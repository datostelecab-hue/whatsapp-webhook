<form method="POST" action="/cambiar-password" class="bg-telecab-card border border-telecab-border rounded-2xl p-6 shadow-soft">
  <h1 class="text-lg font-semibold text-telecab-text mb-1">
    <%= primerAcceso ? 'Crea tu contraseña' : 'Cambiar contraseña' %>
  </h1>
  <p class="text-xs text-telecab-muted mb-4">
    <% if (primerAcceso) { %>
      Es tu primer acceso: elige una contraseña propia para <b class="text-telecab-text"><%= usuario.email %></b>.
    <% } else { %>
      Cambia la contraseña de <b class="text-telecab-text"><%= usuario.email %></b>.
    <% } %>
  </p>

  <% if (error) { %>
    <p class="text-xs text-telecab-red bg-telecab-red/10 border border-telecab-red/30 rounded-lg px-3 py-2 mb-3">
      <i class="fa-solid fa-triangle-exclamation mr-1"></i><%= error %>
    </p>
  <% } %>

  <% if (!primerAcceso) { %>
    <label class="block text-xs text-telecab-muted mb-1">Contraseña actual</label>
    <input name="actual" type="password" required autocomplete="current-password"
           class="w-full bg-telecab-dark border border-telecab-border rounded-xl px-3 py-2 text-telecab-text mb-3 focus:outline-none focus:border-telecab-gold transition">
  <% } %>

  <label class="block text-xs text-telecab-muted mb-1">Nueva contraseña <span class="text-telecab-muted/70">(mín. 8)</span></label>
  <input name="nueva" type="password" required minlength="8" autocomplete="new-password"
         class="w-full bg-telecab-dark border border-telecab-border rounded-xl px-3 py-2 text-telecab-text mb-3 focus:outline-none focus:border-telecab-gold transition">

  <label class="block text-xs text-telecab-muted mb-1">Repite la nueva contraseña</label>
  <input name="repetir" type="password" required minlength="8" autocomplete="new-password"
         class="w-full bg-telecab-dark border border-telecab-border rounded-xl px-3 py-2 text-telecab-text mb-4 focus:outline-none focus:border-telecab-gold transition">

  <button class="w-full px-4 py-2.5 rounded-xl bg-telecab-gold text-telecab-dark font-semibold hover:bg-telecab-gold-soft transition">
    Guardar y entrar
  </button>

  <% if (!primerAcceso) { %>
    <div class="text-center mt-4">
      <a href="/" class="text-xs text-telecab-muted hover:text-telecab-gold transition">Cancelar</a>
    </div>
  <% } %>
</form>
