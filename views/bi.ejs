<div class="max-w-[1500px] mx-auto">

  <!-- ── Cabecera ──────────────────────────────────────────────────────────────── -->
  <div class="flex flex-wrap items-end justify-between gap-3 mb-4">
    <div>
      <h1 class="text-2xl font-bold text-telecab-text flex items-center gap-2">
        <i class="fa-solid fa-chart-pie text-telecab-gold"></i> Inteligencia de negocio
      </h1>
      <p class="text-sm text-telecab-muted mt-1">
        Ingresos, horas, flota y personas sobre la misma capa de datos que lee Power BI.
        <span id="b-meta" class="ml-1 text-telecab-muted/70"></span>
      </p>
    </div>
    <div class="flex items-center gap-2">
      <select id="b-export" aria-label="Exportar una tabla en CSV" class="px-3 py-2 rounded-lg bg-telecab-card border border-telecab-border text-sm text-telecab-muted" title="Descargar una tabla en CSV (Excel la abre directo)">
        <option value="">Exportar CSV…</option>
      </select>
      <button id="b-refrescar" class="px-3 py-2 rounded-lg bg-telecab-card border border-telecab-border text-sm text-telecab-muted hover:text-telecab-text" title="Recalcular los hechos (horas, ingresos, km) con lo de hoy. Solos se recalculan cada madrugada, a las 04:30.&#10;Tarda cerca de un minuto y carga la base: úsalo cuando haga falta lo de hoy.">
        <i class="fa-solid fa-rotate mr-1"></i> Refrescar datos
      </button>
    </div>
  </div>

  <!-- ── Periodo y filtros: mandan sobre TODAS las pestañas ─────────────────────── -->
  <div class="rounded-2xl border border-telecab-border bg-telecab-card p-3 mb-4 flex flex-wrap items-center gap-2">
    <div id="b-presets" class="flex flex-wrap items-center gap-1">
      <% [['mes','Este mes'],['mes_pasado','Mes pasado'],['7d','7 días'],['30d','30 días'],['90d','90 días'],['anio','Este año']].forEach(([v,t]) => { %>
        <button data-preset="<%= v %>" class="b-preset px-3 py-1.5 rounded-lg border text-xs border-telecab-border text-telecab-muted hover:text-telecab-text"><%= t %></button>
      <% }) %>
    </div>
    <div class="flex items-center gap-1 text-xs text-telecab-muted">
      <input id="b-desde" type="date" aria-label="Desde" class="px-2 py-1.5 rounded-lg bg-telecab-dark border border-telecab-border text-xs text-telecab-text">
      <span>→</span>
      <input id="b-hasta" type="date" aria-label="Hasta" class="px-2 py-1.5 rounded-lg bg-telecab-dark border border-telecab-border text-xs text-telecab-text">
    </div>
    <div class="flex-1"></div>
    <select id="b-zona"  aria-label="Zona" class="px-2 py-1.5 rounded-lg bg-telecab-dark border border-telecab-border text-xs text-telecab-text"><option value="">Todas las zonas</option></select>
    <select id="b-tipo"  aria-label="Tipo de contrato" class="px-2 py-1.5 rounded-lg bg-telecab-dark border border-telecab-border text-xs text-telecab-text">
      <option value="">Propia + ETT</option><option value="propia">Solo propia</option><option value="ett">Solo ETT</option>
    </select>
    <select id="b-turno" aria-label="Turno" class="px-2 py-1.5 rounded-lg bg-telecab-dark border border-telecab-border text-xs text-telecab-text"><option value="">Todos los turnos</option></select>
    <span id="b-rango" class="text-xs text-telecab-muted tabular-nums ml-1"></span>
  </div>

  <!-- ── Pestañas ──────────────────────────────────────────────────────────────── -->
  <div id="b-tabs" class="flex flex-wrap items-center gap-2 mb-4">
    <% [['resumen','fa-gauge-high','Resumen'],['negocio','fa-euro-sign','Negocio'],['flota','fa-car-side','Flota'],['personas','fa-users','Personas'],['operacion','fa-satellite-dish','Operación'],['contratacion','fa-user-plus','Contratación'],['powerbi','fa-plug','Power BI']].forEach(([id,ic,t]) => { %>
      <button data-tab="<%= id %>" class="b-tab px-3 py-2 rounded-xl border text-sm flex items-center gap-2 border-telecab-border bg-telecab-card text-telecab-muted hover:text-telecab-text"><i class="fa-solid <%= ic %>"></i> <%= t %></button>
    <% }) %>
  </div>

  <%
    const kpi = (id, label, sub, acento, extra) => `<div class="rounded-2xl border ${acento ? 'border-telecab-gold/40' : 'border-telecab-border'} bg-telecab-card p-4 ${extra || ''}">
      <p class="text-[11px] text-telecab-muted uppercase tracking-wide">${label}</p>
      <p id="${id}" class="text-2xl font-bold ${acento ? 'text-telecab-gold' : 'text-telecab-text'} mt-1 tabular-nums leading-none">—</p>
      <div class="flex items-center gap-2 mt-2"><span id="${id}-delta" class="text-[11px] tabular-nums"></span><span class="text-[11px] text-telecab-muted">${sub}</span></div>
    </div>`;
    const panel = (titulo, sub, canvasId, alto, extra) => `<div class="rounded-2xl border border-telecab-border bg-telecab-card p-4 ${extra || ''}">
      <h2 class="text-sm font-semibold text-telecab-text">${titulo}</h2>
      ${sub ? `<p class="text-xs text-telecab-muted mb-2">${sub}</p>` : '<div class="mb-2"></div>'}
      <div class="relative" style="height:${alto || 260}px"><canvas id="${canvasId}"></canvas></div>
    </div>`;
    const tabla = (id, titulo, sub, cabeceras, extra) => `<div class="rounded-2xl border border-telecab-border bg-telecab-card overflow-hidden ${extra || ''}">
      <div class="px-4 py-3 border-b border-telecab-border flex items-center justify-between gap-2">
        <div><h2 class="text-sm font-semibold text-telecab-text">${titulo}</h2>${sub ? `<p class="text-xs text-telecab-muted">${sub}</p>` : ''}</div>
        <span id="${id}-n" class="text-xs text-telecab-muted"></span>
      </div>
      <div class="overflow-x-auto"><table class="w-full text-sm"><thead><tr class="text-telecab-muted text-[11px] uppercase tracking-wide border-b border-telecab-border">
        ${cabeceras.map(c => `<th class="${c.startsWith('>') ? 'text-right' : 'text-left'} px-3 py-2 whitespace-nowrap">${c.replace(/^>/, '')}</th>`).join('')}
      </tr></thead><tbody id="${id}" class="tabular-nums"></tbody></table></div>
    </div>`;
  %>

  <!-- ══ RESUMEN ═══════════════════════════════════════════════════════════════ -->
  <section data-panel="resumen" class="b-panel hidden space-y-4">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
      <%- kpi('k-neto', 'Neto facturado', 'frente al periodo anterior', false, 'tarjeta-grad tarjeta-grad-d') %>
      <%- kpi('k-horas', 'Horas efectivas', 'viaje + espera', false, 'tarjeta-grad tarjeta-grad-a') %>
      <%- kpi('k-eurh', 'Euros por hora', 'neto / horas efectivas', false, 'tarjeta-grad tarjeta-grad-b') %>
      <%- kpi('k-viajes', 'Viajes terminados', 'con su € por viaje', false, 'tarjeta-grad tarjeta-grad-c') %>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
      <%- kpi('k-util', 'Utilización', 'viaje / (viaje + espera)') %>
      <%- kpi('k-perd', 'Ofertas perdidas por el conductor', 'no respondió · rechazó · canceló') %>
      <%- kpi('k-coches', 'Coches con horas', 'y horas por coche y día') %>
      <%- kpi('k-plant', 'Plantilla media', 'y absentismo') %>
    </div>
    <%- panel('Neto y horas efectivas por día', 'Cada barra es el neto del día; la línea, las horas efectivas. Los días por venir no aparecen.', 'g-r-dia', 300) %>
    <div class="grid grid-cols-1 xl:grid-cols-3 gap-4">
      <%- panel('Los últimos meses', 'Neto (barras) y euros por hora (línea) mes a mes, con todo lo que hay en el núcleo.', 'g-r-meses', 280, 'xl:col-span-2') %>
      <%- tabla('t-r-zona', 'Por zona', 'El periodo elegido, cortado por la zona del cuadrante.', ['Zona', '>Neto', '>Horas', '>€/h', '>Cond.', '>% perd.']) %>
    </div>
  </section>

  <!-- ══ NEGOCIO ═══════════════════════════════════════════════════════════════ -->
  <section data-panel="negocio" class="b-panel hidden space-y-4">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
      <%- kpi('n-eurh', 'Euros por hora', 'el precio de cada hora efectiva', true) %>
      <%- kpi('n-eurv', 'Euros por viaje', 'ticket medio') %>
      <%- kpi('n-vh', 'Viajes por hora', 'ritmo de la flota') %>
      <%- kpi('n-conv', 'Conversión de ofertas', 'viajes / ofertas recibidas') %>
    </div>
    <div class="grid grid-cols-1 xl:grid-cols-2 gap-4">
      <%- panel('Euros por hora y viajes por hora, por día', 'Si baja el €/h con las mismas horas, el problema es la demanda; si bajan las horas, la oferta.', 'g-n-ratios', 280) %>
      <%- panel('Qué pasa con cada oferta', 'De todo lo que BOLT ofrece a la flota: lo que acaba en viaje, lo que pierde el conductor y lo que cancela el cliente.', 'g-n-ofertas', 280) %>
    </div>
    <div class="rounded-2xl border border-telecab-border bg-telecab-card p-4">
      <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
        <div>
          <h2 class="text-sm font-semibold text-telecab-text">Cuándo se factura · hora del día × día de la semana</h2>
          <p class="text-xs text-telecab-muted">Neto de los viajes terminados. Cuanto más oscuro, más dinero: ahí es donde tiene que haber coches en la calle.</p>
        </div>
        <div class="flex items-center gap-1 text-[11px] text-telecab-muted"><span>menos</span><span id="b-heat-escala" class="inline-flex gap-px"></span><span>más</span></div>
      </div>
      <div id="b-heat" class="overflow-x-auto"></div>
    </div>
    <div class="grid grid-cols-1 xl:grid-cols-3 gap-4">
      <%- tabla('t-n-turnohora', 'Por turno horario', 'Los viajes, por la hora a la que terminaron.', ['Turno', '>Viajes', '>Neto', '>% perd.']) %>
      <%- tabla('t-n-contrato', 'Por tipo de contrato', 'La cuenta de BOLT enlazada dice quién es; el contrato, de qué tipo.', ['Contrato', '>Neto', '>Horas', '>€/h', '>Cond.']) %>
      <%- tabla('t-n-turno', 'Por turno de plaza', 'El turno que tiene asignado en el cuadrante.', ['Turno', '>Neto', '>Horas', '>€/h', '>Cond.']) %>
    </div>
  </section>

  <!-- ══ FLOTA ═════════════════════════════════════════════════════════════════ -->
  <section data-panel="flota" class="b-panel hidden space-y-4">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
      <%- kpi('f-hcd', 'Horas por coche y día', 'la capacidad configurada son 16 h', true) %>
      <%- kpi('f-ecd', 'Euros por coche y día', 'neto / coches con horas / días') %>
      <%- kpi('f-km', 'Km rodados en BOLT', 'y km fuera (descanso o desconectado)') %>
      <%- kpi('f-ekm', 'Euros por km en BOLT', 'neto / km en viaje o espera') %>
    </div>
    <div class="grid grid-cols-1 xl:grid-cols-2 gap-4">
      <%- panel('Coches con horas y horas por coche, por día', 'Cuántos coches salieron y cuánto rindió cada uno de media.', 'g-f-coches', 280) %>
      <%- panel('Km por día · en BOLT y fuera', 'Los km fuera son coche rodando sin estar disponible: combustible y desgaste sin ingreso.', 'g-f-km', 280) %>
    </div>
    <%- tabla('t-f-coches', 'Ranking de coches', 'Pincha una cabecera para ordenar. Los que más rinden y los que menos, con sus km fuera.', ['Matrícula', 'Zona', 'Modelo', '>Días salió', '>Horas/día', '>€/día', '>€/h', '>Km', '>% km fuera', '>Neto']) %>
  </section>

  <!-- ══ PERSONAS ══════════════════════════════════════════════════════════════ -->
  <section data-panel="personas" class="b-panel hidden space-y-4">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
      <%- kpi('p-plant', 'Plantilla vigente hoy', 'propia + ETT', true) %>
      <%- kpi('p-aus', 'Ausentes hoy', 'baja médica, vacaciones, permiso…') %>
      <%- kpi('p-altas', 'Altas en el periodo', 'y bajas reales (sin la migración)') %>
      <%- kpi('p-sinbolt', 'Vigentes sin cuenta BOLT', 'gente cuyo dinero no se le puede atribuir') %>
    </div>
    <div class="grid grid-cols-1 xl:grid-cols-3 gap-4">
      <%- panel('La plantilla, día a día', 'Vigentes por tipo de contrato y, en rojo, los ausentes.', 'g-p-plantilla', 280, 'xl:col-span-2') %>
      <%- panel('Ausentes hoy, por motivo', '', 'g-p-ausentes', 280) %>
    </div>
    <div class="grid grid-cols-1 xl:grid-cols-3 gap-4">
      <%- panel('Altas y bajas por día', 'Las bajas administrativas de la migración no cuentan.', 'g-p-altasbajas', 240) %>
      <%- panel('Antigüedad de los vigentes', 'Cuánta gente lleva poco: la rotación se ve aquí antes que en ningún sitio.', 'g-p-antig', 240) %>
      <%- panel('Edad de los vigentes', '', 'g-p-edad', 240) %>
    </div>
    <div class="rounded-2xl border border-telecab-border bg-telecab-card overflow-hidden">
      <div class="px-4 py-3 border-b border-telecab-border flex flex-wrap items-center justify-between gap-2">
        <div>
          <h2 class="text-sm font-semibold text-telecab-text">Ranking de conductores</h2>
          <p class="text-xs text-telecab-muted">Los ratios exigen un mínimo de horas en el periodo (<span id="p-min">—</span> h) para que una tarde suelta no encabece la lista.</p>
        </div>
        <div class="flex items-center gap-2">
          <select id="p-orden" aria-label="Orden del ranking" class="px-2 py-1.5 rounded-lg bg-telecab-dark border border-telecab-border text-xs text-telecab-text">
            <option value="neto">Más neto</option><option value="horas">Más horas</option><option value="euros_hora">Mejor €/hora</option>
            <option value="utilizacion">Mejor utilización</option><option value="perdidas">Más ofertas perdidas</option><option value="menos_horas">Menos horas</option>
          </select>
          <select id="p-limite" aria-label="Conductores a mostrar" class="px-2 py-1.5 rounded-lg bg-telecab-dark border border-telecab-border text-xs text-telecab-text">
            <option value="25">25</option><option value="50" selected>50</option><option value="100">100</option><option value="500">Todos</option>
          </select>
        </div>
      </div>
      <div class="overflow-x-auto"><table class="w-full text-sm"><thead><tr class="text-telecab-muted text-[11px] uppercase tracking-wide border-b border-telecab-border">
        <th class="text-left px-3 py-2">#</th><th class="text-left px-3 py-2">Conductor</th><th class="text-left px-3 py-2">Contrato</th><th class="text-left px-3 py-2">Zona</th>
        <th class="text-right px-3 py-2">Días</th><th class="text-right px-3 py-2">Horas</th><th class="text-right px-3 py-2">H/día</th><th class="text-right px-3 py-2">Viajes</th>
        <th class="text-right px-3 py-2">Neto</th><th class="text-right px-3 py-2">€/h</th><th class="text-right px-3 py-2">Util.</th><th class="text-right px-3 py-2">% perd.</th>
      </tr></thead><tbody id="t-p-cond" class="tabular-nums"></tbody></table></div>
    </div>
    <%- tabla('t-p-bajas', 'Por qué se va la gente', 'Motivos de las bajas del periodo, tal como los apuntó RRHH.', ['Motivo', '>Personas']) %>
  </section>

  <!-- ══ OPERACIÓN ═════════════════════════════════════════════════════════════ -->
  <section data-panel="operacion" class="b-panel hidden space-y-4">
    <div class="grid grid-cols-1 xl:grid-cols-2 gap-4">
      <%- panel('Cobertura del cuadrante · últimos 14 días', 'Plazas planificadas y cuántas tenían a alguien asignado. Un hueco es un coche que se quedó sin salir por falta de gente.', 'g-o-cobertura', 260) %>
      <%- panel('Avisos del control por día', 'Los avisos de Control · En directo. En rojo los graves (rueda desconectado, sin cumplir horas).', 'g-o-incidencias', 260) %>
    </div>
    <div class="grid grid-cols-1 xl:grid-cols-3 gap-4">
      <%- tabla('t-o-tipo', 'Avisos por tipo', 'Cuántos hubo y cuántos se gestionaron (llamada o ignorar).', ['Tipo', '>Grav.', '>Avisos', '>Gestionados', '>Min. medios']) %>
      <%- tabla('t-o-reinc', 'Quién más avisos acumula', 'Las personas y coches que más veces han saltado en el periodo.', ['Conductor', 'Coche', '>Avisos', '>Grav. máx.']) %>
      <%- tabla('t-o-bitacora', 'Justificantes y marcas por mes', 'Las J valen 8 h para el pago: cuántas se dan es un coste que hay que mirar.', ['Mes', 'Marca', '>Personas·día']) %>
    </div>
  </section>

  <!-- ══ CONTRATACIÓN ══════════════════════════════════════════════════════════ -->
  <section data-panel="contratacion" class="b-panel hidden space-y-4">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
      <%- kpi('c-total', 'Candidaturas', 'todas las registradas', true) %>
      <%- kpi('c-funnel', 'En el embudo', 'aún en proceso') %>
      <%- kpi('c-altas', 'Llegaron a alta', 'y días medios hasta el alta') %>
      <%- kpi('c-salidas', 'Salieron del proceso', 'descartados, no presentados…') %>
    </div>
    <div class="grid grid-cols-1 xl:grid-cols-2 gap-4">
      <%- panel('El embudo, por estado', 'Cuánta gente hay en cada paso del proceso de selección.', 'g-c-funnel', 300) %>
      <%- tabla('t-c-canales', 'Por canal de entrada', 'De dónde viene la gente y cuántos de cada canal acaban dados de alta.', ['Canal', '>Candidatos', '>Altas', '>% alta']) %>
    </div>
  </section>

  <!-- ══ POWER BI ══════════════════════════════════════════════════════════════ -->
  <section data-panel="powerbi" class="b-panel hidden space-y-4">
    <div class="grid grid-cols-1 xl:grid-cols-2 gap-4">
      <div class="rounded-2xl border border-telecab-border bg-telecab-card p-5 space-y-4">
        <h2 class="text-sm font-semibold text-telecab-text"><i class="fa-solid fa-plug text-telecab-gold mr-2"></i>Conectar Power BI Desktop</h2>
        <ol class="text-sm text-telecab-muted space-y-2 list-decimal pl-5">
          <li>Abre Power BI Desktop → <b class="text-telecab-text">Obtener datos</b> → <b class="text-telecab-text">Base de datos PostgreSQL</b>.</li>
          <li>Servidor: <code id="pb-host" class="text-telecab-gold">—</code> · Base de datos: <code id="pb-base" class="text-telecab-gold">—</code></li>
          <li>Modo <b class="text-telecab-text">Importar</b>. Cifrado activado (el servidor exige SSL).</li>
          <li>Usuario y contraseña de <b class="text-telecab-text">solo lectura</b> (abajo cómo crearlo). Nunca el usuario de la aplicación.</li>
          <li>En el navegador de tablas marca las que empiezan por <code class="text-telecab-gold">bi_</code> y pulsa Cargar. Power BI detecta solo las relaciones por <code>bolt_uuid</code>, <code>matricula</code> y <code>dia</code>; si no, se crean a mano en Modelo.</li>
        </ol>
        <p class="text-xs text-telecab-muted">Si el conector pide instalar Npgsql, acepta: es el controlador oficial de PostgreSQL para Power BI.</p>
      </div>
      <div class="rounded-2xl border border-telecab-border bg-telecab-card p-5 space-y-3">
        <h2 class="text-sm font-semibold text-telecab-text"><i class="fa-solid fa-key text-telecab-gold mr-2"></i>Usuario de solo lectura</h2>
        <p class="text-xs text-telecab-muted">Ejecútalo una vez en la base (por ejemplo desde la consola de Render) cambiando la contraseña. Solo puede leer las vistas <code>bi_*</code>: ni escribir, ni ver las tablas de personas.</p>
<pre class="text-xs bg-telecab-dark border border-telecab-border rounded-lg p-3 overflow-x-auto text-telecab-text">CREATE ROLE bi_lector LOGIN PASSWORD 'CAMBIAME';
GRANT CONNECT ON DATABASE telecab TO bi_lector;
GRANT USAGE ON SCHEMA public TO bi_lector;
GRANT SELECT ON bi_dim_fecha, bi_dim_conductor, bi_dim_vehiculo,
  bi_hecho_horas_dia, bi_hecho_ingresos_dia, bi_hecho_km_dia,
  bi_plantilla_dia, bi_hecho_incidencias, bi_hecho_bitacora,
  bi_funnel_candidaturas, bi_conductor_mes, bi_vehiculo_dia, bi_kpi_mes
  TO bi_lector;</pre>
      </div>
    </div>
    <div class="rounded-2xl border border-telecab-border bg-telecab-card overflow-hidden">
      <div class="px-4 py-3 border-b border-telecab-border">
        <h2 class="text-sm font-semibold text-telecab-text">Las tablas del modelo</h2>
        <p class="text-xs text-telecab-muted">Un modelo en estrella: dimensiones (quién, qué, cuándo) y hechos (cuánto). Cada una se puede bajar en CSV con el periodo elegido arriba.</p>
      </div>
      <div class="overflow-x-auto"><table class="w-full text-sm"><thead><tr class="text-telecab-muted text-[11px] uppercase tracking-wide border-b border-telecab-border">
        <th class="text-left px-4 py-2">Vista</th><th class="text-left px-3 py-2">Qué es</th><th class="text-left px-3 py-2">Grano</th><th class="text-right px-4 py-2"></th>
      </tr></thead><tbody id="t-pb-vistas"></tbody></table></div>
    </div>
  </section>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/chartjs-plugin-datalabels/2.2.0/chartjs-plugin-datalabels.min.js"></script>
<script src="<%= est('/assets/js/vistas/bi.js') %>"></script>
