<div class="p-4 lg:p-6 max-w-4xl mx-auto space-y-5">

  <div class="flex items-center justify-between gap-3">
    <div>
      <h1 class="text-lg font-semibold text-telecab-text flex items-center gap-2">
        <i class="fa-solid fa-clipboard-list text-telecab-gold"></i> Peticiones a RRHH
      </h1>
      <p class="text-xs text-telecab-muted mt-0.5">Tráfico solicita bajas y ausencias (con Desde–Hasta); RRHH las aprueba/rechaza o las crea y aplica directo. Al aplicarse, el estado cambia al momento y la bitácora se rellena en el rango.</p>
    </div>
    <button id="btn-recargar" class="shrink-0 text-xs px-3 py-1.5 rounded-lg border border-telecab-border text-telecab-muted hover:border-telecab-gold transition">
      <i class="fa-solid fa-rotate mr-1"></i> Recargar
    </button>
  </div>

  <!-- Crear petición (Tráfico) -->
  <div id="card-crear" class="bg-telecab-card border border-telecab-border rounded-2xl p-4 hidden">
    <h2 class="text-sm font-semibold text-telecab-text mb-3 flex items-center gap-2"><i class="fa-solid fa-plus text-telecab-gold"></i> Nueva petición</h2>
    <div class="grid md:grid-cols-2 gap-4">
      <div>
        <label class="block text-xs text-telecab-muted mb-1">Conductor <span class="text-telecab-muted/70">(escribe para buscar)</span></label>
        <input id="f-conductor-txt" class="inp" list="dl-conductores" placeholder="Nombre o ID del conductor…" autocomplete="off">
        <datalist id="dl-conductores"></datalist>
      </div>
      <div>
        <label class="block text-xs text-telecab-muted mb-1">Tipo</label>
        <select id="f-tipo" class="inp">
          <% (tipos || []).forEach(function (t) { %><option value="<%= t %>"><%= t %></option><% }); %>
        </select>
      </div>
      <div id="f-desde-wrap">
        <label class="block text-xs text-telecab-muted mb-1">Desde</label>
        <input id="f-desde" class="js-fecha inp" readonly placeholder="dd/mm/aaaa">
      </div>
      <div id="f-hasta-wrap">
        <label class="block text-xs text-telecab-muted mb-1">Hasta</label>
        <input id="f-hasta" class="js-fecha inp" readonly placeholder="dd/mm/aaaa" data-min-field="f-desde">
      </div>
      <div class="md:col-span-2">
        <label class="block text-xs text-telecab-muted mb-1">Responsable <span class="text-telecab-muted/70">(quién lo hace)</span></label>
        <input id="f-solicitante" class="inp" placeholder="Tu nombre">
      </div>
      <div class="md:col-span-2">
        <label class="block text-xs text-telecab-muted mb-1">Motivo</label>
        <textarea id="f-motivo" rows="2" class="inp resize-none" placeholder="Motivo de la baja / ausencia"></textarea>
      </div>
    </div>
    <div class="mt-4 flex flex-wrap items-center gap-3">
      <button id="btn-crear" class="hidden px-4 py-2.5 rounded-xl bg-telecab-gold/15 border border-telecab-gold/40 text-telecab-gold hover:bg-telecab-gold/25 transition font-semibold">
        <i class="fa-solid fa-paper-plane mr-1"></i> Enviar petición a RRHH
      </button>
      <button id="btn-crear-directa" class="hidden px-4 py-2.5 rounded-xl bg-telecab-green/15 border border-telecab-green/40 text-telecab-green hover:bg-telecab-green/25 transition font-semibold">
        <i class="fa-solid fa-bolt mr-1"></i> Crear y aplicar
      </button>
      <p id="crear-msg" class="text-xs hidden"></p>
    </div>
  </div>

  <!-- Pendientes de resolver (RRHH) -->
  <div id="card-pend" class="bg-telecab-card border border-telecab-border rounded-2xl p-4 hidden">
    <h2 class="text-sm font-semibold text-telecab-text mb-3 flex items-center gap-2"><i class="fa-solid fa-clipboard-check text-telecab-gold"></i> Pendientes de resolver <span id="c-pend" class="text-telecab-muted font-normal"></span></h2>
    <div id="lista-pend" class="space-y-2"></div>
  </div>

  <!-- Historial -->
  <div class="bg-telecab-card border border-telecab-border rounded-2xl p-4">
    <h2 class="text-sm font-semibold text-telecab-text mb-3 flex items-center gap-2"><i class="fa-solid fa-clock-rotate-left text-telecab-muted"></i> Historial</h2>
    <div id="lista-hist" class="space-y-1.5"></div>
  </div>

</div>


<script>
  const $ = s => document.querySelector(s);
  const esc = s => String(s == null ? '' : s).replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
  const rol = localStorage.getItem('telecab-rol') || 'general';
  const esTrafico = rol === 'trafico' || rol === 'general';   // crea petición (queda pendiente)
  const esRRHH = rol === 'rrhh' || rol === 'general';         // resuelve + crea y aplica directo
  const puedeCrear = esTrafico || esRRHH;                     // ve el formulario de alta
  const puedeResolver = esRRHH;

  const COLOR = { 'Pendiente': 'text-telecab-gold', 'Aprobada': 'text-telecab-green', 'Rechazada': 'text-telecab-red' };
  const ICONO = { 'Baja Empresa': 'fa-user-slash', 'Vacaciones': 'fa-umbrella-beach', 'Baja Médica': 'fa-briefcase-medical', 'Permiso Retribuido': 'fa-ticket', 'Reingreso': 'fa-arrow-rotate-left' };
  // El despido (Baja Empresa) es permanente: lleva solo la fecha de efecto, sin "Hasta".
  const SIN_HASTA = ['Baja Empresa'];

  // Conductores para el autocompletado (300+). La fuente cambia según el tipo:
  //   · Reingreso → archivados (CONDUCTORES_OUT)   · resto → agenda activa.
  let ACTIVOS = [], ARCHIVADOS = [], CONDUCTORES = [];
  const esReingreso = () => $('#f-tipo').value === 'Reingreso';
  const sinHasta = () => SIN_HASTA.includes($('#f-tipo').value);
  const dispCond = c => `${c.nombre}${c.turno ? ' · ' + c.turno : ''}`;
  function pintarDatalist() {
    const dl = $('#dl-conductores');
    if (dl) dl.innerHTML = CONDUCTORES.map(c => `<option value="${esc(dispCond(c))}"></option>`).join('');
  }
  function resolverConductor(txt) {
    txt = (txt || '').trim().toLowerCase();
    if (!txt) return null;
    return CONDUCTORES.find(c => dispCond(c).toLowerCase() === txt)
        || CONDUCTORES.find(c => (c.nombre || '').toLowerCase() === txt)
        || CONDUCTORES.find(c => String(c.id).toLowerCase() === txt)
        || null;
  }
  // Al cambiar el tipo: reingreso oculta las fechas (es inmediato) y usa el archivo.
  function onTipoChange() {
    const rein = esReingreso();
    const dw = $('#f-desde-wrap'), hw = $('#f-hasta-wrap');
    if (dw) dw.classList.toggle('hidden', rein);
    // El despido oculta "Hasta" (permanente); el reingreso oculta ambas (inmediato).
    if (hw) hw.classList.toggle('hidden', rein || sinHasta());
    const lblDesde = $('#f-desde-wrap label'); if (lblDesde) lblDesde.textContent = sinHasta() ? 'Fecha de efecto' : 'Desde';
    CONDUCTORES = rein ? ARCHIVADOS : ACTIVOS;
    const inp = $('#f-conductor-txt'); if (inp) inp.value = '';
    pintarDatalist();
  }

  async function api(url, body) {
    const r = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body || {}) });
    return r.json();
  }

  function tarjetaPend(p) {
    const el = document.createElement('div');
    el.className = 'rounded-xl bg-telecab-dark/40 border border-telecab-border p-3';
    const rein = p.tipo === 'Reingreso';
    const sh = SIN_HASTA.includes(p.tipo);   // despido: solo fecha de efecto
    const bloqueFechas = rein
      ? `<p class="text-xs text-telecab-muted mb-2"><i class="fa-solid fa-arrow-rotate-left mr-1 text-telecab-gold"></i>Reingreso inmediato: al aprobar vuelve a la agenda como <b class="text-telecab-text">Pendiente Asignar</b>.</p>`
      : `<div class="flex flex-wrap items-end gap-2 mb-2">
          <div><label class="block text-[11px] text-telecab-muted mb-0.5">${sh ? 'Fecha de efecto' : 'Desde'}</label><input class="pp-desde js-fecha inp !w-32 text-sm" value="${esc(p.desde)}" placeholder="dd/mm/aaaa"></div>
          ${sh ? '' : `<div><label class="block text-[11px] text-telecab-muted mb-0.5">Hasta</label><input class="pp-hasta js-fecha inp !w-32 text-sm" value="${esc(p.hasta)}" placeholder="dd/mm/aaaa"></div>`}
        </div>`;
    el.innerHTML =
      `<div class="flex items-center gap-2 mb-2">
         <i class="fa-solid ${ICONO[p.tipo] || 'fa-file'} text-telecab-gold"></i>
         <span class="text-sm font-semibold text-telecab-text">${esc(p.tipo)}</span>
         <span class="text-sm text-telecab-text">· ${esc(p.conductor || p.id_conductor)}</span>
         <span class="ml-auto text-[11px] text-telecab-muted">${esc(p.fecha_solicitud)} · ${esc(p.solicitante)}</span>
       </div>
       ${p.motivo ? `<p class="text-xs text-telecab-muted mb-2">Motivo: ${esc(p.motivo)}</p>` : ''}
       ${bloqueFechas}
       <div class="mb-2">
         <label class="block text-[11px] text-telecab-muted mb-0.5">Responsable RRHH <span class="text-telecab-muted/70">(quién resuelve)</span></label>
         <input class="pp-resp inp !w-56 text-sm" placeholder="Tu nombre">
       </div>
       <div class="flex gap-2">
         <button class="pp-ap px-3 py-1.5 rounded-lg bg-telecab-green/15 border border-telecab-green/40 text-telecab-green text-xs font-semibold hover:bg-telecab-green/25 transition"><i class="fa-solid fa-check mr-1"></i> Aprobar</button>
         <button class="pp-rz px-3 py-1.5 rounded-lg bg-telecab-red/10 border border-telecab-red/40 text-telecab-red text-xs hover:bg-telecab-red/20 transition"><i class="fa-solid fa-xmark mr-1"></i> Rechazar</button>
       </div>`;
    const responsable = () => el.querySelector('.pp-resp').value.trim();
    el.querySelector('.pp-ap').addEventListener('click', async () => {
      const resuelto_por = responsable();
      if (!resuelto_por) { alert('Escribe quién de RRHH resuelve la petición.'); return; }
      let desde = '', hasta = '';
      if (!rein) {
        desde = el.querySelector('.pp-desde').value.trim();
        hasta = sh ? '' : el.querySelector('.pp-hasta').value.trim();
        if (!desde || (!sh && !hasta)) { alert(sh ? 'Pon la fecha de efecto.' : 'Pon las fechas Desde y Hasta.'); return; }
      }
      const r = await api('/peticiones/aprobar', { id: p.id, desde, hasta, resuelto_por });
      if (r.status === 'ok') cargar(); else alert(r.msg || 'No se pudo aprobar');
    });
    el.querySelector('.pp-rz').addEventListener('click', async () => {
      const resuelto_por = responsable();
      if (!resuelto_por) { alert('Escribe quién de RRHH resuelve la petición.'); return; }
      const motivo = prompt('Motivo del rechazo (se avisa a Tráfico):');
      if (motivo === null) return;
      const r = await api('/peticiones/rechazar', { id: p.id, motivo, resuelto_por });
      if (r.status === 'ok') cargar(); else alert(r.msg || 'No se pudo rechazar');
    });
    return el;
  }

  function filaHist(p) {
    const el = document.createElement('div');
    el.className = 'flex items-center gap-3 px-3 py-2 rounded-lg bg-telecab-dark/30';
    const rango = p.desde ? ` · ${esc(p.desde)}→${esc(p.hasta)}` : '';
    el.innerHTML =
      `<i class="fa-solid ${ICONO[p.tipo] || 'fa-file'} text-telecab-muted shrink-0"></i>
       <span class="min-w-0 flex-1">
         <span class="block text-sm text-telecab-text truncate">${esc(p.tipo)} · ${esc(p.conductor || p.id_conductor)}${rango}</span>
         <span class="block text-[11px] text-telecab-muted truncate">Solicitó: ${esc(p.solicitante || '—')}${p.resuelto_por ? ' · Resolvió: ' + esc(p.resuelto_por) : ''}</span>
         ${p.estado === 'Rechazada' && p.motivo_rechazo ? `<span class="block text-[11px] text-telecab-red/80 truncate">${esc(p.motivo_rechazo)}</span>` : ''}
       </span>
       <span class="text-xs font-semibold ${COLOR[p.estado] || 'text-telecab-muted'} whitespace-nowrap shrink-0">${esc(p.estado)}</span>`;
    return el;
  }

  async function cargar() {
    const r = await (await fetch('/peticiones/api/datos')).json();
    if (r.status !== 'ok') return;

    // Autocompletado de conductores (input texteable; solo quien puede crear).
    if (puedeCrear) {
      ACTIVOS = r.conductores || [];
      ARCHIVADOS = r.archivados || [];
      CONDUCTORES = esReingreso() ? ARCHIVADOS : ACTIVOS;
      pintarDatalist();
    }

    const pend = (r.peticiones || []).filter(p => p.estado === 'Pendiente');
    const resto = (r.peticiones || []).filter(p => p.estado !== 'Pendiente')
      .sort((a, b) => (b.fecha_resolucion || '').localeCompare(a.fecha_resolucion || ''));

    // Pendientes (resolver): solo RRHH/general.
    if (puedeResolver) {
      $('#c-pend').textContent = pend.length ? '(' + pend.length + ')' : '';
      const cont = $('#lista-pend'); cont.innerHTML = '';
      if (!pend.length) cont.innerHTML = '<p class="text-telecab-muted text-sm">No hay peticiones pendientes.</p>';
      else pend.forEach(p => cont.appendChild(tarjetaPend(p)));
    }

    const hist = $('#lista-hist'); hist.innerHTML = '';
    const historial = puedeResolver ? resto : (r.peticiones || []).slice().sort((a, b) => (b.fecha_solicitud || '').localeCompare(a.fecha_solicitud || ''));
    if (!historial.length) hist.innerHTML = '<p class="text-telecab-muted text-sm">Aún no hay peticiones.</p>';
    else historial.forEach(p => hist.appendChild(filaHist(p)));
  }

  // Visibilidad según rol.
  $('#card-crear').classList.toggle('hidden', !puedeCrear);
  $('#card-pend').classList.toggle('hidden', !puedeResolver);

  if (puedeCrear) {
    // Tráfico envía petición (queda pendiente); RRHH crea y aplica directo.
    $('#btn-crear').classList.toggle('hidden', !esTrafico);
    $('#btn-crear-directa').classList.toggle('hidden', !esRRHH);

    const msg = $('#crear-msg');
    const aviso = (t, cls) => { msg.textContent = t; msg.className = 'text-xs ' + cls; msg.classList.remove('hidden'); };
    const recolectar = () => {
      const c = resolverConductor($('#f-conductor-txt').value);
      if (!c) { aviso('Escribe y elige un conductor de la lista.', 'text-telecab-red'); return null; }
      const responsable = $('#f-solicitante').value.trim();
      if (!responsable) { aviso('Escribe el responsable.', 'text-telecab-red'); return null; }
      const rein = esReingreso();
      const sh = sinHasta();
      const desde = rein ? '' : $('#f-desde').value.trim();
      const hasta = (rein || sh) ? '' : $('#f-hasta').value.trim();
      if (!rein && !desde) { aviso(sh ? 'Pon la fecha de efecto.' : 'Pon las fechas Desde y Hasta.', 'text-telecab-red'); return null; }
      if (!rein && !sh && !hasta) { aviso('Pon las fechas Desde y Hasta.', 'text-telecab-red'); return null; }
      return { id_conductor: c.id, conductor: c.nombre, tipo: $('#f-tipo').value,
        desde, hasta, motivo: $('#f-motivo').value.trim(), responsable };
    };
    const limpiar = () => { $('#f-motivo').value = ''; $('#f-desde').value = ''; $('#f-hasta').value = ''; $('#f-conductor-txt').value = ''; };

    $('#f-tipo').addEventListener('change', onTipoChange);
    onTipoChange();

    $('#btn-crear').addEventListener('click', async () => {
      const b = recolectar(); if (!b) return;
      const r = await api('/peticiones/crear', { ...b, solicitante: b.responsable });
      if (r.status === 'ok') { aviso('Petición enviada a RRHH.', 'text-telecab-green'); limpiar(); cargar(); }
      else aviso(r.msg || 'No se pudo enviar', 'text-telecab-red');
    });
    $('#btn-crear-directa').addEventListener('click', async () => {
      const b = recolectar(); if (!b) return;
      const r = await api('/peticiones/crear-directa', b);
      if (r.status === 'ok') { aviso('Aplicada: estado y bitácora actualizados.', 'text-telecab-green'); limpiar(); cargar(); }
      else aviso(r.msg || 'No se pudo aplicar', 'text-telecab-red');
    });
  }

  $('#btn-recargar').addEventListener('click', cargar);
  cargar();
</script>
