<form method="POST" action="/olvide-password" class="bg-telecab-card border border-telecab-border rounded-2xl p-6 shadow-soft">
  <h1 class="text-lg font-semibold text-telecab-text mb-1">Recuperar acceso</h1>
  <p class="text-xs text-telecab-muted mb-4">Escribe tu correo y te enviaremos una contraseña provisional.</p>

  <% if (mensaje) { %>
    <p class="text-xs text-telecab-green bg-telecab-green/10 border border-telecab-green/30 rounded-lg px-3 py-2 mb-3">
      <i class="fa-solid fa-circle-check mr-1"></i><%= mensaje %>
    </p>
  <% } %>
  <% if (error) { %>
    <p class="text-xs text-telecab-red bg-telecab-red/10 border border-telecab-red/30 rounded-lg px-3 py-2 mb-3">
      <i class="fa-solid fa-triangle-exclamation mr-1"></i><%= error %>
    </p>
  <% } %>

  <label class="block text-xs text-telecab-muted mb-1">Correo</label>
  <input name="email" type="email" required autofocus autocomplete="username"
         class="w-full bg-telecab-dark border border-telecab-border rounded-xl px-3 py-2 text-telecab-text mb-4 focus:outline-none focus:border-telecab-gold transition"
         placeholder="tu@telecab.es">

  <button class="w-full px-4 py-2.5 rounded-xl bg-telecab-gold text-telecab-dark font-semibold hover:bg-telecab-gold-soft transition">
    Enviarme una provisional
  </button>

  <div class="text-center mt-4">
    <a href="/login" class="text-xs text-telecab-muted hover:text-telecab-gold transition">Volver a iniciar sesión</a>
  </div>
</form>
