<% if (!veCifras) { %>
  <%# ── LA BIENVENIDA ────────────────────────────────────────────────────────
      Para quien no tiene el permiso de las cifras. Antes esta gente aterrizaba
      en un "Sin permiso" nada más entrar y creía que la web se había caído; el
      candado no es un error, así que aquí no hay ninguno. Se le saluda, y se le
      enseña por dónde seguir. %>
  <div class="max-w-lg mx-auto text-center pt-16 pb-10 px-4">
    <div class="flex justify-center mb-6">
      <%- include('partials/marca', { tam: 'w-24 h-24' }) %>
    </div>
    <h1 class="text-2xl font-bold text-telecab-text">Bienvenido a Telecab</h1>
    <p class="text-sm text-telecab-muted mt-2">
      <%= (typeof usuario !== 'undefined' && usuario && usuario.nombre) ? usuario.nombre : '' %>,
      esto es todo tuyo. Elige por dónde empezar.
    </p>

    <% if ((misModulos || []).length) { %>
      <div class="mt-7 grid grid-cols-2 gap-2 text-left">
        <% misModulos.forEach(function (m) { %>
          <a href="<%= m.clave %>"
             class="px-3 py-2.5 rounded-xl bg-telecab-card border border-telecab-border text-sm text-telecab-text
                    hover:border-telecab-gold/50 hover:text-telecab-gold transition truncate">
            <%= m.etiqueta %>
          </a>
        <% }); %>
      </div>
    <% } else { %>
      <p class="mt-7 text-sm text-telecab-muted">
        Todavía no tienes ningún módulo asignado. Avisa a quien te dio de alta para que te lo abra.
      </p>
    <% } %>
  </div>

<% } else { %>
<div class="max-w-[1500px] mx-auto" id="panel">

  <div class="flex flex-wrap items-end justify-between gap-3 mb-5">
    <div class="flex items-center gap-3">
      <%- include('partials/marca', { tam: 'w-11 h-11' }) %>
      <div>
        <h1 class="text-2xl font-bold text-telecab-text">
          Hola<%= (typeof usuario !== 'undefined' && usuario && usuario.nombre) ? ', ' + usuario.nombre : '' %>
        </h1>
        <p class="text-sm text-telecab-muted mt-0.5">
          Cómo va la flota. <span id="i-jornada"></span>
        </p>
      </div>
    </div>
    <div class="flex items-center gap-2">
      <a href="/visibilidad" class="px-3 py-2 rounded-lg bg-telecab-card border border-telecab-border text-sm text-telecab-muted hover:text-telecab-text">
        <i class="fa-solid fa-chart-line mr-1"></i> Ver con gráficas
      </a>
      <button id="i-refrescar" class="px-3 py-2 rounded-lg bg-telecab-card border border-telecab-border text-sm text-telecab-muted hover:text-telecab-text">
        <i class="fa-solid fa-rotate mr-1"></i> Actualizar
      </button>
    </div>
  </div>

  <div id="i-error" class="hidden mb-4 px-4 py-3 rounded-xl border border-telecab-red/40 bg-telecab-red/10 text-sm text-telecab-red"></div>

  <%
    /* QUIÉN LLEVA YA SU JORNADA (Camilo, 23/10/2026): cuántos han hecho sus 8 h y
       a cuántos les faltan, y al pulsar, los nombres con sus horas de mayor a
       menor, «para saber si llegaremos o no». Va en el turno en curso, en el
       anterior y en la jornada pasada. Lo pinta pintarPrevision(). */
    function bloquePrevision(id) {
      return `<button type="button" id="${id}-prev" class="hidden mt-4 w-full text-left rounded-xl border border-telecab-border bg-telecab-card2/50 px-3 py-2.5 transition hover:border-telecab-gold/50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-telecab-gold">
        <span class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm">
          <span class="text-telecab-green"><i class="fa-solid fa-circle-check mr-1" aria-hidden="true"></i><b class="tabular-nums" id="${id}-prev-ok">—</b> <span id="${id}-prev-ok-txt">ya llevan su jornada</span></span>
          <span class="text-telecab-warn"><i class="fa-solid fa-hourglass-half mr-1" aria-hidden="true"></i><b class="tabular-nums" id="${id}-prev-falta">—</b> <span id="${id}-prev-falta-txt">les faltan</span></span>
          <span class="ml-auto text-xs text-telecab-muted whitespace-nowrap">Ver quiénes <i class="fa-solid fa-chevron-right ml-0.5" aria-hidden="true"></i></span>
        </span>
        <span class="mt-2 h-1.5 rounded-full bg-telecab-card2 overflow-hidden flex">
          <span id="${id}-prev-bar-ok" class="h-full bg-telecab-green" style="width:0%"></span>
          <span id="${id}-prev-bar-falta" class="h-full bg-telecab-warn/60" style="width:0%"></span>
        </span>
        <span class="block text-xs text-telecab-muted mt-1.5" id="${id}-prev-pie"></span>
      </button>`;
    }
  %>

  <%#
    LO QUE IMPORTA, ARRIBA Y EN GRANDE (Camilo, 23/10/2026): «lo más importante
    siempre serán las horas del mes, las horas del turno actual, si es día o
    noche, y luego las horas del turno pasado, también de la jornada pasada, si
    puede ser más gráfico mejor». Son las cifras y las metas de Visibilidad, tal
    cual: el turno en curso es una de sus dos tarjetas de turno y el anterior, la
    otra. Los conductores de cada turno, pequeños al lado de las horas, son los de
    Visibilidad partidos en «del cuadrante + NN», que es como los cuenta Control
    (la pestaña del turno y la de los NN).
  %>
  <div class="grid grid-cols-1 xl:grid-cols-2 gap-4 mb-4">

    <!-- ── EL MES ───────────────────────────────────────────────────────── -->
    <section class="rounded-2xl border border-telecab-gold/40 bg-telecab-card p-5 md:p-6 flex flex-col min-w-0">
      <div class="flex items-center justify-between gap-3">
        <h2 class="text-xs font-semibold text-telecab-muted uppercase tracking-wider flex items-center gap-2"
            title="Horas EFECTIVAS de toda la flota en lo que va de mes, por día natural: viaje + espera, sin el descanso.&#10;Es la cifra con la que se vive, y la misma que el «Horas efectivas» de Visibilidad.">
          <span class="inline-flex w-7 h-7 items-center justify-center rounded-full bg-telecab-gold/15 text-telecab-gold" aria-hidden="true"><i class="fa-solid fa-calendar-days text-[13px]"></i></span>
          Horas del mes <span id="m-nombre" class="normal-case tracking-normal font-normal"></span>
        </h2>
        <span class="text-xs text-telecab-muted tabular-nums" id="m-cond"></span>
      </div>
      <p class="mt-4 flex items-baseline flex-wrap gap-x-2 leading-none">
        <span id="m-h" class="text-6xl md:text-7xl font-bold text-telecab-gold tabular-nums tracking-tight">—</span>
        <span id="m-meta" class="text-xl md:text-2xl text-telecab-muted font-semibold tabular-nums"></span>
      </p>
      <%# El avance hacia la meta en dos trozos: los días CERRADOS, enteros, y hoy, más
          claro porque aún corre. La raya es el ideal a cierre de ayer: se compara con
          el trozo entero, como el acumulado contra el ideal de Visibilidad. %>
      <div class="mt-5 relative" id="m-barcaja">
        <div class="h-3 rounded-full bg-telecab-card2 overflow-hidden flex">
          <div id="m-bar" class="h-full bg-telecab-gold transition-all" style="width:0%"></div>
          <div id="m-bar-hoy" class="h-full bg-telecab-gold/40 transition-all" style="width:0%"></div>
        </div>
        <div id="m-ideal" class="hidden absolute -top-1 h-5 w-0.5 rounded-full bg-telecab-text/80"></div>
      </div>
      <p class="text-sm text-telecab-muted mt-2.5" id="m-pie">—</p>
      <div class="mt-5 flex-1 flex flex-col justify-end">
        <div id="m-dias" class="h-24" role="img" aria-label="Horas efectivas de cada día del mes"></div>
        <div class="flex justify-between text-[11px] text-telecab-muted tabular-nums mt-1.5" id="m-dias-eje"></div>
        <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-[11px] text-telecab-muted mt-2">
          <span class="flex items-center gap-1.5"><span class="inline-block w-2.5 h-2.5 rounded-sm bg-telecab-gold"></span> días cerrados</span>
          <span class="flex items-center gap-1.5"><span class="inline-block w-2.5 h-2.5 rounded-sm bg-telecab-gold/40"></span> hoy, en curso</span>
          <span class="flex items-center gap-1.5"><span class="inline-block w-4 border-t border-dashed border-telecab-text/60"></span> ritmo que pide la meta <span id="m-ritmo" class="tabular-nums"></span></span>
        </div>
      </div>
    </section>

    <!-- ── EL TURNO EN CURSO ───────────────────────────────────────────── -->
    <section class="rounded-2xl border border-telecab-gold/40 bg-telecab-card p-5 md:p-6 flex flex-col min-w-0">
      <div class="flex items-center justify-between gap-3">
        <h2 class="text-xs font-semibold text-telecab-muted uppercase tracking-wider flex items-center gap-2">
          <span id="t-icono" class="inline-flex w-7 h-7 items-center justify-center rounded-full bg-telecab-card2" aria-hidden="true"><i class="fa-solid fa-sun text-[13px]"></i></span>
          <span id="t-etq">Turno en curso</span>
        </h2>
        <span class="text-xs text-telecab-muted tabular-nums" id="t-ventana"></span>
      </div>
      <div class="mt-4 flex items-end justify-between flex-wrap gap-x-6 gap-y-3">
        <p class="flex items-baseline flex-wrap gap-x-2 leading-none">
          <span id="t-h" class="text-6xl md:text-7xl font-bold text-telecab-text tabular-nums tracking-tight">—</span>
          <span id="t-meta" class="text-xl md:text-2xl text-telecab-muted font-semibold tabular-nums"></span>
        </p>
        <div class="text-right" id="t-cond-caja">
          <p class="text-sm text-telecab-text"><b class="text-lg tabular-nums" id="t-cond">—</b> conductores</p>
          <p class="text-[11px] text-telecab-muted tabular-nums" id="t-cond-det"></p>
        </div>
      </div>
      <div class="mt-5 h-3 rounded-full bg-telecab-card2 overflow-hidden" id="t-barcaja">
        <div id="t-bar" class="h-full rounded-full transition-all" style="width:0%"></div>
      </div>
      <p class="text-sm text-telecab-muted mt-2.5" id="t-pie">—</p>
      <%- bloquePrevision('t') %>
      <%# Viaje y espera: las dos partes de las horas efectivas. La utilización es la
          parte en viaje; se ve sin leer el número. %>
      <div class="mt-4">
        <div class="h-2 rounded-full bg-telecab-card2 overflow-hidden flex" id="t-split" title="">
          <div id="t-viaje" class="h-full bg-telecab-green" style="width:0%"></div>
          <div id="t-espera" class="h-full bg-telecab-azul/70" style="width:0%"></div>
        </div>
        <div class="flex justify-between text-[11px] mt-1.5 tabular-nums">
          <span class="text-telecab-green"><span id="t-viaje-h">—</span> h en viaje</span>
          <span class="text-telecab-muted"><span id="t-util">—</span> % utilización</span>
          <span class="text-telecab-azul"><span id="t-espera-h">—</span> h en espera</span>
        </div>
      </div>
      <%# El reloj del turno: cuánto lleva de sus 12 horas. Va con la hora estándar
          (05:00 y 17:00), que es cuando se cambia de tarjeta. %>
      <div class="mt-auto pt-5">
        <div class="flex justify-between text-[11px] text-telecab-muted tabular-nums">
          <span id="t-ini">—</span><span id="t-queda" class="text-telecab-text"></span><span id="t-fin">—</span>
        </div>
        <div class="mt-1 h-1.5 rounded-full bg-telecab-card2 overflow-hidden" id="t-reloj-caja">
          <div id="t-reloj" class="h-full rounded-full bg-telecab-muted/70" style="width:0%"></div>
        </div>
      </div>
    </section>
  </div>

  <%
    /* Una tarjeta de turno o de jornada ya hecha: las horas con su meta, los
       conductores al lado, la barra de la meta, y debajo lo suyo (`extra`). */
    function tarjetaHecha(id, icono, ayuda, extra) {
      return `<section class="rounded-2xl border border-telecab-border bg-telecab-card p-5 flex flex-col min-w-0">
        <div class="flex items-center justify-between gap-3">
          <h2 class="text-xs font-semibold text-telecab-muted uppercase tracking-wider flex items-center gap-2" title="${ayuda.replace(/"/g, '&quot;')}">
            <span id="${id}-icono" class="inline-flex w-6 h-6 items-center justify-center rounded-full bg-telecab-card2" aria-hidden="true"><i class="fa-solid ${icono} text-[11px]"></i></span>
            <span id="${id}-etq">—</span>
          </h2>
          <span class="text-[11px] text-telecab-muted text-right" id="${id}-estado"></span>
        </div>
        <div class="mt-3 flex items-end justify-between flex-wrap gap-x-4 gap-y-2">
          <p class="flex items-baseline gap-x-1.5 leading-none">
            <span id="${id}-h" class="text-4xl md:text-5xl font-bold text-telecab-text tabular-nums tracking-tight">—</span>
            <span id="${id}-meta" class="text-lg text-telecab-muted font-semibold tabular-nums"></span>
          </p>
          <div class="text-right">
            <p class="text-sm text-telecab-text"><b class="tabular-nums" id="${id}-cond">—</b> conductores</p>
            <p class="text-[11px] text-telecab-muted tabular-nums" id="${id}-cond-det"></p>
          </div>
        </div>
        <div class="mt-4 h-2.5 rounded-full bg-telecab-card2 overflow-hidden" id="${id}-barcaja">
          <div id="${id}-bar" class="h-full rounded-full transition-all" style="width:0%"></div>
        </div>
        <p class="text-xs text-telecab-muted mt-2" id="${id}-pie">—</p>
        ${extra || ''}
        ${bloquePrevision(id)}
      </section>`;
    }
  %>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-7">
    <%- tarjetaHecha('p', 'fa-moon',
      'El turno de antes del que corre. Sus horas son las de SU GENTE: el de día cuenta de 00:00 a 24:00 y el de noche de 12:00 a 12:00, según el turno de cada conductor en el cuadrante (los NN, por su hora de inicio). Por eso puede seguir sumando un rato después de acabar.') %>
    <%- tarjetaHecha('j', 'fa-clock-rotate-left',
      'La última jornada: su turno de día más su turno de noche, por la gente de cada uno. No se cierra hasta las 12:00 del día siguiente, cuando acaba la ventana de su noche. Es la que cuadra con el Reporte de horas y la Bitácora.',
      `<div class="mt-4">
        <div class="h-2 rounded-full bg-telecab-card2 overflow-hidden flex" id="j-split">
          <div id="j-dia" class="h-full bg-telecab-gold/80" style="width:0%"></div>
          <div id="j-noche" class="h-full bg-telecab-azul/70" style="width:0%"></div>
        </div>
        <div class="flex justify-between text-[11px] mt-1.5 tabular-nums">
          <span class="text-telecab-text"><i class="fa-solid fa-sun text-telecab-gold mr-1" aria-hidden="true"></i>día <span id="j-dia-h">—</span> h</span>
          <span class="text-telecab-text">noche <span id="j-noche-h">—</span> h<i class="fa-solid fa-moon text-telecab-azul ml-1" aria-hidden="true"></i></span>
        </div>
      </div>`) %>
  </div>

  <!-- ── KILÓMETROS, POR TURNO ───────────────────────────────────────────────
       En las MISMAS ventanas que las horas de arriba, para poder compararlas.
       EN BOLT = viaje + espera (trabajo). FUERA = descanso (el "busy") +
       desconectado: el coche anda y no está produciendo. -->
  <h2 class="text-xs font-semibold text-telecab-text uppercase tracking-wider mb-2">
    Kilómetros por turno
    <span class="font-normal text-telecab-muted normal-case tracking-normal">· en BOLT (viaje + espera) contra fuera (descanso + desconectado)</span>
  </h2>
  <%
    /* Una tarjeta de turno: el total grande y el reparto debajo, con su barra.
       El % que se lee es el de FUERA, que es lo que se mira: el total sube con
       la actividad, la proporción no. */
    function kmTurno(id) {
      return `<div class="rounded-2xl border border-telecab-border bg-telecab-card p-4">
        <p class="text-[11px] text-telecab-muted uppercase tracking-wide" id="${id}-etq">—</p>
        <p class="text-3xl font-bold text-telecab-text mt-1 tabular-nums leading-none">
          <span id="${id}-tot">—</span><span class="text-sm text-telecab-muted font-normal ml-1">km</span></p>
        <div class="mt-3 flex h-2 rounded-full overflow-hidden bg-telecab-card2" id="${id}-barra">
          <div id="${id}-bar-bolt" class="h-full bg-telecab-green" style="width:0%"></div>
          <div id="${id}-bar-fuera" class="h-full bg-telecab-red" style="width:0%"></div>
        </div>
        <div class="flex justify-between text-[11px] mt-1.5" id="${id}-pie">
          <span class="text-telecab-green"><span id="${id}-bolt">—</span> km en BOLT</span>
          <span class="text-telecab-red"><span id="${id}-fuera">—</span> km fuera · <span id="${id}-pct">—</span> %</span>
        </div>
        <p class="text-[11px] text-telecab-muted mt-1.5 hidden" id="${id}-vacio">El turno acaba de empezar: todavía no ha rodado nadie.</p>
      </div>`;
    }
  %>
  <div class="grid grid-cols-1 xl:grid-cols-3 gap-3 mb-4">
    <%- kmTurno('k-kd') %>
    <%- kmTurno('k-kn') %>
    <%- kmTurno('k-ka') %>
  </div>

  <p class="text-[11px] text-telecab-muted mb-7">
    La ventana de día es 05:00–17:00 y la de noche 17:00–05:00, las mismas que las horas. Ojo: cada ventana
    recoge también la <b class="text-telecab-text">cola del otro turno</b> —quien terminó a las 05:51 rodó
    dentro del día—, así que estos kilómetros son los de LA FRANJA, no los de la gente del turno.
    Los kilómetros salen de los <b class="text-telecab-text">trayectos de Mapon</b>, no del salto de odómetro:
    esa otra fuente solo habla a ratos y daba menos de la décima parte de lo que rueda la flota. Cada trayecto
    se reparte entre las situaciones que pisa en proporción al tiempo, así que un viaje que cae mitad en trabajo
    y mitad en descanso cuenta mitad y mitad. Es la misma cuenta que usan el cockpit y los reportes.
    El detalle matrícula a matrícula está en
    <a href="/operaciones/auditoria" class="text-telecab-gold hover:underline">Auditoría de flota</a>.
  </p>

  <%
    /* Las demás cifras, en pequeño: siguen a mano, pero no compiten con las de
       arriba. */
    function cifraPeq(id, etq, unidad, pie, ayuda) {
      return `<div class="rounded-xl border border-telecab-border bg-telecab-card px-3 py-2.5"${
        ayuda ? ` title="${ayuda.replace(/"/g, '&quot;')}"` : ''}>
        <p class="text-[11px] text-telecab-muted">${etq}</p>
        <p class="text-lg font-bold text-telecab-text tabular-nums leading-tight mt-0.5">
          <span id="${id}">—</span>${unidad ? `<span class="text-xs text-telecab-muted font-normal ml-1">${unidad}</span>` : ''}
        </p>
        <p class="text-[11px] text-telecab-muted" id="${id}-pie">${pie || ''}</p>
      </div>`;
    }
  %>
  <h2 class="text-xs font-semibold text-telecab-text uppercase tracking-wider mb-2">
    Más cifras <span class="font-normal text-telecab-muted normal-case tracking-normal" id="i-ne-nota"></span>
  </h2>
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 mb-8">
    <%- cifraPeq('k-hoy-h', 'Hoy · día natural', 'h', '00:00 – 24:00, en curso',
      'Lo que lleva la flota HOY de 00:00 a 24:00: lo que cuadra con el informe de BOLT.\nEl descanso no cuenta: efectivo es viaje + espera.') %>
    <%- cifraPeq('k-sem-h', 'Esta semana', 'h', 'desde el lunes') %>
    <%- cifraPeq('k-mes-neto', 'Neto del mes', '€', '<span id="k-mes-viajes">—</span> viajes',
      'Lo que queda después de la comisión de BOLT, sumando todos los viajes del mes.\nNo es la facturación: es lo que entra.') %>
    <%- cifraPeq('k-mes-util', 'Utilización del mes', '%', 'tiempo conectado con pasajero',
      'Horas EN VIAJE sobre horas efectivas (viaje + espera).\nMide cuánto del tiempo conectado va cargado. Por debajo del 65 % hay demasiada espera.') %>
    <%- cifraPeq('k-ne-h', 'Sin hacer · última jornada', 'h', '<span id="k-ne-pct">—</span> % de lo que tocaba',
      'Lo que faltó para completar la jornada de quien debía salir: no es el descanso, es la resta.\nPor persona y sin compensar, y solo de jornadas cerradas.') %>
    <%- cifraPeq('k-ne-sin', 'No salieron · última jornada', '', 'de <span id="k-ne-personas">—</span> a los que tocaba') %>
    <%- cifraPeq('k-ne-just', 'Justificadas · última jornada', 'h', 'taller, gestiones… sí cuentan') %>
    <%- cifraPeq('k-ne-mes', 'Sin hacer · el mes', 'h', '<span id="k-ne-mes-pct">—</span> % de lo que tocaba') %>
  </div>
</div>

<script>
(function () {
  const $ = s => document.querySelector(s);
  const num = (n, d) => (n == null ? '—' : Number(n).toLocaleString('es-ES',
    { minimumFractionDigits: d || 0, maximumFractionDigits: d || 0 }));
  const pon = (id, v, d) => { const e = $('#' + id); if (e) e.textContent = num(v, d); };
  const txt = (id, t) => { const e = $('#' + id); if (e) e.textContent = t; };
  const esFecha = iso => { if (!iso) return ''; const [a, m, dd] = iso.split('-'); return `${dd}/${m}/${a}`; };
  const hhmm = h => String(Math.floor(h) % 24).padStart(2, '0') + ':' + String(Math.round((h % 1) * 60) % 60).padStart(2, '0');
  const duracion = h => { const m = Math.round(h * 60); return m >= 60 ? `${Math.floor(m / 60)} h ${String(m % 60).padStart(2, '0')} min` : `${m} min`; };
  const MESES = ['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre'];

  // EL COLOR DE LA META, el mismo de Visibilidad (views/visibilidad.ejs, colorMeta):
  // de rojo a amarillo según se acerca y verde al cumplirla. Si un día cambia allí,
  // que cambie aquí también: las dos pantallas enseñan las mismas metas.
  function colorMeta(pct) {
    const p = Math.max(0, Number(pct) || 0);
    if (p >= 100) return 'hsl(120 72% 42%)';
    const t = Math.max(0, (p - 40) / 60);
    return `hsl(${Math.round(t * 55)} 78% 50%)`;
  }

  async function cargar(forzar) {
    const b = $('#i-refrescar');
    if (b) b.disabled = true;
    try {
      // `forzar` solo cuando se pulsa Actualizar: entrar a la pantalla sirve lo
      // cacheado (instantáneo), pero pedir refresco a mano tiene que recalcular de
      // verdad o el botón no hace nada visible.
      const r = await fetch('/inicio/api/panel' + (forzar ? '?forzar=1' : ''));
      const j = await r.json();
      if (j.status !== 'ok') throw new Error(j.msg || 'No se pudo cargar');
      pintar(j);
      $('#i-error').classList.add('hidden');
    } catch (e) {
      const el = $('#i-error');
      el.textContent = 'No se han podido cargar las cifras: ' + e.message;
      el.classList.remove('hidden');
    } finally { if (b) b.disabled = false; }
  }

  /** Las horas contra su meta: la cifra y la barra con el color de lo cerca que está. */
  function conMeta(id, horas, meta) {
    const bar = $('#' + id + '-bar'), h = $('#' + id + '-h');
    if (!(meta > 0)) {
      txt(id + '-meta', '');
      if (bar) { bar.style.width = '0%'; }
      return null;
    }
    const pct = (Number(horas) || 0) / meta * 100;
    txt(id + '-meta', '/ ' + num(meta) + ' h');
    const color = colorMeta(pct);
    if (bar) { bar.style.width = Math.min(100, pct) + '%'; bar.style.backgroundColor = color; }
    if (h) h.style.color = color;
    const caja = $('#' + id + '-barcaja');
    if (caja) caja.title = `${num(horas, 1)} h de ${num(meta)} · ${num(pct, 1)} % de la meta`;
    return pct;
  }

  /** Los conductores de un turno, como los cuenta Control: los del cuadrante y los NN. */
  function conductores(id, s) {
    pon(id + '-cond', s.conductores);
    const nn = Number(s.conductoresNN) || 0;
    const plan = Math.max(0, (Number(s.conductores) || 0) - nn);
    txt(id + '-cond-det', nn ? `${plan} del cuadrante + ${nn} NN` : 'todos del cuadrante');
    const caja = $('#' + id + '-cond-det');
    if (caja) caja.title = nn
      ? `${plan} del cuadrante (en Control, los que salieron en la pestaña del turno) y ${nn} sin plan con ${num(s.horasNN, 1)} h (los NN, que van por su hora de inicio)`
      : 'Todos los que han salido estaban en el cuadrante';
  }

  /** Las barras del mes, día a día, en SVG: sin librerías y con los colores del tema. */
  function barrasMes(serie) {
    const caja = $('#m-dias');
    if (!caja || !serie || !serie.dias || !serie.dias.length) return;
    const dias = serie.dias, n = dias.length;
    const ultimo = serie.ultimoConDatos || 0, hoyD = serie.hoyDia;
    const tope = Math.max(serie.idealDiario || 0, ...dias.map(d => d.total || 0)) * 1.12 || 1;
    const W = n * 10, H = 60, ancho = 7;
    const y = v => H - (v / tope) * H;
    let s = `<svg viewBox="0 0 ${W} ${H}" preserveAspectRatio="none" class="w-full h-full overflow-visible" aria-hidden="true">`;
    dias.forEach((d, i) => {
      const x = i * 10 + (10 - ancho) / 2;
      const esHoy = d.dia === hoyD, futuro = d.dia > ultimo;
      if (futuro) {
        s += `<rect x="${x}" y="${H - 1.5}" width="${ancho}" height="1.5" rx="0.75" style="fill: rgb(var(--tc-card2))"><title>${d.dia}: aún no ha llegado</title></rect>`;
        return;
      }
      const alto = Math.max(1.5, H - y(d.total || 0));
      s += `<rect x="${x}" y="${H - alto}" width="${ancho}" height="${alto}" rx="1.2"
               style="fill: rgb(var(--tc-gold) / ${esHoy ? 0.4 : 0.9})"><title>${d.dia}${esHoy ? ' (hoy, en curso)' : ''}: ${num(d.total, 1)} h</title></rect>`;
    });
    if (serie.idealDiario > 0) {
      const yi = y(serie.idealDiario).toFixed(2);
      s += `<line x1="0" x2="${W}" y1="${yi}" y2="${yi}" stroke-dasharray="3 3" vector-effect="non-scaling-stroke"
               style="stroke: rgb(var(--tc-text) / 0.55); stroke-width: 1"><title>Ritmo que pide la meta: ${num(serie.idealDiario)} h al día</title></line>`;
    }
    caja.innerHTML = s + '</svg>';
    // El eje: el 1, cada semana y el último día del mes.
    const marcas = [1, 8, 15, 22, n].filter((v, i, a) => v <= n && a.indexOf(v) === i);
    $('#m-dias-eje').innerHTML = marcas.map(m => `<span>${m}</span>`).join('');
  }

  function pintarMes(j, cfg) {
    const v = j.visibilidad || {}, mes = v.mes || {}, serie = j.mesSerie || {};
    txt('m-nombre', serie.mes ? '· ' + MESES[serie.mes - 1] : '');
    pon('m-h', mes.horasEfectivas, 0);
    txt('m-cond', mes.conductores != null ? `${num(mes.conductores)} conductores` : '');
    const meta = Number(cfg.meta) || 0;
    const total = Number(mes.horasEfectivas) || 0;
    // Lo de los días cerrados y lo de hoy, por separado: el ideal es a cierre de
    // ayer, así que se compara con lo entero, no con lo que aún corre.
    const dias = serie.dias || [], hoyD = serie.hoyDia;
    const ayer = hoyD && hoyD > 1 ? dias[hoyD - 2] : null;
    const cerrado = ayer ? Number(ayer.acumulado) || 0 : 0;
    const deHoy = Math.max(0, total - cerrado);
    const bar = $('#m-bar'), barHoy = $('#m-bar-hoy'), marca = $('#m-ideal');
    if (meta > 0) {
      txt('m-meta', '/ ' + num(meta) + ' h');
      bar.style.width = Math.min(100, cerrado / meta * 100) + '%';
      barHoy.style.width = Math.max(0, Math.min(100 - cerrado / meta * 100, deHoy / meta * 100)) + '%';
      $('#m-barcaja').title = `${num(cerrado, 1)} h de los días cerrados + ${num(deHoy, 1)} h de hoy, de ${num(meta)} h`;
      const pct = total / meta * 100;
      let pie = `${num(pct, 1)} % de la meta`;
      if (ayer) {
        marca.classList.remove('hidden');
        marca.style.left = `calc(${Math.min(100, ayer.ideal / meta * 100)}% - 1px)`;
        marca.title = `El ideal a cierre de ayer: ${num(ayer.ideal)} h`;
        const b = Number(ayer.brecha) || 0;
        pie += ` · a cierre de ayer, <b class="${b >= 0 ? 'text-telecab-green' : 'text-telecab-red'} tabular-nums">${b >= 0 ? '+' : '−'}${num(Math.abs(b))} h</b> ${b >= 0 ? 'por delante del' : 'por detrás del'} ideal`;
      } else marca.classList.add('hidden');
      $('#m-pie').innerHTML = pie;
    } else {
      txt('m-meta', '');
      txt('m-pie', 'Sin meta del mes: se pone en Visibilidad, en Configuración.');
    }
    txt('m-ritmo', serie.idealDiario ? `(${num(serie.idealDiario)} h/día)` : '');
    barrasMes(serie);
  }

  function pintarTurnos(j, cfg) {
    const v = j.visibilidad || {};
    const enCurso = j.turnoActual === 'dia' ? 'dia' : 'noche';
    const actual = (enCurso === 'dia' ? v.turnoDia : v.turnoNoche) || {};
    const antes = (enCurso === 'dia' ? v.turnoNoche : v.turnoDia) || {};
    const metaDe = t => Number(t === 'dia' ? cfg.meta_turno_dia_h : cfg.meta_turno_noche_h) || 0;
    const otro = enCurso === 'dia' ? 'noche' : 'dia';

    // El turno en curso.
    const icono = $('#t-icono');
    icono.className = 'inline-flex w-7 h-7 items-center justify-center rounded-full ' +
      (enCurso === 'dia' ? 'bg-telecab-gold/15 text-telecab-gold' : 'bg-telecab-azul/15 text-telecab-azul');
    icono.innerHTML = `<i class="fa-solid ${enCurso === 'dia' ? 'fa-sun' : 'fa-moon'} text-[13px]"></i>`;
    txt('t-etq', enCurso === 'dia' ? 'Turno de día · en curso' : 'Turno de noche · en curso');
    const [ini, fin] = (j.turnos || {})[enCurso] || [enCurso === 'dia' ? 5 : 17, enCurso === 'dia' ? 17 : 5];
    txt('t-ventana', `${hhmm(ini)} – ${hhmm(fin)}`);
    pon('t-h', actual.horasEfectivas, 1);
    const pct = conMeta('t', actual.horasEfectivas, metaDe(enCurso));
    conductores('t', actual);
    const jornadaH = Number(j.jornadaH) || 8;
    pintarPrevision('t', actual, {
      titulo: (enCurso === 'dia' ? 'Turno de día' : 'Turno de noche') + ' en curso · quién lleva ya su jornada',
      abierta: true, meta: metaDe(enCurso), jornadaH,
    });
    $('#t-pie').textContent = pct == null ? 'Sin meta del turno: se pone en Visibilidad.'
      : `${num(pct, 1)} % de la meta del turno de ${enCurso === 'dia' ? 'día' : 'noche'}`;
    const vi = Number(actual.viajeH) || 0, es = Number(actual.esperaH) || 0, tot = vi + es;
    $('#t-viaje').style.width = (tot ? vi / tot * 100 : 0) + '%';
    $('#t-espera').style.width = (tot ? es / tot * 100 : 0) + '%';
    pon('t-viaje-h', vi, 1); pon('t-espera-h', es, 1); pon('t-util', actual.utilizacion, 1);
    // El reloj del turno.
    const dur = ((fin - ini) + 24) % 24 || 12;
    const lleva = Math.min(dur, ((Number(j.horaMadrid) - ini) + 24) % 24);
    txt('t-ini', hhmm(ini)); txt('t-fin', hhmm(fin));
    $('#t-reloj').style.width = (lleva / dur * 100) + '%';
    txt('t-queda', lleva < 0.25 ? 'acaba de empezar' : `lleva ${duracion(lleva)} · quedan ${duracion(dur - lleva)}`);
    $('#t-reloj-caja').title = `Ventana estándar del turno: ${hhmm(ini)} a ${hhmm(fin)}`;

    // El turno anterior.
    const ic = $('#p-icono');
    ic.className = 'inline-flex w-6 h-6 items-center justify-center rounded-full ' +
      (otro === 'dia' ? 'bg-telecab-gold/15 text-telecab-gold' : 'bg-telecab-azul/15 text-telecab-azul');
    ic.innerHTML = `<i class="fa-solid ${otro === 'dia' ? 'fa-sun' : 'fa-moon'} text-[11px]"></i>`;
    // «Turno noche · anoche», «Turno día · hoy»…: la etiqueta de Visibilidad.
    txt('p-etq', (antes.etq || (otro === 'dia' ? 'Turno día' : 'Turno noche')).replace(/^Turno (día|noche)/, 'Turno de $1'));
    pon('p-h', antes.horasEfectivas, 1);
    const pp = conMeta('p', antes.horasEfectivas, metaDe(otro));
    conductores('p', antes);
    $('#p-pie').textContent = (pp == null ? '' : `${num(pp, 1)} % de la meta · `) +
      `${num(antes.utilizacion, 1)} % utilización`;
    // Lo que aún puede crecer: la noche suma hasta las 12:00 y el día hasta las 24:00.
    const h = Number(j.horaMadrid);
    const abierto = otro === 'noche' ? (enCurso === 'dia' && h < 12) : (enCurso === 'noche' && h >= 12);
    txt('p-estado', abierto ? (otro === 'noche' ? 'aún suma hasta las 12:00' : 'aún suma hasta las 24:00') : 'cerrado');
    pintarPrevision('p', antes, {
      titulo: ($('#p-etq').textContent || 'Turno anterior') + ' · quién hizo su jornada',
      abierta: abierto, meta: metaDe(otro), jornadaH,
    });
  }

  function pintarJornada(j, cfg) {
    const a = (j.visibilidad || {}).ayerJornada || {};
    txt('j-etq', `Jornada pasada · ${esFecha(a.dia)}`);
    const ic = $('#j-icono'); if (ic) ic.className = 'inline-flex w-6 h-6 items-center justify-center rounded-full bg-telecab-card2 text-telecab-muted';
    txt('j-estado', a.parcial ? 'se cierra a las 12:00' : 'completa');
    pon('j-h', a.horasEfectivas, 1);
    // La meta de la jornada es la suma de las dos de turno, como en Visibilidad.
    const meta = (Number(cfg.meta_turno_dia_h) || 0) + (Number(cfg.meta_turno_noche_h) || 0);
    const pct = conMeta('j', a.horasEfectivas, meta);
    conductores('j', a);
    $('#j-pie').textContent = (pct == null ? '' : `${num(pct, 1)} % de la meta de día + noche · `) +
      `${num(a.utilizacion, 1)} % utilización`;
    const p = a.partes || {}, d = Number(p.dia) || 0, n = Number(p.noche) || 0, t = d + n;
    $('#j-dia').style.width = (t ? d / t * 100 : 0) + '%';
    $('#j-noche').style.width = (t ? n / t * 100 : 0) + '%';
    pon('j-dia-h', d, 1); pon('j-noche-h', n, 1);
    $('#j-split').title = `Turno de día ${num(d, 1)} h · turno de noche ${num(n, 1)} h`;
    // En la jornada, lo de cada uno es su día más su noche.
    pintarPrevision('j', a, {
      titulo: `Jornada pasada · ${esFecha(a.dia)} · quién hizo su jornada`,
      abierta: !!a.parcial, meta, jornadaH: Number(j.jornadaH) || 8,
    });
  }

  // ── QUIÉN LLEVA YA SU JORNADA ─────────────────────────────────────────────
  // Lo de cada tarjeta se guarda aquí para abrir su lista al pulsar.
  const PREV = {};
  const esc = s => String(s == null ? '' : s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const AHORA = {
    viaje: { txt: 'en viaje', cls: 'text-telecab-green' },
    espera: { txt: 'en espera', cls: 'text-telecab-gold' },
    descanso: { txt: 'en descanso', cls: 'text-telecab-warn' },
  };

  /**
   * El resumen de la tarjeta: cuántos han hecho ya su jornada y a cuántos les
   * falta. `abierta` = el turno aún suma: entonces se dice a cuánto llegaría si
   * los que faltan la completaran; cerrado, cuánto les faltó.
   */
  function pintarPrevision(id, t, { titulo, abierta, meta, jornadaH }) {
    const b = $('#' + id + '-prev');
    const p = t && t.prevision;
    if (!b || !p || !(t.gente || []).length) { if (b) b.classList.add('hidden'); return; }
    PREV[id] = { t, titulo, abierta, meta, jornadaH };
    b.classList.remove('hidden');
    const total = p.cumplen + p.faltan;
    pon(id + '-prev-ok', p.cumplen);
    txt(id + '-prev-ok-txt', `ya llevan sus ${num(jornadaH)} h`);
    pon(id + '-prev-falta', p.faltan);
    txt(id + '-prev-falta-txt', p.faltan ? `les faltan · ${num(p.faltanH, 1)} h entre todos` : 'les faltan');
    $('#' + id + '-prev-bar-ok').style.width = (total ? p.cumplen / total * 100 : 0) + '%';
    $('#' + id + '-prev-bar-falta').style.width = (total ? p.faltan / total * 100 : 0) + '%';
    let pie;
    if (!p.faltan) pie = `Todos han hecho ya sus ${num(jornadaH)} h.`;
    else if (abierta) {
      const llega = meta > 0 && p.siCompletan >= meta;
      pie = `Si los ${num(p.faltan)} completan sus ${num(jornadaH)} h, el turno llega a ` +
        `<b class="tabular-nums ${meta > 0 ? (llega ? 'text-telecab-green' : 'text-telecab-red') : 'text-telecab-text'}">${num(p.siCompletan, 1)} h</b>` +
        (meta > 0 ? ` de ${num(meta)}${llega ? '' : ' (no llega)'}` : '') +
        ` · ${num(p.faltanConectados)} de ellos siguen conectados`;
    } else pie = `A ${num(p.faltan)} les faltaron ${num(p.faltanH, 1)} h para llegar a sus ${num(jornadaH)} h.`;
    $('#' + id + '-prev-pie').innerHTML = pie;
    b.setAttribute('aria-label', `${p.cumplen} ya llevan sus ${jornadaH} h y a ${p.faltan} les faltan. Ver la lista.`);
  }

  /** La lista de la tarjeta, de más horas a menos, partida por la jornada. */
  function abrirLista(id) {
    const x = PREV[id];
    if (!x || !window.Dialogo) return;
    const { t, titulo, abierta, meta, jornadaH } = x;
    const fila = (g, i) => {
      const pct = Math.min(100, g.h / jornadaH * 100);
      const ok = g.h >= jornadaH;
      const a = g.ahora && AHORA[g.ahora.situacion];
      const estado = a ? a.txt : 'desconectado', mat = a && g.ahora.matricula ? esc(g.ahora.matricula) : '';
      // En el móvil no caben cuatro columnas: lo que hace ahora va debajo del nombre.
      return `<div class="flex items-center gap-2 sm:gap-3 py-2 border-b border-telecab-border/50 last:border-0">
        <span class="w-5 sm:w-6 shrink-0 text-right text-[11px] text-telecab-muted tabular-nums">${i + 1}</span>
        <div class="flex-1 min-w-0">
          <p class="text-sm text-telecab-text truncate" title="${esc(g.nombre)}">${esc(g.nombre)}${g.nn ? ' <span class="ml-1 px-1.5 py-0.5 rounded bg-telecab-warn/15 text-telecab-warn text-[10px] font-semibold align-middle" title="Sin plan en el cuadrante: va por su hora de inicio">NN</span>' : ''}</p>
          <div class="mt-1 h-1.5 rounded-full bg-telecab-card2 overflow-hidden"><div class="h-full rounded-full ${ok ? 'bg-telecab-green' : 'bg-telecab-warn/70'}" style="width:${pct}%"></div></div>
          <p class="sm:hidden mt-0.5 text-[11px] ${a ? a.cls : 'text-telecab-muted'}">${estado}${mat ? ` <span class="text-telecab-muted tabular-nums">· ${mat}</span>` : ''}</p>
        </div>
        <span class="hidden sm:block w-28 shrink-0 text-[11px] text-right ${a ? a.cls : 'text-telecab-muted'}">${estado}${mat ? `<br><span class="text-telecab-muted tabular-nums">${mat}</span>` : ''}</span>
        <span class="w-[4.5rem] sm:w-24 shrink-0 text-right tabular-nums">
          <b class="text-sm text-telecab-text">${num(g.h, 1)} h</b><br>
          <span class="text-[11px] ${ok ? 'text-telecab-green' : 'text-telecab-warn'}">${ok ? (g.h > jornadaH ? '+' + num(g.h - jornadaH, 1) + ' h' : 'justo') : 'faltan ' + num(jornadaH - g.h, 1) + ' h'}</span>
        </span>
      </div>`;
    };
    const gente = t.gente || [];
    const hechos = gente.filter(g => g.h >= jornadaH), faltan = gente.filter(g => g.h < jornadaH);
    const p = t.prevision || {};
    const grupo = (etq, cls, lista, desde) => lista.length
      ? `<p class="mt-3 mb-1 text-[11px] font-semibold uppercase tracking-wider ${cls}">${etq} · ${lista.length}</p>` + lista.map((g, i) => fila(g, desde + i)).join('')
      : '';
    const cabeza = `<p class="text-sm text-telecab-muted">${num(gente.length)} conductores · <b class="text-telecab-text tabular-nums">${num(t.horasEfectivas, 1)} h</b>` +
      (meta > 0 ? ` de ${num(meta)}` : '') +
      (p.faltan && abierta ? ` · si los que faltan completan sus ${num(jornadaH)} h: <b class="tabular-nums ${meta > 0 && p.siCompletan >= meta ? 'text-telecab-green' : 'text-telecab-red'}">${num(p.siCompletan, 1)} h</b>` : '') +
      `</p><p class="text-[11px] text-telecab-muted mt-1">Horas efectivas (viaje + espera) de cada uno en este turno, con la regla de Visibilidad. «Desconectado» es lo que dice BOLT ahora mismo.</p>`;
    Dialogo.aviso({
      titulo, tono: 'info', ancho: 'max-w-2xl', boton: 'Cerrar',
      html: cabeza + `<div class="mt-2 max-h-[60vh] overflow-y-auto pr-1">` +
        grupo(`Ya llevan sus ${num(jornadaH)} h`, 'text-telecab-green', hechos, 0) +
        grupo('Les faltan', 'text-telecab-warn', faltan, hechos.length) + '</div>',
    });
  }
  ['t', 'p', 'j'].forEach(id => { const b = $('#' + id + '-prev'); if (b) b.addEventListener('click', () => abrirLista(id)); });

  function pintar(j) {
    const v = j.visibilidad || {};
    const cfg = v.config || {};
    // De cuándo es lo que se está viendo. Hace falta decirlo: el panel sirve lo
    // último calculado y refresca por detrás, así que puede tener unos minutos.
    const edad = Math.round((j.edadMs || 0) / 1000);
    $('#i-jornada').textContent = `Jornada del ${esFecha(j.jornadaEnCurso)}` +
      (edad > 60 ? ` · datos de hace ${Math.round(edad / 60)} min` : '');

    pintarMes(j, cfg);
    pintarTurnos(j, cfg);
    pintarJornada(j, cfg);

    // Más cifras.
    pon('k-hoy-h', (v.dia || {}).horasEfectivas, 1);
    pon('k-sem-h', (v.semana || {}).horasEfectivas, 1);
    const mes = v.mes || {};
    pon('k-mes-neto', mes.neto);
    pon('k-mes-viajes', mes.viajes);
    pon('k-mes-util', mes.utilizacion, 1);
    const ne = (j.noEfectivas || {}).cerrada || {};
    const nem = (j.noEfectivas || {}).mes || {};
    $('#i-ne-nota').textContent =
      `· lo «sin hacer» es de la jornada del ${esFecha(j.jornadaCerrada)}, ya cerrada, con ${j.jornadaH} h por persona`;
    pon('k-ne-h', ne.horas, 1);
    pon('k-ne-pct', ne.porcentaje, 1);
    pon('k-ne-sin', ne.sinSalir);
    pon('k-ne-personas', ne.personasDia);
    pon('k-ne-just', ne.justificadas, 1);
    pon('k-ne-mes', nem.horas, 1);
    pon('k-ne-mes-pct', nem.porcentaje, 1);

    // Kilómetros por turno. La barra parte el total en lo que se rodó dentro de
    // BOLT y lo que se rodó fuera; los dos trozos suman el 100 %, así que se ve
    // la proporción sin leer el número.
    const ponKm = (id, k) => {
      if (!k) return;
      const e = $('#' + id + '-etq'); if (e) e.textContent = k.etq || '';
      pon(id + '-tot', k.total);
      pon(id + '-bolt', k.enBolt);
      pon(id + '-fuera', k.fuera);
      pon(id + '-pct', k.porcentajeFuera, 1);
      const t = k.total || 0;
      const pb = t > 0 ? (k.enBolt / t) * 100 : 0;
      const bb = $('#' + id + '-bar-bolt'), bf = $('#' + id + '-bar-fuera');
      if (bb) bb.style.width = pb + '%';
      if (bf) bf.style.width = (t > 0 ? 100 - pb : 0) + '%';
      const barra = $('#' + id + '-barra');
      if (barra) barra.title = `${num(k.enBolt)} km en BOLT · ${num(k.fuera)} km fuera`;
      // Un turno recién empezado son ceros de verdad, no un fallo. Se dice, en vez
      // de enseñar "0 km fuera · — %", que parece la pantalla rota.
      const vacio = t === 0;
      const pie = $('#' + id + '-pie'), aviso = $('#' + id + '-vacio'), caja = $('#' + id + '-barra');
      if (pie) pie.classList.toggle('hidden', vacio);
      if (aviso) aviso.classList.toggle('hidden', !vacio);
      if (caja) caja.classList.toggle('hidden', vacio);
    };
    ponKm('k-kd', (j.km || {}).dia);
    ponKm('k-kn', (j.km || {}).noche);
    ponKm('k-ka', (j.km || {}).ayer);
  }

  const b = $('#i-refrescar');
  if (b) b.addEventListener('click', () => cargar(true));
  cargar();
})();
</script>
<% } %>
