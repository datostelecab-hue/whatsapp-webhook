<div class="p-4 lg:p-6 space-y-4">

  <!-- KPIs de flota -->
  <div id="kpis-flota" class="grid grid-cols-2 lg:grid-cols-4 gap-3">
    <% ['Conductores activos','Ausentes esta semana','Horas del mes','Bajas médicas activas'].forEach(function(k){ %>
      <div class="bg-telecab-card border border-telecab-border rounded-2xl px-4 py-3">
        <p class="text-[11px] uppercase tracking-wide text-telecab-muted"><%= k %></p>
        <p class="kpi-val text-2xl font-bold text-telecab-text">–</p>
      </div>
    <% }); %>
  </div>

  <!-- Maestro-detalle -->
  <div class="flex flex-col lg:flex-row gap-4 lg:h-[calc(100vh-13rem)]">
    <aside class="lg:w-80 shrink-0 bg-telecab-card border border-telecab-border rounded-2xl flex flex-col lg:h-full overflow-hidden">
      <div class="p-3 border-b border-telecab-border">
        <input id="b-buscar" class="w-full bg-telecab-dark border border-telecab-border rounded-xl px-3 py-2 text-sm text-telecab-text focus:outline-none focus:border-telecab-gold transition" placeholder="Buscar conductor…" autocomplete="off">
        <p id="b-count" class="text-[11px] text-telecab-muted mt-1.5"></p>
      </div>
      <div id="b-lista" class="flex-1 overflow-y-auto p-2 space-y-1 max-h-[40vh] lg:max-h-none"></div>
    </aside>

    <section class="flex-1 bg-telecab-card border border-telecab-border rounded-2xl overflow-y-auto lg:h-full">
      <div id="b-default" class="p-5"></div>
      <div id="b-detalle" class="p-5 hidden"></div>
    </section>
  </div>
</div>

<script>
  const $ = s => document.querySelector(s);
  const esc = s => String(s == null ? '' : s).replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
  const rol = '<%= rol || "" %>';   // rol REAL de la sesión (lo inyecta el servidor)

  // Colores desde los tokens globales (canales RGB → se pueden teñir y cambian con el tema).
  const CH = { V: 'var(--tc-vac)', B: 'var(--tc-med)', P: 'var(--tc-permiso)', J: 'var(--tc-just)' };
  const clr = t => `rgb(${CH[t]})`;            // color sólido de una ausencia
  const tintClr = t => `rgb(${CH[t]} / .14)`;  // su fondo tenue
  const NOM = { V: 'Vacaciones', B: 'Baja médica', P: 'Permiso', J: 'Justificante' };
  const HCOL = 'rgb(var(--tc-green))';
  const TRACK = 'rgb(var(--tc-dark))', LINEA = 'rgb(var(--tc-border))', LIBR = 'rgb(var(--tc-muted) / .28)';
  const ABBR = ['ene','feb','mar','abr','may','jun','jul','ago','sep','oct','nov','dic'];
  const DOW = ['L','M','X','J','V','S','D'];

  let DATA = null, MESES = [], SEL = null;
  let level = 'mes', mIdx = 0, wIdx = 0;

  const esAus = v => v === 'V' || v === 'B' || v === 'P';
  const dia = (c, d) => (d >= 0 && d < c.dias.length ? c.dias[d] : null);

  function construirMeses(ini) {
    const M = []; let cur = null;
    for (let d = 0; d < 365; d++) {
      const dt = new Date(Date.UTC(ini.y, ini.m, ini.d + d));
      const y = dt.getUTCFullYear(), mo = dt.getUTCMonth();
      if (!cur || cur.y !== y || cur.mo !== mo) { cur = { y, mo, label: ABBR[mo] + ' ' + y, start: d, len: 0, dias: [] }; M.push(cur); }
      cur.len++; cur.dias.push(d);
    }
    return M;
  }
  const mesDeHoy = () => Math.max(0, MESES.findIndex(m => DATA.hoyIdx >= m.start && DATA.hoyIdx < m.start + m.len));
  const semDeHoy = () => Math.floor(DATA.hoyIdx / 7);

  // Rangos de ausencia (nº de periodos consecutivos por tipo) en un array de días.
  function rangos(dias) {
    const r = { V: 0, B: 0, P: 0 }; let prev = null;
    for (let d = 0; d < dias.length; d++) { const v = dias[d]; if (esAus(v)) { if (prev !== v) r[v]++; prev = v; } else prev = null; }
    return r;
  }
  function horasEn(c, ini, fin) { let h = 0; for (let d = ini; d <= fin; d++) { const v = dia(c, d); if (typeof v === 'number' && v > 0) h += v; } return h; }

  // ---------- KPIs de flota ----------
  function pintarKpisFlota() {
    const wk = semDeHoy(), wa = wk * 7, wb = wk * 7 + 6;
    const mes = MESES[mesDeHoy()];
    let activos = 0, ausSem = 0, horasMes = 0, bMed = 0;
    DATA.conductores.forEach(c => {
      if (/Activo/i.test(c.estado)) activos++;
      let aus = false; for (let d = wa; d <= wb; d++) if (esAus(dia(c, d))) aus = true;
      if (aus) ausSem++;
      mes.dias.forEach(d => { const v = dia(c, d); if (typeof v === 'number' && v > 0) horasMes += v; });
      if (dia(c, DATA.hoyIdx) === 'B') bMed++;
    });
    const vals = [activos, ausSem, Math.round(horasMes).toLocaleString('es-ES'), bMed];
    document.querySelectorAll('#kpis-flota .kpi-val').forEach((el, i) => { el.textContent = vals[i]; });
  }

  // ---------- Lista de conductores ----------
  function badges(r) {
    let h = '';
    ['B', 'V', 'P'].forEach(t => { if (r[t]) h += `<span style="background:${tintClr(t)};color:${clr(t)};" class="text-[10px] px-1.5 py-0.5 rounded font-semibold">${t}${r[t]}</span>`; });
    return h || '<span class="text-[10px] text-telecab-muted">sin ausencias</span>';
  }
  function pintarLista() {
    const q = $('#b-buscar').value.trim().toLowerCase();
    const mes = MESES[mesDeHoy()];
    const vis = DATA.conductores.filter(c => !q || c.id.toLowerCase().includes(q));
    const cont = $('#b-lista'); cont.innerHTML = '';
    if (!vis.length) { cont.innerHTML = '<p class="text-telecab-muted text-sm p-3">Sin resultados.</p>'; }
    vis.forEach(c => {
      const r = rangos(c.dias);
      const hMes = Math.round(horasEn(c, mes.start, mes.start + mes.len - 1));
      const el = document.createElement('button');
      el.type = 'button';
      el.className = 'w-full text-left px-2.5 py-2 rounded-xl hover:bg-telecab-card2 transition' + (SEL === c.id ? ' bg-telecab-card2' : '');
      el.dataset.id = c.id;
      el.innerHTML =
        `<div class="flex items-center gap-2">
           <span class="min-w-0 flex-1 text-sm text-telecab-text truncate">${esc(c.id)}</span>
           <span class="text-[11px] text-telecab-muted whitespace-nowrap">${hMes} h</span>
         </div>
         <div class="flex flex-wrap gap-1 mt-1">${badges(r)}</div>`;
      el.addEventListener('click', () => abrir(c.id));
      cont.appendChild(el);
    });
    $('#b-count').textContent = `${vis.length} de ${DATA.conductores.length} conductores`;
  }

  // ---------- Panel por defecto (según rol) ----------
  function pintarDefault() {
    $('#b-detalle').classList.add('hidden');
    $('#b-default').classList.remove('hidden');
    const wk = semDeHoy(), wa = wk * 7, wb = wk * 7 + 6;
    const mes = MESES[mesDeHoy()];

    if (rol === 'trafico') {
      const lista = DATA.conductores.map(c => {
        const tipos = {}; for (let d = wa; d <= wb; d++) { const v = dia(c, d); if (esAus(v)) tipos[v] = (tipos[v] || 0) + 1; }
        return { c, tipos, n: Object.values(tipos).reduce((a, b) => a + b, 0) };
      }).filter(x => x.n).sort((a, b) => b.n - a.n);
      $('#b-default').innerHTML =
        `<h2 class="text-lg font-semibold text-telecab-text flex items-center gap-2 mb-1"><i class="fa-solid fa-user-clock text-telecab-gold"></i> Ausentes esta semana</h2>
         <p class="text-xs text-telecab-muted mb-4">Quién no sale estos días. Haz clic en cualquier conductor para ver su bitácora.</p>
         ${lista.length ? '<div class="space-y-1.5">' + lista.map(x =>
            `<button type="button" data-id="${esc(x.c.id)}" class="b-open w-full text-left flex items-center gap-3 px-3 py-2.5 rounded-xl bg-telecab-dark/40 hover:bg-telecab-card2 transition">
               <span class="min-w-0 flex-1 text-sm text-telecab-text truncate">${esc(x.c.id)}</span>
               <span class="flex gap-1">${Object.keys(x.tipos).map(t => `<span style="background:${tintClr(t)};color:${clr(t)};" class="text-[11px] px-2 py-0.5 rounded-lg font-medium">${NOM[t]} · ${x.tipos[t]}d</span>`).join('')}</span>
             </button>`).join('') + '</div>'
          : '<p class="text-telecab-muted text-sm">Nadie ausente esta semana. 🎉</p>'}`;
    } else {
      const cont = { V: 0, B: 0, P: 0 }, conductores = [];
      DATA.conductores.forEach(c => {
        const r = { V: 0, B: 0, P: 0 }; let prev = null, any = false;
        mes.dias.forEach(d => { const v = dia(c, d); if (esAus(v)) { any = true; if (prev !== v) { r[v]++; cont[v]++; } prev = v; } else prev = null; });
        if (any) conductores.push({ c, r });
      });
      const chip = (t, n) => `<span style="background:${tintClr(t)};color:${clr(t)};" class="text-sm px-3 py-1.5 rounded-xl font-medium">${NOM[t]}: ${n}</span>`;
      $('#b-default').innerHTML =
        `<h2 class="text-lg font-semibold text-telecab-text flex items-center gap-2 mb-1"><i class="fa-solid fa-calendar-check text-telecab-gold"></i> Ausencias de ${esc(mes.label)}</h2>
         <p class="text-xs text-telecab-muted mb-4">Periodos de ausencia registrados este mes. Haz clic en un conductor para su histórico completo.</p>
         <div class="flex flex-wrap gap-2 mb-5">${chip('V', cont.V)}${chip('B', cont.B)}${chip('P', cont.P)}</div>
         ${conductores.length ? '<div class="space-y-1.5">' + conductores.map(x =>
            `<button type="button" data-id="${esc(x.c.id)}" class="b-open w-full text-left flex items-center gap-3 px-3 py-2.5 rounded-xl bg-telecab-dark/40 hover:bg-telecab-card2 transition">
               <span class="min-w-0 flex-1 text-sm text-telecab-text truncate">${esc(x.c.id)}</span>
               <span class="flex gap-1">${badges(x.r)}</span>
             </button>`).join('') + '</div>'
          : '<p class="text-telecab-muted text-sm">Sin ausencias este mes.</p>'}`;
    }
    $('#b-default').querySelectorAll('.b-open').forEach(b => b.addEventListener('click', () => abrir(b.dataset.id)));
  }

  // ---------- Detalle del conductor (año / mes / semana) ----------
  function rango() {
    if (level === 'año') return { a: 0, b: 364 };
    if (level === 'mes') { const m = MESES[mIdx]; return { a: m.start, b: m.start + m.len - 1 }; }
    return { a: wIdx * 7, b: Math.min(wIdx * 7 + 6, 364) };
  }
  function abrir(id) {
    const c = DATA.conductores.find(x => x.id === id); if (!c) return;
    SEL = id; level = 'mes'; mIdx = mesDeHoy(); wIdx = semDeHoy();
    pintarLista();
    $('#b-default').classList.add('hidden');
    const d = $('#b-detalle'); d.classList.remove('hidden');
    d.innerHTML =
      `<div class="flex items-center gap-3 mb-4">
         <button id="b-volver" class="text-xs px-2.5 py-1.5 rounded-lg border border-telecab-border text-telecab-muted hover:border-telecab-gold transition"><i class="fa-solid fa-arrow-left mr-1"></i>Resumen</button>
         <h2 class="text-lg font-semibold text-telecab-text truncate">${esc(c.id)}</h2>
         <span class="text-xs text-telecab-muted whitespace-nowrap">${esc(c.turno || '')}${c.estado ? ' · ' + esc(c.estado) : ''}</span>
       </div>
       <div class="flex items-center gap-3 flex-wrap mb-4">
         <div class="inline-flex rounded-xl overflow-hidden border border-telecab-border">
           ${['año','mes','semana'].map(l => `<button data-lv="${l}" class="b-seg px-3 py-1.5 text-sm capitalize">${l}</button>`).join('')}
         </div>
         <div class="flex items-center gap-2 ml-auto">
           <button id="b-prev" class="w-8 h-8 rounded-lg border border-telecab-border text-telecab-muted hover:border-telecab-gold transition"><i class="fa-solid fa-chevron-left"></i></button>
           <span id="b-period" class="text-sm font-medium text-telecab-text min-w-[110px] text-center"></span>
           <button id="b-next" class="w-8 h-8 rounded-lg border border-telecab-border text-telecab-muted hover:border-telecab-gold transition"><i class="fa-solid fa-chevron-right"></i></button>
         </div>
       </div>
       <div id="b-kpis" class="grid grid-cols-4 gap-2 mb-5"></div>
       <p class="text-xs text-telecab-muted mb-2">Ausencias</p>
       <div id="b-tl" class="flex gap-0.5"></div>
       <div id="b-tlabels" class="flex gap-0.5 mt-1"></div>
       <div class="flex flex-wrap gap-4 mt-3 text-xs text-telecab-muted">
         <span class="flex items-center gap-1.5"><span style="background:${clr('B')}" class="w-3 h-3 rounded"></span>Baja médica</span>
         <span class="flex items-center gap-1.5"><span style="background:${clr('V')}" class="w-3 h-3 rounded"></span>Vacaciones</span>
         <span class="flex items-center gap-1.5"><span style="background:${clr('P')}" class="w-3 h-3 rounded"></span>Permiso</span>
         <span class="flex items-center gap-1.5"><span style="background:${clr('J')}" class="w-3 h-3 rounded"></span>Justificante</span>
         <span class="flex items-center gap-1.5"><span style="background:${LIBR}" class="w-3 h-3 rounded"></span>Libranza</span>
       </div>
       <p class="text-xs text-telecab-muted mt-6 mb-2">Horas</p>
       <div id="b-hours" class="flex gap-1 items-end h-32"></div>
       <div id="b-hlabels" class="flex gap-1 mt-1"></div>`;
    d.querySelector('#b-volver').addEventListener('click', () => { SEL = null; pintarLista(); pintarDefault(); });
    d.querySelectorAll('.b-seg').forEach(b => b.addEventListener('click', () => { level = b.dataset.lv; render(); }));
    d.querySelector('#b-prev').addEventListener('click', () => nav(-1));
    d.querySelector('#b-next').addEventListener('click', () => nav(1));
    render();
  }
  function nav(dir) {
    if (level === 'mes') mIdx = (mIdx + 12 + dir) % 12;
    else if (level === 'semana') wIdx = (wIdx + 52 + dir) % 52;
    render();
  }
  function render() {
    const c = DATA.conductores.find(x => x.id === SEL); if (!c) return;
    document.querySelectorAll('.b-seg').forEach(b => {
      const on = b.dataset.lv === level;
      b.className = 'b-seg px-3 py-1.5 text-sm capitalize ' + (on ? 'bg-telecab-gold/20 text-telecab-gold' : 'text-telecab-muted hover:text-telecab-text');
    });
    const navOff = level === 'año';
    ['#b-prev', '#b-next'].forEach(s => { $(s).style.visibility = navOff ? 'hidden' : 'visible'; });

    // Periodo + KPIs
    const r = rango(); let H = 0, tr = 0, au = 0, li = 0;
    for (let d = r.a; d <= r.b; d++) { const v = dia(c, d); if (typeof v === 'number' && v > 0) { H += v; tr++; } else if (v === 'L') li++; else if (esAus(v)) au++; }
    $('#b-period').textContent = level === 'año' ? 'jun 2026 – may 2027' : (level === 'mes' ? MESES[mIdx].label : 'sem ' + (wIdx + 1) + ' · ' + mesDeSemana(wIdx));
    const kp = [['Horas', Math.round(H)], ['Días trabajados', tr], ['Días de ausencia', au], ['Libranzas', li]];
    $('#b-kpis').innerHTML = kp.map(k =>
      `<div class="bg-telecab-dark/50 rounded-xl px-3 py-2"><p class="text-[11px] text-telecab-muted">${k[0]}</p><p class="text-lg font-bold text-telecab-text">${k[1]}</p></div>`).join('');

    pintarTimeline(c);
    pintarHoras(c);
  }
  function mesDeSemana(w) { const d = w * 7; const m = MESES.find(m => d >= m.start && d < m.start + m.len); return m ? m.label : ''; }

  function celdaTL(bg, extra) {
    return `<div style="flex:1 1 0;height:24px;border-radius:2px;background:${bg};border:0.5px solid ${bg === TRACK ? LINEA : bg};${extra || ''}"></div>`;
  }
  function pintarTimeline(c) {
    const tl = $('#b-tl'), lb = $('#b-tlabels');
    if (level === 'año') {
      let cells = '';
      for (let w = 0; w < 52; w++) { let col = null; for (let j = 0; j < 7; j++) { const v = dia(c, w * 7 + j); if (esAus(v) || v === 'J') { col = clr(v); break; } } cells += celdaTL(col || TRACK); }
      tl.innerHTML = cells;
      lb.innerHTML = MESES.map(m => `<div style="flex:1 1 0;text-align:center;" class="text-[10px] text-telecab-muted">${m.label.slice(0, 3)}</div>`).join('');
    } else {
      const r = rango(); let cells = '', labs = '';
      for (let d = r.a; d <= r.b; d++) {
        const v = dia(c, d);
        const bg = (esAus(v) || v === 'J') ? clr(v) : (v === 'L' ? LIBR : TRACK);
        cells += celdaTL(bg);
        const dt = new Date(Date.UTC(DATA.inicio.y, DATA.inicio.m, DATA.inicio.d + d));
        const lab = level === 'semana' ? DOW[(d % 7)] : (dt.getUTCDate() % 5 === 1 ? dt.getUTCDate() : '');
        labs += `<div style="flex:1 1 0;text-align:center;" class="text-[10px] text-telecab-muted">${lab}</div>`;
      }
      tl.innerHTML = cells; lb.innerHTML = labs;
    }
  }
  function pintarHoras(c) {
    const hc = $('#b-hours'), hl = $('#b-hlabels');
    let vals = [], labs = [];
    if (level === 'año') { vals = MESES.map(m => Math.round(horasEn(c, m.start, m.start + m.len - 1))); labs = MESES.map(m => m.label.slice(0, 3)); }
    else { const r = rango(); for (let d = r.a; d <= r.b; d++) { const v = dia(c, d); vals.push(typeof v === 'number' && v > 0 ? Math.round(v) : 0); const dt = new Date(Date.UTC(DATA.inicio.y, DATA.inicio.m, DATA.inicio.d + d)); labs.push(level === 'semana' ? DOW[d % 7] : (dt.getUTCDate() % 5 === 1 ? dt.getUTCDate() : '')); } }
    const max = Math.max(1, ...vals);
    hc.innerHTML = vals.map(v =>
      `<div style="flex:1 1 0;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;gap:2px;height:100%;">
         <span class="text-[9px] text-telecab-muted">${v > 0 ? v : ''}</span>
         <div style="width:100%;border-radius:3px 3px 0 0;background:${v > 0 ? HCOL : 'transparent'};height:${Math.round(v / max * 100)}%;min-height:${v > 0 ? 2 : 0}px;"></div>
       </div>`).join('');
    hl.innerHTML = labs.map(l => `<div style="flex:1 1 0;text-align:center;" class="text-[10px] text-telecab-muted">${l}</div>`).join('');
  }

  // ---------- Carga ----------
  async function cargar() {
    try {
      const r = await (await fetch('/bitacora/api/datos')).json();
      if (r.status !== 'ok') throw new Error(r.msg || 'Error');
      DATA = r; MESES = construirMeses(r.inicio);
      pintarKpisFlota(); pintarLista(); pintarDefault();
    } catch (e) {
      $('#b-default').innerHTML = '<p class="text-telecab-red text-sm">No se pudo cargar la bitácora: ' + esc(e.message) + '</p>';
    }
  }
  $('#b-buscar').addEventListener('input', pintarLista);
  cargar();
</script>
