<div class="p-4 lg:p-6 max-w-5xl mx-auto space-y-5">

  <!-- Contadores -->
  <div class="grid grid-cols-3 gap-3">
    <div class="bg-telecab-card border border-telecab-border rounded-2xl px-4 py-3">
      <p class="text-[11px] uppercase tracking-wide text-telecab-muted">Por tramitar</p>
      <p id="c-tram" class="text-2xl font-bold text-telecab-gold">–</p>
      <p id="c-tram-split" class="text-[11px] text-telecab-muted"></p>
    </div>
    <div class="bg-telecab-card border border-telecab-border rounded-2xl px-4 py-3">
      <p class="text-[11px] uppercase tracking-wide text-telecab-muted">Altas hechas</p>
      <p id="c-altas" class="text-2xl font-bold text-telecab-green">–</p>
    </div>
    <div class="bg-telecab-card border border-telecab-border rounded-2xl px-4 py-3">
      <p class="text-[11px] uppercase tracking-wide text-telecab-muted">No realizadas</p>
      <p id="c-noalta" class="text-2xl font-bold text-telecab-muted">–</p>
    </div>
  </div>

  <!-- Ficha de alta + verificación -->
  <div id="ficha" class="bg-telecab-card border border-telecab-border rounded-2xl p-5 hidden">
    <div class="flex items-center justify-between mb-1">
      <h2 id="ficha-nombre" class="text-lg font-semibold text-telecab-text flex items-center gap-2">
        <i class="fa-solid fa-user-check text-telecab-green"></i> <span></span>
        <span id="ficha-ett" class="hidden text-[11px] px-2 py-0.5 rounded-full bg-telecab-gold/15 text-telecab-gold border border-telecab-gold/30">ETT</span>
      </h2>
      <span class="text-xs px-2.5 py-1 rounded-full bg-telecab-green/10 text-telecab-green border border-telecab-green/30">Aprobado en BOLT</span>
    </div>
    <p id="ficha-sub" class="text-sm text-telecab-muted mb-4"></p>

    <!-- Verificación: todos los datos de Selección (editables por RRHH) -->
    <div class="rounded-xl border border-telecab-border bg-telecab-dark/20 p-4 mb-4">
      <div class="flex items-center justify-between gap-2 mb-3">
        <h3 class="text-xs font-semibold text-telecab-text uppercase tracking-wide flex items-center gap-2">
          <i class="fa-solid fa-clipboard-check text-telecab-gold"></i> Datos de Selección
          <span class="text-telecab-muted font-normal normal-case">— corrige aquí si hay errores</span>
        </h3>
        <button id="btn-guardar-datos" class="shrink-0 text-xs px-3 py-1.5 rounded-lg bg-telecab-gold/15 border border-telecab-gold/40 text-telecab-gold hover:bg-telecab-gold/25 transition font-medium">
          <i class="fa-solid fa-floppy-disk mr-1"></i> Guardar cambios
        </button>
      </div>
      <div id="ficha-datos" class="grid md:grid-cols-3 gap-x-6 gap-y-0"></div>
      <p id="datos-msg" class="text-xs mt-2 hidden"></p>
    </div>

    <!-- Verificación: documentos y PDF -->
    <div class="rounded-xl border border-telecab-border bg-telecab-dark/20 p-4 mb-4">
      <h3 class="text-xs font-semibold text-telecab-text uppercase tracking-wide mb-3 flex items-center gap-2">
        <i class="fa-solid fa-images text-telecab-gold"></i> Documentos <span class="text-telecab-muted font-normal normal-case">(pulsa para ampliar)</span>
      </h3>
      <div id="ficha-docs" class="grid grid-cols-3 sm:grid-cols-4 lg:grid-cols-5 gap-2.5"></div>
      <div class="mt-3 flex flex-wrap items-center gap-2">
        <div id="ficha-pdf"></div>
        <button id="btn-regenerar-pdf" class="text-xs px-3 py-1.5 rounded-lg bg-telecab-green/15 border border-telecab-green/40 text-telecab-green hover:bg-telecab-green/25 transition font-medium">
          <i class="fa-solid fa-arrows-rotate mr-1"></i> Regenerar FICHA DE ALTA (PDF)
        </button>
        <span id="pdf-msg" class="text-xs hidden"></span>
      </div>
    </div>

    <!-- Fechas del alta -->
    <div class="grid md:grid-cols-2 gap-4">
      <div>
        <label for="f-alta" class="block text-xs text-telecab-muted mb-1">Fecha de alta en Seguridad Social</label>
        <input id="f-alta" class="js-fecha w-full bg-telecab-dark border border-telecab-border rounded-xl px-3 py-2 text-telecab-text focus:outline-none focus:border-telecab-gold transition"
               data-campo="fecha_alta" readonly placeholder="dd/mm/aaaa" data-min="today">
      </div>
      <div>
        <label for="f-habilitado" class="block text-xs text-telecab-muted mb-1">Habilitado para trabajar desde <span class="text-telecab-muted/70">(la usa el planificador)</span></label>
        <input id="f-habilitado" class="js-fecha w-full bg-telecab-dark border border-telecab-border rounded-xl px-3 py-2 text-telecab-text focus:outline-none focus:border-telecab-gold transition"
               data-campo="fecha_habilitado" readonly placeholder="dd/mm/aaaa" data-min="today" data-min-field="fecha_alta">
      </div>
    </div>

    <p id="nota-excel" class="text-xs mt-3"></p>

    <!-- Candado de verificación: RRHH confirma que todo está bien antes del alta -->
    <label class="flex items-start gap-2 mt-3 p-3 rounded-xl border border-telecab-border bg-telecab-dark/30 cursor-pointer">
      <input id="chk-verificado" type="checkbox" class="accent-telecab-green mt-0.5 w-4 h-4 shrink-0">
      <span class="text-xs text-telecab-text">He verificado que <b>los datos, los documentos y el PDF</b> de la ficha de alta son correctos.</span>
    </label>

    <div class="flex items-center gap-2 mt-3 text-xs text-telecab-muted">
      <i class="fa-solid fa-circle-arrow-right text-telecab-gold"></i>
      Al procesar el alta la ficha queda <b class="text-telecab-text">de alta</b> y sale de esta bandeja. El contrato ya estaba abierto desde Selección; lo que le falta es un coche, y de eso avisa el planificador.
    </div>

    <div class="flex flex-wrap gap-2 mt-5">
      <button id="btn-alta" class="px-4 py-2.5 rounded-xl bg-telecab-green/15 border border-telecab-green/40 text-telecab-green hover:bg-telecab-green/25 transition font-semibold disabled:opacity-40 disabled:cursor-not-allowed">
        <i class="fa-solid fa-user-plus mr-1"></i> Alta procesada → Administración
      </button>
      <button id="btn-devolver" class="px-4 py-2.5 rounded-xl bg-telecab-gold/15 border border-telecab-gold/40 text-telecab-gold hover:bg-telecab-gold/25 transition font-medium">
        <i class="fa-solid fa-rotate-left mr-1"></i> Devolver a Selección
      </button>
      <button id="btn-no" class="px-4 py-2.5 rounded-xl bg-telecab-red/10 border border-telecab-red/40 text-telecab-red hover:bg-telecab-red/20 transition font-medium ml-auto">
        <i class="fa-solid fa-ban mr-1"></i> No continuar
      </button>
    </div>
    <p id="ficha-msg" class="text-xs mt-3 hidden"></p>
  </div>

  <!-- Sección ETT -->
  <div class="seccion-altas bg-telecab-card border border-telecab-border rounded-2xl p-4" data-tipo="ett">
    <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
      <h2 class="text-sm font-semibold text-telecab-text flex items-center gap-2">
        <i class="fa-solid fa-building-user text-telecab-gold"></i> ETT — pendientes de alta
        <span class="cnt text-telecab-muted font-normal text-xs"></span>
      </h2>
    </div>
    <div class="flex flex-wrap items-end gap-3 mb-3 pb-3 border-b border-telecab-border/50">
      <div>
        <label for="f-grupo-ett" class="block text-xs text-telecab-muted mb-1">Fecha del grupo de altas ETT</label>
        <input id="f-grupo-ett" class="fecha-altas js-fecha w-40 bg-telecab-dark border border-telecab-border rounded-xl px-3 py-2 text-telecab-text focus:outline-none focus:border-telecab-gold transition" readonly placeholder="dd/mm/aaaa">
      </div>
      <button class="btn-excel px-4 py-2.5 rounded-xl bg-telecab-gold/15 border border-telecab-gold/40 text-telecab-gold hover:bg-telecab-gold/25 transition font-semibold">
        <i class="fa-solid fa-file-excel mr-1"></i> Generar Excel ETT
      </button>
      <label class="text-xs text-telecab-muted flex items-center gap-1.5 cursor-pointer"><input class="chk-todos accent-telecab-gold" type="checkbox"> marcar todos</label>
      <p class="excel-msg text-xs w-full hidden"></p>
    </div>
    <div class="lista space-y-1.5"></div>
  </div>

  <!-- Sección Nuestros (general) -->
  <div class="seccion-altas bg-telecab-card border border-telecab-border rounded-2xl p-4" data-tipo="general">
    <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
      <h2 class="text-sm font-semibold text-telecab-text flex items-center gap-2">
        <i class="fa-solid fa-users text-telecab-gold"></i> Nuestros — pendientes de alta
        <span class="cnt text-telecab-muted font-normal text-xs"></span>
      </h2>
    </div>
    <div class="flex flex-wrap items-end gap-3 mb-3 pb-3 border-b border-telecab-border/50">
      <div>
        <label for="f-grupo-general" class="block text-xs text-telecab-muted mb-1">Fecha del grupo de altas</label>
        <input id="f-grupo-general" class="fecha-altas js-fecha w-40 bg-telecab-dark border border-telecab-border rounded-xl px-3 py-2 text-telecab-text focus:outline-none focus:border-telecab-gold transition" readonly placeholder="dd/mm/aaaa">
      </div>
      <button class="btn-excel px-4 py-2.5 rounded-xl bg-telecab-gold/15 border border-telecab-gold/40 text-telecab-gold hover:bg-telecab-gold/25 transition font-semibold">
        <i class="fa-solid fa-file-excel mr-1"></i> Generar Excel de Altas
      </button>
      <label class="text-xs text-telecab-muted flex items-center gap-1.5 cursor-pointer"><input class="chk-todos accent-telecab-gold" type="checkbox"> marcar todos</label>
      <p class="excel-msg text-xs w-full hidden"></p>
    </div>
    <div class="lista space-y-1.5"></div>
  </div>

</div>

<script src="<%= est('/assets/js/vistas/rrhh.js') %>"></script>
