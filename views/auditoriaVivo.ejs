<div class="max-w-7xl mx-auto">
  <div class="flex flex-wrap items-center justify-between gap-3 mb-5">
    <div>
      <h1 class="text-2xl font-bold text-telecab-text flex items-center gap-2">
        <span class="latido"></span> Auditoría en vivo
      </h1>
      <p class="text-sm text-telecab-muted mt-1">
        Coches <b>planificados</b> que están en <b>descanso</b> en BOLT pero siguen sumando kilómetros en el GPS.
        Se recalcula solo cada <span id="cfg-int">—</span> min.
      </p>
    </div>
    <div class="flex items-center gap-2">
      <span id="reloj" class="text-xs text-telecab-muted"></span>
      <button id="btn-refrescar" class="px-4 py-2 rounded-lg bg-telecab-gold/15 text-telecab-gold font-medium hover:bg-telecab-gold/25">
        <i class="fa-solid fa-rotate mr-1"></i> Refrescar ahora
      </button>
    </div>
  </div>

  <!-- ══ Tarjetas de situación ══ -->
  <div class="grid grid-cols-2 lg:grid-cols-5 gap-3 mb-6">
    <div class="rounded-xl bg-telecab-card border border-telecab-border p-4">
      <div class="text-xs text-telecab-muted mb-1">Ocurriendo ahora</div>
      <div id="k-abiertas" class="text-2xl font-bold text-telecab-text">—</div>
    </div>
    <div class="rounded-xl bg-telecab-card border border-telecab-border p-4">
      <div class="text-xs text-telecab-muted mb-1">Sin justificar</div>
      <div id="k-cerradas" class="text-2xl font-bold text-telecab-text">—</div>
    </div>
    <div class="rounded-xl bg-telecab-card border border-telecab-border p-4">
      <div class="text-xs text-telecab-muted mb-1">En descanso ahora</div>
      <div id="k-vigilados" class="text-2xl font-bold text-telecab-text">—</div>
    </div>
    <div class="rounded-xl bg-telecab-card border border-telecab-border p-4">
      <div class="text-xs text-telecab-muted mb-1">Coches planificados</div>
      <div id="k-plan" class="text-2xl font-bold text-telecab-text">—</div>
    </div>
    <div class="rounded-xl bg-telecab-card border border-telecab-border p-4">
      <div class="text-xs text-telecab-muted mb-1">Turno en curso</div>
      <div id="k-turno" class="text-2xl font-bold text-telecab-gold">—</div>
    </div>
  </div>

  <div id="msg" class="hidden mb-4 rounded-lg border border-telecab-border bg-telecab-card px-4 py-3 text-sm"></div>

  <!-- ══ Alertas ══ -->
  <section>
    <h2 class="text-sm font-semibold text-telecab-red mb-3 flex items-center gap-2">
      <i class="fa-solid fa-triangle-exclamation"></i>
      Se mueven en descanso
      <span id="n-alertas" class="text-xs text-telecab-muted"></span>
    </h2>
    <div id="lista" class="grid gap-3 lg:grid-cols-2"></div>
  </section>

  <!-- ══ Histórico de justificadas ══ -->
  <section class="mt-8">
    <details>
      <summary class="text-sm font-semibold text-telecab-muted cursor-pointer select-none">
        <i class="fa-solid fa-clock-rotate-left mr-1"></i> Justificadas recientemente
        <span id="n-just" class="text-xs"></span>
      </summary>
      <div id="historico" class="mt-3 rounded-xl bg-telecab-card border border-telecab-border overflow-hidden text-sm"></div>
    </details>
  </section>
</div>

<!-- ══ Diálogo de justificación ══ -->
<div id="modal" class="hidden fixed inset-0 z-[100] bg-black/60 backdrop-blur-sm flex items-center justify-center p-4">
  <div class="w-full max-w-md rounded-xl bg-telecab-card border border-telecab-border p-5">
    <h3 class="text-lg font-semibold text-telecab-text mb-1">Justificar alerta</h3>
    <p id="modal-sub" class="text-sm text-telecab-muted mb-4"></p>
    <label class="block text-xs font-semibold text-telecab-text mb-1">¿Qué pasó?</label>
    <textarea id="modal-motivo" rows="3" placeholder="Ej.: fue a repostar · llevó el coche al taller · cambio de turno acordado"
      class="w-full px-3 py-2 rounded-lg bg-telecab-dark border border-telecab-border text-telecab-text text-sm"></textarea>
    <div class="flex flex-wrap gap-1.5 mt-2" id="modal-rapidos"></div>
    <p id="modal-err" class="hidden text-xs text-telecab-red mt-2"></p>
    <div class="flex justify-end gap-2 mt-4">
      <button id="modal-cancelar" class="px-3 py-2 rounded-lg text-sm text-telecab-muted hover:text-telecab-text">Cancelar</button>
      <button id="modal-ok" class="px-4 py-2 rounded-lg bg-telecab-green/15 text-telecab-green border border-telecab-green/40 text-sm font-medium hover:bg-telecab-green/25">Justificar</button>
    </div>
  </div>
</div>

<style>
  /* Punto rojo que late: deja claro de un vistazo que esto es "en vivo". */
  .latido { width: 12px; height: 12px; border-radius: 50%; background: rgb(var(--tc-red)); box-shadow: 0 0 0 0 rgb(var(--tc-red) / .55); animation: latido 2s infinite; flex-shrink: 0; }
  @keyframes latido { 70% { box-shadow: 0 0 0 12px rgb(var(--tc-red) / 0); } 100% { box-shadow: 0 0 0 0 rgb(var(--tc-red) / 0); } }
  @media (prefers-reduced-motion: reduce) { .latido { animation: none; } }
  .fila-alerta { transition: opacity .3s ease; }
  /* Una alerta CERRADA ya no está pasando, pero sigue pendiente de justificar:
     se atenúa un poco para distinguirla de las que ocurren ahora mismo. */
  .cerrada { opacity: .78; }
</style>

<script>
const $ = s => document.querySelector(s);
const esc = s => String(s==null?'':s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
let DATOS = null, tickReloj = null;

function msg(t, err) {
  const m = $('#msg');
  if (!t) { m.classList.add('hidden'); return; }
  m.classList.remove('hidden');
  m.textContent = t;
  m.style.color = err ? 'rgb(var(--tc-red))' : '';
}

function pintar() {
  if (!DATOS) return;
  const a = DATOS.alertas || [];
  const abiertas = DATOS.abiertas || 0, cerradas = DATOS.cerradas || 0;
  $('#k-abiertas').textContent = abiertas;
  $('#k-abiertas').className = 'text-2xl font-bold ' + (abiertas ? 'text-telecab-red' : 'text-telecab-green');
  $('#k-cerradas').textContent = cerradas;
  $('#k-cerradas').className = 'text-2xl font-bold ' + (cerradas ? 'text-telecab-warn' : 'text-telecab-green');
  $('#k-vigilados').textContent = DATOS.vigilados ?? '—';
  $('#k-plan').textContent = DATOS.planificados ?? '—';
  $('#k-turno').textContent = DATOS.turno || '—';
  $('#n-alertas').textContent = a.length ? `(${a.length})` : '';
  $('#cfg-int').textContent = (DATOS.config && DATOS.config.intervaloMin) || '—';

  if (DATOS.error) msg('Última vuelta con error: ' + DATOS.error, true);
  else msg('');

  pintarHistorico();

  if (!a.length) {
    $('#lista').innerHTML = `
      <div class="lg:col-span-2 rounded-xl bg-telecab-card border border-telecab-border p-8 text-center">
        <i class="fa-solid fa-circle-check text-3xl text-telecab-green mb-3"></i>
        <p class="text-telecab-text font-medium">Nada pendiente.</p>
        <p class="text-telecab-muted text-sm mt-1">
          Se vigilan los planificados que llevan más de ${(DATOS.config&&DATOS.config.minDescansoMin)||'—'} min
          en descanso y superan ${(DATOS.config&&DATOS.config.umbralKm)||'—'} km.
          Las alertas se quedan aquí hasta que las justifiques.
        </p>
      </div>`;
    return;
  }

  $('#lista').innerHTML = a.map(r => {
    const enCurso = r.estado === 'abierta';
    return `
    <div class="fila-alerta ${enCurso?'':'cerrada'} rounded-xl border ${enCurso?'border-telecab-red/45':'border-telecab-warn/40'} ${enCurso?'bg-telecab-red/5':'bg-telecab-warn/5'} p-4">
      <div class="flex items-baseline justify-between gap-2">
        <span class="font-semibold text-telecab-text text-lg">${esc(r.matricula)}</span>
        <span class="text-xs ${enCurso?'text-telecab-red':'text-telecab-muted'}">
          ${enCurso ? '● ocurriendo ahora' : 'terminó ' + esc(r.cerradaLocal || '')}
        </span>
      </div>
      <div class="text-xs text-telecab-muted mt-0.5">empezó el ${esc(r.abiertaLocal)}</div>

      <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1 mt-2">
        <span class="text-2xl font-bold text-telecab-red">${r.km} km</span>
        <span class="text-sm text-telecab-muted">en ${r.minutos} min · ${r.trayectos} trayecto(s) · ≈${r.kmPorHora} km/h de media</span>
      </div>

      <div class="text-sm mt-3 space-y-0.5">
        <div><span class="text-telecab-muted">Planificado:</span> <b class="text-telecab-text">${esc(r.planificado)||'—'}</b>${r.zona?` <span class="text-telecab-muted">· ${esc(r.zona)}</span>`:''}</div>
        <div>
          <span class="text-telecab-muted">Conectado en BOLT:</span>
          <b class="${r.distinto?'text-telecab-warn':'text-telecab-text'}">${esc(r.enBolt)||'—'}</b>
          ${r.distinto?'<span class="text-xs text-telecab-warn ml-1">⚠ no es el planificado</span>':''}
        </div>
        ${r.telefono?`<div class="text-telecab-muted text-xs">📱 ${esc(r.telefono)}</div>`:''}
      </div>

      <div class="flex flex-wrap gap-2 mt-3">
        ${r.telefono?`<a href="https://wa.me/${esc(String(r.telefono).replace(/\\D/g,''))}?text=${encodeURIComponent('Hola, ¿va todo bien con el coche '+r.matricula+'? Nos figura en descanso pero con movimiento.')}" target="_blank" rel="noopener"
           class="px-3 py-1.5 rounded-lg bg-telecab-green/15 text-telecab-green border border-telecab-green/40 text-sm font-medium hover:bg-telecab-green/25"><i class="fa-brands fa-whatsapp mr-1"></i> Escribirle</a>`:''}
        <button data-justificar="${esc(r.clave)}" data-matricula="${esc(r.matricula)}" data-km="${r.km}" data-min="${r.minutos}"
                class="px-3 py-1.5 rounded-lg bg-telecab-violet/15 text-telecab-violet border border-telecab-violet/40 text-sm font-medium hover:bg-telecab-violet/25">
          <i class="fa-solid fa-clipboard-check mr-1"></i> Justificar
        </button>
      </div>
    </div>`;
  }).join('');
}

function pintarHistorico() {
  const h = DATOS.justificadas || [];
  $('#n-just').textContent = h.length ? `(${h.length})` : '(0)';
  $('#historico').innerHTML = h.length
    ? h.map(r => `
      <div class="px-4 py-2.5 border-b border-telecab-border/50 last:border-0 flex flex-wrap items-baseline gap-x-2">
        <span class="font-medium text-telecab-text">${esc(r.matricula)}</span>
        <span class="text-telecab-muted text-xs">${r.km} km / ${r.minutos} min · ${esc(r.abiertaLocal)}</span>
        <span class="text-telecab-text text-sm flex-1 min-w-0">— ${esc(r.motivo)}</span>
        <span class="text-telecab-muted text-xs">${esc(r.justificadaPor || '')} · ${esc(r.justificadaLocal || '')}</span>
      </div>`).join('')
    : '<p class="px-4 py-3 text-telecab-muted text-sm">Todavía no se ha justificado ninguna.</p>';
}

function pintarReloj() {
  if (!DATOS || !DATOS.ts) { $('#reloj').textContent = ''; return; }
  const seg = Math.max(0, Math.round((Date.now() - DATOS.ts) / 1000));
  const txt = seg < 60 ? `hace ${seg}s` : `hace ${Math.round(seg/60)} min`;
  $('#reloj').textContent = 'Actualizado ' + txt;
}

async function cargar(forzar) {
  const b = $('#btn-refrescar');
  if (forzar) { b.disabled = true; b.innerHTML = '<i class="fa-solid fa-spinner fa-spin mr-1"></i> Midiendo…'; }
  try {
    const r = forzar
      ? await fetch('/operaciones/api/vivo/refrescar', { method: 'POST', headers: {'Content-Type':'application/json'}, body: '{}' })
      : await fetch('/operaciones/api/vivo');
    DATOS = await r.json();
    pintar(); pintarReloj();
  } catch (e) { msg('No se pudo consultar: ' + e.message, true); }
  if (forzar) { b.disabled = false; b.innerHTML = '<i class="fa-solid fa-rotate mr-1"></i> Refrescar ahora'; }
}

$('#btn-refrescar').addEventListener('click', () => cargar(true));

// ── Justificar ──────────────────────────────────────────────────────────────
const RAPIDOS = ['Fue a repostar', 'Al taller / avería', 'Cambio de turno acordado',
  'Traslado del coche', 'Uso indebido — hablado con el conductor', 'Falso positivo del GPS'];
let CLAVE_ACTUAL = null;

function abrirModal(btn) {
  CLAVE_ACTUAL = btn.dataset.justificar;
  $('#modal-sub').textContent = `${btn.dataset.matricula} · ${btn.dataset.km} km en ${btn.dataset.min} min`;
  $('#modal-motivo').value = '';
  $('#modal-err').classList.add('hidden');
  $('#modal-rapidos').innerHTML = RAPIDOS.map(t =>
    `<button type="button" class="rapido px-2 py-1 rounded-full bg-telecab-card2 text-telecab-muted text-xs hover:text-telecab-text">${esc(t)}</button>`).join('');
  $('#modal').classList.remove('hidden');
  $('#modal-motivo').focus();
}
function cerrarModal() { $('#modal').classList.add('hidden'); CLAVE_ACTUAL = null; }

$('#modal-cancelar').addEventListener('click', cerrarModal);
$('#modal').addEventListener('click', e => { if (e.target.id === 'modal') cerrarModal(); });
document.addEventListener('keydown', e => { if (e.key === 'Escape' && !$('#modal').classList.contains('hidden')) cerrarModal(); });

$('#modal-ok').addEventListener('click', async () => {
  const motivo = $('#modal-motivo').value.trim();
  if (!motivo) {
    $('#modal-err').textContent = 'Escribe el motivo: es lo que se consulta luego.';
    $('#modal-err').classList.remove('hidden');
    return;
  }
  const b = $('#modal-ok');
  b.disabled = true; b.textContent = 'Guardando…';
  try {
    const r = await fetch('/operaciones/api/vivo/justificar', {
      method: 'POST', headers: {'Content-Type':'application/json'},
      body: JSON.stringify({ clave: CLAVE_ACTUAL, motivo })
    });
    const d = await r.json();
    if (d.status !== 'ok') throw new Error(d.msg || 'no se pudo');
    DATOS = d; cerrarModal(); pintar();
  } catch (err) {
    $('#modal-err').textContent = err.message;
    $('#modal-err').classList.remove('hidden');
  }
  b.disabled = false; b.textContent = 'Justificar';
});

document.addEventListener('click', e => {
  const rap = e.target.closest('.rapido');
  if (rap) {
    const t = $('#modal-motivo');
    t.value = t.value ? t.value + ' · ' + rap.textContent : rap.textContent;
    t.focus();
    return;
  }
  const btn = e.target.closest('[data-justificar]');
  if (btn) abrirModal(btn);
});

// El servidor recalcula por su cuenta; la pantalla solo va a buscar el resultado.
cargar();
setInterval(cargar, 30000);
tickReloj = setInterval(pintarReloj, 5000);
</script>
