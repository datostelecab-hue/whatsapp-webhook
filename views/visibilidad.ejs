<div class="max-w-[1500px] mx-auto">

  <!-- ── Cabecera: título + selector de mes + config ─────────────────────────── -->
  <div class="flex flex-wrap items-end justify-between gap-3 mb-5">
    <div>
      <h1 class="text-2xl font-bold text-telecab-text flex items-center gap-2">
        <i class="fa-solid fa-chart-line text-telecab-gold"></i> Visibilidad
      </h1>
      <p class="text-sm text-telecab-muted mt-1">
        Horas de flota en vivo desde el núcleo de BOLT. Sin hojas.
        <span id="v-actualizado" class="ml-1 text-telecab-muted/70"></span>
      </p>
    </div>
    <div class="flex items-center gap-2">
      <div class="flex items-center gap-1 bg-telecab-card border border-telecab-border rounded-lg px-1">
        <button id="v-mes-prev" class="w-8 h-8 rounded-md hover:bg-telecab-card2 text-telecab-muted"><i class="fa-solid fa-chevron-left"></i></button>
        <span id="v-mes-lbl" class="text-sm text-telecab-text font-medium min-w-[130px] text-center tabular-nums">—</span>
        <button id="v-mes-next" class="w-8 h-8 rounded-md hover:bg-telecab-card2 text-telecab-muted"><i class="fa-solid fa-chevron-right"></i></button>
      </div>
      <button id="v-config-btn" class="px-3 py-2 rounded-lg bg-telecab-card border border-telecab-border text-sm text-telecab-muted hover:text-telecab-text" title="Capacidad, meta, vehículos y días del mes">
        <i class="fa-solid fa-sliders mr-1"></i> Config
      </button>
      <button id="v-refrescar" class="px-3 py-2 rounded-lg bg-telecab-card border border-telecab-border text-sm text-telecab-muted hover:text-telecab-text">
        <i class="fa-solid fa-rotate mr-1"></i> Actualizar
      </button>
    </div>
  </div>

  <!-- ── KPIs del mes elegido ─────────────────────────────────────────────────── -->
  <div class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-5 gap-3 mb-5">
    <div class="rounded-2xl border border-telecab-gold/40 bg-telecab-card p-4">
      <p class="text-[11px] text-telecab-muted uppercase tracking-wide">Horas efectivas</p>
      <p id="k-horas" class="text-3xl font-bold text-telecab-gold mt-1 tabular-nums leading-none">—</p>
      <p class="text-xs text-telecab-muted mt-2">viaje + espera · <span id="k-sub-mes">este mes</span></p>
      <div class="mt-2 h-1.5 rounded-full bg-telecab-card2 overflow-hidden" title="Avance sobre la meta del mes">
        <div id="k-meta-bar" class="h-full bg-telecab-gold" style="width:0%"></div>
      </div>
      <p class="text-[11px] text-telecab-muted mt-1"><span id="k-meta-pct">—</span> de la meta <span id="k-meta-val"></span></p>
    </div>
    <div class="rounded-2xl border border-telecab-border bg-telecab-card p-4">
      <p class="text-[11px] text-telecab-muted uppercase tracking-wide">% Utilización</p>
      <p id="k-util" class="text-3xl font-bold text-telecab-text mt-1 tabular-nums leading-none">—</p>
      <p class="text-xs text-telecab-muted mt-2">viaje / (viaje + espera)</p>
    </div>
    <div class="rounded-2xl border border-telecab-border bg-telecab-card p-4">
      <p class="text-[11px] text-telecab-muted uppercase tracking-wide">Euros / hora</p>
      <p id="k-eurhora" class="text-3xl font-bold text-telecab-text mt-1 tabular-nums leading-none">—</p>
      <p class="text-xs text-telecab-muted mt-2">neto / horas efectivas</p>
    </div>
    <div class="rounded-2xl border border-telecab-border bg-telecab-card p-4">
      <p class="text-[11px] text-telecab-muted uppercase tracking-wide">Neto total</p>
      <p id="k-neto" class="text-3xl font-bold text-telecab-text mt-1 tabular-nums leading-none">—</p>
      <p class="text-xs text-telecab-muted mt-2">facturación del mes</p>
    </div>
    <div class="rounded-2xl border border-telecab-border bg-telecab-card p-4">
      <p class="text-[11px] text-telecab-muted uppercase tracking-wide">Viajes / hora</p>
      <p id="k-viahora" class="text-3xl font-bold text-telecab-text mt-1 tabular-nums leading-none">—</p>
      <p class="text-xs text-telecab-muted mt-2"><span id="k-viajes">—</span> viajes terminados</p>
    </div>
  </div>

  <!-- ── EN VIVO: por día natural y por turno. Son dos formas de mirar el mismo día
       y las dos valen: la natural cuadra con BOLT y con el mes; la jornada, con el
       Reporte de horas. No dan lo mismo porque la noche cruza la medianoche. ──── -->
  <%
    function miniCard(id, label, nota, acento){
      return `<div class="rounded-2xl border ${acento ? 'border-telecab-gold/40' : 'border-telecab-border'} bg-telecab-card/60 p-4">
        <div class="flex items-center justify-between gap-2">
          <p class="text-[11px] text-telecab-muted uppercase tracking-wide" id="${id}-etq" title="">${label}</p>
          <span class="text-[11px] text-telecab-muted tabular-nums shrink-0" id="${id}-cond"></span>
        </div>
        <p class="text-2xl font-bold text-telecab-text mt-1 tabular-nums leading-none"><span id="${id}-h">—</span> <span class="text-sm text-telecab-muted font-normal">h</span></p>
        <div class="mt-2.5 h-1.5 rounded-full bg-telecab-card2 overflow-hidden" title="% utilización">
          <div id="${id}-bar" class="h-full ${acento ? 'bg-telecab-gold' : 'bg-telecab-green'}" style="width:0%"></div>
        </div>
        <p class="text-[11px] text-telecab-muted mt-1"><span id="${id}-util">—</span> % utilización${nota ? ' · ' + nota : ''}</p>
      </div>`;
    }
  %>

  <div class="grid grid-cols-1 xl:grid-cols-2 gap-4 mb-5">
    <div>
      <div class="mb-2 flex items-center gap-2">
        <span class="text-xs font-semibold text-telecab-text uppercase tracking-wider">Por día natural</span>
        <span class="text-[11px] text-telecab-muted">00:00 – 24:00 · lo que cuadra con BOLT</span>
        <div class="flex-1 h-px bg-telecab-border/50"></div>
      </div>
      <div class="grid grid-cols-3 gap-3">
        <%- miniCard('m-hoy', 'Hoy', 'en curso') %>
        <%- miniCard('m-ayer', 'Ayer', '') %>
        <%- miniCard('m-semana', 'Esta semana', '') %>
      </div>
    </div>
    <div>
      <div class="mb-2 flex items-center gap-2">
        <span class="text-xs font-semibold text-telecab-text uppercase tracking-wider">Por turno</span>
        <span class="text-[11px] text-telecab-muted">día 05–17 · noche 17–05 · jornada 05→05</span>
        <div class="flex-1 h-px bg-telecab-border/50"></div>
      </div>
      <div class="grid grid-cols-3 gap-3">
        <%- miniCard('m-tdia', 'Turno día', '') %>
        <%- miniCard('m-tnoche', 'Turno noche', '') %>
        <%- miniCard('m-ajor', 'Ayer · jornada', 'día + noche', true) %>
      </div>
    </div>
  </div>

  <!-- ── Capacidad por día: los últimos 15 días cerrados + hoy en curso ─────── -->
  <div class="rounded-2xl border border-telecab-border bg-telecab-card p-4 mb-4">
    <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
      <div>
        <h2 class="text-sm font-semibold text-telecab-text">Capacidad por día · últimos 15 días</h2>
        <p class="text-xs text-telecab-muted">Horas efectivas de cada día cerrado, y hoy aparte porque aún corre. La línea de puntos es el ritmo diario que pide la meta.</p>
      </div>
      <div class="flex items-center gap-3 text-[11px] text-telecab-muted">
        <span class="flex items-center gap-1"><i class="fa-solid fa-circle text-telecab-gold"></i> Total del día</span>
        <span class="flex items-center gap-1"><i class="fa-solid fa-circle text-telecab-green"></i> Hoy, en curso</span>
        <span class="flex items-center gap-1"><span class="inline-block w-4 border-t border-dashed border-telecab-muted"></span> Ideal diario</span>
      </div>
    </div>
    <div class="relative h-[300px]"><canvas id="g-ultimos"></canvas></div>
  </div>

  <!-- ── Acumulado del mes contra el ideal y el suelo crítico ──────────────── -->
  <div class="rounded-2xl border border-telecab-border bg-telecab-card p-4 mb-4">
    <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
      <div>
        <h2 class="text-sm font-semibold text-telecab-text">Acumulado vs Ideal vs Crítico</h2>
        <p class="text-xs text-telecab-muted">El acumulado real llega hasta hoy. El ideal y el crítico siguen hasta fin de mes porque son el objetivo, no un dato. En rojo, la zona en la que la meta ya no se alcanza.</p>
      </div>
      <div id="g-acum-estado" class="text-xs tabular-nums"></div>
    </div>
    <div class="relative h-[320px]"><canvas id="g-acumulado"></canvas></div>
  </div>

  <div class="grid grid-cols-1 xl:grid-cols-3 gap-4 mb-4">
    <div class="xl:col-span-2 rounded-2xl border border-telecab-border bg-telecab-card p-4">
      <h2 class="text-sm font-semibold text-telecab-text">Horas efectivas por día</h2>
      <p class="text-xs text-telecab-muted mb-2">Total del día (oro) y cuánto de eso fue espera (ámbar).</p>
      <div class="relative h-[260px]"><canvas id="g-dia"></canvas></div>
    </div>
    <div class="rounded-2xl border border-telecab-border bg-telecab-card p-4">
      <div class="flex items-start justify-between gap-2">
        <div>
          <h2 class="text-sm font-semibold text-telecab-text">Brecha sobre el ideal</h2>
          <p class="text-xs text-telecab-muted">Acumulado menos ideal, día a día.</p>
        </div>
        <div class="text-right">
          <p id="g-brecha-num" class="text-2xl font-bold tabular-nums leading-none">—</p>
          <p class="text-[11px] text-telecab-muted mt-0.5">a día de hoy</p>
        </div>
      </div>
      <div class="relative h-[220px] mt-2"><canvas id="g-brecha"></canvas></div>
    </div>
  </div>

  <!-- ── Tabla del mes (las columnas del VISOR) ──────────────────────────────── -->
  <div class="rounded-2xl border border-telecab-border bg-telecab-card overflow-hidden">
    <div class="px-4 py-3 border-b border-telecab-border flex items-center justify-between">
      <h2 class="text-sm font-semibold text-telecab-text">Detalle por día</h2>
      <span class="text-xs text-telecab-muted">TOTAL = viaje+espera · WAITING = espera · los días por venir van en gris</span>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="text-telecab-muted text-xs uppercase tracking-wide border-b border-telecab-border">
            <th class="text-left px-4 py-2">Día</th>
            <th class="text-right px-3 py-2">Total</th>
            <th class="text-right px-3 py-2">Waiting</th>
            <th class="text-right px-3 py-2">% Util</th>
            <th class="text-right px-3 py-2">Acumulado</th>
            <th class="text-right px-3 py-2">Ideal</th>
            <th class="text-right px-3 py-2">Crítico</th>
            <th class="text-right px-3 py-2">Brecha</th>
            <th class="text-right px-4 py-2">Sobre crítico</th>
          </tr>
        </thead>
        <tbody id="v-tabla" class="tabular-nums"></tbody>
      </table>
    </div>
  </div>
</div>

<!-- ── Panel de config (capacidad, meta, vehículos, días) ────────────────────── -->
<div id="v-config-modal" class="hidden fixed inset-0 z-[120] flex items-center justify-center bg-black/60 backdrop-blur-sm p-4">
  <div class="w-full max-w-md rounded-2xl border border-telecab-border bg-telecab-card shadow-soft">
    <div class="px-5 py-4 border-b border-telecab-border flex items-center justify-between">
      <h3 class="font-semibold text-telecab-text"><i class="fa-solid fa-sliders mr-2 text-telecab-gold"></i>Config del visor</h3>
      <button id="v-config-x" class="text-telecab-muted hover:text-telecab-text"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <div class="p-5 space-y-3">
      <label class="block">
        <span class="text-xs text-telecab-muted">Capacidad diaria · h (por coche)</span>
        <input id="cfg-cap" type="number" step="0.1" class="mt-1 w-full px-3 py-2 rounded-lg bg-telecab-dark border border-telecab-border text-telecab-text">
      </label>
      <label class="block">
        <span class="text-xs text-telecab-muted">Meta del mes (horas)</span>
        <input id="cfg-meta" type="number" step="1" class="mt-1 w-full px-3 py-2 rounded-lg bg-telecab-dark border border-telecab-border text-telecab-text">
      </label>
      <label class="block">
        <span class="text-xs text-telecab-muted">Vehículos</span>
        <input id="cfg-veh" type="number" step="1" class="mt-1 w-full px-3 py-2 rounded-lg bg-telecab-dark border border-telecab-border text-telecab-text">
      </label>
      <label class="block">
        <span class="text-xs text-telecab-muted">Días del mes <span class="text-telecab-muted/60">(vacío = automático)</span></span>
        <input id="cfg-dias" type="number" step="1" placeholder="auto" class="mt-1 w-full px-3 py-2 rounded-lg bg-telecab-dark border border-telecab-border text-telecab-text">
      </label>
    </div>
    <div class="px-5 py-4 border-t border-telecab-border flex justify-end gap-2">
      <button id="v-config-cancel" class="px-3 py-2 rounded-lg text-sm text-telecab-muted hover:text-telecab-text">Cancelar</button>
      <button id="v-config-save" class="px-4 py-2 rounded-lg text-sm bg-telecab-gold text-telecab-dark font-semibold hover:brightness-95">Guardar y recalcular</button>
    </div>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/chartjs-plugin-datalabels/2.2.0/chartjs-plugin-datalabels.min.js"></script>
<script>
(function () {
  // Color desde los tokens del tema (respeta claro/oscuro y el cambio en caliente).
  const raiz = document.documentElement;
  const cv  = (n, a) => { const v = getComputedStyle(raiz).getPropertyValue(n).trim(); return a == null ? `rgb(${v})` : `rgb(${v} / ${a})`; };
  const nf1 = new Intl.NumberFormat('es-ES', { maximumFractionDigits: 1 });
  const nf0 = new Intl.NumberFormat('es-ES', { maximumFractionDigits: 0 });
  const eur = new Intl.NumberFormat('es-ES', { style: 'currency', currency: 'EUR' });
  const setTxt = (id, v) => { const e = document.getElementById(id); if (e) e.textContent = v; };
  const sig = x => (x > 0 ? '+' : '') + nf0.format(x);

  // Estado: mes visible.
  const hoy = new Date();
  let anio = hoy.getFullYear(), mes = hoy.getMonth() + 1;
  const MESES = ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];
  const DIAS_CORTOS = ['dom', 'lun', 'mar', 'mié', 'jue', 'vie', 'sáb'];
  let charts = {};

  if (window.Chart) {
    Chart.defaults.color = cv('--tc-muted');
    Chart.defaults.font.family = 'Inter, system-ui, sans-serif';
    Chart.defaults.borderColor = cv('--tc-border', 0.5);
    // Las etiquetas de valor solo donde se piden: por defecto, apagadas.
    if (window.ChartDataLabels) {
      Chart.register(ChartDataLabels);
      Chart.defaults.set('plugins.datalabels', { display: false });
    }
  }

  // ── Una raya vertical en "hoy", para que se vea dónde acaba lo real ────────
  const lineaHoy = {
    id: 'lineaHoy',
    afterDraw(chart, args, opts) {
      if (opts.indice == null || !chart.scales.x) return;
      const x = chart.scales.x.getPixelForValue(opts.indice);
      const { top, bottom } = chart.chartArea;
      const ctx = chart.ctx;
      ctx.save();
      ctx.strokeStyle = opts.color; ctx.setLineDash([4, 4]); ctx.lineWidth = 1;
      ctx.beginPath(); ctx.moveTo(x, top); ctx.lineTo(x, bottom); ctx.stroke();
      ctx.fillStyle = opts.color; ctx.font = '600 10px Inter, system-ui, sans-serif';
      ctx.textAlign = 'center'; ctx.fillText('HOY', x, top + 10);
      ctx.restore();
    },
  };

  // ── KPIs en vivo ──────────────────────────────────────────────────────────
  async function cargarResumen() {
    const r = await fetch('/visibilidad/api/resumen').then(x => x.json()).catch(() => null);
    if (!r || r.status !== 'ok') return;
    // La etiqueta corta se pinta; la larga de la API ("Turno noche · anoche") va al
    // title, que es donde cabe. Seis tarjetas en fila no perdonan un texto largo.
    const CORTA = { 'm-hoy': 'Hoy', 'm-ayer': 'Ayer', 'm-semana': 'Semana', 'm-tdia': 'Turno día', 'm-tnoche': 'Turno noche', 'm-ajor': 'Ayer · jornada' };
    const pon = (id, s) => {
      if (!s) return;
      setTxt(id + '-etq', CORTA[id] || s.etq);
      const e = document.getElementById(id + '-etq'); if (e) e.title = s.etq || '';
      setTxt(id + '-h', nf1.format(s.horasEfectivas));
      setTxt(id + '-util', s.utilizacion == null ? '—' : nf1.format(s.utilizacion));
      setTxt(id + '-cond', (s.conductores || 0) + ' cond.');
      const bar = document.getElementById(id + '-bar');
      if (bar) bar.style.width = Math.max(0, Math.min(100, s.utilizacion || 0)) + '%';
    };
    pon('m-hoy', r.dia); pon('m-ayer', r.ayer); pon('m-semana', r.semana);
    pon('m-tdia', r.turnoDia); pon('m-tnoche', r.turnoNoche); pon('m-ajor', r.ayerJornada);
    setTxt('v-actualizado', '· actualizado ' + new Date().toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' }));
  }

  // ── Últimos 15 días + hoy ─────────────────────────────────────────────────
  async function cargarUltimos(idealDiario) {
    const r = await fetch('/visibilidad/api/ultimos?n=15').then(x => x.json()).catch(() => null);
    if (!r || r.status !== 'ok') return;
    const dias = r.dias || [];
    const labels = dias.map(d => {
      const f = new Date(d.dia + 'T12:00:00');
      return (d.esHoy ? 'HOY · ' : '') + DIAS_CORTOS[f.getDay()] + ' ' + f.getDate();
    });
    const cerrados = dias.map(d => (d.esHoy ? null : d.total));
    const enCurso = dias.map(d => (d.esHoy ? d.total : null));
    const oro = cv('--tc-gold'), verde = cv('--tc-green');
    if (charts.ultimos) charts.ultimos.destroy();
    charts.ultimos = new Chart(document.getElementById('g-ultimos'), {
      type: 'line',
      data: { labels, datasets: [
        { label: 'Total del día', data: cerrados, borderColor: oro, backgroundColor: cv('--tc-gold', 0.07),
          fill: true, tension: 0.3, borderWidth: 2, pointRadius: 5, pointBackgroundColor: oro, pointBorderColor: cv('--tc-card', 1), pointBorderWidth: 2,
          datalabels: { display: true, align: 'top', anchor: 'end', offset: 6, color: cv('--tc-text', 0.9),
            font: { weight: '600', size: 11 }, formatter: v => (v == null ? '' : nf0.format(v)) } },
        { label: 'Hoy, en curso', data: enCurso, borderColor: verde, backgroundColor: verde, showLine: false,
          pointRadius: 7, pointHoverRadius: 8, pointBorderColor: cv('--tc-card', 1), pointBorderWidth: 2,
          datalabels: { display: true, align: 'top', anchor: 'end', offset: 8, color: verde,
            font: { weight: '700', size: 12 }, formatter: v => (v == null ? '' : nf1.format(v)) } },
        { label: 'Ideal diario', data: dias.map(() => idealDiario || null), borderColor: cv('--tc-muted', 0.8),
          borderDash: [6, 4], borderWidth: 1.5, pointRadius: 0, fill: false },
      ] },
      options: { responsive: true, maintainAspectRatio: false, interaction: { mode: 'index', intersect: false },
        layout: { padding: { top: 18, right: 28 } },
        plugins: { legend: { display: false }, tooltip: { callbacks: { label: c => c.dataset.label + ': ' + nf1.format(c.parsed.y) + ' h' } } },
        scales: { x: { grid: { display: false } }, y: { beginAtZero: true, grid: { color: cv('--tc-border', 0.35) }, ticks: { callback: v => nf0.format(v) } } } }
    });
  }

  // ── Serie del mes: KPIs, gráficos y tabla ─────────────────────────────────
  async function cargarSerie() {
    setTxt('v-mes-lbl', MESES[mes - 1] + ' ' + anio);
    const mm = String(mes).padStart(2, '0');
    const r = await fetch('/visibilidad/api/serie?mes=' + anio + '-' + mm).then(x => x.json()).catch(() => null);
    if (!r || r.status !== 'ok') return;
    pintarKpis(r.totales || {}, r.config || {});
    setTxt('k-sub-mes', MESES[mes - 1] + ' ' + anio);
    rellenarTabla(r.dias, r.ultimoConDatos);
    pintarGraficos(r);
    rellenarConfig(r.config);
    cargarUltimos(r.idealDiario);
  }

  // KPIs grandes del MES elegido (siguen al selector de mes, no a "hoy").
  function pintarKpis(t, c) {
    setTxt('k-horas', nf1.format(t.horasEfectivas || 0) + ' h');
    setTxt('k-util', t.utilizacion == null ? '—' : nf1.format(t.utilizacion) + ' %');
    setTxt('k-eurhora', t.eurosHora == null ? '—' : eur.format(t.eurosHora));
    setTxt('k-neto', eur.format(t.neto || 0));
    setTxt('k-viahora', t.viajesHora == null ? '—' : nf1.format(t.viajesHora) + ' v/h');
    setTxt('k-viajes', nf0.format(t.viajes || 0));
    const meta = Number(c.meta) || 0;
    const pct = meta > 0 ? (t.horasEfectivas || 0) / meta * 100 : 0;
    setTxt('k-meta-pct', meta > 0 ? nf1.format(pct) + ' %' : '—');
    setTxt('k-meta-val', meta > 0 ? '(' + nf0.format(meta) + ' h)' : '');
    const bar = document.getElementById('k-meta-bar');
    if (bar) bar.style.width = Math.max(0, Math.min(100, pct)) + '%';
  }

  function rellenarTabla(dias, ultimo) {
    const tb = document.getElementById('v-tabla');
    tb.innerHTML = dias.map(d => {
      const futuro = d.dia > ultimo;
      const bClass = d.brecha >= 0 ? 'text-telecab-green' : 'text-telecab-red';
      const sClass = d.sobreCritico >= 0 ? 'text-telecab-muted' : 'text-telecab-red font-semibold';
      const s1 = x => (x > 0 ? '+' : '') + nf1.format(x);
      const hoyClase = d.dia === ultimo && futuro === false && dias.some(x => x.dia > ultimo) ? ' bg-telecab-gold/[0.06]' : '';
      return `<tr class="border-b border-telecab-border/40 hover:bg-telecab-card2/40 ${futuro ? 'opacity-40' : ''}${hoyClase}">
        <td class="text-left px-4 py-1.5 text-telecab-text">${d.dia}</td>
        <td class="text-right px-3 py-1.5 text-telecab-text">${d.total ? nf1.format(d.total) : '·'}</td>
        <td class="text-right px-3 py-1.5 text-telecab-muted">${d.waiting ? nf1.format(d.waiting) : '·'}</td>
        <td class="text-right px-3 py-1.5 text-telecab-muted">${d.utilizacion == null ? '·' : nf1.format(d.utilizacion)}</td>
        <td class="text-right px-3 py-1.5 text-telecab-text">${futuro ? '·' : nf0.format(d.acumulado)}</td>
        <td class="text-right px-3 py-1.5 text-telecab-muted">${nf0.format(d.ideal)}</td>
        <td class="text-right px-3 py-1.5 text-telecab-muted">${nf0.format(d.critico)}</td>
        <td class="text-right px-3 py-1.5 ${futuro ? 'text-telecab-muted' : bClass}">${futuro ? '·' : s1(d.brecha)}</td>
        <td class="text-right px-4 py-1.5 ${futuro ? 'text-telecab-muted' : sClass}">${futuro ? '·' : s1(d.sobreCritico)}</td>
      </tr>`;
    }).join('');
  }

  function pintarGraficos(r) {
    const dias = r.dias, ultimo = r.ultimoConDatos;
    const labels = dias.map(d => d.dia);
    // Lo REAL se corta en hoy: un día por venir no es un cero, es un hueco.
    const real = f => dias.map(d => (d.dia > ultimo ? null : f(d)));
    const idxHoy = r.hoyDia != null ? r.hoyDia - 1 : null;
    ['acum', 'dia', 'brecha'].forEach(k => { if (charts[k]) charts[k].destroy(); });
    const gridColor = cv('--tc-border', 0.35);
    const ejesBase = () => ({ x: { grid: { display: false } }, y: { grid: { color: gridColor }, beginAtZero: true, ticks: { callback: v => nf0.format(v) } } });

    // ── Acumulado vs ideal vs crítico: lo real hasta hoy, el objetivo hasta fin de mes,
    //    y la zona crítica sombreada en rojo (debajo del crítico la meta ya no llega).
    const ultimoReal = dias[Math.max(0, Math.min(dias.length, ultimo) - 1)] || {};
    const est = document.getElementById('g-acum-estado');
    if (est && ultimoReal.dia) {
      const ok = ultimoReal.sobreCritico >= 0;
      est.innerHTML = '<span class="text-telecab-muted">Día ' + ultimoReal.dia + ':</span> ' +
        '<span class="font-semibold text-telecab-text">' + nf0.format(ultimoReal.acumulado) + ' h</span>' +
        ' <span class="text-telecab-muted">·</span> ' +
        '<span class="' + (ultimoReal.brecha >= 0 ? 'text-telecab-green' : 'text-telecab-red') + '">' + sig(ultimoReal.brecha) + ' h sobre el ideal</span>' +
        ' <span class="text-telecab-muted">·</span> ' +
        '<span class="' + (ok ? 'text-telecab-muted' : 'text-telecab-red font-semibold') + '">' + sig(ultimoReal.sobreCritico) + ' h sobre el crítico</span>';
    }
    charts.acum = new Chart(document.getElementById('g-acumulado'), {
      type: 'line',
      data: { labels, datasets: [
        { label: 'Acumulado', data: real(d => d.acumulado), borderColor: cv('--tc-gold'), backgroundColor: cv('--tc-gold', 0.15),
          fill: true, tension: 0.25, borderWidth: 2.5, pointRadius: 0, pointHoverRadius: 4, spanGaps: false, order: 1 },
        { label: 'Ideal', data: dias.map(d => d.ideal), borderColor: cv('--tc-muted', 0.9), borderDash: [6, 4],
          borderWidth: 1.5, pointRadius: 0, fill: false, order: 2 },
        // El crítico rellena hasta el suelo: todo lo que quede por debajo es la zona en
        // la que ya no hay capacidad para llegar a la meta. Rojo al 40 %.
        { label: 'Crítico', data: dias.map(d => d.critico), borderColor: cv('--tc-red', 0.9), borderDash: [3, 3],
          borderWidth: 1.5, pointRadius: 0, fill: 'origin', backgroundColor: cv('--tc-red', 0.4), order: 3 },
      ] },
      options: { responsive: true, maintainAspectRatio: false, interaction: { mode: 'index', intersect: false },
        plugins: { legend: { labels: { boxWidth: 12, usePointStyle: true } },
          tooltip: { callbacks: { label: c => c.parsed.y == null ? null : c.dataset.label + ': ' + nf0.format(c.parsed.y) + ' h' } },
          lineaHoy: { indice: idxHoy, color: cv('--tc-text', 0.55) } },
        scales: ejesBase() },
      plugins: [lineaHoy],
    });

    // ── Horas por día: solo hasta hoy.
    charts.dia = new Chart(document.getElementById('g-dia'), {
      type: 'bar',
      data: { labels, datasets: [
        { label: 'Efectivas', data: real(d => d.total), backgroundColor: cv('--tc-gold', 0.6), borderRadius: 3 },
        { label: 'Waiting', data: real(d => d.waiting), backgroundColor: cv('--tc-warn', 0.55), borderRadius: 3 },
      ] },
      options: { responsive: true, maintainAspectRatio: false, interaction: { mode: 'index', intersect: false },
        plugins: { legend: { labels: { boxWidth: 12, usePointStyle: true } },
          tooltip: { callbacks: { label: c => c.parsed.y == null ? null : c.dataset.label + ': ' + nf1.format(c.parsed.y) + ' h' } },
          lineaHoy: { indice: idxHoy, color: cv('--tc-text', 0.4) } },
        scales: ejesBase() },
      plugins: [lineaHoy],
    });

    // ── Brecha: barras hasta hoy, con el número de hoy en grande arriba.
    const num = document.getElementById('g-brecha-num');
    if (num) {
      const b = ultimoReal.brecha;
      num.textContent = b == null ? '—' : sig(b) + ' h';
      num.className = 'text-2xl font-bold tabular-nums leading-none ' + (b >= 0 ? 'text-telecab-green' : 'text-telecab-red');
    }
    const brechas = real(d => d.brecha);
    charts.brecha = new Chart(document.getElementById('g-brecha'), {
      type: 'bar',
      data: { labels, datasets: [
        { label: 'Brecha', data: brechas, borderRadius: 3,
          backgroundColor: brechas.map(v => (v == null ? 'transparent' : v >= 0 ? cv('--tc-green', 0.65) : cv('--tc-red', 0.65))) },
      ] },
      options: { responsive: true, maintainAspectRatio: false,
        plugins: { legend: { display: false },
          tooltip: { callbacks: { label: c => c.parsed.y == null ? null : sig(c.parsed.y) + ' h sobre el ideal' } } },
        scales: { x: { grid: { display: false } },
          y: { grid: { color: ctx => (ctx.tick.value === 0 ? cv('--tc-text', 0.5) : gridColor), lineWidth: ctx => (ctx.tick.value === 0 ? 1.5 : 1) },
               ticks: { callback: v => sig(v) } } } }
    });
  }

  // ── Config ────────────────────────────────────────────────────────────────
  function rellenarConfig(c) {
    if (!c) return;
    document.getElementById('cfg-cap').value = c.capacidad_diaria_h ?? '';
    document.getElementById('cfg-meta').value = c.meta ?? '';
    document.getElementById('cfg-veh').value = c.vehiculos ?? '';
    document.getElementById('cfg-dias').value = c.dias_del_mes ?? '';
  }
  const modal = document.getElementById('v-config-modal');
  const abrirCfg = () => modal.classList.remove('hidden');
  const cerrarCfg = () => modal.classList.add('hidden');
  document.getElementById('v-config-btn').addEventListener('click', abrirCfg);
  document.getElementById('v-config-x').addEventListener('click', cerrarCfg);
  document.getElementById('v-config-cancel').addEventListener('click', cerrarCfg);
  modal.addEventListener('click', e => { if (e.target === modal) cerrarCfg(); });
  document.getElementById('v-config-save').addEventListener('click', async () => {
    const cuerpo = {
      capacidad_diaria_h: document.getElementById('cfg-cap').value,
      meta: document.getElementById('cfg-meta').value,
      vehiculos: document.getElementById('cfg-veh').value,
      dias_del_mes: document.getElementById('cfg-dias').value,   // vacío → null (auto) en el server
    };
    const r = await fetch('/visibilidad/api/config', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(cuerpo) }).then(x => x.json()).catch(() => null);
    if (r && r.status === 'ok') { cerrarCfg(); cargarSerie(); }
  });

  // ── Navegación de mes + refresco ──────────────────────────────────────────
  document.getElementById('v-mes-prev').addEventListener('click', () => { mes--; if (mes < 1) { mes = 12; anio--; } cargarSerie(); });
  document.getElementById('v-mes-next').addEventListener('click', () => { mes++; if (mes > 12) { mes = 1; anio++; } cargarSerie(); });
  document.getElementById('v-refrescar').addEventListener('click', () => { cargarResumen(); cargarSerie(); });

  cargarResumen();
  cargarSerie();
  // Refresco suave de los KPIs cada 5 min (los gráficos se dejan salvo que cambien de mes).
  setInterval(cargarResumen, 5 * 60 * 1000);
})();
</script>
