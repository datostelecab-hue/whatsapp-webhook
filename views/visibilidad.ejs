<%
  /* LA MISMA PANTALLA PARA LAS DOS SEDES. Madrid la pinta sin más; Barcelona
     (modules/Barcelona) le pasa `api` (dónde preguntar) y `sedeNombre`. Las
     métricas son las mismas porque las cuentas son las mismas
     (services/visibilidad.js: metricas, sliceDeTurno, armarSerie). */
  const SEDE_NOMBRE = typeof sedeNombre !== 'undefined' && sedeNombre ? sedeNombre : '';
  const API = typeof api !== 'undefined' && api ? api : '/visibilidad/api';
%>
<div class="max-w-[1500px] mx-auto">

  <!-- ── Cabecera: título + selector de mes + config ─────────────────────────── -->
  <div class="flex flex-wrap items-end justify-between gap-3 mb-5">
    <div>
      <h1 class="text-2xl font-bold text-telecab-text flex items-center gap-2">
        <i class="fa-solid fa-chart-line text-telecab-gold"></i> Visibilidad<%= SEDE_NOMBRE ? ' · ' + SEDE_NOMBRE : '' %>
      </h1>
      <p class="text-sm text-telecab-muted mt-1">
        <%= SEDE_NOMBRE ? 'Horas de la flota de ' + SEDE_NOMBRE + ', de su empresa de BOLT, con las mismas cuentas que Madrid.' : 'Horas de flota en vivo desde el núcleo de BOLT. Sin hojas.' %>
        <span id="v-actualizado" class="ml-1 text-telecab-muted/70"></span>
      </p>
    </div>
    <div class="flex items-center gap-2">
      <div class="flex items-center gap-1 bg-telecab-card border border-telecab-border rounded-lg px-1">
        <button id="v-mes-prev" class="w-8 h-8 rounded-md hover:bg-telecab-card2 text-telecab-muted" aria-label="Mes anterior"><i class="fa-solid fa-chevron-left" aria-hidden="true"></i></button>
        <span id="v-mes-lbl" class="text-sm text-telecab-text font-medium min-w-[130px] text-center tabular-nums">—</span>
        <button id="v-mes-next" class="w-8 h-8 rounded-md hover:bg-telecab-card2 text-telecab-muted" aria-label="Mes siguiente"><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button>
      </div>
      <button id="v-config-btn" class="px-3 py-2 rounded-lg bg-telecab-card border border-telecab-border text-sm text-telecab-muted hover:text-telecab-text" title="Capacidad, meta, vehículos y días del mes">
        <i class="fa-solid fa-sliders mr-1"></i> Config
      </button>
      <button id="v-refrescar" class="px-3 py-2 rounded-lg bg-telecab-card border border-telecab-border text-sm text-telecab-muted hover:text-telecab-text">
        <i class="fa-solid fa-rotate mr-1"></i> Actualizar
      </button>
    </div>
  </div>

  <div id="v-aviso" class="hidden mb-4 rounded-2xl border border-telecab-warn/40 bg-telecab-warn/10 p-4 text-sm text-telecab-warn"></div>

  <!-- ── KPIs del mes elegido ─────────────────────────────────────────────────── -->
  <%# En el móvil la cifra baja a text-xl: «410.119,39 €» en text-3xl no cabía en
      media columna y ensanchaba la página entera a 386 px (25/10/2026). %>
  <div class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-5 gap-3 mb-5">
    <div class="rounded-2xl border border-telecab-gold/40 bg-telecab-card p-4 min-w-0">
      <p class="text-[11px] text-telecab-muted uppercase tracking-wide">Horas efectivas</p>
      <p id="k-horas" class="text-xl sm:text-3xl font-bold text-telecab-gold mt-1 tabular-nums leading-none">—</p>
      <p class="text-xs text-telecab-muted mt-2">viaje + espera · <span id="k-sub-mes">este mes</span></p>
      <div class="mt-2 h-1.5 rounded-full bg-telecab-card2 overflow-hidden" title="Avance sobre la meta del mes">
        <div id="k-meta-bar" class="h-full bg-telecab-gold" style="width:0%"></div>
      </div>
      <p class="text-[11px] text-telecab-muted mt-1"><span id="k-meta-pct">—</span> de la meta <span id="k-meta-val"></span></p>
    </div>
    <div class="rounded-2xl border border-telecab-border bg-telecab-card p-4 min-w-0">
      <p class="text-[11px] text-telecab-muted uppercase tracking-wide">% Utilización</p>
      <p id="k-util" class="text-xl sm:text-3xl font-bold text-telecab-text mt-1 tabular-nums leading-none">—</p>
      <p class="text-xs text-telecab-muted mt-2">viaje / (viaje + espera)</p>
    </div>
    <div class="rounded-2xl border border-telecab-border bg-telecab-card p-4 min-w-0">
      <p class="text-[11px] text-telecab-muted uppercase tracking-wide">Euros / hora</p>
      <p id="k-eurhora" class="text-xl sm:text-3xl font-bold text-telecab-text mt-1 tabular-nums leading-none">—</p>
      <p id="k-eurhora-sub" class="text-xs text-telecab-muted mt-2">neto / horas efectivas</p>
    </div>
    <div class="rounded-2xl border border-telecab-border bg-telecab-card p-4 min-w-0">
      <p class="text-[11px] text-telecab-muted uppercase tracking-wide">Neto total</p>
      <p id="k-neto" class="text-xl sm:text-3xl font-bold text-telecab-text mt-1 tabular-nums leading-none">—</p>
      <p id="k-neto-sub" class="text-xs text-telecab-muted mt-2">facturación del mes</p>
    </div>
    <div class="rounded-2xl border border-telecab-border bg-telecab-card p-4 min-w-0">
      <p class="text-[11px] text-telecab-muted uppercase tracking-wide">Viajes / hora</p>
      <p id="k-viahora" class="text-xl sm:text-3xl font-bold text-telecab-text mt-1 tabular-nums leading-none">—</p>
      <p id="k-viajes" class="text-xs text-telecab-muted mt-2">— viajes terminados</p>
    </div>
  </div>

  <!-- ── EN VIVO: por día natural y por turno. Son dos formas de mirar el mismo día
       y las dos valen: la natural cuadra con BOLT y con el acumulado del mes; la
       jornada, con el Reporte de horas y con la Bitácora. No dan lo mismo porque la
       noche cruza la medianoche, y esa diferencia es justo lo que hay que ver. ──── -->
  <%
    /* `meta` = la tarjeta lleva objetivo. Entonces la cifra se lee "458 / 500 h",
       la barra mide el AVANCE HACIA LA META (no la utilización, que sigue abajo
       en su línea) y el color va de rojo a verde según lo cerca que se esté. */
    /* A 375 px «SEMANA» y «124 cond.» no caben en la tercera parte de la pantalla:
       el «cond.» (que no encoge) se salía de su tarjeta y ensanchaba la página
       1 px. Ahí la cabecera baja de línea (flex-wrap), y min-w-0 deja que la
       tarjeta encoja dentro de su rejilla, que si no mide lo que su contenido. */
    function miniCard(id, label, nota, acento, meta){
      return `<div class="rounded-2xl border ${acento ? 'border-telecab-gold/40' : 'border-telecab-border'} bg-telecab-card/60 p-4 min-w-0">
        <div class="flex flex-wrap items-center justify-between gap-x-2">
          <p class="text-[11px] text-telecab-muted uppercase tracking-wide" id="${id}-etq" title="">${label}</p>
          <span class="text-[11px] text-telecab-muted tabular-nums shrink-0" id="${id}-cond"></span>
        </div>
        <p class="text-2xl font-bold mt-1 tabular-nums leading-none">
          <span id="${id}-h" class="text-telecab-text">—</span>${meta ? `<span id="${id}-meta" class="text-base text-telecab-muted font-semibold"></span>` : ''}
          <span class="text-sm text-telecab-muted font-normal">h</span></p>
        <div class="mt-2.5 h-1.5 rounded-full bg-telecab-card2 overflow-hidden" id="${id}-barcaja" title="${meta ? 'Avance sobre la meta del turno' : '% utilización'}">
          <div id="${id}-bar" class="h-full ${acento ? 'bg-telecab-gold' : 'bg-telecab-green'}" style="width:0%"></div>
        </div>
        <p class="text-[11px] text-telecab-muted mt-1">${meta ? '<span id="' + id + '-pct">—</span> % de la meta · ' : ''}<span id="${id}-util">—</span> % utilización${nota ? ' · ' + nota : ''}</p>
      </div>`;
    }
  %>

  <div class="grid grid-cols-1 xl:grid-cols-2 gap-4 mb-5">
    <div>
      <div class="mb-2 flex items-center gap-2">
        <span class="text-xs font-semibold text-telecab-text uppercase tracking-wider">Por día natural</span>
        <span class="text-[11px] text-telecab-muted">00:00 – 24:00 · lo que cuadra con BOLT y con el mes</span>
        <div class="flex-1 h-px bg-telecab-border/50"></div>
      </div>
      <div class="grid grid-cols-3 gap-3">
        <%- miniCard('m-hoy', 'Hoy', 'en curso') %>
        <%- miniCard('m-ayer', 'Ayer', '') %>
        <%- miniCard('m-semana', 'Esta semana', '') %>
      </div>
    </div>
    <div>
      <div class="mb-2 flex items-center gap-2">
        <span class="text-xs font-semibold text-telecab-text uppercase tracking-wider">Por turno</span>
        <%# Desde el 06/10/2026 el turno es su GENTE, no un reloj: el día cuenta de
            00:00 a 24:00 y la noche de 12:00 a 12:00, según el turno de cada
            conductor; los NN, por su hora de inicio. La misma regla que Control. %>
        <span class="text-[11px] text-telecab-muted" title="Las horas de cada turno son las de su gente según <%= SEDE_NOMBRE ? 'el planificador' : 'el cuadrante' %>: el día cuenta de 00:00 a 24:00 y la noche de 12:00 a 12:00 del día siguiente. Quien no está en el plan (<%= SEDE_NOMBRE ? 'sin plaza' : 'NN' %>) va por su hora de inicio: antes de las 12:00, día. La jornada de un día es su turno de día más su turno de noche, y no se cierra hasta las 12:00 del día siguiente.">día 00–24 · noche 12–12, por conductor · jornada = día + noche</span>
        <div class="flex-1 h-px bg-telecab-border/50"></div>
      </div>
      <div class="grid grid-cols-3 gap-3">
        <%- miniCard('m-tdia', 'Turno día', '', false, true) %>
        <%- miniCard('m-tnoche', 'Turno noche', '', false, true) %>
        <%- miniCard('m-ajor', 'Ayer · jornada', 'día + noche', true, true) %>
      </div>
    </div>
  </div>

  <%# A ESTA HORA (30/10/2026). Camilo: «ayer a las 12:28 estábamos con este total
      de horas, hoy con estas; así con dos días hacia atrás y con el mismo día de la
      semana pasada, con porcentajes reales, con gráficos que entienda una persona
      que no sabe de datos, directo al punto». Una barra por día, las horas al lado
      y, en los días de antes, cuánto va hoy por encima o por debajo, en horas y en
      %. Desde el 30/10/2026 también en Barcelona, con sus horas y su planificador. %>
  <section id="aeh" class="rounded-2xl border border-telecab-border bg-telecab-card p-4 mb-4" aria-labelledby="aeh-titulo">
    <%# Tres formas de contar, como las tarjetas de arriba (Camilo, 30/10/2026: «dos
        botones para cambiar a la vista de hora natural y hora por turno… y jornada»). %>
    <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-2">
      <div class="min-w-0">
        <h2 id="aeh-titulo" class="text-sm font-semibold text-telecab-text">A esta hora</h2>
        <p id="aeh-sub" class="text-[11px] text-telecab-muted">Horas efectivas (viaje + espera) desde las 00:00 hasta la misma hora de cada día</p>
      </div>
      <input type="hidden" id="aeh-vista" value="natural">
      <div class="tc-selector tc-selector-compacto" data-para="aeh-vista" role="group" aria-label="Cómo se cuentan las horas">
        <button type="button" data-v="natural" title="Todas las horas desde las 00:00 hasta esta hora, como la tarjeta de Hoy">Día natural</button>
        <button type="button" data-v="turno" title="Las horas de la gente de cada turno: el de día desde las 00:00 y el de noche desde las 12:00, hasta esta hora">Por turno</button>
        <button type="button" data-v="jornada" title="El turno de día de cada día más su turno de noche (que empieza a las 12:00), hasta esta hora">Jornada</button>
      </div>
    </div>
    <p id="aeh-frase" class="text-base sm:text-lg font-semibold text-telecab-text mt-1 mb-3">—</p>
    <div id="aeh-filas" class="space-y-3"><p class="text-sm text-telecab-muted">Cargando…</p></div>
  </section>

  <%
    /* LA TENDENCIA (25/10/2026). Camilo: «que el gráfico de los últimos 15 días
       se pueda agrandar… gráficos mucho más profesionales, que muestren cómo van
       las horas actualmente y cómo hemos crecido». Cuatro tarjetas:
         · Horas por día, con su rango (de una semana a todo).
         · Cómo vamos: el mes elegido contra el anterior, a la misma altura.
         · Brecha sobre el ideal: las horas que debemos a la meta, día a día, en
           barras y solo del mes (la de antes, que volvió el mismo día: Camilo,
           «esa era muy buena, solo del mes»).
         · Cómo hemos crecido: mes a mes.
       Sustituyen a los gráficos de antes: «Capacidad por día · últimos 15 días»
       (ahora es el rango de 15 días), «Acumulado vs Ideal vs Crítico» (está entero
       en Cómo vamos, con el mes anterior encima) y «Horas efectivas por día» (el
       rango por días; la espera, en el globo y en la tabla).
       El estilo sigue la skill de visualización: un acento (el del tema), el gris
       para el contexto, rayas finas, el globo con todas las series, una leyenda
       siempre y la tabla al lado de cada gráfico para quien no lo pueda ver. */
    function botonTabla(id) {
      return `<button type="button" class="w-8 h-8 shrink-0 rounded-lg border border-telecab-border text-telecab-muted hover:text-telecab-text" data-tabla="${id}" aria-pressed="false" aria-controls="g-${id}-tabla" aria-label="Ver los datos en una tabla" title="Ver los datos en una tabla"><i class="fa-solid fa-table" aria-hidden="true"></i></button>`;
    }
  %>

  <!-- ── 1. Horas por día, con rangos ─────────────────────────────────────────── -->
  <section class="rounded-2xl border border-telecab-border bg-telecab-card p-4 mb-4" aria-labelledby="g-rango-titulo">
    <div class="flex flex-wrap items-start justify-between gap-3 mb-3">
      <div class="min-w-0">
        <h2 id="g-rango-titulo" class="text-sm font-semibold text-telecab-text">Horas por día</h2>
        <p id="g-rango-sub" class="text-xs text-telecab-muted">Horas efectivas (viaje + espera) de cada día.</p>
      </div>
      <div class="flex items-center gap-2">
        <input type="hidden" id="v-rango" value="15">
        <div class="tc-selector tc-selector-compacto" data-para="v-rango" role="group" aria-label="Rango del gráfico">
          <button type="button" data-v="7" title="La última semana: los 7 días cerrados y hoy">Semana</button>
          <button type="button" data-v="15" title="Los 15 días cerrados y hoy">15 días</button>
          <button type="button" data-v="30" title="Los 30 días cerrados y hoy">30 días</button>
          <button type="button" data-v="60" title="Los 60 días cerrados y hoy, día a día">2 meses</button>
          <button type="button" data-v="182" title="Medio año, por semanas: cada punto es la media diaria de su semana">6 meses</button>
          <button type="button" data-v="365" title="Un año, por semanas: cada punto es la media diaria de su semana">1 año</button>
          <button type="button" data-v="todo" title="Desde el primer día con datos">Todo</button>
        </div>
        <%- botonTabla('rango') %>
      </div>
    </div>
    <div id="g-rango-cifras" class="grid grid-cols-2 lg:grid-cols-4 gap-2 mb-3"></div>
    <div id="g-rango-caja" class="relative h-[300px] transition-opacity"><canvas id="g-rango" role="img" aria-label="Horas por día"></canvas></div>
    <div id="g-rango-tabla" class="hidden max-h-[300px] overflow-auto rounded-lg border border-telecab-border"></div>
    <div id="g-rango-leyenda" class="flex flex-wrap items-center gap-x-4 gap-y-1 mt-2 text-[11px] text-telecab-muted"></div>
    <p id="g-rango-nota" class="hidden text-[11px] text-telecab-muted mt-1"></p>
  </section>

  <!-- ── 2. Cómo vamos: el mes contra el anterior a la misma altura ─────────── -->
  <section class="rounded-2xl border border-telecab-border bg-telecab-card p-4 mb-4" aria-labelledby="g-vamos-titulo">
    <div class="flex flex-wrap items-start justify-between gap-3 mb-3">
      <div class="min-w-0">
        <h2 id="g-vamos-titulo" class="text-sm font-semibold text-telecab-text">Cómo vamos este mes</h2>
        <p id="g-vamos-sub" class="text-xs text-telecab-muted">El acumulado del mes contra el del mes anterior, día a día.</p>
      </div>
      <%- botonTabla('vamos') %>
    </div>
    <div class="grid grid-cols-1 xl:grid-cols-[minmax(0,1fr)_280px] gap-4">
      <div class="min-w-0">
        <div id="g-vamos-caja" class="relative h-[320px] transition-opacity"><canvas id="g-vamos" role="img" aria-label="Acumulado del mes"></canvas></div>
        <div id="g-vamos-tabla" class="hidden max-h-[320px] overflow-auto rounded-lg border border-telecab-border"></div>
        <div id="g-vamos-leyenda" class="flex flex-wrap items-center gap-x-4 gap-y-1 mt-2 text-[11px] text-telecab-muted"></div>
      </div>
      <div id="g-vamos-cifras" class="grid grid-cols-2 xl:grid-cols-1 gap-2 content-start"></div>
    </div>
  </section>

  <!-- ── 2 bis. Brecha sobre el ideal: lo que debemos, solo del mes ─────────── -->
  <section class="rounded-2xl border border-telecab-border bg-telecab-card p-4 mb-4" aria-labelledby="g-brecha-titulo">
    <div class="flex flex-wrap items-start justify-between gap-3 mb-3">
      <div class="min-w-0">
        <h2 id="g-brecha-titulo" class="text-sm font-semibold text-telecab-text">Brecha sobre el ideal</h2>
        <p id="g-brecha-sub" class="text-xs text-telecab-muted">El acumulado menos el ideal de la meta, al cierre de cada día del mes.</p>
      </div>
      <div class="flex items-start gap-3">
        <div class="text-right">
          <p id="g-brecha-num" class="text-2xl font-semibold tabular-nums leading-none text-telecab-muted">—</p>
          <p id="g-brecha-num-sub" class="text-[11px] text-telecab-muted mt-1">al último día cerrado</p>
        </div>
        <%- botonTabla('brecha') %>
      </div>
    </div>
    <div id="g-brecha-caja" class="relative h-[240px] transition-opacity"><canvas id="g-brecha" role="img" aria-label="Brecha sobre el ideal, día a día"></canvas></div>
    <div id="g-brecha-tabla" class="hidden max-h-[300px] overflow-auto rounded-lg border border-telecab-border"></div>
    <div id="g-brecha-leyenda" class="flex flex-wrap items-center gap-x-4 gap-y-1 mt-2 text-[11px] text-telecab-muted"></div>
  </section>

  <!-- ── 3. Cómo hemos crecido: mes a mes ──────────────────────────────────── -->
  <section class="rounded-2xl border border-telecab-border bg-telecab-card p-4 mb-4" aria-labelledby="g-crec-titulo">
    <div class="flex flex-wrap items-start justify-between gap-3 mb-3">
      <div class="min-w-0">
        <h2 id="g-crec-titulo" class="text-sm font-semibold text-telecab-text">Cómo hemos crecido</h2>
        <p id="g-crec-sub" class="text-xs text-telecab-muted">Mes a mes. El mes en curso va en un punto hueco y, en las horas, una raya discontinua hasta donde cerraría al ritmo de ahora.</p>
      </div>
      <%- botonTabla('crec') %>
    </div>
    <div id="g-crec-cifras" class="grid grid-cols-2 lg:grid-cols-4 gap-2 mb-3"></div>
    <%# Horas al mes, a todo el ancho: con la historia desde enero son diez meses o
        más, y en un tercio de tarjeta sus % se montaban unos sobre otros. %>
    <div id="g-crec-caja" class="grid grid-cols-1 lg:grid-cols-2 gap-4 transition-opacity">
      <figure class="min-w-0 m-0 lg:col-span-2">
        <figcaption class="text-xs font-medium text-telecab-text mb-1">Horas al mes</figcaption>
        <div class="relative h-[220px]"><canvas id="g-crec-horas" role="img" aria-label="Horas al mes"></canvas></div>
      </figure>
      <figure class="min-w-0 m-0">
        <figcaption class="text-xs font-medium text-telecab-text mb-1" title="La media de los días cerrados con datos de cada mes: así un mes de 30 días y uno de 31 se comparan sin trampa.">Horas por día <span class="font-normal text-telecab-muted">· media del mes</span></figcaption>
        <div class="relative h-[220px]"><canvas id="g-crec-dia" role="img" aria-label="Horas por día de cada mes"></canvas></div>
      </figure>
      <figure class="min-w-0 m-0">
        <figcaption class="text-xs font-medium text-telecab-text mb-1" title="Cuántos conductores trabajaron (viaje o espera) cada día, de media en el mes.">Conductores al día <span class="font-normal text-telecab-muted">· media del mes</span></figcaption>
        <div class="relative h-[220px]"><canvas id="g-crec-cond" role="img" aria-label="Conductores al día de cada mes"></canvas></div>
      </figure>
    </div>
    <div id="g-crec-tabla" class="hidden max-h-[320px] overflow-auto rounded-lg border border-telecab-border"></div>
    <div id="g-crec-leyenda" class="flex flex-wrap items-center gap-x-4 gap-y-1 mt-2 text-[11px] text-telecab-muted"></div>
    <p id="g-crec-nota" class="text-[11px] text-telecab-muted mt-1"></p>
  </section>

  <!-- ── Tabla del mes (las columnas del VISOR) ──────────────────────────────── -->
  <div class="rounded-2xl border border-telecab-border bg-telecab-card overflow-hidden">
    <div class="px-4 py-3 border-b border-telecab-border flex items-center justify-between">
      <h2 class="text-sm font-semibold text-telecab-text">Detalle por día</h2>
      <span class="text-xs text-telecab-muted">TOTAL = viaje+espera · WAITING = espera · los días por venir van en gris</span>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="text-telecab-muted text-xs uppercase tracking-wide border-b border-telecab-border">
            <th class="text-left px-4 py-2">Día</th>
            <th class="text-right px-3 py-2">Total</th>
            <th class="text-right px-3 py-2">Waiting</th>
            <th class="text-right px-3 py-2">% Util</th>
            <th class="text-right px-3 py-2">Acumulado</th>
            <th class="text-right px-3 py-2">Ideal</th>
            <th class="text-right px-3 py-2">Crítico</th>
            <th class="text-right px-3 py-2">Brecha</th>
            <th class="text-right px-4 py-2">Sobre crítico</th>
          </tr>
        </thead>
        <tbody id="v-tabla" class="tabular-nums"></tbody>
      </table>
    </div>
  </div>

  <%# HORAS POR PLANTILLA (30/10/2026). Camilo: «dos tarjetas también de total de
      horas, por plantilla propia y ETT, donde se pueda filtrar por fechas, desde y
      hasta con los datos que tenemos disponibles». Cada día va al contrato que la
      persona tenía ese día. Solo Madrid: Barcelona no tiene contratos de la ETT. %>
  <% if (!SEDE_NOMBRE) { %>
  <section id="hp" class="rounded-2xl border border-telecab-border bg-telecab-card p-4 mt-4" aria-labelledby="hp-titulo">
    <div class="flex flex-wrap items-end justify-between gap-3 mb-3">
      <div class="min-w-0">
        <h2 id="hp-titulo" class="text-sm font-semibold text-telecab-text">Horas por plantilla</h2>
        <p class="text-xs text-telecab-muted">Horas efectivas (viaje + espera) por día natural, según el contrato de cada conductor ese día.</p>
      </div>
      <div class="flex items-end gap-2">
        <label class="block">
          <span class="text-[11px] text-telecab-muted">Desde</span>
          <input id="hp-desde" class="js-fecha block w-32 mt-1 px-3 py-2 bg-telecab-card2 border border-telecab-border rounded-xl text-sm text-telecab-text"
                 placeholder="dd/mm/aaaa" readonly data-max-field="hp-hasta">
        </label>
        <label class="block">
          <span class="text-[11px] text-telecab-muted">Hasta</span>
          <input id="hp-hasta" class="js-fecha block w-32 mt-1 px-3 py-2 bg-telecab-card2 border border-telecab-border rounded-xl text-sm text-telecab-text"
                 placeholder="dd/mm/aaaa" readonly data-min-field="hp-desde" data-max="today">
        </label>
      </div>
    </div>
    <div id="hp-tarjetas" class="grid grid-cols-1 md:grid-cols-2 gap-3 transition-opacity">
      <% [['propia', 'Plantilla propia'], ['ett', 'ETT']].forEach(([k, etq]) => { %>
      <div class="rounded-2xl border border-telecab-border bg-telecab-card2/40 p-4 min-w-0">
        <div class="flex flex-wrap items-center justify-between gap-x-2">
          <p class="text-[11px] text-telecab-muted uppercase tracking-wide"><%= etq %></p>
          <span id="hp-<%= k %>-cond" class="text-[11px] text-telecab-muted tabular-nums"></span>
        </div>
        <p class="text-xl sm:text-3xl font-bold mt-1 tabular-nums leading-none">
          <span id="hp-<%= k %>-h" class="text-telecab-text">—</span>
          <span class="text-sm text-telecab-muted font-normal">h</span>
        </p>
        <div class="mt-2.5 h-1.5 rounded-full bg-telecab-card2 overflow-hidden" title="Parte de las horas de la flota en esas fechas">
          <div id="hp-<%= k %>-bar" class="h-full bg-telecab-gold" style="width:0%"></div>
        </div>
        <p class="text-[11px] text-telecab-muted mt-1"><span id="hp-<%= k %>-pct">—</span> de las horas · <span id="hp-<%= k %>-util">—</span> utilización · <span id="hp-<%= k %>-media">—</span> por conductor</p>
      </div>
      <% }) %>
    </div>
    <p id="hp-nota" class="text-[11px] text-telecab-muted mt-2"></p>
  </section>
  <% } %>
</div>

<!-- ── Panel de config (capacidad, meta, vehículos, días) ────────────────────── -->
<div id="v-config-modal" class="hidden fixed inset-0 z-[120] flex items-center justify-center bg-black/60 backdrop-blur-sm p-4">
  <div class="w-full max-w-md rounded-2xl border border-telecab-border bg-telecab-card shadow-soft">
    <div class="px-5 py-4 border-b border-telecab-border flex items-center justify-between">
      <h3 class="font-semibold text-telecab-text"><i class="fa-solid fa-sliders mr-2 text-telecab-gold"></i>Config del visor</h3>
      <button id="v-config-x" class="text-telecab-muted hover:text-telecab-text" aria-label="Cerrar"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
    </div>
    <div class="p-5 space-y-3">
      <label class="block">
        <span class="text-xs text-telecab-muted">Capacidad diaria · h (por coche)</span>
        <input id="cfg-cap" type="number" step="0.1" class="mt-1 w-full px-3 py-2 rounded-lg bg-telecab-dark border border-telecab-border text-telecab-text">
      </label>
      <label class="block">
        <span class="text-xs text-telecab-muted">Meta del mes (horas)</span>
        <input id="cfg-meta" type="number" step="1" class="mt-1 w-full px-3 py-2 rounded-lg bg-telecab-dark border border-telecab-border text-telecab-text">
      </label>
      <label class="block">
        <span class="text-xs text-telecab-muted">Vehículos</span>
        <input id="cfg-veh" type="number" step="1" class="mt-1 w-full px-3 py-2 rounded-lg bg-telecab-dark border border-telecab-border text-telecab-text">
      </label>
      <div class="pt-3 border-t border-telecab-border/60">
        <p class="text-xs text-telecab-muted mb-1">Meta por turno · horas al día</p>
        <div class="grid grid-cols-2 gap-2">
          <label class="block">
            <span class="text-[11px] text-telecab-muted">Turno día</span>
            <input id="cfg-mtd" type="number" step="1" class="mt-1 w-full px-3 py-2 rounded-lg bg-telecab-dark border border-telecab-border text-telecab-text">
          </label>
          <label class="block">
            <span class="text-[11px] text-telecab-muted">Turno noche</span>
            <input id="cfg-mtn" type="number" step="1" class="mt-1 w-full px-3 py-2 rounded-lg bg-telecab-dark border border-telecab-border text-telecab-text">
          </label>
        </div>
        <p class="text-[11px] text-telecab-muted/70 mt-1">La jornada entera (día + noche) usa la suma: <span id="cfg-meta-dia">—</span> h.</p>
      </div>
      <label class="block">
        <span class="text-xs text-telecab-muted">Días del mes <span class="text-telecab-muted/60">(vacío = automático)</span></span>
        <input id="cfg-dias" type="number" step="1" placeholder="auto" class="mt-1 w-full px-3 py-2 rounded-lg bg-telecab-dark border border-telecab-border text-telecab-text">
      </label>
    </div>
    <div class="px-5 py-4 border-t border-telecab-border flex justify-end gap-2">
      <button id="v-config-cancel" class="px-3 py-2 rounded-lg text-sm text-telecab-muted hover:text-telecab-text">Cancelar</button>
      <button id="v-config-save" class="px-4 py-2 rounded-lg text-sm bg-telecab-gold text-telecab-dark font-semibold hover:brightness-95">Guardar y recalcular</button>
    </div>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/chartjs-plugin-datalabels/2.2.0/chartjs-plugin-datalabels.min.js"></script>
<script src="<%= typeof est === 'function' ? est('/assets/js/graficos.js') : '/assets/js/graficos.js' %>"></script>
<script type="application/json" id="datos-servidor"><%- json({
  api: (API == null ? '' : String(API)),
  sinPlan: SEDE_NOMBRE ? 'sin plaza' : 'sin plan (NN)',
  esMadrid: !SEDE_NOMBRE,
}) %></script>
<script src="<%= est('/assets/js/vistas/visibilidad.js') %>"></script>
