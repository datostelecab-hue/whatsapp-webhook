<div class="p-4 lg:p-6 max-w-3xl mx-auto space-y-5">

  <div>
    <h1 class="text-lg font-semibold text-telecab-text flex items-center gap-2">
      <i class="fa-solid fa-gear text-telecab-gold"></i> Configuración del sistema
    </h1>
    <p class="text-xs text-telecab-muted mt-0.5">Tu perfil, tu correo y la apariencia de la plataforma.</p>
  </div>

  <!-- Mi perfil (todos): nombre, apellidos y teléfono = tu firma en el sistema -->
  <div class="bg-telecab-card border border-telecab-border rounded-2xl p-5" id="card-perfil">
    <h2 class="text-sm font-semibold text-telecab-text mb-1 flex items-center gap-2"><i class="fa-solid fa-id-card text-telecab-gold"></i> Mi perfil</h2>
    <p class="text-xs text-telecab-muted mb-4">Tu nombre, apellidos y teléfono se usan como <b>firma</b> en las acciones que registras. Tu correo (<b><%= (typeof usuario !== 'undefined' && usuario && usuario.email) || '' %></b>) y tu rol los gestiona el administrador.</p>
    <div class="grid sm:grid-cols-3 gap-3">
      <div><label class="block text-xs text-telecab-muted mb-1">Nombre</label><input id="p-nombre" class="inp" value="<%= (typeof usuario !== 'undefined' && usuario && usuario.nombre) || '' %>"></div>
      <div><label class="block text-xs text-telecab-muted mb-1">Apellidos</label><input id="p-apellidos" class="inp" value="<%= (typeof usuario !== 'undefined' && usuario && usuario.apellidos) || '' %>"></div>
      <div><label class="block text-xs text-telecab-muted mb-1">Teléfono</label><input id="p-telefono" class="inp" inputmode="tel" value="<%= (typeof usuario !== 'undefined' && usuario && usuario.telefono) || '' %>"></div>
    </div>
    <div class="mt-4 pt-3 border-t border-telecab-border">
      <p class="text-xs text-telecab-muted mb-2">
        <i class="fa-solid fa-envelope text-telecab-gold mr-1"></i>
        <b class="text-telecab-text">Tu correo.</b> Los avisos de tus procesos salen <b>desde tu propio correo</b>
        (<span class="font-mono"><%= (typeof usuario !== 'undefined' && usuario && usuario.email) || '' %></span>), así queda registrado quién hizo qué.
        Para eso hace falta la contraseña de tu buzón (se guarda <b>cifrada</b>). <span id="p-correo-estado" class="text-telecab-muted"></span>
      </p>
      <div class="flex flex-wrap items-end gap-2">
        <div>
          <label class="block text-xs text-telecab-muted mb-1">Contraseña de correo</label>
          <input id="p-pass-correo" type="password" class="inp !w-56" placeholder="••••••••" autocomplete="new-password">
        </div>
        <button id="p-probar-correo" class="px-3 py-2 rounded-xl bg-telecab-card2 border border-telecab-border text-telecab-text hover:border-telecab-gold transition text-sm"><i class="fa-solid fa-paper-plane mr-1"></i> Probar mi correo</button>
        <span id="p-correo-msg" class="text-xs hidden"></span>
      </div>
    </div>

    <div class="flex items-center gap-3 mt-3">
      <button id="p-guardar" class="px-4 py-2 rounded-xl bg-telecab-gold/15 border border-telecab-gold/40 text-telecab-gold hover:bg-telecab-gold/25 transition font-semibold text-sm"><i class="fa-solid fa-floppy-disk mr-1"></i> Guardar</button>
      <a href="/cambiar-password" class="text-xs text-telecab-muted hover:text-telecab-gold transition">Cambiar mi contraseña</a>
      <span id="p-msg" class="text-xs ml-auto hidden"></span>
    </div>

    <div class="mt-4 pt-3 border-t border-telecab-border">
      <h3 class="text-xs font-semibold text-telecab-text uppercase tracking-wide mb-1 flex items-center gap-2"><i class="fa-solid fa-palette text-telecab-gold"></i> Apariencia</h3>
      <p class="text-xs text-telecab-muted mb-3">Elige un tema. El automático sigue la configuración de tu sistema. Se guarda en tu perfil y te acompaña en cualquier dispositivo.</p>
      <div id="temas" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3"></div>
      <p id="tema-msg" class="text-xs text-telecab-muted mt-4"></p>
    </div>

    <div class="mt-4 pt-3 border-t border-telecab-border">
      <h3 class="text-xs font-semibold text-telecab-text uppercase tracking-wide mb-1 flex items-center gap-2"><i class="fa-solid fa-circle-question text-telecab-gold"></i> Ayudas</h3>
      <p class="text-xs text-telecab-muted mb-3">
        Al pasar el cursor por encima de un número o un botón, el sistema explica qué es.
        Para quien acaba de entrar son la forma de aprender la pantalla sin preguntar;
        para quien lleva años, un estorbo. <b>Tú decides</b>, y te acompaña en cualquier dispositivo.
      </p>
      <label class="flex items-center gap-3 cursor-pointer select-none w-fit"
             title="Apagadas, vuelven los globos del navegador de siempre">
        <input type="checkbox" id="p-ayudas" class="accent-telecab-gold w-4 h-4">
        <span class="text-sm text-telecab-text">Enseñar las ayudas al pasar el cursor</span>
      </label>
      <p id="ayudas-msg" class="text-xs text-telecab-muted mt-3"></p>
    </div>
  </div>

  <!-- Sesiones abiertas. De cada uno: no hay forma de ver las de otro. -->
  <div class="bg-telecab-card border border-telecab-border rounded-2xl p-5" id="card-sesiones">
    <h2 class="text-sm font-semibold text-telecab-text mb-1 flex items-center gap-2"><i class="fa-solid fa-mobile-screen-button text-telecab-gold"></i> Sesiones abiertas</h2>
    <p class="text-xs text-telecab-muted mb-4">
      Dónde está tu cuenta abierta ahora mismo. Si no reconoces una, ciérrala y cambia tu contraseña.
    </p>
    <div id="s-padre" class="text-xs mb-3 hidden"></div>
    <div id="s-lista" class="space-y-2"><p class="text-xs text-telecab-muted">Cargando…</p></div>
    <div class="mt-4 flex items-center gap-3 flex-wrap">
      <button id="s-todas" class="px-4 py-2 rounded-xl bg-telecab-red/10 border border-telecab-red/40 text-telecab-red hover:bg-telecab-red/20 transition font-semibold text-sm hidden">
        <i class="fa-solid fa-right-from-bracket mr-1"></i> Cerrar todas menos esta
      </button>
      <span id="s-msg" class="text-xs hidden"></span>
    </div>
  </div>

  <!-- Gestión de usuarios (solo el desarrollador; la matriz completa está en /usuarios) -->
  <% if (typeof rol !== 'undefined' && rol === 'desarrollador') { %>
  <div class="bg-telecab-card border border-telecab-border rounded-2xl p-5" id="card-usuarios">
    <h2 class="text-sm font-semibold text-telecab-text mb-1 flex items-center gap-2"><i class="fa-solid fa-users-gear text-telecab-gold"></i> Usuarios</h2>
    <p class="text-xs text-telecab-muted mb-4">Crea accesos y asigna roles. Al crear un usuario se le envía una contraseña provisional a su correo; en su primer acceso elige la suya.</p>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-2">
      <input id="u-nombre" class="inp" placeholder="Nombre">
      <input id="u-apellidos" class="inp" placeholder="Apellidos">
      <input id="u-telefono" class="inp" placeholder="Teléfono" inputmode="tel">
      <input id="u-email" type="email" class="inp lg:col-span-2" placeholder="correo@telecab.es" autocomplete="off">
      <select id="u-rol" class="inp">
        <option value="oficina">Oficina</option>
        <option value="trafico">Tráfico</option>
        <option value="superadmin">Superadmin</option>
        <option value="desarrollador">Desarrollador</option>
      </select>
    </div>
    <button id="u-crear" class="mt-2 px-4 py-2 rounded-xl bg-telecab-gold/15 border border-telecab-gold/40 text-telecab-gold hover:bg-telecab-gold/25 transition font-semibold text-sm">
      <i class="fa-solid fa-user-plus mr-1"></i> Crear y enviar acceso
    </button>
    <p id="u-msg" class="text-xs mt-2 hidden"></p>

    <div class="mt-4 border-t border-telecab-border pt-3">
      <div id="u-lista" class="space-y-1.5"></div>
    </div>
  </div>
  <% } %>

  <!-- Correo para procesos (solo superadmin) -->
  <% if (typeof rol !== 'undefined' && rol === 'superadmin') { %>
  <div class="bg-telecab-card border border-telecab-border rounded-2xl p-5" id="card-correo">
    <h2 class="text-sm font-semibold text-telecab-text mb-1 flex items-center gap-2"><i class="fa-solid fa-envelope-circle-check text-telecab-gold"></i> Correo para procesos</h2>
    <p class="text-xs text-telecab-muted mb-4">Cuenta desde la que la plataforma envía los correos (accesos, avisos, auditoría). La contraseña se guarda <b>cifrada</b>. Para telecab.es (DonDominio): servidor <b>smtp.dondominio.com</b>, puerto <b>587</b>, usuario = tu correo completo. El <b>«De:» debe ser una dirección @telecab.es</b> (puedes enviar a cualquier destinatario, pero no <i>como</i> un gmail ajeno).</p>
    <div class="grid sm:grid-cols-2 gap-3">
      <div>
        <label class="block text-xs text-telecab-muted mb-1">Servidor SMTP</label>
        <input id="c-host" class="inp" placeholder="smtp.dondominio.com" autocomplete="off">
      </div>
      <div>
        <label class="block text-xs text-telecab-muted mb-1">Puerto</label>
        <input id="c-port" class="inp" placeholder="587" inputmode="numeric">
      </div>
      <div>
        <label class="block text-xs text-telecab-muted mb-1">Usuario — buzón que envía <span class="text-telecab-muted/70">(@telecab.es, no un gmail)</span></label>
        <input id="c-user" class="inp" placeholder="datos@telecab.es" autocomplete="off">
      </div>
      <div>
        <label class="block text-xs text-telecab-muted mb-1">Remitente «De:» <span class="text-telecab-muted/70">(@telecab.es)</span></label>
        <input id="c-from" class="inp" placeholder="noreply@telecab.es">
      </div>
      <div class="sm:col-span-2">
        <label class="block text-xs text-telecab-muted mb-1">Contraseña <span id="c-pass-nota" class="text-telecab-muted/70"></span></label>
        <input id="c-pass" type="password" class="inp" placeholder="••••••••" autocomplete="new-password">
      </div>
    </div>
    <div class="flex flex-wrap items-end gap-2 mt-3">
      <button id="c-guardar" class="px-4 py-2 rounded-xl bg-telecab-gold/15 border border-telecab-gold/40 text-telecab-gold hover:bg-telecab-gold/25 transition font-semibold text-sm"><i class="fa-solid fa-floppy-disk mr-1"></i> Guardar</button>
      <div>
        <label class="block text-[11px] text-telecab-muted mb-0.5">Enviar prueba a</label>
        <input id="c-prueba-to" class="inp !w-52 text-sm" placeholder="tu@correo.com" value="<%= (typeof usuario !== 'undefined' && usuario && usuario.email) || '' %>">
      </div>
      <button id="c-prueba" class="px-4 py-2 rounded-xl bg-telecab-card2 border border-telecab-border text-telecab-text hover:border-telecab-gold transition text-sm"><i class="fa-solid fa-paper-plane mr-1"></i> Enviar prueba</button>
      <span id="c-estado" class="text-xs text-telecab-muted ml-auto"></span>
    </div>
    <p id="c-msg" class="text-xs mt-2 hidden"></p>
  </div>
  <% } %>

</div>

<script>
  const KEY = 'telecab-tema';
  // Cada tema: clave (= data-theme), nombre, y colores de la mini-vista-previa.
  const TEMAS = [
    { k: 'dark',       n: 'Oscuro',          bg: '#1b1619', ac: '#f4963c', tx: '#f4f0ec', claro: false },
    { k: 'azul',       n: 'Azul',            bg: '#131927', ac: '#60a5fa', tx: '#e6e8ec', claro: false },
    { k: 'verde',      n: 'Verde',           bg: '#101d18', ac: '#34d399', tx: '#e6e8ec', claro: false },
    { k: 'purpura',    n: 'Púrpura',         bg: '#1a1425', ac: '#a78bfa', tx: '#e6e8ec', claro: false },
    { k: 'rosa',       n: 'Rosa',            bg: '#21141c', ac: '#f472b6', tx: '#e6e8ec', claro: false },
    { k: 'cian',       n: 'Cian',            bg: '#0f1e21', ac: '#2dd4cd', tx: '#e6e8ec', claro: false },
    { k: 'naranja',    n: 'Naranja',         bg: '#22160e', ac: '#fb923c', tx: '#f4f0ec', claro: false },
    { k: 'contraste',  n: 'Alto contraste',  bg: '#000000', ac: '#ffd60a', tx: '#ffffff', claro: false },
    { k: 'light',         n: 'Claro',           bg: '#fbf7f3', ac: '#c96c14', tx: '#261e1c', claro: true },
    { k: 'claro-azul',    n: 'Claro azul',      bg: '#ffffff', ac: '#2563eb', tx: '#161f2e', claro: true },
    { k: 'claro-verde',   n: 'Claro verde',     bg: '#ffffff', ac: '#15803d', tx: '#18221c', claro: true },
    { k: 'claro-rosa',    n: 'Claro rosa',      bg: '#ffffff', ac: '#c81d68', tx: '#281a22', claro: true },
    { k: 'claro-purpura', n: 'Claro púrpura',   bg: '#ffffff', ac: '#7c3aed', tx: '#1e1a2c', claro: true },
    { k: 'claro-naranja', n: 'Claro naranja',   bg: '#ffffff', ac: '#c2410c', tx: '#281e16', claro: true },
    { k: 'auto',          n: 'Automático',      bg: 'auto',    ac: '#8b93a1', tx: '#8b93a1', claro: false }
  ];

  const resolver = pref => pref === 'auto'
    ? (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark')
    : pref;
  const aplicar = pref => document.documentElement.setAttribute('data-theme', resolver(pref));

  function preview(t) {
    if (t.k === 'auto') {
      // Mitad oscuro / mitad claro para representar "automático".
      return `<div style="height:52px;border-radius:8px;overflow:hidden;display:flex;">
          <div style="flex:1;background:#171b22;display:flex;align-items:center;justify-content:center;">
            <span style="width:12px;height:12px;border-radius:50%;background:#e8b84b;"></span></div>
          <div style="flex:1;background:#ffffff;display:flex;align-items:center;justify-content:center;">
            <span style="width:12px;height:12px;border-radius:50%;background:#b78218;"></span></div>
        </div>`;
    }
    return `<div style="height:52px;border-radius:8px;background:${t.bg};border:1px solid ${t.claro ? '#e2e8f0' : '#2a3140'};padding:8px 10px;display:flex;flex-direction:column;justify-content:space-between;">
        <div style="display:flex;align-items:center;gap:5px;">
          <span style="width:11px;height:11px;border-radius:50%;background:${t.ac};"></span>
          <span style="height:5px;width:38%;border-radius:3px;background:${t.tx};opacity:.85;"></span>
        </div>
        <div style="display:flex;gap:4px;align-items:center;">
          <span style="height:4px;width:55%;border-radius:3px;background:${t.tx};opacity:.35;"></span>
          <span style="height:14px;width:22px;border-radius:5px;background:${t.ac};opacity:.22;border:1px solid ${t.ac};"></span>
        </div>
      </div>`;
  }

  function pintarSel(sel) {
    document.querySelectorAll('.tema').forEach(b => {
      const on = b.dataset.tema === sel;
      b.classList.toggle('border-telecab-gold', on);
      b.classList.toggle('border-2', on);
      b.classList.toggle('border-telecab-border', !on);
    });
    const t = TEMAS.find(x => x.k === sel);
    const el = document.getElementById('tema-msg');
    el.textContent = sel === 'auto'
      ? `Automático — ahora mismo se ve ${resolver('auto') === 'light' ? 'claro' : 'oscuro'}.`
      : `Tema “${(t && t.n) || sel}” activo.`;
  }

  const cont = document.getElementById('temas');
  cont.innerHTML = TEMAS.map(t =>
    `<button data-tema="${t.k}" class="tema text-left p-2 rounded-xl border border-telecab-border hover:border-telecab-gold/50 transition">
       ${preview(t)}
       <span class="block text-xs text-telecab-text mt-2 px-0.5">${t.n}</span>
     </button>`).join('');

  let actual = ('<%= (typeof tema !== "undefined" && tema) ? tema : "" %>') || localStorage.getItem(KEY) || 'dark';
  document.querySelectorAll('.tema').forEach(b => b.addEventListener('click', () => {
    actual = b.dataset.tema;
    localStorage.setItem(KEY, actual);
    aplicar(actual); pintarSel(actual);
    // Persiste el tema en el perfil (y en la cookie de sesión): sigue al usuario entre dispositivos.
    fetch('/configuracion/mi-tema', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ tema: actual }) }).catch(() => {});
  }));
  pintarSel(actual);

  // Si está en "automático", seguir al sistema en vivo.
  matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
    if ((localStorage.getItem(KEY) || 'dark') === 'auto') { aplicar('auto'); pintarSel('auto'); }
  });
</script>

<!-- Gestión de usuarios (solo se activa si el superadmin ve la tarjeta). -->
<script>
(function () {
  const card = document.getElementById('card-usuarios');
  if (!card) return;   // no es superadmin → no hay tarjeta
  const ROLN = { superadmin: 'Superadmin', oficina: 'Oficina', trafico: 'Tráfico' };
  const lista = document.getElementById('u-lista');
  const msg = document.getElementById('u-msg');
  let YO = '';
  const esc = s => String(s == null ? '' : s).replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
  const aviso = (t, cls) => { msg.textContent = t; msg.className = 'text-xs mt-2 ' + cls; msg.classList.remove('hidden'); };
  async function api(url, body) {
    const r = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body || {}) });
    return r.json();
  }

  function fila(u) {
    const el = document.createElement('div');
    el.className = 'flex flex-wrap items-center gap-2 px-3 py-2 rounded-xl bg-telecab-dark/40 border border-telecab-border';
    const bloqueado = u.estado === 'bloqueado';
    const yo = u.email === YO;
    el.innerHTML =
      `<span class="min-w-0 flex-1">
         <span class="block text-sm text-telecab-text truncate">${esc(u.nombre)} ${esc(u.apellidos || '')} ${yo ? '<span class="text-[10px] text-telecab-gold">(tú)</span>' : ''} ${u.debe_cambiar ? '<span class="text-[10px] text-telecab-muted">· provisional</span>' : ''}</span>
         <span class="block text-[11px] text-telecab-muted font-mono truncate">${esc(u.email)}${u.telefono ? ' · ' + esc(u.telefono) : ''}${u.ultimo_acceso ? ' · último: ' + esc(u.ultimo_acceso) : ' · nunca ha entrado'}</span>
       </span>
       <select class="u-rol inp !w-32 text-xs !py-1" data-email="${esc(u.email)}">
         ${['superadmin', 'oficina', 'trafico'].map(r => `<option value="${r}" ${u.rol === r ? 'selected' : ''}>${ROLN[r]}</option>`).join('')}
       </select>
       <button class="u-estado text-xs px-2 py-1 rounded-lg border ${bloqueado ? 'border-telecab-red/40 text-telecab-red' : 'border-telecab-green/40 text-telecab-green'}" data-email="${esc(u.email)}" data-estado="${bloqueado ? 'activo' : 'bloqueado'}">${bloqueado ? 'Activar' : 'Desactivar'}</button>
       <button class="u-reset text-xs px-2 py-1 rounded-lg border border-telecab-border text-telecab-muted hover:text-telecab-gold" data-email="${esc(u.email)}" title="Enviar nueva contraseña provisional"><i class="fa-solid fa-key"></i></button>`;
    return el;
  }

  async function cargar() {
    try {
      const r = await (await fetch('/usuarios/api/datos')).json();
      if (r.status !== 'ok') return aviso(r.msg || 'No se pudo cargar la lista', 'text-telecab-red');
      YO = r.yo || '';
      lista.innerHTML = '';
      (r.usuarios || []).sort((a, b) => (a.nombre || '').localeCompare(b.nombre || '', 'es')).forEach(u => lista.appendChild(fila(u)));
    } catch (_) {}
  }

  document.getElementById('u-crear').addEventListener('click', async () => {
    const nombre = document.getElementById('u-nombre').value.trim();
    const apellidos = document.getElementById('u-apellidos').value.trim();
    const telefono = document.getElementById('u-telefono').value.trim();
    const email = document.getElementById('u-email').value.trim();
    const rol = document.getElementById('u-rol').value;
    if (!nombre || !apellidos || !telefono || !email) return aviso('Completa nombre, apellidos, teléfono y correo.', 'text-telecab-red');
    const r = await api('/usuarios/crear', { nombre, apellidos, telefono, email, rol });
    if (r.status !== 'ok') return aviso(r.msg || 'No se pudo crear', 'text-telecab-red');
    ['u-nombre', 'u-apellidos', 'u-telefono', 'u-email'].forEach(id => { document.getElementById(id).value = ''; });
    if (r.correoEnviado) aviso('Usuario creado. Se le envió la contraseña provisional por correo.', 'text-telecab-green');
    else aviso('Usuario creado. El correo aún no está configurado → contraseña provisional: ' + r.passwordProvisional + ' (pásasela tú).', 'text-telecab-gold');
    cargar();
  });

  lista.addEventListener('change', async e => {
    const sel = e.target.closest('.u-rol');
    if (!sel) return;
    const r = await api('/usuarios/rol', { email: sel.dataset.email, rol: sel.value });
    if (r.status !== 'ok') aviso(r.msg || 'No se pudo cambiar el rol', 'text-telecab-red');
    cargar();
  });

  lista.addEventListener('click', async e => {
    const est = e.target.closest('.u-estado');
    const res = e.target.closest('.u-reset');
    if (est) {
      const r = await api('/usuarios/estado', { email: est.dataset.email, estado: est.dataset.estado });
      if (r.status !== 'ok') aviso(r.msg || 'No se pudo cambiar el estado', 'text-telecab-red');
      cargar();
    } else if (res) {
      if (!confirm('¿Enviar una nueva contraseña provisional a ' + res.dataset.email + '?')) return;
      const r = await api('/usuarios/reset', { email: res.dataset.email });
      if (r.status !== 'ok') return aviso(r.msg || 'No se pudo resetear', 'text-telecab-red');
      if (r.correoEnviado) aviso('Nueva provisional enviada por correo a ' + res.dataset.email + '.', 'text-telecab-green');
      else aviso('Nueva provisional (correo sin configurar) de ' + res.dataset.email + ': ' + r.passwordProvisional, 'text-telecab-gold');
    }
  });

  cargar();
})();
</script>

<!-- Correo para procesos (solo se activa si el superadmin ve la tarjeta). -->
<script>
(function () {
  const card = document.getElementById('card-correo');
  if (!card) return;
  const $ = id => document.getElementById(id);
  const msg = $('c-msg');
  const aviso = (t, cls) => { msg.textContent = t; msg.className = 'text-xs mt-2 ' + cls; msg.classList.remove('hidden'); };
  async function post(url, body) {
    const r = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body || {}) });
    return r.json();
  }
  function pintar(e) {
    $('c-host').value = e.host || '';
    $('c-port').value = e.port || '587';
    $('c-user').value = e.user || '';
    $('c-from').value = e.from || '';
    $('c-pass-nota').textContent = e.tienePass ? '(guardada — déjala vacía para no cambiarla)' : '(requerida)';
    $('c-estado').innerHTML = e.activo
      ? '<span class="text-telecab-green"><i class="fa-solid fa-circle-check"></i> Envío activo</span>'
      : (e.envCredenciales ? '<span class="text-telecab-gold">Usando credenciales del servidor</span>' : '<span class="text-telecab-muted">Sin configurar</span>');
  }
  async function cargar() { try { const r = await (await fetch('/configuracion/correo')).json(); if (r.status === 'ok') pintar(r.estado); } catch (_) {} }

  $('c-guardar').addEventListener('click', async () => {
    const body = { host: $('c-host').value.trim(), port: $('c-port').value.trim(), user: $('c-user').value.trim(), from: $('c-from').value.trim() };
    if ($('c-pass').value) body.pass = $('c-pass').value;
    const r = await post('/configuracion/correo', body);
    if (r.status !== 'ok') return aviso(r.msg || 'No se pudo guardar', 'text-telecab-red');
    $('c-pass').value = ''; pintar(r.estado); aviso('Guardado.', 'text-telecab-green');
  });
  $('c-prueba').addEventListener('click', async () => {
    aviso('Enviando prueba…', 'text-telecab-muted');
    const to = $('c-prueba-to').value.trim();
    const r = await post('/configuracion/correo/prueba', to ? { to } : {});
    if (r.enviado) aviso('Prueba enviada a ' + (to || 'tu correo') + '. Revísalo (mira también spam).', 'text-telecab-green');
    else aviso('No se pudo enviar: ' + (r.msg || 'revisa los datos'), 'text-telecab-red');
  });
  cargar();
})();
</script>

<!-- Mi perfil: cada usuario completa su nombre/apellidos/teléfono (su firma). -->
<script>
(function () {
  const card = document.getElementById('card-perfil');
  if (!card) return;
  const $ = id => document.getElementById(id);
  const msg = $('p-msg');
  const aviso = (t, cls) => { msg.textContent = t; msg.className = 'text-xs ml-auto ' + cls; msg.classList.remove('hidden'); };
  const cMsg = $('p-correo-msg');
  const cAviso = (t, cls) => { cMsg.textContent = t; cMsg.className = 'text-xs ' + cls; cMsg.classList.remove('hidden'); };

  async function estadoCorreo() {
    try {
      const r = await (await fetch('/configuracion/mi-correo')).json();
      if (r.status === 'ok') $('p-correo-estado').innerHTML = r.tieneCorreo
        ? '<span class="text-telecab-green">✓ guardada (déjala vacía para no cambiarla)</span>'
        : '<span class="text-telecab-gold">— aún sin configurar</span>';
    } catch (_) {}
  }
  estadoCorreo();

  async function guardarPerfil(incluirCorreo) {
    const body = { nombre: $('p-nombre').value.trim(), apellidos: $('p-apellidos').value.trim(), telefono: $('p-telefono').value.trim() };
    if (incluirCorreo && $('p-pass-correo').value) body.pass_correo = $('p-pass-correo').value;
    return (await fetch('/configuracion/mi-perfil', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) })).json();
  }

  $('p-guardar').addEventListener('click', async () => {
    if (!$('p-nombre').value.trim()) return aviso('Pon tu nombre.', 'text-telecab-red');
    try {
      const r = await guardarPerfil(true);
      if (r.status !== 'ok') return aviso(r.msg || 'No se pudo guardar', 'text-telecab-red');
      $('p-pass-correo').value = '';
      aviso('Guardado.', 'text-telecab-green');
      estadoCorreo();
    } catch (_) { aviso('No se pudo guardar', 'text-telecab-red'); }
  });

  $('p-probar-correo').addEventListener('click', async () => {
    try {
      // Si escribió una contraseña nueva, se guarda antes de probar.
      if ($('p-pass-correo').value) {
        const g = await guardarPerfil(true);
        if (g.status !== 'ok') return cAviso(g.msg || 'No se pudo guardar la contraseña', 'text-telecab-red');
        $('p-pass-correo').value = '';
        estadoCorreo();
      }
      cAviso('Enviando prueba…', 'text-telecab-muted');
      const r = await (await fetch('/configuracion/mi-perfil/probar-correo', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({}) })).json();
      if (r.enviado) cAviso('Prueba enviada a tu correo. Revísalo (mira también spam).', 'text-telecab-green');
      else cAviso('No se pudo enviar: ' + (r.msg || 'revisa tu contraseña de correo'), 'text-telecab-red');
    } catch (_) { cAviso('No se pudo enviar la prueba', 'text-telecab-red'); }
  });
})();
</script>

<script>
// ── SESIONES ABIERTAS ───────────────────────────────────────────────────────
// La pantalla NO decide nada: esconde el botón para no prometer lo que no se
// puede hacer, pero quien dice que no es el servidor. `mando` viene de ahí.
(function () {
  const $ = s => document.querySelector(s);
  const esc = s => String(s == null ? '' : s).replace(/[&<>"]/g, c =>
    ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));

  const fechaLarga = iso => !iso ? '—' : new Date(iso).toLocaleString('es-ES',
    { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
  const soloDia = iso => !iso ? '—' : new Date(iso).toLocaleDateString('es-ES',
    { day: '2-digit', month: 'long', year: 'numeric' });

  /** "hace 3 min", "hace 2 h", "hace 4 días". */
  function hace(iso) {
    if (!iso) return '';
    const m = Math.max(0, Math.round((Date.now() - new Date(iso).getTime()) / 60000));
    if (m < 2) return 'ahora mismo';
    if (m < 60) return 'hace ' + m + ' min';
    const h = Math.round(m / 60);
    if (h < 24) return 'hace ' + h + ' h';
    const d = Math.round(h / 24);
    return 'hace ' + d + (d === 1 ? ' día' : ' días');
  }

  function aviso(txt, tono) {
    const e = $('#s-msg');
    e.textContent = txt;
    e.className = 'text-xs ' + (tono === 'error' ? 'text-telecab-red' : tono === 'ok' ? 'text-telecab-green' : 'text-telecab-muted');
    e.classList.remove('hidden');
  }

  function pintar(d) {
    const ses = d.sesiones || [];
    // La línea de arriba explica la regla ANTES de que alguien pulse y se lleve
    // un "no puedes": una prohibición que se entiende no es una prohibición.
    const p = $('#s-padre');
    if (d.padre) {
      p.className = 'text-xs mb-3 rounded-xl border border-telecab-border bg-telecab-card2/40 px-3 py-2 text-telecab-muted';
      p.innerHTML = d.mando
        ? `<i class="fa-solid fa-shield-halved text-telecab-gold"></i> Estás en tu <b class="text-telecab-text">dispositivo principal</b>`
          + ` (${esc(d.padre.etiqueta)}, desde el ${esc(soloDia(d.padre.desde))}), así que desde aquí puedes cerrar cualquier otra sesión.`
        : `<i class="fa-solid fa-lock text-telecab-muted"></i> Tu <b class="text-telecab-text">dispositivo principal</b> es`
          + ` <b class="text-telecab-text">${esc(d.padre.etiqueta)}</b>, donde entraste por primera vez el ${esc(soloDia(d.padre.desde))}.`
          + ` Solo desde ahí se pueden cerrar las demás sesiones; desde aquí puedes cerrar esta.`;
      p.classList.remove('hidden');
    } else p.classList.add('hidden');

    $('#s-todas').classList.toggle('hidden', !d.mando || ses.length < 2);

    $('#s-lista').innerHTML = ses.length ? ses.map(x => `
      <div class="flex items-center gap-3 flex-wrap rounded-xl border px-3 py-2.5 ${
        x.actual ? 'border-telecab-green/40 bg-telecab-green/5' : 'border-telecab-border bg-telecab-card2/30'}">
        <i class="fa-solid ${/Android|iPhone|iPad/i.test(x.etiqueta) ? 'fa-mobile-screen-button' : 'fa-display'} text-telecab-muted"></i>
        <div class="min-w-0 flex-1">
          <div class="text-sm font-medium text-telecab-text truncate">${esc(x.etiqueta)}
            ${x.actual ? '<span class="text-[10px] px-1.5 py-0.5 rounded bg-telecab-green/15 text-telecab-green border border-telecab-green/30 ml-1">esta sesión</span>' : ''}
            ${x.esPadre ? '<span class="text-[10px] px-1.5 py-0.5 rounded bg-telecab-gold/15 text-telecab-gold border border-telecab-gold/30 ml-1">principal</span>' : ''}
            ${x.larga ? '<span class="text-[10px] text-telecab-muted ml-1" title="Sesión de 30 días">recordada</span>' : ''}
          </div>
          <div class="text-[11px] text-telecab-muted">
            Entró el ${esc(fechaLarga(x.desde))} · visto ${esc(hace(x.vista))}${x.ip ? ' · ' + esc(x.ip) : ''}
            ${x.dispositivoDesde ? `<br>Este dispositivo se usa desde el ${esc(soloDia(x.dispositivoDesde))}` : ''}
          </div>
        </div>
        ${(x.actual || d.mando) ? `<button data-cerrar="${esc(x.sid)}"
          class="px-3 py-1.5 rounded-lg border border-telecab-border text-xs text-telecab-muted hover:border-telecab-red hover:text-telecab-red transition whitespace-nowrap">
          <i class="fa-solid fa-xmark mr-1"></i>${x.actual ? 'Salir aquí' : 'Cerrar'}</button>` : ''}
      </div>`).join('')
      : '<p class="text-xs text-telecab-muted">No hay ninguna sesión registrada. Las de antes de esta pantalla no se pueden listar; se van solas al caducar.</p>';

    $('#s-lista').querySelectorAll('[data-cerrar]').forEach(b =>
      b.addEventListener('click', () => cerrar(b.dataset.cerrar)));
  }

  async function pedir(url, opciones) {
    const r = await (await fetch(url, opciones)).json();
    if (r.status !== 'ok') throw new Error(r.msg || 'No se ha podido');
    return r;
  }

  async function cerrar(sid) {
    const esLaMia = (window.__SES || []).some(x => x.sid === sid && x.actual);
    const ok = await Dialogo.confirmar({
      titulo: esLaMia ? '¿Salir en este dispositivo?' : '¿Cerrar esa sesión?',
      texto: esLaMia
        ? 'Se cerrará aquí y volverás a la pantalla de acceso.'
        : 'Ese dispositivo volverá a pedir usuario y contraseña la próxima vez que toque algo.',
      textoBoton: esLaMia ? 'Salir' : 'Cerrar sesión', tono: 'aviso',
    });
    if (!ok) return;
    try {
      const r = await pedir('/configuracion/mis-sesiones/cerrar',
        { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ sid }) });
      if (r.propia) { window.location.href = '/login'; return; }
      window.__SES = r.sesiones; pintar(r);
      aviso('Sesión cerrada.', 'ok');
    } catch (e) { aviso(e.message, 'error'); }
  }

  $('#s-todas').addEventListener('click', async () => {
    const ok = await Dialogo.confirmar({
      titulo: '¿Cerrar todas las demás?',
      texto: 'Todos los demás dispositivos volverán a pedir usuario y contraseña. Esta sesión se queda.',
      textoBoton: 'Cerrar las demás', tono: 'aviso',
    });
    if (!ok) return;
    try {
      const r = await pedir('/configuracion/mis-sesiones/cerrar-las-demas', { method: 'POST' });
      window.__SES = r.sesiones; pintar(r);
      aviso(r.cerradas ? `${r.cerradas} sesión(es) cerradas.` : 'No había otras sesiones abiertas.', 'ok');
    } catch (e) { aviso(e.message, 'error'); }
  });

  (async () => {
    try {
      const r = await pedir('/configuracion/mis-sesiones');
      window.__SES = r.sesiones; pintar(r);
    } catch (e) {
      $('#s-lista').innerHTML = `<p class="text-xs text-telecab-red">${esc(e.message)}</p>`;
    }
  })();
})();
</script>

<script>
// ── EL INTERRUPTOR DE LAS AYUDAS ────────────────────────────────────────────
// Se enciende y se apaga EN CALIENTE: `Ayudas.activar` cambia la marca del
// documento, así que se nota en la misma pantalla sin recargar. Y además se
// guarda en el perfil, para el resto de dispositivos.
(function () {
  const caja = document.getElementById('p-ayudas');
  const msg = document.getElementById('ayudas-msg');
  if (!caja) return;

  caja.checked = document.documentElement.getAttribute('data-ayudas') !== '0';

  caja.addEventListener('change', async () => {
    const si = caja.checked;
    if (window.Ayudas) window.Ayudas.activar(si);   // se ve al momento
    msg.textContent = 'Guardando…';
    msg.className = 'text-xs text-telecab-muted mt-3';
    try {
      const r = await (await fetch('/configuracion/mis-ayudas', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ayudas: si }),
      })).json();
      if (r.status !== 'ok') throw new Error(r.msg || 'No se ha podido guardar');
      msg.textContent = si
        ? '✓ Las ayudas están encendidas. Pasa el cursor por encima de este texto para verlas.'
        : '✓ Apagadas. Vuelven los globos del navegador de siempre.';
      msg.className = 'text-xs text-telecab-green mt-3';
    } catch (e) {
      // Se devuelve la casilla a donde estaba: dejarla marcada cuando no se ha
      // guardado es decirle a alguien que su preferencia está puesta y no lo está.
      caja.checked = !si;
      if (window.Ayudas) window.Ayudas.activar(!si);
      msg.textContent = e.message;
      msg.className = 'text-xs text-telecab-red mt-3';
    }
  });
})();
</script>
