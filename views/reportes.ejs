<%- include('partials/control-nav', { sub: 'reportes' }) %>

<div class="max-w-[1100px] mx-auto">

  <div class="mb-5">
    <h1 class="text-2xl font-bold text-telecab-text flex items-center gap-2">
      <i class="fa-solid fa-chart-pie text-telecab-gold"></i> Reportes
    </h1>
    <p class="text-sm text-telecab-muted mt-1">
      Lo que se imprime o se manda: cada tarjeta baja un Excel o un PDF. Todo sale de
      PostgreSQL, nada de hojas. Lo que se mira en pantalla vive en <a href="/control" class="text-telecab-gold hover:underline">En directo</a>.
    </p>
  </div>

  <div class="grid sm:grid-cols-2 gap-3 mb-6">

    <!-- Reporte de horas del día: Excel + Sankey -->
    <div class="rounded-2xl border border-telecab-border bg-telecab-card p-4">
      <div class="flex items-start gap-3">
        <i class="fa-solid fa-clock text-telecab-gold text-lg mt-0.5"></i>
        <div class="flex-1">
          <div class="font-semibold text-telecab-text">Reporte de horas del día</div>
          <p class="text-sm text-telecab-muted mt-0.5">De un clic: el <b>Excel</b> (horas efectivas de la jornada 05→05, KM y matrícula por conductor, con quien salió fuera del cuadrante) y el <b>PDF de la cascada de KM</b>. Cuadra con Visibilidad.</p>
          <p class="text-xs text-telecab-muted mt-2">
            <i class="fa-solid fa-circle-info mr-1"></i>
            La cascada es el gráfico para enseñar arriba: parte de todo lo que rodó la flota y va restando
            —sin nadie fichado, en descanso, esperando aviso— hasta los km con pasajero. Se lee como una cuenta
            de resultados y no hace falta explicarla.
          </p>
          <div class="flex flex-wrap items-center gap-2 mt-3">
            <select id="r-horas-dia" class="px-2 py-1.5 rounded-lg bg-telecab-dark border border-telecab-border text-sm text-telecab-text">
              <option value="1">Ayer</option>
              <option value="2">Hace 2 días</option>
              <option value="3">Hace 3 días</option>
            </select>
            <button id="r-horas" type="button"
               class="px-3 py-1.5 rounded-lg bg-telecab-gold text-telecab-dark text-sm font-semibold">
              <i class="fa-solid fa-download mr-1"></i> Excel + cascada
            </button>
            <button id="r-sankey" type="button"
               class="px-3 py-1.5 rounded-lg bg-telecab-card2 border border-telecab-border text-sm text-telecab-muted hover:text-telecab-text"
               title="El mismo dato en diagrama de flujo. Enseña por dónde se va cada km, pero hay que saber leerlo.">
              <i class="fa-solid fa-diagram-project mr-1"></i> Sankey
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Reporte por turnos (5-5) -->
    <div class="rounded-2xl border border-telecab-border bg-telecab-card p-4">
      <div class="flex items-start gap-3">
        <i class="fa-solid fa-clock-rotate-left text-telecab-gold text-lg mt-0.5"></i>
        <div class="flex-1">
          <div class="font-semibold text-telecab-text">Reporte por turnos (5-5)</div>
          <p class="text-sm text-telecab-muted mt-0.5">Quién rodó de <b>05→17</b> (día) y de <b>17→05</b> (noche), con horas, matrícula y los <b>NN</b> incluidos.</p>
          <div class="flex items-center gap-2 mt-3">
            <input id="rt-dia" type="date" class="px-2 py-1.5 rounded-lg bg-telecab-dark border border-telecab-border text-sm text-telecab-text">
            <a id="rt-excel" href="/control/reporte-turnos/excel"
               class="px-3 py-1.5 rounded-lg bg-telecab-gold text-telecab-dark text-sm font-semibold">
              <i class="fa-solid fa-download mr-1"></i> Excel
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Turnos para imprimir -->
    <div class="rounded-2xl border border-telecab-border bg-telecab-card p-4">
      <div class="flex items-start gap-3">
        <i class="fa-solid fa-print text-telecab-gold text-lg mt-0.5"></i>
        <div class="flex-1">
          <div class="font-semibold text-telecab-text">Turnos para imprimir</div>
          <p class="text-sm text-telecab-muted mt-0.5">Quién sale hoy y los próximos días, con teléfono. Para llevar en papel el fin de semana.</p>
          <div class="flex items-center gap-2 mt-3">
            <select id="r-turnos-dias" class="px-2 py-1.5 rounded-lg bg-telecab-dark border border-telecab-border text-sm text-telecab-text">
              <option value="2">Hoy + 2 días</option>
              <option value="1">Hoy + mañana</option>
              <option value="6">Toda la semana</option>
            </select>
            <a id="r-turnos" href="/control/turnos/excel?dias=2"
               class="px-3 py-1.5 rounded-lg bg-telecab-gold text-telecab-dark text-sm font-semibold">
              <i class="fa-solid fa-download mr-1"></i> Excel
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Parrilla del planificador (ANEXO) -->
    <div class="rounded-2xl border border-telecab-border bg-telecab-card p-4">
      <div class="flex items-start gap-3">
        <i class="fa-solid fa-table-cells text-telecab-gold text-lg mt-0.5"></i>
        <div class="flex-1">
          <div class="font-semibold text-telecab-text">Parrilla del planificador</div>
          <p class="text-sm text-telecab-muted mt-0.5">El anexo completo por correturno: cada coche con su descanso, matrícula y las 4 plazas (fijo/CT · día/noche) con teléfono y zona.</p>
          <div class="flex items-center gap-2 mt-3">
            <input id="pl-dia" type="date" class="px-2 py-1.5 rounded-lg bg-telecab-dark border border-telecab-border text-sm text-telecab-text">
            <a id="pl-excel" href="/control/planificador/excel"
               class="px-3 py-1.5 rounded-lg bg-telecab-gold text-telecab-dark text-sm font-semibold">
              <i class="fa-solid fa-download mr-1"></i> Excel
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Asistencia: quién faltó y cuántas veces -->
    <div class="rounded-2xl border border-telecab-border bg-telecab-card p-4 sm:col-span-2">
      <div class="flex items-start gap-3">
        <i class="fa-solid fa-user-xmark text-telecab-gold text-lg mt-0.5"></i>
        <div class="flex-1">
          <div class="font-semibold text-telecab-text">Asistencia · los más reincidentes</div>
          <p class="text-sm text-telecab-muted mt-0.5">
            Quién <b>faltó</b> y cuántas veces, del más reincidente al que menos, y detrás la
            <b>plantilla entera por promedio</b> de menor a mayor. Cada uno con su número al lado,
            su teléfono, su coche y los días que faltó.
            Una falta es <b>0 horas en BOLT sin justificante</b> en un día que le tocaba salir:
            quien tiene su J no falta, y quien está de vacaciones tampoco, porque esos días ni le tocaba.
          </p>
          <p class="text-xs text-telecab-muted mt-2">
            <i class="fa-solid fa-circle-info mr-1"></i>
            La libranza que se aplica es la de <b>hoy</b>, hacia atrás: si su coche descansa los miércoles,
            se da por librado el miércoles pasado. Y quien no tiene cuenta de BOLT enlazada va al final:
            su 0 no significa que faltara, significa que no se puede leer.
          </p>
          <div class="flex flex-wrap items-center gap-2 mt-3">
            <label class="text-xs text-telecab-muted">Del</label>
            <input id="as-desde" type="date" class="px-2 py-1.5 rounded-lg bg-telecab-dark border border-telecab-border text-sm text-telecab-text">
            <label class="text-xs text-telecab-muted">al</label>
            <input id="as-hasta" type="date" class="px-2 py-1.5 rounded-lg bg-telecab-dark border border-telecab-border text-sm text-telecab-text">
            <a id="as-excel" href="/control/asistencia/excel"
               class="px-3 py-1.5 rounded-lg bg-telecab-gold text-telecab-dark text-sm font-semibold">
              <i class="fa-solid fa-file-excel mr-1"></i> Excel
            </a>
            <a id="as-pdf" href="/control/asistencia/pdf"
               class="px-3 py-1.5 rounded-lg bg-telecab-card2 border border-telecab-border text-sm text-telecab-muted hover:text-telecab-text">
              <i class="fa-solid fa-file-pdf mr-1"></i> PDF
            </a>
            <span class="text-[11px] text-telecab-muted">por defecto, del 1 del mes hasta ayer</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
(function () {
  const $ = s => document.querySelector(s);

  // Hoy en la zona del navegador, 'YYYY-MM-DD'. A mediodía: sumar días nunca cae
  // en el día equivocado por el cambio de hora.
  const isoDia = off => {
    const d = new Date(); d.setHours(12, 0, 0, 0); d.setDate(d.getDate() + (off || 0));
    return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
  };

  // Un control (select o fecha) solo cambia el ?param= del enlace de descarga.
  const sinc = (sel, a, param) => {
    const el = $(sel), link = $(a);
    const base = link.getAttribute('href').split('?')[0];
    const set = () => { link.href = el.value ? base + '?' + param + '=' + encodeURIComponent(el.value) : base; };
    el.addEventListener('change', set); set();
  };
  sinc('#r-turnos-dias', '#r-turnos', 'dias');
  $('#rt-dia').value = isoDia(0);
  sinc('#rt-dia', '#rt-excel', 'dia');
  $('#pl-dia').value = isoDia(0);
  sinc('#pl-dia', '#pl-excel', 'dia');

  // El reporte del día baja DOS ficheros de un clic: el Excel de horas+KM y el PDF
  // del Sankey. Con un pequeño desfase, porque algunos navegadores frenan dos
  // descargas seguidas.
  const baja = url => {
    const a = document.createElement('a');
    a.href = url; a.download = '';
    document.body.appendChild(a); a.click(); a.remove();
  };
  $('#r-horas').addEventListener('click', () => {
    const key = $('#r-horas-dia').value;
    baja('/control/reporte/excel?dia=' + encodeURIComponent(key));
    setTimeout(() => baja('/control/cascada/pdf?dia=' + encodeURIComponent(key)), 500);
  });
  // El Sankey sigue estando, aparte: a quien ya sabe leerlo le dice más que la
  // cascada, porque enseña los dos turnos a la vez y por dónde se va cada km.
  $('#r-sankey').addEventListener('click', () =>
    baja('/control/sankey/pdf?dia=' + encodeURIComponent($('#r-horas-dia').value)));

  // ── Asistencia ────────────────────────────────────────────────────────────
  // Las fechas por defecto las decide el SERVIDOR (día 1 del mes → ayer, en hora
  // de Madrid): calcularlas aquí saldría con el reloj del navegador, que no tiene
  // por qué ser el mismo, y a las 00:30 daría un mes distinto.
  const asSync = () => {
    const d = $('#as-desde').value, h = $('#as-hasta').value;
    const q = [];
    if (d) q.push('desde=' + encodeURIComponent(d));
    if (h) q.push('hasta=' + encodeURIComponent(h));
    const cola = q.length ? '?' + q.join('&') : '';
    $('#as-excel').href = '/control/asistencia/excel' + cola;
    $('#as-pdf').href = '/control/asistencia/pdf' + cola;
  };
  $('#as-desde').addEventListener('change', asSync);
  $('#as-hasta').addEventListener('change', asSync);
  fetch('/control/asistencia/periodo').then(r => r.json()).then(j => {
    if (j.status !== 'ok') return;
    $('#as-desde').value = j.desde;
    $('#as-hasta').value = j.hasta;
    asSync();
  }).catch(() => { /* sin fechas puestas, el enlace baja el periodo por defecto */ });
})();
</script>
