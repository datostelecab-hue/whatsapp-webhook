<%- include('partials/control-nav', { sub: 'reportes' }) %>

<div class="max-w-[1100px] mx-auto">

  <div class="mb-5">
    <h1 class="text-2xl font-bold text-telecab-text flex items-center gap-2">
      <i class="fa-solid fa-chart-pie text-telecab-gold"></i> Reportes
    </h1>
    <p class="text-sm text-telecab-muted mt-1">
      Lo que hay que imprimir o descargar, y los paneles de detalle. Se irá llenando
      a medida que migren los módulos.
    </p>
  </div>

  <!-- Descargables -->
  <div class="text-[11px] uppercase tracking-wide text-telecab-muted mb-2">Descargar</div>
  <div class="grid sm:grid-cols-2 gap-3 mb-6">

    <!-- Turnos para imprimir -->
    <div class="rounded-2xl border border-telecab-border bg-telecab-card p-4">
      <div class="flex items-start gap-3">
        <i class="fa-solid fa-print text-telecab-gold text-lg mt-0.5"></i>
        <div class="flex-1">
          <div class="font-semibold text-telecab-text">Turnos para imprimir</div>
          <p class="text-sm text-telecab-muted mt-0.5">Quién sale hoy y los próximos días. Para llevar en papel.</p>
          <div class="flex items-center gap-2 mt-3">
            <select id="r-turnos-dias" class="px-2 py-1.5 rounded-lg bg-telecab-dark border border-telecab-border text-sm text-telecab-text">
              <option value="2">Hoy + 2 días</option>
              <option value="1">Hoy + mañana</option>
              <option value="6">Toda la semana</option>
            </select>
            <a id="r-turnos" href="/control/turnos/excel?dias=2"
               class="px-3 py-1.5 rounded-lg bg-telecab-gold text-telecab-dark text-sm font-semibold">
              <i class="fa-solid fa-download mr-1"></i> Excel
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Reporte de horas -->
    <div class="rounded-2xl border border-telecab-border bg-telecab-card p-4">
      <div class="flex items-start gap-3">
        <i class="fa-solid fa-clock text-telecab-gold text-lg mt-0.5"></i>
        <div class="flex-1">
          <div class="font-semibold text-telecab-text">Reporte de horas del día</div>
          <p class="text-sm text-telecab-muted mt-0.5">De un clic: el <b>Excel</b> (horas + KM + matrícula por conductor) y el <b>PDF del Sankey</b> (flujo de KM de la flota, por coche).</p>
          <div class="flex items-center gap-2 mt-3">
            <select id="r-horas-dia" class="px-2 py-1.5 rounded-lg bg-telecab-dark border border-telecab-border text-sm text-telecab-text">
              <option value="1">Ayer</option>
              <option value="2">Hace 2 días</option>
              <option value="3">Hace 3 días</option>
            </select>
            <button id="r-horas"
               class="px-3 py-1.5 rounded-lg bg-telecab-gold text-telecab-dark text-sm font-semibold">
              <i class="fa-solid fa-download mr-1"></i> Descargar (Excel + Sankey)
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Paneles -->
  <div class="text-[11px] uppercase tracking-wide text-telecab-muted mb-2">Paneles</div>
  <div class="grid sm:grid-cols-2 gap-3">
    <a href="/control/km" class="rounded-2xl border border-telecab-border bg-telecab-card p-4 hover:border-telecab-gold/40 flex items-center gap-3">
      <i class="fa-solid fa-route text-telecab-gold text-lg"></i>
      <div>
        <div class="font-semibold text-telecab-text">KM y traza</div>
        <p class="text-sm text-telecab-muted">Km conectado vs desconectado por conductor.</p>
      </div>
    </a>
    <a href="/flota-viva/partes" class="rounded-2xl border border-telecab-border bg-telecab-card p-4 hover:border-telecab-gold/40 flex items-center gap-3">
      <i class="fa-solid fa-clipboard-list text-telecab-gold text-lg"></i>
      <div>
        <div class="font-semibold text-telecab-text">Histórico de incidencias</div>
        <p class="text-sm text-telecab-muted">Partes por franja: qué pasó y qué se hizo.</p>
      </div>
    </a>
  </div>
</div>

<script>
(function () {
  const $ = s => document.querySelector(s);
  // Los selectores solo cambian el ?param del enlace de descarga.
  const sinc = (sel, a, param) => {
    const el = $(sel), link = $(a);
    const base = link.getAttribute('href').split('?')[0];
    const set = () => { link.href = base + '?' + param + '=' + encodeURIComponent(el.value); };
    el.addEventListener('change', set); set();
  };
  sinc('#r-turnos-dias', '#r-turnos', 'dias');

  // El reporte del día baja DOS ficheros de un clic: el Excel de horas+KM y el PDF
  // del Sankey. Con un pequeño desfase, porque algunos navegadores frenan dos
  // descargas seguidas.
  const baja = url => {
    const a = document.createElement('a');
    a.href = url; a.download = '';
    document.body.appendChild(a); a.click(); a.remove();
  };
  document.querySelector('#r-horas').addEventListener('click', () => {
    const key = document.querySelector('#r-horas-dia').value;
    baja('/control/reporte/excel?dia=' + encodeURIComponent(key));
    setTimeout(() => baja('/control/sankey/pdf?dia=' + encodeURIComponent(key)), 500);
  });
})();
</script>
