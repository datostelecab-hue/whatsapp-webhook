<div class="max-w-7xl mx-auto">
  <div class="flex flex-wrap items-center justify-between gap-3 mb-5">
    <div>
      <h1 class="text-2xl font-bold text-telecab-text flex items-center gap-2">
        <i class="fa-solid fa-gauge-high text-telecab-gold"></i> Sanciones por velocidad
        <span id="modo" class="text-xs px-2 py-0.5 rounded-full align-middle"></span>
      </h1>
      <p class="text-sm text-telecab-muted mt-1">Exceso de velocidad (Mapon) → conductor (Bolt) → advertencia por WhatsApp + registro legal. La 1ª es automática; la reincidencia (3 meses) requiere tu aprobación.</p>
    </div>
    <button id="btn-procesar" class="px-4 py-2 rounded-lg bg-telecab-gold/15 text-telecab-gold font-medium hover:bg-telecab-gold/25">
      <i class="fa-solid fa-rotate mr-1"></i> Procesar ahora
    </button>
  </div>

  <div id="msg" class="hidden mb-4 rounded-lg border border-telecab-border bg-telecab-card px-4 py-3 text-sm"></div>

  <!-- ══ Reincidencias pendientes de aprobación ══ -->
  <section id="sec-aprob" class="hidden mb-6">
    <h2 class="text-sm font-semibold text-telecab-red mb-2 flex items-center gap-2"><i class="fa-solid fa-triangle-exclamation"></i> Reincidencias pendientes de aprobar <span id="n-aprob" class="text-xs text-telecab-muted"></span></h2>
    <div id="lista-aprob" class="grid gap-3 lg:grid-cols-2"></div>
  </section>

  <!-- ══ Pendientes de revisión (sin conductor) ══ -->
  <section id="sec-revision" class="hidden mb-6">
    <h2 class="text-sm font-semibold text-telecab-warn mb-2 flex items-center gap-2"><i class="fa-solid fa-user-magnifying-glass"></i> Sin conductor resuelto (revisar a mano) <span id="n-revision" class="text-xs text-telecab-muted"></span></h2>
    <div id="lista-revision" class="rounded-xl bg-telecab-card border border-telecab-border divide-y divide-telecab-border/60 text-sm"></div>
  </section>

  <!-- ══ Reincidentes (contador por conductor, últimos 3 meses) ══ -->
  <section id="sec-reinc" class="hidden mb-6">
    <h2 class="text-sm font-semibold text-telecab-violet mb-2 flex items-center gap-2"><i class="fa-solid fa-repeat"></i> Reincidentes (últimos 3 meses) <span id="n-reinc" class="text-xs text-telecab-muted"></span></h2>
    <div id="lista-reinc" class="flex flex-wrap gap-2"></div>
  </section>

  <!-- ══ Registro completo ══ -->
  <section>
    <div class="flex items-center justify-between mb-2">
      <h2 class="text-sm font-semibold text-telecab-text">Registro</h2>
      <input id="filtro" type="search" placeholder="Matrícula o conductor…" class="px-3 py-1.5 rounded-lg bg-telecab-card border border-telecab-border text-telecab-text text-sm w-64 max-w-full">
    </div>
    <div class="rounded-xl bg-telecab-card border border-telecab-border overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="text-xs text-telecab-muted bg-telecab-card2/50">
            <tr>
              <th class="text-left px-3 py-2">Fecha</th>
              <th class="text-left px-3 py-2">Matrícula</th>
              <th class="text-left px-3 py-2">Conductor</th>
              <th class="text-right px-3 py-2">Vel.</th>
              <th class="text-right px-3 py-2">Límite</th>
              <th class="text-left px-3 py-2">Aviso</th>
              <th class="text-left px-3 py-2">Estado</th>
              <th class="text-center px-3 py-2">Mapa</th>
            </tr>
          </thead>
          <tbody id="tbody"></tbody>
        </table>
      </div>
    </div>
  </section>
</div>

<script>
const $ = s => document.querySelector(s);
const esc = s => String(s==null?'':s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
let LOG = [], MODO = 'test';

// Solo tokens de la marca: la paleta suelta de Tailwind (purple-300, amber-400…)
// está pensada para fondo oscuro y se vuelve ilegible en los 6 temas claros.
const BADGE = {
  'enviado': ['Enviada','bg-telecab-green/15 text-telecab-green'],
  'simulado': ['Simulada (test)','bg-telecab-card2 text-telecab-muted'],
  'pendiente-aprobacion': ['Pend. aprobar','bg-telecab-red/15 text-telecab-red'],
  'reincidencia-enviada': ['Reincidencia enviada','bg-telecab-violet/15 text-telecab-violet'],
  'reincidencia-simulada': ['Reincidencia (test)','bg-telecab-card2 text-telecab-muted'],
  'pendiente-revision': ['Sin conductor','bg-telecab-warn/15 text-telecab-warn'],
  'descartada': ['Descartada','bg-telecab-card2 text-telecab-muted/60'],
  'error': ['Error','bg-telecab-red/15 text-telecab-red']
};
const badge = e => { const b = BADGE[e] || [e,'bg-telecab-card2 text-telecab-muted']; return `<span class="text-xs px-2 py-0.5 rounded-full ${b[1]}">${esc(b[0])}</span>`; };

async function cargar() {
  const [est, lg] = await Promise.all([
    fetch('/sanciones/api/estado').then(r=>r.json()),
    fetch('/sanciones/api/log').then(r=>r.json())
  ]);
  MODO = (lg && lg.modo) || (est && est.modo) || 'test';
  $('#modo').innerHTML = MODO==='live'
    ? '<span class="bg-telecab-green/15 text-telecab-green px-2 py-0.5 rounded-full">EN VIVO</span>'
    : '<span class="bg-telecab-warn/15 text-telecab-warn px-2 py-0.5 rounded-full">MODO TEST (no envía)</span>';
  LOG = (lg && lg.log) || [];
  render();
}

function render() {
  // Pendientes de aprobación (reincidencias)
  const aprob = LOG.filter(r => r.estado === 'pendiente-aprobacion').sort((a,b)=>(b.ts||0)-(a.ts||0));
  $('#sec-aprob').classList.toggle('hidden', !aprob.length);
  $('#n-aprob').textContent = aprob.length ? `(${aprob.length})` : '';
  $('#lista-aprob').innerHTML = aprob.map(r => `
    <div class="rounded-xl border border-telecab-red/40 bg-telecab-red/5 p-4">
      <div class="flex items-baseline justify-between">
        <span class="font-semibold text-telecab-text">${esc(r.conductor)||'(sin nombre)'}</span>
        <span class="text-xs text-telecab-muted">${esc(r.fechaLocal)}</span>
      </div>
      <div class="text-sm text-telecab-muted mt-1">Matrícula <b class="text-telecab-text">${esc(r.matricula)}</b> · ${r.velocidad||'?'} km/h (límite ${r.limite||'?'}) · ${esc(r.aviso)}</div>
      <div class="text-xs text-telecab-muted mt-1">${r.telefono ? '📱 '+esc(r.telefono) : '<span class="text-telecab-red">⚠️ sin teléfono</span>'}</div>
      <div class="flex gap-2 mt-3">
        <button data-aprob="${esc(r.clave)}" class="px-3 py-1.5 rounded-lg bg-telecab-violet/15 text-telecab-violet border border-telecab-violet/40 text-sm font-medium hover:bg-telecab-violet/25"><i class="fa-brands fa-whatsapp mr-1"></i> Aprobar y enviar</button>
        <button data-rechazo="${esc(r.clave)}" class="px-3 py-1.5 rounded-lg bg-telecab-card2 text-telecab-muted text-sm hover:text-telecab-text">Descartar</button>
      </div>
    </div>`).join('');

  // Reincidentes: por conductor, infracciones atribuidas dentro de los últimos 3 meses.
  const CUENTAN = new Set(['enviado','simulado','pendiente-aprobacion','reincidencia-enviada','reincidencia-simulada']);
  const corte3m = new Date(); corte3m.setMonth(corte3m.getMonth()-3); const desde3 = corte3m.getTime();
  const porCond = {};
  LOG.forEach(r => {
    if (!r.driverUuid || !CUENTAN.has(r.estado) || !r.ts || r.ts < desde3) return;
    porCond[r.driverUuid] = porCond[r.driverUuid] || { nombre: r.conductor, n: 0 };
    porCond[r.driverUuid].n++; if (r.conductor) porCond[r.driverUuid].nombre = r.conductor;
  });
  const reinc = Object.values(porCond).filter(c => c.n >= 2).sort((a,b)=>b.n-a.n);
  $('#sec-reinc').classList.toggle('hidden', !reinc.length);
  $('#n-reinc').textContent = reinc.length ? `(${reinc.length})` : '';
  // El nombre va en el color de texto normal: sobre la píldora morada clara es
  // lo único que se lee bien en los temas claros. El contador sí en morado.
  $('#lista-reinc').innerHTML = reinc.map(c => `<span class="px-3 py-1.5 rounded-full bg-telecab-violet/12 border border-telecab-violet/30 text-telecab-text text-sm">${esc(c.nombre)||'(sin nombre)'} <b class="ml-1 text-telecab-violet">×${c.n}</b></span>`).join('');

  // Sin conductor (revisión)
  const rev = LOG.filter(r => r.estado === 'pendiente-revision').sort((a,b)=>(b.ts||0)-(a.ts||0));
  $('#sec-revision').classList.toggle('hidden', !rev.length);
  $('#n-revision').textContent = rev.length ? `(${rev.length})` : '';
  $('#lista-revision').innerHTML = rev.map(r => `
    <div class="px-4 py-2.5 flex flex-wrap items-baseline gap-x-2">
      <span class="text-telecab-muted text-xs">${esc(r.fechaLocal)}</span>
      <span class="font-medium text-telecab-text">${esc(r.matricula)}</span>
      <span class="text-telecab-muted">· ${r.velocidad||'?'} km/h</span>
      <span class="text-telecab-warn text-xs">· ${esc(r.notas)}</span>
    </div>`).join('');

  filtrar();
}

function filtrar() {
  const q = ($('#filtro').value||'').toLowerCase().trim();
  const filas = LOG.filter(r => !q || (r.matricula+' '+r.conductor).toLowerCase().includes(q)).sort((a,b)=>(b.ts||0)-(a.ts||0));
  $('#tbody').innerHTML = filas.map(r => `
    <tr class="border-t border-telecab-border/50">
      <td class="px-3 py-2 text-telecab-muted whitespace-nowrap">${esc(r.fechaLocal)}</td>
      <td class="px-3 py-2 text-telecab-text">${esc(r.matricula)}</td>
      <td class="px-3 py-2">${esc(r.conductor)||'<span class="text-telecab-muted/50">—</span>'}</td>
      <td class="px-3 py-2 text-right ${r.velocidad>=150?'text-telecab-red font-semibold':''}">${r.velocidad??''}</td>
      <td class="px-3 py-2 text-right text-telecab-muted">${r.limite??''}</td>
      <td class="px-3 py-2 text-telecab-muted">${esc(r.aviso)}</td>
      <td class="px-3 py-2">${badge(r.estado)}</td>
      <td class="px-3 py-2 text-center">${r.ubicacion
        ? `<a href="https://www.google.com/maps?q=${encodeURIComponent(r.ubicacion)}" target="_blank" rel="noopener" class="text-telecab-gold hover:underline" title="${esc(r.ubicacion)}"><i class="fa-solid fa-location-dot"></i></a>`
        : '<span class="text-telecab-muted/40">—</span>'}</td>
    </tr>`).join('') || '<tr><td colspan="8" class="px-3 py-6 text-center text-telecab-muted">Sin registros todavía</td></tr>';
}
$('#filtro').addEventListener('input', filtrar);

function msg(t, err) { const m = $('#msg'); m.classList.remove('hidden'); m.textContent = t; m.style.color = err ? 'var(--tc-red,#f87171)' : ''; }

$('#btn-procesar').addEventListener('click', async () => {
  const b = $('#btn-procesar'); b.disabled = true; msg('Procesando (leyendo Mapon y resolviendo conductores)…', false);
  try {
    const r = await (await fetch('/sanciones/api/procesar', {method:'POST',headers:{'Content-Type':'application/json'},body:'{}'})).json();
    if (r.status==='ok') msg(`✅ ${r.nuevas} nuevas · ${r.advertencias} advertencia(s) · ${r.reincidencias} reincidencia(s) a aprobar · ${r.sinConductor} sin conductor${r.errores?' · '+r.errores+' error(es)':''}`, false);
    else msg('❌ '+(r.msg||'error'), true);
  } catch(e){ msg('Error: '+e.message, true); }
  b.disabled = false; cargar();
});

document.addEventListener('click', async e => {
  const ap = e.target.closest('[data-aprob]'); const rc = e.target.closest('[data-rechazo]');
  if (ap) {
    if (!confirm('¿Aprobar y ENVIAR la plantilla de reincidencia? Traslada el caso a dirección (expediente).')) return;
    ap.disabled = true;
    const r = await (await fetch('/sanciones/api/aprobar',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({clave:ap.dataset.aprob})})).json();
    msg(r.status==='ok' && r.ok ? '✅ Reincidencia enviada' : ('❌ '+(r.error||r.msg||'no se pudo')), !(r.status==='ok'&&r.ok));
    cargar();
  }
  if (rc) {
    const motivo = prompt('Motivo para descartar (opcional):') || '';
    const r = await (await fetch('/sanciones/api/rechazar',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({clave:rc.dataset.rechazo, motivo})})).json();
    msg(r.status==='ok' ? '✅ Descartada' : ('❌ '+(r.msg||'error')), r.status!=='ok');
    cargar();
  }
});

cargar();
</script>
