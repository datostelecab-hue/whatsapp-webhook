<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Telecab · <%= titulo || 'Gestión' %></title>
  <link rel="icon" type="image/png" href="/assets/logo-64.png">

  <!-- Tema del PERFIL (lo inyecta el servidor) ANTES de pintar, sin parpadeo. Si no
       hay (o falla), cae al localStorage del dispositivo. -->
  <script>
    (function () {
      try {
        var perfil = '<%= (typeof tema !== "undefined" && tema) ? tema : "" %>';
        var pref = perfil || localStorage.getItem('telecab-tema') || 'dark';
        if (perfil) localStorage.setItem('telecab-tema', perfil);   // el dispositivo sigue al perfil
        var t = pref === 'auto'
          ? (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark')
          : pref;
        document.documentElement.setAttribute('data-theme', t);
      } catch (e) { document.documentElement.setAttribute('data-theme', 'dark'); }
    })();
  </script>

  <!-- Menú contraído o no, ANTES de pintar: si se decidiera después, el menú
       aparecería ancho y daría un salto al encogerse. Sin preferencia guardada
       se decide por el ancho de la pantalla, que es lo que de verdad importa. -->
  <script>
    (function () {
      try {
        var g = localStorage.getItem('telecab-menu');
        var corto = g === null ? (window.innerWidth < 1280) : (g === 'corto');
        if (corto) document.documentElement.setAttribute('data-menu', 'corto');
      } catch (e) {}
    })();
  </script>
  <link rel="stylesheet" href="<%= typeof est === 'function' ? est('/assets/css/telecab.css') : '/assets/css/telecab.css' %>">

  <!-- Componentes compartidos. Se cargan aqui, ANTES del cuerpo, porque cada
       modulo los invoca desde su propio bloque de codigo en linea. -->
  <script src="<%= typeof est === 'function' ? est('/assets/js/listado.js') : '/assets/js/listado.js' %>"></script>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Inter', 'system-ui', 'sans-serif'] },
          colors: {
            // Apuntan a los tokens CSS (public/assets/css/telecab.css). El
            // <alpha-value> conserva los modificadores de opacidad (bg-…/15,
            // border-…/40). Cambiar de tema solo cambia las variables.
            'telecab': {
              'dark': 'rgb(var(--tc-dark) / <alpha-value>)',
              'card': 'rgb(var(--tc-card) / <alpha-value>)',
              'card2': 'rgb(var(--tc-card2) / <alpha-value>)',
              'border': 'rgb(var(--tc-border) / <alpha-value>)',
              'gold': 'rgb(var(--tc-gold) / <alpha-value>)',
              'gold-soft': 'rgb(var(--tc-gold-soft) / <alpha-value>)',
              'gold-deep': 'rgb(var(--tc-gold-deep) / <alpha-value>)',
              'red': 'rgb(var(--tc-red) / <alpha-value>)',
              'red-hover': 'rgb(var(--tc-red-hover) / <alpha-value>)',
              'green': 'rgb(var(--tc-green) / <alpha-value>)',
              'warn': 'rgb(var(--tc-warn) / <alpha-value>)',
              'violet': 'rgb(var(--tc-violet) / <alpha-value>)',
              'text': 'rgb(var(--tc-text) / <alpha-value>)',
              'muted': 'rgb(var(--tc-muted) / <alpha-value>)'
            }
          },
          boxShadow: {
            'soft': '0 1px 3px rgba(0,0,0,.3), 0 8px 24px -12px rgba(0,0,0,.5)',
            'gold': '0 4px 20px -6px rgb(var(--tc-gold) / .35)'
          }
        }
      }
    }
  </script>

</head>
<body class="app-bg text-telecab-text min-h-screen">

<!-- ══════════ Overlay de carga (una sola pieza; la heredan TODOS los módulos) ══════════ -->
<!-- Va al principio del body para envolver window.fetch ANTES de que corran los
     scripts de cada módulo: así hasta la primera consulta ya muestra el vídeo. -->
<div id="cargando-overlay" class="hidden fixed inset-0 z-[200] flex items-center justify-center bg-telecab-dark/70 backdrop-blur-md">
  <div class="flex flex-col items-center gap-6">
    <%- include('partials/logo-video', { tam: 'w-[240px] h-[240px]' }) %>
    <p class="text-telecab-gold text-sm font-medium animate-pulse">Cargando…</p>
  </div>
</div>
<script>
(function () {
  const overlay = document.getElementById('cargando-overlay');
  const video   = overlay.querySelector('video');
  let activos = 0, ultima = performance.now(), inicial = true;

  const reproducir = () => {
    if (!video || !video.play) return;
    try { video.playbackRate = 2; const p = video.play(); if (p && p.catch) p.catch(() => {}); } catch (_) {}
  };
  const mostrar = () => { overlay.classList.remove('hidden'); reproducir(); };
  const ocultar = () => {
    overlay.classList.add('hidden');
    if (video && video.pause) { try { video.pause(); } catch (_) {} }
  };
  const ocultarSiLibre = () => { if (activos <= 0) { activos = 0; ocultar(); } };

  // CARGA INICIAL: el logo tapa desde el primer pintado, en lugar de los textos
  // "Leyendo el tablero…", "Calculando la semana…", etc., y se mantiene hasta que
  // llegan TODOS los datos del módulo. Red de seguridad a los 15 s por si algo cuelga.
  mostrar();
  setTimeout(() => { inicial = false; activos = 0; ocultar(); }, 15000);

  document.addEventListener('pointerdown', () => { ultima = performance.now(); }, true);

  // Mientras haya consultas en vuelo, mantener el logo. Cuenta como "acción" la carga
  // inicial y cualquier fetch cerca de un clic (consultar/guardar/editar/eliminar).
  // Los auto-refrescos de fondo (p. ej. Control cada 5 min) NO tapan.
  const origFetch = window.fetch;
  window.fetch = function (url, opt) {
    const usuario = inicial || (performance.now() - ultima) < 1200;
    if (usuario) { activos++; mostrar(); }
    const fin = () => { if (usuario) { activos = Math.max(0, activos - 1); ocultarSiLibre(); } };
    return origFetch(url, opt).then(r => { fin(); return r; }, e => { fin(); throw e; });
  };

  // Cuando la página termina de cargar dejamos de tratar todo como carga inicial;
  // si ya no queda ninguna consulta en vuelo, ocultamos.
  window.addEventListener('load', () => setTimeout(() => { inicial = false; ocultarSiLibre(); }, 300));

  // Nota: NO tapamos al pulsar un enlace de módulo; el logo sale ya en la página
  // destino mientras carga sus datos (evita que el logo aparezca "dos veces").

  // Al volver por el historial (bfcache) los datos ya están: no tapar.
  window.addEventListener('pageshow', (e) => { if (e.persisted) { activos = 0; inicial = false; ocultar(); } });

  // Control manual para acciones que NO pasan por un fetch cerca de un clic
  // (p. ej. subir un archivo soltado o pegado). abrir()/cerrar() se equilibran.
  window.telecabCarga = {
    abrir() { activos++; mostrar(); },
    cerrar() { activos = Math.max(0, activos - 1); ocultarSiLibre(); }
  };
})();
</script>

<div class="flex min-h-screen">

  <!-- ══════════ MENÚ LATERAL ══════════ -->
  <aside id="menu"
         class="fixed lg:sticky top-0 left-0 z-40 h-screen w-64 shrink-0
                flex flex-col -translate-x-full lg:translate-x-0
                transition-transform duration-300 lg:transition-[width]">

    <!-- Panel: es quien lleva el fondo y quien cambia de ancho. Va aparte del
         <aside> para que, contraído, pueda desplegarse POR ENCIMA del contenido
         sin empujarlo (el hueco que reserva el aside no se toca). -->
    <div id="menu-panel"
         class="h-full w-full flex flex-col bg-telecab-card/80 backdrop-blur-xl border-r border-telecab-border">

    <!-- Marca -->
    <a href="/planificador" class="flex items-center gap-3 px-5 py-5 border-b border-telecab-border/70">
      <%- include('partials/logo-video', { tam: 'w-12 h-12' }) %>
      <span class="leading-tight">
        <span class="block text-lg font-bold tracking-tight">tele<span class="gold-text">cab</span></span>
        <span class="block text-[11px] text-telecab-muted">Gestión de flota</span>
      </span>
    </a>

    <!-- Navegación -->
    <nav class="flex-1 p-3 space-y-1 overflow-y-auto">
      <%
        const seccionActiva = typeof seccion !== 'undefined' ? seccion : '';
        // Módulos agrupados por departamento. El menú se filtra por el rol de la sesión.
        const grupos = [
          { nombre: 'Contratación', icono: 'fa-user-tie', rol: 'oficina', items: [
            { href: '/vacantes',       icono: 'fa-location-dot',    texto: 'Vacantes',       id: 'vacantes' },
            { href: '/seleccion',      icono: 'fa-user-plus',       texto: 'Selección',      id: 'seleccion' },
            { href: '/ett',            icono: 'fa-people-arrows',   texto: 'ETT',            id: 'ett' },

          ] },
          { nombre: 'RRHH', icono: 'fa-id-badge', rol: 'oficina', items: [
            { href: '/rrhh',           icono: 'fa-id-badge',        texto: 'RRHH',           id: 'rrhh' },
            { href: '/administracion', icono: 'fa-gas-pump',         texto: 'Administración', id: 'administracion' },
            { href: '/conductores',   icono: 'fa-id-card',          texto: 'Conductores',    id: 'conductores' },
            { href: '/plantilla',      icono: 'fa-address-book',     texto: 'Plantilla',      id: 'plantilla' },
            { href: '/ticketera',      icono: 'fa-ticket',          texto: 'Ticketera RRHH', id: 'ticketera' },
            { href: '/reportes',       icono: 'fa-file-lines',      texto: 'Reportes',       id: 'reportes' },
            { href: '/nominas',        icono: 'fa-money-check-dollar', texto: 'Nóminas extras', id: 'nominas' }
          ] },
          { nombre: 'Tráfico', icono: 'fa-satellite-dish', rol: 'trafico', items: [
            { href: '/incorporaciones', icono: 'fa-user-plus',       texto: 'Incorporaciones',  id: 'incorporaciones' },
            { href: '/planificador', icono: 'fa-table-cells-large',  texto: 'Planificador',     id: 'planificador' },
            { href: '/planificador-v2', icono: 'fa-table-columns',   texto: 'Planificador V2',  id: 'planificador-v2' },
            { href: '/agenda',       icono: 'fa-users',              texto: 'Agenda',           id: 'agenda' },
            { href: '/control',      icono: 'fa-satellite-dish',     texto: 'Control',          id: 'control' },
            { href: '/cobertura',    icono: 'fa-calendar-week',      texto: 'Cobertura',        id: 'cobertura' },
            { href: '/generador',    icono: 'fa-wand-magic-sparkles',texto: 'Generar vacantes', id: 'generador' }
          ] },
          { nombre: 'Flota', icono: 'fa-car-side', rol: 'trafico', items: [
            { href: '/matching',  icono: 'fa-location-dot', texto: 'Matching',  id: 'matching' },
            { href: '/vehiculos', icono: 'fa-car-side',     texto: 'Vehículos', id: 'vehiculos' },
            // La MISMA pantalla que ve RRHH. Aparece en los dos departamentos
            // porque los dos la necesitan, no porque haya dos pantallas.
            { href: '/conductores', icono: 'fa-id-card',    texto: 'Conductores', id: 'conductores' }
          ] },
          { nombre: 'Operaciones', icono: 'fa-triangle-exclamation', rol: 'trafico', items: [
            { href: '/operaciones', icono: 'fa-tower-broadcast', texto: 'Alertas Mapon', id: 'operaciones' },
            { href: '/sanciones',   icono: 'fa-gauge-high',      texto: 'Sanciones velocidad', id: 'sanciones' },
            { href: '/operaciones/auditoria', icono: 'fa-clipboard-check', texto: 'Auditoría flota', id: 'auditoria' },
            { href: '/operaciones/vivo', icono: 'fa-tower-cell', texto: 'Auditoría en vivo', id: 'vivo' },
            { href: '/callcenter', icono: 'fa-headset', texto: 'Call Center', id: 'callcenter' }
          ] },
          { nombre: 'Sistema', icono: 'fa-database', rol: 'desarrollador', items: [
            { href: '/explorador', icono: 'fa-database', texto: 'Base de datos', id: 'explorador' },
            { href: '/migraciones', icono: 'fa-code-branch', texto: 'Migraciones', id: 'migraciones' }
          ] }
        ];
      %>
      <a href="/pendientes" class="nav-item <%= seccionActiva === 'pendientes' ? 'activo' : '' %> flex items-center gap-3 px-3 py-2.5 rounded-xl transition mb-1
                <%= seccionActiva === 'pendientes' ? 'bg-telecab-gold/10 text-telecab-gold font-semibold' : 'text-telecab-text hover:bg-telecab-card2' %>">
        <i class="fa-solid fa-inbox w-5 text-center <%= seccionActiva === 'pendientes' ? '' : 'text-telecab-muted' %>"></i>
        <span class="text-sm flex-1">Pendientes</span>
        <span id="nav-pend-badge" class="hidden min-w-[18px] h-[18px] px-1 rounded-full bg-telecab-red text-white text-[10px] font-bold leading-none flex items-center justify-center"></span>
      </a>

      <a href="/peticiones" class="nav-item <%= seccionActiva === 'peticiones' ? 'activo' : '' %> flex items-center gap-3 px-3 py-2.5 rounded-xl transition mb-1
                <%= seccionActiva === 'peticiones' ? 'bg-telecab-gold/10 text-telecab-gold font-semibold' : 'text-telecab-text hover:bg-telecab-card2' %>">
        <i class="fa-solid fa-clipboard-list w-5 text-center <%= seccionActiva === 'peticiones' ? '' : 'text-telecab-muted' %>"></i>
        <span class="text-sm flex-1">Peticiones</span>
      </a>

      <a href="/bitacora" class="nav-item <%= seccionActiva === 'bitacora' ? 'activo' : '' %> flex items-center gap-3 px-3 py-2.5 rounded-xl transition mb-1
                <%= seccionActiva === 'bitacora' ? 'bg-telecab-gold/10 text-telecab-gold font-semibold' : 'text-telecab-text hover:bg-telecab-card2' %>">
        <i class="fa-solid fa-book w-5 text-center <%= seccionActiva === 'bitacora' ? '' : 'text-telecab-muted' %>"></i>
        <span class="text-sm flex-1">Bitácora</span>
      </a>

      <% grupos.forEach(function (g) { const abierto = g.items.some(i => i.id === seccionActiva); %>
        <div class="nav-grupo" data-rol="<%= g.rol || '' %>">
          <button type="button" class="grupo-btn w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-telecab-text hover:bg-telecab-card2 transition">
            <i class="fa-solid <%= g.icono %> w-5 text-center text-telecab-muted"></i>
            <span class="text-sm font-semibold flex-1 text-left"><%= g.nombre %></span>
            <i class="fa-solid fa-chevron-down text-[10px] text-telecab-muted grupo-chev transition <%= abierto ? 'rotate-180' : '' %>"></i>
          </button>
          <div class="grupo-items <%= abierto ? '' : 'hidden' %> mt-0.5 ml-3 pl-3 border-l border-telecab-border/60 space-y-0.5">
            <% g.items.forEach(function (e) { const on = seccionActiva === e.id; %>
              <a href="<%= e.href %>"
                 class="nav-item <%= on ? 'activo' : '' %> flex items-center gap-3 px-3 py-2 rounded-xl transition
                        <%= on ? 'bg-telecab-gold/10 text-telecab-gold font-semibold' : 'text-telecab-text hover:bg-telecab-card2' %>">
                <i class="fa-solid <%= e.icono %> w-5 text-center <%= on ? '' : 'text-telecab-muted' %>"></i>
                <span class="text-sm"><%= e.texto %></span>
              </a>
            <% }); %>
          </div>
        </div>
      <% }); %>
    </nav>

    <!-- Pie -->
    <div class="p-3 border-t border-telecab-border/70">
      <% if (typeof rol !== 'undefined' && rol === 'desarrollador') { %>
      <a href="/tickets-telecab" class="nav-item <%= seccionActiva === 'tickets-telecab' ? 'activo' : '' %> flex items-center gap-3 px-3 py-2 rounded-xl transition text-sm mb-1
                <%= seccionActiva === 'tickets-telecab' ? 'bg-telecab-gold/10 text-telecab-gold font-semibold' : 'text-telecab-text hover:bg-telecab-card2' %>">
        <i class="fa-solid fa-ticket w-5 text-center <%= seccionActiva === 'tickets-telecab' ? '' : 'text-telecab-muted' %>"></i>
        <span>Tickets Telecab</span>
      </a>
      <% } else { %>
      <a href="/soporte" class="nav-item <%= seccionActiva === 'soporte' ? 'activo' : '' %> flex items-center gap-3 px-3 py-2 rounded-xl transition text-sm mb-1
                <%= seccionActiva === 'soporte' ? 'bg-telecab-gold/10 text-telecab-gold font-semibold' : 'text-telecab-text hover:bg-telecab-card2' %>">
        <i class="fa-solid fa-headset w-5 text-center <%= seccionActiva === 'soporte' ? '' : 'text-telecab-muted' %>"></i>
        <span>Soporte técnico</span>
      </a>
      <% } %>
      <a href="/configuracion" class="nav-item <%= seccionActiva === 'configuracion' ? 'activo' : '' %> flex items-center gap-3 px-3 py-2 rounded-xl transition text-sm
                <%= seccionActiva === 'configuracion' ? 'bg-telecab-gold/10 text-telecab-gold font-semibold' : 'text-telecab-muted hover:bg-telecab-card2' %>">
        <i class="fa-solid fa-gear w-5 text-center"></i>
        <span>Configuración</span>
      </a>
      <p class="px-3 pt-3 text-[11px] text-telecab-muted whitespace-nowrap">© <%= new Date().getFullYear() %> Telecab</p>
    </div>

    </div><!-- /menu-panel -->
  </aside>

  <div id="menu-fondo" class="hidden fixed inset-0 z-30 bg-black/60 backdrop-blur-sm lg:hidden"></div>

  <!-- ══════════ CONTENIDO ══════════ -->
  <div class="flex-1 min-w-0 flex flex-col">

    <!-- Barra superior -->
    <header class="sticky top-0 z-20 flex items-center gap-3 px-4 lg:px-6 h-14
                   bg-telecab-dark/70 backdrop-blur-lg border-b border-telecab-border">
      <button id="menu-abrir" class="lg:hidden w-9 h-9 rounded-lg hover:bg-telecab-card2 transition">
        <i class="fa-solid fa-bars"></i>
      </button>
      <button id="menu-corto" type="button"
              class="w-9 h-9 rounded-lg hover:bg-telecab-card2 transition items-center justify-center text-telecab-muted"
              aria-label="Contraer el menú" title="Contraer el menú (Ctrl+B)">
        <i class="fa-solid fa-angles-left"></i>
      </button>
      <h1 class="font-semibold text-telecab-text"><%= titulo || 'Gestión' %></h1>

      <% const ROL_NOMBRE = { superadmin: 'Superadmin', desarrollador: 'Desarrollador', oficina: 'Oficina', trafico: 'Tráfico' }; %>
      <div class="ml-auto flex items-center gap-2">

        <!-- Buzón de pendientes -->
        <div class="relative">
          <button id="notif-btn" title="Pendientes" class="relative w-9 h-9 rounded-lg hover:bg-telecab-card2 transition flex items-center justify-center">
            <i class="fa-solid fa-bell text-telecab-text"></i>
            <span id="notif-badge" class="hidden absolute top-0.5 right-0.5 min-w-[16px] h-4 px-1 rounded-full bg-telecab-red text-white text-[10px] font-bold leading-none flex items-center justify-center">0</span>
          </button>
          <div id="notif-panel" class="hidden absolute right-0 mt-2 w-80 max-w-[calc(100vw-2rem)] max-h-[70vh] overflow-y-auto bg-telecab-card border border-telecab-border rounded-xl shadow-soft z-50 p-2">
            <p class="text-[11px] uppercase tracking-wide font-semibold text-telecab-muted px-2 py-1">Buzón de pendientes</p>
            <div id="notif-lista" class="space-y-0.5"></div>
          </div>
        </div>

        <span class="text-xs text-telecab-muted hidden lg:flex items-center gap-2">
          <i class="far fa-clock"></i>
          <%= new Date().toLocaleString('es-ES', { weekday: 'short', day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' }) %>
        </span>

        <!-- Usuario en sesión + salir -->
        <div class="flex items-center gap-2 pl-2 ml-1 border-l border-telecab-border">
          <div class="hidden sm:block text-right leading-tight">
            <span class="block text-xs text-telecab-text font-medium"><%= (typeof usuario !== 'undefined' && usuario && ((usuario.nombre || '') + ' ' + (usuario.apellidos || '')).trim()) || '' %></span>
            <span class="block text-[10px] uppercase tracking-wide text-telecab-gold"><%= (typeof usuario !== 'undefined' && usuario && (ROL_NOMBRE[usuario.rol] || usuario.rol)) || '' %></span>
          </div>
          <a href="/logout" title="Salir" class="w-9 h-9 rounded-lg hover:bg-telecab-card2 transition flex items-center justify-center text-telecab-muted hover:text-telecab-red">
            <i class="fa-solid fa-arrow-right-from-bracket"></i>
          </a>
        </div>
      </div>
    </header>

    <main class="flex-1"><%- body %></main>
  </div>
</div>

<script>
// IIFE para NO filtrar estos nombres al ámbito global: los scripts de cada vista
// (bitácora, fichas…) también corren en global y declaran su propia función
// `abrir`; sin este aislamiento chocaban ("Identifier 'abrir' already declared")
// y ese error rompía el enganche de los desplegables de departamento.
(function () {
  const menu = document.getElementById('menu');
  const fondo = document.getElementById('menu-fondo');
  const abrir = () => { menu.classList.remove('-translate-x-full'); fondo.classList.remove('hidden'); };
  const cerrar = () => { menu.classList.add('-translate-x-full'); fondo.classList.add('hidden'); };
  document.getElementById('menu-abrir').addEventListener('click', abrir);
  fondo.addEventListener('click', cerrar);
  menu.querySelectorAll('a').forEach(a => a.addEventListener('click', cerrar));

  // ── Menú contraído ──────────────────────────────────────────────────────
  // Tres formas de manejarlo, de la más automática a la más explícita:
  //   · sin preferencia guardada, se decide por el ancho de la pantalla;
  //   · contraído, basta pasar el ratón para verlo entero (lo hace el CSS);
  //   · el botón (o Ctrl+B) fija la decisión y se recuerda.
  const raiz = document.documentElement;
  const btnCorto = document.getElementById('menu-corto');
  const icoCorto = btnCorto.querySelector('i');

  const pintarBoton = () => {
    const corto = raiz.getAttribute('data-menu') === 'corto';
    icoCorto.className = 'fa-solid ' + (corto ? 'fa-angles-right' : 'fa-angles-left');
    const t = corto ? 'Fijar el menú abierto (Ctrl+B)' : 'Contraer el menú (Ctrl+B)';
    btnCorto.title = t;
    btnCorto.setAttribute('aria-label', t);
    btnCorto.setAttribute('aria-expanded', String(!corto));
  };

  // ¿Ha elegido ya alguien, o seguimos decidiendo por el ancho de pantalla?
  let elegido = false;
  try { elegido = localStorage.getItem('telecab-menu') !== null; } catch (e) {}

  const alternar = () => {
    const corto = raiz.getAttribute('data-menu') === 'corto';
    if (corto) raiz.removeAttribute('data-menu');
    else raiz.setAttribute('data-menu', 'corto');
    try { localStorage.setItem('telecab-menu', corto ? 'largo' : 'corto'); } catch (e) {}
    elegido = true;   // a partir de aquí manda la persona, no la ventana
    pintarBoton();
  };

  pintarBoton();
  btnCorto.addEventListener('click', alternar);

  // Ctrl+B, como en cualquier editor. No se roba la tecla mientras se escribe.
  document.addEventListener('keydown', e => {
    if (!(e.ctrlKey || e.metaKey) || e.key.toLowerCase() !== 'b') return;
    // Ojo con `matches`: el destino de la tecla no siempre es un elemento (puede
    // ser el propio documento si no hay nada enfocado), y entonces no existe.
    const d = e.target;
    if (d && typeof d.matches === 'function' &&
        (d.matches('input, textarea, select') || d.isContentEditable)) return;
    e.preventDefault();
    alternar();
  });

  // Mientras nadie haya elegido, el menú sigue al tamaño de la ventana. La
  // comprobación va DENTRO del oyente: si estuviera fuera, quien pulsara el
  // botón y luego cambiara el tamaño se encontraría con que le ignora.
  let reloj;
  window.addEventListener('resize', () => {
    if (elegido) return;
    clearTimeout(reloj);
    reloj = setTimeout(() => {
      if (window.innerWidth < 1280) raiz.setAttribute('data-menu', 'corto');
      else raiz.removeAttribute('data-menu');
      pintarBoton();
    }, 150);
  });

  // Desplegables de departamento en el menú.
  document.querySelectorAll('.grupo-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      btn.nextElementSibling.classList.toggle('hidden');
      btn.querySelector('.grupo-chev').classList.toggle('rotate-180');
    });
  });
})();
</script>

<!-- ══════════ Roles (según sesión) + buzón de pendientes por departamento ══════════ -->
<script>
(function () {
  const btn = document.getElementById('notif-btn');
  const panel = document.getElementById('notif-panel');
  const badge = document.getElementById('notif-badge');
  const lista = document.getElementById('notif-lista');

  // Rol REAL de la sesión (lo inyecta el servidor). superadmin ve todo.
  const rol = '<%= rol || "" %>';
  // Departamentos que alimentan el buzón de pendientes, por rol.
  const DEPS = {
    superadmin: ['reclutador', 'rrhh', 'trafico', 'operaciones'],
    desarrollador: ['soporte'],   // el dev ve como pendientes sus tickets IT
    oficina: ['reclutador', 'rrhh'],
    trafico: ['trafico', 'operaciones']
  };
  const NOMBRE = { reclutador: 'Reclutador', rrhh: 'RRHH', trafico: 'Tráfico', operaciones: 'Operaciones', soporte: 'Tickets IT' };
  let datos = null;

  // Filtra los grupos del menú por rol (general = todos). El grupo de la sección
  // activa se deja SIEMPRE visible para no dejar al usuario sin salida.
  function aplicarRolNav() {
    document.querySelectorAll('.nav-grupo[data-rol]').forEach(g => {
      const gr = g.getAttribute('data-rol');
      const activo = !!g.querySelector('.nav-item.activo');
      g.classList.toggle('hidden', !(rol === 'superadmin' || rol === 'desarrollador' || gr === rol || activo));
    });
    // Ítems sueltos ocultos para ciertos roles (p. ej. Fichas no es para Tráfico).
    document.querySelectorAll('[data-rol-not]').forEach(el => {
      const veta = el.getAttribute('data-rol-not').split(',').map(s => s.trim());
      el.classList.toggle('hidden', veta.includes(rol) && !el.classList.contains('activo'));
    });
  }

  function pintar() {
    if (!datos || datos.status !== 'ok') return;
    const deps = DEPS[rol] || [];
    let total = 0;
    lista.innerHTML = '';
    deps.forEach(dep => {
      const d = datos[dep] || { total: 0, items: [] };
      total += d.total;
      (d.items || []).forEach(it => {
        const a = document.createElement('a');
        a.href = it.href;
        a.className = 'block px-2 py-1.5 rounded-lg hover:bg-telecab-card2 transition';
        a.innerHTML =
          (deps.length > 1 ? `<span class="block text-[10px] uppercase tracking-wide text-telecab-gold">${NOMBRE[dep]}</span>` : '') +
          `<span class="block text-xs text-telecab-text">${it.texto}</span>` +
          (it.detalle ? `<span class="block text-[11px] text-telecab-muted truncate">${it.detalle}</span>` : '');
        lista.appendChild(a);
      });
    });
    if (!lista.children.length) lista.innerHTML = '<p class="text-xs text-telecab-muted px-2 py-4 text-center">Sin pendientes 🎉</p>';
    const txt = total > 99 ? '99+' : String(total);
    [badge, document.getElementById('nav-pend-badge')].forEach(b => {
      if (!b) return;
      if (total > 0) { b.textContent = txt; b.classList.remove('hidden'); } else b.classList.add('hidden');
    });
  }

  async function cargar() {
    try { const r = await fetch('/notificaciones'); datos = await r.json(); pintar(); } catch (_) {}
  }

  if (btn) {
    btn.addEventListener('click', e => { e.stopPropagation(); panel.classList.toggle('hidden'); });
    document.addEventListener('click', e => { if (panel && !panel.contains(e.target) && !btn.contains(e.target)) panel.classList.add('hidden'); });
  }

  aplicarRolNav();
  // Con retraso para que la campana NO entre en el overlay de carga inicial.
  setTimeout(cargar, 1500);
  setInterval(cargar, 120000);   // refresca cada 2 min (en segundo plano)
})();
</script>

<!-- ══════════ Selector de fechas (calendario propio, a juego con el tema) ══════════ -->
<script>
(function () {
  const MESES = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];
  const DIAS = ['L', 'M', 'X', 'J', 'V', 'S', 'D'];
  const pad = n => String(n).padStart(2, '0');
  const fmt = d => pad(d.getDate()) + '/' + pad(d.getMonth() + 1) + '/' + d.getFullYear();
  function parse(v) {
    if (!v) return null;
    const s = String(v).trim();
    let m = s.match(/^(\d{1,2})[\/\-.](\d{1,2})[\/\-.](\d{2,4})$/);
    if (m) { const y = +m[3] < 100 ? 2000 + +m[3] : +m[3]; return new Date(y, +m[2] - 1, +m[1]); }
    m = s.match(/^(\d{4})[\/\-.](\d{1,2})[\/\-.](\d{1,2})$/);
    if (m) return new Date(+m[1], +m[2] - 1, +m[3]);
    return null;
  }
  const norm = d => { const x = new Date(d); x.setHours(0, 0, 0, 0); return x; };

  // ── Rango permitido de un campo (validación de fechas) ────────────────────
  // Se declara con atributos en el <input>:
  //   data-min / data-max        → 'today', 'today+3', 'today-2' o una fecha fija.
  //   data-min-field / data-max-field (+ *-offset en días) → otro campo (por
  //     data-campo o id), p. ej. caducidad ≥ expedición+1. El límite efectivo es
  //     el más restrictivo de ambos.
  function resolverLimite(spec) {
    if (!spec) return null;
    const s = String(spec).trim();
    const m = s.match(/^today\s*([+-]\s*\d+)?$/i);
    if (m) { const off = m[1] ? parseInt(m[1].replace(/\s/g, ''), 10) : 0; const d = norm(new Date()); d.setDate(d.getDate() + off); return d; }
    const p = parse(s); return p ? norm(p) : null;
  }
  function limiteCampo(input, cual) {
    const ref = input.getAttribute('data-' + cual + '-field');
    if (!ref) return null;
    const otro = document.querySelector('[data-campo="' + ref + '"], #' + (window.CSS && CSS.escape ? CSS.escape(ref) : ref));
    if (!otro) return null;
    const base = parse(otro.value); if (!base) return null;
    const off = parseInt(input.getAttribute('data-' + cual + '-offset') || '0', 10);
    const d = norm(base); d.setDate(d.getDate() + off); return d;
  }
  function rango(input) {
    if (!input) return { min: null, max: null };
    const mins = [resolverLimite(input.getAttribute('data-min')), limiteCampo(input, 'min')].filter(Boolean);
    const maxs = [resolverLimite(input.getAttribute('data-max')), limiteCampo(input, 'max')].filter(Boolean);
    return {
      min: mins.length ? new Date(Math.max(...mins.map(d => d.getTime()))) : null,
      max: maxs.length ? new Date(Math.min(...maxs.map(d => d.getTime()))) : null
    };
  }
  const fuera = (f, r) => (r.min && f < r.min) || (r.max && f > r.max);
  // Marca en rojo el input si la fecha tecleada queda fuera de su rango.
  function marcarValidez(inp) {
    const d = inp.value.trim() ? parse(inp.value) : null;
    const mal = d && fuera(norm(d), rango(inp));
    inp.classList.toggle('!border-telecab-red', !!mal);
    inp.classList.toggle('ring-1', !!mal);
    inp.classList.toggle('ring-telecab-red', !!mal);
    if (mal) { const r = rango(inp); inp.title = 'Fecha fuera de rango' + (r.min ? ' · desde ' + fmt(r.min) : '') + (r.max ? ' · hasta ' + fmt(r.max) : ''); }
    else inp.removeAttribute('title');
  }

  const pop = document.createElement('div');
  pop.className = 'fp-pop hidden fixed z-[120] w-72 rounded-2xl border border-telecab-border bg-telecab-card2 shadow-soft p-3 text-telecab-text select-none';
  document.body.appendChild(pop);
  let target = null, vista = null, modo = 'dias';   // 'dias' | 'meses' | 'anios'

  const flecha = n => '<button type="button" data-nav="' + n + '" class="w-8 h-8 rounded-lg text-telecab-muted hover:bg-telecab-card hover:text-telecab-text transition">' + (n < 0 ? '‹' : '›') + '</button>';
  const pie =
    '<div class="flex items-center justify-between mt-3 pt-2 border-t border-telecab-border text-xs">' +
      '<button type="button" data-hoy class="px-2.5 py-1 rounded-lg text-telecab-gold hover:bg-telecab-gold/10 transition">Hoy</button>' +
      '<button type="button" data-borrar class="px-2.5 py-1 rounded-lg text-telecab-muted hover:text-telecab-red transition">Borrar</button>' +
    '</div>';

  function render() {
    const hoy = new Date(); hoy.setHours(0, 0, 0, 0);
    const sel = target ? parse(target.value) : null;
    const y = vista.getFullYear(), mo = vista.getMonth();

    // Vista de años: rejilla de 12 años; las flechas saltan de 12 en 12.
    if (modo === 'anios') {
      const base = Math.floor(y / 12) * 12;
      let celdas = '';
      for (let a = base; a < base + 12; a++) {
        const cls = a === y ? 'bg-telecab-gold text-telecab-dark font-semibold' : 'text-telecab-text hover:bg-telecab-card';
        celdas += `<button type="button" data-anio="${a}" class="h-10 rounded-lg text-sm transition ${cls}">${a}</button>`;
      }
      pop.innerHTML =
        '<div class="flex items-center justify-between mb-2">' + flecha(-1) +
          '<div class="text-sm font-semibold">' + base + ' – ' + (base + 11) + '</div>' + flecha(1) + '</div>' +
        '<div class="grid grid-cols-3 gap-1">' + celdas + '</div>' + pie;
      return;
    }

    // Vista de meses: rejilla de 12 meses; las flechas cambian de año.
    if (modo === 'meses') {
      let celdas = '';
      MESES.forEach((m, i) => {
        const cls = i === mo ? 'bg-telecab-gold text-telecab-dark font-semibold' : 'text-telecab-text hover:bg-telecab-card';
        celdas += `<button type="button" data-mes="${i}" class="h-10 rounded-lg text-sm transition ${cls}">${m.slice(0, 3)}</button>`;
      });
      pop.innerHTML =
        '<div class="flex items-center justify-between mb-2">' + flecha(-1) +
          '<button type="button" data-modo="anios" class="text-sm font-semibold px-2 py-1 rounded-lg hover:bg-telecab-card transition">' + y + '</button>' +
          flecha(1) + '</div>' +
        '<div class="grid grid-cols-3 gap-1">' + celdas + '</div>' + pie;
      return;
    }

    // Vista de días (por defecto). El mes y el año del encabezado abren su rejilla.
    const offset = (new Date(y, mo, 1).getDay() + 6) % 7;
    const total = new Date(y, mo + 1, 0).getDate();
    const r = rango(target);
    let celdas = '';
    for (let i = 0; i < offset; i++) celdas += '<div></div>';
    for (let d = 1; d <= total; d++) {
      const f = new Date(y, mo, d);
      if (fuera(norm(f), r)) { celdas += `<div class="h-9 rounded-lg text-sm flex items-center justify-center text-telecab-muted/25 line-through cursor-not-allowed">${d}</div>`; continue; }
      const esSel = sel && f.getTime() === sel.getTime();
      const esHoy = f.getTime() === hoy.getTime();
      const cls = esSel ? 'bg-telecab-gold text-telecab-dark font-semibold shadow-gold'
        : esHoy ? 'ring-1 ring-telecab-gold/60 text-telecab-gold'
        : 'text-telecab-text hover:bg-telecab-card';
      celdas += `<button type="button" data-d="${d}" class="h-9 rounded-lg text-sm transition ${cls}">${d}</button>`;
    }
    pop.innerHTML =
      '<div class="flex items-center justify-between mb-2">' + flecha(-1) +
        '<div class="flex items-center gap-1">' +
          '<button type="button" data-modo="meses" class="text-sm font-semibold px-2 py-1 rounded-lg hover:bg-telecab-card transition">' + MESES[mo] + '</button>' +
          '<button type="button" data-modo="anios" class="text-sm font-semibold px-2 py-1 rounded-lg hover:bg-telecab-card transition">' + y + '</button>' +
        '</div>' + flecha(1) + '</div>' +
      '<div class="grid grid-cols-7 gap-1 mb-1 text-[11px] font-medium text-telecab-muted text-center">' + DIAS.map(x => '<div>' + x + '</div>').join('') + '</div>' +
      '<div class="grid grid-cols-7 gap-1 text-center">' + celdas + '</div>' + pie;
  }

  function abrir(input) {
    target = input;
    const base = parse(input.value) || new Date();
    vista = new Date(base.getFullYear(), base.getMonth(), 1);
    modo = 'dias';
    render();
    pop.classList.remove('hidden');
    const r = input.getBoundingClientRect();
    const w = pop.offsetWidth, h = pop.offsetHeight;
    let left = Math.max(8, Math.min(r.left, window.innerWidth - w - 8));
    let top = r.bottom + 6;
    if (top + h > window.innerHeight - 8) top = Math.max(8, r.top - h - 6);
    pop.style.left = left + 'px';
    pop.style.top = top + 'px';
  }
  function cerrar() { pop.classList.add('hidden'); target = null; }
  function fijar(fecha) {
    if (!target) return;
    if (fecha && fuera(norm(fecha), rango(target))) return;   // no se fija una fecha fuera de rango
    target.value = fecha ? fmt(fecha) : '';
    marcarValidez(target);
    target.dispatchEvent(new Event('input', { bubbles: true }));
    target.dispatchEvent(new Event('change', { bubbles: true }));
    cerrar();
  }

  pop.addEventListener('mousedown', e => e.preventDefault());  // no robar el foco del input
  pop.addEventListener('click', e => {
    // Sin esto, al navegar de mes render() reemplaza el HTML y saca del DOM el
    // botón pulsado; el detector de "clic fuera" lo ve fuera y cierra el calendario.
    e.stopPropagation();
    const modoBtn = e.target.closest('[data-modo]');
    if (modoBtn) { modo = modoBtn.dataset.modo; render(); return; }
    const nav = e.target.closest('[data-nav]');
    if (nav) {
      const paso = Number(nav.dataset.nav);
      if (modo === 'anios') vista.setFullYear(vista.getFullYear() + paso * 12);
      else if (modo === 'meses') vista.setFullYear(vista.getFullYear() + paso);
      else vista = new Date(vista.getFullYear(), vista.getMonth() + paso, 1);
      render(); return;
    }
    const anio = e.target.closest('[data-anio]');
    if (anio) { vista.setFullYear(Number(anio.dataset.anio)); modo = 'dias'; render(); return; }
    const mes = e.target.closest('[data-mes]');
    if (mes) { vista.setMonth(Number(mes.dataset.mes)); modo = 'dias'; render(); return; }
    const day = e.target.closest('[data-d]');
    if (day) { fijar(new Date(vista.getFullYear(), vista.getMonth(), Number(day.dataset.d))); return; }
    if (e.target.closest('[data-hoy]')) { fijar(new Date()); return; }
    if (e.target.closest('[data-borrar]')) { fijar(null); return; }
  });

  document.addEventListener('click', e => {
    if (pop.contains(e.target)) return;
    const inp = e.target.closest('input.js-fecha');
    if (inp) abrir(inp); else cerrar();
  });
  document.addEventListener('focusin', e => {
    const inp = e.target.closest('input.js-fecha');
    // Se puede teclear la fecha a mano (además del calendario): al enfocar se
    // quita el readonly para permitir escribir, y se abre el calendario a juego.
    if (inp) { inp.removeAttribute('readonly'); abrir(inp); }
  });
  // Formateo al teclear: solo dígitos, insertando las barras (dd/mm/aaaa) solo.
  document.addEventListener('input', e => {
    const inp = e.target.closest && e.target.closest('input.js-fecha');
    if (!inp) return;
    let v = inp.value.replace(/\D/g, '').slice(0, 8);
    if (v.length >= 5) v = v.slice(0, 2) + '/' + v.slice(2, 4) + '/' + v.slice(4);
    else if (v.length >= 3) v = v.slice(0, 2) + '/' + v.slice(2);
    inp.value = v;
    marcarValidez(inp);
    const d = parse(inp.value);
    if (d && target === inp) { vista = new Date(d.getFullYear(), d.getMonth(), 1); render(); }   // el calendario sigue lo tecleado
  });
  // Al salir del campo: formato inválido → se limpia; válido → se normaliza y valida.
  document.addEventListener('focusout', e => {
    const inp = e.target.closest && e.target.closest('input.js-fecha');
    if (!inp) return;
    if (!inp.value.trim()) { marcarValidez(inp); return; }
    const d = parse(inp.value);
    if (!d) { inp.value = ''; marcarValidez(inp); return; }
    inp.value = fmt(d);
    marcarValidez(inp);
  });
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') cerrar();
    if (e.key === 'Enter' && e.target.closest && e.target.closest('input.js-fecha')) cerrar();
  });
  window.addEventListener('resize', cerrar);
  window.addEventListener('scroll', () => { if (target) cerrar(); }, true);
})();
</script>

</body>
</html>
