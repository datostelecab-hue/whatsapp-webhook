<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Telecab · <%= titulo || 'Gestión' %></title>
  <link rel="icon" type="image/png" href="<%= typeof est === 'function' ? est('/assets/logo-sinfondo-256.png') : '/assets/logo-sinfondo-256.png' %>">
  <link rel="apple-touch-icon" href="<%= typeof est === 'function' ? est('/assets/logo-sinfondo-256.png') : '/assets/logo-sinfondo-256.png' %>">

  <!-- Tema del PERFIL (lo inyecta el servidor) ANTES de pintar, sin parpadeo. Si no
       hay (o falla), cae al localStorage del dispositivo. -->
  <script nonce="<%= nonce %>">
    (function () {
      try {
        var perfil = '<%= (typeof tema !== "undefined" && tema) ? tema : "" %>';
        var pref = perfil || localStorage.getItem('telecab-tema') || 'dark';
        if (perfil) localStorage.setItem('telecab-tema', perfil);   // el dispositivo sigue al perfil
        var t = pref === 'auto'
          ? (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark')
          : pref;
        document.documentElement.setAttribute('data-theme', t);
      } catch (e) { document.documentElement.setAttribute('data-theme', 'dark'); }
      // Y si este usuario las ha apagado, las AYUDAS al pasar el cursor. Aquí
      // arriba por lo mismo que el tema: decidirlo después dejaría un parpadeo
      // de globos encendiéndose durante la primera pasada del ratón.
      try {
        document.documentElement.setAttribute('data-ayudas',
          '<%= (typeof ayudas !== "undefined" && ayudas === false) ? "0" : "1" %>');
      } catch (e) { /* por omisión, encendidas */ }
    })();
  </script>

  <!-- Menú contraído o no, ANTES de pintar: si se decidiera después, el menú
       aparecería ancho y daría un salto al encogerse. Sin preferencia guardada
       se decide por el ancho de la pantalla, que es lo que de verdad importa. -->
  <script nonce="<%= nonce %>">
    (function () {
      try {
        var g = localStorage.getItem('telecab-menu');
        var corto = g === null ? (window.innerWidth < 1280) : (g === 'corto');
        if (corto) document.documentElement.setAttribute('data-menu', 'corto');
      } catch (e) {}
    })();
  </script>
  <link rel="stylesheet" href="<%= typeof est === 'function' ? est('/assets/css/telecab.css') : '/assets/css/telecab.css' %>">

  <!-- Componentes compartidos. Se cargan aqui, ANTES del cuerpo, porque cada
       modulo los invoca desde su propio bloque de codigo en linea. -->
  <%# Casa.esc y lo demás que todas las pantallas usan: el PRIMERO, que las vistas lo toman al arrancar. %>
  <script src="<%= typeof est === 'function' ? est('/assets/js/nucleo.js') : '/assets/js/nucleo.js' %>"></script>
  <script src="<%= typeof est === 'function' ? est('/assets/js/dialogo.js') : '/assets/js/dialogo.js' %>"></script>
  <%# Api.pedir/get/post: la forma de la casa de hablar con el servidor, y el aviso de los errores de JavaScript que nadie captura. Pronto, para oírlos desde el principio. %>
  <script src="<%= typeof est === 'function' ? est('/assets/js/api.js') : '/assets/js/api.js' %>"></script>
  <%# Horas y minutos de una J, en vez de un decimal (HorasMin; también `tipo: 'horas'` de Dialogo.formulario). %>
  <script src="<%= typeof est === 'function' ? est('/assets/js/horasMin.js') : '/assets/js/horasMin.js' %>"></script>
  <%# El formulario de la −J (MenosJ.poner): Bitácora, Control y Justificantes piden lo mismo. %>
  <script src="<%= typeof est === 'function' ? est('/assets/js/menosJ.js') : '/assets/js/menosJ.js' %>"></script>
  <%# El cuadrito de copiar un dato (Copiar.boton): para las filas que se abren al pulsarlas. %>
  <script src="<%= typeof est === 'function' ? est('/assets/js/copiar.js') : '/assets/js/copiar.js' %>"></script>
  <%# Los cumpleaños de hoy: tarjetas en las pantallas de TODOS (modules/Cumpleanos). %>
  <% if (typeof usuario !== 'undefined' && usuario && usuario.id) { %>
  <script src="<%= typeof est === 'function' ? est('/assets/js/cumpleanos.js') : '/assets/js/cumpleanos.js' %>" defer data-usuario="<%= usuario.id %>"></script>
  <%# El efectivo activo sin entregar nunca: solo para quien tenga la llave '/avisos/efectivo'
      (Víctor y Daiane, db/220). Con acceso total (permisos null) se carga y el servidor
      contesta que no, salvo que esa persona también tenga la llave. %>
  <% if (typeof permisos !== 'undefined' && (permisos === null || (Array.isArray(permisos) && permisos.includes('/avisos/efectivo')))) { %>
  <script src="<%= typeof est === 'function' ? est('/assets/js/avisoEfectivo.js') : '/assets/js/avisoEfectivo.js' %>" defer data-usuario="<%= usuario.id %>"></script>
  <% } %>
  <% } %>
  <script src="<%= typeof est === 'function' ? est('/assets/js/listado.js') : '/assets/js/listado.js' %>"></script>
  <script src="<%= typeof est === 'function' ? est('/assets/js/fichaConductor.js') : '/assets/js/fichaConductor.js' %>"></script>
  <script src="<%= typeof est === 'function' ? est('/assets/js/fotoPersona.js') : '/assets/js/fotoPersona.js' %>"></script>
  <!-- Ver una foto en grande sin salir de la pantalla (VisorFoto.abrir). -->
  <script src="<%= typeof est === 'function' ? est('/assets/js/visorFoto.js') : '/assets/js/visorFoto.js' %>"></script>
  <!-- Las ayudas: se quedan con el `title` de cualquier elemento y lo pintan con
       la cara de la casa. Vale para todo el sistema sin tocar una pantalla. -->
  <script src="<%= typeof est === 'function' ? est('/assets/js/ayuda.js') : '/assets/js/ayuda.js' %>"></script>
  <!-- El selector de la casa para formularios montados a mano: el valor vive en
       un input oculto, así que quien lo use sigue leyendo `.value` de siempre. -->
  <script src="<%= typeof est === 'function' ? est('/assets/js/selector.js') : '/assets/js/selector.js' %>"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

  <!-- Tailwind COMPILADO (tailwind.config.js, services/tailwind.js), no la CDN
       «Play» que lo compilaba en el navegador en cada página. Va el ÚLTIMO del
       <head>, que es donde Play metía su hoja: así el reset de Tailwind y las
       utilidades siguen ganando a telecab.css en los mismos sitios que antes. -->
  <link rel="stylesheet" href="<%= typeof est === 'function' ? est('/assets/css/tailwind.css') : '/assets/css/tailwind.css' %>">
</head>
<body class="app-bg text-telecab-text min-h-screen">

<!-- ══════════ Overlay de carga (una sola pieza; la heredan TODOS los módulos) ══════════ -->
<!-- Va al principio del body para envolver window.fetch ANTES de que corran los
     scripts de cada módulo: así hasta la primera consulta ya se ve la carga.
     La marca animada es SVG + CSS (partials/marca.ejs): pesa unos pocos KB en vez
     de los 4,9 MB del vídeo de antes, va fluida a cualquier tamaño y toma los
     colores del tema de cada usuario. -->
<div id="cargando-overlay" class="hidden fixed inset-0 z-[200] flex items-center justify-center" role="status" aria-live="polite">
  <div class="flex flex-col items-center gap-4">
    <%- include('partials/marca', { tam: 'w-24 h-24', anima: true }) %>
    <p class="tc-carga-texto text-[11px] uppercase font-medium">Cargando</p>
  </div>
</div>
<script src="<%= typeof est === 'function' ? est('/assets/js/layout/cargando.js') : '/assets/js/layout/cargando.js' %>"></script>

<div class="flex min-h-screen">

  <!-- ══════════ MENÚ LATERAL ══════════ -->
  <aside id="menu"
         class="fixed lg:sticky top-0 left-0 z-40 h-screen w-64 shrink-0
                flex flex-col -translate-x-full lg:translate-x-0
                transition-transform duration-300 lg:transition-[width]">

    <!-- Panel: es quien lleva el fondo y quien cambia de ancho. Va aparte del
         <aside> para que, contraído, pueda desplegarse POR ENCIMA del contenido
         sin empujarlo (el hueco que reserva el aside no se toca). -->
    <div id="menu-panel"
         class="h-full w-full flex flex-col bg-telecab-card/80 backdrop-blur-xl border-r border-telecab-border">

    <%# LA SEDE de la sesión (el selector del login, 07/10/2026). Barcelona tiene
        su propio menú: planificador, reporte de horas y Visibilidad. %>
    <% const sedeSesion = (typeof sede !== 'undefined' && sede) ? sede : 'madrid';
       // Fuera de los dos menús: el pie también la usa.
       const seccionActiva = typeof seccion !== 'undefined' ? seccion : ''; %>

    <!-- Marca -->
    <a href="<%= sedeSesion === 'barcelona' ? '/barcelona' : '/planificador' %>" class="flex items-center gap-3 px-4 h-16 shrink-0 border-b border-telecab-border/70">
      <%# Un div y no un span: con el menú contraído el CSS esconde los span del
          panel (los textos), y la marca tiene que seguir viéndose. %>
      <div class="w-10 flex justify-center shrink-0"><%- include('partials/marca', { tam: 'w-9 h-9' }) %></div>
      <span class="leading-tight whitespace-nowrap">
        <span class="block text-base font-bold tracking-tight">tele<span class="gold-text">cab</span></span>
        <span class="block text-[11px] text-telecab-muted"><%= sedeSesion === 'barcelona' ? 'Barcelona' : 'Gestión de flota' %></span>
      </span>
    </a>

    <!-- Navegación -->
    <nav class="flex-1 p-3 space-y-1 overflow-y-auto">
      <%# Cambiar de sede sin volver a entrar. Re-emite la sesión con la otra. %>
      <form method="POST" action="/sede" class="mb-2">
        <input type="hidden" name="sede" value="<%= sedeSesion === 'barcelona' ? 'madrid' : 'barcelona' %>">
        <button type="submit" class="nav-item w-full flex items-center gap-3 px-3 py-2 rounded-xl transition text-telecab-muted hover:bg-telecab-card2 hover:text-telecab-text"
                title="Cambiar a la sede de <%= sedeSesion === 'barcelona' ? 'Madrid' : 'Barcelona' %>">
          <i class="fa-solid fa-right-left w-5 text-center"></i>
          <span class="text-xs flex-1 text-left">Ir a <%= sedeSesion === 'barcelona' ? 'Madrid' : 'Barcelona' %></span>
        </button>
      </form>
      <% if (sedeSesion === 'barcelona') { %>
        <% [{ href: '/barcelona', icono: 'fa-table-cells-large', texto: 'Planificador', id: 'bcn-planificador' },
            { href: '/barcelona/reportes', icono: 'fa-file-excel', texto: 'Reporte de horas', id: 'bcn-reportes' },
            { href: '/barcelona/visibilidad', icono: 'fa-chart-line', texto: 'Visibilidad', id: 'bcn-visibilidad' }]
           .forEach(function (e) { const on = seccionActiva === e.id; %>
          <a href="<%= e.href %>" class="nav-item <%= on ? 'activo' : '' %> flex items-center gap-3 px-3 py-2.5 rounded-xl transition mb-1
                    <%= on ? 'bg-telecab-gold/10 text-telecab-gold font-semibold' : 'text-telecab-text hover:bg-telecab-card2' %>">
            <i class="fa-solid <%= e.icono %> w-5 text-center <%= on ? '' : 'text-telecab-muted' %>"></i>
            <span class="text-sm flex-1"><%= e.texto %></span>
          </a>
        <% }); %>
      <% } else { %>
      <%
        // Módulos agrupados por departamento. El menú se filtra por el rol de la sesión.
        const grupos = [
          { nombre: 'Contratación', icono: 'fa-user-tie', rol: 'oficina', items: [
            { href: '/vacantes',       icono: 'fa-location-dot',    texto: 'Vacantes',       id: 'vacantes' },
            { href: '/seleccion',      icono: 'fa-user-plus',       texto: 'Selección',      id: 'seleccion' },
            { href: '/ett',            icono: 'fa-people-arrows',   texto: 'ETT',            id: 'ett' },

          ] },
          { nombre: 'RRHH', icono: 'fa-id-badge', rol: 'oficina', items: [
            // Las bandejas de tickets (RRHH, Administración, Tráfico, Taller y
            // Sin traza) ya no están en el menú: son los cuadros de la barra de
            // arriba, con sus pendientes (25/09/2026).
            { href: '/rrhh',           icono: 'fa-id-badge',        texto: 'RRHH',           id: 'rrhh' },
            { href: '/plantilla',      icono: 'fa-id-card',          texto: 'Plantilla',      id: 'plantilla' },
            { href: '/vacaciones',     icono: 'fa-umbrella-beach',   texto: 'Vacaciones',     id: 'vacaciones' },
            // "Reportes" NO va aquí. Los informes son de Control —horas, turnos,
            // parrilla, asistencia, Sankey: todo de tráfico— y su pestaña está
            // dentro de /control. Esta entrada llevaba a una copia de esa misma
            // pantalla con el permiso de RRHH, así que quien la abría veía los
            // botones y le fallaban todos: apuntan a /control/*.
            { href: '/nominas',        icono: 'fa-money-check-dollar', texto: 'Nóminas', id: 'nominas' },
            { href: '/convenio',       icono: 'fa-scale-balanced',   texto: 'Convenio',       id: 'convenio' }
          ] },
          { nombre: 'Tráfico', icono: 'fa-satellite-dish', rol: 'trafico', items: [
            { href: '/planificador', icono: 'fa-table-cells-large',  texto: 'Planificador',     id: 'planificador' },
            { href: '/control',      icono: 'fa-satellite-dish',     texto: 'Control',          id: 'control' },
            { href: '/visibilidad',  icono: 'fa-chart-line',         texto: 'Visibilidad',      id: 'visibilidad' },
            { href: '/mapa',         icono: 'fa-map-location-dot',   texto: 'Mapa de flota',    id: 'mapa' },
            { href: '/cobertura',    icono: 'fa-calendar-week',      texto: 'Cobertura',        id: 'cobertura' },
            { href: '/bloqueo-motor', icono: 'fa-lock',              texto: 'Ciclo de bloqueo de motor', id: 'bloqueo-motor' },
            { href: '/generador',    icono: 'fa-wand-magic-sparkles',texto: 'Generar vacantes', id: 'generador' },
            { href: '/whatsapp',     icono: 'fa-comments',           texto: 'WhatsApp',         id: 'whatsapp' }
          ] },
          { nombre: 'Taller', icono: 'fa-car-side', rol: 'trafico', items: [
            { href: '/vehiculos', icono: 'fa-car-side',     texto: 'Vehículos', id: 'vehiculos' },
            { href: '/taller',    icono: 'fa-screwdriver-wrench', texto: 'Mantenimientos', id: 'taller' },
            { href: '/inspecciones', icono: 'fa-clipboard-check', texto: 'Inspección de vehículos', id: 'inspecciones' },
            { href: '/facturas',  icono: 'fa-file-invoice', texto: 'Facturas de taller', id: 'facturas' },
            // Los repostajes que llegan por correo (Ballenoil DNI & GO, db/212).
            { href: '/combustible', icono: 'fa-gas-pump',  texto: 'Combustible', id: 'combustible' },
            // La MISMA pantalla que ve RRHH. Aparece en los dos departamentos
            // porque los dos la necesitan, no porque haya dos pantallas.
            { href: '/plantilla', icono: 'fa-id-card',      texto: 'Plantilla', id: 'plantilla' }
          ] },
          { nombre: 'Operaciones', icono: 'fa-triangle-exclamation', rol: 'trafico', items: [
            { href: '/operaciones', icono: 'fa-tower-broadcast', texto: 'Alertas Mapon', id: 'operaciones' },
            { href: '/sanciones',   icono: 'fa-gauge-high',      texto: 'Sanciones velocidad', id: 'sanciones' },
            { href: '/operaciones/auditoria', icono: 'fa-clipboard-check', texto: 'Auditoría flota', id: 'auditoria' },
            { href: '/alertas', icono: 'fa-bell', texto: 'Alertas de control', id: 'alertas' },
            { href: '/callcenter', icono: 'fa-headset', texto: 'Call Center', id: 'callcenter' }
          ] },
          // Solo lo ve la dirección: el layout enseña un grupo si su rol coincide con el de
          // la sesión, y 'direccion' no es el rol de nadie; superadmin y desarrollador lo ven todo.
          { nombre: 'Dirección', icono: 'fa-chart-pie', rol: 'direccion', items: [
            { href: '/bi', icono: 'fa-chart-pie', texto: 'Inteligencia de negocio', id: 'bi' }
          ] },
          { nombre: 'Sistema', icono: 'fa-database', rol: 'desarrollador', items: [
            // Del desarrollador y de quien tenga la llave '/usuarios' (una sola
            // persona: Ignacio, db/168). `oLlave` NO vale para el acceso total:
            // el superadmin no tiene esa fila y no la ve.
            { href: '/usuarios',    icono: 'fa-users-gear',  texto: 'Usuarios y permisos', id: 'usuarios', solo: 'desarrollador', oLlave: '/usuarios' },
            { href: '/explorador',  icono: 'fa-database',    texto: 'Base de datos', id: 'explorador', solo: 'desarrollador' },
            { href: '/migraciones', icono: 'fa-code-branch', texto: 'Migraciones', id: 'migraciones', solo: 'desarrollador' }
          ] }
        ];
        // El menú pinta SOLO lo que el usuario puede abrir. `permisos` (res.locals)
        // trae sus claves de usuario_permiso, o null si su rol tiene acceso total
        // (Admin, Desarrollador). Lo marcado `solo` es de ese rol y de nadie más.
        const misPermisos = (typeof permisos !== 'undefined' && permisos) ? new Set(permisos) : null;
        const rolSesion = typeof rol !== 'undefined' ? rol : '';
        const puedeVer = it => it.solo
          ? (rolSesion === it.solo || !!(it.oLlave && misPermisos && misPermisos.has(it.oLlave)))
          : (!misPermisos || misPermisos.has(it.href));
        const gruposVisibles = grupos
          .map(g => ({ nombre: g.nombre, icono: g.icono, rol: g.rol, items: g.items.filter(puedeVer) }))
          .filter(g => g.items.length);
      %>
      <%# Inicio SIEMPRE, sin `puedeVer`: la pantalla no se bloquea nunca y es
          donde cae todo el mundo al entrar. Quitarla del menú a quien no tiene
          las cifras le dejaría sin forma de volver a su bienvenida. %>
      <a href="/inicio" class="nav-item <%= seccionActiva === 'inicio' ? 'activo' : '' %> flex items-center gap-3 px-3 py-2.5 rounded-xl transition mb-1
                <%= seccionActiva === 'inicio' ? 'bg-telecab-gold/10 text-telecab-gold font-semibold' : 'text-telecab-text hover:bg-telecab-card2' %>">
        <i class="fa-solid fa-house w-5 text-center <%= seccionActiva === 'inicio' ? '' : 'text-telecab-muted' %>"></i>
        <span class="text-sm flex-1">Inicio</span>
      </a>

      <% if (puedeVer({ href: '/pendientes' })) { %>
      <a href="/pendientes" class="nav-item <%= seccionActiva === 'pendientes' ? 'activo' : '' %> flex items-center gap-3 px-3 py-2.5 rounded-xl transition mb-1
                <%= seccionActiva === 'pendientes' ? 'bg-telecab-gold/10 text-telecab-gold font-semibold' : 'text-telecab-text hover:bg-telecab-card2' %>">
        <i class="fa-solid fa-inbox w-5 text-center <%= seccionActiva === 'pendientes' ? '' : 'text-telecab-muted' %>"></i>
        <span class="text-sm flex-1">Pendientes</span>
        <span id="nav-pend-badge" class="hidden min-w-[18px] h-[18px] px-1 rounded-full bg-telecab-red text-white text-[10px] font-bold leading-none flex items-center justify-center"></span>
      </a>
      <% } %>

      <% if (puedeVer({ href: '/justificantes' })) { %>
      <a href="/justificantes" class="nav-item <%= seccionActiva === 'justificantes' ? 'activo' : '' %> flex items-center gap-3 px-3 py-2.5 rounded-xl transition mb-1
                <%= seccionActiva === 'justificantes' ? 'bg-telecab-gold/10 text-telecab-gold font-semibold' : 'text-telecab-text hover:bg-telecab-card2' %>">
        <i class="fa-solid fa-file-circle-check w-5 text-center <%= seccionActiva === 'justificantes' ? '' : 'text-telecab-muted' %>"></i>
        <span class="text-sm flex-1">Justificantes</span>
      </a>
      <% } %>

      <%# Fichar jornada. NO se puede filtrar con `puedeVer`: '/fichaje' no está en
          el catálogo de permisos a propósito —fichar es de cualquiera— y
          `puedeVer` esconde todo lo que no sea una clave suya.

          Quien lleva el registro la ve siempre. Al resto se la enseña el mismo
          /fichaje/api/estado que ya pregunta el botón de la barra: nace oculta y
          aparece si tiene que fichar. Mirar la COOKIE aquí no vale —se firmó al
          entrar y puede ser de antes de que le activaran el fichaje—, que es la
          misma razón por la que el botón de arriba lo pregunta al servidor. %>
      <a id="nav-fichaje" href="/fichaje"
         class="nav-item <%= seccionActiva === 'fichaje' ? 'activo' : '' %> flex items-center gap-3 px-3 py-2.5 rounded-xl transition mb-1
                <%= (!misPermisos || misPermisos.has('/fichaje/revisar')) ? '' : 'hidden' %>
                <%= seccionActiva === 'fichaje' ? 'bg-telecab-gold/10 text-telecab-gold font-semibold' : 'text-telecab-text hover:bg-telecab-card2' %>">
        <i class="fa-solid fa-clock w-5 text-center <%= seccionActiva === 'fichaje' ? '' : 'text-telecab-muted' %>"></i>
        <span class="text-sm flex-1">Fichar jornada</span>
      </a>

      <% if (puedeVer({ href: '/recaudacion' })) { %>
      <a href="/recaudacion" class="nav-item <%= seccionActiva === 'recaudacion' ? 'activo' : '' %> flex items-center gap-3 px-3 py-2.5 rounded-xl transition mb-1
                <%= seccionActiva === 'recaudacion' ? 'bg-telecab-gold/10 text-telecab-gold font-semibold' : 'text-telecab-text hover:bg-telecab-card2' %>">
        <i class="fa-solid fa-money-bill-wave w-5 text-center <%= seccionActiva === 'recaudacion' ? '' : 'text-telecab-muted' %>"></i>
        <span class="text-sm flex-1">Recaudación</span>
      </a>
      <% } %>

      <% if (puedeVer({ href: '/bitacora' })) { %>
      <a href="/bitacora" class="nav-item <%= seccionActiva === 'bitacora' ? 'activo' : '' %> flex items-center gap-3 px-3 py-2.5 rounded-xl transition mb-1
                <%= seccionActiva === 'bitacora' ? 'bg-telecab-gold/10 text-telecab-gold font-semibold' : 'text-telecab-text hover:bg-telecab-card2' %>">
        <i class="fa-solid fa-book w-5 text-center <%= seccionActiva === 'bitacora' ? '' : 'text-telecab-muted' %>"></i>
        <span class="text-sm flex-1">Bitácora</span>
      </a>
      <% } %>

      <% gruposVisibles.forEach(function (g) { const abierto = g.items.some(i => i.id === seccionActiva); %>
        <div class="nav-grupo" data-rol="<%= g.rol || '' %>">
          <button type="button" aria-expanded="<%= abierto ? 'true' : 'false' %>" class="grupo-btn w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-telecab-text hover:bg-telecab-card2 transition">
            <i class="fa-solid <%= g.icono %> w-5 text-center text-telecab-muted"></i>
            <span class="text-sm font-semibold flex-1 text-left"><%= g.nombre %></span>
            <i class="fa-solid fa-chevron-down text-[10px] text-telecab-muted grupo-chev transition <%= abierto ? 'rotate-180' : '' %>"></i>
          </button>
          <div class="grupo-items <%= abierto ? '' : 'hidden' %> mt-0.5 ml-3 pl-3 border-l border-telecab-border/60 space-y-0.5">
            <% g.items.forEach(function (e) { const on = seccionActiva === e.id; %>
              <a href="<%= e.href %>"
                 class="nav-item <%= on ? 'activo' : '' %> flex items-center gap-3 px-3 py-2 rounded-xl transition
                        <%= on ? 'bg-telecab-gold/10 text-telecab-gold font-semibold' : 'text-telecab-text hover:bg-telecab-card2' %>">
                <i class="fa-solid <%= e.icono %> w-5 text-center <%= on ? '' : 'text-telecab-muted' %>"></i>
                <span class="text-sm"><%= e.texto %></span>
              </a>
            <% }); %>
          </div>
        </div>
      <% }); %>
      <% } /* fin del menú de Madrid */ %>
    </nav>

    <!-- Pie -->
    <div class="p-3 border-t border-telecab-border/70">
      <% if (typeof rol !== 'undefined' && rol === 'desarrollador') { %>
      <a href="/tickets-telecab" class="nav-item <%= seccionActiva === 'tickets-telecab' ? 'activo' : '' %> flex items-center gap-3 px-3 py-2 rounded-xl transition text-sm mb-1
                <%= seccionActiva === 'tickets-telecab' ? 'bg-telecab-gold/10 text-telecab-gold font-semibold' : 'text-telecab-text hover:bg-telecab-card2' %>">
        <i class="fa-solid fa-ticket w-5 text-center <%= seccionActiva === 'tickets-telecab' ? '' : 'text-telecab-muted' %>"></i>
        <span>Tickets Telecab</span>
      </a>
      <% } else { %>
      <a href="/soporte" class="nav-item <%= seccionActiva === 'soporte' ? 'activo' : '' %> flex items-center gap-3 px-3 py-2 rounded-xl transition text-sm mb-1
                <%= seccionActiva === 'soporte' ? 'bg-telecab-gold/10 text-telecab-gold font-semibold' : 'text-telecab-text hover:bg-telecab-card2' %>">
        <i class="fa-solid fa-headset w-5 text-center <%= seccionActiva === 'soporte' ? '' : 'text-telecab-muted' %>"></i>
        <span>Soporte técnico</span>
      </a>
      <% } %>
      <a href="/configuracion" class="nav-item <%= seccionActiva === 'configuracion' ? 'activo' : '' %> flex items-center gap-3 px-3 py-2 rounded-xl transition text-sm
                <%= seccionActiva === 'configuracion' ? 'bg-telecab-gold/10 text-telecab-gold font-semibold' : 'text-telecab-muted hover:bg-telecab-card2' %>">
        <i class="fa-solid fa-gear w-5 text-center"></i>
        <span>Configuración</span>
      </a>
      <p class="px-3 pt-3 text-[11px] text-telecab-muted whitespace-nowrap">© <%= new Date().getFullYear() %> Telecab</p>
    </div>

    </div><!-- /menu-panel -->
  </aside>

  <div id="menu-fondo" class="hidden fixed inset-0 z-30 bg-black/60 backdrop-blur-sm lg:hidden"></div>

  <!-- ══════════ CONTENIDO ══════════ -->
  <div class="flex-1 min-w-0 flex flex-col">

    <!-- Barra superior -->
    <%# En el móvil la barra se parte en dos líneas: la de siempre y, debajo, los
        cuadros de tickets (no caben al lado y ya no están en el menú). %>
    <header class="sticky top-0 z-20 flex flex-wrap md:flex-nowrap items-center gap-x-3 gap-y-2 px-4 lg:px-6 py-2.5 md:py-0 md:h-14
                   bg-telecab-dark/70 backdrop-blur-lg border-b border-telecab-border">
      <button id="menu-abrir" type="button" aria-label="Abrir el menú" aria-controls="menu" aria-expanded="false"
              class="lg:hidden w-9 h-9 rounded-lg hover:bg-telecab-card2 transition">
        <i class="fa-solid fa-bars" aria-hidden="true"></i>
      </button>
      <button id="menu-corto" type="button"
              class="w-9 h-9 rounded-lg hover:bg-telecab-card2 transition items-center justify-center text-telecab-muted"
              aria-label="Contraer el menú" title="Contraer el menú (Ctrl+B)">
        <i class="fa-solid fa-angles-left" aria-hidden="true"></i>
      </button>
      <h1 class="font-semibold text-telecab-text shrink-0"><%= titulo || 'Gestión' %></h1>

      <%# ── LOS TICKETS DE CADA DEPARTAMENTO (25/09/2026) ──────────────────────
          Un cuadro por bandeja, con su nombre y sus PENDIENTES (los pedidos desde
          el corte, ticketera.service → desdeCuando). Lo
          pidió Camilo: estaban repartidas por el menú lateral —RRHH,
          Administración, Tráfico, Taller y los sin traza— y se veían solo al ir
          a buscarlas. Solo salen las que quien mira puede abrir
          (ticketera.controller → enLaBarra); el número llega después, como la
          campana. Si no cabe, la fila se desliza de lado en vez de apretar. %>
      <% const tkBarra = (typeof bandejasBarra !== 'undefined' && bandejasBarra) || []; %>
      <% if (tkBarra.length) { %>
      <style>
        #tk-barra { scrollbar-width: none; }
        #tk-barra::-webkit-scrollbar { display: none; }
        #tk-barra .tk-activo { border-color: rgb(var(--tc-gold) / .7); background: rgb(var(--tc-gold) / .12); }
      </style>
      <nav id="tk-barra" aria-label="Tickets por departamento"
           class="order-last w-full md:order-none md:w-auto md:ml-2 flex items-center gap-1.5 2xl:gap-1 min-w-0 overflow-x-auto">
        <% tkBarra.forEach(b => { const partido = !!(b.partes && b.partes.length); %>
        <%# Partido (RRHH): el cuadro único solo por debajo de 2xl; en pantalla
            grande lo sustituye el grupo de sus partes. %>
        <a href="<%= b.href %>" data-tk-area="<%= b.area %>" data-tk-href="<%= b.href %>"
           title="Tickets de <%= b.etiqueta %>: los pendientes"
           class="shrink-0 flex <%= partido ? '2xl:hidden' : '' %> items-center gap-2 2xl:gap-1.5 h-9 pl-3 2xl:pl-2.5 pr-1.5 rounded-lg border border-telecab-border bg-telecab-card2/50 text-xs font-semibold text-telecab-text hover:border-telecab-gold/60 transition">
          <%# El icono sobra en pantalla grande: con RRHH partido, el sitio hace falta. %>
          <i class="fa-solid <%= b.area === 'OPERACIONES' ? 'fa-circle-question' : 'fa-ticket' %> text-telecab-muted 2xl:hidden"></i>
          <span class="whitespace-nowrap"><%= b.etiqueta %></span>
          <span data-tk-n class="min-w-[22px] h-6 px-1.5 rounded-md text-[11px] font-bold tabular-nums flex items-center justify-center bg-telecab-card2 text-telecab-muted">·</span>
        </a>
        <% if (partido) { %>
        <%# EN PANTALLA GRANDE, SUS PARTES (Camilo, 25/09/2026): «casos de nómina,
            casos de baja médica, vacaciones y permisos». Un solo bloque con el
            nombre de la bandeja delante —que se lea que son de RRHH— y cada
            parte abre la bandeja ya filtrada. «Otros» solo sale si tiene algo. %>
        <div data-tk-grupo="<%= b.area %>" role="group" aria-label="Tickets de <%= b.etiqueta %> por tipo"
             class="hidden 2xl:flex shrink-0 items-stretch h-9 rounded-lg border border-telecab-border bg-telecab-card2/50 overflow-hidden">
          <a href="<%= b.href %>" data-tk-todo="<%= b.href %>" title="Toda la bandeja de <%= b.etiqueta %>"
             class="flex items-center px-2 text-[10px] uppercase tracking-wider font-bold text-telecab-muted hover:text-telecab-gold border-r border-telecab-border transition">
            <%= b.etiqueta %>
          </a>
          <% b.partes.forEach(p => { %>
          <a href="<%= p.href %>" data-tk-parte="<%= b.area %>|<%= p.clave %>" <%- p.otros ? 'data-tk-otros' : '' %>
             title="<%= p.etiqueta %>: los pendientes"
             class="<%= p.otros ? 'hidden' : 'flex' %> items-center gap-1.5 pl-2 pr-1.5 text-xs font-semibold text-telecab-text whitespace-nowrap border-r border-telecab-border/60 last:border-r-0 hover:bg-telecab-gold/10 transition">
            <span><%= p.etiqueta %></span>
            <span data-tk-n class="min-w-[22px] h-6 px-1.5 rounded-md text-[11px] font-bold tabular-nums flex items-center justify-center bg-telecab-card2 text-telecab-muted">·</span>
          </a>
          <% }) %>
        </div>
        <% } %>
        <% }) %>
      </nav>
      <% } %>

      <%# El nombre del rol viene del servidor (services/sesion.js, desde la tabla
          `rol`). Antes era una lista aquí y cada rol nuevo salía en crudo. %>
      <%# shrink-0: lo de la derecha no se aprieta nunca. Si falta sitio, lo que
          cede es la fila de cuadros de tickets, que se desliza de lado. %>
      <div class="ml-auto flex items-center gap-2 shrink-0 pl-2">

        <!-- ── FICHAR ────────────────────────────────────────────────────────
             Vive en la barra y no en su pantalla porque fichar se olvida: si
             hay que ir a buscarlo, se olvida más. Nace oculto y solo aparece
             para quien tiene el fichaje activado; quién es eso lo dice el
             servidor, no la sesión, porque la cookie se emitió al entrar y
             puede ser de antes de que le activaran el fichaje. -->
        <a id="fichar-btn" href="/fichaje" class="hidden items-center gap-2 h-9 px-3 rounded-lg text-xs font-semibold transition"
           title="Fichar jornada">
          <i class="fa-solid fa-stopwatch"></i>
          <span id="fichar-txt" class="whitespace-nowrap">Fichar</span>
        </a>

        <!-- Buzón de pendientes -->
        <div class="relative">
          <%# aria-label además del title: ayuda.js se lleva el title al enfocar, y sin él la campana se quedaba sin nombre. %>
          <button id="notif-btn" title="Pendientes" aria-label="Pendientes" aria-controls="notif-panel" aria-expanded="false" class="relative w-9 h-9 rounded-lg hover:bg-telecab-card2 transition flex items-center justify-center">
            <i class="fa-solid fa-bell text-telecab-text" aria-hidden="true"></i>
            <span id="notif-badge" class="hidden absolute top-0.5 right-0.5 min-w-[16px] h-4 px-1 rounded-full bg-telecab-red text-white text-[10px] font-bold leading-none flex items-center justify-center">0</span>
          </button>
          <div id="notif-panel" class="hidden absolute right-0 mt-2 w-80 max-w-[calc(100vw-2rem)] max-h-[70vh] overflow-y-auto bg-telecab-card border border-telecab-border rounded-xl shadow-soft z-50 p-2">
            <p class="text-[11px] uppercase tracking-wide font-semibold text-telecab-muted px-2 py-1">Buzón de pendientes</p>
            <div id="notif-lista" class="space-y-0.5"></div>
          </div>
        </div>

        <span class="text-xs text-telecab-muted hidden xl:flex items-center gap-2 whitespace-nowrap">
          <i class="far fa-clock"></i>
          <%= new Date().toLocaleString('es-ES', { weekday: 'short', day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' }) %>
        </span>

        <!-- Usuario en sesión + salir -->
        <div class="flex items-center gap-2 pl-2 ml-1 border-l border-telecab-border">
          <div class="hidden sm:block text-right leading-tight whitespace-nowrap">
            <span class="block text-xs text-telecab-text font-medium"><%= (typeof usuario !== 'undefined' && usuario && ((usuario.nombre || '') + ' ' + (usuario.apellidos || '')).trim()) || '' %></span>
            <span class="block text-[10px] uppercase tracking-wide text-telecab-muted"><%= (typeof rolNombre !== 'undefined' && rolNombre) || (typeof usuario !== 'undefined' && usuario && usuario.rol) || '' %></span>
          </div>
          <a href="/logout" title="Salir" aria-label="Salir" class="w-9 h-9 rounded-lg hover:bg-telecab-card2 transition flex items-center justify-center text-telecab-muted hover:text-telecab-red">
            <i class="fa-solid fa-arrow-right-from-bracket" aria-hidden="true"></i>
          </a>
        </div>
      </div>
    </header>

    <main class="flex-1"><%- body %></main>
  </div>
</div>

<script src="<%= typeof est === 'function' ? est('/assets/js/layout/menu.js') : '/assets/js/layout/menu.js' %>"></script>

<!-- ══════════ Roles (según sesión) + buzón de pendientes por departamento ══════════ -->
<script src="<%= typeof est === 'function' ? est('/assets/js/layout/pendientes.js') : '/assets/js/layout/pendientes.js' %>"></script>

<!-- ══════════ El botón de FICHAR de la barra ══════════ -->
<script src="<%= typeof est === 'function' ? est('/assets/js/layout/fichar.js') : '/assets/js/layout/fichar.js' %>"></script>

<!-- ══════════ Selector de fechas (calendario propio, a juego con el tema) ══════════ -->
<script src="<%= typeof est === 'function' ? est('/assets/js/layout/calendario.js') : '/assets/js/layout/calendario.js' %>"></script>


<!-- ══════════ Gráficos: el estilo de la casa, una sola vez ══════════ -->
<!-- Se aplica aquí, después del cuerpo (que es quien carga Chart.js), y vale para
     todos los módulos. Antes cada barra se pintaba en degradado —de su color a
     casi transparente—; desde el 27/09/2026 los gráficos son sobrios: barras
     lisas con la esquina apenas redondeada, rejilla fina, la tipografía de la
     casa y el globo con los colores del tema. Lo que un gráfico fija por su
     cuenta (sus colores de serie) lo sigue mandando él. -->
<script src="<%= typeof est === 'function' ? est('/assets/js/layout/temaGraficos.js') : '/assets/js/layout/temaGraficos.js' %>"></script>
</body>
</html>
