<div class="p-4 lg:p-6 max-w-6xl mx-auto space-y-5">

  <!-- Funnel: contador por etapa + salidas -->
  <div class="flex flex-wrap items-stretch gap-2">
    <% (etapas || []).forEach(function (e, i) { %>
      <div class="flex-1 min-w-[140px] bg-telecab-card border border-telecab-border rounded-xl px-3 py-2">
        <p class="text-[10px] uppercase tracking-wide text-telecab-muted leading-tight"><%= i + 1 %>. <%= e %></p>
        <p class="text-xl font-bold text-telecab-text" data-cont-etapa="<%= e %>">–</p>
      </div>
    <% }); %>
    <a href="/pendientes-bolt" class="min-w-[130px] bg-telecab-card border border-telecab-border rounded-xl px-3 py-2 hover:border-telecab-gold transition">
      <p class="text-[10px] uppercase tracking-wide text-telecab-muted">Pendientes BOLT <i class="fa-solid fa-arrow-up-right-from-square opacity-60"></i></p>
      <p id="c-pendiente" class="text-xl font-bold text-telecab-gold">–</p>
    </a>
  </div>

  <!-- Buscar / crear por teléfono -->
  <div class="bg-telecab-card border border-telecab-border rounded-2xl p-4">
    <label class="block text-sm text-telecab-muted mb-2">Contacto del candidato — teléfono (9 dígitos)</label>
    <div class="flex gap-2">
      <input id="tel-input" inputmode="numeric" maxlength="14" placeholder="6XX XXX XXX"
             class="flex-1 bg-telecab-dark border border-telecab-border rounded-xl px-4 py-2.5 text-telecab-text placeholder:text-telecab-muted/60 focus:outline-none focus:border-telecab-gold transition font-mono tracking-wider">
      <button id="btn-abrir" class="px-5 py-2.5 rounded-xl bg-telecab-gold text-telecab-dark font-semibold hover:bg-telecab-gold-soft transition whitespace-nowrap">
        <i class="fa-solid fa-id-card mr-1"></i> Abrir / crear
      </button>
    </div>
    <p id="tel-error" class="text-telecab-red text-xs mt-2 hidden"></p>
  </div>

  <!-- Ficha -->
  <div id="ficha" class="bg-telecab-card border border-telecab-border rounded-2xl p-5 hidden">
    <div class="flex items-center justify-between mb-3">
      <div>
        <h2 class="text-lg font-semibold text-telecab-text flex items-center gap-2">
          <i class="fa-solid fa-user-pen text-telecab-gold"></i> <span id="ficha-titulo">Nuevo candidato</span>
        </h2>
        <p class="text-sm text-telecab-muted font-mono" id="ficha-tel"></p>
      </div>
    </div>

    <div id="banner-bolt" class="hidden mb-3 rounded-xl border border-telecab-green/40 bg-telecab-green/10 p-3 text-xs text-telecab-green">
      <i class="fa-solid fa-circle-check mr-1"></i> Este conductor ya pertenece a nuestra base de datos en BOLT. Puede seguir el proceso igual; el link de alta no será obligatorio.
    </div>

    <!-- Funnel stepper -->
    <div class="flex flex-wrap gap-1.5 mb-4" id="stepper">
      <% (etapas || []).forEach(function (e, i) { %>
        <button type="button" data-etapa="<%= e %>" class="step px-3 py-1.5 rounded-lg text-xs border border-telecab-border text-telecab-muted hover:border-telecab-gold transition">
          <%= i + 1 %>. <%= e %>
        </button>
      <% }); %>
    </div>

    <div class="grid md:grid-cols-2 gap-4">
      <div>
        <label class="block text-xs text-telecab-muted mb-1">Nombre y apellidos</label>
        <input data-campo="nombre" class="inp">
      </div>
      <div>
        <label class="block text-xs text-telecab-muted mb-1">DNI / NIE</label>
        <input data-campo="dni" class="inp">
      </div>
      <div>
        <label class="block text-xs text-telecab-muted mb-1">Canal de origen</label>
        <select data-campo="canal" class="inp">
          <option value="">—</option>
          <% (canales || []).forEach(function (c) { %><option value="<%= c %>"><%= c %></option><% }); %>
        </select>
        <p id="nota-ett" class="text-[11px] text-telecab-gold mt-1 hidden"><i class="fa-solid fa-circle-info"></i> Vía ETT: el contrato puede ser 40h ETT / 32h ETT. La agencia nos lo manda; lo entrevistamos igual.</p>
      </div>
      <div>
        <label class="block text-xs text-telecab-muted mb-1">Correo electrónico</label>
        <input data-campo="email" type="email" class="inp">
      </div>
      <div>
        <label class="block text-xs text-telecab-muted mb-1">Contacto de emergencia</label>
        <input data-campo="contacto_emergencia" class="inp">
      </div>
      <div>
        <label class="block text-xs text-telecab-muted mb-1">Fecha de nacimiento</label>
        <input data-campo="fecha_nacimiento" class="js-fecha inp" readonly placeholder="dd/mm/aaaa">
      </div>

      <!-- Vacante que se cubre (la arma Tráfico en el generador) -->
      <div class="md:col-span-2">
        <label class="block text-xs text-telecab-muted mb-1">Vacante <span class="text-telecab-muted/70">(la elige Tráfico en el generador)</span></label>
        <select data-campo="vacante" class="inp">
          <option value="">— sin asignar —</option>
          <% (vacantes || []).forEach(function (v) { %>
            <option value="<%= v.id %>" data-zonas="<%= v.zonas %>" data-turno="<%= v.turno %>"><%= v.puesto %> · <%= v.zonas %> · libra <%= v.libranzas %></option>
          <% }); %>
        </select>
        <p id="vac-info" class="text-[11px] text-telecab-muted mt-1 hidden"></p>
      </div>

      <div>
        <label class="block text-xs text-telecab-muted mb-1">Certificado bancario (IBAN / nº cuenta)</label>
        <input data-campo="iban" class="inp font-mono">
      </div>
      <div>
        <label class="block text-xs text-telecab-muted mb-1">Responsable (Selección)</label>
        <input data-campo="responsable" class="inp">
      </div>

      <div class="md:col-span-2">
        <label class="block text-xs text-telecab-muted mb-1">Dirección</label>
        <div class="flex gap-2">
          <input data-campo="direccion" class="inp flex-1">
          <button id="btn-geo" type="button" class="px-3 py-2 rounded-xl bg-telecab-card2 border border-telecab-border text-telecab-text hover:border-telecab-gold transition whitespace-nowrap text-sm">
            <i class="fa-solid fa-location-crosshairs mr-1"></i> Coordenadas
          </button>
        </div>
      </div>
      <div class="md:col-span-2">
        <label class="block text-xs text-telecab-muted mb-1">Coordenadas</label>
        <input data-campo="coordenadas" class="inp font-mono" placeholder="lat, lng">
      </div>

      <div class="md:col-span-2">
        <label class="block text-xs text-telecab-muted mb-1">Notas</label>
        <textarea data-campo="notas" rows="2" class="inp resize-none"></textarea>
      </div>

      <div class="md:col-span-2">
        <label class="block text-xs text-telecab-muted mb-1">Link de alta BOLT <span class="text-telecab-muted/70">(se enviará al conductor por WhatsApp)</span></label>
        <input data-campo="link_bolt" type="url" class="inp font-mono" placeholder="https://…">
        <p class="text-[11px] text-telecab-muted mt-1">Habilita "Enviar solicitud a BOLT". Si el conductor ya está en el histórico, no es obligatorio. <span class="text-telecab-gold">Envío por WhatsApp: pendiente de la plantilla de Meta.</span></p>
      </div>
    </div>

    <!-- Atributos rápidos -->
    <div class="flex flex-wrap gap-4 mt-4">
      <% [{k:'experiencia',t:'Experiencia'},{k:'carne_vtc',t:'Carné VTC'}].forEach(function (f) { %>
        <div>
          <label class="block text-xs text-telecab-muted mb-1"><%= f.t %></label>
          <div class="inline-flex rounded-xl border border-telecab-border overflow-hidden" data-toggle="<%= f.k %>">
            <button type="button" data-val="Sí" class="px-4 py-1.5 text-sm transition">Sí</button>
            <button type="button" data-val="No" class="px-4 py-1.5 text-sm transition border-l border-telecab-border">No</button>
          </div>
        </div>
      <% }); %>
    </div>

    <div class="flex flex-wrap gap-2 mt-5">
      <button id="btn-guardar" class="px-4 py-2.5 rounded-xl bg-telecab-card2 border border-telecab-border text-telecab-text hover:border-telecab-gold transition font-medium">
        <i class="fa-solid fa-floppy-disk mr-1"></i> Guardar
      </button>
      <button id="btn-bolt" class="px-4 py-2.5 rounded-xl bg-telecab-green/15 border border-telecab-green/40 text-telecab-green hover:bg-telecab-green/25 transition font-semibold disabled:opacity-40 disabled:cursor-not-allowed">
        <i class="fa-solid fa-paper-plane mr-1"></i> Enviar solicitud a BOLT
      </button>
      <button id="btn-descartar" class="px-4 py-2.5 rounded-xl bg-telecab-red/10 border border-telecab-red/40 text-telecab-red hover:bg-telecab-red/20 transition font-medium ml-auto">
        <i class="fa-solid fa-user-xmark mr-1"></i> Descartar
      </button>
    </div>
    <p id="ficha-msg" class="text-xs mt-3 hidden"></p>
  </div>

  <!-- Board por etapa -->
  <div id="board" class="space-y-3"></div>

</div>

<style>
  .inp { width:100%; background:#0e1116; border:1px solid #282e39; border-radius:.75rem; padding:.5rem .75rem; color:#e6e8ec; transition:border-color .15s; }
  .inp:focus { outline:none; border-color:#e8b84b; }
</style>

<script>
  const ETAPAS = <%- JSON.stringify(etapas || []) %>;
  const CAMPOS = ['nombre','dni','canal','email','contacto_emergencia','fecha_nacimiento','vacante','iban','responsable','direccion','coordenadas','notas','link_bolt'];
  const estado = { experiencia: 'No', carne_vtc: 'No' };
  let ticketActual = null;
  let EN_BOLT = false;   // ¿el teléfono ya está en nuestro histórico de BOLT?

  const $ = s => document.querySelector(s);
  const norm = v => String(v || '').replace(/\D/g, '').slice(-9);

  // Toggles Sí/No
  function pintarToggle(campo) {
    document.querySelectorAll(`[data-toggle="${campo}"] [data-val]`).forEach(b => {
      const on = b.dataset.val === estado[campo];
      b.className = 'px-4 py-1.5 text-sm transition' + (b.dataset.val === 'No' ? ' border-l border-telecab-border' : '') +
        (on ? (estado[campo] === 'Sí' ? ' bg-telecab-green/20 text-telecab-green font-semibold' : ' bg-telecab-card2 text-telecab-text font-semibold')
            : ' text-telecab-muted hover:bg-telecab-card2');
    });
  }
  document.querySelectorAll('[data-toggle]').forEach(g => {
    const campo = g.dataset.toggle;
    g.querySelectorAll('[data-val]').forEach(b => b.addEventListener('click', () => { estado[campo] = b.dataset.val; pintarToggle(campo); }));
  });

  // Stepper del funnel
  function pintarStepper(estadoActual) {
    const idx = ETAPAS.indexOf(estadoActual);
    document.querySelectorAll('#stepper .step').forEach((b, i) => {
      const done = i < idx, cur = i === idx;
      b.className = 'step px-3 py-1.5 rounded-lg text-xs border transition ' +
        (cur ? 'border-telecab-gold bg-telecab-gold/15 text-telecab-gold font-semibold'
         : done ? 'border-telecab-green/40 bg-telecab-green/10 text-telecab-green'
         : 'border-telecab-border text-telecab-muted hover:border-telecab-gold');
    });
    actualizarBotonBolt();
  }

  // "Enviar a BOLT": solo en la última etapa Y con el link puesto (o si el
  // conductor ya está en el histórico de BOLT, donde el link no es obligatorio).
  function actualizarBotonBolt() {
    const estadoActual = ticketActual ? ticketActual.estado : '';
    const enUltima = estadoActual === ETAPAS[ETAPAS.length - 1];
    const link = ($('[data-campo="link_bolt"]').value || '').trim();
    $('#btn-bolt').disabled = !(enUltima && (link || EN_BOLT));
  }
  $('[data-campo="link_bolt"]').addEventListener('input', actualizarBotonBolt);

  async function api(url, body) {
    const r = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body || {}) });
    return r.json();
  }
  function msg(texto, ok) {
    const el = $('#ficha-msg');
    el.textContent = texto;
    el.className = 'text-xs mt-3 ' + (ok ? 'text-telecab-green' : 'text-telecab-red');
    el.classList.remove('hidden');
  }

  function abrirFicha(t, tel) {
    ticketActual = t || { id: tel, estado: ETAPAS[0] };
    $('#ficha').classList.remove('hidden');
    $('#ficha-tel').textContent = ticketActual.id;
    $('#ficha-titulo').textContent = (t && t.nombre) ? t.nombre : 'Nuevo candidato';
    CAMPOS.forEach(k => { const el = $(`[data-campo="${k}"]`); if (el) el.value = t ? (t[k] || '') : ''; });
    ['experiencia', 'carne_vtc'].forEach(k => { estado[k] = (t && t[k] === 'Sí') ? 'Sí' : 'No'; pintarToggle(k); });
    pintarStepper(ticketActual.estado);
    pintarVacInfo();
    $('#nota-ett').classList.toggle('hidden', ($('[data-campo="canal"]').value !== 'Bolsa de Empleo (ETT)'));
    $('#ficha-msg').classList.add('hidden');
    $('#ficha').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  function datosFicha() {
    const d = { tel: ticketActual.id, experiencia: estado.experiencia, carne_vtc: estado.carne_vtc };
    CAMPOS.forEach(k => { const el = $(`[data-campo="${k}"]`); if (el) d[k] = el.value; });
    // Zona y turno se derivan de la vacante elegida (los pone Tráfico, no Selección).
    const opt = $('[data-campo="vacante"]').selectedOptions[0];
    d.zona = opt ? (opt.dataset.zonas || '') : '';
    d.turno = opt ? (opt.dataset.turno || '') : '';
    return d;
  }

  function pintarVacInfo() {
    const opt = $('[data-campo="vacante"]').selectedOptions[0];
    const info = $('#vac-info');
    if (opt && opt.value) { info.textContent = `Zona: ${opt.dataset.zonas || '—'} · Turno: ${opt.dataset.turno || '—'}`; info.classList.remove('hidden'); }
    else info.classList.add('hidden');
  }
  $('[data-campo="vacante"]').addEventListener('change', pintarVacInfo);

  // Abrir / crear
  $('#btn-abrir').addEventListener('click', async () => {
    const tel = norm($('#tel-input').value);
    const err = $('#tel-error');
    if (tel.length !== 9) { err.textContent = 'El teléfono debe tener 9 dígitos.'; err.classList.remove('hidden'); return; }
    err.classList.add('hidden');
    const r = await (await fetch('/seleccion/api/ticket/' + tel)).json();
    EN_BOLT = !!r.enBolt;
    $('#banner-bolt').classList.toggle('hidden', !EN_BOLT);
    abrirFicha(r.ticket, tel);
  });
  $('#tel-input').addEventListener('keydown', e => { if (e.key === 'Enter') $('#btn-abrir').click(); });
  $('[data-campo="canal"]').addEventListener('change', () => $('#nota-ett').classList.toggle('hidden', $('[data-campo="canal"]').value !== 'Bolsa de Empleo (ETT)'));

  // Guardar
  $('#btn-guardar').addEventListener('click', async () => {
    const r = await api('/seleccion/ticket', datosFicha());
    if (r.status === 'ok') { $('#ficha').classList.add('hidden'); cargar(); }
    else msg(r.msg || 'Error al guardar', false);
  });

  // Mover de etapa (stepper)
  $('#stepper').addEventListener('click', async e => {
    const b = e.target.closest('.step'); if (!b || !ticketActual) return;
    await api('/seleccion/ticket', datosFicha());              // guarda lo escrito
    const r = await api('/seleccion/etapa', { tel: ticketActual.id, estado: b.dataset.etapa });
    if (r.status === 'ok') { ticketActual = r.ticket; pintarStepper(r.ticket.estado); cargar(); }
    else msg(r.msg || 'No se pudo mover de etapa', false);
  });

  // Enviar a BOLT
  $('#btn-bolt').addEventListener('click', async () => {
    await api('/seleccion/ticket', datosFicha());
    const r = await api('/seleccion/bolt', { tel: ticketActual.id });
    if (r.status === 'ok') { msg('Solicitud enviada a BOLT — pendiente de aprobación.', true); $('#ficha').classList.add('hidden'); cargar(); }
    else msg(r.msg || 'No se pudo enviar a BOLT', false);
  });

  // Descartar
  $('#btn-descartar').addEventListener('click', async () => {
    const motivo = prompt('Motivo del descarte:'); if (motivo === null) return;
    const r = await api('/seleccion/descartar', { tel: ticketActual.id, motivo });
    if (r.status === 'ok') { $('#ficha').classList.add('hidden'); cargar(); }
    else msg(r.msg || 'No se pudo descartar', false);
  });

  // Geocodificar
  $('#btn-geo').addEventListener('click', async () => {
    const dir = $('[data-campo="direccion"]').value.trim();
    if (!dir) { msg('Escribe primero la dirección.', false); return; }
    const btn = $('#btn-geo'); const html = btn.innerHTML;
    btn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i>';
    const r = await api('/seleccion/geocodificar', { direccion: dir });
    btn.innerHTML = html;
    if (r.status === 'ok' && r.encontrado) { $('[data-campo="coordenadas"]').value = r.coordenadas; msg('Coordenadas obtenidas (' + r.precision + ').', true); }
    else msg(r.msg || 'No se encontró la dirección.', false);
  });

  // Board por etapa
  function tarjeta(t) {
    const el = document.createElement('button');
    el.className = 'w-full text-left flex items-center gap-3 px-3 py-2 rounded-lg bg-telecab-dark/40 hover:bg-telecab-card2 border border-transparent hover:border-telecab-border transition';
    el.innerHTML =
      `<span class="w-7 h-7 rounded-lg bg-telecab-gold/15 text-telecab-gold flex items-center justify-center shrink-0 text-xs"><i class="fa-solid fa-user"></i></span>
       <span class="min-w-0 flex-1">
         <span class="block text-sm text-telecab-text truncate">${t.nombre || '<span class=\"text-telecab-muted\">(sin nombre)</span>'}</span>
         <span class="block text-xs text-telecab-muted font-mono">${t.id}${t.zona ? ' · ' + t.zona : ''}${t.turno ? ' ' + t.turno : ''}${t.canal ? ' · ' + t.canal : ''}</span>
       </span>`;
    el.addEventListener('click', async () => {
      const r = await (await fetch('/seleccion/api/ticket/' + t.id)).json();
      EN_BOLT = !!(r && r.enBolt);
      $('#banner-bolt').classList.toggle('hidden', !EN_BOLT);
      abrirFicha((r && r.ticket) || t, t.id);
    });
    return el;
  }

  async function cargar() {
    const r = await (await fetch('/seleccion/api/datos')).json();
    if (r.status !== 'ok') return;
    ETAPAS.forEach(e => { const el = document.querySelector(`[data-cont-etapa="${e}"]`); if (el) el.textContent = r.contadores.porEtapa[e] || 0; });
    $('#c-pendiente').textContent = r.contadores.pendienteBolt;

    const board = $('#board'); board.innerHTML = '';
    ETAPAS.forEach((e, i) => {
      const lista = r.porEtapa[e] || [];
      const sec = document.createElement('div');
      sec.className = 'bg-telecab-card border border-telecab-border rounded-2xl p-4';
      sec.innerHTML = `<h2 class="text-sm font-semibold text-telecab-text mb-2 flex items-center gap-2">
          <span class="w-5 h-5 rounded-md bg-telecab-gold/15 text-telecab-gold text-[11px] flex items-center justify-center">${i + 1}</span>
          ${e} <span class="text-telecab-muted font-normal">(${lista.length})</span></h2>`;
      const cont = document.createElement('div'); cont.className = 'space-y-1';
      if (!lista.length) cont.innerHTML = '<p class="text-telecab-muted text-xs px-1">—</p>';
      else lista.sort((a, b) => (a.nombre || '').localeCompare(b.nombre || '', 'es')).forEach(t => cont.appendChild(tarjeta(t)));
      sec.appendChild(cont); board.appendChild(sec);
    });
  }

  cargar();
</script>
