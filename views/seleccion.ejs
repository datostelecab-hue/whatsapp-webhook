<div class="p-4 lg:p-6 max-w-6xl mx-auto space-y-5">

  <!-- Funnel: contador por etapa + salidas -->
  <div class="flex flex-wrap items-stretch gap-2">
    <% (etapas || []).forEach(function (e, i) { %>
      <div class="flex-1 min-w-[140px] bg-telecab-card border border-telecab-border rounded-xl px-3 py-2">
        <p class="text-[10px] uppercase tracking-wide text-telecab-muted leading-tight"><%= i + 1 %>. <%= e %></p>
        <p class="text-xl font-bold text-telecab-text" data-cont-etapa="<%= e %>">–</p>
      </div>
    <% }); %>
    <a href="/pendientes-bolt" class="min-w-[130px] bg-telecab-card border border-telecab-border rounded-xl px-3 py-2 hover:border-telecab-gold transition">
      <p class="text-[10px] uppercase tracking-wide text-telecab-muted">Pendientes BOLT <i class="fa-solid fa-arrow-up-right-from-square opacity-60"></i></p>
      <p id="c-pendiente" class="text-xl font-bold text-telecab-gold">–</p>
    </a>
    <div class="min-w-[130px] bg-telecab-card border border-telecab-border rounded-xl px-3 py-2">
      <p class="text-[10px] uppercase tracking-wide text-telecab-muted">Rechazados RRHH</p>
      <p id="c-rechrrhh" class="text-xl font-bold text-telecab-red">–</p>
    </div>
  </div>

  <!-- Buscar / crear por teléfono -->
  <div class="bg-telecab-card border border-telecab-border rounded-2xl p-4">
    <label class="block text-sm text-telecab-muted mb-2">Contacto del candidato — teléfono (9 dígitos)</label>
    <div class="flex gap-2">
      <input id="tel-input" inputmode="numeric" maxlength="14" placeholder="6XX XXX XXX"
             class="flex-1 bg-telecab-dark border border-telecab-border rounded-xl px-4 py-2.5 text-telecab-text placeholder:text-telecab-muted/60 focus:outline-none focus:border-telecab-gold transition font-mono tracking-wider">
      <button id="btn-abrir" class="px-5 py-2.5 rounded-xl bg-telecab-gold text-telecab-dark font-semibold hover:bg-telecab-gold-soft transition whitespace-nowrap">
        <i class="fa-solid fa-id-card mr-1"></i> Abrir / crear
      </button>
    </div>
    <p id="tel-error" class="text-telecab-red text-xs mt-2 hidden"></p>
  </div>

  <!-- Ficha -->
  <div id="ficha" class="bg-telecab-card border border-telecab-border rounded-2xl p-5 hidden">
    <div class="flex items-center justify-between mb-3">
      <div>
        <h2 class="text-lg font-semibold text-telecab-text flex items-center gap-2">
          <i class="fa-solid fa-user-pen text-telecab-gold"></i> <span id="ficha-titulo">Nuevo candidato</span>
        </h2>
        <p class="text-sm text-telecab-muted font-mono" id="ficha-tel"></p>
      </div>
    </div>

    <div id="banner-bolt" class="hidden mb-3 rounded-xl border border-telecab-gold/50 bg-telecab-gold/10 p-3 text-xs text-telecab-gold">
      <i class="fa-solid fa-triangle-exclamation mr-1"></i> <b>Este conductor YA está en BOLT</b> (viene de un proceso anterior). No hay que crearlo: <b>actívalo YA en BOLT</b> para continuar — sin estar activo en BOLT no puede trabajar y RRHH no podrá darlo de alta. Revisa bien la ficha; el link de alta no es obligatorio.
    </div>

    <!-- Funnel stepper -->
    <div class="flex flex-wrap gap-1.5 mb-4" id="stepper">
      <% (etapas || []).forEach(function (e, i) { %>
        <button type="button" data-etapa="<%= e %>" class="step px-3 py-1.5 rounded-lg text-xs border border-telecab-border text-telecab-muted hover:border-telecab-gold transition">
          <%= i + 1 %>. <%= e %>
        </button>
      <% }); %>
    </div>

    <div class="grid md:grid-cols-2 gap-4">
      <div>
        <label class="block text-xs text-telecab-muted mb-1">Nombre</label>
        <input data-campo="nombre" class="inp">
      </div>
      <div>
        <label class="block text-xs text-telecab-muted mb-1">Apellidos</label>
        <input data-campo="apellidos" class="inp">
      </div>
      <div>
        <label class="block text-xs text-telecab-muted mb-1">DNI / NIE</label>
        <input data-campo="dni" class="inp">
      </div>
      <div>
        <label class="block text-xs text-telecab-muted mb-1">Canal de origen</label>
        <select data-campo="canal" class="inp">
          <option value="">—</option>
          <% (canales || []).forEach(function (c) { %><option value="<%= c %>"><%= c %></option><% }); %>
        </select>
        <p id="nota-ett" class="text-[11px] text-telecab-gold mt-1 hidden"><i class="fa-solid fa-circle-info"></i> Vía ETT: el contrato puede ser 40h ETT / 32h ETT. La agencia nos lo manda; lo entrevistamos igual.</p>
      </div>
      <div>
        <label class="block text-xs text-telecab-muted mb-1">Correo electrónico</label>
        <input data-campo="email" type="email" class="inp">
      </div>
      <div>
        <label class="block text-xs text-telecab-muted mb-1">Contacto de emergencia</label>
        <input data-campo="contacto_emergencia" class="inp">
      </div>
      <div>
        <label class="block text-xs text-telecab-muted mb-1">Fecha de nacimiento</label>
        <input data-campo="fecha_nacimiento" class="js-fecha inp" readonly placeholder="dd/mm/aaaa">
      </div>

      <!-- Vacante que se cubre (la arma Tráfico en el generador) -->
      <div class="md:col-span-2">
        <label class="block text-xs text-telecab-muted mb-1">Vacante <span class="text-telecab-muted/70">(la elige Tráfico en el generador)</span></label>
        <select data-campo="vacante" class="inp">
          <option value="">— sin asignar —</option>
          <% (vacantes || []).forEach(function (v) { %>
            <option value="<%= v.id %>" data-zonas="<%= v.zonas %>" data-turno="<%= v.turno %>"><%= v.puesto %> · <%= v.zonas %> · libra <%= v.libranzas %></option>
          <% }); %>
        </select>
        <p id="vac-info" class="text-[11px] text-telecab-muted mt-1 hidden"></p>
      </div>

      <div>
        <label class="block text-xs text-telecab-muted mb-1">Certificado bancario (IBAN / nº cuenta)</label>
        <input data-campo="iban" class="inp font-mono">
      </div>
      <div>
        <label class="block text-xs text-telecab-muted mb-1">Responsable (Selección)</label>
        <input data-campo="responsable" class="inp">
      </div>

      <div class="md:col-span-2">
        <label class="block text-xs text-telecab-muted mb-1">Dirección</label>
        <div class="flex gap-2">
          <input data-campo="direccion" class="inp flex-1">
          <button id="btn-geo" type="button" class="px-3 py-2 rounded-xl bg-telecab-card2 border border-telecab-border text-telecab-text hover:border-telecab-gold transition whitespace-nowrap text-sm">
            <i class="fa-solid fa-location-crosshairs mr-1"></i> Coordenadas
          </button>
        </div>
      </div>
      <div class="md:col-span-2">
        <label class="block text-xs text-telecab-muted mb-1">Coordenadas</label>
        <input data-campo="coordenadas" class="inp font-mono" placeholder="lat, lng">
      </div>

      <div class="md:col-span-2">
        <label class="block text-xs text-telecab-muted mb-1">Notas</label>
        <textarea data-campo="notas" rows="2" class="inp resize-none"></textarea>
      </div>

      <div class="md:col-span-2">
        <label class="block text-xs text-telecab-muted mb-1">Link de alta BOLT <span class="text-telecab-muted/70">(se enviará al conductor por WhatsApp)</span></label>
        <input data-campo="link_bolt" type="url" class="inp font-mono" placeholder="https://…">
        <p class="text-[11px] text-telecab-muted mt-1">Habilita "Enviar solicitud a BOLT". Si el conductor ya está en el histórico, no es obligatorio. <span class="text-telecab-gold">Envío por WhatsApp: pendiente de la plantilla de Meta.</span></p>
      </div>
    </div>

    <!-- ══════════ FICHA DE ALTA: datos + documentos ══════════ -->
    <div class="mt-5 pt-4 border-t border-telecab-border">
      <h3 class="text-sm font-semibold text-telecab-text mb-3 flex items-center gap-2">
        <i class="fa-solid fa-file-signature text-telecab-gold"></i> Ficha de alta
        <span class="text-[11px] text-telecab-muted font-normal">— datos y documentos para la FICHA DE ALTA en PDF</span>
      </h3>
      <div class="grid md:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs text-telecab-muted mb-1">Código postal</label>
          <input data-campo="codigo_postal" class="inp">
        </div>
        <div>
          <label class="block text-xs text-telecab-muted mb-1">Localidad</label>
          <input data-campo="localidad" class="inp" placeholder="MADRID">
        </div>
        <div>
          <label class="block text-xs text-telecab-muted mb-1">Provincia</label>
          <input data-campo="provincia" class="inp" placeholder="Madrid">
        </div>
        <div>
          <label class="block text-xs text-telecab-muted mb-1">Estado civil</label>
          <input data-campo="estado_civil" class="inp" placeholder="SOLTERO">
        </div>
        <div>
          <label class="block text-xs text-telecab-muted mb-1">Nº de hijos</label>
          <input data-campo="num_hijos" class="inp">
        </div>
        <div>
          <label class="block text-xs text-telecab-muted mb-1">Nº Seguridad Social</label>
          <input data-campo="num_seg_social" class="inp font-mono">
        </div>
        <div>
          <label class="block text-xs text-telecab-muted mb-1">Tipo de carnet</label>
          <input data-campo="tipo_carnet" class="inp" placeholder="B">
        </div>
        <div>
          <label class="block text-xs text-telecab-muted mb-1">Carnet · fecha expedición</label>
          <input data-campo="carnet_expedicion" class="js-fecha inp" readonly placeholder="dd/mm/aaaa">
        </div>
        <div>
          <label class="block text-xs text-telecab-muted mb-1">Carnet · fecha caducidad</label>
          <input data-campo="carnet_caducidad" class="js-fecha inp" readonly placeholder="dd/mm/aaaa">
        </div>
        <div>
          <label class="block text-xs text-telecab-muted mb-1">Fecha de inicio (contrato)</label>
          <input data-campo="fecha_inicio" class="js-fecha inp" readonly placeholder="dd/mm/aaaa">
        </div>
        <div>
          <label class="block text-xs text-telecab-muted mb-1">Nacionalidad <span class="text-telecab-muted/70">(del DNI/NIE)</span></label>
          <input data-campo="nacionalidad" class="inp" placeholder="Española">
        </div>
        <div>
          <label class="block text-xs text-telecab-muted mb-1">Jornada</label>
          <select data-campo="jornada" class="inp">
            <option value="40 HORAS">40 horas</option>
            <option value="32 HORAS">32 horas</option>
          </select>
          <p id="salario-nota" class="text-[11px] text-telecab-gold mt-1"></p>
        </div>
      </div>

      <p class="text-xs uppercase tracking-wide text-telecab-muted mt-5 mb-2">Documentos <span class="normal-case text-telecab-muted/70">— arrastra un archivo, pega un pantallazo (Ctrl+V) o haz clic para examinar</span></p>
      <div id="drive-aviso" class="hidden rounded-lg border border-telecab-gold/40 bg-telecab-gold/5 px-3 py-2 text-xs text-telecab-gold mb-2"></div>
      <div id="dropzones" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3"></div>

      <div class="mt-4 flex items-center gap-3 flex-wrap">
        <button id="btn-ficha" class="px-4 py-2.5 rounded-xl bg-telecab-gold/15 border border-telecab-gold/40 text-telecab-gold hover:bg-telecab-gold/25 transition font-semibold">
          <i class="fa-solid fa-file-pdf mr-1"></i> Generar FICHA DE ALTA (PDF)
        </button>
        <p id="ficha-pdf-msg" class="text-xs hidden"></p>
      </div>
    </div>

    <!-- Atributos rápidos -->
    <div class="flex flex-wrap gap-4 mt-4">
      <% [{k:'experiencia',t:'Experiencia'},{k:'carne_vtc',t:'Carné VTC'}].forEach(function (f) { %>
        <div>
          <label class="block text-xs text-telecab-muted mb-1"><%= f.t %></label>
          <div class="inline-flex rounded-xl border border-telecab-border overflow-hidden" data-toggle="<%= f.k %>">
            <button type="button" data-val="Sí" class="px-4 py-1.5 text-sm transition">Sí</button>
            <button type="button" data-val="No" class="px-4 py-1.5 text-sm transition border-l border-telecab-border">No</button>
          </div>
        </div>
      <% }); %>
    </div>

    <div class="flex flex-wrap gap-2 mt-5">
      <button id="btn-guardar" class="px-4 py-2.5 rounded-xl bg-telecab-card2 border border-telecab-border text-telecab-text hover:border-telecab-gold transition font-medium">
        <i class="fa-solid fa-floppy-disk mr-1"></i> Guardar
      </button>
      <button id="btn-bolt" class="px-4 py-2.5 rounded-xl bg-telecab-green/15 border border-telecab-green/40 text-telecab-green hover:bg-telecab-green/25 transition font-semibold disabled:opacity-40 disabled:cursor-not-allowed">
        <i class="fa-solid fa-paper-plane mr-1"></i> Enviar solicitud a BOLT
      </button>
      <button id="btn-descartar" class="px-4 py-2.5 rounded-xl bg-telecab-red/10 border border-telecab-red/40 text-telecab-red hover:bg-telecab-red/20 transition font-medium ml-auto">
        <i class="fa-solid fa-user-xmark mr-1"></i> Descartar
      </button>
    </div>
    <p id="ficha-msg" class="text-xs mt-3 hidden"></p>
  </div>

  <!-- Board por etapa -->
  <div id="board" class="space-y-3"></div>

</div>

<style>
  .inp { width:100%; background:#0e1116; border:1px solid #282e39; border-radius:.75rem; padding:.5rem .75rem; color:#e6e8ec; transition:border-color .15s; }
  .inp:focus { outline:none; border-color:#e8b84b; }
</style>

<script>
  const ETAPAS = <%- JSON.stringify(etapas || []) %>;
  const CAMPOS = ['nombre','dni','canal','email','contacto_emergencia','fecha_nacimiento','vacante','iban','responsable','direccion','coordenadas','notas','link_bolt',
    'apellidos','codigo_postal','localidad','provincia','estado_civil','num_hijos','num_seg_social','tipo_carnet','carnet_expedicion','carnet_caducidad','fecha_inicio','jornada','nacionalidad'];
  const estado = { experiencia: 'No', carne_vtc: 'No' };
  let ticketActual = null;
  let EN_BOLT = false;   // ¿el teléfono ya está en nuestro histórico de BOLT?

  const $ = s => document.querySelector(s);
  const norm = v => String(v || '').replace(/\D/g, '').slice(-9);

  // Toggles Sí/No
  function pintarToggle(campo) {
    document.querySelectorAll(`[data-toggle="${campo}"] [data-val]`).forEach(b => {
      const on = b.dataset.val === estado[campo];
      b.className = 'px-4 py-1.5 text-sm transition' + (b.dataset.val === 'No' ? ' border-l border-telecab-border' : '') +
        (on ? (estado[campo] === 'Sí' ? ' bg-telecab-green/20 text-telecab-green font-semibold' : ' bg-telecab-card2 text-telecab-text font-semibold')
            : ' text-telecab-muted hover:bg-telecab-card2');
    });
  }
  document.querySelectorAll('[data-toggle]').forEach(g => {
    const campo = g.dataset.toggle;
    g.querySelectorAll('[data-val]').forEach(b => b.addEventListener('click', () => { estado[campo] = b.dataset.val; pintarToggle(campo); }));
  });

  // Stepper del funnel
  function pintarStepper(estadoActual) {
    const idx = ETAPAS.indexOf(estadoActual);
    document.querySelectorAll('#stepper .step').forEach((b, i) => {
      const done = i < idx, cur = i === idx;
      b.className = 'step px-3 py-1.5 rounded-lg text-xs border transition ' +
        (cur ? 'border-telecab-gold bg-telecab-gold/15 text-telecab-gold font-semibold'
         : done ? 'border-telecab-green/40 bg-telecab-green/10 text-telecab-green'
         : 'border-telecab-border text-telecab-muted hover:border-telecab-gold');
    });
    actualizarBotonBolt();
  }

  // "Enviar a BOLT": solo en la última etapa Y con el link puesto (o si el
  // conductor ya está en el histórico de BOLT, donde el link no es obligatorio).
  function actualizarBotonBolt() {
    const estadoActual = ticketActual ? ticketActual.estado : '';
    const enUltima = estadoActual === ETAPAS[ETAPAS.length - 1];
    const link = ($('[data-campo="link_bolt"]').value || '').trim();
    const btn = $('#btn-bolt');
    btn.disabled = !(enUltima && (link || EN_BOLT));
    // Si ya está en BOLT no se "envía solicitud": va directo a RRHH.
    btn.innerHTML = EN_BOLT
      ? '<i class="fa-solid fa-forward mr-1"></i> Pasar directo a RRHH'
      : '<i class="fa-solid fa-paper-plane mr-1"></i> Enviar solicitud a BOLT';
  }
  $('[data-campo="link_bolt"]').addEventListener('input', actualizarBotonBolt);

  async function api(url, body) {
    const r = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body || {}) });
    return r.json();
  }
  function msg(texto, ok) {
    const el = $('#ficha-msg');
    el.textContent = texto;
    el.className = 'text-xs mt-3 ' + (ok ? 'text-telecab-green' : 'text-telecab-red');
    el.classList.remove('hidden');
  }

  function abrirFicha(t, tel) {
    ticketActual = t || { id: tel, estado: ETAPAS[0] };
    $('#ficha').classList.remove('hidden');
    $('#ficha-tel').textContent = ticketActual.id;
    $('#ficha-titulo').textContent = (t && t.nombre) ? t.nombre : 'Nuevo candidato';
    CAMPOS.forEach(k => { const el = $(`[data-campo="${k}"]`); if (el) el.value = t ? (t[k] || '') : ''; });
    ['experiencia', 'carne_vtc'].forEach(k => { estado[k] = (t && t[k] === 'Sí') ? 'Sí' : 'No'; pintarToggle(k); });
    pintarStepper(ticketActual.estado);
    pintarVacInfo();
    refrescarDocs();
    const _j = $('[data-campo="jornada"]'); if (_j && !_j.value) _j.value = '40 HORAS';
    actualizarSalario();
    $('#nota-ett').classList.toggle('hidden', ($('[data-campo="canal"]').value !== 'Bolsa de Empleo (ETT)'));
    $('#ficha-msg').classList.add('hidden');
    $('#ficha').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  // Reabre una ficha por teléfono (cargando datos del servidor + banner de BOLT).
  async function abrirPorTel(tel) {
    const r = await (await fetch('/seleccion/api/ticket/' + tel)).json();
    EN_BOLT = !!(r && r.enBolt);
    $('#banner-bolt').classList.toggle('hidden', !EN_BOLT);
    abrirFicha((r && r.ticket) || { id: tel }, tel);
  }

  function datosFicha() {
    const d = { tel: ticketActual.id, experiencia: estado.experiencia, carne_vtc: estado.carne_vtc };
    CAMPOS.forEach(k => { const el = $(`[data-campo="${k}"]`); if (el) d[k] = el.value; });
    // Zona y turno se derivan de la vacante elegida (los pone Tráfico, no Selección).
    const opt = $('[data-campo="vacante"]').selectedOptions[0];
    d.zona = opt ? (opt.dataset.zonas || '') : '';
    d.turno = opt ? (opt.dataset.turno || '') : '';
    return d;
  }

  // Cola de subida de documentos. Guardar el formulario reescribe TODA la hoja,
  // así que primero se espera a que terminen las subidas (que escriben celdas
  // sueltas) para no revertirlas con una lectura antigua.
  let colaDocs = Promise.resolve();
  async function guardarFormulario() {
    await colaDocs;
    return api('/seleccion/ticket', datosFicha());
  }

  // Campos y documentos obligatorios antes de enviar a BOLT (deben coincidir con
  // REQUERIDOS_ALTA del servidor, que es quien lo impone de verdad).
  const REQ_FICHA = [
    ['nombre', 'Nombre'], ['apellidos', 'Apellidos'], ['dni', 'DNI/NIE'],
    ['fecha_nacimiento', 'Fecha de nacimiento'], ['email', 'Correo'],
    ['direccion', 'Dirección'], ['codigo_postal', 'Código postal'],
    ['estado_civil', 'Estado civil'], ['num_seg_social', 'Nº Seguridad Social'],
    ['iban', 'Certificado bancario (IBAN)'],
    ['carnet_expedicion', 'Carnet: expedición'], ['carnet_caducidad', 'Carnet: caducidad'],
    ['fecha_inicio', 'Fecha de inicio']
  ];
  const REQ_DOCS = [
    ['dni', 'Doc: DNI/NIE'], ['carnet', 'Doc: Carnet'], ['bancario', 'Doc: Cert. bancario'],
    ['seg_social', 'Doc: Seg. Social/vida laboral'], ['penales', 'Doc: Delitos sexuales']
  ];
  function faltanFicha() {
    const d = datosFicha();
    const faltan = REQ_FICHA.filter(([c]) => !String(d[c] || '').trim()).map(([, l]) => l);
    REQ_DOCS.forEach(([k, l]) => { if (!(ticketActual && ticketActual['doc_' + k])) faltan.push(l); });
    return faltan;
  }

  function pintarVacInfo() {
    const opt = $('[data-campo="vacante"]').selectedOptions[0];
    const info = $('#vac-info');
    if (opt && opt.value) { info.textContent = `Zona: ${opt.dataset.zonas || '—'} · Turno: ${opt.dataset.turno || '—'}`; info.classList.remove('hidden'); }
    else info.classList.add('hidden');
  }
  $('[data-campo="vacante"]').addEventListener('change', pintarVacInfo);

  // Salario según la jornada (40 h → 1.442,14 · 32 h → 1.154,39). Solo informativo
  // en la ficha; el PDF lo vuelve a calcular igual en el servidor.
  const SALARIOS = { '40': '1.442,14', '32': '1.154,39' };
  function actualizarSalario() {
    const jn = $('[data-campo="jornada"]');
    const h = (jn ? jn.value : '').replace(/\D/g, '');
    const nota = $('#salario-nota');
    if (nota) nota.textContent = 'Salario: ' + (SALARIOS[h] || SALARIOS['40']) + ' € · Contrato: ' + (h === '32' ? 'CT-200' : 'CT-100');
  }
  { const jn = $('[data-campo="jornada"]'); if (jn) jn.addEventListener('change', actualizarSalario); }

  // Abrir / crear
  $('#btn-abrir').addEventListener('click', async () => {
    const tel = norm($('#tel-input').value);
    const err = $('#tel-error');
    if (tel.length !== 9) { err.textContent = 'El teléfono debe tener 9 dígitos.'; err.classList.remove('hidden'); return; }
    err.classList.add('hidden');
    const r = await (await fetch('/seleccion/api/ticket/' + tel)).json();
    EN_BOLT = !!r.enBolt;
    $('#banner-bolt').classList.toggle('hidden', !EN_BOLT);
    abrirFicha(r.ticket, tel);
  });
  $('#tel-input').addEventListener('keydown', e => { if (e.key === 'Enter') $('#btn-abrir').click(); });
  $('[data-campo="canal"]').addEventListener('change', () => $('#nota-ett').classList.toggle('hidden', $('[data-campo="canal"]').value !== 'Bolsa de Empleo (ETT)'));

  // Guardar
  $('#btn-guardar').addEventListener('click', async () => {
    const r = await guardarFormulario();
    if (r.status === 'ok') { $('#ficha').classList.add('hidden'); cargar(); }
    else msg(r.msg || 'Error al guardar', false);
  });

  // Mover de etapa (stepper)
  $('#stepper').addEventListener('click', async e => {
    const b = e.target.closest('.step'); if (!b || !ticketActual) return;
    await guardarFormulario();              // guarda lo escrito
    const r = await api('/seleccion/etapa', { tel: ticketActual.id, estado: b.dataset.etapa });
    if (r.status === 'ok') { ticketActual = r.ticket; pintarStepper(r.ticket.estado); cargar(); }
    else msg(r.msg || 'No se pudo mover de etapa', false);
  });

  // Enviar a BOLT
  $('#btn-bolt').addEventListener('click', async () => {
    await guardarFormulario();                 // guarda lo tecleado antes de validar
    const faltan = faltanFicha();
    if (faltan.length) { msg('Completa la ficha antes de enviar a BOLT — falta: ' + faltan.join(', '), false); return; }
    const r = await api('/seleccion/bolt', { tel: ticketActual.id });
    if (r.status === 'ok') {
      const directo = r.ticket && r.ticket.estado === 'Aprobado en BOLT';
      msg(directo ? 'Ya estaba en BOLT — pasado directo a RRHH. Recuerda activarlo en BOLT.'
                  : 'Solicitud enviada a BOLT — pendiente de aprobación.', true);
      $('#ficha').classList.add('hidden'); cargar();
    }
    else msg(r.msg || 'No se pudo enviar a BOLT', false);
  });

  // Descartar
  $('#btn-descartar').addEventListener('click', async () => {
    const motivo = prompt('Motivo del descarte:'); if (motivo === null) return;
    const r = await api('/seleccion/descartar', { tel: ticketActual.id, motivo });
    if (r.status === 'ok') { $('#ficha').classList.add('hidden'); cargar(); }
    else msg(r.msg || 'No se pudo descartar', false);
  });

  // Geocodificar
  $('#btn-geo').addEventListener('click', async () => {
    const dir = $('[data-campo="direccion"]').value.trim();
    if (!dir) { msg('Escribe primero la dirección.', false); return; }
    const btn = $('#btn-geo'); const html = btn.innerHTML;
    btn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i>';
    const r = await api('/seleccion/geocodificar', { direccion: dir });
    btn.innerHTML = html;
    if (r.status === 'ok' && r.encontrado) { $('[data-campo="coordenadas"]').value = r.coordenadas; msg('Coordenadas obtenidas (' + r.precision + ').', true); }
    else msg(r.msg || 'No se encontró la dirección.', false);
  });

  // Board por etapa
  function tarjeta(t) {
    const el = document.createElement('button');
    el.className = 'w-full text-left flex items-center gap-3 px-3 py-2 rounded-lg bg-telecab-dark/40 hover:bg-telecab-card2 border border-transparent hover:border-telecab-border transition';
    el.innerHTML =
      `<span class="w-7 h-7 rounded-lg bg-telecab-gold/15 text-telecab-gold flex items-center justify-center shrink-0 text-xs"><i class="fa-solid fa-user"></i></span>
       <span class="min-w-0 flex-1">
         <span class="block text-sm text-telecab-text truncate">${t.nombre || '<span class=\"text-telecab-muted\">(sin nombre)</span>'}</span>
         <span class="block text-xs text-telecab-muted font-mono">${t.id}${t.zona ? ' · ' + t.zona : ''}${t.turno ? ' ' + t.turno : ''}${t.canal ? ' · ' + t.canal : ''}</span>
       </span>`;
    el.addEventListener('click', async () => {
      const r = await (await fetch('/seleccion/api/ticket/' + t.id)).json();
      EN_BOLT = !!(r && r.enBolt);
      $('#banner-bolt').classList.toggle('hidden', !EN_BOLT);
      abrirFicha((r && r.ticket) || t, t.id);
    });
    return el;
  }

  async function cargar() {
    const r = await (await fetch('/seleccion/api/datos')).json();
    if (r.status !== 'ok') return;
    ETAPAS.forEach(e => { const el = document.querySelector(`[data-cont-etapa="${e}"]`); if (el) el.textContent = r.contadores.porEtapa[e] || 0; });
    $('#c-pendiente').textContent = r.contadores.pendienteBolt;
    $('#c-rechrrhh').textContent = r.contadores.rechazadosRRHH || 0;

    const board = $('#board'); board.innerHTML = '';

    // Rechazados por RRHH (si hay): arriba, con el motivo, para reabrir y corregir.
    const rech = r.rechazadosRRHH || [];
    if (rech.length) {
      const sec = document.createElement('div');
      sec.className = 'bg-telecab-red/5 border border-telecab-red/40 rounded-2xl p-4';
      sec.innerHTML = `<h2 class="text-sm font-semibold text-telecab-red mb-2 flex items-center gap-2"><i class="fa-solid fa-rotate-left"></i> Rechazados por RRHH <span class="text-telecab-muted font-normal">(${rech.length})</span></h2>`;
      const cont = document.createElement('div'); cont.className = 'space-y-1';
      rech.sort((a, b) => (a.nombre || '').localeCompare(b.nombre || '', 'es')).forEach(t => {
        const el = document.createElement('button');
        el.className = 'w-full text-left flex items-center gap-3 px-3 py-2 rounded-lg bg-telecab-dark/40 hover:bg-telecab-card2 border border-transparent hover:border-telecab-red/40 transition';
        el.innerHTML =
          `<span class="w-7 h-7 rounded-lg bg-telecab-red/15 text-telecab-red flex items-center justify-center shrink-0 text-xs"><i class="fa-solid fa-user-xmark"></i></span>
           <span class="min-w-0 flex-1">
             <span class="block text-sm text-telecab-text truncate">${t.nombre || '(sin nombre)'}</span>
             <span class="block text-xs text-telecab-red/80 truncate">${t.motivo || 'Devuelto por RRHH'}</span>
           </span>
           <span class="block text-xs text-telecab-muted font-mono shrink-0">${t.id}</span>`;
        el.addEventListener('click', () => abrirPorTel(t.id));
        cont.appendChild(el);
      });
      sec.appendChild(cont); board.appendChild(sec);
    }

    ETAPAS.forEach((e, i) => {
      const lista = r.porEtapa[e] || [];
      const sec = document.createElement('div');
      sec.className = 'bg-telecab-card border border-telecab-border rounded-2xl p-4';
      sec.innerHTML = `<h2 class="text-sm font-semibold text-telecab-text mb-2 flex items-center gap-2">
          <span class="w-5 h-5 rounded-md bg-telecab-gold/15 text-telecab-gold text-[11px] flex items-center justify-center">${i + 1}</span>
          ${e} <span class="text-telecab-muted font-normal">(${lista.length})</span></h2>`;
      const cont = document.createElement('div'); cont.className = 'space-y-1';
      if (!lista.length) cont.innerHTML = '<p class="text-telecab-muted text-xs px-1">—</p>';
      else lista.sort((a, b) => (a.nombre || '').localeCompare(b.nombre || '', 'es')).forEach(t => cont.appendChild(tarjeta(t)));
      sec.appendChild(cont); board.appendChild(sec);
    });
  }

  // ---------- Documentos de la ficha de alta (Drive) ----------
  const DOCS = [
    { key: 'dni', label: 'DNI / NIE' },
    { key: 'carnet', label: 'Carnet de conducir' },
    { key: 'bancario', label: 'Certificado bancario' },
    { key: 'seg_social', label: 'Cert. Seg. Social / vida laboral' },
    { key: 'penales', label: 'Cert. de delitos sexuales' }
  ];
  let dzActiva = null;   // última zona apuntada (para pegar con Ctrl+V)

  const iconoMime = m => /pdf/.test(m || '') ? 'fa-file-pdf' : (/image/.test(m || '') ? 'fa-file-image' : 'fa-file');

  function pintarDoc(tipo, doc) {
    const zona = document.querySelector(`.dz[data-tipo="${tipo}"]`);
    if (!zona) return;
    const body = zona.querySelector('.dz-body');
    if (doc && doc.id) {
      zona.classList.add('dz-ok');
      const nombre = String(doc.nombre || 'documento').replace(/^[A-Z_]+ — /, '');
      body.innerHTML =
        `<div class="flex items-center gap-2 w-full">
           <i class="fa-solid ${iconoMime(doc.mime)} text-telecab-green"></i>
           <a href="${doc.link || '#'}" target="_blank" rel="noopener" class="flex-1 text-left text-xs text-telecab-text hover:text-telecab-gold truncate">${nombre}</a>
           <button type="button" class="dz-quitar text-telecab-muted hover:text-telecab-red px-1" title="Quitar"><i class="fa-solid fa-xmark"></i></button>
         </div>`;
      body.querySelector('.dz-quitar').addEventListener('click', ev => { ev.stopPropagation(); quitarDoc(tipo); });
    } else {
      zona.classList.remove('dz-ok');
      body.innerHTML = '<span class="text-[11px] text-telecab-muted">Arrastra, pega o haz clic</span>';
    }
  }

  function refrescarDocs() {
    DOCS.forEach(d => {
      let doc = null;
      const raw = ticketActual ? ticketActual['doc_' + d.key] : '';
      if (raw) { try { doc = JSON.parse(raw); } catch (_) {} }
      pintarDoc(d.key, doc);
    });
    // Ficha ya generada: mostrar el enlace al PDF actual.
    const el = $('#ficha-pdf-msg');
    let fp = null;
    if (ticketActual && ticketActual.ficha_pdf) { try { fp = JSON.parse(ticketActual.ficha_pdf); } catch (_) {} }
    if (fp && fp.link) {
      el.className = 'text-xs text-telecab-muted';
      el.innerHTML = 'Ficha actual: <a href="' + fp.link + '" target="_blank" rel="noopener" class="underline text-telecab-gold font-semibold">Abrir PDF →</a>';
      el.classList.remove('hidden');
    } else {
      el.classList.add('hidden');
    }
  }

  // Los documentos se suben de UNO EN UNO (cola): así el servidor escribe cada
  // celda sin solaparse. El ticket lo crea el propio endpoint si no existía.
  function subirDoc(tipo, file) {
    if (!file || !ticketActual) return;
    const tel = ticketActual.id;
    const zona = document.querySelector(`.dz[data-tipo="${tipo}"]`);
    zona.querySelector('.dz-body').innerHTML = '<span class="text-[11px] text-telecab-muted"><i class="fa-solid fa-circle-notch fa-spin"></i> Subiendo…</span>';
    if (window.telecabCarga) window.telecabCarga.abrir();   // tapa la pantalla mientras sube
    colaDocs = colaDocs.then(() => enviarDoc(tipo, file, tel));
  }
  async function enviarDoc(tipo, file, tel) {
    try {
      const fd = new FormData();
      fd.append('tel', tel);
      fd.append('tipo', tipo);
      fd.append('archivo', file, file.name || (tipo + '.png'));
      const r = await (await fetch('/seleccion/documento', { method: 'POST', body: fd })).json();
      if (r.status !== 'ok') throw new Error(r.msg);
      if (ticketActual && ticketActual.id === tel) ticketActual['doc_' + tipo] = JSON.stringify(r.doc);
      pintarDoc(tipo, r.doc);
    } catch (e) {
      pintarDoc(tipo, null);
      msg('No se pudo subir el documento: ' + e.message, false);
    } finally {
      if (window.telecabCarga) window.telecabCarga.cerrar();
    }
  }

  async function quitarDoc(tipo) {
    if (!ticketActual) return;
    try {
      const r = await (await fetch('/seleccion/documento', {
        method: 'DELETE', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ tel: ticketActual.id, tipo })
      })).json();
      if (r.status !== 'ok') throw new Error(r.msg);
      ticketActual['doc_' + tipo] = '';
      pintarDoc(tipo, null);
    } catch (e) { msg('No se pudo quitar: ' + e.message, false); }
  }

  function initDropzones() {
    const cont = $('#dropzones');
    cont.innerHTML = DOCS.map(d => `
      <div class="dz relative rounded-xl border border-dashed border-telecab-border p-3 min-h-[92px] flex flex-col cursor-pointer transition focus:outline-none focus:border-telecab-gold" data-tipo="${d.key}" tabindex="0">
        <span class="text-xs font-medium text-telecab-text mb-1">${d.label}</span>
        <div class="dz-body flex-1 flex items-center justify-center text-center"></div>
        <input type="file" class="hidden dz-input" accept="image/*,application/pdf,.pdf">
      </div>`).join('');

    cont.querySelectorAll('.dz').forEach(zona => {
      const tipo = zona.dataset.tipo;
      const input = zona.querySelector('.dz-input');
      pintarDoc(tipo, null);
      zona.addEventListener('click', e => { if (e.target.closest('a,button')) return; input.click(); });
      zona.addEventListener('focus', () => { dzActiva = tipo; });
      zona.addEventListener('mouseenter', () => { dzActiva = tipo; });
      input.addEventListener('change', () => { if (input.files[0]) subirDoc(tipo, input.files[0]); input.value = ''; });
      zona.addEventListener('dragover', e => { e.preventDefault(); zona.classList.add('border-telecab-gold'); });
      zona.addEventListener('dragleave', () => zona.classList.remove('border-telecab-gold'));
      zona.addEventListener('drop', e => {
        e.preventDefault(); zona.classList.remove('border-telecab-gold');
        const f = e.dataTransfer.files[0]; if (f) subirDoc(tipo, f);
      });
    });
  }

  // Pegar (Ctrl+V) una imagen → va a la última zona apuntada.
  document.addEventListener('paste', e => {
    if (!dzActiva || !ticketActual) return;
    const item = [...((e.clipboardData || {}).items || [])].find(i => i.type.indexOf('image/') === 0);
    if (!item) return;
    const f = item.getAsFile();
    if (f) { e.preventDefault(); subirDoc(dzActiva, f); }
  });

  // Aviso si Drive aún no está conectado.
  (async () => {
    try {
      const est = await (await fetch('/documentos/api/estado')).json();
      if (!est.configurado) {
        const a = $('#drive-aviso');
        a.classList.remove('hidden');
        a.innerHTML = est.puedeConectar
          ? 'Drive aún no está conectado. <a href="/documentos/auth" target="_blank" class="underline font-semibold">Conectar cuenta de Google →</a>'
          : 'Falta configurar el cliente OAuth de Drive (GOOGLE_OAUTH_CLIENT_ID / SECRET en Render).';
      }
    } catch (_) {}
  })();

  // Generar la FICHA DE ALTA en PDF.
  $('#btn-ficha').addEventListener('click', async () => {
    if (!ticketActual) return;
    const el = $('#ficha-pdf-msg');
    el.className = 'text-xs text-telecab-muted'; el.textContent = 'Generando la ficha…'; el.classList.remove('hidden');
    try {
      await guardarFormulario();
      const r = await (await fetch('/seleccion/ficha', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ tel: ticketActual.id })
      })).json();
      if (r.status !== 'ok') throw new Error(r.msg);
      if (r.ficha) ticketActual.ficha_pdf = JSON.stringify(r.ficha);   // recordar el PDF actual
      el.className = 'text-xs text-telecab-green';
      el.innerHTML = `Ficha generada (${r.adjuntos} doc.). <a href="${r.link}" target="_blank" rel="noopener" class="underline font-semibold">Abrir PDF →</a>`;
      if (r.link) window.open(r.link, '_blank');
    } catch (e) {
      el.className = 'text-xs text-telecab-red'; el.textContent = 'No se pudo generar: ' + e.message;
    }
  });

  initDropzones();
  cargar();
</script>

<style>
  .dz.dz-ok { border-style: solid; border-color: rgba(62,207,142,.5); }
  .dz:hover { border-color: rgba(232,184,75,.5); }
</style>
