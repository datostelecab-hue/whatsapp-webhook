<div class="max-w-5xl mx-auto p-4 sm:p-6">

  <div class="flex items-center gap-3 mb-6">
    <div class="w-10 h-10 rounded-xl bg-telecab-gold/10 flex items-center justify-center">
      <i class="fa-solid fa-people-arrows text-telecab-gold"></i>
    </div>
    <div>
      <h1 class="text-xl font-bold text-telecab-text">ETT · Bolsa de empleo</h1>
      <p class="text-sm text-telecab-muted">Candidatos que nos manda la agencia. Marca la decisión y completa los datos.</p>
    </div>
  </div>

  <!-- Importar la matriz del correo -->
  <div class="bg-telecab-card border border-telecab-border rounded-2xl p-4 sm:p-5 mb-5">
    <div class="flex items-center justify-between mb-3">
      <h2 class="font-semibold text-telecab-text flex items-center gap-2"><i class="fa-solid fa-table-cells text-telecab-muted"></i> Importar matriz del correo</h2>
      <button id="btnToggleImport" class="text-xs text-telecab-muted hover:text-telecab-text">Mostrar / ocultar</button>
    </div>
    <div id="importBox">
      <p class="text-xs text-telecab-muted mb-2">Copia la tabla del correo de la ETT y pégala aquí (se separa por columnas sola). Solo se añaden los teléfonos nuevos; los que ya están no se tocan.</p>
      <textarea id="pegar" rows="5" placeholder="Pega aquí la tabla del correo…" class="w-full text-sm rounded-xl border border-telecab-border bg-telecab-bg p-3 font-mono text-telecab-text focus:outline-none focus:border-telecab-gold"></textarea>
      <div class="flex items-center gap-3 mt-3">
        <button id="btnImportar" class="px-4 py-2 rounded-xl bg-telecab-gold text-white text-sm font-semibold hover:opacity-90">Importar candidatos</button>
        <span id="importMsg" class="text-sm"></span>
      </div>
    </div>
  </div>

  <!-- Resumen + exportar -->
  <div class="flex flex-wrap items-center gap-2 mb-4" id="chips"></div>

  <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
    <h2 class="font-semibold text-telecab-text">Candidatos</h2>
    <div class="flex items-center gap-2">
      <!-- Lo normal es adjuntar el Excel al correo; copiar la matriz queda como alternativa. -->
      <a id="btnExcel" href="/ett/exportar/excel"
         class="px-4 py-2 rounded-xl bg-telecab-gold text-telecab-dark font-semibold text-sm hover:bg-telecab-gold-soft transition shadow-gold flex items-center gap-2">
        <i class="fa-solid fa-file-excel"></i> Descargar Excel para la ETT
      </a>
      <button id="btnExportar" class="px-3 py-2 rounded-xl border border-telecab-border text-sm text-telecab-muted hover:text-telecab-text hover:bg-telecab-card2 flex items-center gap-2"
              title="Copia la matriz en texto, por si prefieres pegarla en el cuerpo del correo">
        <i class="fa-solid fa-copy"></i> Copiar matriz
      </button>
    </div>
  </div>

  <div id="lista" class="space-y-3">
    <div class="text-center text-telecab-muted py-10 text-sm">Cargando…</div>
  </div>
</div>

<script>
  const $ = s => document.querySelector(s);
  const JORNADAS = ['40h', '32h'];
  const TURNOS = ['Día', 'Noche'];
  const ESTADO_ORDEN = { 'Pendiente': 0, 'Presentó': 1, 'Contratado': 2, 'No pasa': 3, 'No se presentó': 4 };
  const ESTILO = {
    'Pendiente': 'bg-slate-100 text-slate-600', 'Presentó': 'bg-blue-100 text-blue-700',
    'Contratado': 'bg-green-100 text-green-700', 'No pasa': 'bg-red-100 text-red-700',
    'No se presentó': 'bg-amber-100 text-amber-700'
  };
  const esc = s => (s == null ? '' : String(s)).replace(/[&<>"]/g, m => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[m]));

  async function cargar() {
    try {
      const r = await fetch('/ett/api/datos', { headers: { Accept: 'application/json' } });
      const d = await r.json();
      if (d.status !== 'ok') throw new Error(d.msg || 'error');
      pintarChips(d.resumen);
      pintarLista(d.lista);
    } catch (e) { $('#lista').innerHTML = '<div class="text-center text-red-600 py-8 text-sm">No pude cargar: ' + esc(e.message) + '</div>'; }
  }

  function pintarChips(r) {
    const chip = (n, txt, cls) => '<span class="px-3 py-1.5 rounded-full text-xs font-semibold ' + cls + '">' + n + ' ' + txt + '</span>';
    $('#chips').innerHTML =
      chip(r.total, 'total', 'bg-telecab-card2 text-telecab-text') +
      chip(r.pendientes, 'por decidir', 'bg-blue-100 text-blue-700') +
      chip(r.contratados, 'contratados', 'bg-green-100 text-green-700') +
      chip(r.noPasan, 'no pasan', 'bg-red-100 text-red-700') +
      chip(r.noPresentados, 'no se presentaron', 'bg-amber-100 text-amber-700');
  }

  function pintarLista(lista) {
    if (!lista.length) { $('#lista').innerHTML = '<div class="text-center text-telecab-muted py-10 text-sm">Aún no hay candidatos. Pega la matriz del correo arriba.</div>'; return; }
    lista.sort((a, b) => (ESTADO_ORDEN[a.estado] ?? 9) - (ESTADO_ORDEN[b.estado] ?? 9) || a.nombre.localeCompare(b.nombre));
    $('#lista').innerHTML = lista.map(tarjeta).join('');
    wire();
  }

  function tarjeta(c) {
    const chip = '<span class="px-2.5 py-1 rounded-full text-xs font-semibold ' + (ESTILO[c.estado] || 'bg-slate-100 text-slate-600') + '">' + esc(c.estado || 'Pendiente') + '</span>';
    const botones = ['No se presentó', 'Presentó', 'Contratado', 'No pasa'].map(e =>
      '<button data-dec="' + e + '" data-tel="' + c.telefono + '" class="dec px-2.5 py-1.5 rounded-lg text-xs border ' +
      (c.estado === e ? 'border-telecab-gold text-telecab-gold font-semibold' : 'border-telecab-border text-telecab-muted hover:bg-telecab-card2') + '">' + e + '</button>').join('');
    // Datos de Selección: visibles cuando presentó o contratado
    const mostrarDatos = c.estado === 'Contratado' || c.estado === 'Presentó';
    const sel = j => JORNADAS.map(o => '<option ' + (c.jornada === o ? 'selected' : '') + '>' + o + '</option>').join('');
    const selT = TURNOS.map(o => '<option ' + (c.turno === o ? 'selected' : '') + '>' + o + '</option>').join('');
    const datos = !mostrarDatos ? '' :
      '<div class="mt-3 pt-3 border-t border-telecab-border grid grid-cols-2 sm:grid-cols-5 gap-2 items-end">' +
      campo('Fecha alta', '<input value="' + esc(c.fecha_alta) + '" class="f-fecha w-full text-sm rounded-lg border border-telecab-border bg-telecab-bg px-2 py-1.5" placeholder="dd/mm/aaaa">') +
      campo('Jornada', '<select class="f-jornada w-full text-sm rounded-lg border border-telecab-border bg-telecab-bg px-2 py-1.5"><option value=""></option>' + sel() + '</select>') +
      campo('Turno', '<select class="f-turno w-full text-sm rounded-lg border border-telecab-border bg-telecab-bg px-2 py-1.5"><option value=""></option>' + selT + '</select>') +
      campo('Zona', '<input value="' + esc(c.zona) + '" list="dl-zonas" class="f-zona w-full text-sm rounded-lg border border-telecab-border bg-telecab-bg px-2 py-1.5" placeholder="GETAFE…">') +
      '<button data-tel="' + c.telefono + '" class="guardar px-3 py-1.5 rounded-lg bg-telecab-gold text-white text-sm font-semibold h-[34px]">Guardar</button>' +
      '</div>';
    // Pasar a RRHH: solo con la decisión tomada y la fecha de alta puesta, que
    // es lo mínimo para abrir un contrato. Si ya tiene ficha, se dice cuál en
    // vez de ofrecer crearla otra vez.
    const puedePasar = c.estado === 'Contratado' && String(c.fecha_alta || '').trim();
    const aRRHH = c.ficha
      ? '<div class="mt-3 pt-3 border-t border-telecab-border text-xs text-telecab-muted">' +
        '<i class="fa-solid fa-id-card mr-1"></i> Ficha creada · nº ' + esc(c.ficha) + '</div>'
      : (!puedePasar ? '' :
        '<div class="mt-3 pt-3 border-t border-telecab-border flex items-center gap-3">' +
        '<button data-tel="' + c.telefono + '" class="a-rrhh px-3 py-1.5 rounded-lg bg-telecab-card2 border border-telecab-gold text-telecab-gold text-sm font-semibold">' +
        '<i class="fa-solid fa-forward mr-1"></i> Crear ficha y pasar a RRHH</button>' +
        '<span class="text-[11px] text-telecab-muted">Deja de ser candidato: pasa a la plantilla como contrato de ETT.</span>' +
        '</div>');
    return '<div class="bg-telecab-card border border-telecab-border rounded-2xl p-4" data-card="' + c.telefono + '">' +
      '<div class="flex items-start justify-between gap-3">' +
      '<div><div class="font-semibold text-telecab-text">' + esc(c.nombre || '(sin nombre)') + '</div>' +
      '<div class="text-xs text-telecab-muted mt-0.5">📞 ' + esc(c.telefono) + (c.dni ? ' · ' + esc(c.dni) : '') + (c.correo ? ' · ' + esc(c.correo) : '') + '</div>' +
      (c.direccion ? '<div class="text-xs text-telecab-muted">📍 ' + esc(c.direccion) + (c.cp ? ', ' + esc(c.cp) : '') + '</div>' : '') +
      '<div class="text-xs text-telecab-muted mt-0.5">🗓 ' + esc(c.fecha_entrevista) + ' ' + esc(c.hora_entrevista) + ' · <span class="text-telecab-text">ETT:</span> ' + esc(c.jornada_ett) + ' ' + esc(c.turno_ett) + '</div>' +
      '</div>' + chip + '</div>' +
      '<div class="flex flex-wrap gap-2 mt-3">' + botones + '</div>' + datos + aRRHH + '</div>';
  }
  function campo(label, control) { return '<div><label class="block text-[11px] text-telecab-muted mb-1">' + label + '</label>' + control + '</div>'; }

  function wire() {
    document.querySelectorAll('.dec').forEach(b => b.addEventListener('click', async () => {
      await accion('/ett/decision', { tel: b.dataset.tel, estado: b.dataset.dec });
      cargar();
    }));
    document.querySelectorAll('.a-rrhh').forEach(b => b.addEventListener('click', async () => {
      b.disabled = true;
      const r = await accion('/ett/rrhh', { tel: b.dataset.tel });
      if (r && r.status === 'ok') {
        alert((r.restaurado ? '✅ Ficha restaurada' : '✅ Ficha creada') + ' nº ' + r.id +
              (r.faltaBolt ? '

⚠️ No tiene cuenta de BOLT. Sin ella no puede conducir.'
                           : (r.boltEnlazada ? '

Su cuenta de BOLT se ha enlazado sola.' : '')));
      }
      cargar();
    }));
    document.querySelectorAll('.guardar').forEach(b => b.addEventListener('click', async () => {
      const card = b.closest('[data-card]');
      await accion('/ett/campos', {
        tel: b.dataset.tel,
        fecha_alta: card.querySelector('.f-fecha').value,
        jornada: card.querySelector('.f-jornada').value,
        turno: card.querySelector('.f-turno').value,
        zona: card.querySelector('.f-zona').value
      });
      b.textContent = 'Guardado ✓';
      setTimeout(() => { b.textContent = 'Guardar'; }, 1500);
    }));
  }

  async function accion(url, body) {
    const r = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify(body) });
    const d = await r.json();
    if (d.status !== 'ok') alert(d.msg || 'Error');
    return d;
  }

  // Importar
  $('#btnToggleImport').addEventListener('click', () => $('#importBox').classList.toggle('hidden'));
  $('#btnImportar').addEventListener('click', async () => {
    const texto = $('#pegar').value;
    if (!texto.trim()) { $('#importMsg').innerHTML = '<span class="text-telecab-muted">Pega la tabla primero.</span>'; return; }
    $('#btnImportar').disabled = true; $('#importMsg').innerHTML = '<span class="text-telecab-muted">Importando…</span>';
    try {
      const r = await fetch('/ett/importar', { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify({ texto }) });
      const d = await r.json();
      if (d.status !== 'ok') { $('#importMsg').innerHTML = '<span class="text-red-600">' + esc(d.msg || 'Error') + '</span>'; }
      else {
        $('#importMsg').innerHTML = '<span class="text-green-700">✅ ' + d.añadidos + ' nuevos' + (d.yaEstaban ? ' · ' + d.yaEstaban + ' ya estaban' : '') + '</span>';
        $('#pegar').value = ''; cargar();
      }
    } catch (e) { $('#importMsg').innerHTML = '<span class="text-red-600">' + esc(e.message) + '</span>'; }
    $('#btnImportar').disabled = false;
  });

  // Exportar (copiar al portapapeles)
  $('#btnExportar').addEventListener('click', async () => {
    try {
      const r = await fetch('/ett/exportar');
      const txt = await r.text();
      await navigator.clipboard.writeText(txt);
      const b = $('#btnExportar'); const o = b.innerHTML;
      b.innerHTML = '<i class="fa-solid fa-check text-green-600"></i> Copiado';
      setTimeout(() => { b.innerHTML = o; }, 1800);
    } catch (e) { alert('No pude copiar: ' + e.message); }
  });

  cargar();
</script>
<datalist id="dl-zonas"><option>GETAFE</option><option>COLMENAR</option><option>ALCOBENDAS</option><option>MADRID</option></datalist>
