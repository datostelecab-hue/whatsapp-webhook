<div class="p-4 lg:p-6 max-w-5xl mx-auto space-y-5">

  <!-- Controles -->
  <div class="bg-telecab-card border border-telecab-border rounded-2xl p-4">
    <div class="grid md:grid-cols-4 gap-4">
      <div>
        <label class="block text-xs text-telecab-muted mb-1">Zona</label>
        <select id="sel-zona" class="inp"><option value="">Cargando…</option></select>
      </div>
      <div>
        <label class="block text-xs text-telecab-muted mb-1">Turno</label>
        <div class="inline-flex rounded-xl border border-telecab-border overflow-hidden w-full" id="tg-turno">
          <button type="button" data-val="Día" class="flex-1 px-3 py-2 text-sm">☀️ Día</button>
          <button type="button" data-val="Noche" class="flex-1 px-3 py-2 text-sm border-l border-telecab-border">🌙 Noche</button>
        </div>
      </div>
      <div>
        <label class="block text-xs text-telecab-muted mb-1">Días de la vacante</label>
        <div class="inline-flex rounded-xl border border-telecab-border overflow-hidden w-full" id="tg-dias">
          <button type="button" data-val="4" class="flex-1 px-3 py-2 text-sm">4 días</button>
          <button type="button" data-val="6" class="flex-1 px-3 py-2 text-sm border-l border-telecab-border">6 días</button>
        </div>
      </div>
      <div>
        <label class="block text-xs text-telecab-muted mb-1">Matrícula de partida</label>
        <select id="sel-matricula" class="inp"><option value="">—</option></select>
      </div>
    </div>
    <div class="flex items-center gap-3 mt-4">
      <button id="btn-generar" class="px-5 py-2.5 rounded-xl bg-telecab-gold text-telecab-dark font-semibold hover:bg-telecab-gold-soft transition disabled:opacity-40" disabled>
        <i class="fa-solid fa-wand-magic-sparkles mr-1"></i> Generar vacante
      </button>
      <p id="msg" class="text-xs hidden"></p>
    </div>
  </div>

  <!-- Resultado interactivo -->
  <div id="resultado" class="hidden space-y-4">
    <div class="bg-telecab-card border border-telecab-border rounded-2xl p-4">
      <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
        <h2 id="res-titulo" class="text-sm font-semibold text-telecab-text"></h2>
        <span id="res-estado" class="text-xs px-2.5 py-1 rounded-full border"></span>
      </div>
      <div class="grid grid-cols-7 gap-1.5" id="semana"></div>
      <div class="flex flex-wrap gap-3 mt-3 text-[11px] text-telecab-muted">
        <span><span class="inline-block w-3 h-3 rounded bg-telecab-gold/30 border border-telecab-gold/50 align-middle"></span> misma zona</span>
        <span><span class="inline-block w-3 h-3 rounded bg-sky-500/25 border border-sky-500/50 align-middle"></span> zona cercana</span>
        <span><span class="inline-block w-3 h-3 rounded bg-telecab-dark border border-telecab-border align-middle"></span> libre</span>
      </div>
    </div>

    <div class="bg-telecab-card border border-telecab-border rounded-2xl p-4">
      <div class="flex items-center justify-between mb-2 gap-2">
        <h3 class="text-sm font-semibold text-telecab-text"><i class="fa-solid fa-list-check text-telecab-gold mr-1"></i> Matrículas de la vacante</h3>
        <button id="btn-guardar-vac" class="px-4 py-2 rounded-xl bg-telecab-green/15 border border-telecab-green/40 text-telecab-green hover:bg-telecab-green/25 transition text-sm font-semibold whitespace-nowrap">
          <i class="fa-solid fa-floppy-disk mr-1"></i> Guardar vacante
        </button>
      </div>
      <div id="sel-bloques" class="space-y-1.5"></div>
      <p id="msg-vac" class="text-xs mt-2 hidden"></p>
    </div>

    <div class="bg-telecab-card border border-telecab-border rounded-2xl p-4">
      <h3 class="text-sm font-semibold text-telecab-text mb-1"><i class="fa-solid fa-plus text-telecab-green mr-1"></i> Otras opciones compatibles
        <span class="text-telecab-muted font-normal">— añade a criterio de Tráfico</span></h3>
      <p class="text-[11px] text-telecab-muted mb-2">Fichas cuyos huecos no chocan con los días ya cubiertos.</p>
      <div id="compatibles" class="space-y-1.5"></div>
    </div>
  </div>

</div>

<style>
  .inp { width:100%; background:#0e1116; border:1px solid #282e39; border-radius:.75rem; padding:.5rem .75rem; color:#e6e8ec; transition:border-color .15s; }
  .inp:focus { outline:none; border-color:#e8b84b; }
</style>

<script>
  const $ = s => document.querySelector(s);
  let DATOS = { zonas: [] };
  const estado = { turno: 'Día', dias: 6 };
  const LETRA = ['L', 'M', 'X', 'J', 'V', 'S', 'D'];
  const DIAS_NOM = ['Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb', 'Dom'];

  // Estado del resultado interactivo.
  let POOL = {}, POOL_ARR = [], SEL = new Set(), OBJETIVO = 6, TURNO = 'Día', ZONA = '';

  function pintarToggle(id, val) {
    document.querySelectorAll(`#${id} [data-val]`).forEach(b => {
      const on = b.dataset.val == val;
      b.className = 'flex-1 px-3 py-2 text-sm transition' + (b.previousElementSibling ? ' border-l border-telecab-border' : '') +
        (on ? ' bg-telecab-gold/20 text-telecab-gold font-semibold' : ' text-telecab-muted hover:bg-telecab-card2');
    });
  }
  $('#tg-turno').addEventListener('click', e => { const b = e.target.closest('[data-val]'); if (!b) return; estado.turno = b.dataset.val; pintarToggle('tg-turno', estado.turno); llenarMatriculas(); });
  $('#tg-dias').addEventListener('click', e => { const b = e.target.closest('[data-val]'); if (!b) return; estado.dias = Number(b.dataset.val); pintarToggle('tg-dias', estado.dias); });

  function huecosDe(mat) { return estado.turno === 'Día' ? (mat.dia || []) : (mat.noche || []); }

  function llenarMatriculas() {
    const zona = $('#sel-zona').value;
    const z = DATOS.zonas.find(x => x.zona === zona);
    const sel = $('#sel-matricula');
    sel.innerHTML = '<option value="">—</option>';
    if (z) z.matriculas.filter(m => huecosDe(m).length).forEach(m => {
      const o = document.createElement('option');
      o.value = m.matricula;
      o.textContent = `${m.matricula} (huecos: ${huecosDe(m).map(d => LETRA[d]).join('')})`;
      sel.appendChild(o);
    });
    $('#btn-generar').disabled = !sel.value;
  }
  $('#sel-zona').addEventListener('change', llenarMatriculas);
  $('#sel-matricula').addEventListener('change', () => { $('#btn-generar').disabled = !$('#sel-matricula').value; });

  function msg(t, ok) { const el = $('#msg'); el.textContent = t; el.className = 'text-xs ' + (ok ? 'text-telecab-green' : 'text-telecab-red'); el.classList.remove('hidden'); }

  // ---- Render interactivo ----
  function diasCubiertos() { const s = new Set(); SEL.forEach(m => (POOL[m].dias || []).forEach(d => s.add(d.dia))); return s; }
  function matriculaDelDia(d) { for (const m of SEL) if ((POOL[m].dias || []).some(x => x.dia === d)) return m; return null; }

  function celdaDia(d) {
    const m = matriculaDelDia(d);
    if (!m) return `<div class="rounded-lg border border-telecab-border bg-telecab-dark px-2 py-3 text-center">
        <div class="text-[10px] text-telecab-muted uppercase">${DIAS_NOM[d]}</div>
        <div class="text-xs text-telecab-muted mt-1">Libre</div></div>`;
    const b = POOL[m];
    const cls = b.sugerido ? 'border-sky-500/50 bg-sky-500/15' : 'border-telecab-gold/50 bg-telecab-gold/15';
    return `<div class="rounded-lg border ${cls} px-2 py-3 text-center">
        <div class="text-[10px] text-telecab-muted uppercase">${DIAS_NOM[d]}</div>
        <div class="text-xs font-mono text-telecab-text mt-1 truncate" title="${m} · ${b.zona}${b.fijo ? ' · ' + b.fijo : ''}">${m}</div>
        ${b.sugerido ? '<div class="text-[9px] text-sky-400 truncate">' + b.zona + '</div>' : ''}</div>`;
  }

  function filaBloque(m, modo) {
    const b = POOL[m];
    const dias = b.dias.map(x => x.nombre).join(', ');
    const badge = b.sugerido
      ? `<span class="text-[11px] px-2 py-0.5 rounded-full bg-sky-500/15 text-sky-400 whitespace-nowrap">${b.zona} · ${b.km} km</span>`
      : `<span class="text-[11px] px-2 py-0.5 rounded-full bg-telecab-gold/15 text-telecab-gold whitespace-nowrap">${b.zona}</span>`;
    const btn = modo === 'sel'
      ? `<button data-quitar="${m}" class="shrink-0 px-2.5 py-1.5 rounded-lg text-telecab-red hover:bg-telecab-red/10 border border-telecab-red/30 text-xs transition">Quitar</button>`
      : `<button data-agregar="${m}" class="shrink-0 px-2.5 py-1.5 rounded-lg text-telecab-green hover:bg-telecab-green/10 border border-telecab-green/30 text-xs transition">Agregar</button>`;
    return `<div class="flex items-center gap-3 px-3 py-2 rounded-xl bg-telecab-dark/40">
        <span class="w-8 h-8 rounded-lg bg-telecab-card2 text-telecab-text flex items-center justify-center shrink-0"><i class="fa-solid fa-car-side text-xs"></i></span>
        <span class="flex-1 min-w-0">
          <span class="block text-sm font-mono text-telecab-text">${m} <span class="text-telecab-muted font-sans text-xs">· fijo: ${b.fijo || '—'}</span></span>
          <span class="block text-xs text-telecab-muted">${dias}</span></span>
        ${badge}${btn}</div>`;
  }

  function renderResultado() {
    const cub = diasCubiertos();
    $('#res-titulo').textContent = `Vacante ${TURNO} · ${cub.size}/${OBJETIVO} días · zona ${ZONA}`;
    const est = $('#res-estado');
    if (cub.size >= OBJETIVO) { est.textContent = 'Completa'; est.className = 'text-xs px-2.5 py-1 rounded-full border border-telecab-green/40 text-telecab-green bg-telecab-green/10'; }
    else { est.textContent = `Faltan ${OBJETIVO - cub.size} días`; est.className = 'text-xs px-2.5 py-1 rounded-full border border-telecab-gold/40 text-telecab-gold bg-telecab-gold/10'; }

    $('#semana').innerHTML = [0, 1, 2, 3, 4, 5, 6].map(celdaDia).join('');
    $('#sel-bloques').innerHTML = [...SEL].map(m => filaBloque(m, 'sel')).join('') || '<p class="text-telecab-muted text-sm">Ninguna matrícula.</p>';

    const comp = POOL_ARR
      .filter(m => !SEL.has(m) && POOL[m].dias.every(x => !cub.has(x.dia)))
      .sort((a, b) => {
        const A = POOL[a], B = POOL[b];
        if (A.sugerido !== B.sugerido) return A.sugerido ? 1 : -1;
        if (A.km !== B.km) return A.km - B.km;
        return B.dias.length - A.dias.length;
      });
    $('#compatibles').innerHTML = comp.map(m => filaBloque(m, 'comp')).join('') ||
      '<p class="text-telecab-muted text-sm">No hay más opciones compatibles (los huecos restantes chocan de día).</p>';
  }

  $('#resultado').addEventListener('click', e => {
    const a = e.target.closest('[data-agregar]'); if (a) { SEL.add(a.dataset.agregar); renderResultado(); return; }
    const q = e.target.closest('[data-quitar]'); if (q) { SEL.delete(q.dataset.quitar); renderResultado(); return; }
  });

  $('#btn-guardar-vac').addEventListener('click', async () => {
    const mv = $('#msg-vac');
    if (!SEL.size) { mv.textContent = 'La vacante no tiene matrículas.'; mv.className = 'text-xs mt-2 text-telecab-red'; return; }
    const matriculas = [...SEL].map(m => ({ matricula: m, zona: POOL[m].zona, dias: POOL[m].dias.map(x => x.dia), fijo: POOL[m].fijo }));
    const btn = $('#btn-guardar-vac'); btn.disabled = true;
    const r = await (await fetch('/generador/api/guardar', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ turno: TURNO, objetivo: OBJETIVO, matriculas })
    })).json();
    btn.disabled = false;
    if (r.status === 'ok') { mv.textContent = `Vacante guardada (${r.puesto} · ${r.zonas}) — ya la ve Selección.`; mv.className = 'text-xs mt-2 text-telecab-green'; }
    else { mv.textContent = r.msg || 'No se pudo guardar'; mv.className = 'text-xs mt-2 text-telecab-red'; }
    mv.classList.remove('hidden');
  });

  async function generar() {
    const zona = $('#sel-zona').value, matricula = $('#sel-matricula').value;
    if (!zona || !matricula) { msg('Elige zona y matrícula.', false); return; }
    $('#msg').classList.add('hidden');
    const btn = $('#btn-generar'); btn.disabled = true;
    const r = await (await fetch('/generador/api/generar', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ zona, turno: estado.turno, dias: estado.dias, matricula })
    })).json();
    btn.disabled = false;
    if (r.status !== 'ok') { msg(r.msg || 'No se pudo generar', false); return; }

    POOL = {}; POOL_ARR = [];
    (r.pool || []).forEach(b => { POOL[b.matricula] = b; POOL_ARR.push(b.matricula); });
    SEL = new Set((r.propuesta || []).filter(m => POOL[m]));
    OBJETIVO = r.objetivo; TURNO = r.turno; ZONA = r.zona;
    renderResultado();
    $('#resultado').classList.remove('hidden');
    $('#resultado').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }
  $('#btn-generar').addEventListener('click', generar);

  async function cargar() {
    const r = await (await fetch('/generador/api/datos')).json();
    if (r.status !== 'ok') return;
    DATOS = r;
    $('#sel-zona').innerHTML = '<option value="">— elige zona —</option>' +
      DATOS.zonas.map(z => `<option value="${z.zona}">${z.zona}</option>`).join('');
    pintarToggle('tg-turno', estado.turno);
    pintarToggle('tg-dias', estado.dias);
  }
  cargar();
</script>
