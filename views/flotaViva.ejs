<style>
  .fv-fila { transition: background .12s; cursor: pointer; }
  .fv-fila:hover { background: rgba(148,163,184,.08); }
  .fv-punto { width: 7px; height: 7px; border-radius: 999px; display: inline-block; }
  .fv-barra { height: 4px; border-radius: 999px; background: currentColor; opacity: .35; }
  .fv-tab { border-bottom: 2px solid transparent; }
  .fv-tab.on { border-bottom-color: currentColor; }
  .fv-cab { cursor: pointer; user-select: none; white-space: nowrap; }
  .fv-cab:hover { color: rgb(var(--tc-text)); }
  #fv-panel { transition: transform .18s ease-out; }
</style>

<div class="max-w-[1600px] mx-auto">

  <div class="flex flex-wrap items-end justify-between gap-3 mb-4">
    <div>
      <h1 class="text-2xl font-bold text-telecab-text flex items-center gap-2">
        <span class="latido"></span> Flota viva
      </h1>
      <p class="text-sm text-telecab-muted mt-1">
        BOLT dice quién y en qué. Mapon dice cuánto ha rodado. Cada 5 minutos.
      </p>
    </div>
    <div class="flex items-center gap-2">
      <span id="fv-reloj" class="text-xs text-telecab-muted"></span>
      <button id="fv-refrescar"
        class="px-4 py-2 rounded-lg bg-telecab-gold/15 text-telecab-gold font-medium hover:bg-telecab-gold/25">
        <i class="fa-solid fa-rotate mr-1"></i> Refrescar
      </button>
    </div>
  </div>

  <div id="fv-aviso" class="hidden mb-4"></div>

  <!-- Pestañas: cada una es un filtro, y el número se ve sin abrirla -->
  <div id="fv-tabs" class="flex flex-wrap items-center gap-x-1 gap-y-1 border-b border-telecab-border mb-3"></div>

  <div class="flex flex-wrap items-center gap-2 mb-3">
    <div class="relative flex-1 min-w-[16rem] max-w-sm">
      <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-xs text-telecab-muted"></i>
      <input id="fv-busca" placeholder="Matrícula, conductor o teléfono…"
        class="w-full pl-8 pr-3 py-2 rounded-xl bg-telecab-card border border-telecab-border text-sm
               text-telecab-text focus:outline-none focus:border-telecab-gold/50">
    </div>
    <label class="flex items-center gap-2 text-sm text-telecab-muted cursor-pointer px-2">
      <input type="checkbox" id="fv-solo-km" class="accent-current">
      Solo los que han rodado
    </label>
  </div>

  <div class="rounded-2xl border border-telecab-border bg-telecab-card overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-telecab-card2 text-telecab-muted text-xs uppercase tracking-wide">
        <tr>
          <th class="fv-cab text-left px-4 py-2.5"  data-orden="matricula">Matrícula</th>
          <th class="fv-cab text-left px-3 py-2.5"  data-orden="situacion">Estado</th>
          <th class="fv-cab text-left px-3 py-2.5"  data-orden="conductor">Conductor</th>
          <th class="text-left px-3 py-2.5">Teléfono</th>
          <th class="fv-cab text-right px-3 py-2.5" data-orden="segundos">Lleva</th>
          <th class="fv-cab text-right px-4 py-2.5" data-orden="km">Km</th>
        </tr>
      </thead>
      <tbody id="fv-cuerpo"></tbody>
    </table>
    <div id="fv-vacio" class="hidden px-4 py-10 text-center text-sm text-telecab-muted"></div>
  </div>
</div>

<!-- Ficha del coche: se abre al pulsar una fila -->
<div id="fv-fondo" class="hidden fixed inset-0 bg-black/40 z-40"></div>
<aside id="fv-panel" class="fixed top-0 right-0 h-full w-full max-w-xl bg-telecab-dark border-l border-telecab-border
       z-50 overflow-y-auto translate-x-full shadow-2xl">
  <div class="sticky top-0 z-10 bg-telecab-dark border-b border-telecab-border px-5 py-4 flex items-center justify-between">
    <div>
      <h2 id="fv-p-mat" class="text-xl font-bold font-mono text-telecab-text"></h2>
      <p id="fv-p-sub" class="text-sm text-telecab-muted mt-0.5"></p>
    </div>
    <button id="fv-cerrar" class="w-9 h-9 rounded-lg text-telecab-muted hover:bg-telecab-card2">
      <i class="fa-solid fa-xmark"></i>
    </button>
  </div>
  <div id="fv-p-cuerpo" class="p-5"></div>
</aside>

<script>
(function () {
  const $ = s => document.querySelector(s);
  const esc = s => (s == null ? '' : String(s)).replace(/[&<>"]/g,
    m => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[m]));

  let T = null;               // lo último que trajo el servidor
  let TAB = 'todos';
  let ORDEN = { campo: 'segundos', desc: true };

  // Los colores de cada situación, en un sitio. La pantalla no decide nada:
  // el color viene de la base, y esto solo lo traduce a clases.
  const TONO = {
    viaje: 'text-emerald-500', espera: 'text-amber-500', descanso: 'text-orange-500',
    desconectado: 'text-slate-400', otro: 'text-red-500',
  };
  const tono = s => TONO[s] || 'text-slate-400';

  /**
   * El tiempo se calcula AQUÍ, a partir de `desde`.
   *
   * El servidor manda un número de segundos que se queda congelado hasta la
   * siguiente vuelta: un coche "17 min" seguía diciendo 17 min cinco minutos
   * después. Calculándolo del momento de inicio, el contador corre solo.
   */
  function hace(desde) {
    if (!desde) return { seg: 0, txt: '' };
    const seg = Math.max(0, Math.floor((Date.now() - new Date(desde)) / 1000));
    const d = Math.floor(seg / 86400), h = Math.floor((seg % 86400) / 3600), m = Math.floor((seg % 3600) / 60);
    const txt = d ? d + ' d ' + h + ' h'
      : h ? h + ' h ' + String(m).padStart(2, '0') + ' min'
        : m + ' min';
    return { seg, txt };
  }

  const todas = () => !T ? [] : [].concat(T.conectados, T.recienCaidos, T.parados);

  // Rodar estando en descanso o desconectado es lo que se viene a buscar aquí.
  const sospechoso = c => (c.km > 0) && (c.situacion === 'descanso' || c.situacion === 'desconectado');

  const TABS = [
    { id: 'todos',        texto: 'Todos',         pasa: () => true },
    { id: 'viaje',        texto: 'En viaje',      pasa: c => c.situacion === 'viaje' },
    { id: 'espera',       texto: 'En espera',     pasa: c => c.situacion === 'espera' },
    { id: 'descanso',     texto: 'En descanso',   pasa: c => c.situacion === 'descanso' },
    { id: 'desconectado', texto: 'Desconectados', pasa: c => c.situacion === 'desconectado' },
    // La pestaña de la auditoría. Va al final y aparte porque no es un estado:
    // es una pregunta.
    { id: 'rodando',      texto: 'Rodando sin trabajar', pasa: sospechoso, alerta: true },
  ];

  function pintarTabs() {
    const lista = todas();
    $('#fv-tabs').innerHTML = TABS.map(t => {
      const n = lista.filter(t.pasa).length;
      if (t.alerta && !n) return '';       // sin sospechas, no se enseña la pestaña
      const activa = TAB === t.id;
      const color = t.alerta ? 'text-red-500' : (TONO[t.id] || 'text-telecab-text');
      return '<button data-tab="' + t.id + '" class="fv-tab ' + (activa ? 'on ' : '') +
        'px-3 py-2 text-sm font-medium ' + (activa ? color : 'text-telecab-muted hover:text-telecab-text') + '">' +
        esc(t.texto) + ' <span class="ml-1 tabular-nums ' + (activa ? '' : 'opacity-70') + '">' + n + '</span></button>';
    }).join('');
    $('#fv-tabs').querySelectorAll('[data-tab]').forEach(b =>
      b.addEventListener('click', () => { TAB = b.dataset.tab; pintar(); }));
  }

  function visibles() {
    const t = TABS.find(x => x.id === TAB) || TABS[0];
    const q = ($('#fv-busca').value || '').toLowerCase().trim();
    const soloKm = $('#fv-solo-km').checked;
    let filas = todas().filter(t.pasa);
    if (soloKm) filas = filas.filter(c => c.km > 0);
    if (q) {
      filas = filas.filter(c => [c.matricula, c.conductor, c.ultimoConductor, c.telefono, c.ultimoTelefono]
        .filter(Boolean).some(v => String(v).toLowerCase().includes(q)));
    }
    const s = ORDEN.desc ? -1 : 1;
    return filas.sort((a, b) => {
      const va = ORDEN.campo === 'segundos' ? hace(a.desde).seg : (a[ORDEN.campo] ?? '');
      const vb = ORDEN.campo === 'segundos' ? hace(b.desde).seg : (b[ORDEN.campo] ?? '');
      if (typeof va === 'number' && typeof vb === 'number') return (va - vb) * s;
      return String(va).localeCompare(String(vb)) * s;
    });
  }

  function fila(c, maxKm) {
    const t = hace(c.desde);
    const mal = sospechoso(c);
    const quien = c.conductor || c.ultimoConductor || '';
    const telefono = c.telefono || c.ultimoTelefono || '';
    const ultimo = !c.conductor && c.ultimoConductor;
    const ancho = maxKm > 0 && c.km > 0 ? Math.max(4, Math.round((c.km / maxKm) * 100)) : 0;

    return '<tr class="fv-fila border-t border-telecab-border" data-mat="' + esc(c.matricula) + '">' +
      '<td class="px-4 py-2.5 font-mono font-semibold text-telecab-text">' + esc(c.matricula) + '</td>' +
      '<td class="px-3 py-2.5 whitespace-nowrap ' + tono(c.situacion) + '">' +
        '<span class="fv-punto bg-current mr-1.5 align-middle"></span>' +
        '<span class="align-middle text-[13px]">' + esc(c.etiqueta || '—') + '</span>' +
        (c.situacion === 'otro' && c.estadoBolt
          ? ' <span class="text-[11px] opacity-80" title="BOLT manda un estado que no sabemos traducir">'
            + esc(c.estadoBolt) + '</span>' : '') +
      '</td>' +
      '<td class="px-3 py-2.5 text-telecab-text">' +
        (quien ? (ultimo ? '<span class="text-telecab-muted text-[12px] mr-1">último:</span>' : '') + esc(quien)
               : '<span class="text-telecab-muted">—</span>') + '</td>' +
      '<td class="px-3 py-2.5">' + (telefono
        ? '<a href="tel:' + esc(String(telefono).replace(/[^\d+]/g, '')) + '" class="text-telecab-gold hover:underline">'
          + esc(telefono) + '</a>'
        : '<span class="text-telecab-muted">—</span>') + '</td>' +
      '<td class="px-3 py-2.5 text-right tabular-nums text-telecab-muted whitespace-nowrap">' + esc(t.txt) + '</td>' +
      // Los km con barra: el número dice cuánto, la barra dice cuánto COMPARADO
      // con el resto, que es lo que hace saltar a la vista al que se pasa.
      '<td class="px-4 py-2.5 text-right ' + (mal ? 'text-red-500 font-semibold' : 'text-telecab-muted') + '">' +
        (c.km > 0
          ? '<div class="flex items-center justify-end gap-2">' +
              '<div class="fv-barra" style="width:' + ancho + 'px"></div>' +
              '<span class="tabular-nums">' + c.km + '</span>' +
              (c.kmDudoso ? '<span class="text-amber-500" title="Se descartó algún salto de odómetro imposible: puede quedarse corto">~</span>' : '') +
            '</div>'
          : '<span class="opacity-40">—</span>') +
      '</td></tr>';
  }

  function pintar() {
    if (!T) return;
    pintarTabs();
    const filas = visibles();
    const maxKm = Math.max(0, ...filas.map(c => c.km || 0));
    $('#fv-cuerpo').innerHTML = filas.map(c => fila(c, maxKm)).join('');
    $('#fv-vacio').classList.toggle('hidden', filas.length > 0);
    $('#fv-vacio').textContent = 'Nada que enseñar con este filtro.';

    document.querySelectorAll('.fv-cab').forEach(th => {
      const suyo = th.dataset.orden === ORDEN.campo;
      th.classList.toggle('text-telecab-text', suyo);
      th.innerHTML = th.innerHTML.replace(/ ?[▲▼]$/, '') + (suyo ? (ORDEN.desc ? ' ▼' : ' ▲') : '');
    });
    document.querySelectorAll('.fv-fila').forEach(tr =>
      tr.addEventListener('click', () => abrirFicha(tr.dataset.mat)));

    const v = T.ultimaVuelta;
    $('#fv-reloj').textContent = v && v.arrancada_at
      ? 'Última vuelta: ' + new Date(v.arrancada_at).toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' })
      : '';
    const av = $('#fv-aviso');
    if (v && v.error) {
      av.className = 'mb-4 px-3 py-2 rounded-xl border border-red-500/40 bg-red-500/10 text-sm text-red-500';
      av.textContent = 'La última vuelta falló: ' + v.error;
    } else av.className = 'hidden';
  }

  // ── La ficha del coche ──────────────────────────────────────────────────
  // Es donde se audita de verdad: el panel dice "3 km en descanso", y aquí se
  // ve de qué tramos salen y quién los hizo.

  function cerrarFicha() {
    $('#fv-panel').classList.add('translate-x-full');
    $('#fv-fondo').classList.add('hidden');
  }

  async function abrirFicha(mat) {
    const c = todas().find(x => x.matricula === mat);
    $('#fv-p-mat').textContent = mat;
    $('#fv-p-sub').textContent = c ? (c.etiqueta + ' · ' + hace(c.desde).txt) : '';
    $('#fv-p-cuerpo').innerHTML = '<p class="text-sm text-telecab-muted">Buscando su historial…</p>';
    $('#fv-fondo').classList.remove('hidden');
    $('#fv-panel').classList.remove('translate-x-full');

    try {
      const r = await fetch('/flota-viva/api/historial/' + encodeURIComponent(mat) + '?dias=2');
      const d = await r.json();
      if (d.status !== 'ok') throw new Error(d.msg || 'No se pudo leer');
      const h = d.historial || [];
      if (!h.length) {
        $('#fv-p-cuerpo').innerHTML = '<p class="text-sm text-telecab-muted">Sin tramos en los últimos 2 días.</p>';
        return;
      }
      const total = h.filter(x => x.km).reduce((s, x) => s + x.km, 0);
      const sinTrabajar = h.filter(x => x.km && (x.situacion === 'descanso' || x.situacion === 'desconectado'))
        .reduce((s, x) => s + x.km, 0);

      $('#fv-p-cuerpo').innerHTML =
        '<div class="flex gap-4 mb-4 text-sm">' +
          '<div><div class="text-telecab-muted text-xs uppercase tracking-wide">Km en 2 días</div>' +
          '<div class="text-xl font-bold tabular-nums">' + Math.round(total * 10) / 10 + '</div></div>' +
          '<div><div class="text-telecab-muted text-xs uppercase tracking-wide">Sin estar trabajando</div>' +
          '<div class="text-xl font-bold tabular-nums ' + (sinTrabajar > 0 ? 'text-red-500' : '') + '">' +
          Math.round(sinTrabajar * 10) / 10 + '</div></div>' +
        '</div>' +
        '<div class="space-y-1.5">' + h.map(x => {
          const mal = x.km > 0 && (x.situacion === 'descanso' || x.situacion === 'desconectado');
          const ini = new Date(x.desde);
          return '<div class="flex items-center gap-3 px-3 py-2 rounded-lg border ' +
            (mal ? 'border-red-500/30 bg-red-500/5' : 'border-telecab-border') + '">' +
            '<span class="fv-punto bg-current ' + tono(x.situacion) + '"></span>' +
            '<span class="text-[13px] w-28 ' + tono(x.situacion) + '">' + esc(x.etiqueta) + '</span>' +
            '<span class="text-xs text-telecab-muted tabular-nums w-24">' +
              ini.toLocaleString('es-ES', { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' }) +
            '</span>' +
            '<span class="text-xs text-telecab-muted tabular-nums w-20">' + esc(x.duracion) + '</span>' +
            '<span class="flex-1 text-[13px] truncate">' + esc(x.conductor || '') + '</span>' +
            '<span class="tabular-nums text-sm ' + (mal ? 'text-red-500 font-semibold' : 'text-telecab-muted') + '">' +
              (x.km ? x.km + ' km' : '') + '</span></div>';
        }).join('') + '</div>';
    } catch (e) {
      $('#fv-p-cuerpo').innerHTML = '<p class="text-sm text-red-500">' + esc(e.message) + '</p>';
    }
  }

  // ── Traer datos ─────────────────────────────────────────────────────────

  async function cargar(forzar) {
    const b = $('#fv-refrescar');
    if (forzar) { b.disabled = true; b.innerHTML = '<i class="fa-solid fa-spinner fa-spin mr-1"></i> Mirando…'; }
    try {
      const r = await fetch('/flota-viva/api/' + (forzar ? 'refrescar' : 'estado'),
        forzar ? { method: 'POST' } : undefined);
      const d = await r.json();
      if (d.status !== 'ok') throw new Error(d.msg || 'No se pudo leer');
      T = d;
      pintar();
    } catch (e) {
      const av = $('#fv-aviso');
      av.className = 'mb-4 px-3 py-2 rounded-xl border border-red-500/40 bg-red-500/10 text-sm text-red-500';
      av.textContent = e.message;
    }
    b.disabled = false;
    b.innerHTML = '<i class="fa-solid fa-rotate mr-1"></i> Refrescar';
  }

  $('#fv-refrescar').addEventListener('click', () => cargar(true));
  $('#fv-busca').addEventListener('input', pintar);
  $('#fv-solo-km').addEventListener('change', pintar);
  $('#fv-cerrar').addEventListener('click', cerrarFicha);
  $('#fv-fondo').addEventListener('click', cerrarFicha);
  document.addEventListener('keydown', e => { if (e.key === 'Escape') cerrarFicha(); });

  document.querySelectorAll('.fv-cab').forEach(th => th.addEventListener('click', () => {
    const campo = th.dataset.orden;
    ORDEN = { campo, desc: ORDEN.campo === campo ? !ORDEN.desc : true };
    pintar();
  }));

  // Los contadores corren solos cada 15 s sin pedir nada al servidor; los datos
  // se refrescan cada minuto. Mirar la pantalla no gasta cuota de BOLT.
  setInterval(pintar, 15000);
  setInterval(() => cargar(false), 60000);
  cargar(false);
})();
</script>
