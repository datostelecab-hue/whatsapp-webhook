             <p class="text-telecab-muted">El archivo NO se borra de Drive: solo deja de ser el vigente
             y desaparece de la ficha.</p>`,
    });
    if (!ok) return;
    await hacer(() => api(`/plantilla/api/documento/${doc.id}`, { method: 'DELETE' }));
  }

