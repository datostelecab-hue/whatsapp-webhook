<div class="p-4 lg:p-6 max-w-6xl mx-auto space-y-5">

  <!-- ══════════ VISTA TABLA (maestro) ══════════ -->
  <div id="vista-tabla" class="space-y-5">

    <!-- Contadores -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
      <div class="bg-telecab-card border border-telecab-border rounded-2xl px-4 py-3">
        <p class="text-[11px] uppercase tracking-wide text-telecab-muted">Excels de altas</p>
        <p id="c-excels" class="text-2xl font-bold text-telecab-gold">–</p>
      </div>
      <div class="bg-telecab-card border border-telecab-border rounded-2xl px-4 py-3">
        <p class="text-[11px] uppercase tracking-wide text-telecab-muted">Fichas en altas</p>
        <p id="c-altas" class="text-2xl font-bold text-telecab-text">–</p>
      </div>
      <div class="bg-telecab-card border border-telecab-border rounded-2xl px-4 py-3">
        <p class="text-[11px] uppercase tracking-wide text-telecab-muted">Plantilla activa</p>
        <p id="c-activos" class="text-2xl font-bold text-telecab-green">–</p>
      </div>
      <div class="bg-telecab-card border border-telecab-border rounded-2xl px-4 py-3">
        <p class="text-[11px] uppercase tracking-wide text-telecab-muted">Bajas</p>
        <p id="c-bajas" class="text-2xl font-bold text-telecab-red">–</p>
      </div>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-2">
      <!-- Pestañas -->
      <div class="flex gap-1 bg-telecab-card border border-telecab-border rounded-2xl p-1">
        <button data-tab="activos" class="tab-btn px-3 py-2 rounded-xl text-sm font-medium transition"><i class="fa-solid fa-users mr-1.5"></i>Activos</button>
        <button data-tab="bajas"   class="tab-btn px-3 py-2 rounded-xl text-sm font-medium transition"><i class="fa-solid fa-user-slash mr-1.5"></i>Bajas</button>
        <button data-tab="altas"   class="tab-btn px-3 py-2 rounded-xl text-sm font-medium transition"><i class="fa-solid fa-file-excel mr-1.5"></i>Altas por Excel</button>
      </div>
      <button id="crear-todas" class="text-xs px-3 py-1.5 rounded-lg bg-telecab-gold/15 border border-telecab-gold/40 text-telecab-gold hover:bg-telecab-gold/25 transition font-medium">
        <i class="fa-solid fa-user-plus mr-1"></i> Crear fichas de todos
      </button>
    </div>
    <p id="crear-msg" class="text-xs hidden leading-snug"></p>

    <p id="cargando" class="text-telecab-muted text-sm">Cargando…</p>

    <div id="resumen-activos" class="tab-pane-activos flex flex-wrap gap-2 hidden"></div>
    <div id="pane-activos" class="tab-pane hidden"></div>
    <div id="pane-bajas"   class="tab-pane hidden"></div>
    <div id="pane-altas"   class="tab-pane space-y-3 hidden"></div>
  </div>

  <!-- ══════════ VISTA DETALLE (ficha de un conductor) ══════════ -->
  <div id="vista-detalle" class="hidden">
    <button id="volver" class="mb-4 inline-flex items-center gap-2 text-sm text-telecab-muted hover:text-telecab-gold transition">
      <i class="fa-solid fa-arrow-left"></i> Volver a la tabla
    </button>
    <div id="detalle"></div>
  </div>

</div>

<script>
  const $ = s => document.querySelector(s);
  const esc = s => (s == null ? '' : String(s)).replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
  let DATOS = null;
  let fichaActual = null;

  const badgeContrato = c => {
    const v = (c || '').trim();
    if (!v) return '<span class="text-xs px-2 py-0.5 rounded-lg bg-telecab-dark text-telecab-muted border border-telecab-border">sin contrato</span>';
    const ett = /ETT/i.test(v);
    return `<span class="text-xs px-2 py-0.5 rounded-lg border font-medium whitespace-nowrap ${ett ? 'bg-amber-500/15 text-amber-400 border-amber-500/40' : 'bg-telecab-gold/10 text-telecab-gold border-telecab-gold/30'}">${esc(v)}</span>`;
  };

  // ═══════════ DETALLE: ficha editable (datos + documentos + estado + PDF) ═══════════
  const GRUPOS = [
    { g: 'Datos personales', campos: [['nombre','Nombre'],['apellidos','Apellidos'],['dni','DNI / NIE'],['nacionalidad','Nacionalidad'],['fecha_nacimiento','Fecha de nacimiento'],['estado_civil','Estado civil'],['num_hijos','Nº de hijos']] },
    { g: 'Contacto', campos: [['email','Correo'],['id','Teléfono'],['contacto_emergencia','Contacto de emergencia'],['direccion','Dirección'],['codigo_postal','Código postal'],['localidad','Localidad'],['provincia','Provincia']] },
    { g: 'Datos laborales', campos: [['num_seg_social','Nº Seguridad Social'],['tipo_carnet','Tipo de carnet'],['carnet_expedicion','Carnet · expedición'],['carnet_caducidad','Carnet · caducidad'],['fecha_inicio','Fecha de inicio'],['jornada','Jornada'],['tipo_contrato','Tipo de contrato'],['turno','Turno'],['canal','Canal / origen'],['iban','IBAN / cuenta']] },
    { g: 'Proceso', campos: [['estado','Estado (funnel)'],['etapa','Etapa'],['excel_alta','Excel de alta'],['fecha_creacion','Creado'],['fecha_alta','Alta S. Social'],['fecha_habilitado','Habilitado desde'],['pin_ballenoil','PIN Ballenoil']] }
  ];
  const EDITABLES = new Set(['nombre','apellidos','dni','nacionalidad','fecha_nacimiento','estado_civil','num_hijos','email','contacto_emergencia','direccion','codigo_postal','localidad','provincia','num_seg_social','tipo_carnet','carnet_expedicion','carnet_caducidad','fecha_inicio','jornada','tipo_contrato','turno','canal','iban']);
  const FECHAS = { fecha_nacimiento: 'data-max="today"', carnet_expedicion: 'data-max="today"', carnet_caducidad: 'data-min="today"', fecha_inicio: '' };
  const SELECTS = { jornada: ['40 HORAS','32 HORAS'], turno: ['','Día','Noche','TodoTurno'] };
  const INP = 'w-full text-sm bg-telecab-dark border border-telecab-border rounded-lg px-2 py-1.5 text-telecab-text focus:outline-none focus:border-telecab-gold transition';
  const ESTADOS_OP = ['Activo','Pendiente Asignar','Suspendido','Baja Empresa'];
  const nombreDe = f => `${f.nombre || ''}${f.apellidos ? ' ' + f.apellidos : ''}`.trim() || '(sin nombre)';

  function control(k, val) {
    const v = esc(val || '');
    if (k in FECHAS) return `<input data-edit="${k}" value="${v}" placeholder="dd/mm/aaaa" readonly ${FECHAS[k]} class="js-fecha ${INP}">`;
    if (SELECTS[k]) return `<select data-edit="${k}" class="${INP}">${SELECTS[k].map(o => `<option value="${esc(o)}" ${String(val || '') === o ? 'selected' : ''}>${o || '—'}</option>`).join('')}</select>`;
    return `<input data-edit="${k}" value="${v}" placeholder="—" class="${INP}">`;
  }
  function campoHTML(f, k, etq) {
    const editable = EDITABLES.has(k);
    const v = (f[k] == null ? '' : String(f[k])).trim();
    const valor = editable ? control(k, f[k]) : `<dd class="text-sm ${v ? 'text-telecab-text' : 'text-telecab-muted/50'} break-words">${v ? esc(v) : '—'}</dd>`;
    return `<div><dt class="text-[11px] uppercase tracking-wide text-telecab-muted mb-0.5">${esc(etq)}</dt>${valor}</div>`;
  }
  function docHTML(d) {
    if (d.link) return `<a href="${esc(d.link)}" target="_blank" rel="noopener" class="flex items-center gap-2.5 px-3 py-2.5 rounded-xl bg-telecab-dark/40 border border-telecab-border hover:border-telecab-gold transition">
        <i class="fa-solid fa-file-lines text-telecab-green shrink-0"></i>
        <span class="min-w-0 flex-1 text-sm text-telecab-text truncate">${esc(d.label)}</span>
        <span class="text-[11px] text-telecab-gold shrink-0">Abrir</span></a>`;
    return `<div class="flex items-center gap-2.5 px-3 py-2.5 rounded-xl bg-telecab-dark/20 border border-dashed border-telecab-border/60">
        <i class="fa-regular fa-file text-telecab-muted/60 shrink-0"></i>
        <span class="min-w-0 flex-1 text-sm text-telecab-muted truncate">${esc(d.label)}</span>
        <span class="text-[11px] text-amber-400 shrink-0">falta</span></div>`;
  }
  function estadoOpHTML(f) {
    if (!f.id_bolt) return '';
    const actual = f.estado_agenda || '';
    return `<div class="bg-telecab-card border border-telecab-border rounded-2xl p-4 mb-4">
        <div class="flex flex-wrap items-center gap-2">
          <span class="text-xs uppercase tracking-wide text-telecab-gold font-semibold">Estado operativo</span>
          <span class="text-sm text-telecab-text">${esc(actual || '—')}</span>
          ${f.en_agenda ? `<select id="d-estado" class="ml-auto text-sm bg-telecab-dark border border-telecab-border rounded-lg px-2 py-1.5 text-telecab-text">${ESTADOS_OP.map(o => `<option value="${o}" ${o === actual ? 'selected' : ''}>${o}</option>`).join('')}</select>
            <button id="d-estado-btn" class="text-sm px-3 py-1.5 rounded-lg bg-telecab-card2 border border-telecab-border text-telecab-text hover:border-telecab-gold transition">Cambiar</button>`
          : '<span class="ml-auto text-[11px] text-telecab-muted">Archivado (baja). Reingreso desde Peticiones.</span>'}
        </div>
        <p class="text-[11px] text-telecab-muted mt-1.5">Para Vacaciones / Baja Médica / Permiso usa <b>Peticiones</b> (llevan fechas y bitácora).</p>
      </div>`;
  }
  const recogerEdits = () => { const d = {}; document.querySelectorAll('#detalle [data-edit]').forEach(el => { d[el.dataset.edit] = (el.value || '').trim(); }); return d; };
  function avisoD(t, cls) { const m = $('#d-msg'); if (!m) return; m.textContent = t; m.className = 'text-xs ' + cls; m.classList.remove('hidden'); }
  async function guardarEdits(f) {
    const edits = recogerEdits();
    const r = await (await fetch('/seleccion/ticket', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ tel: f.id, ...edits }) })).json();
    if (r && r.status === 'ok') Object.assign(f, edits);
    return r;
  }
  async function guardarFicha(f) {
    avisoD('Guardando…', 'text-telecab-muted');
    try { const r = await guardarEdits(f); if (r.status !== 'ok') throw new Error(r.msg || 'error'); avisoD('Cambios guardados.', 'text-telecab-green'); }
    catch (e) { avisoD('No se pudo guardar: ' + e.message, 'text-telecab-red'); }
  }
  async function regenerarFicha(f) {
    avisoD('Guardando y regenerando…', 'text-telecab-muted');
    try {
      const g = await guardarEdits(f); if (g.status !== 'ok') throw new Error(g.msg || 'error');
      const r = await (await fetch('/seleccion/ficha', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ tel: f.id }) })).json();
      if (r.status !== 'ok') throw new Error(r.msg || 'error');
      f.ficha_pdf_link = (r.ficha && r.ficha.link) || r.link || f.ficha_pdf_link;
      avisoD('FICHA regenerada.', 'text-telecab-green');
      if (r.link) window.open(r.link, '_blank');
      pintarDetalle(f);
    } catch (e) { avisoD('No se pudo: ' + e.message, 'text-telecab-red'); }
  }
  async function cambiarEstadoFicha(f) {
    const estado = $('#d-estado').value;
    if (!confirm(`¿Cambiar el estado operativo de ${nombreDe(f)} a "${estado}"?` + (estado === 'Baja Empresa' ? ' (se archiva en bajas)' : ''))) return;
    avisoD('Cambiando estado…', 'text-telecab-muted');
    try {
      const r = await (await fetch('/fichas/estado', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ idBolt: f.id_bolt, estado }) })).json();
      if (r.status !== 'ok') throw new Error(r.msg || 'error');
      f.estado_agenda = estado; if (estado === 'Baja Empresa') f.en_agenda = false;
      avisoD('Estado cambiado a ' + estado + '.', 'text-telecab-green');
      pintarDetalle(f); cargar();   // refresca también la tabla
    } catch (e) { avisoD('No se pudo cambiar: ' + e.message, 'text-telecab-red'); }
  }

  function pintarDetalle(f) {
    const estadoBadge = f.completa
      ? '<span class="text-xs px-2.5 py-1 rounded-full bg-telecab-green/10 text-telecab-green border border-telecab-green/30"><i class="fa-solid fa-circle-check mr-1"></i>Ficha completa</span>'
      : `<span class="text-xs px-2.5 py-1 rounded-full bg-amber-500/10 text-amber-400 border border-amber-500/30" title="Falta: ${esc((f.faltan || []).join(', '))}"><i class="fa-solid fa-triangle-exclamation mr-1"></i>Faltan ${(f.faltan || []).length}</span>`;
    const grupos = GRUPOS.map(gr => `
      <div class="bg-telecab-card border border-telecab-border rounded-2xl p-4">
        <h3 class="text-xs font-semibold uppercase tracking-wide text-telecab-gold mb-3">${esc(gr.g)}</h3>
        <dl class="grid sm:grid-cols-2 gap-x-5 gap-y-3">${gr.campos.map(([k, etq]) => campoHTML(f, k, etq)).join('')}</dl>
      </div>`).join('');
    const docsPresentes = (f.documentos || []).filter(d => d.link).length;
    const documentos = `
      <div class="bg-telecab-card border border-telecab-border rounded-2xl p-4">
        <div class="flex items-center justify-between mb-3">
          <h3 class="text-xs font-semibold uppercase tracking-wide text-telecab-gold">Documentos</h3>
          <span class="text-[11px] text-telecab-muted">${docsPresentes}/${(f.documentos || []).length}</span>
        </div>
        <div class="grid sm:grid-cols-2 gap-2">${(f.documentos || []).map(docHTML).join('')}</div>
        ${f.ficha_pdf_link ? `<a href="${esc(f.ficha_pdf_link)}" target="_blank" rel="noopener" class="mt-3 inline-flex items-center gap-2 text-sm text-telecab-gold hover:underline"><i class="fa-solid fa-file-pdf"></i> Abrir FICHA DE ALTA (PDF)</a>` : ''}
      </div>`;

    $('#detalle').innerHTML =
      `<div class="mb-4">
         <div class="flex items-start justify-between gap-3 flex-wrap">
           <h2 class="text-2xl font-bold text-telecab-text">${esc(f.id_bolt || nombreDe(f))}</h2>
           ${estadoBadge}
         </div>
         <p class="text-sm text-telecab-muted mt-1">${esc(nombreDe(f))} <span class="font-mono">· ${esc(f.dni || '')}${f.dni && f.id ? ' · ' : ''}${esc(f.id || '')}</span></p>
       </div>
       ${estadoOpHTML(f)}
       <div class="flex flex-wrap items-center gap-2 mb-4">
         <button id="d-guardar" class="px-3 py-1.5 rounded-lg bg-telecab-gold/15 border border-telecab-gold/40 text-telecab-gold hover:bg-telecab-gold/25 transition text-sm font-medium"><i class="fa-solid fa-floppy-disk mr-1"></i> Guardar cambios</button>
         <button id="d-regenerar" class="px-3 py-1.5 rounded-lg bg-telecab-green/15 border border-telecab-green/40 text-telecab-green hover:bg-telecab-green/25 transition text-sm font-medium"><i class="fa-solid fa-arrows-rotate mr-1"></i> Regenerar PDF</button>
         <span id="d-msg" class="text-xs hidden"></span>
       </div>
       <div class="space-y-4">${grupos}${documentos}</div>`;

    $('#d-guardar').addEventListener('click', () => guardarFicha(f));
    $('#d-regenerar').addEventListener('click', () => regenerarFicha(f));
    const eb = $('#d-estado-btn'); if (eb) eb.addEventListener('click', () => cambiarEstadoFicha(f));
  }

  // Abre el detalle de un conductor: asegura su ficha (la crea si no hay) y la carga.
  async function abrirDetalle(idBolt) {
    if (!idBolt) return;
    try {
      const r = await (await fetch('/fichas/asegurar', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ idBolt }) })).json();
      if (r.status !== 'ok') return alert(r.msg || 'No se pudo abrir la ficha');
      if (r.sinTelefono) return alert(r.msg || 'El conductor no tiene teléfono; ponlo primero para crear su ficha.');
      const fr = await (await fetch('/fichas/api/ficha/' + encodeURIComponent(r.tel))).json();
      if (fr.status !== 'ok') return alert(fr.msg || 'No se pudo cargar la ficha');
      fichaActual = fr.ficha;
      pintarDetalle(fichaActual);
      $('#vista-tabla').classList.add('hidden');
      $('#vista-detalle').classList.remove('hidden');
      window.scrollTo(0, 0);
    } catch (e) { alert('No se pudo abrir la ficha: ' + e.message); }
  }
  $('#volver').addEventListener('click', () => {
    $('#vista-detalle').classList.add('hidden');
    $('#vista-tabla').classList.remove('hidden');
    fichaActual = null;
  });

  // ═══════════ TABLA (maestro) con filtros por columna + export ═══════════
  const COLS_ACTIVOS = [
    { key: 'nombreSS', label: 'SS (Seg. Social)', tipo: 'text', link: true },
    { key: 'id', label: 'ID_BOLT', tipo: 'text', link: true },
    { key: 'estado', label: 'Estado', tipo: 'select' },
    { key: 'ett', label: 'ALTA', tipo: 'select', fmt: v => v ? 'ETT' : 'Tibus' },
    { key: 'contrato', label: 'Contrato', tipo: 'select' },
    { key: 'libranzas', label: 'Libranzas', tipo: 'text' },
    { key: 'zona', label: 'Zona', tipo: 'select' }
  ];
  const COLS_BAJAS = [
    { key: 'nombreSS', label: 'SS (Seg. Social)', tipo: 'text', link: true },
    { key: 'id', label: 'ID_BOLT', tipo: 'text', link: true },
    { key: 'estado', label: 'Estado', tipo: 'select' },
    { key: 'ett', label: 'ALTA', tipo: 'select', fmt: v => v ? 'ETT' : 'Tibus' },
    { key: 'contrato', label: 'Contrato', tipo: 'select' },
    { key: 'fechaBaja', label: 'F. baja', tipo: 'text' }
  ];

  function construirTabla(paneSel, cols, filas, cfg) {
    const pane = $(paneSel);
    const filtros = {};
    const celda = (f, k) => { const c = cols.find(x => x.key === k); const v = f[k]; return String(c && c.fmt ? c.fmt(v, f) : (v == null ? '' : v)); };
    const unicos = k => [...new Set(filas.map(f => celda(f, k)).filter(v => v.trim()))].sort((a, b) => a.localeCompare(b, 'es'));
    const pasa = f => cols.every(c => {
      const val = String(filtros[c.key] || '').trim().toLowerCase();
      if (!val) return true;
      const cell = celda(f, c.key).toLowerCase();
      return c.tipo === 'select' ? cell === val : cell.includes(val);
    });

    const ths = cols.map(c => `<th class="px-3 py-2 text-left text-[11px] uppercase tracking-wide text-telecab-muted font-semibold whitespace-nowrap">${esc(c.label)}</th>`).join('');
    const filtroCells = cols.map(c => c.tipo === 'select'
      ? `<th class="px-2 py-1"><select data-filtro="${c.key}" class="w-full text-xs bg-telecab-dark border border-telecab-border rounded px-1.5 py-1 text-telecab-text"><option value="">Todos</option>${unicos(c.key).map(v => `<option value="${esc(v)}">${esc(v)}</option>`).join('')}</select></th>`
      : `<th class="px-2 py-1"><input data-filtro="${c.key}" placeholder="filtrar" class="w-full text-xs bg-telecab-dark border border-telecab-border rounded px-1.5 py-1 text-telecab-text"></th>`).join('');

    pane.innerHTML =
      `<div class="flex items-center justify-between gap-2 mb-2 flex-wrap">
         <span data-count class="text-xs text-telecab-muted"></span>
         <button data-export class="text-xs px-3 py-1.5 rounded-lg bg-telecab-gold/15 border border-telecab-gold/40 text-telecab-gold hover:bg-telecab-gold/25 transition font-medium"><i class="fa-solid fa-file-excel mr-1"></i> Exportar a Excel (con filtros)</button>
       </div>
       <div class="bg-telecab-card border border-telecab-border rounded-2xl overflow-x-auto">
         <table class="w-full text-sm">
           <thead><tr class="border-b border-telecab-border">${ths}</tr><tr class="bg-telecab-dark/30">${filtroCells}</tr></thead>
           <tbody data-body></tbody>
         </table>
       </div>`;
    const tbody = pane.querySelector('[data-body]');
    function render() {
      const vis = filas.filter(pasa);
      tbody.innerHTML = vis.length ? vis.map(f => `<tr class="border-t border-telecab-border/30 hover:bg-telecab-dark/30">${cols.map(c => {
        const txt = esc(celda(f, c.key));
        if (c.link) return `<td class="px-3 py-2"><button data-idbolt="${esc(f.id || '')}" class="text-telecab-gold hover:underline text-left font-medium">${txt || '—'}</button></td>`;
        return `<td class="px-3 py-2 text-telecab-text whitespace-nowrap">${txt || '<span class="text-telecab-muted/40">—</span>'}</td>`;
      }).join('')}</tr>`).join('') : `<tr><td colspan="${cols.length}" class="px-3 py-8 text-center text-telecab-muted">Sin resultados.</td></tr>`;
      pane.querySelector('[data-count]').textContent = `${vis.length} de ${filas.length}`;
      tbody.querySelectorAll('[data-idbolt]').forEach(b => b.addEventListener('click', () => abrirDetalle(b.dataset.idbolt)));
    }
    pane.querySelectorAll('[data-filtro]').forEach(el => el.addEventListener('input', () => { filtros[el.dataset.filtro] = el.value; render(); }));
    pane.querySelector('[data-export]').addEventListener('click', () => exportarExcel(cfg.titulo, cols, filas.filter(pasa)));
    render();
  }

  async function exportarExcel(titulo, cols, filas) {
    const columnas = cols.map(c => ({ key: c.key, label: c.label }));
    const planas = filas.map(f => { const o = {}; cols.forEach(c => { const v = f[c.key]; o[c.key] = String(c.fmt ? c.fmt(v, f) : (v == null ? '' : v)); }); return o; });
    try {
      const r = await fetch('/plantilla/excel', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ titulo, columnas, filas: planas }) });
      if (!r.ok) throw new Error('error');
      const blob = await r.blob(); const url = URL.createObjectURL(blob);
      const a = document.createElement('a'); a.href = url; a.download = titulo.replace(/\s+/g, '_') + '.xlsx';
      document.body.appendChild(a); a.click(); a.remove(); URL.revokeObjectURL(url);
    } catch (e) { alert('No se pudo exportar el Excel.'); }
  }

  function pintarResumen(resumen, ettTotal) {
    const chips = $('#resumen-activos'); chips.innerHTML = '';
    const orden = ['40h', '32h', '40h ETT', '32h ETT'];
    Object.keys(resumen).sort((a, b) => { const ia = orden.indexOf(a), ib = orden.indexOf(b); return (ia === -1 ? 99 : ia) - (ib === -1 ? 99 : ib); }).forEach(k => {
      const ett = /ETT/i.test(k);
      const el = document.createElement('span');
      el.className = 'text-xs px-3 py-1.5 rounded-xl border ' + (ett ? 'bg-amber-500/15 text-amber-400 border-amber-500/40' : 'bg-telecab-card text-telecab-text border-telecab-border');
      el.innerHTML = `${esc(k)} · <b>${resumen[k]}</b>`;
      chips.appendChild(el);
    });
    if (ettTotal) { const el = document.createElement('span'); el.className = 'text-xs px-3 py-1.5 rounded-xl border bg-amber-500/10 text-amber-400 border-amber-500/40'; el.innerHTML = `<i class="fa-solid fa-triangle-exclamation mr-1"></i>ETT en total · <b>${ettTotal}</b>`; chips.appendChild(el); }
  }

  function pintarAltas(altas) {
    const cont = $('#pane-altas'); cont.innerHTML = '';
    if (!altas.length) { cont.innerHTML = '<p class="text-telecab-muted text-sm">Todavía no se ha generado ningún Excel de altas.</p>'; return; }
    altas.forEach(g => {
      const card = document.createElement('div');
      card.className = 'bg-telecab-card border border-telecab-border rounded-2xl p-4';
      const filas = g.fichas.map(f => `<div class="flex items-center gap-3 px-3 py-2 rounded-xl bg-telecab-dark/40">
          <span class="min-w-0 flex-1"><span class="block text-sm text-telecab-text truncate">${esc(f.nombre)}${f.apellidos ? ' ' + esc(f.apellidos) : ''}</span>
          <span class="block text-xs text-telecab-muted font-mono">${esc(f.id)}${f.dni ? ' · ' + esc(f.dni) : ''}${f.fecha_inicio ? ' · inicio ' + esc(f.fecha_inicio) : ''}</span></span>
          ${badgeContrato(f.contrato)}</div>`).join('');
      card.innerHTML = `<div class="flex items-center justify-between mb-3"><h3 class="text-sm font-semibold text-telecab-text flex items-center gap-2"><i class="fa-solid fa-file-excel text-telecab-gold"></i> Excel del ${esc(g.excel)}</h3><span class="text-xs text-telecab-muted">${g.total} ficha${g.total === 1 ? '' : 's'}</span></div><div class="space-y-1.5">${filas}</div>`;
      cont.appendChild(card);
    });
  }

  // ---- Pestañas ----
  function activar(tab) {
    document.querySelectorAll('.tab-btn').forEach(b => {
      const on = b.dataset.tab === tab;
      b.className = 'tab-btn px-3 py-2 rounded-xl text-sm font-medium transition ' + (on ? 'bg-telecab-gold/15 text-telecab-gold' : 'text-telecab-muted hover:text-telecab-text');
    });
    document.querySelectorAll('.tab-pane').forEach(p => p.classList.add('hidden'));
    $('#resumen-activos').classList.toggle('hidden', tab !== 'activos');
    $('#pane-' + tab).classList.remove('hidden');
    try { localStorage.setItem('telecab-plantilla-tab', tab); } catch (_) {}
  }
  document.querySelectorAll('.tab-btn').forEach(b => b.addEventListener('click', () => activar(b.dataset.tab)));

  async function cargar() {
    try {
      const r = await (await fetch('/plantilla/api/datos')).json();
      $('#cargando').classList.add('hidden');
      if (r.status !== 'ok') return;
      DATOS = r;
      $('#c-excels').textContent = r.contadores.excels;
      $('#c-altas').textContent = r.contadores.altas;
      $('#c-activos').textContent = r.agendaError ? '?' : r.contadores.activos;
      $('#c-bajas').textContent = r.contadores.bajas;
      pintarResumen(r.resumen || {}, r.ettTotal || 0);
      construirTabla('#pane-activos', COLS_ACTIVOS, r.activos || [], { titulo: 'Plantilla activa' });
      construirTabla('#pane-bajas', COLS_BAJAS, r.bajas || [], { titulo: 'Bajas' });
      pintarAltas(r.altas || []);
      let tab = 'activos';
      try { tab = localStorage.getItem('telecab-plantilla-tab') || 'activos'; } catch (_) {}
      activar(tab);
    } catch (e) { $('#cargando').textContent = 'No se pudieron cargar los datos: ' + e.message; }
  }

  // Crear las fichas de todos los conductores que falten.
  $('#crear-todas').addEventListener('click', async () => {
    const b = $('#crear-todas'), msg = $('#crear-msg');
    const aviso = (t, cls) => { msg.innerHTML = t; msg.className = 'text-xs leading-snug ' + cls; msg.classList.remove('hidden'); };
    if (!confirm('¿Crear las fichas de todos los conductores que aún no la tengan, con los datos de la agenda?')) return;
    b.disabled = true; aviso('Creando…', 'text-telecab-muted');
    try {
      const r = await (await fetch('/fichas/crear-todas', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' })).json();
      if (r.status !== 'ok') throw new Error(r.msg || 'error');
      let t = `Creadas <b>${r.creadas}</b>. Ya tenían ${r.yaTenian}.`;
      if (r.sinTelefono && r.sinTelefono.length) t += `<br><span class="text-telecab-gold">Sin teléfono (${r.sinTelefono.length}): ${esc(r.sinTelefono.slice(0, 12).join(', '))}${r.sinTelefono.length > 12 ? '…' : ''}</span>`;
      aviso(t, r.sinTelefono && r.sinTelefono.length ? 'text-telecab-text' : 'text-telecab-green');
    } catch (e) { aviso('No se pudo: ' + esc(e.message), 'text-telecab-red'); }
    b.disabled = false;
  });

  cargar();
</script>
