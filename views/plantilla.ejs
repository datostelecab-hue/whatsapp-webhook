                pinta: v => v
                  ? '<span class="text-telecab-warn"><i class="fa-solid fa-triangle-exclamation"></i> Ambiguo</span>'
                  : '<span class="text-telecab-green">Sí</span>' },
            ],
          },
        },
        {
          titulo: 'Patrón de libranza', icono: 'fa-calendar-week',
          visible: d => (d.patrones || []).length > 0,
          pinta: (d, hueco) => {
            hueco.className = 'p-5 space-y-3';
            hueco.innerHTML = d.patrones.map(p => `
              <div class="flex items-center gap-3 flex-wrap">
                <div class="flex gap-1">
                  ${[1, 2, 3, 4, 5, 6, 7].map(n => `
                    <span class="w-7 h-7 rounded-lg text-xs font-semibold flex items-center justify-center
                      ${p.dias.includes(n)
                        ? 'bg-telecab-gold text-telecab-dark'
                        : 'bg-telecab-card2 text-telecab-muted'}">${DIAS[n]}</span>`).join('')}
                </div>
                <span class="text-xs text-telecab-muted">
                  ${esc(fecha(p.desde))} → ${p.hasta ? esc(fecha(p.hasta)) : 'ahora'}
                </span>
              </div>`).join('');
          },
        },
      ],
    },
  });
})();
</script>
