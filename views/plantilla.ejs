<div id="modulo"></div>

<script>
(function () {
  const CAT = <%- JSON.stringify(catalogos || {}) %>;
  const { fecha, hace, etiqueta, esc } = Listado.fmt;

  const DIAS = ['', 'L', 'M', 'X', 'J', 'V', 'S', 'D'];
  const ROL = '<%= typeof rol !== "undefined" ? rol : "" %>';
  // Tráfico ve la ficha entera pero solo cambia lo suyo: turno y libranzas.
  const SOLO_OPERATIVO = ROL === 'trafico';

  /** Llama a la API y devuelve el JSON, o lanza con el mensaje del servidor. */
  async function api(url, opciones) {
    const r = await fetch(url, opciones);
    const j = await r.json().catch(() => null);
    if (!r.ok || (j && j.status === 'error')) {
      const e = new Error((j && j.msg) || `Error ${r.status}`);
      // El servidor puede decir MÁS que un mensaje: si el fallo es un choque
      // con alguien que ya existe, viene con quién es y en qué situación está.
      if (j && j.conflicto) e.conflicto = j.conflicto;
      throw e;
    }
    return j;
  }
  const enviar = (url, metodo, cuerpo) => api(url, {
    method: metodo,
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(cuerpo || {}),
  });

  /** dd/mm/aaaa → aaaa-mm-dd, que es lo que entiende la base. */
  const aISO = v => {
    const m = String(v || '').match(/^(\d{2})\/(\d{2})\/(\d{4})$/);
    return m ? `${m[3]}-${m[2]}-${m[1]}` : (v || null);
  };

  /**
   * Ventana pequeña para pedir unos datos. Se usa para todas las acciones de la
   * ficha en vez de repetir el mismo modal seis veces.
   *
   * `campos` = [{ id, etiqueta, tipo: 'texto'|'fecha'|'lista'|'semana', opciones, valor, ayuda }]
   * Devuelve los valores, o null si se cancela.
   */
  function pedirDatos(titulo, campos, { textoBoton = 'Guardar', nota, ancho = 'max-w-md', columnas = 1 } = {}) {
    return new Promise(resolver => {
      const fondo = document.createElement('div');
      fondo.className = 'fixed inset-0 z-50 flex items-start justify-center p-4 overflow-y-auto bg-black/60 backdrop-blur-sm';
      fondo.innerHTML = `
        <div class="bg-telecab-card border border-telecab-border rounded-2xl shadow-soft w-full ${ancho} my-8">
          <div class="px-5 py-4 border-b border-telecab-border">
            <h3 class="font-bold">${esc(titulo)}</h3>
            ${nota ? `<p class="text-xs text-telecab-muted mt-1">${esc(nota)}</p>` : ''}
          </div>
          <form class="p-5 max-h-[70vh] overflow-y-auto grid gap-x-4 gap-y-3 ${
            columnas === 2 ? 'sm:grid-cols-2' : 'grid-cols-1'}">
            ${campos.map((c, i) => {
              // Cabecera de grupo cuando cambia: con treinta campos seguidos no
              // se distingue la dirección de la Seguridad Social.
              const cabecera = c.grupo && (i === 0 || campos[i - 1].grupo !== c.grupo)
                ? `<p class="col-span-full text-[11px] uppercase tracking-wider font-semibold
                             text-telecab-gold border-b border-telecab-border pb-1 pt-2">${esc(c.grupo)}</p>`
                : '';
              const base = 'w-full px-3 py-2 bg-telecab-card2 border border-telecab-border rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-telecab-gold/40';
              let campo;
              if (c.tipo === 'lista') {
                const ops = (c.opciones || []).map(o => (typeof o === 'string' ? { valor: o, texto: o } : o));
                // Se deja elegir "sin dato": obligar a un valor inventaría uno.
                const vacio = c.obligatorio ? '' : '<option value=""></option>';
                campo = `<select id="pd-${c.id}" class="${base}">${vacio}${ops.map(o =>
                  `<option value="${esc(o.valor)}" ${String(o.valor) === String(c.valor || '') ? 'selected' : ''}>${esc(o.texto)}</option>`).join('')}</select>`;
              } else if (c.tipo === 'semana') {
                const puestos = c.valor || [];
                campo = `<div class="flex gap-1" id="pd-${c.id}">${[1,2,3,4,5,6,7].map(n =>
                  `<button type="button" data-dia="${n}"
                     class="w-9 h-9 rounded-lg text-sm font-semibold transition border
                       ${puestos.includes(n)
                         ? 'bg-telecab-gold text-telecab-dark border-telecab-gold'
                         : 'bg-telecab-card2 text-telecab-muted border-telecab-border'}">${DIAS[n]}</button>`).join('')}</div>`;
              } else if (c.tipo === 'texto-largo') {
                campo = `<textarea id="pd-${c.id}" rows="2" class="${base}">${esc(c.valor || '')}</textarea>`;
              } else {
                campo = `<input id="pd-${c.id}" class="${c.tipo === 'fecha' ? 'js-fecha ' : ''}${base}"
                          value="${esc(c.valor || '')}" placeholder="${esc(c.marcador || (c.tipo === 'fecha' ? 'dd/mm/aaaa' : ''))}">`;
              }
              return cabecera + `<div class="${c.tipo === 'texto-largo' ? 'col-span-full' : ''}">
                <label class="block text-xs text-telecab-muted uppercase tracking-wide mb-1">${esc(c.etiqueta)}</label>
                ${campo}
                ${c.ayuda ? `<p class="text-[11px] text-telecab-muted mt-1">${esc(c.ayuda)}</p>` : ''}
              </div>`;
            }).join('')}
            <p class="hidden text-sm text-telecab-red col-span-full" data-error></p>
            <div class="flex items-center gap-2 pt-1 col-span-full">
              <button type="submit" class="flex-1 px-4 py-2.5 rounded-xl bg-telecab-gold text-telecab-dark font-semibold text-sm shadow-gold">${esc(textoBoton)}</button>
              <button type="button" data-cancelar class="px-4 py-2.5 rounded-xl bg-telecab-card2 border border-telecab-border text-sm">Cancelar</button>
            </div>
          </form>
        </div>`;
      document.body.appendChild(fondo);

      // Los días de la semana se marcan pinchando.
      fondo.querySelectorAll('[id^="pd-"] [data-dia]').forEach(b => {
        b.addEventListener('click', () => {
          const on = b.classList.toggle('bg-telecab-gold');
          b.classList.toggle('text-telecab-dark', on);
          b.classList.toggle('border-telecab-gold', on);
          b.classList.toggle('bg-telecab-card2', !on);
          b.classList.toggle('text-telecab-muted', !on);
          b.classList.toggle('border-telecab-border', !on);
        });
      });

      const cerrar = v => { fondo.remove(); document.removeEventListener('keydown', esc2); resolver(v); };
      const esc2 = e => { if (e.key === 'Escape') cerrar(null); };
      document.addEventListener('keydown', esc2);
      fondo.addEventListener('click', e => { if (e.target === fondo) cerrar(null); });
      fondo.querySelector('[data-cancelar]').addEventListener('click', () => cerrar(null));

      fondo.querySelector('form').addEventListener('submit', async e => {
        e.preventDefault();
        const salida = {};
        campos.forEach(c => {
          const el = fondo.querySelector('#pd-' + c.id);
          if (c.tipo === 'semana') {
            salida[c.id] = [...el.querySelectorAll('[data-dia]')]
              .filter(b => b.classList.contains('bg-telecab-gold'))
              .map(b => Number(b.dataset.dia));
          } else {
            salida[c.id] = c.tipo === 'fecha' ? aISO(el.value.trim()) : el.value.trim();
          }
        });
        cerrar(salida);
      });

      const primero = fondo.querySelector('input, select, textarea');
      if (primero) primero.focus();
    });
  }

  /** Ejecuta una acción y refresca la ficha y la lista. Errores a la vista. */
  async function hacer(fn) {
    try {
      await fn();
      const id = plantilla.abierto;
      await plantilla.recargar();
      if (id) await plantilla.abrir(id, { historial: false });
    } catch (e) {
      alert(e.message);
    }
  }

  // Color de cada situación. El código va en la base; esto es solo cómo se ve.
  const tonoSituacion = c => ({
    activo: 'green', vacaciones: 'gold', baja_medica: 'warn',
    permiso: 'violet', excedencia: 'muted', baja_empresa: 'red',
  }[c] || 'muted');

  // Lo que le falta a una ficha, en corto y con su aviso.
  const faltan = f => !f.faltan.length
    ? '<span class="text-telecab-green"><i class="fa-solid fa-check"></i></span>'
    : `<span class="text-telecab-warn" title="${esc(f.faltan.join(', '))}">
         <i class="fa-solid fa-triangle-exclamation"></i> ${f.faltan.length}</span>`;

  // ---------- acciones de la ficha ----------

  async function accionSituacion(d) {
    const v = await pedirDatos(`Cambiar la situación de ${d.nombre_completo}`, [
      { id: 'estado', etiqueta: 'Situación', tipo: 'lista', valor: d.situacion,
        opciones: (CAT.situaciones || []).map(x => ({ valor: x.codigo, texto: x.etiqueta })) },
      { id: 'desde', etiqueta: 'Desde', tipo: 'fecha', valor: fecha(new Date()),
        ayuda: 'Se cierra la situación anterior el día antes.' },
      { id: 'hastaPrevisto', etiqueta: 'Vuelta prevista', tipo: 'fecha',
        ayuda: 'Solo cuenta en vacaciones o permisos. En una baja médica la fecha la pone el alta, no nosotros.' },
      { id: 'motivo', etiqueta: 'Motivo', tipo: 'texto-largo' },
    ], { nota: 'Una ausencia NO le quita su plaza: el coche sigue siendo suyo.' });
    if (!v) return;
    // Una ausencia no cierra su asignación, así que aquí no se toca nada del
    // coche. Está decidido en el esquema y esto solo lo respeta.
    await hacer(() => enviar(`/plantilla/api/conductor/${d.id}/situacion`, 'POST', v));
  }

  async function accionTurno(d) {
    const v = await pedirDatos(`Cambiar el turno de ${d.nombre_completo}`, [
      { id: 'turnoId', etiqueta: 'Turno', tipo: 'lista', valor: d.turno_id,
        opciones: (CAT.turnos || []).map(t => ({ valor: t.id, texto: t.etiqueta })) },
      { id: 'desde', etiqueta: 'Desde', tipo: 'fecha', valor: fecha(new Date()) },
    ]);
    if (!v) return;
    await hacer(() => enviar(`/plantilla/api/conductor/${d.id}/turno`, 'POST', v));
  }

  async function accionLibranza(d) {
    const actual = (d.patrones || []).find(p => !p.hasta);
    const v = await pedirDatos(`Libranzas de ${d.nombre_completo}`, [
      { id: 'dias', etiqueta: 'Días que libra', tipo: 'semana', valor: (actual && actual.dias) || [] },
      { id: 'desde', etiqueta: 'A partir de', tipo: 'fecha', valor: fecha(new Date()) },
    ], { nota: 'Se abre un patrón nuevo y se cierra el anterior. No se reescribe: si se reescribiera, la cobertura de las semanas pasadas dejaría de cuadrar con lo que de verdad pasó.' });
    if (!v) return;
    await hacer(() => enviar(`/plantilla/api/conductor/${d.id}/libranza`, 'POST', v));
  }

  async function accionTelefono(d) {
    const v = await pedirDatos(`Teléfono de ${d.nombre_completo}`, [
      { id: 'e164', etiqueta: 'Número', valor: d.telefono || '+34', marcador: '+34600000000' },
    ], { nota: 'Pasa a ser el principal y el anterior se archiva. Es el número con el que el bot le escribe.' });
    if (!v) return;
    await hacer(() => enviar(`/plantilla/api/conductor/${d.id}/telefono`, 'POST', v));
  }

  async function accionBolt(d) {
    let sugeridas = [], libres = [], estado = {};
    try {
      [sugeridas, libres, estado] = await Promise.all([
        api('/plantilla/api/bolt-sugerencias').then(r => r.sugerencias || []),
        api('/plantilla/api/bolt-libres').then(r => r.cuentas || []),
        api('/plantilla/api/bolt-estado').then(r => r.estado || {}),
      ]);
    } catch (e) { return alert(e.message); }

    // La propuesta para ESTA persona: la cuenta cuyo teléfono es el suyo.
    const mia = sugeridas.find(x => Number(x.conductor_id) === Number(d.id));

    if (mia) {
      const ok = await Dialogo.confirmar({
        titulo: 'Hay una cuenta con su mismo teléfono',
        tono: mia.coincide_nombre ? 'pregunta' : 'aviso',
        si: 'Enlazar esta cuenta', no: 'Cancelar',
        html: `
          <div class="rounded-xl border border-telecab-border bg-telecab-card2 p-3 text-sm">
            <p class="font-semibold">${esc(mia.nombre_en_bolt || '(sin nombre en BOLT)')}</p>
            <p class="tabular-nums text-telecab-muted">${esc(mia.externo_telefono)}</p>
            <p class="text-xs text-telecab-muted">estado en BOLT: ${esc(mia.estado_externo)}</p>
          </div>
          <p>${mia.coincide_nombre
                ? 'El nombre también coincide, así que no hay duda.'
                : '<b class="text-telecab-warn">El nombre no coincide exactamente</b>, pero el teléfono sí. ' +
                  'Puede ser un cambio de apellido o una errata en BOLT — compruébalo antes de enlazar.'}</p>`,
      });
      if (ok) {
        await hacer(() => enviar(`/plantilla/api/conductor/${d.id}/bolt`, 'POST', { cuentaId: mia.cuenta_id }));
        return;
      }
    }

    if (!libres.length) {
      // El mensaje explica POR QUÉ no hay ninguna, que es lo que faltaba: casi
      // siempre es que nadie ha traído todavía el padrón de BOLT.
      const ultima = estado.ultima_consulta
        ? `La última consulta a BOLT fue el ${fecha(estado.ultima_consulta)}.`
        : 'Nunca se ha consultado el padrón de BOLT desde aquí.';
      return alert(
        'No hay ninguna cuenta de BOLT libre.\n\n' + ultima + '\n\n' +
        `Enlazadas: ${estado.enlazadas || 0} · sin dar de alta en BOLT: ${estado.sin_alta_bolt || 0}\n\n` +
        'Si falta gente, hay que traer el padrón: es el botón "Traer de BOLT" de la cabecera.');
    }

    const v = await pedirDatos(`Enlazar cuenta de BOLT a ${d.nombre_completo}`, [
      { id: 'cuentaId', etiqueta: 'Cuenta', tipo: 'lista',
        opciones: libres.map(c => ({
          valor: c.id,
          texto: `${c.nombre_en_bolt || '(sin nombre)'}${c.externo_telefono ? ' · ' + c.externo_telefono : ''}`,
        })) },
    ], { nota: 'Ninguna cuenta libre tiene el teléfono de esta persona, así que hay que elegirla a mano. Comprueba de quién es antes: una cuenta mal enlazada le imputa las horas a otro.' });
    if (!v) return;
    await hacer(() => enviar(`/plantilla/api/conductor/${d.id}/bolt`, 'POST', v));
  }

  /**
   * Vuelve a dar de alta a alguien que ya estuvo aquí.
   *
   * NO se crea una ficha nueva: se abre un periodo de empleo más sobre la misma
   * persona. Así su historial —los coches que llevó, sus bajas, sus documentos—
   * sigue siendo el suyo, que es justo lo que se perdería creando un duplicado.
   */
  async function volverAAlta(d) {
    const previos = (d.empleos || []).length;
    const v = await pedirDatos(`Volver a dar de alta a ${d.nombre_completo}`, [
      { id: 'tipo', etiqueta: 'Tipo de contrato', tipo: 'lista', obligatorio: true,
        valor: d.empleo_tipo || 'propia',
        opciones: [{ valor: 'propia', texto: 'Plantilla propia' }, { valor: 'ett', texto: 'ETT' }] },
      { id: 'ettNombre', etiqueta: 'Nombre de la ETT', valor: d.ett_nombre || '' },
      { id: 'alta', etiqueta: 'Fecha de alta *', tipo: 'fecha', valor: fecha(new Date()) },
      { id: 'antiguedad', etiqueta: 'Antigüedad reconocida', tipo: 'fecha',
        ayuda: 'Si se le respeta la antigüedad de su etapa anterior, ponla aquí.' },
      { id: 'jornadaHoras', etiqueta: 'Jornada', tipo: 'lista',
        opciones: [20, 25, 30, 32, 35, 40].map(h => ({ valor: h, texto: h + ' horas' })) },
      { id: 'finPrueba', etiqueta: 'Fin del periodo de prueba', tipo: 'fecha' },
    ], { textoBoton: 'Volver a dar de alta',
         nota: `Ya tiene ${previos} periodo(s) de empleo en su historial. Este se añade, no los sustituye.` });
    if (!v) return;
    if (!v.alta) return alert('Falta la fecha de alta.');
    await hacer(() => enviar(`/plantilla/api/conductor/${d.id}/alta`, 'POST', v));
  }

  /**
   * Alta de alguien nuevo.
   *
   * Se pide lo mínimo: nombre y fecha. Un ETT entra así de justo a propósito —
   * se le puede planificar antes de que llegue su papeleo, que es como funciona
   * de verdad una incorporación urgente. El resto se completa luego en su ficha.
   */
  async function altaNueva() {
    const v = await pedirDatos('Dar de alta a alguien nuevo', [
      { id: 'nombre', etiqueta: 'Nombre *', grupo: 'Quién es' },
      { id: 'apellidos', etiqueta: 'Apellidos', grupo: 'Quién es' },
      { id: 'dni_nie', etiqueta: 'DNI o NIE', grupo: 'Quién es',
        ayuda: 'Si ya existe, se avisa de quién es en vez de crear un duplicado.' },
      { id: 'telefono', etiqueta: 'Teléfono', grupo: 'Quién es',
        ayuda: 'Es con el que le escribe el bot, y con el que se le busca en BOLT.' },

      { id: 'tipo', etiqueta: 'Tipo de contrato', grupo: 'Contrato', tipo: 'lista',
        valor: 'propia', obligatorio: true,
        opciones: [{ valor: 'propia', texto: 'Plantilla propia' }, { valor: 'ett', texto: 'ETT' }] },
      { id: 'ettNombre', etiqueta: 'Nombre de la ETT', grupo: 'Contrato',
        ayuda: 'Solo si el contrato es por ETT.' },
      { id: 'alta', etiqueta: 'Fecha de alta *', grupo: 'Contrato', tipo: 'fecha',
        valor: fecha(new Date()) },
      { id: 'antiguedad', etiqueta: 'Antigüedad reconocida', grupo: 'Contrato', tipo: 'fecha',
        ayuda: 'Solo si arrastra antigüedad de antes, por una subrogación.' },
      { id: 'jornadaHoras', etiqueta: 'Jornada', grupo: 'Contrato', tipo: 'lista',
        opciones: [20, 25, 30, 32, 35, 40].map(h => ({ valor: h, texto: h + ' horas' })) },
      { id: 'finPrueba', etiqueta: 'Fin del periodo de prueba', grupo: 'Contrato', tipo: 'fecha' },

      { id: 'turnoId', etiqueta: 'Turno', grupo: 'Cómo trabaja', tipo: 'lista',
        opciones: (CAT.turnos || []).map(t => ({ valor: t.id, texto: t.etiqueta })) },
      { id: 'libranzas', etiqueta: 'Días que libra', grupo: 'Cómo trabaja', tipo: 'semana', valor: [] },
    ], { ancho: 'max-w-2xl', columnas: 2, textoBoton: 'Dar de alta',
         nota: 'Solo el nombre y la fecha de alta son obligatorios. Todo lo demás se puede completar después en su ficha.' });
    if (!v) return;

    if (!v.nombre) return alert('Falta el nombre.');
    if (!v.alta) return alert('Falta la fecha de alta.');

    try {
      const r = await enviar('/plantilla/api/conductor', 'POST', v);
      await plantilla.recargar();
      // Se abre su ficha recién creada: lo siguiente que se hace siempre es
      // completarla o subirle un documento.
      if (r.id) await plantilla.abrir(r.id);
    } catch (e) {
      // Si el choque es con una persona que YA existe, no se deja a nadie
      // delante de un mensaje sin salida: se le lleva a su ficha, que es donde
      // se resuelve — volviéndole a dar de alta o corrigiendo el dato.
      const c = e.conflicto;
      if (!c) return Dialogo.aviso({ titulo: 'No se pudo dar de alta', texto: e.message, tono: 'error' });

      // Dos situaciones distintas, dos diálogos distintos. Ofrecer "volver a
      // darle de alta" a alguien que está trabajando seria un disparate.
      const ir = c.empleoVigente
        ? await Dialogo.elegir({
            titulo: `Ese ${c.campo} ya tiene dueño`,
            tono: 'aviso',
            html: `<p><b>${esc(c.quien)}</b> está de alta ahora mismo con ese ${esc(c.campo)}.</p>
                   <p class="text-telecab-muted">Si de verdad son personas distintas, revisa el dato antes de seguir.</p>`,
            opciones: [
              { texto: 'Cancelar', valor: false },
              { texto: 'Ver su ficha', valor: true, principal: true },
            ],
          })
        : await Dialogo.elegir({
            titulo: 'Esta persona ya estuvo aquí',
            tono: 'pregunta',
            html: `<p><b>${esc(c.quien)}</b> tiene ese ${esc(c.campo)} y está <b>de baja</b>.</p>
                   <p class="text-telecab-muted">Lo suyo es volver a darle de alta: así conserva su historial,
                   sus documentos y los coches que llevó. Creando otra ficha se perdería todo eso.</p>`,
            opciones: [
              { texto: 'Cancelar', valor: false },
              { texto: 'Volver a darle de alta', valor: true, principal: true },
            ],
          });
      if (ir) await plantilla.abrir(c.id);
    }
  }

  /** Trae el padrón de BOLT y cuenta cuántas propuestas salen. */
  async function traerDeBolt() {
    const ok = await Dialogo.confirmar({
      titulo: 'Traer el padrón de BOLT',
      si: 'Traer', no: 'Cancelar',
      html: `<p>Se pregunta a BOLT qué cuentas existen y se actualiza el inventario.</p>
             <p class="text-telecab-muted">NO enlaza a nadie con nadie: solo deja la lista al día
             para poder enlazar después a mano.</p>`,
    });
    if (!ok) return;
    try {
      const r = await enviar('/plantilla/api/bolt/sincronizar', 'POST');
      const e = await api('/plantilla/api/bolt-estado').then(x => x.estado || {});
      alert(
        `${r.vistas} cuentas en BOLT · ${r.nuevas} nuevas · ${r.cambiadas} con otro estado\n\n` +
        `Libres para enlazar: ${e.libres || 0}\n` +
        `Con dueño propuesto por el teléfono: ${e.sugeridas || 0}\n` +
        `Personas SIN dar de alta en BOLT: ${e.sin_alta_bolt || 0}\n` +
        `Personas sin teléfono en la ficha: ${e.sin_telefono || 0}`);
      await plantilla.recargar();
    } catch (e) {
      alert('BOLT: ' + e.message);
    }
  }

  // Los campos editables los declara el SERVIDOR. Pedirlos en vez de escribirlos
  // aquí es lo que hace que añadir un campo a la ficha no obligue a tocar la
  // pantalla, y que Tráfico vea exactamente lo que puede tocar y nada más.
  let CAMPOS_FICHA = null;
  async function camposFicha() {
    if (!CAMPOS_FICHA) CAMPOS_FICHA = await api('/plantilla/api/campos');
    return CAMPOS_FICHA;
  }

  async function accionDatos(d) {
    let meta;
    try { meta = await camposFicha(); } catch (e) { return alert(e.message); }

    const editables = new Set(meta.editables || []);
    const campos = Object.entries(meta.campos || {})
      .filter(([k]) => editables.has(k))
      .map(([k, def]) => ({
        id: k,
        etiqueta: def.etiqueta || k,
        grupo: def.grupo,
        tipo: def.tipo || 'texto',
        opciones: def.opciones,
        ayuda: def.ayuda,
        // Las fechas se enseñan como dd/mm/aaaa y vuelven a ISO al guardar.
        valor: def.tipo === 'fecha' ? fecha(d[k]) : (d[k] == null ? '' : String(d[k])),
      }));

    if (!campos.length) return alert('Tu rol no puede editar ningún campo de la ficha.');

    const v = await pedirDatos(`Datos de ${d.nombre_completo}`, campos, {
      ancho: 'max-w-3xl', columnas: 2,
      nota: SOLO_OPERATIVO
        ? 'Tu rol solo edita lo operativo. El resto lo lleva RRHH.'
        : 'Cada campo que cambie queda registrado con tu nombre y la hora. El teléfono principal se cambia en su propio bloque: tiene historial.',
    });
    if (!v) return;

    // Se manda SOLO lo que ha cambiado: así el registro de auditoría no se
    // llena de campos que nadie ha tocado.
    const cambios = {};
    campos.forEach(c => {
      const antes = c.valor || '';
      const ahora = v[c.id] == null ? '' : String(v[c.id]);
      const comparable = c.tipo === 'fecha' ? (aISO(antes) || '') : antes;
      if (ahora !== comparable && !(ahora === '' && comparable === '')) cambios[c.id] = v[c.id];
    });
    if (!Object.keys(cambios).length) return;

    await hacer(() => enviar(`/plantilla/api/conductor/${d.id}`, 'PUT', cambios));
  }

  async function accionBaja(d) {
    const v = await pedirDatos(`Dar de baja a ${d.nombre_completo}`, [
      { id: 'fecha', etiqueta: 'Fecha de baja', tipo: 'fecha', valor: fecha(new Date()) },
      { id: 'motivo', etiqueta: 'Motivo', tipo: 'texto-largo' },
    ], { textoBoton: 'Dar de baja',
         nota: 'Se cierran su empleo, su turno, sus libranzas y sus asignaciones. Su historial se conserva entero.' });
    if (!v) return;
    const ok = await Dialogo.confirmar({
      titulo: `Dar de baja a ${d.nombre_completo}`,
      tono: 'peligro', si: 'Dar de baja', no: 'Cancelar',
      html: `<p>Con fecha <b>${esc(v.fecha)}</b>.</p>
             <p class="text-telecab-muted">Se cierran su empleo, su turno, sus libranzas y sus asignaciones.
             Su historial se conserva entero y se le puede volver a dar de alta.</p>`,
    });
    if (!ok) return;
    await hacer(() => enviar(`/plantilla/api/conductor/${d.id}/baja`, 'POST', v));
  }

  // ---------- documentos ----------

  async function subirDocumento(d) {
    let tipos = [];
    try { tipos = (await api('/plantilla/api/tipos-documento')).tipos || []; }
    catch (e) { return alert(e.message); }

    const entrada = document.createElement('input');
    entrada.type = 'file';
    entrada.accept = 'image/*,application/pdf';
    entrada.onchange = async () => {
      const f = entrada.files && entrada.files[0];
      if (!f) return;
      if (f.size > 25 * 1024 * 1024) return alert('El archivo pasa de 25 MB.');

      const v = await pedirDatos(`Subir "${f.name}"`, [
        { id: 'tipo', etiqueta: 'Qué documento es', tipo: 'lista',
          opciones: tipos.map(t => ({ valor: t.codigo, texto: t.etiqueta + (t.obligatorio ? ' (obligatorio)' : '') })) },
        { id: 'fechaEmision', etiqueta: 'Fecha de emisión', tipo: 'fecha' },
        { id: 'fechaCaduca', etiqueta: 'Caduca el', tipo: 'fecha',
          ayuda: 'Obligatoria en los documentos que caducan; es lo que permite avisar antes.' },
        { id: 'notas', etiqueta: 'Notas', tipo: 'texto-largo' },
      ], { textoBoton: 'Subir' });
      if (!v) return;

      const base64 = await new Promise(r => {
        const fr = new FileReader();
        fr.onload = () => r(String(fr.result).split(',')[1]);
        fr.readAsDataURL(f);
      });
      await hacer(() => enviar('/plantilla/api/documento', 'POST', {
        conductorId: d.id, nombre: f.name, mime: f.type, base64, ...v,
      }));
    };
    entrada.click();
  }

