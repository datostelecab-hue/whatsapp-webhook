<form method="POST" action="/login" class="bg-telecab-card border border-telecab-border rounded-2xl p-6 shadow-soft">
  <h1 class="text-lg font-semibold text-telecab-text mb-1">Iniciar sesión</h1>
  <p class="text-xs text-telecab-muted mb-4">Entra con tu correo y contraseña.</p>

  <% if (error) { %>
    <p class="text-xs text-telecab-red bg-telecab-red/10 border border-telecab-red/30 rounded-lg px-3 py-2 mb-3">
      <i class="fa-solid fa-triangle-exclamation mr-1"></i><%= error %>
    </p>
  <% } %>

  <input type="hidden" name="next" value="<%= next || '' %>">

  <label class="block text-xs text-telecab-muted mb-1">Correo</label>
  <input name="email" type="email" required autofocus autocomplete="username"
         class="w-full bg-telecab-dark border border-telecab-border rounded-xl px-3 py-2 text-telecab-text mb-3 focus:outline-none focus:border-telecab-gold transition"
         placeholder="tu@telecab.es">

  <label class="block text-xs text-telecab-muted mb-1">Contraseña</label>
  <input name="password" type="password" required autocomplete="current-password"
         class="w-full bg-telecab-dark border border-telecab-border rounded-xl px-3 py-2 text-telecab-text mb-4 focus:outline-none focus:border-telecab-gold transition"
         placeholder="••••••••">

  <button class="w-full px-4 py-2.5 rounded-xl bg-telecab-gold text-telecab-dark font-semibold hover:bg-telecab-gold-soft transition">
    Entrar
  </button>

  <div class="text-center mt-4">
    <a href="/olvide-password" class="text-xs text-telecab-muted hover:text-telecab-gold transition">¿Olvidaste tu contraseña?</a>
  </div>
</form>
