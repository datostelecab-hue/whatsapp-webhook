<div class="flex flex-col lg:flex-row lg:h-[calc(100vh-3.5rem)]">

  <!-- ═══════ Lista de fichas ═══════ -->
  <aside class="lg:w-80 shrink-0 border-b lg:border-b-0 lg:border-r border-telecab-border flex flex-col lg:h-full">
    <div class="p-3 border-b border-telecab-border">
      <h1 class="text-sm font-semibold text-telecab-text flex items-center gap-2 mb-2">
        <i class="fa-solid fa-address-card text-telecab-gold"></i> Fichas de conductores
      </h1>
      <input id="f-buscar" class="w-full bg-telecab-dark border border-telecab-border rounded-xl px-3 py-2 text-sm text-telecab-text focus:outline-none focus:border-telecab-gold transition"
             placeholder="Buscar por nombre o DNI…" autocomplete="off">
      <p id="f-count" class="text-[11px] text-telecab-muted mt-1.5"></p>
      <button id="f-crear-todas" class="w-full mt-2 text-xs px-3 py-1.5 rounded-lg bg-telecab-gold/15 border border-telecab-gold/40 text-telecab-gold hover:bg-telecab-gold/25 transition font-medium">
        <i class="fa-solid fa-user-plus mr-1"></i> Crear fichas de todos
      </button>
      <p id="f-crear-msg" class="text-[11px] mt-1 hidden leading-snug"></p>
    </div>
    <div id="lista" class="flex-1 overflow-y-auto p-2 space-y-1 lg:max-h-none max-h-[40vh]"></div>
  </aside>

  <!-- ═══════ Detalle ═══════ -->
  <section class="flex-1 overflow-y-auto lg:h-full">
    <div id="detalle-vacio" class="h-full min-h-[50vh] flex items-center justify-center text-center text-telecab-muted p-8">
      <div>
        <i class="fa-regular fa-address-card text-4xl mb-3 opacity-40"></i>
        <p class="text-sm">Elige una ficha de la lista para ver todos sus datos y documentos.</p>
      </div>
    </div>
    <div id="detalle" class="hidden max-w-3xl mx-auto p-5 lg:p-8"></div>
  </section>

</div>

<script>
  const $ = s => document.querySelector(s);
  const esc = s => String(s == null ? '' : s).replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
  let FICHAS = [];
  let sel = null;

  // Grupos de campos del detalle (clave en la ficha → etiqueta).
  const GRUPOS = [
    { g: 'Datos personales', campos: [['nombre','Nombre'],['apellidos','Apellidos'],['dni','DNI / NIE'],['nacionalidad','Nacionalidad'],['fecha_nacimiento','Fecha de nacimiento'],['estado_civil','Estado civil'],['num_hijos','Nº de hijos']] },
    { g: 'Contacto', campos: [['email','Correo'],['id','Teléfono'],['contacto_emergencia','Contacto de emergencia'],['direccion','Dirección'],['codigo_postal','Código postal'],['localidad','Localidad'],['provincia','Provincia']] },
    { g: 'Datos laborales', campos: [['num_seg_social','Nº Seguridad Social'],['tipo_carnet','Tipo de carnet'],['carnet_expedicion','Carnet · expedición'],['carnet_caducidad','Carnet · caducidad'],['fecha_inicio','Fecha de inicio'],['jornada','Jornada'],['tipo_contrato','Tipo de contrato'],['turno','Turno'],['canal','Canal / origen'],['pin_ballenoil','PIN Ballenoil'],['iban','IBAN / cuenta']] },
    { g: 'Proceso', campos: [['estado','Estado'],['etapa','Etapa'],['excel_alta','Excel de alta'],['fecha_creacion','Creado'],['fecha_apto','Apto'],['fecha_alta','Alta S. Social'],['fecha_habilitado','Habilitado desde']] }
  ];

  const nombreDe = f => `${f.nombre || ''}${f.apellidos ? ' ' + f.apellidos : ''}`.trim() || '(sin nombre)';

  // ── Edición del detalle ────────────────────────────────────────────────────
  const EDITABLES = new Set(['nombre', 'apellidos', 'dni', 'nacionalidad', 'fecha_nacimiento', 'estado_civil',
    'num_hijos', 'email', 'contacto_emergencia', 'direccion', 'codigo_postal', 'localidad', 'provincia',
    'num_seg_social', 'tipo_carnet', 'carnet_expedicion', 'carnet_caducidad', 'fecha_inicio', 'jornada',
    'tipo_contrato', 'turno', 'canal', 'iban']);
  const FECHAS = { fecha_nacimiento: 'data-max="today"', carnet_expedicion: 'data-max="today"', carnet_caducidad: 'data-min="today"', fecha_inicio: '' };
  const SELECTS = { jornada: ['40 HORAS', '32 HORAS'], turno: ['', 'Día', 'Noche', 'TodoTurno'] };
  const INP = 'w-full text-sm bg-telecab-dark border border-telecab-border rounded-lg px-2 py-1.5 text-telecab-text focus:outline-none focus:border-telecab-gold transition';
  function control(k, val) {
    const v = esc(val || '');
    if (k in FECHAS) return `<input data-edit="${k}" value="${v}" placeholder="dd/mm/aaaa" readonly ${FECHAS[k]} class="js-fecha ${INP}">`;
    if (SELECTS[k]) return `<select data-edit="${k}" class="${INP}">${SELECTS[k].map(o => `<option value="${esc(o)}" ${String(val || '') === o ? 'selected' : ''}>${o || '—'}</option>`).join('')}</select>`;
    return `<input data-edit="${k}" value="${v}" placeholder="—" class="${INP}">`;
  }

  const ESTADOS_OP = ['Activo', 'Pendiente Asignar', 'Suspendido', 'Baja Empresa'];
  function estadoOpHTML(f) {
    if (!f.id_bolt) return '';   // sin ID_BOLT no está en la agenda
    const actual = f.estado_agenda || '';
    return `<div class="bg-telecab-card border border-telecab-border rounded-2xl p-4 mb-4">
        <div class="flex flex-wrap items-center gap-2">
          <span class="text-xs uppercase tracking-wide text-telecab-gold font-semibold">Estado operativo</span>
          <span class="text-sm text-telecab-text">${esc(actual || '—')}</span>
          ${f.en_agenda ? `<select id="d-estado" class="ml-auto text-sm bg-telecab-dark border border-telecab-border rounded-lg px-2 py-1.5 text-telecab-text">
              ${ESTADOS_OP.map(o => `<option value="${o}" ${o === actual ? 'selected' : ''}>${o}</option>`).join('')}
            </select>
            <button id="d-estado-btn" class="text-sm px-3 py-1.5 rounded-lg bg-telecab-card2 border border-telecab-border text-telecab-text hover:border-telecab-gold transition">Cambiar</button>`
        : '<span class="ml-auto text-[11px] text-telecab-muted">Archivado (baja). El reingreso se hace desde Peticiones.</span>'}
        </div>
        <p class="text-[11px] text-telecab-muted mt-1.5">Para Vacaciones / Baja Médica / Permiso usa <b>Peticiones</b> (llevan fechas y bitácora).</p>
      </div>`;
  }

  const recogerEdits = () => {
    const d = {};
    document.querySelectorAll('#detalle [data-edit]').forEach(el => { d[el.dataset.edit] = (el.value || '').trim(); });
    return d;
  };
  function avisoD(t, cls) { const m = $('#d-msg'); if (!m) return; m.textContent = t; m.className = 'text-xs ' + cls; m.classList.remove('hidden'); }
  async function guardarEdits(f) {
    const edits = recogerEdits();
    const r = await (await fetch('/seleccion/ticket', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ tel: f.id, ...edits }) })).json();
    if (r && r.status === 'ok') Object.assign(f, edits);
    return r;
  }
  async function guardarFicha(f) {
    avisoD('Guardando…', 'text-telecab-muted');
    try { const r = await guardarEdits(f); if (r.status !== 'ok') throw new Error(r.msg || 'error'); avisoD('Cambios guardados.', 'text-telecab-green'); cargar(); }
    catch (e) { avisoD('No se pudo guardar: ' + e.message, 'text-telecab-red'); }
  }
  async function regenerarFicha(f) {
    avisoD('Guardando y regenerando…', 'text-telecab-muted');
    try {
      const g = await guardarEdits(f); if (g.status !== 'ok') throw new Error(g.msg || 'error');
      const r = await (await fetch('/seleccion/ficha', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ tel: f.id }) })).json();
      if (r.status !== 'ok') throw new Error(r.msg || 'error');
      f.ficha_pdf_link = (r.ficha && r.ficha.link) || r.link || f.ficha_pdf_link;
      avisoD('FICHA regenerada.', 'text-telecab-green');
      if (r.link) window.open(r.link, '_blank');
      abrir(f.id);
    } catch (e) { avisoD('No se pudo: ' + e.message, 'text-telecab-red'); }
  }
  async function cambiarEstadoFicha(f) {
    const estado = $('#d-estado').value;
    if (!confirm(`¿Cambiar el estado operativo de ${nombreDe(f)} a "${estado}"?` + (estado === 'Baja Empresa' ? ' (se archiva en bajas)' : ''))) return;
    avisoD('Cambiando estado…', 'text-telecab-muted');
    try {
      const r = await (await fetch('/fichas/estado', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ idBolt: f.id_bolt, estado }) })).json();
      if (r.status !== 'ok') throw new Error(r.msg || 'error');
      f.estado_agenda = estado; if (estado === 'Baja Empresa') f.en_agenda = false;
      avisoD('Estado cambiado a ' + estado + '.', 'text-telecab-green');
      abrir(f.id);
    } catch (e) { avisoD('No se pudo cambiar: ' + e.message, 'text-telecab-red'); }
  }

  function fila(f) {
    const el = document.createElement('button');
    el.type = 'button';
    el.className = 'w-full text-left flex items-center gap-2.5 px-2.5 py-2 rounded-xl hover:bg-telecab-card2 transition';
    el.dataset.tel = f.id;
    const dot = f.completa
      ? '<span class="w-2 h-2 rounded-full bg-telecab-green shrink-0" title="Ficha completa"></span>'
      : '<span class="w-2 h-2 rounded-full bg-amber-400 shrink-0" title="Ficha incompleta"></span>';
    el.innerHTML =
      `${dot}
       <span class="min-w-0 flex-1">
         <span class="block text-sm text-telecab-text truncate">${esc(nombreDe(f))}</span>
         <span class="block text-[11px] text-telecab-muted font-mono truncate">${esc(f.dni || f.id || '')}</span>
       </span>`;
    el.addEventListener('click', () => abrir(f.id));
    return el;
  }

  function campoHTML(f, k, etq) {
    const editable = EDITABLES.has(k);
    const v = (f[k] == null ? '' : String(f[k])).trim();
    const valor = editable
      ? control(k, f[k])
      : `<dd class="text-sm ${v ? 'text-telecab-text' : 'text-telecab-muted/50'} break-words">${v ? esc(v) : '—'}</dd>`;
    return `<div>
        <dt class="text-[11px] uppercase tracking-wide text-telecab-muted mb-0.5">${esc(etq)}</dt>
        ${valor}
      </div>`;
  }

  function docHTML(d) {
    if (d.link) {
      return `<a href="${esc(d.link)}" target="_blank" rel="noopener"
                 class="flex items-center gap-2.5 px-3 py-2.5 rounded-xl bg-telecab-dark/40 border border-telecab-border hover:border-telecab-gold transition">
          <i class="fa-solid fa-file-lines text-telecab-green shrink-0"></i>
          <span class="min-w-0 flex-1 text-sm text-telecab-text truncate">${esc(d.label)}</span>
          <span class="text-[11px] text-telecab-gold shrink-0"><i class="fa-solid fa-arrow-up-right-from-square mr-1"></i>Abrir</span>
        </a>`;
    }
    return `<div class="flex items-center gap-2.5 px-3 py-2.5 rounded-xl bg-telecab-dark/20 border border-dashed border-telecab-border/60">
        <i class="fa-regular fa-file text-telecab-muted/60 shrink-0"></i>
        <span class="min-w-0 flex-1 text-sm text-telecab-muted truncate">${esc(d.label)}</span>
        <span class="text-[11px] text-amber-400 shrink-0">falta</span>
      </div>`;
  }

  function abrir(tel) {
    const f = FICHAS.find(x => String(x.id) === String(tel));
    if (!f) return;
    sel = f.id;
    document.querySelectorAll('#lista [data-tel]').forEach(b =>
      b.classList.toggle('bg-telecab-card2', String(b.dataset.tel) === String(tel)));

    const estadoBadge = f.completa
      ? '<span class="text-xs px-2.5 py-1 rounded-full bg-telecab-green/10 text-telecab-green border border-telecab-green/30"><i class="fa-solid fa-circle-check mr-1"></i>Ficha completa</span>'
      : `<span class="text-xs px-2.5 py-1 rounded-full bg-amber-500/10 text-amber-400 border border-amber-500/30" title="Falta: ${esc((f.faltan||[]).join(', '))}"><i class="fa-solid fa-triangle-exclamation mr-1"></i>Faltan ${f.faltan.length}</span>`;

    const grupos = GRUPOS.map(gr => `
      <div class="bg-telecab-card border border-telecab-border rounded-2xl p-4">
        <h3 class="text-xs font-semibold uppercase tracking-wide text-telecab-gold mb-3">${esc(gr.g)}</h3>
        <dl class="grid sm:grid-cols-2 gap-x-5 gap-y-3">
          ${gr.campos.map(([k, etq]) => campoHTML(f, k, etq)).join('')}
        </dl>
      </div>`).join('');

    const docsPresentes = (f.documentos || []).filter(d => d.link).length;
    const documentos = `
      <div class="bg-telecab-card border border-telecab-border rounded-2xl p-4">
        <div class="flex items-center justify-between mb-3">
          <h3 class="text-xs font-semibold uppercase tracking-wide text-telecab-gold">Documentos</h3>
          <span class="text-[11px] text-telecab-muted">${docsPresentes}/${(f.documentos||[]).length}</span>
        </div>
        <div class="grid sm:grid-cols-2 gap-2">${(f.documentos || []).map(docHTML).join('')}</div>
        ${f.ficha_pdf_link ? `<a href="${esc(f.ficha_pdf_link)}" target="_blank" rel="noopener"
             class="mt-3 inline-flex items-center gap-2 text-sm text-telecab-gold hover:underline">
             <i class="fa-solid fa-file-pdf"></i> Abrir FICHA DE ALTA (PDF)</a>` : ''}
      </div>`;

    $('#detalle').innerHTML =
      `<div class="mb-4">
         <div class="flex items-start justify-between gap-3 flex-wrap">
           <h2 class="text-2xl font-bold text-telecab-text">${esc(f.id_bolt || nombreDe(f))}</h2>
           ${estadoBadge}
         </div>
         <p class="text-sm text-telecab-muted mt-1">${esc(nombreDe(f))} <span class="font-mono">· ${esc(f.dni || '')}${f.dni && f.id ? ' · ' : ''}${esc(f.id || '')}</span></p>
       </div>
       ${estadoOpHTML(f)}
       <div class="flex flex-wrap items-center gap-2 mb-4">
         <button id="d-guardar" class="px-3 py-1.5 rounded-lg bg-telecab-gold/15 border border-telecab-gold/40 text-telecab-gold hover:bg-telecab-gold/25 transition text-sm font-medium"><i class="fa-solid fa-floppy-disk mr-1"></i> Guardar cambios</button>
         <button id="d-regenerar" class="px-3 py-1.5 rounded-lg bg-telecab-green/15 border border-telecab-green/40 text-telecab-green hover:bg-telecab-green/25 transition text-sm font-medium"><i class="fa-solid fa-arrows-rotate mr-1"></i> Regenerar PDF</button>
         <span id="d-msg" class="text-xs hidden"></span>
       </div>
       <div class="space-y-4">${grupos}${documentos}</div>`;
    $('#detalle-vacio').classList.add('hidden');
    $('#detalle').classList.remove('hidden');
    $('#detalle').parentElement.scrollTop = 0;

    // Handlers del detalle (los elementos se recrean en cada abrir).
    $('#d-guardar').addEventListener('click', () => guardarFicha(f));
    $('#d-regenerar').addEventListener('click', () => regenerarFicha(f));
    const eb = $('#d-estado-btn'); if (eb) eb.addEventListener('click', () => cambiarEstadoFicha(f));
  }

  function pintarLista() {
    const q = $('#f-buscar').value.trim().toLowerCase();
    const vis = FICHAS.filter(f => !q ||
      `${f.nombre} ${f.apellidos} ${f.dni} ${f.id}`.toLowerCase().includes(q));
    const cont = $('#lista'); cont.innerHTML = '';
    if (!vis.length) { cont.innerHTML = '<p class="text-telecab-muted text-sm p-3">Sin resultados.</p>'; }
    else vis.forEach(f => cont.appendChild(fila(f)));
    const incompletas = FICHAS.filter(f => !f.completa).length;
    $('#f-count').textContent = `${vis.length} de ${FICHAS.length}` + (incompletas ? ` · ${incompletas} incompleta${incompletas === 1 ? '' : 's'}` : '');
    // Reaplica el resaltado de la selección actual.
    if (sel) document.querySelectorAll('#lista [data-tel]').forEach(b =>
      b.classList.toggle('bg-telecab-card2', String(b.dataset.tel) === String(sel)));
  }

  async function cargar() {
    try {
      const r = await (await fetch('/fichas/api/datos')).json();
      if (r.status !== 'ok') return;
      FICHAS = r.fichas || [];
      pintarLista();
    } catch (e) {
      $('#lista').innerHTML = '<p class="text-telecab-red text-sm p-3">No se pudieron cargar las fichas: ' + esc(e.message) + '</p>';
    }
  }

  $('#f-buscar').addEventListener('input', pintarLista);

  // Crear de una vez las fichas de todos los conductores (agenda + bajas) que falten.
  $('#f-crear-todas').addEventListener('click', async () => {
    const b = $('#f-crear-todas'), msg = $('#f-crear-msg');
    const aviso = (t, cls) => { msg.innerHTML = t; msg.className = 'text-[11px] mt-1 leading-snug ' + cls; msg.classList.remove('hidden'); };
    if (!confirm('¿Crear las fichas de todos los conductores que aún no la tengan, con los datos que haya en la agenda?')) return;
    b.disabled = true; aviso('Creando…', 'text-telecab-muted');
    try {
      const r = await (await fetch('/fichas/crear-todas', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' })).json();
      if (r.status !== 'ok') throw new Error(r.msg || 'error');
      let t = `Creadas <b>${r.creadas}</b>. Ya tenían ${r.yaTenian}.`;
      if (r.sinTelefono && r.sinTelefono.length) t += `<br><span class="text-telecab-gold">Sin teléfono (${r.sinTelefono.length}): ${esc(r.sinTelefono.slice(0, 10).join(', '))}${r.sinTelefono.length > 10 ? '…' : ''}</span>`;
      aviso(t, r.sinTelefono && r.sinTelefono.length ? 'text-telecab-text' : 'text-telecab-green');
      cargar();
    } catch (e) { aviso('No se pudo: ' + esc(e.message), 'text-telecab-red'); }
    b.disabled = false;
  });

  cargar();
</script>
