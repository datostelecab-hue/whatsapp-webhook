<%- include('partials/control-nav', { sub: 'directo' }) %>

<div class="max-w-[1400px] mx-auto">

  <div class="flex flex-wrap items-end justify-between gap-3 mb-4">
    <div>
      <h1 class="text-2xl font-bold text-telecab-text flex items-center gap-2">
        <i class="fa-solid fa-satellite-dish text-telecab-gold"></i> En directo
      </h1>
      <p class="text-sm text-telecab-muted mt-1">
        El plan del cuadrante contra lo que rueda ahora mismo, por turno. En
        <span class="text-red-500 font-medium">rojo</span> lo que hay que llamar.
      </p>
    </div>
    <div class="flex items-center gap-2">
      <span id="d-actualizado" class="text-xs text-telecab-muted"></span>
      <button id="d-refrescar" class="px-3 py-2 rounded-lg bg-telecab-card border border-telecab-border
        text-sm text-telecab-muted hover:text-telecab-text">
        <i class="fa-solid fa-rotate mr-1"></i> Actualizar
      </button>
    </div>
  </div>

  <!-- Si una de las dos fuentes no responde, se dice: el resto se ve igual. -->
  <div id="d-aviso" class="hidden mb-3 px-3 py-2 rounded-xl border text-sm"></div>

  <!-- Pestañas por turno: Día · Noche · TodoTurno · NN (los que ruedan sin plan). -->
  <div id="d-tabs" class="flex flex-wrap items-center gap-2 mb-3"></div>

  <div class="mb-3 flex flex-wrap items-center gap-2">
    <i class="fa-solid fa-filter text-telecab-muted text-xs"></i>
    <input id="d-filtro" placeholder="Conductor o matrícula"
      class="px-2 py-1.5 rounded-lg bg-telecab-dark border border-telecab-border text-xs text-telecab-text w-56">
    <span id="d-cuenta" class="text-xs text-telecab-muted ml-auto"></span>
  </div>

  <div class="rounded-2xl border border-telecab-border bg-telecab-card overflow-hidden">
    <div id="d-lista">
      <p class="px-4 py-10 text-center text-sm text-telecab-muted">Cargando…</p>
    </div>
  </div>
</div>

<script src="/assets/js/flotaVivaGestion.js?v=<%= v %>"></script>
<script>
(function () {
  const $ = s => document.querySelector(s);
  const esc = s => (s == null ? '' : String(s)).replace(/[&<>"]/g,
    m => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[m]));
  const hora = t => t ? new Date(t).toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' }) : '';
  const horas = min => ((Number(min) || 0) / 60).toFixed(1);

  const TONO = {
    ok:    'bg-emerald-500/15 text-emerald-500',
    aviso: 'bg-amber-500/15 text-amber-500',
    error: 'bg-red-500/15 text-red-500',
    muted: 'bg-telecab-border/40 text-telecab-muted',
  };
  const chip = (txt, tono) =>
    '<span class="px-2 py-0.5 rounded-md text-xs font-medium ' + (TONO[tono] || TONO.muted) + '">' + esc(txt) + '</span>';

  let DATOS = null;
  const abiertos = new Set();            // filas desplegadas (se conservan al refrescar)

  // Turno activo. Arranca en el que corre AHORA: día 05–17, noche el resto.
  const TURNOS = [
    { id: 'dia',        etq: 'Día',       icono: 'fa-sun' },
    { id: 'noche',      etq: 'Noche',     icono: 'fa-moon' },
    { id: 'todoturno',  etq: 'TodoTurno', icono: 'fa-clock-rotate-left' },
    { id: 'nn',         etq: 'NN',        icono: 'fa-user-clock' },
  ];
  const horaAhora = new Date().getHours();
  let turnoActivo = (horaAhora >= 5 && horaAhora < 17) ? 'dia' : 'noche';

  // ── Pestañas ────────────────────────────────────────────────────────────────
  function pintarTabs() {
    const p = (DATOS && DATOS.porTurno) || {};
    $('#d-tabs').innerHTML = TURNOS.map(t => {
      const n = (t.id === 'nn' ? (p.nn || []) : (p[t.id] || [])).length;
      const activo = turnoActivo === t.id;
      const rojo = t.id === 'nn' && n > 0;
      return '<button data-turno="' + t.id + '" class="px-3 py-2 rounded-xl border text-sm flex items-center gap-2 ' +
        (activo ? 'border-telecab-gold bg-telecab-gold/10 text-telecab-text'
                : 'border-telecab-border bg-telecab-card text-telecab-muted hover:text-telecab-text') + '">' +
        '<i class="fa-solid ' + t.icono + (rojo ? ' text-amber-500' : '') + '"></i> ' + t.etq +
        ' <b class="tabular-nums ' + (rojo ? 'text-amber-500' : 'text-telecab-text') + '">' + n + '</b></button>';
    }).join('');
    $('#d-tabs').querySelectorAll('[data-turno]').forEach(b =>
      b.addEventListener('click', () => { turnoActivo = b.dataset.turno; pintarTabs(); pintar(); }));
  }

  // ── Fila por CONDUCTOR (Día / Noche / TodoTurno) ─────────────────────────────
  function filaConductor(f) {
    const a = f.actividad || {};
    const nInc = (f.incidencias || []).length;
    return '<div class="dfila border-b border-telecab-border/70" data-mat="' + esc(f.matriculaNorm) + '">' +
      '<div class="dcab px-4 py-2.5 cursor-pointer select-none flex flex-wrap items-center gap-x-3 gap-y-1">' +
        '<span class="text-telecab-text font-medium w-56 truncate">' + esc(f.conductor) + '</span>' +
        (f.rol ? '<span class="px-1.5 py-0.5 rounded text-[10px] font-semibold ' +
          (f.rol === 'FIJO' ? 'bg-telecab-violet/20 text-telecab-violet' : 'bg-telecab-border/40 text-telecab-muted') +
          '">' + esc(f.rol) + '</span>' : '') +
        '<span class="font-mono text-telecab-muted w-24">' + esc(f.matricula) + '</span>' +
        (a.conectado ? chip('Conectado', 'ok') : chip('Sin actividad', 'muted')) +
        '<span class="text-xs text-telecab-muted tabular-nums w-20 text-right" title="Horas conectado hoy">' +
          horas(a.minutos) + ' h</span>' +
        '<span class="text-xs tabular-nums text-emerald-500 w-20 text-right" title="Km de hoy">' + (a.km || 0) + ' km</span>' +
        (nInc ? chip(nInc + (nInc > 1 ? ' avisos' : ' aviso'), 'error') : '') +
        (f.conflicto ? chip('Conflicto', 'aviso') : '') +
        '<i class="fa-solid fa-chevron-down dchev text-telecab-muted text-xs transition-transform ml-auto"></i>' +
      '</div>' +
      detalleConductor(f) +
      '</div>';
  }

  function incidenciaHTML(i) {
    return '<div class="rounded-lg border border-telecab-border p-2">' +
      '<div class="flex flex-wrap items-center gap-2">' +
        '<span class="text-sm ' + (i.gravedad >= 3 ? 'text-red-500 font-medium' : 'text-telecab-text') + '">' +
          esc(i.etiqueta) + (i.veces > 1 ? ' (x' + i.veces + ')' : '') + '</span>' +
        '<span class="text-sm text-telecab-muted flex-1 min-w-[8rem]">' + esc(i.detalle) + '</span>' +
        (i.telefono ? '<a href="tel:' + esc(i.telefono) + '" class="px-2 py-1 rounded-lg border border-telecab-border ' +
          'text-sm text-telecab-muted hover:text-telecab-text"><i class="fa-solid fa-phone-volume"></i></a>' : '') +
        GestionIncidencia.botonLlamar(i.id, i.seguimientos) +
        GestionIncidencia.botones(i.id) +
      '</div>' +
      (i.ultimoSeguimiento
        ? '<div class="text-xs text-telecab-muted mt-1"><i class="fa-solid fa-phone mr-1"></i>' +
          i.seguimientos + ' intento(s) · último ' + esc(i.ultimoSeguimiento.quien || 'sin nombre') +
          ' · ' + hora(i.ultimoSeguimiento.at) + '</div>'
        : '') +
      '</div>';
  }

  function detalleConductor(f) {
    const inc = (f.incidencias || []).length
      ? '<div class="space-y-2">' + f.incidencias.map(incidenciaHTML).join('') + '</div>'
      : '<p class="text-sm text-telecab-muted">Sin avisos abiertos.</p>';
    return '<div class="ddet hidden px-4 pb-3">' +
      '<div class="rounded-xl border border-telecab-border bg-telecab-dark/40 p-3 space-y-3 text-sm">' +
        '<div><div class="text-[11px] uppercase tracking-wide text-telecab-muted mb-1">Avisos</div>' + inc + '</div>' +
        '<div><div class="text-[11px] uppercase tracking-wide text-telecab-muted mb-1">Trazos de hoy · ' +
          esc(f.matricula) + '</div><div class="dtrazos text-telecab-muted">Cargando trazos…</div></div>' +
      '</div></div>';
  }

  // ── Fila NN (rueda sin estar en el cuadrante) ────────────────────────────────
  function filaNN(s) {
    return '<div class="px-4 py-2.5 border-b border-telecab-border/70 flex flex-wrap items-center gap-x-4 gap-y-1">' +
      '<span class="text-telecab-text font-medium w-56 truncate">' + esc(s.conductor) + '</span>' +
      (s.conectadoAhora ? chip('Conectado ahora', 'ok') : chip('Rodó hoy', 'muted')) +
      '<span class="text-sm font-mono text-telecab-muted flex-1 min-w-[8rem]" title="Coche(s) usados en BOLT">' +
        esc((s.matriculas || []).join(', ') || '—') + '</span>' +
      '<span class="text-xs text-telecab-muted tabular-nums w-16 text-right" title="Horas conectado">' + horas(s.minutos) + ' h</span>' +
      '<span class="text-xs tabular-nums text-emerald-500 w-20 text-right" title="Km en BOLT">' + (s.enBolt || 0) + ' km</span>' +
      '<span class="text-xs tabular-nums text-amber-500 w-20 text-right" title="Km desconectado">' + (s.desconectado || 0) + ' km</span>' +
      '</div>';
  }

  // ── Trazos de un coche, bajo demanda (una vez por apertura) ──────────────────
  async function cargarTrazos(fila) {
    const caja = fila.querySelector('.dtrazos');
    if (!caja || caja.dataset.cargado) return;
    caja.dataset.cargado = '1';
    const mat = fila.querySelector('.font-mono').textContent.trim();
    try {
      const d = await (await fetch('/flota-viva/api/historial/' + encodeURIComponent(mat) + '?dias=1')).json();
      const h = (d.historial || []);
      caja.innerHTML = h.length
        ? '<div class="space-y-1">' + h.map(t =>
            '<div class="flex items-center gap-2 text-xs">' +
              '<span class="tabular-nums text-telecab-muted w-24">' + hora(t.desde) + (t.hasta ? '–' + hora(t.hasta) : '–ahora') + '</span>' +
              '<span class="text-telecab-text w-24">' + esc(t.etiqueta || t.situacion) + '</span>' +
              '<span class="text-telecab-muted">' + esc(t.duracion || '') +
                (t.conductor ? ' · ' + esc(t.conductor) : '') + '</span>' +
            '</div>').join('') + '</div>'
        : '<span class="text-telecab-muted">Sin trazos hoy.</span>';
    } catch (e) {
      caja.innerHTML = '<span class="text-red-500">No se pudieron cargar los trazos.</span>';
      caja.dataset.cargado = '';
    }
  }

  function abrirFila(fila) {
    fila.querySelector('.ddet').classList.remove('hidden');
    fila.querySelector('.dchev').classList.add('rotate-180');
    abiertos.add(fila.dataset.mat);
    cargarTrazos(fila);
  }
  function cerrarFila(fila) {
    fila.querySelector('.ddet').classList.add('hidden');
    fila.querySelector('.dchev').classList.remove('rotate-180');
    abiertos.delete(fila.dataset.mat);
  }

  // ── Pintar la lista del turno activo, agrupada POR CUADRANTE (planificador) ───
  function pintar() {
    if (!DATOS) return;
    const q = ($('#d-filtro').value || '').trim().toLowerCase();
    const p = DATOS.porTurno || {};

    if (turnoActivo === 'nn') {
      const todas = p.nn || [];
      const filas = todas.filter(s => !q ||
        (s.conductor || '').toLowerCase().includes(q) ||
        (s.matriculas || []).join(' ').toLowerCase().includes(q));
      $('#d-lista').innerHTML = filas.length
        ? filas.map(filaNN).join('')
        : '<p class="px-4 py-10 text-center text-sm text-telecab-muted">Nadie rodando sin plan. 👌</p>';
      $('#d-cuenta').textContent = (q ? filas.length + ' de ' + todas.length : todas.length) + ' conductor(es)';
      return;
    }

    const todas = p[turnoActivo] || [];
    const filas = todas.filter(f => !q ||
      (f.conductor || '').toLowerCase().includes(q) ||
      (f.matricula || '').toLowerCase().includes(q));

    if (!filas.length) {
      $('#d-lista').innerHTML = '<p class="px-4 py-10 text-center text-sm text-telecab-muted">Nadie en este turno.</p>';
      $('#d-cuenta').textContent = '0 conductor(es)';
      $('#d-lista').__wire = null;
      return;
    }

    // Agrupar por cuadrante (planificador). Sin cuadrante van al final.
    const grupos = new Map();
    filas.forEach(f => {
      const k = f.cuadrante || '(sin cuadrante)';
      if (!grupos.has(k)) grupos.set(k, []);
      grupos.get(k).push(f);
    });
    const claves = [...grupos.keys()].sort((a, b) =>
      (a === '(sin cuadrante)') - (b === '(sin cuadrante)') || a.localeCompare(b));

    $('#d-lista').innerHTML = claves.map(k =>
      '<div class="px-4 py-1.5 bg-telecab-dark/40 border-b border-telecab-border text-xs uppercase tracking-wide text-telecab-muted flex items-center gap-2">' +
        '<i class="fa-solid fa-layer-group"></i> ' + esc(k) +
        '<span class="ml-auto normal-case">' + grupos.get(k).length + '</span></div>' +
      grupos.get(k).map(filaConductor).join('')).join('');

    $('#d-cuenta').textContent = (q ? filas.length + ' de ' + todas.length : todas.length) + ' conductor(es)';

    // Reabrir lo que estaba abierto + enganchar acordeón y botones.
    $('#d-lista').querySelectorAll('.dfila').forEach(fila => { if (abiertos.has(fila.dataset.mat)) abrirFila(fila); });
    wire();
  }

  function wire() {
    $('#d-lista').querySelectorAll('.dcab').forEach(cab =>
      cab.addEventListener('click', e => {
        if (e.target.closest('[data-just],[data-llamar],a,button')) return;
        const fila = cab.closest('.dfila');
        if (fila.querySelector('.ddet').classList.contains('hidden')) abrirFila(fila);
        else cerrarFila(fila);
      }));
    GestionIncidencia.enganchar($('#d-lista'),
      id => {
        for (const t of ['dia', 'noche', 'todoturno']) {
          for (const f of ((DATOS.porTurno || {})[t] || [])) {
            const i = (f.incidencias || []).find(x => x.id === id);
            if (i) return i;
          }
        }
        return { id };
      },
      () => cargar());
  }

  async function cargar() {
    try {
      const d = await (await fetch('/control/api/directo')).json();
      if (d.status !== 'ok') throw new Error(d.msg || 'No se pudo cargar');
      DATOS = d;

      const falta = [];
      if (!d.hayCuadrante) falta.push('el cuadrante');
      if (!d.hayFlotaViva) falta.push('la flota viva');
      const av = $('#d-aviso');
      if (falta.length) {
        av.className = 'mb-3 px-3 py-2 rounded-xl border border-amber-500/40 bg-amber-500/10 text-sm text-amber-600';
        av.innerHTML = '<i class="fa-solid fa-triangle-exclamation mr-1"></i> No responde ' + falta.join(' ni ') + '. Se muestra lo demás.';
      } else { av.className = 'hidden'; }

      pintarTabs();
      pintar();
      $('#d-actualizado').innerHTML = 'Flota hoy <b class="text-telecab-text tabular-nums">' +
        ((d.resumen && d.resumen.kmHoy) || 0) + ' km</b> · ' + ((d.resumen && d.resumen.conectados) || 0) + ' conectados · ' +
        '<span class="' + ((d.resumen && d.resumen.alertas) ? 'text-red-500' : '') + '">' +
          ((d.resumen && d.resumen.alertas) || 0) + ' avisos</span> · ' +
        new Date().toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' });
    } catch (e) {
      $('#d-lista').innerHTML = '<p class="px-4 py-10 text-center text-sm text-red-500">' + esc(e.message) + '</p>';
    }
  }

  GestionIncidencia.cargar();
  cargar();
  $('#d-filtro').addEventListener('input', pintar);
  $('#d-refrescar').addEventListener('click', cargar);

  // Auto-refresco cada 45 s, salvo con una fila abierta (se estaría trabajando con ella).
  setInterval(() => { if (abiertos.size === 0) cargar(); }, 45000);
})();
</script>
