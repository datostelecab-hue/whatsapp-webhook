<div class="p-4 lg:p-6 max-w-5xl mx-auto space-y-5">

  <!-- Contadores -->
  <div class="grid grid-cols-3 gap-3">
    <div class="bg-telecab-card border border-telecab-border rounded-2xl px-4 py-3">
      <p class="text-[11px] uppercase tracking-wide text-telecab-muted">Pendientes en BOLT</p>
      <p id="c-pend" class="text-2xl font-bold text-telecab-gold">–</p>
    </div>
    <div class="bg-telecab-card border border-telecab-border rounded-2xl px-4 py-3">
      <p class="text-[11px] uppercase tracking-wide text-telecab-muted">Aprobados → RRHH</p>
      <p id="c-aprob" class="text-2xl font-bold text-telecab-green">–</p>
    </div>
    <div class="bg-telecab-card border border-telecab-border rounded-2xl px-4 py-3">
      <p class="text-[11px] uppercase tracking-wide text-telecab-muted">Rechazados</p>
      <p id="c-rech" class="text-2xl font-bold text-telecab-red">–</p>
    </div>
  </div>

  <!-- Aviso + conciliar -->
  <div class="bg-telecab-card border border-telecab-border rounded-2xl p-4 flex items-start gap-3">
    <i class="fa-solid fa-circle-info text-telecab-gold mt-0.5"></i>
    <div class="flex-1 text-sm text-telecab-muted">
      BOLT no avisa por la API cuando <b class="text-telecab-text">rechaza</b> a un conductor.
      Revisa esta lista a diario en la plataforma de BOLT: al que veas rechazado, márcalo aquí.
      A los aprobados los detecta el cron solo (cada 30 min).
    </div>
    <button id="btn-conciliar" class="shrink-0 px-3 py-2 rounded-xl bg-telecab-card2 border border-telecab-border text-telecab-text hover:border-telecab-gold transition text-sm">
      <i class="fa-solid fa-rotate mr-1"></i> Conciliar ahora
    </button>
  </div>

  <!-- Lista pendientes -->
  <div class="bg-telecab-card border border-telecab-border rounded-2xl p-4">
    <h2 class="text-sm font-semibold text-telecab-text mb-3 flex items-center gap-2">
      <i class="fa-solid fa-hourglass-half text-telecab-gold"></i> Esperando aprobación de BOLT
    </h2>
    <div id="lista-pend" class="space-y-1.5"><p class="text-telecab-muted text-sm">Cargando…</p></div>
  </div>

  <!-- Aprobados recientes (esperando a RRHH) -->
  <div class="bg-telecab-card border border-telecab-border rounded-2xl p-4">
    <h2 class="text-sm font-semibold text-telecab-text mb-3 flex items-center gap-2">
      <i class="fa-solid fa-circle-check text-telecab-green"></i> Aprobados en BOLT — pendientes de RRHH
    </h2>
    <div id="lista-aprob" class="space-y-1.5"><p class="text-telecab-muted text-sm">Cargando…</p></div>
  </div>

</div>

<script>
  const $ = s => document.querySelector(s);

  function dias(fechaApto) {
    const m = String(fechaApto || '').match(/(\d{2})\/(\d{2})\/(\d{4})(?:\s+(\d{2}):(\d{2}))?/);
    if (!m) return null;
    const t = Date.UTC(+m[3], +m[2] - 1, +m[1], +(m[4] || 0), +(m[5] || 0));
    return Math.floor((Date.now() - t) / 86400000);
  }
  function chipDias(d) {
    if (d == null) return '';
    const color = d >= 7 ? 'text-telecab-red bg-telecab-red/10'
                : d >= 3 ? 'text-telecab-gold bg-telecab-gold/10'
                : 'text-telecab-muted bg-telecab-dark/40';
    const txt = d === 0 ? 'hoy' : d === 1 ? '1 día' : d + ' días';
    return `<span class="text-[11px] px-2 py-0.5 rounded-full ${color} whitespace-nowrap">${txt}</span>`;
  }

  async function api(url, body) {
    const r = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body || {}) });
    return r.json();
  }

  function filaPend(t) {
    const el = document.createElement('div');
    el.className = 'flex items-center gap-3 px-3 py-2.5 rounded-xl bg-telecab-dark/40 border border-transparent';
    el.innerHTML =
      `<span class="w-8 h-8 rounded-lg bg-telecab-gold/15 text-telecab-gold flex items-center justify-center shrink-0"><i class="fa-solid fa-user-clock"></i></span>
       <span class="min-w-0 flex-1">
         <span class="block text-sm text-telecab-text truncate">${t.nombre || '<span class=\"text-telecab-muted\">(sin nombre)</span>'}</span>
         <span class="block text-xs text-telecab-muted font-mono">${t.id}${t.zona ? ' · ' + t.zona : ''}${t.canal ? ' · ' + t.canal : ''}</span>
       </span>
       ${chipDias(dias(t.fecha_apto))}
       <button data-rech="${t.id}" class="shrink-0 px-2.5 py-1.5 rounded-lg text-telecab-red hover:bg-telecab-red/10 border border-telecab-red/30 text-xs transition">Rechazado</button>`;
    el.querySelector('[data-rech]').addEventListener('click', async () => {
      const motivo = prompt('Motivo del rechazo en BOLT (opcional):') || '';
      const r = await api('/pendientes-bolt/rechazar', { tel: t.id, motivo });
      if (r.status === 'ok') cargar(); else alert(r.msg || 'Error');
    });
    return el;
  }

  function filaAprob(t) {
    const el = document.createElement('div');
    el.className = 'flex items-center gap-3 px-3 py-2.5 rounded-xl bg-telecab-dark/40';
    el.innerHTML =
      `<span class="w-8 h-8 rounded-lg bg-telecab-green/15 text-telecab-green flex items-center justify-center shrink-0"><i class="fa-solid fa-user-check"></i></span>
       <span class="min-w-0 flex-1">
         <span class="block text-sm text-telecab-text truncate">${t.nombre || '<span class=\"text-telecab-muted\">(sin nombre)</span>'}</span>
         <span class="block text-xs text-telecab-muted font-mono">${t.id}${t.fecha_deteccion ? ' · detectado ' + t.fecha_deteccion : ''}</span>
       </span>
       <span class="text-[11px] px-2 py-0.5 rounded-full bg-telecab-green/10 text-telecab-green whitespace-nowrap">→ RRHH</span>`;
    return el;
  }

  async function cargar() {
    const r = await (await fetch('/pendientes-bolt/api/datos')).json();
    if (r.status !== 'ok') return;
    $('#c-pend').textContent = r.contadores.pendientes;
    $('#c-aprob').textContent = r.contadores.aprobados;
    $('#c-rech').textContent = r.contadores.rechazados;

    const cp = $('#lista-pend'); cp.innerHTML = '';
    if (!r.pendientes.length) cp.innerHTML = '<p class="text-telecab-muted text-sm">Nadie esperando aprobación.</p>';
    else r.pendientes
      .sort((a, b) => (dias(b.fecha_apto) || 0) - (dias(a.fecha_apto) || 0))
      .forEach(t => cp.appendChild(filaPend(t)));

    const ca = $('#lista-aprob'); ca.innerHTML = '';
    if (!r.aprobados.length) ca.innerHTML = '<p class="text-telecab-muted text-sm">Ninguno pendiente de RRHH.</p>';
    else r.aprobados.forEach(t => ca.appendChild(filaAprob(t)));
  }

  $('#btn-conciliar').addEventListener('click', async () => {
    const btn = $('#btn-conciliar');
    btn.disabled = true; btn.innerHTML = '<i class="fa-solid fa-rotate fa-spin mr-1"></i> Conciliando…';
    const r = await api('/pendientes-bolt/conciliar');
    btn.disabled = false; btn.innerHTML = '<i class="fa-solid fa-rotate mr-1"></i> Conciliar ahora';
    if (r.status === 'ok') { cargar(); }
    else alert(r.msg || 'Error al conciliar');
  });

  cargar();
</script>
