<%
  // El cuadrante: la pantalla de Tráfico, modelada sobre el Excel de correturnos.
  // Filas por zona y coche; columnas Fijo día/noche y CT día/noche. La regla de
  // quién cubre qué día vive en la base (f_cobertura); aquí solo se pinta y se
  // colocan personas. Todo lo que se guarda vale DESDE el día que se mira.
%>

<div class="p-4 lg:p-6 max-w-[1600px] mx-auto">

  <!-- ══════════ Cabecera: fecha, KPIs y acciones ══════════ -->
  <div class="flex flex-wrap items-center gap-3 mb-4">
    <div>
      <h2 class="text-xl font-bold flex items-center gap-2">
        <i class="fa-solid fa-table-cells-large text-telecab-gold"></i>Cuadrante
      </h2>
      <p id="sub" class="text-sm text-telecab-muted mt-0.5">Cargando…</p>
    </div>

    <div class="ml-auto flex items-center gap-2">
      <button id="sem-prev" class="w-9 h-9 rounded-xl bg-telecab-card border border-telecab-border hover:border-telecab-gold/40 text-telecab-muted transition" title="Semana anterior">
        <i class="fa-solid fa-chevron-left text-xs"></i>
      </button>
      <input id="f-dia" class="js-fecha w-32 text-center px-2 py-2 bg-telecab-card border border-telecab-border rounded-xl text-sm cursor-pointer" readonly>
      <button id="sem-next" class="w-9 h-9 rounded-xl bg-telecab-card border border-telecab-border hover:border-telecab-gold/40 text-telecab-muted transition" title="Semana siguiente">
        <i class="fa-solid fa-chevron-right text-xs"></i>
      </button>
      <button id="hoy" class="px-3 py-2 rounded-xl bg-telecab-card border border-telecab-border hover:border-telecab-gold/40 text-sm transition">Hoy</button>
    </div>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 mb-5">
    <div class="bg-telecab-card border border-telecab-border rounded-2xl p-3 shadow-soft">
      <p class="text-xs text-telecab-muted uppercase tracking-wide">Coches</p>
      <p id="k-coches" class="text-xl font-bold mt-1">—</p>
    </div>
    <div class="bg-telecab-card border border-telecab-border rounded-2xl p-3 shadow-soft">
      <p class="text-xs text-telecab-muted uppercase tracking-wide">Huecos día</p>
      <p id="k-hd" class="text-xl font-bold mt-1 text-telecab-warn">—</p>
    </div>
    <div class="bg-telecab-card border border-telecab-border rounded-2xl p-3 shadow-soft">
      <p class="text-xs text-telecab-muted uppercase tracking-wide">Huecos noche</p>
      <p id="k-hn" class="text-xl font-bold mt-1 text-telecab-warn">—</p>
    </div>
    <div class="bg-telecab-card border border-telecab-border rounded-2xl p-3 shadow-soft">
      <p class="text-xs text-telecab-muted uppercase tracking-wide">CT que faltan</p>
      <p id="k-ct" class="text-xl font-bold mt-1 text-telecab-gold">—</p>
    </div>
    <div class="bg-telecab-card border border-telecab-border rounded-2xl p-3 shadow-soft">
      <p class="text-xs text-telecab-muted uppercase tracking-wide">Huérfanos</p>
      <p id="k-huerf" class="text-xl font-bold mt-1 text-telecab-red">—</p>
    </div>
    <div class="bg-telecab-card border border-telecab-border rounded-2xl p-3 shadow-soft">
      <p class="text-xs text-telecab-muted uppercase tracking-wide">Banquillo</p>
      <p id="k-banq" class="text-xl font-bold mt-1">—</p>
    </div>
  </div>

  <!-- Filtro por zona + búsqueda + avisos -->
  <div class="flex flex-wrap items-center gap-2 mb-3">
    <div class="relative">
      <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-telecab-muted text-xs"></i>
      <input id="f-busca" type="search" placeholder="Buscar conductor o matrícula…"
             class="pl-8 pr-3 py-2 w-56 bg-telecab-card border border-telecab-border rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-telecab-gold/40">
    </div>
    <select id="f-zona" class="px-3 py-2 rounded-xl bg-telecab-card border border-telecab-border text-sm">
      <option value="">Todas las zonas</option>
    </select>
    <label class="flex items-center gap-2 text-sm text-telecab-muted ml-1">
      <input type="checkbox" id="f-huecos" class="accent-telecab-gold"> Solo con huecos
    </label>
    <button id="btn-nuevo-cua" class="flex items-center gap-2 px-3 py-2 rounded-xl bg-telecab-gold text-telecab-dark font-semibold text-sm shadow-gold">
      <i class="fa-solid fa-plus"></i>Nuevo cuadrante
    </button>
    <button id="btn-avisos" class="ml-auto hidden items-center gap-2 px-3 py-2 rounded-xl bg-telecab-warn/10 border border-telecab-warn/30 text-telecab-warn text-sm">
      <i class="fa-solid fa-triangle-exclamation"></i><span id="btn-avisos-n">0</span> avisos
    </button>
  </div>

  <div class="flex flex-col xl:flex-row gap-4">

    <!-- ══════════ El cuadrante ══════════ -->
    <div class="flex-1 min-w-0">
      <div id="avisos" class="hidden mb-3"></div>
      <div id="cuadrante" class="space-y-6"></div>
      <div id="vacio" class="hidden p-10 text-center text-telecab-muted border border-telecab-border rounded-2xl">
        No hay coches que coincidan.
      </div>
    </div>

    <!-- ══════════ Columna lateral: huérfanos, emergencia, banquillo ══════════ -->
    <aside class="xl:w-80 shrink-0 space-y-4">
      <section id="panel-huerfanos" class="hidden bg-telecab-red/5 border border-telecab-red/30 rounded-2xl p-4">
        <h3 class="font-semibold text-sm text-telecab-red flex items-center gap-2 mb-2">
          <i class="fa-solid fa-user-slash"></i>Huérfanos (sin coche)
        </h3>
        <div id="huerfanos" class="space-y-1.5"></div>
      </section>

      <section id="panel-emergencia" class="hidden bg-telecab-card border border-telecab-border rounded-2xl p-4">
        <h3 class="font-semibold text-sm flex items-center gap-2 mb-2">
          <i class="fa-solid fa-car-burst text-telecab-gold"></i>Coches de emergencia
        </h3>
        <div id="emergencia" class="flex flex-wrap gap-1.5"></div>
      </section>

      <section class="bg-telecab-card border border-telecab-border rounded-2xl p-4">
        <h3 class="font-semibold text-sm flex items-center gap-2 mb-2">
          <i class="fa-solid fa-users text-telecab-muted"></i>Banquillo
          <span id="banq-n" class="ml-auto text-xs text-telecab-muted"></span>
        </h3>
        <input id="banq-busca" type="search" placeholder="Buscar…"
               class="w-full mb-2 px-3 py-1.5 bg-telecab-card2 border border-telecab-border rounded-lg text-sm">
        <div class="flex items-center gap-1.5 mb-2">
          <button data-banq-tab="todos" class="banq-tab px-2.5 py-1 rounded-lg text-xs font-semibold border transition">Todos</button>
          <button data-banq-tab="ett" class="banq-tab px-2.5 py-1 rounded-lg text-xs font-semibold border transition">Solo ETT</button>
          <button data-banq-tab="propios" class="banq-tab px-2.5 py-1 rounded-lg text-xs font-semibold border transition">Sin ETT</button>
        </div>
        <div id="banquillo" class="space-y-1 max-h-[60vh] overflow-y-auto pr-1"></div>
      </section>
    </aside>
  </div>
</div>

<script>
(function () {
  const DIAS_LETRA = <%- JSON.stringify(letrasDia) %>;              // ['L','M','X','J','V','S','D']
  const ESTADOS = <%- JSON.stringify(estadosVehiculo) %>;           // catálogo de estados del coche
  const ESTADO_ETQ = new Map(ESTADOS.map(e => [e.codigo, e.etiqueta]));
  const esc = s => String(s == null ? '' : s).replace(/[&<>"']/g, c =>
    ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

  // Tono del estado del coche. El operativo en verde; lo que sale de cobertura,
  // en rojo/ámbar. Se lee del catálogo (es_operativo), no de una lista fija.
  const TONO_ESTADO = { O: 'green', R: 'gold', T: 'violet', X: 'warn', S: 'red', E: 'gold', B: 'muted' };
  const tonoEstado = cod => TONO_ESTADO[cod] || 'muted';

  let T = null;                       // el tablero que llega del servidor
  let DIA = null;                     // fecha efectiva (AAAA-MM-DD)
  const porId = new Map();            // conductor id -> conductor

  const $ = s => document.querySelector(s);
  const pad = n => String(n).padStart(2, '0');
  const hoyISO = () => { const d = new Date(); return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`; };
  const isoAes = iso => { const [a, m, d] = iso.split('-'); return `${d}/${m}/${a}`; };
  const esAiso = txt => { const m = String(txt || '').match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/); return m ? `${m[3]}-${pad(m[2])}-${pad(m[1])}` : ''; };
  const sumarDias = (iso, n) => { const d = new Date(iso + 'T00:00:00'); d.setDate(d.getDate() + n); return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`; };

  /** [1,3] -> "L X". Vacío si no hay. */
  const diasTexto = arr => (arr || []).map(d => DIAS_LETRA[d - 1]).join(' ');
  /** libra[] (booleanos por día) -> "L M". */
  const libraTexto = libra => (libra || []).map((v, i) => v ? DIAS_LETRA[i] : null).filter(Boolean).join(' ');

  // ── Cargar ────────────────────────────────────────────────────────────────
  async function cargar(dia) {
    const q = dia ? ('?dia=' + encodeURIComponent(dia)) : '';
    const r = await fetch('/planificador-v2/api/tablero' + q);
    const j = await r.json();
    if (!r.ok || j.status === 'error') throw new Error(j.msg || 'No se pudo cargar el cuadrante');
    aplicar(j);
  }

  function aplicar(j) {
    T = j;
    DIA = j.dia;
    porId.clear();
    (j.conductores || []).forEach(c => { if (c.id) porId.set(String(c.id), c); });
    $('#f-dia').value = isoAes(j.dia);
    pintarZonas();
    pintarKpis();
    pintar();
    pintarLaterales();
    pintarAvisos(j.avisos || []);
  }

  // ── KPIs y subtítulo ────────────────────────────────────────────────────────
  function pintarKpis() {
    const r = T.resumen || {};
    $('#k-coches').textContent = r.coches ?? '—';
    $('#k-hd').textContent = r.diasSinCubrirDia ?? '—';
    $('#k-hn').textContent = r.diasSinCubrirNoche ?? '—';
    $('#k-ct').textContent = (r.ctQueFaltanDia || 0) + (r.ctQueFaltanNoche || 0);
    $('#k-huerf').textContent = (T.huerfanos || []).length;
    $('#k-banq').textContent = (T.pendientes || []).length;
    const semana = (T.fechas && T.fechas.length) ? `${isoAes(T.fechas[0])} – ${isoAes(T.fechas[6])}` : '';
    $('#sub').textContent = `Semana ${semana} · efectivo desde el ${isoAes(T.dia)}`;
  }

  function pintarZonas() {
    const sel = $('#f-zona');
    const previa = sel.value;
    // Las zonas del filtro salen de los CUADRANTES (que es como filtra el tablero) y
    // de los coches sueltos. La zona del coche a pelo suele venir vacía; la del
    // cuadrante, no: antes el desplegable salía casi vacío o con zonas que no son.
    const zonas = [...new Set([
      ...(T.cuadrantes || []).map(cu => cu.zona),
      ...(T.coches || []).filter(c => !c.cuadranteId).map(c => c.zona),
    ].filter(Boolean))].sort();
    sel.innerHTML = '<option value="">Todas las zonas</option>' +
      zonas.map(z => `<option value="${esc(z)}">${esc(z)}</option>`).join('');
    sel.value = previa;
  }

  // ── El cuadrante, por zona ───────────────────────────────────────────────────
  const plano = s => String(s || '').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
  // Un HUECO = una PLAZA VISIBLE (fijo día/noche o CT día/noche = slots 0-3) sin
  // nadie asignado. Incluye los huecos de CORRETURNOS, no solo los de fijos. (No
  // cuenta "días sin cubrir": casi todo coche tiene el finde sin CT y eso mostraba a
  // todos con "solo con huecos".)
  const tieneHueco = c => [0, 1, 2, 3].some(s => !((c.personas || [])[s] || {}).id);
  // La zona por la que filtrar es la del CUADRANTE del coche (la del coche a pelo
  // suele estar vacía); los sueltos, por la suya.
  const zonaDeCoche = (c, zc) => (c.cuadranteId && zc.get(String(c.cuadranteId))) || c.zona || '';
  function cochesVisibles() {
    const zona = $('#f-zona').value;
    const soloHuecos = $('#f-huecos').checked;
    const q = plano($('#f-busca').value).trim();
    const zc = new Map((T.cuadrantes || []).map(cu => [String(cu.id), cu.zona]));
    return (T.coches || []).filter(c => {
      if (zona && zonaDeCoche(c, zc) !== zona) return false;
      if (soloHuecos && !tieneHueco(c)) return false;
      if (q) {
        const txt = plano(c.matricula + ' ' + (c.personas || []).map(p => (p && p.nombre) || '').join(' '));
        if (!txt.includes(q)) return false;
      }
      return true;
    });
  }

  // Las 4 columnas del Excel: Fijo día/noche, CT día/noche (slots 0,1,2,3).
  const COLS = [
    { slot: 0, tit: 'Fijo día',  turno: 'dia' },
    { slot: 1, tit: 'Fijo noche', turno: 'noche' },
    { slot: 2, tit: 'CT día',    turno: 'dia' },
    { slot: 3, tit: 'CT noche',  turno: 'noche' },
  ];

  // El CT (día/noche) de un cuadrante: el ocupante de la plaza CT en sus coches.
  // Si es el mismo en todos, ese es el CT del cuadrante; si difieren, 'varios'.
  function ctDelCuadrante(lista, slot) {
    const ids = new Set();
    lista.forEach(c => { const p = (c.personas || [])[slot]; if (p && p.id) ids.add(String(p.id)); });
    if (ids.size === 1) return porId.get([...ids][0]) || null;
    return ids.size > 1 ? 'varios' : null;
  }

  // La libranza de un CT = el complemento de los días de SUS BLOQUES (su patrón:
  // la unión de los descansos de los coches donde es CT), no de lo que cubrió esa
  // semana en concreto (que depende de cuándo empezó la asignación).
  const libraCT = persona => {
    if (!persona) return '';
    const trabaja = new Set();
    (T.coches || []).forEach(c => [2, 3].forEach(slot => {
      const p = (c.personas || [])[slot];
      if (p && String(p.id) === String(persona.id)) (c.descanso || []).forEach(d => trabaja.add(Number(d)));
    }));
    return [1, 2, 3, 4, 5, 6, 7].filter(d => !trabaja.has(d)).map(d => DIAS_LETRA[d - 1]).join(' ');
  };

  function tablaCoches(lista, enCuadrante) {
    const wrap = document.createElement('div');
    wrap.className = 'overflow-x-auto border border-telecab-border rounded-2xl';
    wrap.innerHTML = `
      <table class="w-full text-sm border-collapse">
        <thead class="bg-telecab-card2 text-telecab-muted text-[11px] uppercase tracking-wide">
          <tr>
            <th class="text-left font-semibold px-3 py-2.5 whitespace-nowrap">Matrícula</th>
            <th class="text-left font-semibold px-3 py-2.5 whitespace-nowrap">Descanso</th>
            ${COLS.map(c => `<th class="text-left font-semibold px-3 py-2.5">${c.tit}</th>`).join('')}
            <th class="w-10"></th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>`;
    const tb = wrap.querySelector('tbody');
    lista.forEach(coche => tb.appendChild(filaCoche(coche, enCuadrante)));
    return wrap;
  }

  function seccionCuadrante(cu, lista) {
    const sec = document.createElement('section');
    const ctDia = ctDelCuadrante(lista, 2), ctNoche = ctDelCuadrante(lista, 3);
    const chipCT = (persona, turno) => {
      const nombre = persona === 'varios' ? 'Varios' : (persona ? persona.nombre : null);
      const libra = (persona && persona !== 'varios') ? libraCT(persona) : '';
      return `<button data-ct="${turno}" class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-semibold border transition
                ${nombre ? 'bg-telecab-violet/10 text-telecab-violet border-telecab-violet/30' : 'border-dashed border-telecab-border text-telecab-muted'} hover:border-telecab-gold/50">
              <i class="fa-solid fa-user-group"></i>CT ${turno}: ${nombre ? esc(nombre) : 'asignar'}${libra ? ` <span class="text-telecab-muted">libra ${esc(libra)}</span>` : ''}</button>`;
    };
    const cab = document.createElement('div');
    cab.className = 'flex flex-wrap items-center gap-2 mb-2';
    cab.innerHTML = `
      <h3 class="text-sm font-semibold uppercase tracking-wide text-telecab-gold flex items-center gap-2">
        <i class="fa-solid fa-object-group"></i>${esc(cu.nombre)}
        <span class="text-telecab-muted font-normal normal-case">${cu.zona ? esc(cu.zona) + ' · ' : ''}${lista.length} bloque(s)</span>
      </h3>
      <button data-bloque class="px-2.5 py-1 rounded-lg text-xs font-semibold bg-telecab-card border border-telecab-border hover:border-telecab-gold/50 transition"><i class="fa-solid fa-plus"></i> Bloque</button>
      <div class="flex items-center gap-2 ml-1">${chipCT(ctDia, 'día')}${chipCT(ctNoche, 'noche')}</div>
      <button data-borrar-cua class="ml-auto text-xs text-telecab-muted hover:text-telecab-red transition"><i class="fa-solid fa-trash"></i> borrar cuadrante</button>`;
    cab.querySelector('[data-bloque]').addEventListener('click', () => anadirBloque(cu.id));
    cab.querySelector('[data-ct="día"]').addEventListener('click', () => asignarCTCuadrante(cu.id, 'dia', lista));
    cab.querySelector('[data-ct="noche"]').addEventListener('click', () => asignarCTCuadrante(cu.id, 'noche', lista));
    cab.querySelector('[data-borrar-cua]').addEventListener('click', () => borrarCuadranteUI(cu.id, cu.nombre));
    sec.appendChild(cab);
    if (lista.length) {
      sec.appendChild(tablaCoches(lista, true));
    } else {
      const vac = document.createElement('p');
      vac.className = 'text-xs text-telecab-muted px-3 py-4 border border-dashed border-telecab-border rounded-2xl text-center';
      vac.textContent = 'Cuadrante vacío. Pulsa "Bloque" para añadir días + matrícula.';
      sec.appendChild(vac);
    }
    return sec;
  }

  function seccionSueltos(lista) {
    const sec = document.createElement('section');
    const cab = document.createElement('h3');
    cab.className = 'text-sm font-semibold uppercase tracking-wide text-telecab-muted mb-2 flex items-center gap-2';
    cab.innerHTML = `<i class="fa-solid fa-car-side"></i>Coches sueltos <span class="font-normal normal-case">${lista.length}</span>`;
    sec.appendChild(cab);
    sec.appendChild(tablaCoches(lista, false));
    return sec;
  }

  function pintar() {
    const cont = $('#cuadrante');
    const zona = $('#f-zona').value;
    const coches = cochesVisibles();

    // Coches por cuadrante; los sueltos aparte.
    const porCua = new Map(); const sueltos = [];
    coches.forEach(c => {
      if (c.cuadranteId) { const k = String(c.cuadranteId); if (!porCua.has(k)) porCua.set(k, []); porCua.get(k).push(c); }
      else sueltos.push(c);
    });

    // TODOS los cuadrantes (incluidos los vacíos, recién creados), filtrados por
    // zona. Al buscar, solo los que tengan coches que coincidan (los vacíos se ocultan).
    // Al FILTRAR (buscando o solo-huecos), un cuadrante sin coches que pasen el filtro
    // se oculta: si no, salía como "vacío" y parecía que el filtro no hacía nada. Con
    // solo el filtro de zona, los vacíos de esa zona siguen (para poder añadir bloques).
    const buscando = !!plano($('#f-busca').value).trim();
    const filtrando = buscando || $('#f-huecos').checked;
    const cuadrantes = (T.cuadrantes || []).filter(cu =>
      (!zona || cu.zona === zona) && (!filtrando || (porCua.get(String(cu.id)) || []).length));

    const hayAlgo = cuadrantes.length || sueltos.length;
    $('#vacio').classList.toggle('hidden', hayAlgo > 0);
    cont.classList.toggle('hidden', !hayAlgo);

    cont.innerHTML = '';
    cuadrantes.forEach(cu => cont.appendChild(seccionCuadrante(cu, porCua.get(String(cu.id)) || [])));
    if (sueltos.length) cont.appendChild(seccionSueltos(sueltos));
  }

  function filaCoche(coche, enCuadrante) {
    const tr = document.createElement('tr');
    tr.className = 'border-t border-telecab-border/70 align-top';
    const tono = tonoEstado(coche.estadoVeh);

    // Celda de matrícula + estado.
    const tdMat = document.createElement('td');
    tdMat.className = 'px-3 py-2.5 whitespace-nowrap';
    tdMat.innerHTML = `
      <div class="font-semibold">${esc(coche.matricula)}</div>
      <button class="mt-1 inline-flex items-center gap-1 px-2 py-0.5 rounded-lg text-xs font-semibold
                     bg-telecab-${tono}/15 text-telecab-${tono} border border-telecab-${tono}/30 hover:bg-telecab-${tono}/25 transition"
              data-estado>${esc(ESTADO_ETQ.get(coche.estadoVeh) || coche.estadoVeh)}<i class="fa-solid fa-chevron-down text-[9px]"></i></button>`;
    tdMat.querySelector('[data-estado]').addEventListener('click', () => cambiarEstado(coche));
    // Taller/siniestro: el coche se queda en su bloque, pero avisa de que hay que
    // cambiar la matrícula ahí (sus conductores quedan "huérfanos imaginarios").
    if (!coche.visibleCobertura) {
      tr.classList.add('bg-telecab-red/5');
      const tieneGente = (coche.personas || []).some(p => p && p.id);
      const b = document.createElement('button');
      b.className = 'mt-1 block text-[11px] text-telecab-red font-semibold hover:underline';
      b.innerHTML = tieneGente
        ? '<i class="fa-solid fa-triangle-exclamation"></i> cambiar matrícula aquí'
        : '<i class="fa-solid fa-triangle-exclamation"></i> fuera de cobertura';
      if (tieneGente) {
        b.title = 'Mete una matrícula de emergencia y hereda el bloque (cuadrante, días y tripulación)';
        b.addEventListener('click', () => reemplazarMatriculaUI(coche));
      } else {
        b.className = 'mt-1 block text-[11px] text-telecab-red';
      }
      tdMat.appendChild(b);
    }
    tr.appendChild(tdMat);

    // Descanso del coche (el bloque): vive en el coche. Sus fijos libran esos
    // días. Editable siempre (es del coche, no del fijo).
    const descTxt = (coche.descanso && coche.descanso.length) ? diasTexto(coche.descanso) : '';
    const tdDesc = document.createElement('td');
    tdDesc.className = 'px-3 py-2.5 whitespace-nowrap';
    tdDesc.innerHTML = `
      <button class="px-2 py-1 rounded-lg text-xs font-semibold border transition hover:border-telecab-gold/50
                     ${descTxt ? 'bg-telecab-gold/10 text-telecab-gold border-telecab-gold/30' : 'border-dashed border-telecab-border text-telecab-muted'}"
              data-desc title="Editar el descanso del coche (día y noche)">
        ${descTxt ? esc(descTxt) : 'sin descanso'}
      </button>`;
    tdDesc.querySelector('[data-desc]').addEventListener('click', () => fijarDescansoCoche(coche));
    tr.appendChild(tdDesc);

    // Las 4 columnas de puestos.
    COLS.forEach(col => {
      const p = (coche.personas || [])[col.slot] || {};
      const td = document.createElement('td');
      td.className = 'px-3 py-2.5';
      td.appendChild(celdaPuesto(coche, p, col));
      tr.appendChild(td);
    });

    // Acciones del coche.
    const tdAcc = document.createElement('td');
    tdAcc.className = 'px-2 py-2.5 text-right whitespace-nowrap';
    tdAcc.innerHTML = `
      <button class="w-8 h-8 rounded-lg text-telecab-muted hover:bg-telecab-card2 hover:text-telecab-gold transition" data-cua
              title="${enCuadrante ? 'Sacar del cuadrante' : 'Meter en un cuadrante'}"><i class="fa-solid ${enCuadrante ? 'fa-object-ungroup' : 'fa-object-group'}"></i></button>
      <button class="w-8 h-8 rounded-lg text-telecab-muted hover:bg-telecab-card2 hover:text-telecab-gold transition" data-cambiar
              title="Cambiar de coche (llevarse la tripulación)"><i class="fa-solid fa-right-left"></i></button>`;
    tdAcc.querySelector('[data-cua]').addEventListener('click', () => enCuadrante ? sacarDeCuadrante(coche) : meterEnCuadrante(coche));
    tdAcc.querySelector('[data-cambiar]').addEventListener('click', () => cambiarCoche(coche));
    tr.appendChild(tdAcc);

    return tr;
  }

  // El aviso de ausencia de un conductor: vacaciones (libera la plaza -> hueco),
  // baja/permiso (alerta, sigue asignado), o una ausencia que entra pronto.
  function avisoAusencia(c) {
    if (!c) return null;
    if (c.ausente) {
      const vuelve = c.vuelveEl && c.vuelveEl <= sumarDias(DIA, 7) ? ` · vuelve ${isoAes(c.vuelveEl)}` : '';
      // Cualquier ausente deja el dia sin cubrir (hueco); el tachado (se quita del
      // cuadrante) es solo para las que liberan la plaza, como vacaciones.
      return { tono: c.liberaPlaza ? 'red' : 'warn', texto: c.estado + vuelve, hueco: true, tachado: !!c.liberaPlaza };
    }
    if (c.proxAusencia && c.proxAusencia.desde && c.proxAusencia.desde <= sumarDias(DIA, 7)) {
      return { tono: 'gold', texto: `entra en ${String(c.proxAusencia.estado || '').toLowerCase()} el ${isoAes(c.proxAusencia.desde)}`, hueco: false };
    }
    return null;
  }

  function celdaPuesto(coche, p, col) {
    const esFijo = p.rol === 'FIJO' || col.slot < 2;
    const wrap = document.createElement('div');
    const persona = p.id ? porId.get(String(p.id)) : null;

    // Aviso del PRÓXIMO DUEÑO: quien tiene esta plaza reservada para más adelante.
    // Se ve aunque ahora esté vacía o con un temporal ("→ Carlos · llega el 12/09").
    const fut = p.futuro
      ? `<span class="block text-[11px] text-telecab-gold font-semibold mt-0.5"><i class="fa-solid fa-arrow-right-long"></i> ${esc(p.futuro.nombre)} · llega ${isoAes(p.futuro.desde)}</span>`
      : '';

    if (p.id) {
      // Sub-línea: para el fijo, los días que libra; para el CT, sus días.
      let sub = '';
      if (esFijo) sub = 'libra ' + (diasTexto(coche.descanso) || '—');
      else if (!esFijo) {
        const dias = (p.diasManual || []).some(Boolean)
          ? (p.diasManual || []).map((v, i) => v ? DIAS_LETRA[i] : null).filter(Boolean).join(' ')
          : diasTexto((p.diasSugeridos || []).map(d => d + 1));
        sub = dias ? ('días ' + dias) : 'sin días';
      }
      const ett = persona && persona.esEtt ? ' <span class="text-telecab-violet">ETT</span>' : '';
      const av = avisoAusencia(persona);
      const nombreCls = av && av.tachado ? 'line-through text-telecab-muted' : 'font-medium group-hover:text-telecab-gold';
      wrap.innerHTML = `
        <button class="text-left w-full group" data-asignar>
          <span class="${nombreCls} transition">${esc(persona ? persona.nombre : p.nombre)}${ett}</span>
          <span class="block text-xs text-telecab-muted">${esc(sub)}</span>
          ${av ? `<span class="block text-[11px] text-telecab-${av.tono} font-semibold"><i class="fa-solid fa-triangle-exclamation"></i> ${esc(av.texto)}${av.hueco ? ' · sin cubrir' : ''}</span>` : ''}
          ${fut}
        </button>`;
      wrap.querySelector('[data-asignar]').addEventListener('click', () => asignar(coche, p, col));
    } else {
      // Un hueco tiene que SALTAR a la vista para localizarlos rápido: fondo tintado
      // + icono de aviso. El fijo vacío en rojo (crítico); el CT vacío en ámbar.
      const cls = esFijo
        ? 'border-telecab-red/60 bg-telecab-red/10 text-telecab-red'
        : 'border-telecab-warn/60 bg-telecab-warn/10 text-telecab-warn';
      wrap.innerHTML = `
        <button class="text-left w-full px-2 py-1 rounded-lg border border-dashed font-semibold transition ${cls} hover:brightness-110"
                data-asignar>
          <i class="fa-solid fa-triangle-exclamation text-xs"></i> ${esFijo ? 'Hueco · sin fijo' : 'Hueco · colocar CT'}
        </button>
        ${fut}`;
      wrap.querySelector('[data-asignar]').addEventListener('click', () => asignar(coche, p, col));
    }

    // En un fijo colocado, atajo a la libranza excepcional.
    if (esFijo && p.id) {
      const b = document.createElement('button');
      b.className = 'mt-1 text-[11px] text-telecab-muted hover:text-telecab-gold transition';
      b.innerHTML = '<i class="fa-solid fa-calendar-day"></i> libranza excepcional';
      b.addEventListener('click', () => libranzaExcepcional(persona || { id: p.id, nombre: p.nombre }));
      wrap.appendChild(b);
    }
    return wrap;
  }

  // ── Paneles laterales ─────────────────────────────────────────────────────
  function pintarLaterales() {
    // Huérfanos
    const huerf = T.huerfanos || [];
    $('#panel-huerfanos').classList.toggle('hidden', huerf.length === 0);
    $('#huerfanos').innerHTML = huerf.map(h => `
      <div class="flex items-center gap-2 px-2 py-1.5 rounded-lg bg-telecab-card border border-telecab-border">
        <div class="min-w-0 flex-1">
          <div class="text-sm font-medium truncate">${esc(h.conductor)}</div>
          <div class="text-[11px] text-telecab-muted">${esc(h.matricula)} · ${esc(h.estado)} · ${esc(h.turno)}</div>
        </div>
      </div>`).join('');

    // Emergencia
    const emer = T.emergencia || [];
    $('#panel-emergencia').classList.toggle('hidden', emer.length === 0);
    $('#emergencia').innerHTML = emer.map(e => `
      <span class="inline-flex items-center gap-1 px-2 py-1 rounded-lg text-xs font-semibold bg-telecab-gold/10 text-telecab-gold border border-telecab-gold/30">
        <i class="fa-solid fa-car-side"></i>${esc(e.matricula)}${e.zona ? ` <span class="text-telecab-muted">${esc(e.zona)}</span>` : ''}
      </span>`).join('');

    pintarBanquillo();
  }

  let banqTab = 'todos';   // todos | ett | propios
  function pintarBanquillo() {
    const q = ($('#banq-busca').value || '').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
    const gente = (T.pendientes || []).filter(p => {
      if (banqTab === 'ett' && !p.esEtt) return false;
      if (banqTab === 'propios' && p.esEtt) return false;
      if (!q) return true;
      const t = (p.nombre + ' ' + (p.dni || '') + ' ' + (p.ettNombre || '')).toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
      return t.includes(q);
    });
    document.querySelectorAll('.banq-tab').forEach(b => {
      const on = b.dataset.banqTab === banqTab;
      b.className = 'banq-tab px-2.5 py-1 rounded-lg text-xs font-semibold border transition ' +
        (on ? 'bg-telecab-gold text-telecab-dark border-telecab-gold' : 'bg-telecab-card border-telecab-border text-telecab-muted hover:border-telecab-gold/40');
    });
    $('#banq-n').textContent = `${gente.length}/${(T.pendientes || []).length}`;
    $('#banquillo').innerHTML = gente.length ? gente.map(p => `
      <div class="px-2 py-1.5 rounded-lg bg-telecab-card2/50 border border-telecab-border">
        <div class="text-sm font-medium truncate">${esc(p.nombre)}${p.esEtt ? ` <span class="text-telecab-violet text-xs">ETT${p.ettNombre ? ' ' + esc(p.ettNombre) : ''}</span>` : ''}</div>
        <div class="text-[11px] text-telecab-muted">${esc(p.turno || 'sin turno')}${p.contrato ? ' · ' + esc(p.contrato) : ''}${p.boltPendiente ? ' · <span class="text-telecab-warn">sin BOLT</span>' : ''}</div>
        ${p.ausente ? `<div class="text-[11px] text-telecab-warn"><i class="fa-solid fa-plane-departure"></i> ${esc(p.estado)}${p.vuelveEl ? ` · vuelve ${isoAes(p.vuelveEl)}` : ''}</div>` : ''}
      </div>`).join('') : '<p class="text-xs text-telecab-muted text-center py-4">Nadie en el banquillo.</p>';
  }

  function pintarAvisos(avisos) {
    const btn = $('#btn-avisos');
    btn.classList.toggle('hidden', !avisos.length);
    btn.classList.toggle('flex', avisos.length > 0);
    $('#btn-avisos-n').textContent = avisos.length;
    const cont = $('#avisos');
    if (!avisos.length) { cont.classList.add('hidden'); return; }
    cont.innerHTML = `
      <div class="rounded-2xl border border-telecab-warn/30 bg-telecab-warn/5 p-3">
        <ul class="space-y-1 text-sm">${avisos.map(a => `<li class="flex items-start gap-2"><i class="fa-solid fa-circle text-[5px] mt-2 text-telecab-warn"></i><span>${esc(a.msg)}</span></li>`).join('')}</ul>
      </div>`;
  }

  // ── Acciones ─────────────────────────────────────────────────────────────
  async function guardarCambios(cambios) {
    const r = await fetch('/planificador-v2/api/guardar', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ dia: DIA, cambios }),
    });
    const j = await r.json();
    if (!r.ok || j.status === 'error') throw new Error(j.msg || 'No se pudo guardar');
    if (j.tablero) aplicar(j.tablero);
    return j;
  }

  // Colocar / cambiar / quitar a alguien en un puesto.
  async function asignar(coche, p, col) {
    if (!p.plazaId) { await Dialogo.aviso({ titulo: 'Recarga', texto: 'Esta plaza no existe todavía en la base. Recarga el cuadrante.', tono: 'aviso' }); return; }
    // Si la plaza tiene DUEÑO FUTURO, se recuerda en el título: estás planificando
    // "mientras llega él".
    const tit = `${col.tit} · ${coche.matricula}` +
      (p.futuro ? ` · llega ${(p.futuro.nombre || '').split(' ')[0]} el ${isoAes(p.futuro.desde)}` : '');
    const id = await pickConductor({ titulo: tit, turno: col.turno, actual: p.id ? String(p.id) : null });
    if (id === undefined) return;   // cancelado

    // Colocando a alguien (no quitando) sobre una plaza con dueño futuro: se ofrece un
    // "hasta" OPCIONAL. Vacío = el auto-corte lo cierra la víspera de que llegue el dueño.
    let hasta = null;
    if (id && p.futuro) {
      const v = await Dialogo.formulario(`Mientras llega ${p.futuro.nombre}`, [
        { id: 'hasta', etiqueta: 'Hasta (último día, opcional)', tipo: 'fecha',
          ayuda: `Vacío = hasta la víspera de que llegue ${p.futuro.nombre} (${isoAes(p.futuro.desde)}).` },
      ], { textoBoton: 'Colocar' });
      if (v === undefined || v === null) return;   // cancelado
      hasta = (v.hasta || '').trim() || null;
    }
    try {
      const slot = { plazaId: p.plazaId, id: id || '' };
      if (hasta) slot.hasta = hasta;
      await guardarCambios([{ vehiculoId: coche.vehiculoId, slots: [slot] }]);
    } catch (e) { alert(e.message); }
  }

  async function cambiarEstado(coche) {
    const opciones = ESTADOS.map(e => ({ valor: e.codigo, texto: e.etiqueta }));
    const cod = await Dialogo.elegir({
      titulo: `Estado de ${coche.matricula}`,
      texto: 'Vale desde el día que estás mirando. Un coche que sale de cobertura deja a su gente en huérfanos.',
      opciones,
    });
    if (!cod || cod === coche.estadoVeh) return;
    try {
      await guardarCambios([{ vehiculoId: coche.vehiculoId, estadoVeh: cod }]);
    } catch (e) { alert(e.message); }
  }

  // Taller/siniestro: la matrícula nueva (de emergencia) hereda el bloque entero.
  async function reemplazarMatriculaUI(coche) {
    const emergencia = (T.emergencia || []).map(e => ({ vehiculoId: e.vehiculoId, matricula: e.matricula, zona: e.zona }));
    if (!emergencia.length) { await Dialogo.aviso({ titulo: 'Sin coches de emergencia', texto: 'No hay ninguna matrícula libre (sin nadie) para meter aquí.', tono: 'aviso' }); return; }
    const destino = await pickCoche({ titulo: `Matrícula de emergencia para ${coche.matricula}`, coches: emergencia });
    if (!destino) return;
    const ok = await Dialogo.confirmar({
      titulo: `Reemplazar ${coche.matricula}`, si: 'Reemplazar', no: 'Cancelar',
      html: `<p>La matrícula nueva hereda el <b>cuadrante</b>, los <b>días</b> y la <b>tripulación</b>. ${esc(coche.matricula)} queda libre (en el taller).</p>`,
    });
    if (!ok) return;
    try {
      await pedirTablero('/planificador-v2/api/reemplazar-matricula', { de: coche.vehiculoId, a: destino, dia: DIA });
    } catch (e) { alert(e.message); }
  }

  async function cambiarCoche(coche, soloEmergencia) {
    // La matrícula nueva SOLO puede ser una que no tenga a nadie (de emergencia):
    // si llevara gente, moverla la dejaría sin sitio. Por eso, para el cambio de
    // un coche en taller/siniestro, solo se ofrecen las de emergencia.
    const emergencia = (T.emergencia || []).map(e => ({ vehiculoId: e.vehiculoId, matricula: e.matricula, zona: e.zona }));
    if (soloEmergencia && !emergencia.length) {
      await Dialogo.aviso({ titulo: 'Sin coches de emergencia', texto: 'No hay ninguna matrícula libre (sin nadie asignado) para meter aquí.', tono: 'aviso' });
      return;
    }
    const otros = soloEmergencia ? emergencia
      : (T.coches || []).filter(c => c.vehiculoId !== coche.vehiculoId)
          .concat(emergencia.map(e => ({ ...e, matricula: e.matricula + ' (emergencia)' })));
    const destino = await pickCoche({
      titulo: soloEmergencia ? `Matrícula de emergencia para ${coche.matricula}` : `Mover la tripulación de ${coche.matricula} a…`,
      coches: otros,
    });
    if (!destino) return;
    try {
      const r = await fetch('/planificador-v2/api/cambiar-coche', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ de: coche.vehiculoId, a: destino, dia: DIA }),
      });
      const j = await r.json();
      if (!r.ok || j.status === 'error') {
        if (j.ocupantes) {
          const ok = await Dialogo.confirmar({ titulo: 'El coche de destino lleva gente', tono: 'aviso', si: 'Quitarles la plaza y mover', no: 'Cancelar', html: `<p>${esc(j.ocupantes.join(', '))}</p>` });
          if (!ok) return;
          const r2 = await fetch('/planificador-v2/api/cambiar-coche', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ de: coche.vehiculoId, a: destino, dia: DIA, forzar: true }),
          });
          const j2 = await r2.json();
          if (!r2.ok || j2.status === 'error') throw new Error(j2.msg);
          if (j2.tablero) aplicar(j2.tablero);
          return;
        }
        throw new Error(j.msg);
      }
      if (j.tablero) aplicar(j.tablero);
    } catch (e) { alert(e.message); }
  }

  async function libranzaExcepcional(persona) {
    const lunes = T.fechas[0], domingo = T.fechas[6];
    const datos = await Dialogo.formulario(
      `Libranza excepcional · ${persona.nombre}`,
      [
        { id: 'trabaja', etiqueta: 'Trabaja el día (que normalmente libra)', tipo: 'fecha', obligatorio: true, ayuda: `Entre ${isoAes(lunes)} y ${isoAes(domingo)}` },
        { id: 'libra', etiqueta: 'Libra el día (que normalmente trabaja)', tipo: 'fecha', obligatorio: true },
        { id: 'motivo', etiqueta: 'Motivo', tipo: 'texto' },
      ],
      { nota: 'Cambia, solo esta semana, un día de libranza por uno de trabajo. La semana siguiente vuelve a la normalidad.' }
    );
    if (!datos) return;
    // `formulario` ya devuelve las fechas en ISO (aaaa-mm-dd).
    const diaTrabaja = datos.trabaja, diaLibra = datos.libra;
    if (!diaTrabaja || !diaLibra) { alert('Faltan las fechas'); return; }
    if (diaTrabaja < lunes || diaTrabaja > domingo || diaLibra < lunes || diaLibra > domingo) {
      alert('Los dos días tienen que ser de la semana que estás mirando'); return;
    }
    try {
      const r = await fetch('/planificador-v2/api/libranza-excepcional', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ conductorId: persona.id, diaTrabaja, diaLibra, motivo: datos.motivo, dia: DIA }),
      });
      const j = await r.json();
      if (!r.ok || j.status === 'error') throw new Error(j.msg || 'No se pudo guardar');
      if (j.tablero) aplicar(j.tablero);
    } catch (e) { alert(e.message); }
  }

  // ── Cuadrantes ────────────────────────────────────────────────────────────
  async function pedirTablero(url, body, metodo) {
    const r = await fetch(url, {
      method: metodo || 'POST', headers: { 'Content-Type': 'application/json' },
      body: body ? JSON.stringify(body) : undefined,
    });
    const j = await r.json();
    if (!r.ok || j.status === 'error') throw new Error(j.msg || 'No se pudo guardar');
    if (j.tablero) aplicar(j.tablero);
    return j;
  }

  async function nuevoCuadrante() {
    const zonas = (T.zonas || []).map(z => ({ valor: String(z.id), texto: z.nombre }));
    if (!zonas.length) { await Dialogo.aviso({ titulo: 'Sin zonas', texto: 'No hay zonas dadas de alta.', tono: 'aviso' }); return null; }
    const datos = await Dialogo.formulario('Nuevo cuadrante',
      [{ id: 'zona', etiqueta: 'Zona', tipo: 'lista', opciones: zonas, obligatorio: true }],
      { nota: 'El número se asigna solo. Después le añades los bloques (días + matrícula).' });
    if (!datos || !datos.zona) return null;
    try {
      const r = await fetch('/planificador-v2/api/cuadrantes', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ zonaId: Number(datos.zona) }),
      });
      const j = await r.json();
      if (!r.ok || j.status === 'error') throw new Error(j.msg || 'No se pudo crear');
      await cargar(DIA);   // refresca cuadrantes/zonas en el payload
      return j.id ? String(j.id) : null;
    } catch (e) { alert(e.message); return null; }
  }

  // Añadir un bloque: días (checkbox) + matrícula. La matrícula sale de los
  // coches sin cuadrante y del pool de emergencia (los que no tienen a nadie).
  async function anadirBloque(cuadranteId) {
    const dias = await editarDescanso({ titulo: 'Días del bloque', actual: [] });
    if (dias === undefined) return;
    if (!dias.length) { alert('Elige al menos un día'); return; }
    const candidatos = [
      ...(T.coches || []).filter(c => !c.cuadranteId).map(c => ({ vehiculoId: c.vehiculoId, matricula: c.matricula, zona: c.zona })),
      ...(T.emergencia || []).map(c => ({ vehiculoId: c.vehiculoId, matricula: c.matricula, zona: c.zona })),
    ];
    const vistos = new Set(); const unicos = candidatos.filter(c => !vistos.has(c.vehiculoId) && vistos.add(c.vehiculoId));
    const vehiculoId = await pickCoche({ titulo: `Matrícula del bloque ${dias.map(d => DIAS_LETRA[d - 1]).join('/')}`, coches: unicos });
    if (!vehiculoId) return;
    try {
      await pedirTablero('/planificador-v2/api/cuadrante/bloque', { cuadranteId, vehiculoId, dias, dia: DIA });
    } catch (e) { alert(e.message); }
  }

  async function meterEnCuadrante(coche) {
    const opciones = (T.cuadrantes || []).map(c => ({ valor: c.id, texto: `${c.nombre}${c.zona ? ' · ' + c.zona : ''} (${c.coches})` }));
    opciones.push({ valor: '__nuevo__', texto: '＋ Nuevo cuadrante…' });
    const elegido = await Dialogo.elegir({ titulo: `Meter ${coche.matricula} en un cuadrante`, opciones });
    if (!elegido) return;
    let id = elegido;
    if (elegido === '__nuevo__') { id = await nuevoCuadrante(); if (!id) return; }
    try {
      await pedirTablero('/planificador-v2/api/cuadrante/coche', { vehiculoId: coche.vehiculoId, cuadranteId: id, dia: DIA });
    } catch (e) { alert(e.message); }
  }

  async function sacarDeCuadrante(coche) {
    try {
      await pedirTablero('/planificador-v2/api/cuadrante/coche', { vehiculoId: coche.vehiculoId, cuadranteId: null, dia: DIA });
    } catch (e) { alert(e.message); }
  }

  async function borrarCuadranteUI(id, nombre) {
    const ok = await Dialogo.confirmar({
      titulo: `Borrar el cuadrante ${nombre}`, tono: 'aviso', si: 'Borrar', no: 'Cancelar',
      html: '<p>Los coches quedan sueltos. No se toca su gente ni su libranza.</p>',
    });
    if (!ok) return;
    try {
      await pedirTablero(`/planificador-v2/api/cuadrantes/${encodeURIComponent(id)}?dia=${encodeURIComponent(DIA)}`, null, 'DELETE');
    } catch (e) { alert(e.message); }
  }

  async function asignarCTCuadrante(cuadranteId, turno, lista) {
    const id = await pickConductor({ titulo: `CT ${turno} del cuadrante`, turno, actual: null });
    if (id === undefined) return;   // cancelado
    let vehiculos = [];
    if (id) {
      // Qué bloques (matrículas) cubre este CT. Por defecto, todos.
      vehiculos = await elegirBloques(lista || []);
      if (vehiculos === undefined) return;               // cancelado
      if (!vehiculos.length) { alert('Elige al menos un bloque para el CT'); return; }
    }
    try {
      await pedirTablero('/planificador-v2/api/cuadrante/ct', { cuadranteId, turno, conductorId: id || '', vehiculos, dia: DIA });
    } catch (e) { alert(e.message); }
  }

  // Elegir qué bloques (coches del cuadrante) cubre un CT. Por defecto, todos.
  function elegirBloques(lista) {
    return new Promise(resolve => {
      const sel = new Set((lista || []).map(c => String(c.vehiculoId)));
      const fondo = document.createElement('div');
      fondo.className = 'fixed inset-0 z-[120] bg-black/60 backdrop-blur-sm flex items-start justify-center p-4';
      fondo.innerHTML = `
        <div class="bg-telecab-card border border-telecab-border rounded-2xl shadow-soft w-full max-w-sm my-16">
          <div class="flex items-center justify-between px-4 py-3 border-b border-telecab-border">
            <h3 class="font-semibold">¿Qué días/bloques cubre?</h3>
            <button data-x class="w-8 h-8 rounded-lg hover:bg-telecab-card2 text-telecab-muted"><i class="fa-solid fa-xmark"></i></button>
          </div>
          <div class="p-4">
            <p class="text-xs text-telecab-muted mb-3">Los bloques que cubre el correturnos. Los demás días serán su libranza.</p>
            <div class="space-y-1.5" data-lista></div>
            <div class="flex gap-2 mt-4">
              <button data-guardar class="flex-1 px-3 py-2 rounded-xl bg-telecab-gold text-telecab-dark font-semibold text-sm">Guardar</button>
              <button data-cancelar class="px-3 py-2 rounded-xl bg-telecab-card border border-telecab-border text-sm">Cancelar</button>
            </div>
          </div>
        </div>`;
      const cerrar = v => { document.body.removeChild(fondo); resolve(v); };
      const cont = fondo.querySelector('[data-lista]');
      const pinta = () => {
        cont.innerHTML = (lista || []).map(c => {
          const on = sel.has(String(c.vehiculoId));
          const dias = (c.descanso && c.descanso.length) ? diasTexto(c.descanso) : '—';
          return `<button data-v="${esc(c.vehiculoId)}" class="w-full flex items-center gap-2 px-3 py-2 rounded-lg border text-left transition ${on ? 'bg-telecab-gold/10 border-telecab-gold/40' : 'border-telecab-border hover:bg-telecab-card2'}">
            <i class="fa-${on ? 'solid fa-square-check text-telecab-gold' : 'regular fa-square text-telecab-muted'}"></i>
            <span class="text-sm font-medium">${esc(c.matricula)}</span><span class="text-xs text-telecab-muted ml-auto">${esc(dias)}</span></button>`;
        }).join('') || '<p class="text-xs text-telecab-muted text-center py-3">El cuadrante no tiene bloques.</p>';
        cont.querySelectorAll('[data-v]').forEach(b => b.addEventListener('click', () => {
          const v = b.dataset.v; if (sel.has(v)) sel.delete(v); else sel.add(v); pinta();
        }));
      };
      fondo.querySelector('[data-x]').addEventListener('click', () => cerrar(undefined));
      fondo.querySelector('[data-cancelar]').addEventListener('click', () => cerrar(undefined));
      fondo.addEventListener('mousedown', e => { if (e.target === fondo) cerrar(undefined); });
      fondo.querySelector('[data-guardar]').addEventListener('click', () => cerrar([...sel]));
      document.body.appendChild(fondo);
      pinta();
    });
  }

  // ── Descanso del coche (día + noche a la vez) ─────────────────────────────
  async function fijarDescansoCoche(coche) {
    const dias = await editarDescanso({ titulo: `Descanso de ${coche.matricula}`, actual: coche.descanso || [] });
    if (dias === undefined) return;   // cancelado
    try {
      const r = await fetch('/planificador-v2/api/descanso', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ vehiculoId: coche.vehiculoId, dias, dia: DIA }),
      });
      const j = await r.json();
      if (!r.ok || j.status === 'error') throw new Error(j.msg || 'No se pudo guardar el descanso');
      if (j.tablero) aplicar(j.tablero);
    } catch (e) { alert(e.message); }
  }

  function editarDescanso({ titulo, actual }) {
    return new Promise(resolve => {
      const sel = new Set(actual || []);
      const fondo = document.createElement('div');
      fondo.className = 'fixed inset-0 z-[120] bg-black/60 backdrop-blur-sm flex items-start justify-center p-4';
      fondo.innerHTML = `
        <div class="bg-telecab-card border border-telecab-border rounded-2xl shadow-soft w-full max-w-sm my-16">
          <div class="flex items-center justify-between px-4 py-3 border-b border-telecab-border">
            <h3 class="font-semibold">${esc(titulo)}</h3>
            <button data-x class="w-8 h-8 rounded-lg hover:bg-telecab-card2 text-telecab-muted"><i class="fa-solid fa-xmark"></i></button>
          </div>
          <div class="p-4">
            <p class="text-xs text-telecab-muted mb-3">Los días que libran los fijos (día y noche a la vez). El correturnos cubre justo esos días.</p>
            <div class="flex flex-wrap gap-1.5 justify-center" data-dias></div>
            <div class="flex gap-2 mt-4">
              <button data-guardar class="flex-1 px-3 py-2 rounded-xl bg-telecab-gold text-telecab-dark font-semibold text-sm">Guardar</button>
              <button data-cancelar class="px-3 py-2 rounded-xl bg-telecab-card border border-telecab-border text-sm">Cancelar</button>
            </div>
          </div>
        </div>`;
      const cerrar = v => { document.body.removeChild(fondo); resolve(v); };
      const cont = fondo.querySelector('[data-dias]');
      const pinta = () => {
        cont.innerHTML = DIAS_LETRA.map((l, i) => {
          const d = i + 1, on = sel.has(d);
          return `<button data-d="${d}" class="w-10 h-10 rounded-xl border text-sm font-semibold transition ${on ? 'bg-telecab-gold text-telecab-dark border-telecab-gold' : 'bg-telecab-card2 border-telecab-border text-telecab-muted hover:border-telecab-gold/40'}">${l}</button>`;
        }).join('');
        cont.querySelectorAll('[data-d]').forEach(b => b.addEventListener('click', () => {
          const d = Number(b.dataset.d); if (sel.has(d)) sel.delete(d); else sel.add(d); pinta();
        }));
      };
      fondo.querySelector('[data-x]').addEventListener('click', () => cerrar(undefined));
      fondo.querySelector('[data-cancelar]').addEventListener('click', () => cerrar(undefined));
      fondo.addEventListener('mousedown', e => { if (e.target === fondo) cerrar(undefined); });
      fondo.querySelector('[data-guardar]').addEventListener('click', () => cerrar([...sel].sort((a, b) => a - b)));
      document.body.appendChild(fondo);
      pinta();
    });
  }

  // ── Selector de conductor (modal con búsqueda) ────────────────────────────
  function pickConductor({ titulo, turno, actual }) {
    return new Promise(resolve => {
      const fondo = document.createElement('div');
      fondo.className = 'fixed inset-0 z-[120] bg-black/60 backdrop-blur-sm flex items-start justify-center p-4 overflow-y-auto';
      // Elegibles: el banquillo primero, luego el resto de la plantilla del turno.
      const mismoTurno = c => !turno || !c.turnoCodigo || c.turnoCodigo === turno;
      const lista = [...(T.conductores || [])].filter(c => c.id).sort((a, b) =>
        (b.plazas === 0) - (a.plazas === 0) || a.nombre.localeCompare(b.nombre));
      fondo.innerHTML = `
        <div class="bg-telecab-card border border-telecab-border rounded-2xl shadow-soft w-full max-w-md my-8">
          <div class="flex items-center justify-between px-4 py-3 border-b border-telecab-border">
            <h3 class="font-semibold">${esc(titulo)}</h3>
            <button data-x class="w-8 h-8 rounded-lg hover:bg-telecab-card2 text-telecab-muted"><i class="fa-solid fa-xmark"></i></button>
          </div>
          <div class="p-3">
            <input data-busca type="search" placeholder="Buscar nombre, DNI…" class="w-full mb-2 px-3 py-2 bg-telecab-card2 border border-telecab-border rounded-lg text-sm">
            ${actual ? '<button data-quitar class="w-full mb-2 px-3 py-2 rounded-lg border border-telecab-red/40 text-telecab-red text-sm hover:bg-telecab-red/10"><i class="fa-solid fa-user-minus"></i> Dejar la plaza vacía</button>' : ''}
            <div data-lista class="space-y-1 max-h-[50vh] overflow-y-auto"></div>
          </div>
        </div>`;
      const cerrar = v => { document.body.removeChild(fondo); resolve(v); };
      fondo.addEventListener('mousedown', e => { if (e.target === fondo) cerrar(undefined); });
      fondo.querySelector('[data-x]').addEventListener('click', () => cerrar(undefined));
      const q = fondo.querySelector('[data-quitar]');
      if (q) q.addEventListener('click', () => cerrar(''));

      const cont = fondo.querySelector('[data-lista]');
      const pinta = () => {
        const txt = (fondo.querySelector('[data-busca]').value || '').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
        const vis = lista.filter(c => {
          const t = (c.nombre + ' ' + (c.dni || '')).toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
          return t.includes(txt);
        });
        cont.innerHTML = vis.slice(0, 80).map(c => `
          <button data-id="${esc(c.id)}" class="w-full text-left px-3 py-2 rounded-lg border transition
                  ${String(c.id) === String(actual) ? 'border-telecab-gold bg-telecab-gold/10' : 'border-telecab-border hover:bg-telecab-card2'}
                  ${!mismoTurno(c) ? 'opacity-60' : ''}">
            <div class="text-sm font-medium">${esc(c.nombre)}${c.esEtt ? ' <span class="text-telecab-violet text-xs">ETT</span>' : ''}</div>
            <div class="text-[11px] text-telecab-muted">${esc(c.turno || 'sin turno')}${c.plazas ? ' · ya colocado' : ' · banquillo'}${!mismoTurno(c) ? ' · otro turno' : ''}</div>
          </button>`).join('') || '<p class="text-xs text-telecab-muted text-center py-4">Nadie coincide.</p>';
        cont.querySelectorAll('[data-id]').forEach(b => b.addEventListener('click', () => cerrar(b.dataset.id)));
      };
      fondo.querySelector('[data-busca]').addEventListener('input', pinta);
      document.body.appendChild(fondo);
      pinta();
      fondo.querySelector('[data-busca]').focus();
    });
  }

  function pickCoche({ titulo, coches }) {
    return new Promise(resolve => {
      const fondo = document.createElement('div');
      fondo.className = 'fixed inset-0 z-[120] bg-black/60 backdrop-blur-sm flex items-start justify-center p-4 overflow-y-auto';
      fondo.innerHTML = `
        <div class="bg-telecab-card border border-telecab-border rounded-2xl shadow-soft w-full max-w-md my-8">
          <div class="flex items-center justify-between px-4 py-3 border-b border-telecab-border">
            <h3 class="font-semibold">${esc(titulo)}</h3>
            <button data-x class="w-8 h-8 rounded-lg hover:bg-telecab-card2 text-telecab-muted"><i class="fa-solid fa-xmark"></i></button>
          </div>
          <div class="p-3">
            <input data-busca type="search" placeholder="Buscar matrícula, zona…" class="w-full mb-2 px-3 py-2 bg-telecab-card2 border border-telecab-border rounded-lg text-sm">
            <div data-lista class="space-y-1 max-h-[50vh] overflow-y-auto"></div>
          </div>
        </div>`;
      const cerrar = v => { document.body.removeChild(fondo); resolve(v); };
      fondo.addEventListener('mousedown', e => { if (e.target === fondo) cerrar(null); });
      fondo.querySelector('[data-x]').addEventListener('click', () => cerrar(null));
      const cont = fondo.querySelector('[data-lista]');
      const pinta = () => {
        const q = (fondo.querySelector('[data-busca]').value || '').toLowerCase();
        const vis = coches.filter(c => `${c.matricula} ${c.zona || ''}`.toLowerCase().includes(q));
        cont.innerHTML = vis.slice(0, 100).map(c => `
          <button data-id="${esc(c.vehiculoId)}" class="w-full text-left px-3 py-2 rounded-lg border border-telecab-border hover:bg-telecab-card2 transition">
            <span class="text-sm font-medium">${esc(c.matricula)}</span>${c.zona ? ` <span class="text-[11px] text-telecab-muted">${esc(c.zona)}</span>` : ''}
          </button>`).join('') || '<p class="text-xs text-telecab-muted text-center py-4">Ningún coche coincide.</p>';
        cont.querySelectorAll('[data-id]').forEach(b => b.addEventListener('click', () => cerrar(b.dataset.id)));
      };
      fondo.querySelector('[data-busca]').addEventListener('input', pinta);
      document.body.appendChild(fondo);
      pinta();
      fondo.querySelector('[data-busca]').focus();
    });
  }

  // ── Navegación de semana ──────────────────────────────────────────────────
  const irA = async dia => { try { await cargar(dia); } catch (e) { alert(e.message); } };
  $('#sem-prev').addEventListener('click', () => irA(sumarDias(DIA, -7)));
  $('#sem-next').addEventListener('click', () => irA(sumarDias(DIA, 7)));
  $('#hoy').addEventListener('click', () => irA(hoyISO()));
  $('#f-dia').addEventListener('change', e => { const iso = esAiso(e.target.value); if (iso) irA(iso); });
  $('#f-zona').addEventListener('change', pintar);
  $('#f-huecos').addEventListener('change', pintar);
  { let t; $('#f-busca').addEventListener('input', () => { clearTimeout(t); t = setTimeout(pintar, 150); }); }
  $('#banq-busca').addEventListener('input', pintarBanquillo);
  document.querySelectorAll('.banq-tab').forEach(b =>
    b.addEventListener('click', () => { banqTab = b.dataset.banqTab; pintarBanquillo(); }));
  $('#btn-avisos').addEventListener('click', () => $('#avisos').classList.toggle('hidden'));
  $('#btn-nuevo-cua').addEventListener('click', nuevoCuadrante);

  // Arranque.
  irA(hoyISO());
})();
</script>
