<div class="p-4 lg:p-6 max-w-5xl mx-auto space-y-5">

  <!-- Intro -->
  <div class="bg-telecab-card border border-telecab-border rounded-2xl p-5">
    <h1 class="text-lg font-semibold text-telecab-text flex items-center gap-2">
      <i class="fa-solid fa-gas-pump text-telecab-gold"></i> PIN de Ballenoil
    </h1>
    <p class="text-sm text-telecab-muted mt-1">
      Último paso del alta. Copia el <b class="text-telecab-text">nombre que sale en BOLT</b>, el teléfono y el correo para solicitarle el PIN a Ballenoil; luego digítalo aquí. Hasta que no tenga el PIN, el conductor no pasa al planificador (Tráfico).
    </p>
  </div>

  <!-- Contadores -->
  <div class="grid grid-cols-2 gap-3">
    <div class="bg-telecab-card border border-telecab-border rounded-2xl px-4 py-3">
      <p class="text-[11px] uppercase tracking-wide text-telecab-muted">Pendientes de alta en Ballenoil</p>
      <p id="c-pend" class="text-2xl font-bold text-telecab-gold">–</p>
    </div>
    <div class="bg-telecab-card border border-telecab-border rounded-2xl px-4 py-3">
      <p class="text-[11px] uppercase tracking-wide text-telecab-muted">PIN creados</p>
      <p id="c-hechos" class="text-2xl font-bold text-telecab-green">–</p>
    </div>
  </div>

  <!-- Ficha: crear PIN -->
  <div id="ficha" class="bg-telecab-card border border-telecab-border rounded-2xl p-5 hidden">
    <div class="flex items-center justify-between mb-3">
      <h2 id="ficha-nombre" class="text-lg font-semibold text-telecab-text flex items-center gap-2">
        <i class="fa-solid fa-id-card text-telecab-gold"></i> <span></span>
      </h2>
      <span class="text-xs px-2.5 py-1 rounded-full bg-telecab-gold/10 text-telecab-gold border border-telecab-gold/30">Pendiente de alta en Ballenoil</span>
    </div>

    <!-- Datos para Ballenoil: nombre (ID), DNI, teléfono, correo -->
    <div class="bg-telecab-dark/50 border border-telecab-border rounded-xl px-3 py-2.5 mb-3">
      <p class="text-[11px] uppercase tracking-wide text-telecab-muted mb-0.5">Nombre en BOLT <span class="text-telecab-muted/60 normal-case tracking-normal">(= ID en la agenda)</span></p>
      <div class="flex items-center gap-1.5">
        <input id="d-nombre" class="flex-1 min-w-0 bg-transparent text-sm text-telecab-text font-medium focus:outline-none" placeholder="Nombre completo en BOLT">
        <button type="button" class="js-copy text-telecab-muted hover:text-telecab-gold shrink-0" data-copy="nombre" title="Copiar"><i class="fa-regular fa-copy text-xs"></i></button>
      </div>
    </div>
    <div class="grid md:grid-cols-3 gap-3 mb-3">
      <div class="bg-telecab-dark/50 border border-telecab-border rounded-xl px-3 py-2.5">
        <p class="text-[11px] uppercase tracking-wide text-telecab-muted mb-0.5">DNI / NIE</p>
        <button type="button" class="js-copy text-left text-sm text-telecab-text font-mono flex items-center gap-1.5 w-full" data-copy="dni">
          <span id="d-dni" class="truncate">–</span><i class="fa-regular fa-copy text-telecab-muted text-xs shrink-0"></i>
        </button>
      </div>
      <div class="bg-telecab-dark/50 border border-telecab-border rounded-xl px-3 py-2.5">
        <p class="text-[11px] uppercase tracking-wide text-telecab-muted mb-0.5">Teléfono</p>
        <button type="button" class="js-copy text-left text-sm text-telecab-text font-mono flex items-center gap-1.5 w-full" data-copy="telefono">
          <span id="d-tel" class="truncate">–</span><i class="fa-regular fa-copy text-telecab-muted text-xs shrink-0"></i>
        </button>
      </div>
      <div class="bg-telecab-dark/50 border border-telecab-border rounded-xl px-3 py-2.5">
        <p class="text-[11px] uppercase tracking-wide text-telecab-muted mb-0.5">Correo</p>
        <button type="button" class="js-copy text-left text-sm text-telecab-text flex items-center gap-1.5 w-full" data-copy="email">
          <span id="d-email" class="truncate">–</span><i class="fa-regular fa-copy text-telecab-muted text-xs shrink-0"></i>
        </button>
      </div>
    </div>
    <div class="mb-4">
      <label class="block text-xs text-telecab-muted mb-1">Observaciones de Ballenoil <span class="text-telecab-muted/60">(opcional)</span></label>
      <textarea id="obs-ball" rows="2" class="w-full bg-telecab-dark border border-telecab-border rounded-xl px-3 py-2 text-sm text-telecab-text resize-none focus:outline-none focus:border-telecab-gold transition" placeholder="Notas para Ballenoil (opcional)"></textarea>
    </div>

    <div class="grid md:grid-cols-2 gap-4 items-end">
      <div>
        <label class="block text-xs text-telecab-muted mb-1">PIN de Ballenoil</label>
        <input id="pin" inputmode="numeric" autocomplete="off"
               class="w-full bg-telecab-dark border border-telecab-border rounded-xl px-3 py-2 text-telecab-text tracking-widest focus:outline-none focus:border-telecab-gold transition"
               placeholder="Ej. 4821">
      </div>
      <button id="btn-pin" class="px-4 py-2.5 rounded-xl bg-telecab-green/15 border border-telecab-green/40 text-telecab-green hover:bg-telecab-green/25 transition font-semibold disabled:opacity-40">
        <i class="fa-solid fa-paper-plane mr-1"></i> <span id="btn-pin-txt">Guardar PIN y enviar Ballenoil</span>
      </button>
    </div>
    <div class="flex items-center gap-2 mt-3 text-xs text-telecab-muted">
      <i class="fa-solid fa-circle-arrow-right text-telecab-gold"></i>
      <span id="pin-hint">Se guarda el PIN, se crea su ficha en la Agenda como <b class="text-telecab-text">Pendiente Asignar</b> y se le envía por WhatsApp la <b class="text-telecab-text">bienvenida de Ballenoil</b> (con el botón «VER PIN BALLENOIL»).</span>
    </div>
    <p id="ficha-msg" class="text-xs mt-3 hidden"></p>
  </div>

  <!-- Lista: pendientes de PIN -->
  <div class="bg-telecab-card border border-telecab-border rounded-2xl p-4">
    <h2 class="text-sm font-semibold text-telecab-text mb-3 flex items-center gap-2">
      <i class="fa-solid fa-hourglass-half text-telecab-gold"></i> Pendientes de alta en Ballenoil
    </h2>
    <div id="lista-pend" class="space-y-1.5"></div>
  </div>

  <!-- Historial: PIN creados -->
  <div class="bg-telecab-card border border-telecab-border rounded-2xl p-4">
    <h2 class="text-sm font-semibold text-telecab-text mb-3 flex items-center gap-2">
      <i class="fa-solid fa-clock-rotate-left text-telecab-muted"></i> PIN ya creados
    </h2>
    <div id="lista-hechos" class="space-y-1.5"></div>
  </div>

  <!-- Códigos de lavado Ballenoil (los reparte el bot de WhatsApp) -->
  <div class="bg-telecab-card border border-telecab-border rounded-2xl p-5">
    <h2 class="text-lg font-semibold text-telecab-text flex items-center gap-2"><i class="fa-solid fa-droplet text-telecab-gold"></i> Códigos de lavado Ballenoil</h2>
    <p class="text-sm text-telecab-muted mt-1 mb-4">Pega la lista de <b>Código</b> + <b>Fecha de vencimiento</b> (dos columnas) y guárdala. El bot de WhatsApp entrega uno a cada conductor que lo pida y lo marca <b>Usado</b> — no se reparte dos veces.</p>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-4">
      <div class="bg-telecab-dark/50 border border-telecab-border rounded-xl px-3 py-2.5"><p class="text-[11px] uppercase tracking-wide text-telecab-muted">Total</p><p id="cb-total" class="text-xl font-bold text-telecab-text">–</p></div>
      <div class="bg-telecab-dark/50 border border-telecab-border rounded-xl px-3 py-2.5"><p class="text-[11px] uppercase tracking-wide text-telecab-muted">Disponibles</p><p id="cb-disp" class="text-xl font-bold text-telecab-green">–</p></div>
      <div class="bg-telecab-dark/50 border border-telecab-border rounded-xl px-3 py-2.5"><p class="text-[11px] uppercase tracking-wide text-telecab-muted">Usados</p><p id="cb-usad" class="text-xl font-bold text-telecab-muted">–</p></div>
      <div class="bg-telecab-dark/50 border border-telecab-border rounded-xl px-3 py-2.5"><p class="text-[11px] uppercase tracking-wide text-telecab-muted">Vencidos</p><p id="cb-venc" class="text-xl font-bold text-telecab-red">–</p></div>
    </div>

    <label class="block text-xs text-telecab-muted mb-1">Pega aquí — Código y Fecha de vencimiento</label>
    <textarea id="cb-texto" rows="6" class="w-full text-xs font-mono bg-telecab-dark border border-telecab-border rounded-lg px-3 py-2 text-telecab-text focus:outline-none focus:border-telecab-gold transition" placeholder="Codigo&#9;Fecha Vencimiento&#10;26416900&#9;16/08/2026&#10;26976997&#9;16/08/2026"></textarea>
    <div class="flex items-center gap-3 mt-3">
      <button id="cb-importar" class="px-4 py-2 rounded-xl bg-telecab-gold/15 border border-telecab-gold/40 text-telecab-gold hover:bg-telecab-gold/25 transition font-semibold text-sm"><i class="fa-solid fa-file-import mr-1"></i> Importar</button>
      <button id="cb-toggle" class="text-xs text-telecab-muted hover:text-telecab-gold transition">Ver códigos</button>
      <button id="cb-purgar" class="text-xs text-telecab-muted hover:text-telecab-red transition" title="Borra los no usados que ya vencieron (los usados se conservan)">Borrar vencidos</button>
      <span id="cb-msg" class="text-xs ml-auto hidden"></span>
    </div>

    <div id="cb-lista" class="hidden mt-4 bg-telecab-dark/30 border border-telecab-border rounded-xl overflow-auto max-h-72"></div>
  </div>

</div>

<script>
  const $ = s => document.querySelector(s);
  let fichaActual = null;
  let fichaHecho = false;   // true = ficha ya creada (solo actualizar PIN y reenviar)
  let autoAbierto = false;

  async function api(url, body) {
    const r = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body || {}) });
    return r.json();
  }
  function msg(texto, ok) {
    const el = $('#ficha-msg');
    el.textContent = texto;
    el.className = 'text-xs mt-3 ' + (ok ? 'text-telecab-green' : 'text-telecab-red');
    el.classList.remove('hidden');
  }
  // Nombre para MOSTRAR (el de la ficha de Selección). El "Nombre en BOLT" (= ID)
  // va en el input editable #d-nombre, prellenado con lo resuelto del padrón.
  const nomCompleto = t => (t.ficha || t.nombre || '(sin nombre)');

  function abrirFicha(t, hecho) {
    fichaActual = t;
    fichaHecho = !!hecho;
    $('#ficha').classList.remove('hidden');
    $('#ficha-nombre').querySelector('span').textContent = nomCompleto(t);
    $('#d-nombre').value = t.nombre || '';
    $('#d-dni').textContent = t.dni || '—';
    $('#d-tel').textContent = t.telefono || t.id || '–';
    $('#d-email').textContent = t.email || '—';
    $('#pin').value = t.pin_ballenoil || '';
    $('#obs-ball').value = t.obs_ballenoil || '';
    // Ficha ya creada (historial): solo se actualiza el PIN y se reenvía. Pendiente:
    // se guarda, se crea en la agenda y se envía por primera vez.
    $('#btn-pin-txt').textContent = hecho ? 'Actualizar PIN y reenviar Ballenoil' : 'Guardar PIN y enviar Ballenoil';
    $('#pin-hint').innerHTML = hecho
      ? 'El PIN cambia a veces: se <b class="text-telecab-text">actualiza en su ficha</b> y se le <b class="text-telecab-text">reenvía la bienvenida</b> de Ballenoil por WhatsApp.'
      : 'Se guarda el PIN, se crea su ficha en la Agenda como <b class="text-telecab-text">Pendiente Asignar</b> y se le envía por WhatsApp la <b class="text-telecab-text">bienvenida de Ballenoil</b> (con el botón «VER PIN BALLENOIL»).';
    $('#ficha-msg').classList.add('hidden');
    $('#ficha').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    setTimeout(() => $('#pin').focus(), 250);
  }

  // Copiar al portapapeles los datos que van a Ballenoil.
  document.querySelectorAll('.js-copy').forEach(btn => {
    btn.addEventListener('click', () => {
      if (!fichaActual) return;
      const campo = btn.dataset.copy;
      const val = campo === 'nombre' ? $('#d-nombre').value.trim() : (fichaActual[campo] || fichaActual.id || '');
      if (!val) return;
      navigator.clipboard && navigator.clipboard.writeText(val);
      const ic = btn.querySelector('i');
      const prev = ic.className; ic.className = 'fa-solid fa-check text-telecab-green text-xs shrink-0';
      setTimeout(() => { ic.className = prev; }, 1000);
    });
  });

  $('#btn-pin').addEventListener('click', async () => {
    if (!fichaActual) return;
    const pin = $('#pin').value.trim();
    if (!pin) { msg('Escribe el PIN de Ballenoil.', false); return; }
    const obs_ballenoil = $('#obs-ball').value.trim();
    const btn = $('#btn-pin'); btn.disabled = true;
    let r;
    if (fichaHecho) {
      // Ficha ya creada: solo actualizar el PIN y reenviar la bienvenida.
      r = await api('/administracion/ballenoil/reenviar', { tel: fichaActual.id, pin, obs_ballenoil });
    } else {
      const id_bolt = $('#d-nombre').value.trim();
      if (!id_bolt) { msg('Escribe el nombre tal como sale en BOLT (será su ID en la agenda).', false); btn.disabled = false; return; }
      r = await api('/administracion/pin', { tel: fichaActual.id, pin, id_bolt, obs_ballenoil });
    }
    btn.disabled = false;
    if (r.status === 'ok') {
      const base = fichaHecho ? 'PIN actualizado.' : 'PIN guardado. Creado en la Agenda como Pendiente Asignar.';
      const envio = r.enviado
        ? 'Bienvenida de Ballenoil enviada por WhatsApp.'
        : `⚠️ Pero la bienvenida NO se envió (${r.envioError || 'revisa el número / WhatsApp'}).`;
      msg(`${base} ${envio}`, r.enviado === true);
      setTimeout(() => { $('#ficha').classList.add('hidden'); cargar(); }, 1300);
    } else {
      msg(r.msg || 'No se pudo guardar el PIN', false);
    }
  });

  function fila(t, hecho) {
    const el = document.createElement('div');
    el.className = 'flex items-center gap-3 px-3 py-2.5 rounded-xl bg-telecab-dark/40 border border-transparent hover:border-telecab-border transition cursor-pointer';
    const icon = hecho ? 'fa-circle-check text-telecab-green' : 'fa-hourglass-half text-telecab-gold';
    const box = hecho ? 'bg-telecab-green/15' : 'bg-telecab-gold/15';
    el.innerHTML =
      `<span class="w-8 h-8 rounded-lg ${box} flex items-center justify-center shrink-0"><i class="fa-solid ${icon}"></i></span>
       <span class="min-w-0 flex-1">
         <span class="block text-sm text-telecab-text truncate">${nomCompleto(t)}</span>
         <span class="block text-xs text-telecab-muted font-mono">${t.telefono || t.id}${t.email ? ' · ' + t.email : ''}</span>
       </span>
       ${hecho ? `<span class="text-xs px-2 py-1 rounded-lg bg-telecab-green/10 text-telecab-green border border-telecab-green/25 font-mono whitespace-nowrap">PIN ${t.pin_ballenoil}</span>` : '<i class="fa-solid fa-chevron-right text-telecab-muted text-xs"></i>'}`;
    el.addEventListener('click', () => abrirFicha(t, hecho));
    return el;
  }

  async function cargar() {
    const r = await (await fetch('/administracion/api/datos')).json();
    if (r.status !== 'ok') return;
    $('#c-pend').textContent = r.contadores.pendientes;
    $('#c-hechos').textContent = r.contadores.hechos;

    const cont = $('#lista-pend'); cont.innerHTML = '';
    if (!r.pendientes.length) cont.innerHTML = '<p class="text-telecab-muted text-sm">Nadie pendiente de PIN.</p>';
    else r.pendientes.forEach(t => cont.appendChild(fila(t, false)));

    const hist = $('#lista-hechos'); hist.innerHTML = '';
    if (!r.hechos.length) hist.innerHTML = '<p class="text-telecab-muted text-sm">Todavía no se ha creado ningún PIN.</p>';
    else r.hechos.slice(-30).reverse().forEach(t => hist.appendChild(fila(t, true)));

    // Abre directamente la ficha que llega por ?tel= (una sola vez, desde Pendientes).
    if (!autoAbierto) {
      const tel = new URLSearchParams(location.search).get('tel');
      const t = tel && r.pendientes.find(x => String(x.id) === tel);
      if (t) { autoAbierto = true; abrirFicha(t); }
    }
  }

  cargar();
</script>

<!-- Códigos de lavado Ballenoil (IIFE aparte para no chocar con el script del tablero de PINs) -->
<script>
(function () {
  const $ = s => document.querySelector(s);
  const esc = s => (s == null ? '' : String(s)).replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
  if (!$('#cb-importar')) return;
  const msg = (t, cls) => { const m = $('#cb-msg'); m.textContent = t; m.className = 'text-xs ml-auto ' + cls; m.classList.remove('hidden'); };
  let abierto = false;

  function pintarLista(lista) {
    const cont = $('#cb-lista');
    if (!lista.length) { cont.innerHTML = '<p class="text-xs text-telecab-muted p-3">Aún no hay códigos.</p>'; return; }
    const badge = c => c.estado === 'Usado'
      ? '<span class="text-[11px] px-1.5 py-0.5 rounded bg-telecab-dark text-telecab-muted border border-telecab-border">Usado</span>'
      : (c.vencido ? '<span class="text-[11px] px-1.5 py-0.5 rounded bg-telecab-red/10 text-telecab-red border border-telecab-red/30">Vencido</span>'
                   : '<span class="text-[11px] px-1.5 py-0.5 rounded bg-telecab-green/15 text-telecab-green border border-telecab-green/30">Disponible</span>');
    cont.innerHTML = `<table class="w-full text-xs"><thead><tr class="text-telecab-muted"><th class="text-left px-3 py-2">Código</th><th class="text-left px-3 py-2">Vence</th><th class="text-left px-3 py-2">Estado</th><th class="text-left px-3 py-2">Usado por</th></tr></thead><tbody>${
      lista.map(c => `<tr class="border-t border-telecab-border/30"><td class="px-3 py-1.5 font-mono text-telecab-text">${esc(c.codigo)}</td><td class="px-3 py-1.5 text-telecab-muted">${esc(c.fecha_vencimiento)}</td><td class="px-3 py-1.5">${badge(c)}</td><td class="px-3 py-1.5 text-telecab-muted">${esc(c.id_bolt || '')}${c.telefono ? ' · ' + esc(c.telefono) : ''}${c.fecha_uso ? ' · ' + esc(c.fecha_uso) : ''}</td></tr>`).join('')
    }</tbody></table>`;
  }

  async function cargar() {
    try {
      const r = await (await fetch('/administracion/codigos/api')).json();
      if (r.status !== 'ok') return;
      $('#cb-total').textContent = r.resumen.total;
      $('#cb-disp').textContent = r.resumen.disponibles;
      $('#cb-usad').textContent = r.resumen.usados;
      $('#cb-venc').textContent = r.resumen.vencidos;
      if (abierto) pintarLista(r.lista);
    } catch (_) {}
  }

  $('#cb-importar').addEventListener('click', async () => {
    const texto = $('#cb-texto').value.trim();
    if (!texto) return msg('Pega la lista primero.', 'text-telecab-red');
    const btn = $('#cb-importar'); btn.disabled = true; msg('Importando…', 'text-telecab-muted');
    try {
      const r = await (await fetch('/administracion/codigos/importar', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ texto }) })).json();
      if (r.status !== 'ok') throw new Error(r.msg || 'error');
      msg(`Añadidos ${r.añadidos}${r.duplicados ? ` · ${r.duplicados} repetidos` : ''}${r.invalidos ? ` · ${r.invalidos} inválidos` : ''}.`, 'text-telecab-green');
      $('#cb-texto').value = '';
      abierto = true; $('#cb-lista').classList.remove('hidden'); $('#cb-toggle').textContent = 'Ocultar códigos';
      cargar();
    } catch (e) { msg('No se pudo: ' + e.message, 'text-telecab-red'); }
    btn.disabled = false;
  });

  $('#cb-toggle').addEventListener('click', () => {
    abierto = !abierto;
    $('#cb-lista').classList.toggle('hidden', !abierto);
    $('#cb-toggle').textContent = abierto ? 'Ocultar códigos' : 'Ver códigos';
    if (abierto) cargar();
  });

  $('#cb-purgar').addEventListener('click', async () => {
    if (!confirm('¿Borrar los códigos NO usados que ya vencieron? Los usados se conservan como histórico.')) return;
    msg('Borrando…', 'text-telecab-muted');
    try {
      const r = await (await fetch('/administracion/codigos/purgar', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' })).json();
      if (r.status !== 'ok') throw new Error(r.msg || 'error');
      msg(`Borrados ${r.borrados} vencidos sin usar.`, 'text-telecab-green');
      cargar();
    } catch (e) { msg('No se pudo: ' + e.message, 'text-telecab-red'); }
  });

  cargar();
})();
</script>
