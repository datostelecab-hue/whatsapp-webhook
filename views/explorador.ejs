<div class="h-[calc(100vh-6rem)] flex flex-col">
  <!-- Cabecera -->
  <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
    <div>
      <h1 class="text-xl font-bold text-telecab-text flex items-center gap-2">
        <i class="fa-solid fa-database text-telecab-gold"></i> Base de datos
      </h1>
      <p id="resumen" class="text-xs text-telecab-muted mt-0.5">—</p>
    </div>
    <div class="flex items-center gap-2">
      <span class="text-[10px] px-2 py-1 rounded bg-telecab-green/15 text-telecab-green font-semibold">
        <i class="fa-solid fa-lock"></i> SOLO LECTURA
      </span>
      <button id="btn-sql" class="px-3 py-1.5 rounded-lg bg-telecab-card2 text-telecab-text text-sm hover:bg-telecab-border">
        <i class="fa-solid fa-terminal mr-1"></i> Consulta
      </button>
    </div>
  </div>

  <div class="flex-1 flex gap-3 min-h-0">
    <!-- Lista de tablas -->
    <aside class="w-60 shrink-0 flex flex-col bg-telecab-card border border-telecab-border rounded-xl overflow-hidden">
      <div class="p-2 border-b border-telecab-border">
        <input id="filtro-tabla" placeholder="Buscar tabla…" autocomplete="off"
               class="w-full px-2.5 py-1.5 rounded-lg bg-telecab-card2 border border-telecab-border text-xs text-telecab-text">
      </div>
      <div id="lista-tablas" class="flex-1 overflow-y-auto p-1.5 space-y-0.5"></div>
    </aside>

    <!-- Contenido -->
    <section class="flex-1 flex flex-col bg-telecab-card border border-telecab-border rounded-xl overflow-hidden min-w-0">
      <div id="sin-tabla" class="flex-1 flex items-center justify-center text-telecab-muted text-sm">
        Elige una tabla de la izquierda
      </div>

      <div id="panel" class="hidden flex-1 flex flex-col min-h-0">
        <div class="flex items-center gap-2 px-3 py-2 border-b border-telecab-border flex-wrap">
          <h2 id="titulo" class="font-semibold text-telecab-text"></h2>
          <span id="cuenta" class="text-xs text-telecab-muted"></span>
          <div class="ml-auto flex items-center gap-2">
            <input id="busca" placeholder="Buscar en la tabla…" autocomplete="off"
                   class="px-2.5 py-1.5 rounded-lg bg-telecab-card2 border border-telecab-border text-xs text-telecab-text w-48">
            <div class="flex rounded-lg overflow-hidden border border-telecab-border text-xs">
              <button data-p="datos"       class="tab px-3 py-1.5">Datos</button>
              <button data-p="estructura"  class="tab px-3 py-1.5">Estructura</button>
            </div>
          </div>
        </div>

        <div id="cuerpo" class="flex-1 overflow-auto"></div>

        <div id="pie" class="hidden items-center gap-2 px-3 py-2 border-t border-telecab-border text-xs">
          <button id="ant" class="px-2.5 py-1 rounded bg-telecab-card2 text-telecab-text disabled:opacity-40">‹</button>
          <span id="pag" class="text-telecab-muted"></span>
          <button id="sig" class="px-2.5 py-1 rounded bg-telecab-card2 text-telecab-text disabled:opacity-40">›</button>
          <span id="tiempo" class="ml-auto text-telecab-muted"></span>
        </div>
      </div>
    </section>
  </div>
</div>

<!-- Consulta libre -->
<div id="modal-sql" class="hidden fixed inset-0 z-50 bg-black/60 flex items-center justify-center p-4">
  <div class="bg-telecab-card border border-telecab-border rounded-2xl w-full max-w-4xl flex flex-col max-h-[85vh]">
    <div class="flex items-center gap-2 px-4 py-3 border-b border-telecab-border">
      <h3 class="font-semibold text-telecab-text">Consulta</h3>
      <span class="text-[10px] px-2 py-0.5 rounded bg-telecab-green/15 text-telecab-green font-semibold">
        transacción de solo lectura
      </span>
      <button id="sql-cerrar" class="ml-auto text-telecab-muted hover:text-telecab-text px-2">✕</button>
    </div>
    <div class="p-4 space-y-2">
      <textarea id="sql" rows="5" spellcheck="false" placeholder="SELECT * FROM conductor WHERE empleo_vigente LIMIT 20"
        class="w-full px-3 py-2 rounded-lg bg-telecab-card2 border border-telecab-border text-sm text-telecab-text font-mono"></textarea>
      <div class="flex items-center gap-2">
        <button id="sql-ir" class="px-4 py-2 rounded-lg bg-telecab-gold text-black text-sm font-semibold">
          Ejecutar <span class="opacity-60 text-xs">Ctrl+Enter</span>
        </button>
        <span id="sql-info" class="text-xs text-telecab-muted"></span>
      </div>
    </div>
    <div id="sql-res" class="flex-1 overflow-auto border-t border-telecab-border"></div>
  </div>
</div>

<style>
  .tab { color: rgb(var(--tc-muted)); background: rgb(var(--tc-card2)); }
  .tab.on { color: rgb(var(--tc-gold)); background: rgb(var(--tc-gold) / .15); font-weight: 600; }
  .tbl { border-collapse: collapse; width: 100%; font-size: 12.5px; }
  .tbl th { position: sticky; top: 0; z-index: 1; text-align: left; white-space: nowrap;
            padding: 7px 10px; background: rgb(var(--tc-card2)); color: rgb(var(--tc-muted));
            font-family: ui-monospace, Menlo, monospace; font-size: 10.5px; letter-spacing: .04em;
            text-transform: uppercase; border-bottom: 1px solid rgb(var(--tc-border)); cursor: pointer; }
  .tbl th:hover { color: rgb(var(--tc-text)); }
  .tbl td { padding: 6px 10px; border-bottom: 1px solid rgb(var(--tc-border) / .5);
            white-space: nowrap; max-width: 340px; overflow: hidden; text-overflow: ellipsis;
            color: rgb(var(--tc-text)); }
  .tbl tr:hover td { background: rgb(var(--tc-card2) / .6); }
  .nulo { color: rgb(var(--tc-muted)); font-style: italic; font-size: 11px; }
  .fk { color: rgb(var(--tc-gold)); cursor: pointer; text-decoration: underline dotted; }
  .num { text-align: right; font-variant-numeric: tabular-nums; }
  .t-item { display: flex; align-items: center; gap: 6px; padding: 5px 8px; border-radius: 7px;
            cursor: pointer; font-size: 12.5px; color: rgb(var(--tc-text)); }
  .t-item:hover { background: rgb(var(--tc-card2)); }
  .t-item.on { background: rgb(var(--tc-gold) / .15); color: rgb(var(--tc-gold)); font-weight: 600; }
  .t-item i.n { margin-left: auto; font-style: normal; font-size: 10px; color: rgb(var(--tc-muted)); }
</style>

<script>
(function () {
  'use strict';
  const $ = s => document.querySelector(s);
  const esc = v => String(v == null ? '' : v).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const api = async (u, o) => (await fetch(u, o)).json();

  let TABLAS = [], actual = null, panel = 'datos';
  let est = { pagina: 0, orden: null, desc: false, busca: '', filtroCol: '', filtroVal: '' };

  // ── Lista de tablas ──
  function pintarTablas() {
    const f = $('#filtro-tabla').value.trim().toLowerCase();
    const v = TABLAS.filter(t => !f || t.nombre.includes(f));
    $('#lista-tablas').innerHTML = '';
    let grupo = null;
    v.forEach(t => {
      if (t.esVista && grupo !== 'v') {
        grupo = 'v';
        $('#lista-tablas').insertAdjacentHTML('beforeend',
          '<div class="px-2 pt-3 pb-1 text-[10px] uppercase tracking-wider text-telecab-muted">Vistas</div>');
      }
      const d = document.createElement('div');
      d.className = 't-item' + (actual === t.nombre ? ' on' : '');
      d.innerHTML = `<i class="fa-solid ${t.esVista ? 'fa-eye' : 'fa-table'} text-[10px] opacity-60"></i>
                     <span class="truncate">${esc(t.nombre)}</span>
                     <i class="n">${t.esVista ? '' : Number(t.filas_aprox).toLocaleString('es-ES')}</i>`;
      d.title = (t.comentario || '') + (t.tamano ? ' · ' + t.tamano : '');
      d.onclick = () => abrir(t.nombre);
      $('#lista-tablas').appendChild(d);
    });
  }

  async function cargarTablas() {
    const r = await api('/explorador/api/tablas');
    if (r.status !== 'ok') return;
    TABLAS = r.tablas;
    $('#resumen').textContent =
      `${r.resumen.bd} · ${r.resumen.version} · ${r.resumen.tablas} tablas y ${r.resumen.vistas} vistas · ${r.resumen.tamano}`;
    pintarTablas();
  }

  // ── Abrir una tabla ──
  function abrir(nombre, filtro) {
    actual = nombre;
    est = { pagina: 0, orden: null, desc: false, busca: '', filtroCol: '', filtroVal: '', ...(filtro || {}) };
    $('#busca').value = '';
    $('#sin-tabla').classList.add('hidden');
    $('#panel').classList.remove('hidden');
    $('#panel').classList.add('flex');
    pintarTablas();
    ver(panel);
  }

  function ver(p) {
    panel = p;
    document.querySelectorAll('.tab').forEach(b => b.classList.toggle('on', b.dataset.p === p));
    p === 'datos' ? verDatos() : verEstructura();
  }

  // ── Datos ──
  async function verDatos() {
    $('#cuerpo').innerHTML = '<div class="p-6 text-sm text-telecab-muted">Cargando…</div>';
    const q = new URLSearchParams({
      tabla: actual, pagina: est.pagina, orden: est.orden || '', desc: est.desc ? '1' : '',
      busca: est.busca, filtroCol: est.filtroCol, filtroVal: est.filtroVal,
    });
    const r = await api('/explorador/api/datos?' + q);
    if (r.status !== 'ok') {
      $('#cuerpo').innerHTML = `<div class="p-6 text-sm text-telecab-red">${esc(r.msg)}</div>`;
      return;
    }
    $('#titulo').textContent = r.tabla;
    $('#cuenta').textContent = `${r.total.toLocaleString('es-ES')} fila(s)` +
      (est.filtroCol ? ` · filtrado por ${est.filtroCol}=${est.filtroVal}` : '');
    const fk = Object.fromEntries(r.foraneas.map(f => [f.columna, f]));
    const esNum = c => /int|numeric|double|real|serial/i.test(c.tipo);

    const cab = r.columnas.map(c => {
      const flecha = est.orden === c.nombre ? (est.desc ? ' ↓' : ' ↑') : '';
      return `<th data-col="${esc(c.nombre)}" title="${esc(c.tipo)}${c.comentario ? ' — ' + esc(c.comentario) : ''}">
                ${esc(c.nombre)}${flecha}${fk[c.nombre] ? ' <span class="fk">↗</span>' : ''}</th>`;
    }).join('');

    const cuerpo = r.filas.map(f => '<tr>' + r.columnas.map(c => {
      const v = f[c.nombre];
      if (v === null || v === undefined) return '<td><span class="nulo">null</span></td>';
      if (typeof v === 'boolean') return `<td>${v ? '✓' : '·'}</td>`;
      const txt = v instanceof Object && !(v instanceof Date) ? JSON.stringify(v) : String(v);
      const corto = txt.length > 120 ? txt.slice(0, 120) + '…' : txt;
      if (fk[c.nombre]) {
        return `<td><span class="fk" data-fk="${esc(fk[c.nombre].destino)}" data-fkc="${esc(fk[c.nombre].destino_col)}" data-fkv="${esc(txt)}">${esc(corto)}</span></td>`;
      }
      return `<td class="${esNum(c) ? 'num' : ''}" title="${esc(txt)}">${esc(corto)}</td>`;
    }).join('') + '</tr>').join('');

    $('#cuerpo').innerHTML = r.filas.length
      ? `<table class="tbl"><thead><tr>${cab}</tr></thead><tbody>${cuerpo}</tbody></table>`
      : '<div class="p-6 text-sm text-telecab-muted">Sin filas.</div>';

    // Ordenar al pinchar la cabecera
    $('#cuerpo').querySelectorAll('th').forEach(th => th.onclick = () => {
      const c = th.dataset.col;
      est.desc = est.orden === c ? !est.desc : false;
      est.orden = c; est.pagina = 0; verDatos();
    });
    // Navegar por la foránea
    $('#cuerpo').querySelectorAll('[data-fk]').forEach(s => s.onclick = () =>
      abrir(s.dataset.fk, { filtroCol: s.dataset.fkc, filtroVal: s.dataset.fkv }));

    $('#pie').classList.remove('hidden');
    $('#pie').classList.add('flex');
    $('#pag').textContent = `${r.pagina + 1} de ${Math.max(1, r.paginas)}`;
    $('#ant').disabled = r.pagina <= 0;
    $('#sig').disabled = r.pagina + 1 >= r.paginas;
    $('#tiempo').textContent = r.ms + ' ms';
  }

  // ── Estructura ──
  async function verEstructura() {
    $('#pie').classList.add('hidden');
    const r = await api('/explorador/api/estructura?tabla=' + encodeURIComponent(actual));
    if (r.status !== 'ok') return;
    $('#titulo').textContent = r.tabla;
    $('#cuenta').textContent = `${r.columnas.length} columnas`;
    const cols = r.columnas.map(c => `<tr>
      <td><code>${esc(c.nombre)}</code></td>
      <td class="text-telecab-muted">${esc(c.tipo)}</td>
      <td>${c.obligatorio ? '<span class="text-telecab-red text-[11px]">obligatorio</span>' : '<span class="nulo">admite null</span>'}</td>
      <td class="text-telecab-muted text-[11px]">${c.generada ? 'generada · ' : ''}${esc(c.predeterminado || '')}</td>
      <td class="text-telecab-muted" style="white-space:normal">${esc(c.comentario || '')}</td>
    </tr>`).join('');
    const bloque = (t, filas) => filas.length
      ? `<div class="px-3 pt-4 pb-1 text-[10px] uppercase tracking-wider text-telecab-muted">${t}</div>
         <div class="px-3 space-y-1">${filas.map(x => `<div class="text-[11.5px] text-telecab-muted"><code>${esc(x)}</code></div>`).join('')}</div>` : '';
    $('#cuerpo').innerHTML = `
      <table class="tbl"><thead><tr><th>Columna</th><th>Tipo</th><th></th><th>Por defecto</th><th>Nota</th></tr></thead>
      <tbody>${cols}</tbody></table>
      ${bloque('Restricciones', r.restricciones.map(x => x.nombre + ' — ' + x.definicion))}
      ${bloque('Índices', r.indices.map(x => x.definicion))}
      <div class="h-4"></div>`;
  }

  // ── Consulta libre ──
  async function lanzar() {
    const sql = $('#sql').value.trim();
    if (!sql) return;
    $('#sql-info').textContent = 'Ejecutando…';
    const r = await api('/explorador/api/consulta', {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ sql }),
    });
    if (r.status !== 'ok') {
      $('#sql-info').textContent = '';
      $('#sql-res').innerHTML = `<div class="p-4 text-sm text-telecab-red font-mono">${esc(r.msg)}</div>`;
      return;
    }
    $('#sql-info').textContent = `${r.total.toLocaleString('es-ES')} fila(s) · ${r.ms} ms` +
      (r.recortado ? ' · se muestran las primeras' : '');
    $('#sql-res').innerHTML = r.filas.length
      ? `<table class="tbl"><thead><tr>${r.columnas.map(c => `<th>${esc(c)}</th>`).join('')}</tr></thead>
         <tbody>${r.filas.map(f => '<tr>' + r.columnas.map(c => {
           const v = f[c];
           if (v === null || v === undefined) return '<td><span class="nulo">null</span></td>';
           const t = typeof v === 'object' ? JSON.stringify(v) : String(v);
           return `<td title="${esc(t)}">${esc(t.length > 120 ? t.slice(0, 120) + '…' : t)}</td>`;
         }).join('') + '</tr>').join('')}</tbody></table>`
      : '<div class="p-4 text-sm text-telecab-muted">Sin resultados.</div>';
  }

  // ── Eventos ──
  $('#filtro-tabla').oninput = pintarTablas;
  document.querySelectorAll('.tab').forEach(b => b.onclick = () => ver(b.dataset.p));
  $('#ant').onclick = () => { est.pagina--; verDatos(); };
  $('#sig').onclick = () => { est.pagina++; verDatos(); };
  let temp;
  $('#busca').oninput = e => { clearTimeout(temp); temp = setTimeout(() => {
    est.busca = e.target.value; est.pagina = 0; verDatos(); }, 350); };
  $('#btn-sql').onclick = () => { $('#modal-sql').classList.remove('hidden'); $('#sql').focus(); };
  $('#sql-cerrar').onclick = () => $('#modal-sql').classList.add('hidden');
  $('#sql-ir').onclick = lanzar;
  $('#sql').onkeydown = e => { if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) lanzar(); };
  document.addEventListener('keydown', e => { if (e.key === 'Escape') $('#modal-sql').classList.add('hidden'); });

  ver('datos');
  cargarTablas();
})();
</script>
