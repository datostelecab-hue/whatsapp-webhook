<div class="p-4 lg:p-6 max-w-5xl mx-auto space-y-5">

  <!-- Totales -->
  <div class="grid grid-cols-3 gap-3">
    <div class="bg-telecab-card border border-telecab-border rounded-2xl px-4 py-3">
      <p class="text-[11px] uppercase tracking-wide text-telecab-muted">Vacantes abiertas</p>
      <p id="t-abiertas" class="text-2xl font-bold text-telecab-gold">–</p>
    </div>
    <div class="bg-telecab-card border border-telecab-border rounded-2xl px-4 py-3">
      <p class="text-[11px] uppercase tracking-wide text-telecab-muted">Día ☀️</p>
      <p id="t-dia" class="text-2xl font-bold text-telecab-text">–</p>
    </div>
    <div class="bg-telecab-card border border-telecab-border rounded-2xl px-4 py-3">
      <p class="text-[11px] uppercase tracking-wide text-telecab-muted">Noche 🌙</p>
      <p id="t-noche" class="text-2xl font-bold text-telecab-text">–</p>
    </div>
  </div>

  <div class="flex items-center justify-between">
    <p class="text-xs text-telecab-muted">Vacantes que Tráfico armó y guardó en el generador. Son las que Selección recluta.</p>
    <button id="btn-recargar" class="text-xs px-3 py-1.5 rounded-lg border border-telecab-border text-telecab-muted hover:border-telecab-gold transition">
      <i class="fa-solid fa-rotate mr-1"></i> Recargar
    </button>
  </div>

  <div id="lista" class="grid gap-3 sm:grid-cols-2"></div>

  <div id="resueltas-wrap" class="hidden mt-6">
    <h2 class="text-sm font-semibold text-telecab-text mb-3 flex items-center gap-2">
      <i class="fa-solid fa-circle-check text-telecab-green"></i> Vacantes resueltas <span id="t-resueltas" class="text-telecab-muted font-normal"></span>
    </h2>
    <div id="lista-resueltas" class="grid gap-3 sm:grid-cols-2 opacity-80"></div>
  </div>

</div>

<script>
  const $ = s => document.querySelector(s);
  const esc = s => String(s == null ? '' : s).replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));

  const COLOR_VAC = {
    'Abierta': 'bg-telecab-gold/10 text-telecab-gold border-telecab-gold/30',
    'En proceso de alta': 'bg-amber-500/10 text-amber-400 border-amber-500/30',
    'Cerrada': 'bg-telecab-green/10 text-telecab-green border-telecab-green/30'
  };
  const COLOR_ETAPA = {
    'Preselección': 'text-telecab-muted', 'Coordinación de entrevista': 'text-sky-400',
    'Entrevistado': 'text-telecab-gold', 'Reconocimiento médico': 'text-orange-400',
    'Relevamiento de datos': 'text-telecab-gold', 'Pendiente en BOLT': 'text-telecab-gold',
    'Aprobado en BOLT': 'text-telecab-green', 'Alta procesada - habilitado': 'text-telecab-green',
    'Descartado': 'text-telecab-red', 'Rechazado en BOLT': 'text-telecab-red'
  };

  function ficha(v) {
    const mats = (v.matriculas || []).map(m =>
      `<span class="inline-flex items-center gap-1 mr-1.5 mb-1 px-2 py-0.5 rounded-lg bg-telecab-dark/60 border border-telecab-border">
         <span class="font-mono text-telecab-text">${esc(m.m)}</span>
         <span class="text-telecab-gold text-xs">${esc(m.letras || '')}</span></span>`).join('');
    const cands = (v.candidatos || []).length
      ? `<div class="mt-3 pt-2 border-t border-telecab-border/60">
           <p class="text-[11px] uppercase tracking-wide text-telecab-muted mb-1">Candidatos (${v.candidatos.length})</p>` +
        v.candidatos.map(c => `<div class="flex items-center justify-between text-sm py-0.5">
             <span class="text-telecab-text truncate">${esc(c.nombre)}</span>
             <span class="${COLOR_ETAPA[c.estado] || 'text-telecab-muted'} text-xs whitespace-nowrap ml-2">${esc(c.estado)}</span></div>`).join('') +
        `</div>`
      : `<div class="mt-3 pt-2 border-t border-telecab-border/60 text-[11px] text-telecab-muted">Sin candidatos asignados aún.</div>`;
    return `<div class="bg-telecab-card border border-telecab-border rounded-2xl p-4">
      <div class="flex items-center justify-between mb-2">
        <h3 class="text-base font-semibold text-telecab-text"><i class="fa-solid fa-briefcase text-telecab-gold mr-1"></i> ${esc(v.puesto)}</h3>
        <span class="text-[11px] px-2 py-0.5 rounded-full border ${COLOR_VAC[v.estado] || COLOR_VAC['Abierta']}">${esc(v.estado || 'Abierta')}</span>
      </div>
      <p class="text-sm text-telecab-muted mb-2"><i class="fa-solid fa-location-dot mr-1 text-telecab-gold/70"></i> ${esc(v.zonas || '—')}</p>
      <div class="mb-2"><span class="text-xs text-telecab-muted">Matrículas:</span><br>${mats || '<span class="text-telecab-muted text-sm">—</span>'}</div>
      <p class="text-sm text-telecab-text">Libranzas: <span class="font-mono text-telecab-muted">${esc(v.libranzas || '—')}</span>
        <span class="text-telecab-muted">· ${/^Fijo/.test(v.puesto || '') ? 'toda la semana' : (v.dias || 0) + ' días'}</span></p>
      ${cands}
      <p class="text-[11px] text-telecab-muted mt-2">${esc(v.fecha || '')} · ${esc(v.id)}</p>
    </div>`;
  }

  async function cargar() {
    const r = await (await fetch('/vacantes/api/datos')).json();
    if (r.status !== 'ok') return;
    $('#t-abiertas').textContent = r.contadores.abiertas;
    $('#t-dia').textContent = r.contadores.dia;
    $('#t-noche').textContent = r.contadores.noche;
    const cont = $('#lista');
    if (!r.vacantes.length) cont.innerHTML = '<p class="text-telecab-muted col-span-full">No hay vacantes pendientes. Tráfico las arma en el Generador de vacantes.</p>';
    else cont.innerHTML = r.vacantes.map(ficha).join('');

    const res = r.resueltas || [];
    $('#resueltas-wrap').classList.toggle('hidden', !res.length);
    $('#t-resueltas').textContent = res.length ? '(' + res.length + ')' : '';
    $('#lista-resueltas').innerHTML = res.map(ficha).join('');
  }

  $('#btn-recargar').addEventListener('click', cargar);
  cargar();
</script>
