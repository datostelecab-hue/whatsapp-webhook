<div class="p-4 lg:p-6 max-w-[1500px] mx-auto space-y-5">

  <!-- ══════════ VISTA TABLA (bandeja) ══════════ -->
  <div id="vista-tabla" class="space-y-5">

    <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
      <div class="bg-telecab-card border border-telecab-border rounded-2xl px-4 py-3">
        <p class="text-[11px] uppercase tracking-wide text-telecab-muted">Pendientes</p>
        <p id="c-pend" class="text-2xl font-bold text-telecab-gold">–</p>
      </div>
      <div class="bg-telecab-card border border-telecab-border rounded-2xl px-4 py-3">
        <p class="text-[11px] uppercase tracking-wide text-telecab-muted">Resueltos</p>
        <p id="c-res" class="text-2xl font-bold text-telecab-green">–</p>
      </div>
      <div class="bg-telecab-card border border-telecab-border rounded-2xl px-4 py-3">
        <p class="text-[11px] uppercase tracking-wide text-telecab-muted">Afectan al planificador</p>
        <p id="c-plan" class="text-2xl font-bold text-telecab-text">–</p>
      </div>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-2">
      <div class="flex gap-1 bg-telecab-card border border-telecab-border rounded-2xl p-1">
        <button data-tab="pendientes" class="tab-btn px-3 py-2 rounded-xl text-sm font-medium transition"><i class="fa-solid fa-inbox mr-1.5"></i>Pendientes</button>
        <button data-tab="resueltos"  class="tab-btn px-3 py-2 rounded-xl text-sm font-medium transition"><i class="fa-solid fa-box-archive mr-1.5"></i>Resueltos</button>
      </div>
    </div>

    <div id="chips" class="flex flex-wrap gap-2"></div>

    <p id="cargando" class="text-telecab-muted text-sm">Cargando…</p>
    <div id="pane-pendientes" class="tab-pane hidden"></div>
    <div id="pane-resueltos"  class="tab-pane hidden"></div>
  </div>

  <!-- ══════════ VISTA DETALLE (un ticket) ══════════ -->
  <div id="vista-detalle" class="hidden max-w-4xl mx-auto">
    <button id="volver" class="mb-4 inline-flex items-center gap-2 text-sm text-telecab-muted hover:text-telecab-gold transition">
      <i class="fa-solid fa-arrow-left"></i> Volver a la bandeja
    </button>
    <div id="detalle"></div>
  </div>

</div>

<script>
  const $ = s => document.querySelector(s);
  const esc = s => (s == null ? '' : String(s)).replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
  const INP = 'w-full text-sm bg-telecab-dark border border-telecab-border rounded-lg px-2 py-1.5 text-telecab-text focus:outline-none focus:border-telecab-gold transition';
  const PLANNING = ['VACACIONES', 'BAJA_AUSENCIA', 'PERMISO_RETRIBUIDO'];
  const ESTADOS = ['Pendiente', 'En curso', 'Aprobado', 'Ejecutado', 'Rechazado', 'No procede'];
  const ESTADOS_RES = ['Ejecutado', 'Aprobado', 'Rechazado', 'No procede'];
  const MI_EMAIL = <%- JSON.stringify((typeof usuario !== 'undefined' && usuario && usuario.email) || '') %>;

  let DATOS = { pendientes: [], resueltos: [] };
  let tablaPendientes = null;
  const soloFecha = s => { const m = String(s || '').match(/(\d{1,2})[\/\-.](\d{1,2})[\/\-.](\d{4})/); return m ? `${m[1].padStart(2, '0')}/${m[2].padStart(2, '0')}/${m[3]}` : ''; };

  const badgeEstado = e => {
    const v = (e || '').trim();
    const map = { 'Pendiente': 'bg-amber-500/15 text-amber-400 border-amber-500/40', 'En curso': 'bg-sky-500/15 text-sky-400 border-sky-500/40',
      'Aprobado': 'bg-telecab-gold/15 text-telecab-gold border-telecab-gold/40', 'Ejecutado': 'bg-telecab-green/15 text-telecab-green border-telecab-green/40',
      'Rechazado': 'bg-telecab-red/10 text-telecab-red border-telecab-red/40', 'No procede': 'bg-telecab-dark text-telecab-muted border-telecab-border' };
    return `<span class="text-xs px-2 py-0.5 rounded-lg border whitespace-nowrap ${map[v] || 'bg-telecab-dark text-telecab-muted border-telecab-border'}">${esc(v || '—')}</span>`;
  };
  const esPlanning = t => PLANNING.includes((t.subtipo || '').toUpperCase());

  // ═══════════ TABLA ═══════════
  const COLS_PEND = [
    { key: 'fecha_creacion', label: 'Creado', tipo: 'text' },
    { key: 'nombre', label: 'Conductor', tipo: 'text', link: true },
    { key: 'id_bolt', label: 'ID_BOLT', tipo: 'text' },
    { key: 'telefono', label: 'Teléfono', tipo: 'text' },
    { key: 'subtipo', label: 'Subtipo', tipo: 'select' },
    { key: 'fecha_inicio_evento', label: 'Inicio evento', tipo: 'text' },
    { key: 'numero_de_dias', label: 'Días', tipo: 'text' },
    { key: 'estado', label: 'Estado', tipo: 'select', render: t => badgeEstado(t.estado) },
    { key: 'afecta_planning', label: 'Planning', tipo: 'select' }
  ];
  const COLS_RES = [
    { key: 'fecha_resolucion', label: 'Resuelto', tipo: 'text' },
    { key: 'nombre', label: 'Conductor', tipo: 'text', link: true },
    { key: 'id_bolt', label: 'ID_BOLT', tipo: 'text' },
    { key: 'subtipo', label: 'Subtipo', tipo: 'select' },
    { key: 'estado', label: 'Estado', tipo: 'select', render: t => badgeEstado(t.estado) },
    { key: 'usuario_resolucion', label: 'Resuelto por', tipo: 'select' }
  ];

  function construirTabla(paneSel, cols, filas, cfg) {
    const pane = $(paneSel);
    const filtros = {};
    const celda = (f, k) => { const c = cols.find(x => x.key === k); const v = f[k]; return String(c && c.fmt ? c.fmt(v, f) : (v == null ? '' : v)); };
    const unicos = k => [...new Set(filas.map(f => celda(f, k)).filter(v => v.trim()))].sort((a, b) => a.localeCompare(b, 'es'));
    const pasa = f => cols.every(c => {
      const val = String(filtros[c.key] || '').trim().toLowerCase();
      if (!val) return true;
      const cell = celda(f, c.key).toLowerCase();
      return c.tipo === 'select' ? cell === val : cell.includes(val);
    });

    const ths = cols.map(c => `<th class="px-4 py-3 text-left text-[11px] uppercase tracking-wide text-telecab-muted font-semibold whitespace-nowrap bg-telecab-card border-b border-telecab-border">${esc(c.label)}</th>`).join('');
    const filtroCells = cols.map(c => c.tipo === 'select'
      ? `<th class="px-2 py-1.5 bg-telecab-card2 border-b border-telecab-border"><select data-filtro="${c.key}" class="w-full text-xs bg-telecab-dark border border-telecab-border rounded-lg px-2 py-1.5 text-telecab-text focus:outline-none focus:border-telecab-gold transition"><option value="">Todos</option>${unicos(c.key).map(v => `<option value="${esc(v)}">${esc(v)}</option>`).join('')}</select></th>`
      : `<th class="px-2 py-1.5 bg-telecab-card2 border-b border-telecab-border"><input data-filtro="${c.key}" placeholder="filtrar…" class="w-full text-xs bg-telecab-dark border border-telecab-border rounded-lg px-2 py-1.5 text-telecab-text focus:outline-none focus:border-telecab-gold transition"></th>`).join('');

    pane.innerHTML =
      `<div class="flex items-center justify-between gap-2 mb-3 flex-wrap">
         <span data-count class="text-sm text-telecab-muted"></span>
         <div class="flex items-center gap-2">
           <button data-limpiar class="text-xs px-2.5 py-1.5 rounded-lg border border-telecab-border text-telecab-muted hover:text-telecab-text hover:border-telecab-gold/50 transition"><i class="fa-solid fa-filter-circle-xmark mr-1"></i>Limpiar filtros</button>
           <button data-export class="text-xs px-3 py-1.5 rounded-lg bg-telecab-gold/15 border border-telecab-gold/40 text-telecab-gold hover:bg-telecab-gold/25 transition font-medium"><i class="fa-solid fa-file-excel mr-1"></i> Exportar a Excel</button>
         </div>
       </div>
       <div class="bg-telecab-card border border-telecab-border rounded-2xl overflow-auto max-h-[calc(100vh-18rem)]">
         <table class="w-full text-sm border-separate border-spacing-0">
           <thead class="sticky top-0 z-10"><tr>${ths}</tr><tr>${filtroCells}</tr></thead>
           <tbody data-body></tbody>
         </table>
       </div>`;
    const tbody = pane.querySelector('[data-body]');
    function render() {
      const vis = filas.filter(pasa);
      tbody.innerHTML = vis.length ? vis.map((f, i) => `<tr class="${i % 2 ? 'bg-telecab-dark/15' : ''} hover:bg-telecab-gold/5 transition">${cols.map(c => {
        if (c.render) return `<td class="px-4 py-2.5 border-b border-telecab-border/20">${c.render(f)}</td>`;
        const txt = esc(celda(f, c.key));
        if (c.link) return `<td class="px-4 py-2.5 border-b border-telecab-border/20 whitespace-nowrap"><button data-ticket="${esc(f.ticket_id || '')}" class="text-telecab-gold hover:underline text-left font-medium">${txt || '—'}</button></td>`;
        return `<td class="px-4 py-2.5 border-b border-telecab-border/20 text-telecab-text whitespace-nowrap">${txt || '<span class="text-telecab-muted/40">—</span>'}</td>`;
      }).join('')}</tr>`).join('') : `<tr><td colspan="${cols.length}" class="px-4 py-10 text-center text-telecab-muted">Sin resultados con esos filtros.</td></tr>`;
      pane.querySelector('[data-count]').innerHTML = `<b class="text-telecab-text">${vis.length}</b> de ${filas.length}`;
      tbody.querySelectorAll('[data-ticket]').forEach(b => b.addEventListener('click', () => abrirDetalle(b.dataset.ticket)));
    }
    function setFiltros(map) {
      pane.querySelectorAll('[data-filtro]').forEach(el => { el.value = ''; filtros[el.dataset.filtro] = ''; });
      Object.entries(map || {}).forEach(([k, v]) => { const el = pane.querySelector(`[data-filtro="${k}"]`); if (el) el.value = v; filtros[k] = v; });
      render();
    }
    pane.querySelectorAll('[data-filtro]').forEach(el => el.addEventListener('input', () => { filtros[el.dataset.filtro] = el.value; render(); }));
    pane.querySelector('[data-limpiar]').addEventListener('click', () => setFiltros({}));
    pane.querySelector('[data-export]').addEventListener('click', () => exportarExcel(cfg.titulo, cols, filas.filter(pasa)));
    render();
    return { setFiltros };
  }

  async function exportarExcel(titulo, cols, filas) {
    const columnas = cols.map(c => ({ key: c.key, label: c.label }));
    const planas = filas.map(f => { const o = {}; cols.forEach(c => { const v = f[c.key]; o[c.key] = String(c.fmt ? c.fmt(v, f) : (v == null ? '' : v)); }); return o; });
    try {
      const r = await fetch('/ticketera/excel', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ titulo, columnas, filas: planas }) });
      if (!r.ok) throw new Error('error');
      const blob = await r.blob(); const url = URL.createObjectURL(blob);
      const a = document.createElement('a'); a.href = url; a.download = titulo.replace(/\s+/g, '_') + '.xlsx';
      document.body.appendChild(a); a.click(); a.remove(); URL.revokeObjectURL(url);
    } catch (e) { alert('No se pudo exportar el Excel.'); }
  }

  function pintarChips(porSubtipo) {
    const cont = $('#chips'); cont.innerHTML = '';
    const keys = Object.keys(porSubtipo || {}).filter(k => k && k !== '—').sort((a, b) => porSubtipo[b] - porSubtipo[a]);
    if (!keys.length) return;
    const hint = document.createElement('span');
    hint.className = 'text-xs text-telecab-muted self-center mr-1';
    hint.innerHTML = '<i class="fa-solid fa-hand-pointer mr-1"></i>Filtrar por subtipo:';
    cont.appendChild(hint);
    keys.forEach(k => {
      const plan = PLANNING.includes(k.toUpperCase());
      const el = document.createElement('button');
      el.className = 'text-xs px-3 py-1.5 rounded-xl border transition hover:border-telecab-gold ' + (plan ? 'bg-telecab-gold/10 text-telecab-gold border-telecab-gold/40' : 'bg-telecab-card text-telecab-text border-telecab-border');
      el.innerHTML = `${esc(k)} · <b>${porSubtipo[k]}</b>`;
      el.addEventListener('click', () => { activar('pendientes'); if (tablaPendientes) tablaPendientes.setFiltros({ subtipo: k }); });
      cont.appendChild(el);
    });
  }

  // ═══════════ DETALLE ═══════════
  function bloque(titulo, filas) {
    return `<div class="bg-telecab-card border border-telecab-border rounded-2xl p-4">
      <h3 class="text-xs font-semibold uppercase tracking-wide text-telecab-gold mb-3">${esc(titulo)}</h3>
      <dl class="grid sm:grid-cols-2 gap-x-5 gap-y-3">${filas.map(([l, v]) => `<div><dt class="text-[11px] uppercase tracking-wide text-telecab-muted mb-0.5">${esc(l)}</dt><dd class="text-sm ${v ? 'text-telecab-text' : 'text-telecab-muted/50'} break-words">${v ? esc(v) : '—'}</dd></div>`).join('')}</dl>
    </div>`;
  }
  function avisoD(t, cls) { const m = $('#d-msg'); if (!m) return; m.textContent = t; m.className = 'text-xs ' + cls; m.classList.remove('hidden'); }
  async function post(url, body) {
    const r = await (await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) })).json();
    if (r.status !== 'ok') throw new Error(r.msg || 'error');
    return r;
  }

  function abrirDetalle(ticketId) {
    const t = DATOS.pendientes.find(x => x.ticket_id === ticketId) || DATOS.resueltos.find(x => x.ticket_id === ticketId);
    if (!t) return;
    const resuelto = !DATOS.pendientes.some(x => x.ticket_id === ticketId);
    pintarDetalle(t, resuelto);
    $('#vista-tabla').classList.add('hidden');
    $('#vista-detalle').classList.remove('hidden');
    window.scrollTo(0, 0);
  }
  $('#volver').addEventListener('click', () => { $('#vista-detalle').classList.add('hidden'); $('#vista-tabla').classList.remove('hidden'); });

  function pintarDetalle(t, resuelto) {
    const nombre = (t.nombre || '').trim() || '(sin nombre)';
    const evento = [soloFecha(t.fecha_inicio_evento), soloFecha(t.fecha_fin_evento)].filter(Boolean).join(' → ') || (t.fecha_inicio_evento || '');
    const cabecera =
      `<div class="mb-4">
         <div class="flex items-start justify-between gap-3 flex-wrap">
           <div>
             <h2 class="text-2xl font-bold text-telecab-text">${esc(t.tipo_gestion || t.subtipo || 'Ticket')}</h2>
             <p class="text-sm text-telecab-muted mt-1 font-mono">${esc(t.ticket_id || '')}</p>
           </div>
           <div class="flex items-center gap-2 flex-wrap justify-end">
             ${badgeEstado(t.estado)}
             ${esPlanning(t) ? '<span class="text-xs px-2 py-0.5 rounded-lg border bg-telecab-gold/10 text-telecab-gold border-telecab-gold/40"><i class="fa-solid fa-table-cells-large mr-1"></i>Afecta planning</span>' : ''}
           </div>
         </div>
       </div>`;

    const secciones =
      bloque('Conductor', [['Nombre', nombre], ['ID_BOLT', t.id_bolt], ['DNI', t.dni], ['Teléfono', t.telefono]]) +
      bloque('Clasificación', [['Área', t.area], ['Tipo de gestión', t.tipo_gestion], ['Subtipo', t.subtipo], ['Prioridad', t.prioridad], ['¿Afecta al planificador?', t.afecta_planning]]) +
      `<div class="bg-telecab-card border border-telecab-border rounded-2xl p-4">
         <h3 class="text-xs font-semibold uppercase tracking-wide text-telecab-gold mb-2">Descripción</h3>
         <p class="text-sm text-telecab-text whitespace-pre-wrap break-words">${esc(t.descripcion_compilada || '—')}</p>
       </div>` +
      bloque('Evento', [['Rango', evento], ['Nº de días', t.numero_de_dias], ['Matrícula', t.matricula]]) +
      bloque('Gestión', [['Creado', t.fecha_creacion || t.marca_temporal], ['Responsable', t.responsable_email], ['Fecha asignación', t.fecha_asignacion],
        ['Fecha resolución', t.fecha_resolucion], ['Resuelto por', t.usuario_resolucion], ['Tiempo (h)', t.tiempo_resolucion_horas]]);

    if (resuelto) {
      $('#detalle').innerHTML = cabecera + `<div class="space-y-4">${secciones}` +
        (t.observaciones_gestion ? `<div class="bg-telecab-card border border-telecab-border rounded-2xl p-4"><h3 class="text-xs font-semibold uppercase tracking-wide text-telecab-gold mb-2">Observaciones</h3><p class="text-sm text-telecab-text whitespace-pre-wrap break-words">${esc(t.observaciones_gestion)}</p></div>` : '') +
        `</div>`;
      return;
    }

    // Panel de acciones (solo tickets activos)
    const panelPlanning = esPlanning(t) ? `
      <div class="bg-telecab-gold/5 border border-telecab-gold/30 rounded-2xl p-4">
        <h3 class="text-xs font-semibold uppercase tracking-wide text-telecab-gold mb-1">Aplicar al planificador</h3>
        <p class="text-[11px] text-telecab-muted mb-3">Crea la ausencia en el planificador (libera la plaza y escribe las letras V/B/P). El conductor se busca por ID_BOLT y, si no, por DNI/teléfono.</p>
        <div class="grid sm:grid-cols-2 gap-3 mb-3">
          <div><label class="text-[11px] uppercase tracking-wide text-telecab-muted">Desde</label><input id="ap-desde" value="${esc(soloFecha(t.fecha_inicio_evento))}" placeholder="dd/mm/aaaa" readonly data-max="" class="js-fecha ${INP}"></div>
          <div><label class="text-[11px] uppercase tracking-wide text-telecab-muted">Hasta</label><input id="ap-hasta" value="${esc(soloFecha(t.fecha_fin_evento))}" placeholder="dd/mm/aaaa" readonly class="js-fecha ${INP}"></div>
        </div>
        <button id="d-aplicar" class="px-3 py-1.5 rounded-lg bg-telecab-gold/15 border border-telecab-gold/40 text-telecab-gold hover:bg-telecab-gold/25 transition text-sm font-medium"><i class="fa-solid fa-table-cells-large mr-1"></i> Aplicar al planificador</button>
      </div>` : '';

    const acciones = `
      <div class="bg-telecab-card border border-telecab-border rounded-2xl p-4 space-y-4">
        <h3 class="text-xs font-semibold uppercase tracking-wide text-telecab-gold">Gestionar</h3>
        <div class="flex flex-wrap items-center gap-2">
          <button id="d-asignar" class="px-3 py-1.5 rounded-lg bg-telecab-card2 border border-telecab-border text-telecab-text hover:border-telecab-gold transition text-sm"><i class="fa-solid fa-user-check mr-1"></i> Asignármelo</button>
          <span class="text-xs text-telecab-muted">${t.responsable_email ? 'Responsable: ' + esc(t.responsable_email) : 'Sin responsable'}</span>
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <label class="text-xs text-telecab-muted">Estado:</label>
          <select id="d-estado" class="text-sm bg-telecab-dark border border-telecab-border rounded-lg px-2 py-1.5 text-telecab-text">${ESTADOS.map(e => `<option ${e === (t.estado || '') ? 'selected' : ''}>${e}</option>`).join('')}</select>
          <button id="d-estado-btn" class="px-3 py-1.5 rounded-lg bg-telecab-card2 border border-telecab-border text-telecab-text hover:border-telecab-gold transition text-sm">Cambiar</button>
        </div>
        <div>
          <label class="text-[11px] uppercase tracking-wide text-telecab-muted">Observaciones de gestión</label>
          <textarea id="d-obs" rows="2" class="${INP}" placeholder="Notas internas…">${esc(t.observaciones_gestion || '')}</textarea>
          <button id="d-obs-btn" class="mt-2 px-3 py-1.5 rounded-lg bg-telecab-card2 border border-telecab-border text-telecab-text hover:border-telecab-gold transition text-sm"><i class="fa-solid fa-floppy-disk mr-1"></i> Guardar observaciones</button>
        </div>
      </div>`;

    const resolver = `
      <div class="bg-telecab-green/5 border border-telecab-green/30 rounded-2xl p-4">
        <h3 class="text-xs font-semibold uppercase tracking-wide text-telecab-green mb-1">Resolver y archivar</h3>
        <p class="text-[11px] text-telecab-muted mb-3">Rellena la resolución (con tu email y el tiempo) y <b>mueve</b> el ticket a RESUELTOS_RRHH.</p>
        <div class="flex flex-wrap items-center gap-2">
          <label class="text-xs text-telecab-muted">Cerrar como:</label>
          <select id="d-res-estado" class="text-sm bg-telecab-dark border border-telecab-border rounded-lg px-2 py-1.5 text-telecab-text">${ESTADOS_RES.map(e => `<option>${e}</option>`).join('')}</select>
          <button id="d-resolver" class="px-3 py-1.5 rounded-lg bg-telecab-green/15 border border-telecab-green/40 text-telecab-green hover:bg-telecab-green/25 transition text-sm font-medium"><i class="fa-solid fa-box-archive mr-1"></i> Resolver y archivar</button>
        </div>
      </div>`;

    $('#detalle').innerHTML = cabecera +
      `<div class="flex items-center gap-2 mb-3"><span id="d-msg" class="text-xs hidden"></span></div>` +
      `<div class="space-y-4">${secciones}${panelPlanning}${acciones}${resolver}</div>`;

    // ── Handlers ──
    $('#d-asignar').addEventListener('click', () => accion(() => post('/ticketera/asignar', { ticketId: t.ticket_id, email: MI_EMAIL }), t.ticket_id, 'Asignado a ' + (MI_EMAIL || 'ti')));
    $('#d-estado-btn').addEventListener('click', () => accion(() => post('/ticketera/estado', { ticketId: t.ticket_id, estado: $('#d-estado').value }), t.ticket_id, 'Estado actualizado'));
    $('#d-obs-btn').addEventListener('click', () => accion(() => post('/ticketera/observaciones', { ticketId: t.ticket_id, texto: $('#d-obs').value }), t.ticket_id, 'Observaciones guardadas'));
    const ap = $('#d-aplicar');
    if (ap) ap.addEventListener('click', () => {
      if (!confirm(`¿Aplicar "${t.subtipo}" de ${nombre} al planificador (${$('#ap-desde').value} → ${$('#ap-hasta').value})?`)) return;
      accion(() => post('/ticketera/aplicar-planificador', { ticketId: t.ticket_id, desde: $('#ap-desde').value, hasta: $('#ap-hasta').value }), t.ticket_id, 'Aplicado al planificador');
    });
    $('#d-resolver').addEventListener('click', () => {
      const estado = $('#d-res-estado').value;
      if (!confirm(`¿Resolver el ticket como "${estado}" y archivarlo en RESUELTOS_RRHH?`)) return;
      accion(() => post('/ticketera/resolver', { ticketId: t.ticket_id, estado, observaciones: ($('#d-obs') ? $('#d-obs').value : '') }), t.ticket_id, 'Resuelto y archivado', true);
    });
  }

  // Ejecuta una acción, refresca los datos y re-pinta el detalle (o vuelve si el ticket ya no está activo).
  async function accion(fn, ticketId, okMsg, volverSiempre) {
    avisoD('Guardando…', 'text-telecab-muted');
    try {
      await fn();
      await recargar();
      avisoD(okMsg, 'text-telecab-green');
      const sigue = DATOS.pendientes.find(x => x.ticket_id === ticketId);
      if (volverSiempre || !sigue) { $('#vista-detalle').classList.add('hidden'); $('#vista-tabla').classList.remove('hidden'); }
      else pintarDetalle(sigue, false);
    } catch (e) { avisoD('No se pudo: ' + e.message, 'text-telecab-red'); }
  }

  // ── Pestañas ──
  function activar(tab) {
    document.querySelectorAll('.tab-btn').forEach(b => {
      const on = b.dataset.tab === tab;
      b.className = 'tab-btn px-3 py-2 rounded-xl text-sm font-medium transition ' + (on ? 'bg-telecab-gold/15 text-telecab-gold' : 'text-telecab-muted hover:text-telecab-text');
    });
    document.querySelectorAll('.tab-pane').forEach(p => p.classList.add('hidden'));
    $('#chips').classList.toggle('hidden', tab !== 'pendientes');
    $('#pane-' + tab).classList.remove('hidden');
    try { localStorage.setItem('telecab-ticketera-tab', tab); } catch (_) {}
  }
  document.querySelectorAll('.tab-btn').forEach(b => b.addEventListener('click', () => activar(b.dataset.tab)));

  async function recargar() {
    const r = await (await fetch('/ticketera/api/datos')).json();
    if (r.status !== 'ok') throw new Error(r.msg || 'error');
    DATOS = r;
    $('#c-pend').textContent = r.contadores.pendientes;
    $('#c-res').textContent = r.contadores.resueltos;
    $('#c-plan').textContent = r.contadores.afectaPlanning;
    tablaPendientes = construirTabla('#pane-pendientes', COLS_PEND, r.pendientes || [], { titulo: 'Tickets pendientes' });
    construirTabla('#pane-resueltos', COLS_RES, r.resueltos || [], { titulo: 'Tickets resueltos' });
    pintarChips(r.porSubtipo);
  }

  async function cargar() {
    try {
      await recargar();
      $('#cargando').classList.add('hidden');
      let tab = 'pendientes';
      try { tab = localStorage.getItem('telecab-ticketera-tab') || 'pendientes'; } catch (_) {}
      activar(tab);
    } catch (e) { $('#cargando').textContent = 'No se pudieron cargar los tickets: ' + e.message; }
  }

  cargar();
</script>
