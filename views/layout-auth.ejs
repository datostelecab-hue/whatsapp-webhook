<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Telecab · <%= titulo || 'Acceso' %></title>
  <link rel="icon" type="image/png" href="<%= typeof est === 'function' ? est('/assets/logo-sinfondo-256.png') : '/assets/logo-sinfondo-256.png' %>">
  <link rel="apple-touch-icon" href="<%= typeof est === 'function' ? est('/assets/logo-sinfondo-256.png') : '/assets/logo-sinfondo-256.png' %>">
  <meta name="theme-color" content="#060a15">
  <%
    const _est = p => (typeof est === 'function' ? est(p) : p);
    // LA PORTADA (V3): el Corolla de noche (scripts/fondo-acceso/portada-corolla.py).
    // Debajo, por si la foto no está en este servidor, la ciudad de siempre
    // (scripts/fondo-acceso/): un fondo que falla deja ver el siguiente.
    const PORTADA = { grande: _est('/assets/acceso/portada.webp'), movil: _est('/assets/acceso/portada-900.webp') };
    const RESPALDO = { grande: _est('/assets/acceso/madrid.webp'), movil: _est('/assets/acceso/madrid-1280.webp') };
    // Quien entra por primera vez (crea su contraseña) no vuelve: se le da la bienvenida.
    const PRIMERA_VEZ = typeof primerAcceso !== 'undefined' && primerAcceso;
  %>

  <!-- EL TEMA, SIEMPRE EN SU VERSIÓN OSCURA. El acceso va sobre una foto de
       noche: los textos son claros y el fondo oscuro en todos los temas. Del
       tema de cada uno se conserva el ACENTO (el azul, o su verde, su rosa...),
       que es lo que lo hace suyo: «claro-azul» se pinta como «azul» y «light»
       como «dark». -->
  <script nonce="<%= nonce %>">
    (function () {
      try {
        var pref = localStorage.getItem('telecab-tema') || 'dark';
        if (pref === 'auto' || pref === 'light') pref = 'dark';
        if (pref.indexOf('claro-') === 0) pref = pref.slice(6);
        document.documentElement.setAttribute('data-theme', pref);
      } catch (e) { document.documentElement.setAttribute('data-theme', 'dark'); }
      // La sede: la última elegida en este navegador (la marca el formulario).
      try {
        document.documentElement.setAttribute('data-sede', localStorage.getItem('telecab-sede') === 'barcelona' ? 'barcelona' : 'madrid');
      } catch (e) { document.documentElement.setAttribute('data-sede', 'madrid'); }
    })();
  </script>
  <link rel="stylesheet" href="<%= _est('/assets/css/telecab.css') %>">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

  <style>
    /* ── LA PANTALLA DE ACCESO (V3, 16/11/2026) ──────────────────────────────
       Como la referencia que trajo Camilo: la pantalla partida en dos. A la
       IZQUIERDA, la foto —un Toyota Corolla, el coche de la flota, de noche y
       en el azul de la casa—, con la marca, el lema y cuatro cosas que se hacen
       dentro. A la DERECHA, sobre el azul noche, el formulario en su tarjeta:
       campos oscuros con su icono, la etiqueta encima y el botón del acento.

       Siempre en oscuro (la foto es de noche); de cada tema se conserva el
       acento. En el móvil, una columna: la foto es una franja arriba y la
       tarjeta sube sobre ella. */

    html, body { min-height: 100%; }
    body { background: #060a15; color: #EEF2FA; }
    ::selection { background: rgb(var(--tc-gold) / .4); color: #fff; }

    .acceso { min-height: 100svh; display: grid; grid-template-columns: minmax(0, 1fr); grid-template-rows: auto 1fr; background: #060a15; }
    @media (min-width: 960px) {
      .acceso { grid-template-columns: minmax(0, 1.12fr) minmax(0, 1fr); grid-template-rows: minmax(0, 1fr); }
    }

    /* ── La portada ── */
    .portada { position: relative; isolation: isolate; overflow: hidden; display: flex; flex-direction: column;
      min-height: 14.5rem; padding: 1.4rem clamp(1.25rem, 3.4vw, 3rem) 3.4rem; }
    .portada-foto { position: absolute; inset: 0; z-index: -2; background-color: #0a1022;
      background-image: url('<%= PORTADA.movil %>'), url('<%= RESPALDO.movil %>');
      background-repeat: no-repeat; background-size: cover, cover; background-position: 58% 62%, center;
      animation: asienta 2.2s cubic-bezier(.22, 1, .36, 1) backwards; }
    /* El velo: oscuro arriba (el lema) y abajo (las cuatro cosas), y un punto a
       la derecha, para que la foto se funda con el lado del formulario. */
    .portada::after { content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
      background:
        linear-gradient(180deg, rgb(4 8 20 / .86) 0%, rgb(4 8 20 / .5) 24%, rgb(4 8 20 / 0) 46%, rgb(4 8 20 / .1) 68%, rgb(4 8 20 / .9) 100%),
        linear-gradient(90deg, rgb(4 8 20 / .3) 0%, rgb(4 8 20 / 0) 40%, rgb(4 8 20 / .6) 100%); }
    @media (min-width: 960px) {
      .portada { min-height: 100svh; padding: 1.75rem clamp(1.5rem, 3.4vw, 3.25rem) 1.9rem; }
      .portada-foto { background-image: url('<%= PORTADA.grande %>'), url('<%= RESPALDO.grande %>'); background-position: 50% 28%, center; }
    }

    /* La marca, arriba a la izquierda. */
    .cabecera { display: flex; align-items: center; gap: .7rem; }
    .cabecera .tc-marca-pin path { fill: rgb(var(--tc-gold)); }
    .cabecera .tc-marca-via { stroke: rgb(255 255 255 / .9); }
    .cabecera .tc-marca-carril { stroke: rgb(255 255 255 / .5); }
    .cabecera .tc-marca-sombra { fill: rgb(255 255 255 / .2); }
    .cabecera .nombre { display: flex; flex-direction: column; line-height: 1.1; }
    .cabecera b { font-size: 1.35rem; font-weight: 800; letter-spacing: -.02em; }
    .cabecera b span { color: rgb(var(--tc-gold)); }
    .cabecera small { font-size: .72rem; font-weight: 500; color: rgb(226 232 245 / .7); }

    /* El lema. */
    .lema { margin-top: clamp(1.4rem, 5.5vh, 3.4rem); max-width: 34rem; }
    .lema h2 { font-size: clamp(1.7rem, 3.5vw, 3.3rem); line-height: 1.07; font-weight: 800; letter-spacing: -.03em;
      text-wrap: balance; text-shadow: 0 2px 24px rgb(0 0 0 / .45); }
    .lema p { margin-top: 1rem; max-width: 31ch; font-size: 1.02rem; line-height: 1.55; font-weight: 500; color: rgb(226 232 245 / .88);
      text-shadow: 0 1px 12px rgb(0 0 0 / .5); }

    /* Las cuatro cosas, abajo: un icono en su cuadro de color y dos palabras. */
    .ventajas { margin-top: auto; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .75rem; padding-top: 1.5rem;
      list-style: none; }
    .ventajas li { display: flex; flex-direction: column; align-items: center; gap: .6rem; text-align: center;
      font-size: .84rem; font-weight: 600; line-height: 1.3; color: rgb(238 242 250 / .95); }
    .ventajas .cuadro { width: 2.9rem; height: 2.9rem; border-radius: .85rem; display: inline-flex; align-items: center; justify-content: center;
      font-size: 1.05rem; border: 1px solid rgb(255 255 255 / .1); }
    .ventajas .c-azul { background: rgb(37 99 235 / .28); color: #7FB2FF; }
    .ventajas .c-verde { background: rgb(22 163 74 / .28); color: #5EE08F; }
    .ventajas .c-violeta { background: rgb(124 58 237 / .3); color: #C0A5FF; }
    .ventajas .c-ambar { background: rgb(217 119 6 / .3); color: #FFC766; }
    @media (max-width: 959px) {
      .lema p, .ventajas { display: none; }
      .lema { margin-top: 1.1rem; }
    }

    /* ── El lado del formulario ── */
    .lado-form { display: flex; align-items: center; justify-content: center; padding: 0 1rem 2rem;
      background: radial-gradient(52rem 34rem at 100% 0%, rgb(var(--tc-boton) / .13), transparent 62%), #060a15; }
    .tarjeta-acceso { position: relative; width: 100%; max-width: 27rem; margin-top: -2.4rem;
      background: #0E1526; border: 1px solid #222E4A; border-radius: 1.15rem; padding: 1.7rem 1.4rem 1.1rem;
      box-shadow: 0 30px 80px -30px rgb(0 0 0 / .85), 0 0 0 1px rgb(255 255 255 / .02) inset; }
    @media (min-width: 960px) {
      .lado-form { padding: 2rem clamp(1.25rem, 3vw, 2.75rem); }
      .tarjeta-acceso { margin-top: 0; padding: 2.1rem 2.25rem 1.2rem; }
    }

    .form-acceso { width: 100%; }
    .form-acceso h1 { font-size: 1.65rem; line-height: 1.15; font-weight: 800; letter-spacing: -.02em; margin-bottom: .3rem; }
    .form-acceso .bajada { font-size: .92rem; line-height: 1.45; color: #9AA6C0; margin-bottom: 1.4rem; }

    .etiqueta { display: block; font-size: .8rem; font-weight: 600; color: #C9D2E6; margin-bottom: .4rem; }
    .grupo { margin-bottom: 1rem; position: relative; }
    .entrada { width: 100%; height: 2.9rem; padding: 0 .9rem; font-size: .95rem; color: #EEF2FA; caret-color: #EEF2FA;
      background: #0A1020; border: 1px solid #26324F; border-radius: .7rem; outline: none;
      transition: box-shadow .15s ease, border-color .15s ease; }
    .entrada::placeholder { color: #66728F; }
    .entrada:hover { border-color: #34436A; }
    .entrada:focus { border-color: rgb(var(--tc-gold)); box-shadow: 0 0 0 3px rgb(var(--tc-gold) / .28); }
    .entrada.falta { border-color: rgb(var(--tc-red)); box-shadow: 0 0 0 3px rgb(var(--tc-red) / .3); }
    /* El autorrelleno del navegador pinta el campo de claro: se le devuelve el suyo. */
    .entrada:-webkit-autofill, .entrada:-webkit-autofill:hover, .entrada:-webkit-autofill:focus {
      -webkit-text-fill-color: #EEF2FA; -webkit-box-shadow: 0 0 0 40px #0A1020 inset; transition: background-color 9999s ease 0s; }
    /* El icono de cada campo: el sobre en el correo y el candado en las contraseñas. */
    .grupo:has(> .entrada[type="email"])::before, .grupo.con-ojo::before, .grupo:has(> .entrada[type="password"])::before {
      font-family: 'Font Awesome 6 Free'; font-weight: 900; font-size: .85rem; color: #66728F;
      position: absolute; left: 1rem; bottom: 0; height: 2.9rem; display: flex; align-items: center; pointer-events: none; z-index: 1; }
    .grupo:has(> .entrada[type="email"])::before { content: '\f0e0'; }
    .grupo.con-ojo::before, .grupo:has(> .entrada[type="password"])::before { content: '\f023'; }
    .grupo:has(> .entrada[type="email"]) .entrada, .grupo.con-ojo .entrada, .grupo:has(> .entrada[type="password"]) .entrada { padding-left: 2.6rem; }
    .con-ojo .entrada { padding-right: 2.9rem; }
    .ojo { position: absolute; right: .3rem; bottom: .3rem; height: 2.3rem; width: 2.3rem; border: 0; border-radius: .5rem;
      background: none; color: #8B96AE; cursor: pointer; }
    .ojo:hover { color: #EEF2FA; background: rgb(255 255 255 / .05); }
    .ojo:focus-visible { outline: 2px solid rgb(var(--tc-gold)); }

    /* La sede: dos botones, el elegido en el acento. */
    .sedes { display: grid; grid-template-columns: 1fr 1fr; gap: .5rem; }
    .sedes label { position: relative; }
    .sedes span { display: flex; align-items: center; justify-content: center; gap: .45rem; height: 2.6rem; border-radius: .7rem;
      font-size: .9rem; font-weight: 600; color: #9AA6C0; cursor: pointer;
      background: #0A1020; border: 1px solid #26324F;
      transition: color .15s ease, background-color .15s ease, border-color .15s ease; }
    .sedes input:checked + span { color: #fff; background: rgb(var(--tc-boton) / .22); border-color: rgb(var(--tc-gold)); }
    .sedes input:focus-visible + span { outline: 2px solid rgb(var(--tc-gold)); outline-offset: 2px; }
    @media (hover: hover) and (pointer: fine) { .sedes span:hover { color: #fff; border-color: #3D4E7A; } }

    .fila-recordar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .5rem 1rem; margin-bottom: 1.1rem; }
    .casilla { display: inline-flex; align-items: center; gap: .55rem; font-size: .85rem; color: #C9D2E6; cursor: pointer; }
    .casilla input { width: 1rem; height: 1rem; accent-color: rgb(var(--tc-boton)); }

    .btn-entrar { width: 100%; height: 2.9rem; padding: 0 1.6rem; border: 0; border-radius: .7rem; cursor: pointer;
      font-weight: 700; font-size: .95rem; color: rgb(var(--tc-on-gold)); background: rgb(var(--tc-boton));
      box-shadow: 0 1px 2px rgb(0 0 0 / .3), 0 12px 26px -10px rgb(var(--tc-boton) / .8);
      transition: background-color .15s ease, transform .12s ease; }
    .btn-entrar:hover { background: rgb(var(--tc-boton-hover)); }
    .btn-entrar:active { transform: scale(.985); }
    .btn-entrar:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
    .btn-entrar[disabled] { opacity: .7; cursor: progress; }

    .enlace { font-size: .85rem; font-weight: 600; color: rgb(var(--tc-gold-soft)); text-decoration: none; text-underline-offset: 3px; }
    .enlace:hover { color: #fff; text-decoration: underline; }
    .enlace:focus-visible { outline: 2px solid rgb(var(--tc-gold)); outline-offset: 2px; border-radius: 3px; }
    /* En «recuperar» y «cambiar», el enlace va debajo del botón, centrado. */
    .form-acceso .flex > .enlace { margin-inline: auto; }
    .nota { margin-top: 1.1rem; text-align: center; font-size: .75rem; line-height: 1.5; color: #7C88A6; }

    .pie-acceso { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .4rem 1rem;
      margin-top: 1.3rem; padding-top: .9rem; border-top: 1px solid #1C2740; font-size: .72rem; color: #66728F; }

    /* Los avisos. */
    .aviso { display: flex; align-items: flex-start; gap: .6rem; margin-bottom: 1rem; padding: .7rem .85rem; border-radius: .7rem;
      font-size: .85rem; line-height: 1.4; }
    .aviso.error { background: rgb(239 68 68 / .14); border: 1px solid rgb(239 68 68 / .5); color: #FFD9D9; }
    .aviso.ok { background: rgb(34 197 94 / .14); border: 1px solid rgb(34 197 94 / .45); color: #DBFFE9; }
    .aviso.cuidado { background: rgb(245 158 11 / .14); border: 1px solid rgb(245 158 11 / .45); color: #FFEDC9; }

    /* PANTALLAS BAJAS (un portátil al 125 %: 1280 × 593). Todo cabe sin desplazarse. */
    @media (min-width: 960px) and (max-height: 720px) {
      .portada { padding-top: 1.2rem; padding-bottom: 1.2rem; }
      .lema { margin-top: 1.2rem; }
      .lema h2 { font-size: clamp(1.7rem, 3vw, 2.5rem); }
      .lema p { margin-top: .7rem; font-size: .95rem; }
      .ventajas .cuadro { width: 2.5rem; height: 2.5rem; font-size: .95rem; }
      .ventajas li { font-size: .78rem; gap: .45rem; }
      .lado-form { padding-top: 1rem; padding-bottom: 1rem; }
      .tarjeta-acceso { padding: 1.35rem 2rem .9rem; }
      .form-acceso h1 { font-size: 1.4rem; }
      .form-acceso .bajada { margin-bottom: .9rem; }
      .grupo { margin-bottom: .7rem; }
      .entrada, .btn-entrar { height: 2.6rem; }
      .grupo:has(> .entrada[type="email"])::before, .grupo.con-ojo::before, .grupo:has(> .entrada[type="password"])::before { height: 2.6rem; }
      .ojo { height: 2rem; width: 2rem; }
      .sedes span { height: 2.35rem; }
      .fila-recordar { margin-bottom: .8rem; }
      .nota { margin-top: .7rem; }
      .pie-acceso { margin-top: .8rem; padding-top: .65rem; }
    }

    /* ── La entrada: la foto se asienta y los textos aparecen. Una vez. ── */
    @keyframes asienta { from { transform: scale(1.06); } to { transform: none; } }
    @keyframes aparece { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
    .entra-1 { animation: aparece .7s cubic-bezier(.23, 1, .32, 1) .1s both; }
    .entra-2 { animation: aparece .7s cubic-bezier(.23, 1, .32, 1) .25s both; }
    @media (prefers-reduced-motion: reduce) {
      .portada-foto, .entra-1, .entra-2 { animation: none !important; }
      .entrada, .sedes span, .btn-entrar { transition: none; }
    }
  </style>
  <!-- Tailwind compilado, el mismo de layout-gestion: aquí no se ejecuta ningún
       script de terceros en la página donde se escribe la contraseña. El ÚLTIMO
       del <head>, detrás del <style> de arriba: la cascada queda como siempre. -->
  <link rel="stylesheet" href="<%= _est('/assets/css/tailwind.css') %>">
</head>
<body class="font-sans">
  <div class="acceso">
    <section class="portada" aria-label="Telecab">
      <div class="portada-foto" aria-hidden="true"></div>
      <header class="cabecera entra-1">
        <%- include('partials/marca', { tam: 'w-10 h-10' }) %>
        <span class="nombre"><b>tele<span>cab</span></b><small>Gestión de flota</small></span>
      </header>

      <div class="lema entra-1">
        <h2><%- PRIMERA_VEZ ? 'Te damos la bienvenida a&nbsp;Telecab' : 'Toda la flota, en&nbsp;un&nbsp;solo sitio' %></h2>
        <p>Turnos, horas, coches y documentación de Telecab. Al día y en directo.</p>
      </div>

      <ul class="ventajas entra-2">
        <li><span class="cuadro c-azul"><i class="fa-solid fa-satellite-dish" aria-hidden="true"></i></span>Flota<br>en directo</li>
        <li><span class="cuadro c-verde"><i class="fa-solid fa-calendar-check" aria-hidden="true"></i></span>Turnos<br>y horas</li>
        <li><span class="cuadro c-violeta"><i class="fa-solid fa-screwdriver-wrench" aria-hidden="true"></i></span>Taller<br>al día</li>
        <li><span class="cuadro c-ambar"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i></span>Todo queda<br>registrado</li>
      </ul>
    </section>

    <main class="lado-form entra-2">
      <div class="tarjeta-acceso">
        <%- body %>
        <footer class="pie-acceso">
          <span><i class="fa-solid fa-lock mr-1" aria-hidden="true"></i>Conexión cifrada</span>
          <span>© <%= new Date().getFullYear() %> Telecab</span>
        </footer>
      </div>
    </main>
  </div>
</body>
</html>
