<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Telecab · <%= titulo || 'Acceso' %></title>
  <link rel="icon" type="image/png" href="<%= typeof est === 'function' ? est('/assets/logo-sinfondo-256.png') : '/assets/logo-sinfondo-256.png' %>">
  <link rel="apple-touch-icon" href="<%= typeof est === 'function' ? est('/assets/logo-sinfondo-256.png') : '/assets/logo-sinfondo-256.png' %>">

  <!-- Tema antes de pintar, para que no parpadee. -->
  <script>
    (function () {
      try {
        var pref = localStorage.getItem('telecab-tema') || 'dark';
        var tema = pref === 'auto' ? (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark') : pref;
        document.documentElement.setAttribute('data-theme', tema);
      } catch (e) { document.documentElement.setAttribute('data-theme', 'dark'); }
    })();
  </script>
  <link rel="stylesheet" href="<%= typeof est === 'function' ? est('/assets/css/telecab.css') : '/assets/css/telecab.css' %>">

  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <script>
    window.__tcCrudos = (function () {
      const tok = n => 'rgb(var(--tc-' + n + ') / <alpha-value>)';
      const escala = (n, hondo) => {
        const e = {};
        [50, 100, 200, 300, 400, 500].forEach(k => { e[k] = tok(n); });
        [600, 700, 800, 900, 950].forEach(k => { e[k] = tok(hondo || n); });
        return e;
      };
      return {
        red: escala('red', 'red-hover'), emerald: escala('green'), green: escala('green'),
        amber: escala('warn'), orange: escala('warn'), yellow: escala('warn'),
        sky: escala('azul'), blue: escala('azul'),
      };
    })();
    tailwind.config = {
      theme: { extend: {
        fontFamily: { sans: ['IBM Plex Sans', 'system-ui', '-apple-system', 'Segoe UI', 'sans-serif'] },
        colors: { 'telecab': {
          'dark': 'rgb(var(--tc-dark) / <alpha-value>)', 'card': 'rgb(var(--tc-card) / <alpha-value>)',
          'card2': 'rgb(var(--tc-card2) / <alpha-value>)', 'border': 'rgb(var(--tc-border) / <alpha-value>)',
          'gold': 'rgb(var(--tc-gold) / <alpha-value>)', 'gold-soft': 'rgb(var(--tc-gold-soft) / <alpha-value>)',
          'gold-deep': 'rgb(var(--tc-gold-deep) / <alpha-value>)', 'red': 'rgb(var(--tc-red) / <alpha-value>)',
          'green': 'rgb(var(--tc-green) / <alpha-value>)', 'text': 'rgb(var(--tc-text) / <alpha-value>)',
          'muted': 'rgb(var(--tc-muted) / <alpha-value>)', 'azul': 'rgb(var(--tc-azul) / <alpha-value>)',
          'warn': 'rgb(var(--tc-warn) / <alpha-value>)'
        },
        // Los crudos, a los tokens en todos sus tonos (igual que layout-gestion).
        ...window.__tcCrudos,
        },
        boxShadow: { 'soft': 'var(--tc-sombra-alta)', 'gold': 'var(--tc-sombra)' }
      } }
    }
  </script>

  <style>
    /* ── LA PANTALLA DE ACCESO ────────────────────────────────────────────────
       Dos mitades. A la izquierda la marca; a la derecha, la tarea. En móvil
       solo queda la tarea: en una pantalla de 6 pulgadas, y a menudo con prisa,
       lo que hay que ver es el campo del correo.

       Desde el 27/09/2026 es SOBRIA, como el resto de la casa: sin las estelas
       de faros animadas (ámbar y azul) ni los velos. El panel de la marca es una
       superficie del tema —grafito en oscuro, blanco en claro— con la carretera
       del logo dibujada en trazo fino, quieta. Todo sale de los tokens, así que
       sigue al tema sin casos especiales. */
    .acceso { display: grid; grid-template-columns: 1fr; min-height: 100svh; }
    @media (min-width: 1024px) { .acceso { grid-template-columns: 1.1fr 1fr; } }

    .escena { position: relative; overflow: hidden; display: none; isolation: isolate;
      background: rgb(var(--tc-card)); border-right: 1px solid rgb(var(--tc-border)); }
    @media (min-width: 1024px) { .escena { display: block; } }
    /* La carretera del logo, en grande y en trazo fino: el único adorno. */
    .escena .via { position: absolute; right: -4%; bottom: -6%; width: 78%; height: auto; z-index: 0; pointer-events: none; }
    .escena .via path { fill: none; stroke: rgb(var(--tc-border)); stroke-width: 1.5; stroke-linecap: round; }
    .escena .via path.carril { stroke-dasharray: 10 14; }
    .escena-texto { position: relative; z-index: 1; height: 100%; display: flex; flex-direction: column;
      justify-content: space-between; padding: 3rem; }

    /* El titular. `balance` evita la línea viuda de una sola palabra. */
    .titular { font-size: clamp(2rem, 3vw, 3rem); line-height: 1.08; font-weight: 600;
      letter-spacing: -.02em; text-wrap: balance; }

    /* La hora de Madrid, abajo. */
    .dato { display: flex; flex-direction: column; gap: .15rem; }
    .dato b { font-size: 1.5rem; font-weight: 600; letter-spacing: -.01em; line-height: 1;
      font-variant-numeric: tabular-nums; }
    .dato span { font-size: .7rem; color: rgb(var(--tc-muted)); letter-spacing: .06em; text-transform: uppercase; }

    /* ── El formulario ─────────────────────────────────────────────────────── */
    .panel { display: flex; align-items: center; justify-content: center; padding: 2rem 1.5rem; position: relative; }
    .caja { width: 100%; max-width: 23rem; }

    /* Campo con etiqueta flotante: la etiqueta VIVE dentro del campo y sube al
       escribir. Se ahorra una línea por campo y el formulario respira. */
    .campo { position: relative; margin-bottom: .9rem; }
    .campo input {
      width: 100%; padding: 1.35rem .9rem .5rem 2.4rem; font-size: .95rem;
      background: rgb(var(--tc-campo)); color: rgb(var(--tc-text));
      border: 1px solid rgb(var(--tc-border)); border-radius: .5rem; outline: none;
      transition: border-color .15s ease, box-shadow .15s ease;
    }
    .campo input:focus { border-color: rgb(var(--tc-gold) / .75); box-shadow: 0 0 0 3px rgb(var(--tc-gold) / .16); }
    .campo label {
      position: absolute; left: 2.4rem; top: .95rem; font-size: .95rem; color: rgb(var(--tc-muted));
      pointer-events: none; transform-origin: left top;
      transition: transform .15s ease, color .15s ease;
    }
    /* :placeholder-shown nos dice si está vacío SIN JavaScript. */
    .campo input:focus + label,
    .campo input:not(:placeholder-shown) + label { transform: translateY(-.62rem) scale(.74); }
    .campo input:focus + label { color: rgb(var(--tc-gold)); }
    .campo > i.icono { position: absolute; left: .9rem; top: 50%; transform: translateY(-50%);
      color: rgb(var(--tc-muted)); font-size: .85rem; transition: color .15s ease; }
    .campo input:focus ~ i.icono { color: rgb(var(--tc-gold)); }
    .campo .ojo { position: absolute; right: .35rem; top: 50%; transform: translateY(-50%);
      background: none; border: 0; color: rgb(var(--tc-muted)); cursor: pointer; padding: .5rem .6rem;
      border-radius: .375rem; }
    .campo .ojo:hover { color: rgb(var(--tc-text)); }

    .btn-entrar {
      width: 100%; padding: .75rem 1rem; border: 0; border-radius: .5rem; cursor: pointer;
      font-weight: 600; font-size: .95rem; color: rgb(var(--tc-on-gold));
      background: rgb(var(--tc-gold));
      transition: background-color .15s ease;
    }
    .btn-entrar:hover { background: rgb(var(--tc-gold-deep)); }
    .btn-entrar[disabled] { opacity: .6; cursor: progress; }

    /* La entrada de cada pieza, escalonada. Una vez, al cargar: es un saludo, no
       una animación que se repita. */
    @keyframes sube { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
    .sube { animation: sube .4s ease-out both; }

    @media (prefers-reduced-motion: reduce) {
      .sube { animation: none; }
      .btn-entrar, .campo input, .campo label { transition: none; }
    }
  </style>
</head>
<body class="app-bg font-sans text-telecab-text">
  <div class="acceso">

    <!-- ── La marca ──────────────────────────────────────────────────────────
         La carretera del logo en trazo fino y quieta: es lo que hace la
         empresa, dicho en voz baja. -->
    <section class="escena">
      <svg class="via" viewBox="0 0 600 420" aria-hidden="true" focusable="false">
        <path d="M0 330 Q300 170 600 190"/>
        <path class="carril" d="M60 390 Q330 240 600 238"/>
        <path d="M150 440 Q390 300 600 286"/>
      </svg>
      <div class="escena-texto">
        <div class="flex items-center gap-3 sube" style="animation-delay:.05s">
          <%- include('partials/marca', { tam: 'w-10 h-10' }) %>
          <span class="text-xl font-bold tracking-tight">tele<span class="gold-text">cab</span></span>
        </div>

        <div class="max-w-xl">
          <p class="text-[11px] uppercase tracking-[.2em] text-telecab-muted font-semibold mb-4 sube" style="animation-delay:.12s">
            Gestión de flota VTC
          </p>
          <h1 class="titular sube" style="animation-delay:.2s">
            La flota entera,<br><span class="gold-text">en una pantalla.</span>
          </h1>
          <p class="mt-5 text-sm text-telecab-muted leading-relaxed max-w-md sube" style="animation-delay:.3s">
            Turnos, horas, mantenimiento y documentación. Lo que pasa en la calle,
            aquí dentro y al día.
          </p>
        </div>

        <!-- AQUI NO VA NINGUNA CIFRA DE LA EMPRESA. Esta pagina se ve SIN haber
             entrado: cuantos coches hay o cuantos turnos salen hoy es
             informacion de dentro, y ponerla de adorno la publica a cualquiera
             que abra la direccion. Lo que si vale es la hora de Madrid, que es
             el reloj con el que funciona todo el ERP —la jornada va de 05:00 a
             05:00— y ayuda a quien entra desde otro huso. -->
        <div class="flex items-end gap-10 sube" style="animation-delay:.4s">
          <div class="dato"><b id="d-hora">—</b><span id="d-fecha">Hora de Madrid</span></div>
        </div>
      </div>
    </section>

    <!-- ── El formulario ───────────────────────────────────────────────────── -->
    <main class="panel">
      <div class="caja">
        <!-- En móvil no hay escena, así que la marca se pone aquí. -->
        <div class="lg:hidden flex flex-col items-center mb-7 sube">
          <%- include('partials/marca', { tam: 'w-14 h-14' }) %>
          <span class="mt-3 text-xl font-bold tracking-tight">tele<span class="gold-text">cab</span></span>
        </div>
        <%- body %>
        <p class="text-center text-[11px] text-telecab-muted mt-7">Acceso restringido · plataforma interna</p>
      </div>
    </main>
  </div>

  <script>
  // ── Las cifras del panel ──────────────────────────────────────────────────
  // La hora es de verdad y de Madrid. Las otras dos las sirve el servidor en la
  // propia página; si no llegan, la fila se queda con su raya y no pasa nada.
  (function () {
    const hora = document.getElementById('d-hora');
    if (hora) {
      const pinta = () => {
        hora.textContent = new Intl.DateTimeFormat('es-ES', {
          timeZone: 'Europe/Madrid', hour: '2-digit', minute: '2-digit', hour12: false,
        }).format(new Date());
      };
      pinta(); setInterval(pinta, 20000);
    }
    const fecha = document.getElementById('d-fecha');
    if (fecha) {
      const f = new Intl.DateTimeFormat('es-ES', {
        timeZone: 'Europe/Madrid', weekday: 'long', day: 'numeric', month: 'long',
      }).format(new Date());
      fecha.textContent = f + ' · hora de Madrid';
    }
  })();
  </script>
</body>
</html>
