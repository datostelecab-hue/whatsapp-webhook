<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Telecab · <%= titulo || 'Acceso' %></title>
  <link rel="icon" type="image/png" href="<%= typeof est === 'function' ? est('/assets/logo-sinfondo-256.png') : '/assets/logo-sinfondo-256.png' %>">
  <link rel="apple-touch-icon" href="<%= typeof est === 'function' ? est('/assets/logo-sinfondo-256.png') : '/assets/logo-sinfondo-256.png' %>">
  <%
    const _est = p => (typeof est === 'function' ? est(p) : p);
    // Una imagen por sede (scripts/fondo-acceso/), la grande y la del móvil.
    const FONDOS = ['madrid', 'barcelona'].map(sede => ({
      sede, grande: _est('/assets/acceso/' + sede + '.webp'), movil: _est('/assets/acceso/' + sede + '-1280.webp'),
    }));
    // Quien entra por primera vez (crea su contraseña) no vuelve: se le da la bienvenida.
    const PRIMERA_VEZ = typeof primerAcceso !== 'undefined' && primerAcceso;
  %>

  <!-- EL TEMA, SIEMPRE EN SU VERSIÓN OSCURA. El acceso va sobre una foto de
       noche: los textos son claros y el fondo oscuro en todos los temas. Del
       tema de cada uno se conserva el ACENTO (el oro, o su azul, su verde...),
       que es lo que lo hace suyo: «claro-azul» se pinta como «azul» y «light»
       como «dark». -->
  <script>
    (function () {
      try {
        var pref = localStorage.getItem('telecab-tema') || 'dark';
        if (pref === 'auto' || pref === 'light') pref = 'dark';
        if (pref.indexOf('claro-') === 0) pref = pref.slice(6);
        document.documentElement.setAttribute('data-theme', pref);
      } catch (e) { document.documentElement.setAttribute('data-theme', 'dark'); }
      // LA SEDE DE LA IMAGEN: la última elegida en este navegador, antes de
      // pintar, para que quien entra a Barcelona no vea primero Madrid.
      try {
        document.documentElement.setAttribute('data-sede', localStorage.getItem('telecab-sede') === 'barcelona' ? 'barcelona' : 'madrid');
      } catch (e) { document.documentElement.setAttribute('data-sede', 'madrid'); }
    })();
  </script>
  <link rel="stylesheet" href="<%= _est('/assets/css/telecab.css') %>">

  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <script>
    window.__tcCrudos = (function () {
      const tok = n => 'rgb(var(--tc-' + n + ') / <alpha-value>)';
      const escala = (n, hondo) => {
        const e = {};
        [50, 100, 200, 300, 400, 500].forEach(k => { e[k] = tok(n); });
        [600, 700, 800, 900, 950].forEach(k => { e[k] = tok(hondo || n); });
        return e;
      };
      return {
        red: escala('red', 'red-hover'), emerald: escala('green'), green: escala('green'),
        amber: escala('warn'), orange: escala('warn'), yellow: escala('warn'),
        sky: escala('azul'), blue: escala('azul'),
      };
    })();
    tailwind.config = {
      theme: { extend: {
        fontFamily: { sans: ['IBM Plex Sans', 'system-ui', '-apple-system', 'Segoe UI', 'sans-serif'] },
        colors: { 'telecab': {
          'dark': 'rgb(var(--tc-dark) / <alpha-value>)', 'card': 'rgb(var(--tc-card) / <alpha-value>)',
          'card2': 'rgb(var(--tc-card2) / <alpha-value>)', 'border': 'rgb(var(--tc-border) / <alpha-value>)',
          'gold': 'rgb(var(--tc-gold) / <alpha-value>)', 'gold-soft': 'rgb(var(--tc-gold-soft) / <alpha-value>)',
          'gold-deep': 'rgb(var(--tc-gold-deep) / <alpha-value>)', 'red': 'rgb(var(--tc-red) / <alpha-value>)',
          'green': 'rgb(var(--tc-green) / <alpha-value>)', 'text': 'rgb(var(--tc-text) / <alpha-value>)',
          'muted': 'rgb(var(--tc-muted) / <alpha-value>)', 'azul': 'rgb(var(--tc-azul) / <alpha-value>)',
          'warn': 'rgb(var(--tc-warn) / <alpha-value>)'
        },
        // Los crudos, a los tokens en todos sus tonos (igual que layout-gestion).
        ...window.__tcCrudos,
        },
        boxShadow: { 'soft': 'var(--tc-sombra-alta)', 'gold': 'var(--tc-sombra)' }
      } }
    }
  </script>

  <style>
    /* ── LA PANTALLA DE ACCESO (07/10/2026) ──────────────────────────────────
       Camilo: «login así» (con una referencia): una foto a toda la pantalla,
       el saludo grande a la izquierda y el formulario a la derecha, encima de
       la foto, con los campos blancos y la etiqueta encima de cada uno.

       LA FOTO es nuestra y va con la SEDE que se elige. Madrid al anochecer
       (la sierra de Guadarrama con el sol recién puesto, las Cuatro Torres y
       una autovía con las estelas de los coches) o Barcelona (Collserola, la
       Sagrada Família, la Torre Glòries y el mar). Las genera en SVG
       scripts/fondo-acceso/ y se sirven en WebP: unos 100 KB cada una, 42 KB
       las del móvil. El sol cae detrás del saludo y los edificios conocidos,
       en el hueco entre las dos columnas.

       Encima, un velo: más oscuro a los lados, donde van los textos, para que
       el blanco se lea sobre cualquier parte de la ciudad. */

    html, body { min-height: 100%; }
    body { background: #070912; color: #F4F5F8; }
    ::selection { background: rgb(var(--tc-gold) / .4); color: #fff; }

    .acceso { position: relative; isolation: isolate; min-height: 100svh; display: flex; flex-direction: column;
      background: #070912; overflow: hidden; }
    /* UNA CAPA POR SEDE. Se ve la de la sede elegida y, al cambiarla en el
       formulario, se cruzan con un fundido: la imagen contesta a lo que se ha
       pulsado. La foto, además, entra un poco más cerca y se asienta. */
    /* EL CAMBIO, SUAVE (Camilo: «muy abrupto»). La imagen nueva sube ENCIMA
       de la que había y aparece despacio, algo desenfocada y un poco más
       cerca, hasta asentarse; la de antes se queda quieta debajo y solo se
       retira cuando ya está tapada. Si las dos se fundieran a la vez, a mitad
       del cambio se vería un bajón oscuro. */
    .fondo { position: absolute; inset: 0; z-index: -3; background: center 62% / cover no-repeat;
      opacity: 0; filter: blur(10px);
      transition: opacity 0s linear 1.7s, filter 0s linear 1.7s; }
<% FONDOS.forEach(f => { %>    .fondo-<%= f.sede %> { background-image: url('<%= f.movil %>'); }
    @media (min-width: 900px) { .fondo-<%= f.sede %> { background-image: url('<%= f.grande %>'); background-position: center 58%; } }
    html[data-sede="<%= f.sede %>"] .fondo-<%= f.sede %> { z-index: -2; opacity: 1; filter: none;
      transition: opacity 1.6s cubic-bezier(.45, 0, .25, 1), filter 1.6s cubic-bezier(.45, 0, .25, 1);
      animation: asienta 2.4s cubic-bezier(.22, 1, .36, 1) backwards; }
<% }) %>
    .acceso::after { content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
      background:
        linear-gradient(90deg, rgb(5 7 16 / .5) 0%, rgb(5 7 16 / .16) 34%, rgb(5 7 16 / .08) 50%, rgb(5 7 16 / .5) 64%, rgb(5 7 16 / .72) 100%),
        linear-gradient(180deg, rgb(5 7 16 / .35) 0%, rgb(5 7 16 / 0) 30%, rgb(5 7 16 / 0) 70%, rgb(5 7 16 / .45) 100%); }
    @media (max-width: 899px) {
      .acceso::after { background: linear-gradient(180deg, rgb(5 7 16 / .5) 0%, rgb(5 7 16 / .58) 40%, rgb(5 7 16 / .8) 100%); }
    }

    /* La marca, arriba a la izquierda. */
    .cabecera { display: flex; align-items: center; gap: .65rem; padding: 1.6rem clamp(1.25rem, 5vw, 4.5rem) 0; }
    .cabecera .tc-marca-pin path { fill: rgb(var(--tc-gold)); }
    .cabecera .tc-marca-via { stroke: rgb(255 255 255 / .85); }
    .cabecera .tc-marca-carril { stroke: rgb(255 255 255 / .5); }
    .cabecera .tc-marca-sombra { fill: rgb(255 255 255 / .2); }
    .cabecera b { font-size: 1.25rem; font-weight: 600; letter-spacing: -.02em; }
    .cabecera b span { color: rgb(var(--tc-gold)); }

    /* Las dos columnas. */
    .rejilla { flex: 1; display: grid; align-items: center; gap: 2.5rem;
      padding: 1.5rem clamp(1.25rem, 5vw, 4.5rem) 2rem; grid-template-columns: 1fr; }
    @media (min-width: 900px) { .rejilla { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: clamp(2rem, 8vw, 9rem); } }

    /* El saludo. */
    .saludo h2 { font-size: clamp(2.6rem, 5.6vw, 5rem); line-height: .98; font-weight: 700; letter-spacing: -.035em;
      text-wrap: balance; text-shadow: 0 2px 24px rgb(0 0 0 / .35); }
    .saludo p { margin-top: 1.25rem; max-width: 34ch; font-size: 1rem; line-height: 1.6; color: rgb(255 255 255 / .82); }
    .saludo .web { display: inline-flex; align-items: center; gap: .55rem; margin-top: 1.6rem; font-size: .9rem; font-weight: 500;
      color: #fff; text-decoration: none; padding: .45rem .1rem; border-bottom: 1px solid rgb(255 255 255 / .35);
      transition: border-color .15s ease, color .15s ease; }
    .saludo .web:hover { color: rgb(var(--tc-gold)); border-color: rgb(var(--tc-gold)); }
    .saludo .web:focus-visible { outline: 2px solid rgb(var(--tc-gold)); outline-offset: 3px; }
    @media (max-width: 899px) {
      .saludo { text-align: center; }
      .saludo h2 { font-size: 2.4rem; }
      .saludo p, .saludo .web { display: none; }
    }

    /* El formulario: sobre la foto, sin tarjeta. */
    .lado-form { display: flex; justify-content: center; }
    .form-acceso { width: 100%; max-width: 23rem; }
    .form-acceso h1 { font-size: 2rem; line-height: 1.1; font-weight: 700; letter-spacing: -.02em; text-align: center; margin-bottom: .4rem; }
    .form-acceso .bajada { text-align: center; font-size: .9rem; color: rgb(255 255 255 / .75); margin-bottom: 1.6rem; }

    .etiqueta { display: block; font-size: .8rem; font-weight: 500; color: rgb(255 255 255 / .92); margin-bottom: .35rem; }
    .grupo { margin-bottom: 1rem; position: relative; }
    .entrada { width: 100%; height: 2.75rem; padding: 0 .85rem; font-size: .95rem; color: #12141B; caret-color: #12141B;
      background: #fff; border: 1px solid transparent; border-radius: 6px; outline: none;
      transition: box-shadow .15s ease, border-color .15s ease; }
    .entrada::placeholder { color: #8A90A0; }
    .entrada:focus { border-color: rgb(var(--tc-gold)); box-shadow: 0 0 0 3px rgb(var(--tc-gold) / .45); }
    .entrada.falta { border-color: rgb(var(--tc-red)); box-shadow: 0 0 0 3px rgb(var(--tc-red) / .35); }
    /* El autorrelleno del navegador pinta el campo de amarillo: se le devuelve el blanco. */
    .entrada:-webkit-autofill, .entrada:-webkit-autofill:hover, .entrada:-webkit-autofill:focus {
      -webkit-text-fill-color: #12141B; -webkit-box-shadow: 0 0 0 40px #fff inset; transition: background-color 9999s ease 0s; }
    .con-ojo .entrada { padding-right: 2.75rem; }
    .ojo { position: absolute; right: .25rem; bottom: .25rem; height: 2.25rem; width: 2.25rem; border: 0; border-radius: 5px;
      background: none; color: #5D6375; cursor: pointer; }
    .ojo:hover { color: #12141B; }
    .ojo:focus-visible { outline: 2px solid rgb(var(--tc-gold)); }

    /* La sede: dos botones sobre la foto. */
    .sedes { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
    .sedes label { position: relative; }
    .sedes span { display: flex; align-items: center; justify-content: center; gap: .45rem; height: 2.5rem; border-radius: 6px;
      font-size: .9rem; font-weight: 500; color: rgb(255 255 255 / .8); cursor: pointer;
      background: rgb(8 10 20 / .45); border: 1px solid rgb(255 255 255 / .28);
      transition: color .15s ease, background-color .15s ease, border-color .15s ease; }
    .sedes input:checked + span { color: #fff; font-weight: 600; background: rgb(var(--tc-gold) / .28); border-color: rgb(var(--tc-gold)); }
    .sedes input:focus-visible + span { outline: 2px solid rgb(var(--tc-gold)); outline-offset: 2px; }
    @media (hover: hover) and (pointer: fine) { .sedes span:hover { color: #fff; border-color: rgb(255 255 255 / .55); } }

    .casilla { display: inline-flex; align-items: center; gap: .55rem; font-size: .85rem; color: rgb(255 255 255 / .88); cursor: pointer; }
    .casilla input { width: 1rem; height: 1rem; accent-color: rgb(var(--tc-gold)); }

    .btn-entrar { min-width: 9rem; height: 2.75rem; padding: 0 1.6rem; border: 0; border-radius: 6px; cursor: pointer;
      font-weight: 600; font-size: .95rem; color: rgb(var(--tc-on-gold)); background: rgb(var(--tc-gold));
      transition: background-color .15s ease, transform .12s ease; }
    .btn-entrar:hover { background: rgb(var(--tc-gold-soft)); }
    .btn-entrar:active { transform: scale(.98); }
    .btn-entrar:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
    .btn-entrar[disabled] { opacity: .7; cursor: progress; }

    .enlace { font-size: .85rem; color: rgb(255 255 255 / .85); text-decoration: none; text-underline-offset: 3px; }
    .enlace:hover { color: #fff; text-decoration: underline; }
    .enlace:focus-visible { outline: 2px solid rgb(var(--tc-gold)); outline-offset: 2px; border-radius: 3px; }
    .nota { margin-top: 1.75rem; text-align: center; font-size: .75rem; line-height: 1.5; color: rgb(255 255 255 / .62); }

    /* Los avisos, legibles sobre la foto. */
    .aviso { display: flex; align-items: flex-start; gap: .6rem; margin-bottom: 1rem; padding: .65rem .8rem; border-radius: 6px;
      font-size: .85rem; line-height: 1.4; }
    .aviso.error { background: rgb(190 30 45 / .32); border: 1px solid rgb(255 120 120 / .6); color: #FFE1E1; }
    .aviso.ok { background: rgb(20 140 90 / .3); border: 1px solid rgb(120 230 170 / .55); color: #E2FFF0; }
    .aviso.cuidado { background: rgb(150 100 10 / .35); border: 1px solid rgb(255 200 90 / .55); color: #FFF1D6; }

    /* PANTALLAS BAJAS (un portátil al 125 %: 1280 × 593). Todo cabe sin desplazarse. */
    @media (min-width: 900px) and (max-height: 700px) {
      .cabecera { padding-top: 1rem; }
      .rejilla { padding-top: .5rem; padding-bottom: 1rem; }
      .form-acceso h1 { font-size: 1.65rem; }
      .form-acceso .bajada { margin-bottom: 1rem; }
      .grupo { margin-bottom: .7rem; }
      .entrada { height: 2.5rem; }
      .sedes span { height: 2.3rem; }
      .nota { margin-top: 1rem; }
    }

    /* ── La entrada: la foto se asienta y los textos aparecen. Una vez. ── */
    @keyframes asienta { from { transform: scale(1.06); } to { transform: none; } }
    @keyframes aparece { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
    .entra-1 { animation: aparece .7s cubic-bezier(.23, 1, .32, 1) .15s both; }
    .entra-2 { animation: aparece .7s cubic-bezier(.23, 1, .32, 1) .3s both; }
    @media (prefers-reduced-motion: reduce) {
      .fondo, .fondo[class], .entra-1, .entra-2 { animation: none !important; }
      /* Con menos movimiento, solo un fundido corto, sin desenfoque ni acercamiento. */
      .fondo { filter: none; }
      html[data-sede] .fondo { transition: opacity .4s ease !important; }
      .entrada, .sedes span, .btn-entrar { transition: none; }
    }
  </style>
</head>
<body class="font-sans">
  <div class="acceso">
    <% FONDOS.forEach(f => { %><div class="fondo fondo-<%= f.sede %>" aria-hidden="true"></div>
    <% }) %>
    <header class="cabecera entra-1">
      <%- include('partials/marca', { tam: 'w-9 h-9' }) %>
      <b>tele<span>cab</span></b>
    </header>

    <div class="rejilla">
      <section class="saludo entra-1" aria-label="Telecab">
        <h2><%- PRIMERA_VEZ ? 'Te damos<br>la bienvenida' : 'Hola<br>de nuevo' %></h2>
        <p>Turnos, horas, coches y documentación de la flota de Telecab, en un solo sitio.</p>
        <a class="web" href="https://www.telecab.es" target="_blank" rel="noopener">
          <i class="fa-solid fa-globe" aria-hidden="true"></i> telecab.es
        </a>
      </section>

      <main class="lado-form entra-2">
        <%- body %>
      </main>
    </div>
  </div>
</body>
</html>
