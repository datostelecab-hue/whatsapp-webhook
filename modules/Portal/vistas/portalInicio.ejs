<h1>Hola<%= conductor.pila ? ', ' + conductor.pila : '' %></h1>

<% if (evento) { %>
<p class="aviso"><b><%= evento.nombre %>.</b> Del <%= f.fecha(evento.desde) %> al <%= f.fecha(evento.hasta) %> los turnos son temporales.</p>
<% } %>

<section class="caja" aria-labelledby="t-proximo">
  <div class="caja-tit"><h2 id="t-proximo">Tu próximo turno</h2><a href="/turnos">Ver los 8 días</a></div>
  <div class="caja-in proximo">
  <% if (proximo) { const n = f.nombreDia(proximo.fecha, hoy); %>
    <p class="suave"><%= n.nombre %>, <%= n.fecha %></p>
    <div class="proximo-turno"><span>Turno de <%= String(proximo.turno).toLowerCase() %></span><span class="matricula"><%= proximo.matricula %></span></div>
    <%- include('portalRelevo', { d: proximo, f }) %>
  <% } else if (hayPlan) { %>
    <p>No tienes turnos de hoy al <%= f.fecha(hasta) %>.</p>
    <p class="suave peq">Si crees que es un error, avisa a la oficina.</p>
  <% } else { %>
    <p>Todavía no están cargados tus turnos de los próximos días.</p>
  <% } %>
  </div>
</section>

<% if (dinero) { const d = dinero, mes = d.mes; %>
<section class="caja" aria-labelledby="t-dinero">
  <div class="caja-tit"><h2 id="t-dinero"><%= d.ett ? 'Tus propinas y peajes de ' + mes.nombre : 'Tu facturación de ' + mes.nombre %></h2></div>
  <div class="caja-in dinero">
  <% if (!d.ett && d.objetivo) {
       const pct = Math.max(0, Math.min(100, mes.neto / d.objetivo * 100));
       const falta = Math.round((d.objetivo - mes.neto) * 100) / 100; %>
    <p class="dinero-cifra"><b><%= f.euros(mes.neto) %></b> <span class="suave">de <%= f.euros(d.objetivo, 0) %></span></p>
    <div class="progreso<%= falta <= 0 ? ' progreso-lleno' : '' %>" role="progressbar" aria-label="Facturación neta del mes"
         aria-valuemin="0" aria-valuemax="<%= d.objetivo %>" aria-valuenow="<%= Math.round(mes.neto) %>"
         aria-valuetext="<%= f.euros(mes.neto) %> de <%= f.euros(d.objetivo, 0) %>"><i style="width:<%= pct.toFixed(1) %>%"></i></div>
    <p class="peq <%= falta <= 0 ? 'cambio-mas' : 'suave' %>"><%= falta <= 0
      ? (falta === 0 ? 'Has llegado justo al objetivo.' : 'Has pasado el objetivo en ' + f.euros(-falta) + '.')
      : 'Te faltan ' + f.euros(falta) + ' para el objetivo.' %></p>
  <% } %>
    <dl class="extras">
      <div><dt>Propinas</dt><dd><%= f.euros(mes.propinas) %></dd></div>
      <div><dt>Peajes</dt><dd><%= f.euros(mes.peajes) %></dd></div>
    </dl>
    <p class="suave peq">Va a mes vencido: lo de <%= mes.nombre %> se cobra en la nómina de <%= mes.cobro %>.</p>
  <% if (d.anterior) { const a = d.anterior; %>
    <p class="peq dinero-anterior">En la nómina de <%= a.cobro %> entra lo de <%= a.nombre %>:
      <%= d.ett ? '' : 'facturaste ' + f.euros(a.neto) + ', ' %><%= f.euros(a.propinas) %> de propinas y <%= f.euros(a.peajes) %> de peajes.</p>
  <% } %>
  </div>
</section>
<% } %>

<% if (efectivo) { const e = efectivo; %>
<section class="caja" aria-labelledby="t-efectivo">
  <div class="caja-tit"><h2 id="t-efectivo">Efectivo por entregar</h2><a href="/efectivo">Ver el detalle</a></div>
  <div class="caja-in dinero">
  <% if (e.pendiente > 0) { %>
    <p class="dinero-cifra"><b><%= f.euros(e.pendiente) %></b></p>
    <p class="suave peq">Es el efectivo que has cobrado en BOLT y todavía no has entregado.</p>
  <% } else if (e.pendiente < 0) { %>
    <p>Has entregado <b><%= f.euros(-e.pendiente) %></b> de más.</p>
  <% } else { %>
    <p>Estás al día: no tienes efectivo por entregar.</p>
  <% } %>
  </div>
</section>
<% } %>

<section class="caja" aria-labelledby="t-nota">
  <div class="caja-tit"><h2 id="t-nota">Tu última nota</h2><% if (ultima) { %><a href="/puntuacion">Todas las semanas</a><% } %></div>
  <div class="caja-in">
  <% if (!ultima) { %>
    <p class="suave">Todavía no tienes ninguna semana con nota. La de cada semana sale el lunes.</p>
  <% } else if (ultima.letra === 'N/E') { %>
    <p><%= f.sinNota(ultima.motivo) %></p>
    <p class="suave peq">Semana <%= f.semanaLarga(ultima.desde, ultima.hasta) %></p>
  <% } else {
       const dif = anterior && anterior.total != null ? Math.round((ultima.total - anterior.total) * 10) / 10 : null; %>
    <div class="nota">
      <div class="nota-num"><%= f.total(ultima.total) %><small>/100</small></div>
      <span class="letra letra-<%= ultima.letra %>" aria-label="Letra <%= ultima.letra %>"><%= ultima.letra %></span>
    </div>
    <div class="nota-texto" style="margin-top:.6rem">
      <p class="suave peq">Semana <%= f.semanaLarga(ultima.desde, ultima.hasta) %></p>
      <% if (dif != null) { %>
      <p class="peq <%= dif > 0 ? 'cambio-mas' : dif < 0 ? 'cambio-menos' : 'suave' %>"><%=
        dif === 0 ? 'Igual que la semana anterior.'
        : (Math.abs(dif) === 1 ? '1 punto' : f.total(Math.abs(dif)) + ' puntos') + (dif > 0 ? ' más' : ' menos') + ' que la semana anterior.' %></p>
      <% } %>
    </div>
  <% } %>
  </div>
</section>
