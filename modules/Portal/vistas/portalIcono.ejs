<%# Los iconos del portal, UNA sola vez: los usa la barra de abajo y las tarjetas del inicio.
    Trazo de 1,8 sobre 24×24, en currentColor. Uso: include('portalIcono', { n: 'coche' }) %>
<% const comun = 'viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"'; %>
<% if (n === 'inicio') { %><svg <%- comun %>><path d="M3.5 10.5 12 3.5l8.5 7"/><path d="M5.5 9v11h4.75v-6h3.5v6h4.75V9"/></svg>
<% } else if (n === 'coche') { %><svg <%- comun %>><path d="M5 16.5V12l1.8-4.6A2 2 0 0 1 8.7 6h6.6a2 2 0 0 1 1.9 1.4L19 12v4.5"/><path d="M3.5 16.5h17v2a1 1 0 0 1-1 1h-1.5a1 1 0 0 1-1-1v-.5h-10v.5a1 1 0 0 1-1 1H4.5a1 1 0 0 1-1-1z"/><path d="M5 12h14"/><circle cx="8" cy="14.5" r=".6" fill="currentColor"/><circle cx="16" cy="14.5" r=".6" fill="currentColor"/></svg>
<% } else if (n === 'horas') { %><svg <%- comun %>><circle cx="12" cy="13.5" r="7.5"/><path d="M12 9.5v4l2.5 1.5M9.5 2.75h5M12 2.75V6M18.5 6.5l1.5-1.5"/></svg>
<% } else if (n === 'turnos') { %><svg <%- comun %>><rect x="3.5" y="5" width="17" height="15.5" rx="2.5"/><path d="M3.5 10h17M8 3v4M16 3v4"/></svg>
<% } else if (n === 'puntuacion') { %><svg <%- comun %>><path d="M4 20.5h16"/><path d="M6.5 17v-5M12 17V6.5M17.5 17v-8"/></svg>
<% } else if (n === 'efectivo') { %><svg <%- comun %>><rect x="2.5" y="6" width="19" height="12" rx="2"/><circle cx="12" cy="12" r="2.6"/><path d="M6 9.5v5M18 9.5v5"/></svg>
<% } else if (n === 'dinero') { %><svg <%- comun %>><path d="M4 17.5 9.5 12l3.5 3.5 7-7"/><path d="M15 8.5h5v5"/></svg>
<% } else if (n === 'seguir') { %><svg <%- comun %>><path d="m9.5 6 6 6-6 6"/></svg>
<% } %>
