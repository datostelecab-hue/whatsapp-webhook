<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="robots" content="noindex, nofollow">
  <%# Siempre en claro (20/11/2026, Camilo: «no quiero que lo vean oscuro»): la V3, como el ERP. %>
  <meta name="color-scheme" content="light">
  <meta name="theme-color" content="#f3f5f9">
  <title>Telecab · <%= titulo || 'Conductores' %></title>
  <link rel="icon" type="image/png" href="/assets/logo-sinfondo-256.png">
  <link rel="apple-touch-icon" href="/assets/logo-sinfondo-256.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="<%= est('/assets/css/portal.css') %>">
</head>
<body<%- locals.paso ? ' class="es-acceso"' : '' %>>
  <%# En el acceso, la marca va en la foto (portalEntrar): sin la cabecera de siempre. %>
  <% if (!locals.paso) { %>
  <header class="cab">
    <div class="cab-in">
      <a class="cab-marca" href="/" aria-label="Telecab, inicio">
        <svg class="tc-marca" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
          <path class="tc-marca-via" d="M5 53 Q31 37 61 39"/>
          <path class="tc-marca-carril" d="M12 58.5 Q35 45 61 44"/>
          <path class="tc-marca-via" d="M20 64 Q41 51 61 49"/>
          <ellipse class="tc-marca-sombra" cx="32" cy="41.2" rx="6" ry="1.5"/>
          <g class="tc-marca-pin"><path fill-rule="evenodd" d="M32 39.5C28.6 35.2 19 26.2 19 17.5a13 13 0 0 1 26 0c0 8.7-9.6 17.7-13 22Z M32 12.3a5.2 5.2 0 1 0 0 10.4a5.2 5.2 0 1 0 0-10.4Z"/></g>
        </svg>
        <span class="cab-nombre">Tele<span>cab</span></span>
      </a>
      <% if (conductor) { %>
      <div class="cab-quien">
        <b><%= conductor.nombre %></b>
        <form method="post" action="/salir"><button class="cab-salir" type="submit">Salir</button></form>
      </div>
      <% } %>
    </div>
  </header>
  <% } %>

  <main class="<%= locals.paso ? 'ent-pagina' : 'col' + (conductor ? '' : ' col-acceso') %>">
    <%- body %>
  </main>

  <% if (conductor) { %>
  <nav class="barra" aria-label="Secciones">
    <div class="barra-in">
      <a href="/" <%- pagina === 'portalInicio' ? 'aria-current="page"' : '' %>>
        <%- include('portalIcono', { n: 'inicio' }) %>
        Inicio
      </a>
      <a href="/coche" <%- pagina === 'portalCoche' ? 'aria-current="page"' : '' %>>
        <%- include('portalIcono', { n: 'coche' }) %>
        Coche
      </a>
      <a href="/turnos" <%- pagina === 'portalTurnos' ? 'aria-current="page"' : '' %>>
        <%- include('portalIcono', { n: 'turnos' }) %>
        Turnos
      </a>
      <a href="/puntuacion" <%- pagina === 'portalPuntuacion' ? 'aria-current="page"' : '' %>>
        <%- include('portalIcono', { n: 'puntuacion' }) %>
        Puntuación
      </a>
      <a href="/efectivo" <%- pagina === 'portalEfectivo' ? 'aria-current="page"' : '' %>>
        <%- include('portalIcono', { n: 'efectivo' }) %>
        Efectivo
      </a>
    </div>
  </nav>
  <% } %>
</body>
</html>
