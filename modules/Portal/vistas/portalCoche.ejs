<%#
  MI COCHE (20/11/2026): vincular un coche con su matrícula y, ya vinculado,
  abrir y cerrar las puertas o desvincularlo. Lo mismo que el bot de WhatsApp,
  con las mismas reglas (modules/Portal/portal.coche.js). Formularios normales:
  funciona sin JavaScript y con poca cobertura.

  23/11/2026: «Ver ubicación en vivo» del coche que le toca (el vinculado o el
  de hoy), las fotos con las que se dejó en el turno anterior y, para
  desvincular, las CINCO fotos obligatorias. El mapa y el aligerar las fotos
  antes de subirlas van con JavaScript (/assets/js/portal/coche.js); sin él, el
  formulario funciona igual.
%>
<% const hoyMat = (previas && previas.matricula) || (coche.vinculado ? coche.matricula : null); %>
<h1>Mi coche</h1>

<% if (resultado) { %>
<div class="resultado resultado-<%= resultado.tono %>" role="status">
  <p class="resultado-tit"><%= resultado.titulo %></p>
  <% (resultado.texto || []).forEach(function (t) { %><p><%= t %></p><% }) %>
</div>
<% } %>

<% if (coche.puede && hoyMat) { %>
<section class="caja" aria-labelledby="t-vivo">
  <div class="caja-in vivo" data-vivo>
    <div class="vivo-cab">
      <div>
        <p class="vivo-etq" id="t-vivo"><%= coche.vinculado ? 'Tu coche' : 'Tu coche de hoy' %></p>
        <p class="vivo-placa"><%= hoyMat %></p>
      </div>
      <button class="boton boton-claro vivo-boton" type="button" data-vivo-abrir aria-expanded="false" hidden>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z"/><circle cx="12" cy="10" r="2.4"/></svg>
        Ver ubicación en vivo
      </button>
    </div>
    <div class="vivo-cuerpo" data-vivo-cuerpo hidden>
      <ul class="vivo-estado" data-vivo-estado aria-live="polite"><li>Cargando…</li></ul>
      <div class="vivo-mapa" data-vivo-mapa role="img" aria-label="Mapa con la posición del coche"></div>
      <p class="suave peq" data-vivo-pie></p>
    </div>
    <noscript><p class="suave peq">Para ver el mapa hace falta activar JavaScript en el navegador.</p></noscript>
  </div>
</section>
<% } %>

<% if (!coche.puede) { %>
  <% if (!resultado) { %>
  <div class="resultado resultado-<%= coche.aviso.tono %>" role="status">
    <p class="resultado-tit"><%= coche.aviso.titulo %></p>
    <% (coche.aviso.texto || []).forEach(function (t) { %><p><%= t %></p><% }) %>
  </div>
  <% } %>
<% } else if (coche.vinculado) { %>
<section class="caja" aria-labelledby="t-coche">
  <div class="caja-in coche">
    <p class="coche-etq" id="t-coche">Vehículo vinculado</p>
    <p class="coche-placa"><%= coche.matricula %></p>
    <p class="suave peq">Vinculado <%= coche.desde %><%= coche.entregando ? '. Pulsaste «Entregar coche» ' + coche.entregando : '' %>.</p>

    <div class="coche-puertas">
      <form method="post" action="/coche/puertas">
        <input type="hidden" name="accion" value="abrir">
        <button class="boton boton-grande" type="submit">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4.5" y="10.5" width="15" height="10" rx="2.5"/><path d="M8 10.5V7.5a4 4 0 0 1 7.6-1.7"/></svg>
          Abrir puertas
        </button>
      </form>
      <form method="post" action="/coche/puertas">
        <input type="hidden" name="accion" value="cerrar">
        <button class="boton boton-grande boton-claro" type="submit">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4.5" y="10.5" width="15" height="10" rx="2.5"/><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"/></svg>
          Cerrar puertas
        </button>
      </form>
    </div>
  </div>
</section>

<section class="caja" aria-labelledby="t-desv">
  <div class="caja-in coche-desv">
    <h2 id="t-desv">¿Has terminado con el coche?</h2>
    <p class="suave peq">Al desvincularlo se bloquea el motor. Antes, <b>aparca y apaga el coche</b>: en marcha o con el contacto puesto no se desvincula.</p>
    <p class="suave peq">Haz las <b>cinco fotos</b> de cómo lo dejas: son obligatorias, y el siguiente conductor las verá.</p>
    <form method="post" action="/coche/desvincular" enctype="multipart/form-data" class="fotos-form" data-fotos-form>
      <%# EL PACK (23/11/2026): un botón abre la cámara de la app y guía las cinco
          seguidas. Sin cámara desde el navegador, las cinco casillas de siempre. %>
      <button class="boton fotos-pack" type="button" data-pack hidden>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 8.5A2.5 2.5 0 0 1 6.5 6h1.8l1.4-2h4.6l1.4 2h1.8A2.5 2.5 0 0 1 20 8.5v9a2.5 2.5 0 0 1-2.5 2.5h-11A2.5 2.5 0 0 1 4 17.5z"/><circle cx="12" cy="13" r="3.5"/></svg>
        <span data-pack-texto>Hacer las 5 fotos</span>
      </button>
      <% fotos.forEach(function (f, i) { %>
      <label class="foto-campo" for="<%= f.campo %>" data-foto-i="<%= i %>" data-guia="<%= f.guia %>">
        <%# La imagen de referencia de cómo va la foto (24/11/2026), no un número. %>
        <img class="foto-guia" src="<%= f.guia %>" alt="" width="80" height="50" loading="lazy" decoding="async">
        <span class="foto-texto"><b><%= f.etiqueta %></b><small data-foto-estado>Pulsa para hacer la foto</small></span>
        <img class="foto-mini" alt="" data-foto-mini hidden>
        <input id="<%= f.campo %>" name="<%= f.campo %>" type="file" accept="image/*" capture="environment" required>
      </label>
      <% }) %>
      <button class="boton boton-peligro" type="submit" data-fotos-enviar>Desvincular vehículo</button>
      <p class="suave peq" data-fotos-aviso hidden></p>
    </form>

    <%# La cámara de la app, a pantalla completa. %>
    <div class="cam" data-cam hidden role="dialog" aria-modal="true" aria-labelledby="cam-tit">
      <video class="cam-video" data-cam-video playsinline muted autoplay></video>
      <div class="cam-arriba">
        <button class="cam-cerrar" type="button" data-cam-cerrar aria-label="Cerrar la cámara">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
        </button>
        <%# La foto que toca: su imagen de referencia y su nombre (24/11/2026). %>
        <div class="cam-guia">
          <img class="cam-ref" data-cam-ref alt="" width="160" height="100">
          <p class="cam-tit" id="cam-tit" data-cam-tit></p>
        </div>
      </div>
      <p class="cam-error" data-cam-error hidden></p>
      <div class="cam-abajo">
        <ol class="cam-tira" data-cam-tira aria-label="Las cinco fotos">
          <% fotos.forEach(function (f, i) { %><li><button type="button" data-cam-ir="<%= i %>" aria-label="<%= f.etiqueta %>" style="background-image: url('<%= f.guia %>')"></button></li><% }) %>
        </ol>
        <div class="cam-botones">
          <span></span>
          <button class="cam-disparo" type="button" data-cam-disparo aria-label="Hacer la foto"><span></span></button>
          <button class="cam-listo" type="button" data-cam-listo hidden>Listo</button>
        </div>
      </div>
      <canvas data-cam-lienzo hidden></canvas>
    </div>
  </div>
</section>
<% } else { %>
<section class="caja" aria-labelledby="t-vincular">
  <form class="caja-in coche-vincular" method="post" action="/coche/vincular">
    <h2 id="t-vincular">Vincula el coche que vas a llevar</h2>
    <div class="campo">
      <label for="matricula">Matrícula</label>
      <input id="matricula" name="matricula" type="text" required minlength="4" maxlength="12"
             autocapitalize="characters" autocomplete="off" spellcheck="false" placeholder="1234ABC" value="<%= matricula %>">
    </div>
    <button class="boton" type="submit">Vincular coche</button>
    <p class="suave peq">Al vincularlo se desbloquea el motor y, desde aquí, podrás abrir y cerrar las puertas. Sin un coche vinculado, las puertas no se tocan.</p>
  </form>
</section>
<% } %>

<% if (coche.puede && previas && previas.turno) { %>
<section class="caja" aria-labelledby="t-previas">
  <div class="caja-in previas">
    <h2 id="t-previas">Cómo dejaron el <%= previas.matricula %></h2>
    <p class="suave peq">El turno anterior lo terminó <%= previas.turno.nombre || 'otra persona' %> el <%= previas.turno.fin %>.</p>
    <% if (previas.fotos.length) { %>
    <ul class="previas-fotos">
      <% previas.fotos.forEach(function (f) { %>
      <li><a href="/coche/foto/<%= f.id %>" target="_blank" rel="noopener"><img src="/coche/foto/<%= f.id %>" alt="<%= f.etiqueta %>" loading="lazy"></a><span><%= f.etiqueta %></span></li>
      <% }) %>
    </ul>
    <% } else { %>
    <p class="previas-vacio">Próximamente aquí estarán las fotos con las que se dejó el coche. Este turno se terminó por WhatsApp, que todavía no las pide.</p>
    <% } %>
  </div>
</section>
<% } %>

<p class="suave peq coche-pie">Es el mismo coche que en WhatsApp: si lo vinculas aquí, el bot también lo sabe, y al revés.</p>

<% if (coche.puede && hoyMat) { %>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/maplibre-gl/5.6.0/maplibre-gl.css">
<script nonce="<%= nonce %>" src="https://cdnjs.cloudflare.com/ajax/libs/maplibre-gl/5.6.0/maplibre-gl.js" defer></script>
<% } %>
<script nonce="<%= nonce %>" src="<%= est('/assets/js/portal/coche.js') %>" defer></script>
