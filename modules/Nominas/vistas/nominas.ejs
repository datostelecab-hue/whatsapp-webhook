<div class="max-w-7xl mx-auto">
  <div class="flex flex-wrap items-center justify-between gap-3 mb-5">
    <div>
      <h1 class="text-2xl font-bold text-telecab-text flex items-center gap-2">
        <i class="fa-solid fa-money-check-dollar text-telecab-gold"></i> Nóminas
      </h1>
      <p class="text-sm text-telecab-muted mt-1">
        Compensación variable del mes. <b class="text-telecab-text">A mes vencido</b>: la nómina de un mes
        usa los datos del anterior (la de Julio = trabajo de Junio).
      </p>
    </div>
    <div class="flex items-center gap-2">
      <select id="mes" aria-label="Mes de la nómina" class="px-3 py-2 rounded-lg bg-telecab-card border border-telecab-border text-telecab-text"></select>
      <input id="ano" type="number" min="2024" max="2100" aria-label="Año de la nómina" class="w-24 px-3 py-2 rounded-lg bg-telecab-card border border-telecab-border text-telecab-text">
    </div>
  </div>

  <!-- ══ CONFIG editable ══ -->
  <div class="rounded-xl bg-telecab-card border border-telecab-border mb-5">
    <button id="cfg-toggle" class="w-full flex items-center justify-between px-4 py-3 text-telecab-text font-medium">
      <span><i class="fa-solid fa-sliders mr-2 text-telecab-gold"></i> Configuración (tarifas y parámetros)</span>
      <i id="cfg-chev" class="fa-solid fa-chevron-down text-xs text-telecab-muted transition"></i>
    </button>
    <div id="cfg-body" class="hidden px-4 pb-4">
      <div id="cfg-grid" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3"></div>
      <p class="text-xs text-telecab-muted mt-3">
        Los marcados con <span class="text-telecab-gold">●</span> afectan al total.
        <b>Probar</b> recalcula con estos valores sin guardarlos; <b>Guardar</b> los deja puestos para siempre.
      </p>
      <div class="flex flex-wrap gap-2 mt-3">
        <button id="btn-probar" class="px-4 py-2 rounded-lg bg-telecab-violet/15 text-telecab-violet text-sm font-medium hover:bg-telecab-violet/25">
          <i class="fa-solid fa-calculator mr-1"></i> Probar con estos valores
        </button>
        <button id="btn-guardar-cfg" class="px-4 py-2 rounded-lg bg-telecab-gold/15 text-telecab-gold text-sm font-medium hover:bg-telecab-gold/25">Guardar config</button>
      </div>
    </div>
  </div>

  <!-- ══ Acciones ══ -->
  <div class="flex flex-wrap items-center gap-2 mb-4">
    <button id="btn-recargar" class="px-4 py-2 rounded-lg bg-telecab-green/15 text-telecab-green font-medium hover:bg-telecab-green/25">
      <i class="fa-solid fa-rotate mr-1"></i> Recalcular el mes
    </button>
    <span class="flex-1"></span>
    <% if (esDesarrollador) { %>
    <button id="btn-descongelar" class="px-4 py-2 rounded-lg bg-telecab-card border border-telecab-border text-telecab-muted text-sm hover:text-telecab-red hidden">
      <i class="fa-solid fa-fire mr-1"></i> Descongelar
    </button>
    <% } %>
    <button id="btn-congelar" class="px-4 py-2 rounded-lg bg-telecab-red/15 text-telecab-red text-sm font-medium hover:bg-telecab-red/25 disabled:opacity-40" disabled>
      <i class="fa-solid fa-snowflake mr-1"></i> Congelar
    </button>
    <a id="btn-descargar" href="#" class="px-4 py-2 rounded-lg bg-telecab-card border border-telecab-border text-telecab-text text-sm hover:bg-telecab-card2 hidden">
      <i class="fa-solid fa-file-excel mr-1"></i> Excel
    </a>
  </div>

  <!-- ══ Parte de la ETT ══ -->
  <!-- Va aparte y con su propio selector A PROPÓSITO: este fichero se pide por
       mes TRABAJADO (eliges agosto, salen los datos de agosto) mientras que la
       nómina de arriba va a mes vencido. Compartir el selector sería la forma
       más rápida de que alguien mande el mes equivocado a la agencia. -->
  <div class="rounded-xl bg-telecab-card border border-telecab-border mb-5 px-4 py-3">
    <div class="flex flex-wrap items-center gap-3">
      <div class="flex-1 min-w-[16rem]">
        <div class="text-telecab-text font-medium text-sm">
          <i class="fa-solid fa-file-arrow-down mr-2 text-telecab-violet"></i> Parte de trabajo de la ETT
        </div>
        <p class="text-xs text-telecab-muted mt-1">
          Horas trabajadas (rodadas + justificadas), nocturnidad <b>en horas</b>, propinas y peajes.
          Sin MBO: eso lo paga la agencia, no nosotros.
          <b class="text-telecab-warn">Va por mes trabajado</b>, no a mes vencido.
        </p>
      </div>
      <select id="ett-mes" aria-label="Mes trabajado del parte de la ETT" class="px-3 py-2 rounded-lg bg-telecab-card2 border border-telecab-border text-telecab-text text-sm"></select>
      <input id="ett-ano" type="number" min="2024" max="2100" aria-label="Año del parte de la ETT" class="w-24 px-3 py-2 rounded-lg bg-telecab-card2 border border-telecab-border text-telecab-text text-sm">
      <button id="btn-ett" class="px-4 py-2 rounded-lg bg-telecab-violet/15 text-telecab-violet text-sm font-medium hover:bg-telecab-violet/25">
        <i class="fa-solid fa-file-excel mr-1"></i> Excel de la ETT
      </button>
    </div>
  </div>

  <div id="progreso" class="hidden mb-4 rounded-lg border border-telecab-border bg-telecab-card px-4 py-3 text-sm text-telecab-text"></div>
  <div id="avisos" class="mb-4 space-y-2"></div>

  <!-- ══ Tabla ══ -->
  <div id="tabla-wrap" class="hidden rounded-xl bg-telecab-card border border-telecab-border overflow-hidden">
    <div class="flex flex-wrap items-center gap-3 px-4 py-3 border-b border-telecab-border">
      <input id="filtro" type="search" aria-label="Buscar conductor" placeholder="Nombre (ficha o BOLT) o DNI…" class="px-3 py-1.5 rounded-lg bg-telecab-card2 border border-telecab-border text-telecab-text text-sm w-56 max-w-full">
      <!-- Solo plantilla propia (16/10/2026): los de ETT van en su parte, el
           Excel de arriba. Por eso ya no hay columna «Tipo» ni filtro. -->
      <span id="fuente" class="text-xs"></span>
      <span class="flex-1"></span>
      <span id="resumen-tabla" class="text-sm text-telecab-muted"></span>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="text-xs text-telecab-muted bg-telecab-card2/50">
          <tr>
            <th class="text-left px-3 py-2">Conductor</th>
            <th class="text-left px-3 py-2">DNI/NIE</th>
            <th class="text-left px-3 py-2">Jornada</th>
            <th class="text-right px-3 py-2" title="Día desde el que cuenta el mes (su fecha de alta, o el día 1 si ya estaba)">Desde</th>
            <th class="text-right px-3 py-2" title="Horas efectivas rodadas: viaje + espera, por día natural (del 1 a las 00:00 al último a las 23:59)">Horas</th>
            <th class="text-right px-3 py-2" title="Horas de ESPERA retiradas a quien no llega al umbral de utilización, hasta dejarlo en la exigida. Nunca se quita viaje">Espera −</th>
            <th class="text-right px-3 py-2" title="Horas de las J aprobadas: cada una vale las horas que se le pusieron, y se suman a las rodadas">Justif.</th>
            <th class="text-right px-3 py-2" title="Vacaciones (5,84 h por día natural) y permisos retribuidos (8 h por día): suman para el objetivo">Vac./perm.</th>
            <th class="text-right px-3 py-2" title="Horas que se le pedían ese mes">Objetivo</th>
            <th class="text-right px-3 py-2" title="Lo que falta para el objetivo después de sumar BOLT y las J. Es la diferencia cuando sale negativa">Sin justif.</th>
            <th class="text-right px-3 py-2" title="Rodadas + justificadas − objetivo. Lo que se paga como hora extra cuando es positiva">Dif.</th>
            <th class="text-right px-3 py-2">Propinas</th>
            <th class="text-right px-3 py-2">Peajes</th>
            <th class="text-right px-3 py-2">Nocturnas</th>
            <th class="text-right px-3 py-2">MBO FAS</th>
            <th class="text-right px-3 py-2">Compens.</th>
            <th class="text-right px-3 py-2">Días ext.</th>
            <th class="text-right px-3 py-2">%Util</th>
            <th class="text-right px-3 py-2 font-semibold text-telecab-text">TOTAL</th>
          </tr>
        </thead>
        <tbody id="tbody"></tbody>
        <tfoot id="tfoot" class="font-semibold text-telecab-text border-t-2 border-telecab-border"></tfoot>
      </table>
    </div>
  </div>
</div>

<script type="application/json" id="datos-servidor">
  <%- json({ mesActual: mesActual, anoActual: anoActual, campos: campos, esDesarrollador: esDesarrollador }) %>
</script>
<script src="<%= est('/assets/js/vistas/Nominas/nominas.js') %>"></script>
