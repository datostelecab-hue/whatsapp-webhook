<div class="max-w-7xl mx-auto">
  <div class="flex flex-wrap items-center justify-between gap-3 mb-5">
    <div>
      <h1 class="text-2xl font-bold text-telecab-text flex items-center gap-2">
        <i class="fa-solid fa-money-check-dollar text-telecab-gold"></i> Nóminas
      </h1>
      <p class="text-sm text-telecab-muted mt-1">
        Compensación variable del mes. <b class="text-telecab-text">A mes vencido</b>: la nómina de un mes
        usa los datos del anterior (la de Julio = trabajo de Junio).
      </p>
    </div>
    <div class="flex items-center gap-2">
      <select id="mes" class="px-3 py-2 rounded-lg bg-telecab-card border border-telecab-border text-telecab-text"></select>
      <input id="ano" type="number" min="2024" max="2100" class="w-24 px-3 py-2 rounded-lg bg-telecab-card border border-telecab-border text-telecab-text">
    </div>
  </div>

  <!-- ══ CONFIG editable ══ -->
  <div class="rounded-xl bg-telecab-card border border-telecab-border mb-5">
    <button id="cfg-toggle" class="w-full flex items-center justify-between px-4 py-3 text-telecab-text font-medium">
      <span><i class="fa-solid fa-sliders mr-2 text-telecab-gold"></i> Configuración (tarifas y parámetros)</span>
      <i id="cfg-chev" class="fa-solid fa-chevron-down text-xs text-telecab-muted transition"></i>
    </button>
    <div id="cfg-body" class="hidden px-4 pb-4">
      <div id="cfg-grid" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3"></div>
      <p class="text-xs text-telecab-muted mt-3">
        Los marcados con <span class="text-telecab-gold">●</span> afectan al total.
        <b>Probar</b> recalcula con estos valores sin guardarlos; <b>Guardar</b> los deja puestos para siempre.
      </p>
      <div class="flex flex-wrap gap-2 mt-3">
        <button id="btn-probar" class="px-4 py-2 rounded-lg bg-telecab-violet/15 text-telecab-violet text-sm font-medium hover:bg-telecab-violet/25">
          <i class="fa-solid fa-calculator mr-1"></i> Probar con estos valores
        </button>
        <button id="btn-guardar-cfg" class="px-4 py-2 rounded-lg bg-telecab-gold/15 text-telecab-gold text-sm font-medium hover:bg-telecab-gold/25">Guardar config</button>
      </div>
    </div>
  </div>

  <!-- ══ Acciones ══ -->
  <div class="flex flex-wrap items-center gap-2 mb-4">
    <button id="btn-recargar" class="px-4 py-2 rounded-lg bg-telecab-green/15 text-telecab-green font-medium hover:bg-telecab-green/25">
      <i class="fa-solid fa-rotate mr-1"></i> Recalcular el mes
    </button>
    <span class="flex-1"></span>
    <% if (esDesarrollador) { %>
    <button id="btn-descongelar" class="px-4 py-2 rounded-lg bg-telecab-card border border-telecab-border text-telecab-muted text-sm hover:text-telecab-red hidden">
      <i class="fa-solid fa-fire mr-1"></i> Descongelar
    </button>
    <% } %>
    <button id="btn-congelar" class="px-4 py-2 rounded-lg bg-telecab-red/15 text-telecab-red text-sm font-medium hover:bg-telecab-red/25 disabled:opacity-40" disabled>
      <i class="fa-solid fa-snowflake mr-1"></i> Congelar
    </button>
    <a id="btn-descargar" href="#" class="px-4 py-2 rounded-lg bg-telecab-card border border-telecab-border text-telecab-text text-sm hover:bg-telecab-card2 hidden">
      <i class="fa-solid fa-file-excel mr-1"></i> Excel
    </a>
  </div>

  <div id="progreso" class="hidden mb-4 rounded-lg border border-telecab-border bg-telecab-card px-4 py-3 text-sm text-telecab-text"></div>
  <div id="avisos" class="mb-4 space-y-2"></div>

  <!-- ══ Tabla ══ -->
  <div id="tabla-wrap" class="hidden rounded-xl bg-telecab-card border border-telecab-border overflow-hidden">
    <div class="flex flex-wrap items-center gap-3 px-4 py-3 border-b border-telecab-border">
      <input id="filtro" type="search" placeholder="Nombre (ficha o BOLT) o DNI…" class="px-3 py-1.5 rounded-lg bg-telecab-card2 border border-telecab-border text-telecab-text text-sm w-56 max-w-full">
      <div class="flex rounded-lg overflow-hidden border border-telecab-border text-xs">
        <button data-tipo="todos" class="ftipo px-3 py-1.5 bg-telecab-gold/15 text-telecab-gold font-medium">Todos</button>
        <button data-tipo="propia" class="ftipo px-3 py-1.5 text-telecab-muted hover:text-telecab-text border-l border-telecab-border">Propia</button>
        <button data-tipo="ett" class="ftipo px-3 py-1.5 text-telecab-muted hover:text-telecab-text border-l border-telecab-border">ETT</button>
      </div>
      <span id="fuente" class="text-xs"></span>
      <span class="flex-1"></span>
      <span id="resumen-tabla" class="text-sm text-telecab-muted"></span>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="text-xs text-telecab-muted bg-telecab-card2/50">
          <tr>
            <th class="text-left px-3 py-2">Conductor</th>
            <th class="text-left px-3 py-2">DNI/NIE</th>
            <th class="text-left px-3 py-2">Tipo</th>
            <th class="text-left px-3 py-2">Jornada</th>
            <th class="text-right px-3 py-2" title="Día desde el que cuenta el mes (su fecha de alta, o el día 1 si ya estaba)">Desde</th>
            <th class="text-right px-3 py-2" title="Horas efectivas rodadas: viaje + espera, jornada 05→05">Horas</th>
            <th class="text-right px-3 py-2" title="Horas cubiertas por J aprobadas. Cada J vale la jornada del día, sin pasar de ahí">Justif.</th>
            <th class="text-right px-3 py-2" title="Horas que se le pedían ese mes">Objetivo</th>
            <th class="text-right px-3 py-2" title="Lo que falta para el objetivo después de sumar BOLT y las J. Es la diferencia cuando sale negativa">Sin justif.</th>
            <th class="text-right px-3 py-2" title="Rodadas + justificadas − objetivo. Lo que se paga como hora extra cuando es positiva">Dif.</th>
            <th class="text-right px-3 py-2">Propinas</th>
            <th class="text-right px-3 py-2">Peajes</th>
            <th class="text-right px-3 py-2">Nocturnas</th>
            <th class="text-right px-3 py-2">MBO FAS</th>
            <th class="text-right px-3 py-2">Compens.</th>
            <th class="text-right px-3 py-2">Días ext.</th>
            <th class="text-right px-3 py-2">%Util</th>
            <th class="text-right px-3 py-2 font-semibold text-telecab-text">TOTAL</th>
          </tr>
        </thead>
        <tbody id="tbody"></tbody>
        <tfoot id="tfoot" class="font-semibold text-telecab-text border-t-2 border-telecab-border"></tfoot>
      </table>
    </div>
  </div>
</div>

<script type="application/json" id="datos-servidor">
  <%- JSON.stringify({ mesActual: mesActual, anoActual: anoActual, campos: campos, esDesarrollador: esDesarrollador }) %>
</script>
<script>
const CFG = JSON.parse(document.getElementById('datos-servidor').textContent);
const $ = s => document.querySelector(s);
const MESES = ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];
const esc = s => String(s==null?'':s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const eur = n => (Number(n)||0).toLocaleString('es-ES',{minimumFractionDigits:2,maximumFractionDigits:2}) + ' €';
let RESULTADO = null, FUENTE = '', cargando = false;

// ── Selectores de mes/año ──
MESES.forEach((m,i)=>{ const o=document.createElement('option'); o.value=i+1; o.textContent=m; if(i+1===CFG.mesActual)o.selected=true; $('#mes').appendChild(o); });
$('#ano').value = CFG.anoActual;
const mes = () => parseInt($('#mes').value,10);
const ano = () => parseInt($('#ano').value,10);

// ── Config ──
$('#cfg-toggle').addEventListener('click', () => { $('#cfg-body').classList.toggle('hidden'); $('#cfg-chev').classList.toggle('rotate-180'); });
function pintarConfig(cfg) {
  $('#cfg-grid').innerHTML = CFG.campos.map(c => `
    <label class="block">
      <span class="text-xs text-telecab-muted">${c.usado?'<span class="text-telecab-gold">●</span> ':''}${esc(c.label)}</span>
      <input data-key="${c.key}" type="number" step="0.01" value="${cfg[c.key]}"
        class="cfg-in mt-1 w-full px-3 py-2 rounded-lg bg-telecab-card2 border border-telecab-border text-telecab-text">
    </label>`).join('');
}
const recogerConfig = () => { const o={}; document.querySelectorAll('.cfg-in').forEach(i=>o[i.dataset.key]=parseFloat(i.value)); return o; };
async function cargarConfig() {
  const r = await (await fetch('/nominas/config')).json();
  if (r.status==='ok') pintarConfig(r.config);
}
$('#btn-guardar-cfg').addEventListener('click', async () => {
  const r = await (await fetch('/nominas/config',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({config:recogerConfig()})})).json();
  if (r.status==='ok') { pintarConfig(r.config); msg('✅ Config guardada. Vuelve a recalcular el mes para verla aplicada.'); }
  else msg('❌ '+(r.msg||'error'), true);
});

// ── Cargar el mes ──
// Si está congelado sale lo congelado; si no, se calcula al vuelo. Una nómina
// congelada NO se recalcula: es lo que se pagó.
async function cargar() {
  if (cargando) return;
  cargando = true;
  RESULTADO = null; $('#tabla-wrap').classList.add('hidden'); $('#btn-congelar').disabled = true;
  $('#btn-descargar').classList.add('hidden'); $('#fuente').innerHTML = ''; $('#avisos').innerHTML = '';
  if ($('#btn-descongelar')) $('#btn-descongelar').classList.add('hidden');
  msg('⏳ Calculando el mes…');
  try {
    const r = await (await fetch(`/nominas/cargar?mes=${mes()}&ano=${ano()}`)).json();
    if (r.status==='ok' && r.resultado) {
      RESULTADO = r.resultado; FUENTE = r.fuente; render();
      msg(r.fuente==='congelada'
        ? `❄️ Nómina congelada el ${fecha(RESULTADO.congeladaAt)}${RESULTADO.congeladaPor?' por '+RESULTADO.congeladaPor:''}. Es la que se pagó: no se recalcula.`
        : '✅ Calculada con los datos de la base. Revisa y congela cuando esté conforme.');
    } else msg('❌ '+(r.msg||'no se pudo calcular'), true);
  } catch (e) { msg('No se pudo cargar: ' + e.message, true); }
  cargando = false;
}
$('#mes').addEventListener('change', cargar);
$('#ano').addEventListener('change', cargar);
$('#btn-recargar').addEventListener('click', cargar);

// ── Probar una config sin guardarla ──
$('#btn-probar').addEventListener('click', async () => {
  if (FUENTE === 'congelada' && !confirm('Este mes está CONGELADO. Lo que pruebes no cambia lo congelado: es solo para ver qué saldría. ¿Seguir?')) return;
  msg('⏳ Recalculando con esos valores…');
  const r = await (await fetch('/nominas/calcular',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({mes:mes(),ano:ano(),config:recogerConfig()})})).json();
  if (r.status==='ok') { RESULTADO = r.resultado; FUENTE = 'prueba'; render(); msg('🧪 Simulación con esos valores. No está guardado ni congelado.'); }
  else msg('❌ '+(r.msg||'error'), true);
});

// ── Congelar / descongelar ──
$('#btn-congelar').addEventListener('click', async () => {
  const dm = RESULTADO && RESULTADO.mesDatosNombre ? ` (trabajo de ${RESULTADO.mesDatosNombre})` : '';
  if (!confirm(`¿Congelar la nómina de ${MESES[mes()-1]} ${ano()}${dm}?\n\nSe guardan estos números tal cual. A partir de ahí no se recalculan, pase lo que pase con los datos.`)) return;
  msg('⏳ Congelando…');
  const r = await (await fetch('/nominas/congelar',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({mes:mes(),ano:ano()})})).json();
  if (r.status==='ok') { msg(`❄️ Congelada · ${r.conductores} conductores · total ${eur(r.total)}`); cargar(); }
  else msg('❌ '+(r.msg||'error'), true);
});
if ($('#btn-descongelar')) $('#btn-descongelar').addEventListener('click', async () => {
  if (!confirm(`¿Descongelar ${MESES[mes()-1]} ${ano()}?\n\nSe BORRA la nómina guardada y vuelve a calcularse desde los datos de hoy. Si ya se pagó, los números pueden salir distintos.`)) return;
  const r = await (await fetch('/nominas/descongelar',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({mes:mes(),ano:ano()})})).json();
  if (r.status==='ok') { msg(r.borrada?'Descongelada. Vuelve a calcularse en vivo.':'No había ninguna congelada.'); cargar(); }
  else msg('❌ '+(r.msg||'error'), true);
});

$('#btn-descargar').addEventListener('click', e => { e.preventDefault(); window.open(`/nominas/nomina.xlsx?mes=${mes()}&ano=${ano()}`,'_blank'); });

// ── Render ──
let FILTRO_TIPO = 'todos';
function render() {
  if (!RESULTADO || !RESULTADO.filas) { $('#tabla-wrap').classList.add('hidden'); return; }
  $('#tabla-wrap').classList.remove('hidden');
  $('#btn-congelar').disabled = false;
  $('#btn-descargar').classList.remove('hidden');
  if ($('#btn-descongelar')) $('#btn-descongelar').classList.toggle('hidden', FUENTE !== 'congelada');
  const badge = FUENTE==='congelada' ? ['❄️ congelada','bg-telecab-violet/15 text-telecab-violet']
    : FUENTE==='prueba' ? ['🧪 simulación','bg-telecab-warn/15 text-telecab-warn']
    : ['⚡ calculada en vivo','bg-telecab-card2 text-telecab-muted'];
  $('#fuente').innerHTML = `<span class="px-2 py-0.5 rounded-full ${badge[1]}">${badge[0]}</span>`;
  pintarAvisos(RESULTADO.avisos, RESULTADO.config);
  filtrarYpintar();
}
function filtrarYpintar() {
  const q = ($('#filtro').value||'').toLowerCase().trim();
  // Se busca por CUALQUIERA de los tres nombres y por el DNI: RRHH escribe el de
  // la ficha y Trafico el de BOLT, y son distintos a proposito.
  const filas = RESULTADO.filas.filter(f =>
    (FILTRO_TIPO==='todos' || (FILTRO_TIPO==='ett' ? f.ett : !f.ett)) &&
    (!q || [f.nombre, f.nombreBolt, f.nombreSS, f.dni].join(' ').toLowerCase().includes(q)));
  $('#resumen-tabla').textContent = `${filas.length} conductores · Nómina ${MESES[RESULTADO.mes-1]} ${RESULTADO.ano}` +
    (RESULTADO.mesDatosNombre ? ` · datos de ${RESULTADO.mesDatosNombre} ${RESULTADO.anoDatos}` : '');
  $('#tbody').innerHTML = filas.map(f => `<tr class="border-t border-telecab-border/50 hover:bg-telecab-card2/40">
    <td class="px-3 py-2 text-telecab-text">${esc(f.nombre)}${mismoNombre(f)?'':`<br><span class="text-[11px] text-telecab-muted">BOLT: ${esc(f.nombreBolt)}</span>`}</td>
    <td class="px-3 py-2 text-telecab-muted">${esc(f.dni)||'<span class="text-telecab-red/70">—</span>'}</td>
    <td class="px-3 py-2"><span class="text-xs px-2 py-0.5 rounded-full ${f.ett?'bg-telecab-violet/15 text-telecab-violet':'bg-telecab-card2 text-telecab-muted'}">${f.ett?'ETT':'Propia'}</span></td>
    <td class="px-3 py-2 text-telecab-muted whitespace-nowrap">${f.jornada?f.jornada+' horas':'<span class="text-telecab-muted/50">—</span>'}</td>
    <td class="px-3 py-2 text-right text-telecab-muted" title="${esc(arranque(f))}">${f.primerDia}${f.origenArranque==='primer-log'?' <span class="text-telecab-warn">*</span>':''}</td>
    <td class="px-3 py-2 text-right">${(Number(f.horas)||0).toFixed(1)}</td>
    <td class="px-3 py-2 text-right ${f.horasJustificadas>0?'text-telecab-azul':'text-telecab-muted/50'}" title="${f.diasJustificados||0} día(s) con justificante aprobado">${(Number(f.horasJustificadas)||0).toFixed(1)}${f.diasJustificados?` <span class="text-[10px] text-telecab-muted">(${f.diasJustificados}d)</span>`:''}</td>
    <td class="px-3 py-2 text-right ${f.deltaHoras>0?'text-telecab-green':'text-telecab-muted'}" title="Rodadas ${(Number(f.horas)||0).toFixed(1)} + justificadas ${(Number(f.horasJustificadas)||0).toFixed(1)} = ${((Number(f.horas)||0)+(Number(f.horasJustificadas)||0)).toFixed(1)} h · diferencia ${(Number(f.deltaHoras)||0).toFixed(1)} h">${(Number(f.horasObjetivo)||0).toFixed(1)}</td>
    <td class="px-3 py-2 text-right ${f.horasNoJustificadas>0?'text-telecab-red font-semibold':'text-telecab-muted/40'}" title="${f.horasNoJustificadas>0?'Le faltan horas y no hay J que las explique':'Cubrió su objetivo'}">${(Number(f.horasNoJustificadas)||0).toFixed(1)}</td>
    <td class="px-3 py-2 text-right ${f.deltaHoras>0?'text-telecab-green font-medium':'text-telecab-muted/50'}">${f.deltaHoras>0?'+':''}${(Number(f.deltaHoras)||0).toFixed(1)}</td>
    <td class="px-3 py-2 text-right">${eur(f.propinas)}</td>
    <td class="px-3 py-2 text-right">${eur(f.peajes)}</td>
    <td class="px-3 py-2 text-right">${eur(f.nocturnas)}</td>
    <td class="px-3 py-2 text-right ${f.compensacion>0?'text-telecab-muted/60':''}">${eur(f.mboFAS)}</td>
    <td class="px-3 py-2 text-right ${f.compensacion>0?'':'text-telecab-muted/50'}">${eur(f.compensacion)}</td>
    <td class="px-3 py-2 text-right ${f.diasExtra>0?'':'text-telecab-muted/50'}">${(Number(f.diasExtra)||0).toFixed(2)}</td>
    <td class="px-3 py-2 text-right">${f.utilPct==null?'<span class="text-telecab-red/70">—</span>':f.utilPct.toFixed(0)+'%'}</td>
    <td class="px-3 py-2 text-right font-semibold text-telecab-text">${eur(f.total)}</td></tr>`).join('')
    || '<tr><td colspan="18" class="px-3 py-6 text-center text-telecab-muted">Sin coincidencias</td></tr>';
  const t = filas.reduce((a,f)=>{['horas','horasJustificadas','horasNoJustificadas','propinas','peajes','nocturnas','mboFAS','compensacion','diasExtra','total'].forEach(k=>a[k]+=f[k]||0);return a;},{horas:0,horasJustificadas:0,horasNoJustificadas:0,propinas:0,peajes:0,nocturnas:0,mboFAS:0,compensacion:0,diasExtra:0,total:0});
  $('#tfoot').innerHTML = `<tr>
    <td class="px-3 py-2" colspan="5">TOTAL${FILTRO_TIPO!=='todos'?' '+FILTRO_TIPO.toUpperCase():''} (${filas.length})</td>
    <td class="px-3 py-2 text-right">${t.horas.toFixed(1)}</td>
    <td class="px-3 py-2 text-right text-telecab-azul">${t.horasJustificadas.toFixed(1)}</td>
    <td></td>
    <td class="px-3 py-2 text-right ${t.horasNoJustificadas>0?'text-telecab-red':''}">${t.horasNoJustificadas.toFixed(1)}</td>
    <td></td>
    <td class="px-3 py-2 text-right">${eur(t.propinas)}</td>
    <td class="px-3 py-2 text-right">${eur(t.peajes)}</td>
    <td class="px-3 py-2 text-right">${eur(t.nocturnas)}</td>
    <td class="px-3 py-2 text-right">${eur(t.mboFAS)}</td>
    <td class="px-3 py-2 text-right">${eur(t.compensacion)}</td>
    <td class="px-3 py-2 text-right">${t.diasExtra.toFixed(2)}</td>
    <td></td>
    <td class="px-3 py-2 text-right text-telecab-gold">${eur(t.total)}</td></tr>`;
}
// Los dos nombres son la misma persona escrita de dos formas; solo se ensena el
// de BOLT cuando de verdad difiere, o la tabla se llena de ruido.
const norm = s2 => String(s2||'').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-z0-9]/g,'');
const mismoNombre = f => !f.nombreBolt || norm(f.nombre).split('').sort().join('') === norm(f.nombreBolt).split('').sort().join('');

const arranque = f => f.origenArranque==='alta-anterior' ? 'Ya estaba de alta: mes completo'
  : f.origenArranque==='alta-en-mes' ? ('Alta el '+(dia(f.alta)||'?')+': objetivo prorrateado desde ese día')
  : 'SIN fecha de alta: se usa su primer día con horas';
$('#filtro').addEventListener('input', filtrarYpintar);
document.querySelectorAll('.ftipo').forEach(b => b.addEventListener('click', () => {
  FILTRO_TIPO = b.dataset.tipo;
  document.querySelectorAll('.ftipo').forEach(x => { const on = x===b;
    x.classList.toggle('bg-telecab-gold/15',on); x.classList.toggle('text-telecab-gold',on);
    x.classList.toggle('font-medium',on); x.classList.toggle('text-telecab-muted',!on); });
  if (RESULTADO) filtrarYpintar();
}));

function pintarAvisos(a, cfg) {
  if (!a) { $('#avisos').innerHTML=''; return; }
  const av=[];
  const mesD = RESULTADO ? RESULTADO.mesDatosNombre : 'el mes';
  if (a.sinDinero) av.push(['red','⚠️ Ninguna persona tiene propinas, peajes ni facturación en ese mes: falta la ingesta de pedidos de BOLT.']);
  if (a.sinDni>0) av.push(['amber',`${a.sinDni} conductor(es) sin DNI/NIE en su ficha (aparecen con —). Complétalos en la ficha del conductor.`]);
  if (a.trabajoIncompleto) av.push(['amber',`⚠️ El mes de trabajo (${mesD}) aún no ha terminado: los datos están incompletos. Esta nómina se cierra el mes siguiente.`]);
  const exc = (a.excluidos||[]);
  if (exc.length) av.push(['red',`⛔ ${exc.length} conductor(es) con horas pero FECHA DE ALTA posterior a ${mesD}: fuera de esta nómina. Revisa su alta si es un error → ${exc.map(e=>`${e.nombre} (alta ${dia(e.alta)||'—'}, ${e.horas} h)`).join(' · ')}`]);
  if (a.sinAlta>0) av.push(['amber',`${a.sinAlta} conductor(es) SIN fecha de alta (marcados con *): se les prorratea desde su primer día con horas. Rellénales el alta en su periodo de empleo.`]);
  if (a.altaEnMes>0) av.push(['muted',`${a.altaEnMes} conductor(es) se dieron de alta durante ${mesD}: son los únicos con el objetivo prorrateado.`]);
  if (a.jPendientes>0) av.push(['amber',`⏳ ${a.jPendientes} justificante(s) de ${mesD} siguen PENDIENTES de aprobar: todavía no cuentan. Si se aprueban, las horas justificadas suben y las no justificadas bajan. Se revisan en /justificantes.`]);
  if (a.conJ>0) av.push(['muted',`${a.conJ} conductor(es) tienen días justificados. Cada J vale la jornada entera (${(cfg||{}).horasMetaDia||8} h) sin distinguir el motivo, y nunca suma por encima de lo que falte de ese día. Las justificadas CUENTAN para la diferencia: un día justificado no le resta a nadie sus horas extra.`]);
  if (a.conHorasSinJustificar>0) av.push(['amber',`⚠️ ${a.conHorasSinJustificar} conductor(es) siguen por debajo de su objetivo después de contarles las J: son las "horas no justificadas" de la columna roja.`]);
  if (a.sinNombreBolt>0) av.push(['muted',`${a.sinNombreBolt} conductor(es) sin nombre de BOLT: en el Excel sale el de la ficha en su lugar.`]);
  if (a.sinApellidosSeparados>0) av.push(['muted',`${a.sinApellidosSeparados} conductor(es) tienen el nombre en una sola pieza (la ficha no separa apellidos de nombres), as\u00ed que en la columna "Nombre de la seguridad social" salen sin la coma. No se parte a ojo: en unos casos son dos apellidos y en otros uno, y alguno va en orden inverso. Se arregla rellen\u00e1ndoles los apellidos en su ficha.`]);
  const ss = (a.sinSellar||[]);
  if (ss.length) av.push(['muted',`${ss.length} conductor(es) tienen horas aquí que la bitácora NO tiene selladas (se les enlazó la cuenta de BOLT después de cerrar el mes): la nómina los cuenta, la bitácora no. Si quieres que cuadren, resella el mes desde la bitácora → ${ss.map(x=>x.nombre).join(' · ')}`]);
  const c = cfg || {};
  av.push(['muted',`Hora extra: ${c.eurHoraExtra||0} €/h × utilización · Nocturna: ${c.eurHoraNoc||0} × h × ${c.factorNoc||0} · FAS: (neto − umbral) × ${c.pctMBOFAS||0} · umbral 40h=${c.umbralFAS40||0} / 32h=${c.umbralFAS32||0} · objetivo ${c.horasMetaDia||0} h × ${c.diasObjetivo||0} días`]);
  $('#avisos').innerHTML = av.map(([c2,t])=>`<div class="rounded-lg px-3 py-2 text-sm ${c2==='red'?'bg-telecab-red/10 text-telecab-red border border-telecab-red/30':c2==='amber'?'bg-telecab-warn/15 text-telecab-warn border border-telecab-warn/35':'bg-telecab-card2/40 text-telecab-muted'}">${esc(t)}</div>`).join('');
}

const fecha = v => { try { return new Date(v).toLocaleString('es-ES',{timeZone:'Europe/Madrid',day:'2-digit',month:'2-digit',year:'numeric',hour:'2-digit',minute:'2-digit'}); } catch(e) { return ''; } };
// Las fechas de alta vienen en AAAA-MM-DD (que es como se guardan) y se enseñan
// como se leen aquí. Se le da la vuelta al texto y ya: pasarlas por Date las
// movería un día, que es el fallo clásico de este proyecto con las fechas.
const dia = iso => (iso ? String(iso).slice(0,10).split('-').reverse().join('/') : '');
function msg(txt, err) {
  const p = $('#progreso'); p.classList.remove('hidden');
  p.textContent = txt; p.style.color = err ? 'var(--tc-red, #f87171)' : '';
}

cargarConfig();
cargar();
</script>
