<%- include('partials/convenio-nav', { sub: 'nomina' }) %>

<!-- Barra del mes: la nómina es de un mes (el de PAGO de las variables). -->
<div class="px-4 lg:px-6 pt-3 max-w-[1400px] mx-auto">
  <div class="flex items-center gap-2">
    <span class="text-sm text-telecab-muted mr-1">Mes de pago</span>
    <button id="mes-prev" class="w-9 h-9 rounded-xl bg-telecab-card border border-telecab-border hover:border-telecab-gold/40 text-telecab-muted transition" title="Mes anterior">
      <i class="fa-solid fa-chevron-left text-xs"></i>
    </button>
    <div id="mes-label" class="min-w-[10rem] text-center font-semibold tabular-nums"></div>
    <button id="mes-next" class="w-9 h-9 rounded-xl bg-telecab-card border border-telecab-border hover:border-telecab-gold/40 text-telecab-muted transition" title="Mes siguiente">
      <i class="fa-solid fa-chevron-right text-xs"></i>
    </button>
  </div>
</div>

<div id="nomina"></div>

<script type="application/json" id="datos-servidor"><%- json({ anioInicial: Number(anioInicial), mesInicial: Number(mesInicial) }) %></script>
<script src="<%= est('/assets/js/vistas/RRHH/convenioNomina.js') %>"></script>
