<!-- ============================================================
     MAPA DE FLOTA — piloto
     ============================================================
     Dónde está cada coche (Mapon) y si hay alguien dando servicio (BOLT), en la
     misma pantalla. Lo que se busca es el rojo: un coche que rueda sin que
     nadie esté conectado.

     SIN `p-4`: el `<main>` del layout no lleva padding, así que el mapa va a
     sangre simplemente no poniéndolo. La barra de arriba mide h-14 = 3.5rem.
-->
<div class="h-[calc(100vh-3.5rem)] flex flex-col">

  <!-- ── La cinta: el recuento es el resumen, y se pincha para filtrar ── -->
  <div class="flex items-center gap-2 px-4 py-2 border-b border-telecab-border
              bg-telecab-card/60 backdrop-blur-sm shrink-0 flex-wrap">
    <!-- El buscador va en la cinta y no en la lista: la lista no sale en el
         móvil, y el filtro tiene que valer para el mapa también. -->
    <label class="relative shrink-0" title="Busca por conductor —el de ahora o el último que lo llevó en BOLT— o por matrícula. Intro vuela al primero.">
      <i class="fa-solid fa-magnifying-glass absolute left-2.5 top-1/2 -translate-y-1/2 text-[11px] text-telecab-muted pointer-events-none"></i>
      <input id="m-buscar" type="search" autocomplete="off" spellcheck="false" placeholder="Conductor o matrícula"
             aria-label="Buscar por conductor o matrícula"
             class="w-44 sm:w-52 pl-7 pr-2 py-1.5 rounded-lg bg-telecab-dark/60 border border-telecab-border
                    text-xs text-telecab-text placeholder:text-telecab-muted
                    focus:outline-none focus:border-telecab-gold transition">
    </label>
    <div id="m-chips" class="flex items-center gap-1.5 flex-wrap"></div>
    <div class="flex-1"></div>
    <p id="m-frescura" class="text-[11px] text-telecab-muted tabular-nums"
       title="Cuándo se pidió la última posición a Mapon.&#10;La vuelta va cada 30 segundos, pero el equipo del coche solo habla cada minuto aproximadamente: pedir más a menudo no daría un dato más nuevo."></p>
    <button id="m-recargar" title="Pedir la posición ahora, sin esperar al refresco"
            class="px-2.5 py-1.5 rounded-lg border border-telecab-border text-xs text-telecab-muted
                   hover:text-telecab-gold hover:border-telecab-gold transition">
      <i class="fa-solid fa-rotate"></i>
    </button>
  </div>

  <!-- ── LA ALERTA: coches de la flota de los que Mapon no da nada ──
       No tienen punto en el mapa, asi que sin esto desaparecerian a la vista.
       Se pinta en cuanto hay uno y se va sola cuando Mapon vuelve a verlos. -->
  <div id="m-sinmapon" class="hidden px-4 py-2 border-b border-telecab-red/40 bg-telecab-red/10
                              text-sm text-telecab-red shrink-0"></div>

  <div class="flex-1 flex min-h-0">

    <!-- ── La lista. NO es un Listado de la casa a propósito: no es una
             pantalla que liste, es el índice del mapa —se pincha para volar a
             un coche— y el componente trae tabla, paginación, KPIs y ficha,
             que aquí estorban. Ver el LEEME del módulo. ── -->
    <aside id="m-panel" class="w-72 shrink-0 border-r border-telecab-border
                               bg-telecab-card/40 overflow-y-auto hidden md:block">
      <div id="m-lista" class="p-2 space-y-1"></div>
    </aside>

    <!-- EL MAPA VA DE `flex-1`, NO DE `absolute inset-0`.
         MapLibre le pone `position: relative` a su propio contenedor, y su hoja
         de estilos se carga despues de Tailwind, asi que gana ella: el
         `absolute` se pierde, el `inset-0` deja de sujetar nada y la altura pasa
         a depender del lienzo, que a su vez depende de la altura. El bucle
         acababa en un mapa de 2.756 px que se salia de la pantalla.
         De `flex-1` la altura la decide el padre y no hay bucle posible. -->
    <div class="flex-1 flex flex-col min-h-0 relative">
      <div id="m-mapa" class="flex-1 min-h-0"></div>
      <div id="m-error"
           class="hidden absolute top-3 left-1/2 -translate-x-1/2 z-10 px-3 py-2 rounded-xl
                  border border-telecab-red/40 bg-telecab-red/10 text-sm text-telecab-red"></div>
    </div>
  </div>
</div>

<!-- LA HOJA DE MAPLIBRE VA ANTES QUE LA NUESTRA, Y NO ES UN DETALLE.
     Las dos definen `.maplibregl-popup-content` con la misma especificidad, asi
     que decide el ORDEN: con la suya cargada despues, el globo salia con FONDO
     BLANCO sobre un tema oscuro —el `color` si se aplicaba, el `background` no—
     y el texto quedaba ilegible. Poniendola primero, lo nuestro manda. -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/maplibre-gl/5.6.0/maplibre-gl.css">

<style>
  /* El punto del coche. Se mueve con `transform`, así que el navegador lo
     anima en la tarjeta gráfica y ciento y pico puntos no cuestan nada. */
  .m-coche {
    width: 26px; height: 26px; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    border-radius: 999px; border: 2px solid rgb(var(--tc-dark));
    box-shadow: 0 1px 4px rgb(0 0 0 / .45);
    transition: box-shadow .15s ease, filter .15s ease;
  }
  .m-coche:hover { filter: brightness(1.15); box-shadow: 0 0 0 4px rgb(var(--tc-gold) / .30); }
  .m-coche i { font-size: 11px; color: rgb(var(--tc-dark)); }

  /* EL QUE RUEDA SIN NADIE LATE. Con cien puntos quietos en pantalla, un rojo
     más entre ellos no se ve; lo que se ve es lo que se mueve. Late solo ese:
     si latieran todos, no destacaría ninguno. */
  .m-coche.m-suelto { animation: m-latido 1.6s ease-in-out infinite; }
  @keyframes m-latido {
    0%, 100% { box-shadow: 0 0 0 0   rgb(var(--tc-red) / .55); }
    50%      { box-shadow: 0 0 0 9px rgb(var(--tc-red) / 0); }
  }
  /* LA ESPERA FUERA DE LA M-30 PARPADEA (24/09/2026). Es el mismo azul que la
     de dentro —las dos son espera— y lo que las separa es esto: se enciende y se
     apaga. Late distinto del rojo a propósito: el rojo pulsa un halo, este se
     apaga entero, y así no se confunden de reojo. Lo lleva también el punto
     de la lista. */
  .m-coche.m-esperafuera, .m-parpadea { animation: m-parpadeo 1.1s ease-in-out infinite; }
  @keyframes m-parpadeo { 0%, 100% { opacity: 1; } 50% { opacity: .2; } }

  /* Quien pidió menos movimiento en su sistema no quiere que una pantalla se
     lo salte. El rojo ya distingue; el latido solo ayuda a encontrarlo. La
     espera de fuera, sin parpadeo, lleva un anillo discontinuo: algo tiene que
     separarla de la de dentro. */
  @media (prefers-reduced-motion: reduce) {
    .m-coche.m-suelto, .m-coche.m-esperafuera, .m-parpadea { animation: none; }
    .m-coche.m-esperafuera { outline: 2px dashed rgb(var(--tc-mapa-espera)); outline-offset: 2px; }
  }

  /* El que lleva rato sin hablar se pinta a medias: no es dónde está, es dónde
     estuvo, y eso tiene que notarse sin leer nada. */
  .m-coche.m-perdido { opacity: .45; border-style: dashed; }
  /* El GPS callado no es un equipo muerto: se ve entero, con el borde punteado
     para decir que el punto es de hace unos minutos. */
  .m-coche.m-singps { opacity: .8; border-style: dotted; }
  /* Un rojo levantado sobre datos de BOLT viejos no puede pintarse igual que
     uno de verdad: se vacía por dentro. Es un "no se sabe", no una acusación. */
  .m-coche.m-dudoso { opacity: .55; border-style: dashed; }

  .maplibregl-popup-content {
    background: rgb(var(--tc-card)); color: rgb(var(--tc-text));
    border: 1px solid rgb(var(--tc-border)); border-radius: 14px;
    padding: 10px 12px; font-size: 12px; box-shadow: 0 8px 28px rgb(0 0 0 / .45);
  }
  .maplibregl-popup-tip { border-top-color: rgb(var(--tc-card)) !important;
                          border-bottom-color: rgb(var(--tc-card)) !important; }
  .maplibregl-popup-close-button { color: rgb(var(--tc-muted)); font-size: 16px; padding: 2px 7px; }
  .maplibregl-ctrl-group { background: rgb(var(--tc-card)) !important;
                           border: 1px solid rgb(var(--tc-border)) !important; }
  .maplibregl-ctrl-group button + button { border-top: 1px solid rgb(var(--tc-border)) !important; }
  .maplibregl-ctrl-attrib { font-size: 10px; }
</style>

<script src="https://cdnjs.cloudflare.com/ajax/libs/maplibre-gl/5.6.0/maplibre-gl.js"></script>
<script>
(function () {
  'use strict';
  const $ = s => document.querySelector(s);
  const esc = (window.Listado && Listado.fmt && Listado.fmt.esc) || (x => String(x == null ? '' : x));

  // ── Los colores salen de los TOKENS, no de una lista de hex ──────────────
  // Hay quince temas y el oro pasa de #F4963C a #C96C14 al cambiar a claro. Un
  // marcador con el color escrito a mano se vuelve ilegible en la mitad de
  // ellos; leyendo el token se adapta solo, también al cambiarlo en caliente.
  const raiz = document.documentElement;
  const cv = (n, a) => {
    const v = getComputedStyle(raiz).getPropertyValue(n).trim();
    return a == null ? 'rgb(' + v + ')' : 'rgb(' + v + ' / ' + a + ')';
  };

  // LOS SEIS DE CAMILO, EN SU ORDEN (24/09/2026): viaje, espera dentro de la
  // M-30, espera fuera, rodando en descanso, rodando desconectado y error de
  // GPS. La regla de cada uno vive en mapa.service.js (`tono`); aquí solo el
  // color, el icono y el nombre. Detrás, separados, los que no son ninguno de
  // esos seis.
  const TONOS = {
    viaje:       { tk: '--tc-green',         icono: 'fa-taxi',                 texto: 'En viaje' },
    espera:      { tk: '--tc-mapa-espera',   icono: 'fa-hourglass-half',       texto: 'En espera en la M-30' },
    esperafuera: { tk: '--tc-mapa-espera',   icono: 'fa-hourglass-end',        texto: 'En espera fuera de la M-30' },
    descanso:    { tk: '--tc-mapa-descanso', icono: 'fa-mug-hot',              texto: 'Rodando en descanso' },
    suelto:      { tk: '--tc-red',           icono: 'fa-triangle-exclamation', texto: 'Rodando desconectado' },
    errorgps:    { tk: '--tc-violet',        icono: 'fa-location-crosshairs',  texto: 'Error de GPS' },
    parado:      { tk: '--tc-muted',         icono: 'fa-circle',               texto: 'Parado' },
    singps:      { tk: '--tc-muted',         icono: 'fa-satellite-dish',       texto: 'GPS sin fijar' },
    perdido:     { tk: '--tc-border',        icono: 'fa-question',             texto: 'Sin señal' },
    // Coches nuestros de los que Mapon no da nada: no tienen punto en el mapa,
    // van en la lista y en la franja roja de arriba.
    sinmapon:    { tk: '--tc-red',           icono: 'fa-satellite',            texto: 'Sin nada en Mapon' },
  };
  const PRINCIPALES = ['viaje', 'espera', 'esperafuera', 'descanso', 'suelto', 'errorgps'];
  const ORDEN = PRINCIPALES.concat(['parado', 'singps', 'perdido', 'sinmapon']);
  const CLASES_TONO = ORDEN.map(k => 'm-' + k);
  // Explicación de cada filtro, para el globo del chip.
  const AYUDA = {
    viaje: 'De viaje en BOLT: yendo a por el pasajero o llevándolo.',
    espera: 'En espera en BOLT y dentro de la M-30 (la línea azul discontinua del mapa).',
    esperafuera: 'En espera en BOLT, pero FUERA de la M-30.',
    descanso: 'Rodando con el conductor en descanso: conectado, pero sin dar servicio.',
    suelto: 'Rodando sin nadie conectado en BOLT.',
    errorgps: 'De viaje en BOLT y Mapon lo da por parado desde hace 10 min o más: el GPS no está dando la posición real.',
    parado: 'No se mueve y no está trabajando en BOLT.',
    singps: 'El equipo habla pero no coge satélite: el punto es de hace unos minutos.',
    perdido: 'El equipo de Mapon no habla: el punto es de cuando se calló.',
    sinmapon: 'Coches de la flota de los que Mapon no da nada.',
  };

  const cvComa = (n, a) => {
    const v = getComputedStyle(raiz).getPropertyValue(n).trim().split(/\s+/).join(', ');
    return a == null ? 'rgb(' + v + ')' : 'rgba(' + v + ', ' + a + ')';
  };

  // EL ANILLO DE LA M-30, del servidor (modules/Mapa/m30.js). Solo números.
  const M30 = <%- JSON.stringify(typeof m30 !== 'undefined' && m30 ? m30 : []) %>;

  const hhmm = s => {
    if (s == null) return '';
    const h = Math.floor(s / 3600), m = Math.round((s % 3600) / 60);
    return h ? h + ' h ' + String(m).padStart(2, '0') : m + ' min';
  };
  const hace = s => (s == null ? 'sin dato' : s < 90 ? s + ' s' : hhmm(s));
  // Para lo que puede ser de hace días: «hace 3 días» se lee mejor que «hace 74 h 10».
  const haceLargo = s => (s == null ? '' : s < 172800 ? hace(s) : Math.floor(s / 86400) + ' días');

  // QUIÉN ES EL COCHE EN LA LISTA: la persona, no la matrícula (24/09/2026). El
  // que lo lleva ahora si está conectado; si no, el último que lo llevó en BOLT.
  const esAhora = c => !!(c.conectado && c.conductor);
  const nombreDe = c => (esAhora(c) ? c.conductor : (c.ultimoConductor || c.conductor || null));

  // ── El buscador ──────────────────────────────────────────────────────────
  // Sin acentos ni mayúsculas, y la matrícula sin espacios ni guiones: «1234 abc»
  // encuentra el 1234ABC y «jose» encuentra a José.
  const norm = x => String(x || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
  let busca = '';
  const coincide = c => {
    if (!busca) return true;
    const b = norm(busca), bm = b.replace(/[\s-]/g, '');
    return norm(c.matricula).replace(/[\s-]/g, '').includes(bm)
      || norm(c.conductor).includes(b) || norm(c.ultimoConductor).includes(b);
  };
  // Lo que se ve, en el mapa y en la lista: el chip elegido y lo buscado.
  const visible = c => (!filtro || c.tono === filtro) && coincide(c);

  // "4 s", "2 min 10 s", "1 h 05": los segundos se ven mientras importan, que
  // es justo al principio -cuando alguien acaba de coger un viaje-.
  function desdeHaceTxt(iso) {
    const s = Math.max(0, Math.round((Date.now() - new Date(iso).getTime()) / 1000));
    if (s < 60) return s + ' s';
    if (s < 600) return Math.floor(s / 60) + ' min ' + String(s % 60).padStart(2, '0') + ' s';
    return hhmm(s);
  }
  // EL RELOJ DE LA PANTALLA. Cada segundo pone al dia todos los "hace X" que
  // haya a la vista -la ventanita abierta incluida-. No pregunta nada a nadie:
  // la hora del cambio ya la tiene, solo resta.
  setInterval(() => {
    document.querySelectorAll('[data-desde]').forEach(el => {
      el.textContent = desdeHaceTxt(el.getAttribute('data-desde'));
    });
  }, 1000);

  // ── El fondo del mapa, según el tema ─────────────────────────────────────
  // No hay una lista de "temas claros" que mantener: se mira la LUMINANCIA del
  // color de fondo de la casa. Sirve para los quince de hoy y para el que se
  // añada mañana sin tocar esto.
  function estiloDelTema() {
    const v = getComputedStyle(raiz).getPropertyValue('--tc-dark').trim().split(/\s+/).map(Number);
    const luz = v.length === 3 ? (0.2126 * v[0] + 0.7152 * v[1] + 0.0722 * v[2]) : 0;
    return 'https://tiles.openfreemap.org/styles/' + (luz > 128 ? 'positron' : 'dark');
  }

  let mapa = null, listo = false;
  const marcas = new Map();          // unidad → { marker, el, datos }
  let DATOS = [];
  let filtro = null;                 // tono elegido en la cinta, o null = todos
  let seq = 0;                       // descarta respuestas que llegan tarde
  let primera = true;

  // ── Arranque del mapa ────────────────────────────────────────────────────
  function arrancar() {
    mapa = new maplibregl.Map({
      container: 'm-mapa',
      style: estiloDelTema(),
      center: [-3.70, 40.42],        // Madrid, hasta que lleguen los coches
      zoom: 9.5,
      attributionControl: { compact: true },
    });
    mapa.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'top-right');
    mapa.addControl(new maplibregl.FullscreenControl(), 'top-right');
    mapa.on('load', () => { listo = true; pintar(); });
    // `style.load` salta al arrancar y cada vez que el tema cambia el estilo:
    // setStyle se lleva las capas propias por delante, y el anillo hay que
    // volver a ponerlo.
    mapa.on('style.load', pintarM30);

    // SI EL MAPA NO ARRANCA, QUE LO DIGA.
    //
    // MapLibre da por cargado el mapa despues del PRIMER PINTADO, y ese pintado
    // depende de `requestAnimationFrame`. En una pestaña que el navegador no
    // esta componiendo —minimizada, en segundo plano, o en un panel oculto—
    // esa llamada no llega nunca: el lienzo existe, no hay ni un error en la
    // consola, y lo que se ve es un rectangulo negro. Es la misma trampa que
    // dejo las ayudas invisibles en su dia.
    //
    // No se puede arreglar desde aqui —si el navegador no pinta, no pinta— pero
    // si se puede DECIR, en vez de dejar a alguien mirando un hueco negro sin
    // saber si es que no hay coches.
    setTimeout(() => {
      if (listo) return;
      const av = $('#m-error');
      av.innerHTML = '<i class="fa-solid fa-triangle-exclamation mr-1"></i>'
        + 'El mapa no ha terminado de cargar. Suele pasar si la pestaña estaba en segundo '
        + 'plano: vuelve a ella y recarga. Los coches de la izquierda sí están al día.';
      av.classList.remove('hidden');
    }, 12000);

    // MapLibre mide su lienzo UNA vez y no vuelve a mirar. Sin esto, el mapa se
    // queda con el tamaño que tuviera al arrancar: al esconderse la lista en
    // pantalla estrecha, o al cambiar la ventana de tamaño, quedaria una franja
    // gris al lado. `resize` es barato y solo se dispara cuando cambia de
    // verdad.
    new ResizeObserver(() => { if (mapa) mapa.resize(); }).observe($('#m-mapa'));

    // El tema se puede cambiar sin recargar, y el mapa tiene que enterarse.
    // Los marcadores NO se pierden al cambiar de estilo: viven fuera de él.
    new MutationObserver(() => {
      const nuevo = estiloDelTema();
      if (mapa && mapa.__estilo !== nuevo) { mapa.__estilo = nuevo; mapa.setStyle(nuevo); }
      repintarColores();
    }).observe(raiz, { attributes: true, attributeFilter: ['data-theme'] });
    mapa.__estilo = estiloDelTema();
  }

  /**
   * LA M-30, como línea discontinua en el azul de la espera. Es la frontera que
   * separa el azul fijo del que parpadea: sin verla, «fuera de la M-30» es un
   * acto de fe.
   */
  function pintarM30() {
    if (!mapa || !M30.length || mapa.getSource('m30')) return;
    mapa.addSource('m30', { type: 'geojson', data: {
      type: 'Feature', properties: {},
      geometry: { type: 'LineString', coordinates: M30.concat([M30[0]]) } } });
    mapa.addLayer({ id: 'm30', type: 'line', source: 'm30',
      paint: { 'line-color': cvComa('--tc-mapa-espera'), 'line-width': 2, 'line-opacity': 0.6, 'line-dasharray': [2, 2] } });
  }

  /** El globito que sale al pinchar un coche. */
  function ficha(c) {
    const t = TONOS[c.tono] || TONOS.parado;
    const lineas = [];
    // El de ahora, o el último que lo llevó en BOLT, dicho como tal.
    const quien = nombreDe(c);
    if (quien && esAhora(c)) lineas.push('<i class="fa-solid fa-user w-4 text-telecab-muted"></i> ' + esc(quien));
    else if (quien) {
      lineas.push('<i class="fa-solid fa-user w-4 text-telecab-muted"></i> <span class="text-telecab-muted">último:</span> '
        + esc(quien) + (c.ultimoHace != null ? ' <span class="text-telecab-muted">· hace ' + haceLargo(c.ultimoHace) + '</span>' : ''));
    }
    if (c.situacionEtiqueta) {
      // "En espera · hace 5 s", y el numero CORRE solo: lo pone al dia el reloj
      // de abajo cada segundo, sin volver a preguntar al servidor.
      lineas.push('<i class="fa-solid fa-signal w-4 text-telecab-muted"></i> <b>' + esc(c.situacionEtiqueta) + '</b>'
        + (c.situacionDesde
            ? ' <span class="text-telecab-muted">· hace <span data-desde="' + esc(c.situacionDesde) + '">'
              + desdeHaceTxt(c.situacionDesde) + '</span></span>'
            : (c.desdeHace != null ? ' <span class="text-telecab-muted">· ' + hhmm(c.desdeHace) + '</span>' : '')));
    } else {
      lineas.push('<i class="fa-solid fa-signal w-4 text-telecab-muted"></i> <span class="text-telecab-muted">no está en BOLT</span>');
    }
    lineas.push('<i class="fa-solid fa-gauge-high w-4 text-telecab-muted"></i> '
      + (c.velocidad == null ? '—' : c.velocidad + ' km/h')
      + (c.rueda && c.llevaAsi != null
          ? ' <span class="text-telecab-muted">· rodando desde hace ' + hhmm(c.llevaAsi) + '</span>' : '')
      + (c.km != null ? ' <span class="text-telecab-muted">· ' + c.km + ' km en el tramo</span>' : ''));
    lineas.push('<i class="fa-solid fa-satellite-dish w-4 text-telecab-muted"></i> <span class="text-telecab-muted">'
      + 'el equipo habló hace ' + hace(c.antiguedad) + '</span>');
    // EN QUÉ ESTADO ESTÁ EL COCHE PARA LA CASA. Es lo que deja leer un gris: uno
    // «En taller» lleva semanas callado y es normal; uno «Operativo» callado
    // tres meses es un equipo que hay que ir a mirar.
    if (c.estadoVehiculo && (c.tono === 'perdido' || !c.operativo)) {
      lineas.push('<i class="fa-solid fa-screwdriver-wrench w-4 ' + (c.operativo ? 'text-telecab-warn' : 'text-telecab-muted')
        + '"></i> <span class="' + (c.operativo ? 'text-telecab-warn' : 'text-telecab-muted') + '">'
        + esc(c.estadoVehiculo) + (c.operativo ? ' — y su GPS no habla' : '') + '</span>');
    }
    if (c.telefono) {
      lineas.push('<a href="tel:' + esc(c.telefono) + '" class="text-telecab-gold">'
        + '<i class="fa-solid fa-phone w-4"></i> ' + esc(c.telefono) + '</a>');
    }
    return '<p class="font-bold text-sm mb-1">' + esc(c.matricula || '#' + c.unidad)
      + ' <span class="ml-1 text-[10px] px-1.5 py-0.5 rounded" style="background:' + cv(t.tk, .18)
      + ';color:' + cv(t.tk) + '">' + esc(t.texto) + '</span></p>'
      + (c.motivo ? '<p class="text-[11px] mb-1.5" style="color:' + cv(t.tk) + '">' + esc(c.motivo) + '</p>' : '')
      + '<div class="space-y-0.5">' + lineas.map(l => '<p>' + l + '</p>').join('') + '</div>';
  }

  /** Vuelve a dar color a los puntos ya pintados (al cambiar de tema). */
  function repintarColores() {
    marcas.forEach(m => {
      const t = TONOS[m.datos.tono] || TONOS.parado;
      m.el.style.background = cv(t.tk);
    });
    // El anillo, si el estilo no cambió: un tema claro y otro claro comparten
    // mapa, pero no el azul de la espera.
    if (mapa && mapa.getLayer && mapa.getLayer('m30')) mapa.setPaintProperty('m30', 'line-color', cvComa('--tc-mapa-espera'));
  }

  // ── Pintar: mover lo que ya está, no rehacerlo ───────────────────────────
  // Se conserva el marcador y solo se le cambia el sitio y el color. Recrear
  // ciento y pico cada treinta segundos daría un parpadeo en cada refresco y
  // cerraría el globito que alguien estuviera leyendo justo entonces.
  function pintar() {
    if (!listo) return;
    const vistos = new Set();

    DATOS.forEach(c => {
      if (!visible(c)) return;
      // Sin posicion no hay punto que poner: ese coche va en la lista y en la
      // alerta de arriba.
      if (c.lat == null || c.lng == null) return;
      vistos.add(c.clave);
      const t = TONOS[c.tono] || TONOS.parado;
      let m = marcas.get(c.clave);

      if (!m) {
        const el = document.createElement('div');
        el.className = 'm-coche';
        el.innerHTML = '<i class="fa-solid"></i>';
        const marker = new maplibregl.Marker({ element: el })
          .setLngLat([c.lng, c.lat])
          .setPopup(new maplibregl.Popup({ offset: 16, closeButton: true, maxWidth: '260px' }))
          .addTo(mapa);
        m = { marker, el, datos: c };
        marcas.set(c.clave, m);
      } else {
        m.marker.setLngLat([c.lng, c.lat]);
      }

      m.datos = c;
      m.el.style.background = cv(t.tk);
      // CON `classList`, NUNCA CON `className`.
      //
      // MapLibre le añade al elemento su propia clase `maplibregl-marker`, que
      // es la que lleva el `position: absolute`. Escribir `className` entera la
      // borraba: el marcador se quedaba en `static`, el `transform` que lo
      // coloca dejaba de tener efecto y los ciento y pico puntos se apilaban en
      // una columna que bajaba de Madrid a Gibraltar. Las coordenadas estaban
      // bien todo el rato; lo que faltaba era una palabra en el atributo.
      m.el.classList.remove.apply(m.el.classList, CLASES_TONO);
      m.el.classList.remove('m-dudoso');
      m.el.classList.add('m-coche', 'm-' + c.tono);
      // El rojo levantado sobre datos de BOLT viejos se pinta hueco: sigue
      // estando ahi, pero no acusa a nadie.
      if (c.dudoso) m.el.classList.add('m-dudoso');
      m.el.title = (c.matricula || '#' + c.unidad) + (nombreDe(c) ? ' · ' + nombreDe(c) : '') + ' · ' + t.texto;
      m.el.querySelector('i').className = 'fa-solid ' + t.icono;
      // El contenido se rehace siempre: los segundos de "hace" corren.
      m.marker.getPopup().setHTML(ficha(c));
    });

    // Lo que ya no sale (por el filtro, o porque Mapon dejó de verlo) se quita.
    marcas.forEach((m, k) => { if (!vistos.has(k)) { m.marker.remove(); marcas.delete(k); } });

    // Solo la PRIMERA vez se encuadra la flota. Después no: alguien puede estar
    // mirando una calle concreta y que el mapa salte cada treinta segundos
    // haría la pantalla inservible.
    //
    // Y SE ENCUADRA DONDE ESTÁ LA FLOTA, NO DONDE LLEGAN LOS EXTREMOS. Hay
    // coches en Barcelona: encuadrar hasta el último abría el mapa de Madrid al
    // Mediterráneo y no se distinguía un punto de otro. Se toma la MEDIANA y se
    // encuadra lo que cae a menos de medio grado (unos 55 km) de ella. Los de
    // fuera siguen en el mapa y en la lista, solo que hay que ir a por ellos
    // —o pinchar su fila, que vuela hasta él—.
    //
    // La mediana y no la media: con cien coches en Madrid y cinco en Barcelona,
    // la media se va hacia Zaragoza. La mediana se queda donde está la gente, y
    // el día que la mayoría sea de Barcelona se irá sola allí.
    // Solo con los que tienen punto: los de "sin nada en Mapon" traen la
    // posicion a NULL y romperian la mediana.
    const conPunto = DATOS.filter(c => c.lat != null && c.lng != null);
    if (primera && conPunto.length) {
      const mediana = v => v.slice().sort((a, b) => a - b)[Math.floor(v.length / 2)];
      const clat = mediana(conPunto.map(c => c.lat));
      const clng = mediana(conPunto.map(c => c.lng));
      const cerca = conPunto.filter(c => Math.abs(c.lat - clat) < 0.5 && Math.abs(c.lng - clng) < 0.5);
      const b = new maplibregl.LngLatBounds();
      (cerca.length ? cerca : conPunto).forEach(c => b.extend([c.lng, c.lat]));
      mapa.fitBounds(b, { padding: 60, maxZoom: 13, duration: 0 });
      primera = false;
    }
  }

  function pintarChips(cuenta) {
    // Los seis de siempre salen siempre, aunque estén a cero: un «0 rodando
    // desconectado» también es una respuesta. Los demás, solo si hay alguno.
    const ks = ORDEN.filter(k => PRINCIPALES.includes(k) || cuenta[k] || filtro === k);
    $('#m-chips').innerHTML = ks.map((k, i) => {
      const t = TONOS[k], n = cuenta[k] || 0;
      const activo = filtro === k;
      const raya = i > 0 && !PRINCIPALES.includes(k) && PRINCIPALES.includes(ks[i - 1])
        ? '<span class="w-px h-5 bg-telecab-border mx-1" aria-hidden="true"></span>' : '';
      return raya + '<button data-tono="' + k + '" title="' + esc(AYUDA[k] || t.texto) + ' Pincha para ver solo estos."'
        + ' class="px-2 py-1 rounded-lg text-[11px] font-semibold border transition tabular-nums'
        + (activo ? ' ring-2' : '') + '"'
        + ' style="border-color:' + cv(t.tk, .45) + ';background:' + cv(t.tk, activo ? .28 : .12)
        + ';color:' + cv(t.tk) + (activo ? ';--tw-ring-color:' + cv(t.tk, .5) : '') + '">'
        + '<i class="fa-solid ' + t.icono + ' mr-1"></i>' + n + ' ' + esc(t.texto) + '</button>';
    }).join('');
  }

  function pintarLista() {
    // En el orden de los filtros, y dentro de cada uno por persona.
    const vis = DATOS.filter(visible)
      .sort((a, b) => ORDEN.indexOf(a.tono) - ORDEN.indexOf(b.tono)
        || String(nombreDe(a) || a.matricula || '').localeCompare(String(nombreDe(b) || b.matricula || ''), 'es'));
    if (!vis.length) {
      $('#m-lista').innerHTML = '<p class="text-xs text-telecab-muted p-2">'
        + (busca ? 'Nadie con «' + esc(busca) + '».' : 'Ninguno.') + '</p>';
      return;
    }
    // LA PERSONA ARRIBA, LA MATRÍCULA DEBAJO (24/09/2026). Se busca a la gente
    // por su nombre; la matrícula sigue ahí, en pequeño, para quien la tenga.
    $('#m-lista').innerHTML = vis.map(c => {
      const t = TONOS[c.tono] || TONOS.parado;
      const quien = nombreDe(c);
      const mat = c.matricula || '#' + c.unidad;
      const estado = c.tono === 'sinmapon'
        ? (c.estadoVehiculo || 'sin estado') + ' · sin Mapon'
        : esAhora(c) ? (c.situacionEtiqueta || t.texto)
        : quien ? 'último' + (c.ultimoHace != null ? ', hace ' + haceLargo(c.ultimoHace) : '')
        : 'nadie en BOLT';
      return '<button data-clave="' + esc(c.clave) + '"'
        + ' class="w-full text-left px-2 py-1.5 rounded-lg hover:bg-telecab-card2 transition flex items-center gap-2">'
        + '<span class="w-2 h-2 rounded-full shrink-0' + (c.tono === 'esperafuera' ? ' m-parpadea' : '')
        + '" style="background:' + cv(t.tk) + '"></span>'
        + '<span class="min-w-0 flex-1">'
        + '<span class="block text-xs font-semibold truncate' + (quien && !esAhora(c) ? ' text-telecab-muted' : '') + '">'
        + esc(quien || mat) + '</span>'
        + '<span class="block text-[10px] text-telecab-muted truncate">'
        + (quien ? '<span class="tabular-nums">' + esc(mat) + '</span> · ' : '') + esc(estado) + '</span></span>'
        + (c.velocidad ? '<span class="text-[10px] text-telecab-muted tabular-nums shrink-0">'
            + c.velocidad + '</span>' : '') + '</button>';
    }).join('');
  }

  // ── Traer el fotograma ───────────────────────────────────────────────────
  async function cargar(forzar) {
    const mio = ++seq;
    try {
      const r = await (await fetch('/mapa/api/coches' + (forzar ? '?forzar=1' : ''))).json();
      // Si mientras tanto se pidió otro, este ya es viejo: no pisa al nuevo.
      if (mio !== seq) return;
      if (r.status !== 'ok') throw new Error(r.msg || 'No se pudo cargar');
      $('#m-error').classList.add('hidden');
      DATOS = r.coches || [];
      const sm = r.sinMapon || [];
      const caja = $('#m-sinmapon');
      caja.classList.toggle('hidden', !sm.length);
      caja.innerHTML = sm.length
        ? '<i class="fa-solid fa-triangle-exclamation mr-1"></i><b>' + sm.length + ' coche' + (sm.length === 1 ? '' : 's')
          + ' de la flota sin nada en Mapon:</b> '
          + sm.map(x => esc(x.matricula) + ' <span class="opacity-75">(' + esc(x.estado || 'sin estado') + ')</span>').join(' · ')
          + ' <span class="opacity-75">— no se pueden situar en el mapa.</span>'
        : '';
      pintarChips(r.cuenta || {});
      pintarLista();
      pintar();
      const f = r.frescura || {};
      const fuera = (f.sinFicha || 0) + (f.otraSede || 0);
      // LO QUE NO SE PINTA, DICHO. El mapa enseña solo los coches de la casa de
      // tu sede; las demás unidades de la cuenta de Mapon se quedan fuera. Que
      // desaparezcan a la vista está bien; que desaparezcan en silencio es que
      // un día falte un coche y nadie sepa por qué.
      const cola = fuera
        ? ' · ' + fuera + ' equipo' + (fuera === 1 ? '' : 's') + ' fuera del mapa'
        : '';
      const el = $('#m-frescura');
      el.textContent = f.unidades
        ? DATOS.length + ' coches de Madrid · posición de hace ' + hace(f.hace) + cola
        : 'todavía no hay ninguna posición guardada';
      el.title = f.unidades
        ? 'La vuelta pide la posición a Mapon cada 30 segundos, pero el equipo del coche solo habla cada minuto aproximadamente.\n\n'
          + (fuera ? f.sinFicha + ' equipo(s) de Mapon sin ficha en el ERP y ' + f.otraSede
              + ' de otra sede: no se pintan.' : 'Todas las unidades de Mapon son coches de tu sede.')
        : 'Nadie ha guardado todavía una posición. Si acaba de arrancar el sistema, espera media vuelta.';

      // SI LA VUELTA VA CON RETRASO SE DICE UNA VEZ Y ARRIBA, en vez de ir
      // poniendo coches grises: el dato de cada coche está bien, lo que pasa es
      // que nadie lo está refrescando.
      // LA MITAD DE BOLT, QUE ES LA QUE MIENTE EN SILENCIO. Los puntos se
      // mueven cada 30 s; las etiquetas —quién va conectado— las escribe la
      // vuelta de Flota viva cada 5 min. Si esa se para, el mapa sigue
      // pareciendo vivo y acusa de "rueda sin nadie" a quien está trabajando.
      if (f.boltHace != null && !f.boltFiable) {
        const av = $('#m-error');
        av.innerHTML = '<i class="fa-solid fa-triangle-exclamation mr-1"></i>'
          + '<b>Lo de BOLT es de hace ' + hace(f.boltHace) + '.</b> Los puntos están al día, '
          + 'pero quién va conectado no: los «rueda sin nadie» de ahora no son de fiar.';
        av.classList.remove('hidden');
      } else if (f.hace != null && f.hace > 180) {
        const av = $('#m-error');
        av.innerHTML = '<i class="fa-solid fa-clock-rotate-left mr-1"></i>'
          + 'La posición no se refresca desde hace ' + hace(f.hace)
          + '. Esto es lo último que se guardó, no dónde están ahora.';
        av.classList.remove('hidden');
      }
    } catch (e) {
      if (mio !== seq) return;
      // El error se pinta EN la pantalla, no en un aviso que hay que cerrar:
      // esto se refresca solo cada treinta segundos y un modal por cada fallo
      // de red sería imposible de usar.
      const av = $('#m-error');
      av.innerHTML = '<i class="fa-solid fa-triangle-exclamation mr-1"></i>'
        + esc(e.message) + ' · lo vuelve a intentar en 30 s';
      av.classList.remove('hidden');
    }
  }

  // ── Enganches ────────────────────────────────────────────────────────────
  $('#m-chips').addEventListener('click', e => {
    const b = e.target.closest('button[data-tono]');
    if (!b) return;
    filtro = filtro === b.dataset.tono ? null : b.dataset.tono;
    pintarChips(DATOS.reduce((a, c) => { a[c.tono] = (a[c.tono] || 0) + 1; return a; }, {}));
    pintarLista();
    pintar();
  });

  $('#m-lista').addEventListener('click', e => {
    const b = e.target.closest('button[data-clave]');
    if (!b) return;
    const m = marcas.get(b.dataset.clave);
    if (!m) {
      // Sin punto en el mapa: no hay adonde volar. Se dice que le pasa.
      const c = DATOS.find(x => x.clave === b.dataset.clave);
      if (c && c.tono === 'sinmapon') {
        Dialogo.aviso({ titulo: c.matricula + ' · sin nada en Mapon', tono: 'error',
          texto: (c.motivo || 'Mapon no da nada de este coche') + '. En la casa figura como «'
            + (c.estadoVehiculo || 'sin estado') + '». Hay que mirar su equipo con el taller.' });
      }
      return;
    }
    mapa.flyTo({ center: m.marker.getLngLat(), zoom: Math.max(mapa.getZoom(), 14), duration: 700 });
    m.marker.togglePopup();
  });

  $('#m-recargar').addEventListener('click', () => cargar(true));

  // El buscador filtra al escribir, y Intro vuela al primero que tenga punto.
  $('#m-buscar').addEventListener('input', e => {
    busca = e.target.value.trim();
    pintarLista();
    pintar();
  });
  $('#m-buscar').addEventListener('keydown', e => {
    if (e.key !== 'Enter') return;
    e.preventDefault();
    const c = DATOS.filter(visible)
      .sort((a, b) => ORDEN.indexOf(a.tono) - ORDEN.indexOf(b.tono))
      .find(x => marcas.has(x.clave));
    if (!c) return;
    const m = marcas.get(c.clave);
    mapa.flyTo({ center: m.marker.getLngLat(), zoom: Math.max(mapa.getZoom(), 14), duration: 700 });
    if (!m.marker.getPopup().isOpen()) m.marker.togglePopup();
  });

  arrancar();
  cargar(false);
  // Cada 30 s, igual que la vuelta que pide a Mapon. Más a menudo sería pedir
  // lo mismo: el equipo del coche habla cada minuto aproximadamente.
  // Cada 10 s, que es lo que tarda en entrar un cambio de BOLT (ver
  // `estadosAlDia`). Preguntar mas a menudo no traeria nada nuevo; y el "hace
  // X s" corre solo entre medias.
  setInterval(() => { if (!document.hidden) cargar(false); }, 10000);
  // Al volver a la pestaña, el dato puede llevar rato parado. Se refresca al
  // momento en vez de esperar hasta treinta segundos con algo viejo delante.
  document.addEventListener('visibilitychange', () => { if (!document.hidden) cargar(false); });
})();
</script>
