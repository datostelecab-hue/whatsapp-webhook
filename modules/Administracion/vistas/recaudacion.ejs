<%
  // UNA PANTALLA POR SEDE (05/11/2026). Madrid no pasa nada de esto; Barcelona
  // (modules/Barcelona/recaudacion.controller.js) pasa su base, su nombre y que
  // la gente es su cuenta de BOLT (soloCuentas).
  const BASE = (typeof base !== 'undefined' && base) ? base : '/recaudacion';
  const SEDE_NOMBRE = (typeof sedeNombre !== 'undefined' && sedeNombre) ? sedeNombre : '';
  const SOLO_CUENTAS = (typeof soloCuentas !== 'undefined') && !!soloCuentas;
%>
<div class="p-4 lg:p-6 max-w-[1400px] mx-auto">

  <!-- ── Cabecera ─────────────────────────────────────────────────────── -->
  <div class="flex flex-wrap items-end justify-between gap-3 mb-4">
    <div>
      <h1 class="text-2xl font-bold text-telecab-text flex items-center gap-2">
        <i class="fa-solid fa-money-bill-wave text-telecab-gold"></i> Recaudación<%= SEDE_NOMBRE ? ' · ' + SEDE_NOMBRE : '' %>
      </h1>
      <p class="text-sm text-telecab-muted mt-1">
        El efectivo que cobran en la calle, acumulado. <b>Total en BOLT</b> es todo lo que ha cobrado en mano;
        <b>total en mano</b>, lo que ya ha entregado en ventanilla; y lo que queda es lo que hay que pedirle.
      </p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <button id="r-nuevo" class="px-3 py-2 rounded-lg bg-telecab-gold text-telecab-dark text-sm font-semibold">
        <i class="fa-solid fa-receipt mr-1"></i> Nuevo ingreso
      </button>
      <% if (puedeNomina) { %>
      <button id="r-nomina" class="px-3 py-2 rounded-lg bg-telecab-card border border-telecab-border text-sm text-telecab-muted hover:text-telecab-text">
        <i class="fa-solid fa-file-invoice-dollar mr-1"></i> Descuento de nómina
      </button>
      <% } %>
      <button id="r-cambio" class="px-3 py-2 rounded-lg bg-telecab-card border border-telecab-border text-sm text-telecab-muted hover:text-telecab-text"
              title="El dinero que se le da para que tenga cambio. Sale de la caja y él lo debe">
        <i class="fa-solid fa-hand-holding-dollar mr-1"></i> Añadir cambio
      </button>
      <button id="r-salida" class="px-3 py-2 rounded-lg bg-telecab-card border border-telecab-border text-sm text-telecab-muted hover:text-telecab-text">
        <i class="fa-solid fa-arrow-right-from-bracket mr-1"></i> Salida de caja
      </button>
      <button id="r-cuadra" class="px-3 py-2 rounded-lg bg-telecab-card border border-telecab-border text-sm text-telecab-muted hover:text-telecab-text"
              title="Comprueba que la tabla, la caja y lo que dice BOLT cuentan lo mismo. No toca nada.">
        <i class="fa-solid fa-scale-balanced mr-1"></i> ¿Cuadra?
      </button>
      <button id="r-calcular" class="px-3 py-2 rounded-lg bg-telecab-card border border-telecab-border text-sm text-telecab-muted hover:text-telecab-text">
        <i class="fa-solid fa-rotate mr-1"></i> Recalcular desde BOLT
      </button>
      <% if (!SOLO_CUENTAS) { %>
      <button id="r-cierre" class="px-3 py-2 rounded-lg bg-telecab-card border border-telecab-border text-sm text-telecab-muted hover:text-telecab-text" title="Meter las cifras a mano, para un histórico viejo o una hoja de fuera">
        <i class="fa-solid fa-file-import mr-1"></i> Pegar a mano
      </button>
      <% } %>
    </div>
  </div>

  <!-- ── El cuadre de caja: las dos cifras que se miran al abrir ──────── -->
  <div class="grid sm:grid-cols-2 gap-3 mb-5">
    <div class="bg-telecab-card border-2 border-telecab-green/40 rounded-2xl p-4">
      <div class="flex items-start justify-between gap-2">
        <p class="text-xs text-telecab-muted uppercase tracking-wide">Efectivo actual</p>
        <!-- El conductor viene a entregar y se planta delante de esta cifra. -->
        <button class="tc-ojo shrink-0" data-ojo="caja" data-ojo-que="el dinero de la caja"
                aria-pressed="false" aria-controls="c-efectivo">
          <i class="fa-regular fa-eye tc-ojo-ver" aria-hidden="true"></i>
          <i class="fa-regular fa-eye-slash tc-ojo-tapar" aria-hidden="true"></i>
          <span class="sr-only">Tapar o destapar el dinero de la caja</span>
        </button>
      </div>
      <p id="c-efectivo" class="tc-secreto text-3xl font-bold mt-1 text-telecab-green tabular-nums" data-secreto="caja">—</p>
      <p id="c-efectivo-det" class="tc-secreto text-[11px] text-telecab-muted mt-1" data-secreto="caja"></p>
    </div>
    <div class="bg-telecab-card border-2 border-telecab-red/40 rounded-2xl p-4">
      <p class="text-xs text-telecab-muted uppercase tracking-wide">Pendiente de cobro</p>
      <p id="c-pendiente" class="text-3xl font-bold mt-1 text-telecab-red tabular-nums">—</p>
      <p id="c-pendiente-det" class="text-[11px] text-telecab-muted mt-1"></p>
    </div>
  </div>

  <!-- ── El resumen: las mismas tres cifras que la tabla, sumadas ────── -->
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-4">
    <div class="bg-telecab-card border border-telecab-border rounded-2xl p-3">
      <div class="flex items-start justify-between gap-2">
        <p class="text-xs text-telecab-muted uppercase tracking-wide">Total en mano</p>
        <!-- Ojo propio: se puede querer enseñar lo recaudado sin enseñar lo que
             queda en el cajón, o al revés. Cada uno recuerda su estado. -->
        <button class="tc-ojo shrink-0" data-ojo="mano" data-ojo-que="lo recaudado en mano"
                data-ojo-tam="1.7rem" aria-pressed="false" aria-controls="t-enmano">
          <i class="fa-regular fa-eye tc-ojo-ver" aria-hidden="true"></i>
          <i class="fa-regular fa-eye-slash tc-ojo-tapar" aria-hidden="true"></i>
          <span class="sr-only">Tapar o destapar lo recaudado en mano</span>
        </button>
      </div>
      <p id="t-enmano" class="tc-secreto text-xl font-bold mt-1 text-telecab-green tabular-nums" data-secreto="mano">—</p>
      <p id="t-enmano-det" class="tc-secreto text-[11px] text-telecab-muted mt-0.5" data-secreto="mano"></p>
    </div>
    <div class="bg-telecab-card border border-telecab-border rounded-2xl p-3">
      <p class="text-xs text-telecab-muted uppercase tracking-wide">Total recaudado en BOLT</p>
      <p id="t-bolt" class="text-xl font-bold mt-1 tabular-nums">—</p>
      <p id="t-bolt-det" class="text-[11px] text-telecab-muted mt-0.5"></p>
    </div>
    <div class="bg-telecab-card border border-telecab-red/40 rounded-2xl p-3">
      <p class="text-xs text-telecab-muted uppercase tracking-wide">Total a recaudar</p>
      <p class="mt-1 leading-none"><span id="t-arecaudar" class="text-xl font-bold text-telecab-red tabular-nums">—</span>
        <span id="t-condeuda" class="text-xs text-telecab-muted font-semibold"></span></p>
    </div>
  </div>

  <!-- ── Panel: el recibo / el descuento / el cierre ──────────────────── -->
  <div id="r-panel" class="hidden mb-4"></div>

  <!-- ── Filtros del cuadro ───────────────────────────────────────────── -->
  <div class="flex flex-wrap items-center gap-2 mb-3">
    <div class="relative flex-1 min-w-[220px]">
      <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-telecab-muted text-xs"></i>
      <input id="f-busca" type="search" aria-label="Buscar conductor" placeholder="Buscar conductor…"
        class="w-full pl-9 pr-3 py-2 rounded-lg bg-telecab-dark border border-telecab-border text-sm text-telecab-text">
    </div>
    <select id="f-estado" aria-label="Estado de la cuenta" class="px-3 py-2 rounded-lg bg-telecab-dark border border-telecab-border text-sm text-telecab-text">
      <option value="deuda">Solo los que deben</option>
      <option value="">Todos</option>
      <option value="dia">Al día</option>
      <option value="favor">A su favor</option>
      <% if (!SOLO_CUENTAS) { %><option value="sinficha">Sin ficha en la plantilla</option><% } %>
      <option value="efectivo">Con el efectivo activado en BOLT</option>
      <option value="efectivofuera"><%= SOLO_CUENTAS ? 'Efectivo activado y la cuenta desactivada' : 'Efectivo activado y ya no trabaja aquí' %></option>
    </select>
    <select id="f-dias" aria-label="Días sin pasar por ventanilla" class="px-3 py-2 rounded-lg bg-telecab-dark border border-telecab-border text-sm text-telecab-text"
      title="Cuánto hace que no pasa por ventanilla. Solo mira a quien debe algo: el que está al día y no viene es que no tiene nada que traer">
      <option value="">Venga cuando venga</option>
      <option value="3">+3 días sin entregar</option>
      <option value="7">+7 días sin entregar</option>
      <option value="14">+14 días sin entregar</option>
      <option value="30">+30 días sin entregar</option>
      <option value="nunca">No ha entregado nunca</option>
    </select>
    <select id="f-plantilla" aria-label="<%= SOLO_CUENTAS ? 'Cuenta activa o desactivada' : 'En plantilla o fuera' %>" class="px-3 py-2 rounded-lg bg-telecab-dark border border-telecab-border text-sm text-telecab-text">
      <% if (SOLO_CUENTAS) { %>
      <option value="">Cuentas activas y desactivadas</option>
      <option value="si">Solo cuentas activas</option>
      <option value="no">Solo cuentas desactivadas</option>
      <% } else { %>
      <option value="">En plantilla y fuera</option>
      <option value="si">Solo en plantilla</option>
      <option value="no">Solo los que ya no están</option>
      <% } %>
    </select>
    <span id="f-cuenta" class="text-xs text-telecab-muted ml-auto"></span>
  </div>
  <p id="t-efectivo" class="text-xs text-telecab-muted mb-3"></p>

  <!-- ── El cuadro, o la ficha de uno ─────────────────────────────────── -->
  <div id="r-ficha" class="hidden mb-4"></div>
  <div id="r-cuadro" class="bg-telecab-card border border-telecab-border rounded-2xl overflow-hidden">
    <p class="px-4 py-10 text-center text-sm text-telecab-muted">Cargando…</p>
  </div>

  <!-- ── Lo que salió de la caja en esta quincena ─────────────────────── -->
  <div id="r-salidas" class="mt-4"></div>
</div>

<script type="application/json" id="datos-servidor"><%- json({ denominaciones: denominaciones || [], tiposMovimiento: tiposMovimiento || [], salidasCaja: salidasCaja || [], etiquetasSalida: etiquetasSalida || salidasCaja || [], puedeNomina: !!(puedeNomina), base: BASE, soloCuentas: SOLO_CUENTAS, sedeNombre: SEDE_NOMBRE }) %></script>
<script src="<%= est('/assets/js/vistas/Administracion/recaudacion.js') %>"></script>
