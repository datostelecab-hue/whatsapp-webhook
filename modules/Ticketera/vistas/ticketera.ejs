<div class="p-4 lg:p-6 max-w-6xl mx-auto space-y-5">

  <div class="flex items-start justify-between gap-3 flex-wrap">
    <div class="min-w-0">
      <h1 class="text-lg font-semibold text-telecab-text flex items-center gap-2">
        <i class="fa-solid fa-ticket text-telecab-gold"></i> <%= titulo %>
      </h1>
      <p class="text-xs text-telecab-muted mt-0.5"><%= subtitulo || 'Lo que piden los conductores por el formulario. Al aplicarlo, la ausencia se abre en la ficha de la persona.' %></p>
      <%# Solo lo pedido desde el corte (25/09/2026): se dice desde cuándo, para
          que nadie busque un ticket anterior y crea que se ha perdido. %>
      <p id="nota-mes" class="hidden text-[11px] text-telecab-gold mt-1"></p>
    </div>
    <div class="flex items-center gap-2 shrink-0">
      <label class="text-xs text-telecab-muted flex items-center gap-1.5 cursor-pointer">
        <input type="checkbox" id="f-cerrados" class="accent-telecab-gold"> ver cerrados
      </label>
      <!-- El botón de "Traer del formulario" ya no está: lo hace un cron cada
           dos horas. Un botón que hay que acordarse de pulsar convierte una
           petición en algo que llega cuando alguien se acuerda. -->
      <button id="btn-recargar" class="text-xs px-3 py-1.5 rounded-lg border border-telecab-border text-telecab-muted hover:border-telecab-gold transition">
        <i class="fa-solid fa-rotate mr-1"></i> Recargar
      </button>
    </div>
  </div>

  <p id="msg" class="hidden text-sm rounded-xl px-4 py-3"></p>

  <div id="resumen" class="grid grid-cols-2 sm:grid-cols-4 gap-3"></div>

  <!-- Los filtros. Con doscientos setenta abiertos, la lista sin filtrar no es
       una bandeja: es un muro. -->
  <div class="bg-telecab-card border border-telecab-border rounded-2xl p-3 flex flex-wrap items-end gap-3">
    <div class="flex-1 min-w-[220px]">
      <label class="block text-[11px] text-telecab-muted mb-1" for="f-busca">Conductor, DNI, teléfono o código</label>
      <input id="f-busca" type="search" placeholder="Soufyane, 12345678Z, RH-2026…"
        class="w-full px-3 py-2 bg-telecab-card2 border border-telecab-border rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-telecab-gold/40">
    </div>
    <!-- `js-fecha`: el calendario de la casa (vive en layout-gestion). Trabaja en
         dd/mm/aaaa y se puede teclear o elegir. NADA de `type="date"`: ese pinta
         el calendario del sistema operativo, que en una pantalla oscura canta
         como de otra aplicación. -->
    <div>
      <label class="block text-[11px] text-telecab-muted mb-1" for="f-desde">Desde</label>
      <input id="f-desde" class="js-fecha w-32 px-3 py-2 bg-telecab-card2 border border-telecab-border rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-telecab-gold/40"
        placeholder="dd/mm/aaaa" readonly>
    </div>
    <div>
      <label class="block text-[11px] text-telecab-muted mb-1" for="f-hasta">Hasta</label>
      <input id="f-hasta" class="js-fecha w-32 px-3 py-2 bg-telecab-card2 border border-telecab-border rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-telecab-gold/40"
        placeholder="dd/mm/aaaa" readonly>
    </div>
    <div>
      <label class="block text-[11px] text-telecab-muted mb-1" for="f-subtipo">Tipo</label>
      <select id="f-subtipo"
        class="px-3 py-2 bg-telecab-card2 border border-telecab-border rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-telecab-gold/40">
        <option value="">Todos</option>
      </select>
    </div>
    <button id="f-limpiar" class="px-3 py-2 rounded-xl border border-telecab-border text-xs text-telecab-muted hover:border-telecab-gold transition">
      Limpiar
    </button>
    <p id="f-cuenta" class="text-[11px] text-telecab-muted w-full"></p>
  </div>

  <div id="lista" class="space-y-2">
    <p class="text-telecab-muted text-sm">Cargando…</p>
  </div>
</div>

<script type="application/json" id="datos-servidor"><%- json({ base: base, partes: typeof partes !== 'undefined' ? partes : [], yo: yo || '', vacaciones: typeof vacaciones !== 'undefined' && vacaciones ? vacaciones : { puede: false, quien: null } }) %></script>
<script src="<%= est('/assets/js/vistas/Ticketera/ticketera.js') %>"></script>
