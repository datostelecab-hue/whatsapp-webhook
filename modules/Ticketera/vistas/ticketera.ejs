<div class="p-4 lg:p-6 max-w-6xl mx-auto space-y-5">

  <div class="flex items-start justify-between gap-3 flex-wrap">
    <div class="min-w-0">
      <h1 class="text-lg font-semibold text-telecab-text flex items-center gap-2">
        <i class="fa-solid fa-ticket text-telecab-gold"></i> <%= titulo %>
      </h1>
      <p class="text-xs text-telecab-muted mt-0.5"><%= subtitulo || 'Lo que piden los conductores por el formulario. Al aplicarlo, la ausencia se abre en la ficha de la persona.' %></p>
    </div>
    <div class="flex items-center gap-2 shrink-0">
      <label class="text-xs text-telecab-muted flex items-center gap-1.5 cursor-pointer">
        <input type="checkbox" id="f-cerrados" class="accent-telecab-gold"> ver cerrados
      </label>
      <button id="btn-traer" class="text-xs px-3 py-1.5 rounded-lg border border-telecab-border text-telecab-muted hover:border-telecab-gold transition">
        <i class="fa-solid fa-inbox mr-1"></i> Traer del formulario
      </button>
      <button id="btn-recargar" class="text-xs px-3 py-1.5 rounded-lg border border-telecab-border text-telecab-muted hover:border-telecab-gold transition">
        <i class="fa-solid fa-rotate mr-1"></i> Recargar
      </button>
    </div>
  </div>

  <p id="msg" class="hidden text-sm rounded-xl px-4 py-3"></p>

  <div id="resumen" class="grid grid-cols-2 sm:grid-cols-4 gap-3"></div>

  <div id="lista" class="space-y-2">
    <p class="text-telecab-muted text-sm">Cargando…</p>
  </div>
</div>

<script>
(function () {
  const $ = s => document.querySelector(s);
  const esc = s => String(s == null ? '' : s).replace(/[&<>"]/g,
    c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
  const BASE = <%- JSON.stringify(base) %>;
  const YO   = <%- JSON.stringify(yo || '') %>;

  let TICKETS = [], SUBTIPOS = [], ESTADOS = [], PERSONAS = null;

  const aviso = (t, tipo) => {
    const m = $('#msg');
    if (!t) { m.classList.add('hidden'); return; }
    const tono = tipo === 'error' ? 'red' : tipo === 'ok' ? 'green' : 'gold';
    m.className = `text-sm rounded-xl px-4 py-3 border border-telecab-${tono}/40 bg-telecab-${tono}/5 text-telecab-${tono}`;
    m.textContent = t;
  };

  async function api(url, body) {
    const r = await fetch(BASE + url, {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body || {})
    });
    return r.json();
  }

  // ── Pintar ────────────────────────────────────────────────────────────────

  function pintarResumen() {
    const abiertos = TICKETS.filter(t => !t.cerrado);
    const sinDuenio = abiertos.filter(t => !t.responsable).length;
    const sinPersona = abiertos.filter(t => !t.conductorId).length;
    // La media de lo que llevan esperando dice más que el total: veinte tickets
    // de hoy no son lo mismo que cinco de hace tres semanas.
    const espera = abiertos.length
      ? (abiertos.reduce((s, t) => s + (t.horas || 0), 0) / abiertos.length / 24).toFixed(1)
      : '0';
    const caja = (et, v, tono) => `
      <div class="bg-telecab-card border border-telecab-border rounded-xl p-3">
        <p class="text-[11px] text-telecab-muted uppercase tracking-wide">${et}</p>
        <p class="text-xl font-bold text-telecab-${tono}">${v}</p>
      </div>`;
    $('#resumen').innerHTML =
      caja('Abiertos', abiertos.length, abiertos.length ? 'gold' : 'green') +
      caja('Sin dueño', sinDuenio, sinDuenio ? 'warn' : 'green') +
      caja('Sin identificar', sinPersona, sinPersona ? 'red' : 'green') +
      caja('Espera media', espera + ' d', 'text');
  }

  function tarjeta(t) {
    const el = document.createElement('div');
    el.className = 'bg-telecab-card border border-telecab-border rounded-2xl p-4' +
      (t.cerrado ? ' opacity-60' : '');

    const dias = t.horas != null ? (t.horas / 24).toFixed(1) + ' d' : '';
    // Un ticket sin persona enlazada es el que no se puede aplicar, así que se
    // señala arriba y no escondido en un detalle.
    const sinPersona = !t.conductorId
      ? `<span class="px-2 py-0.5 rounded-lg text-[11px] bg-telecab-red/15 text-telecab-red border border-telecab-red/30">sin identificar</span>` : '';

    el.innerHTML = `
      <div class="flex items-start gap-3 flex-wrap">
        <div class="min-w-0 flex-1">
          <p class="flex items-center gap-2 flex-wrap">
            <span class="font-mono text-xs text-telecab-muted">${esc(t.codigo)}</span>
            <span class="px-2 py-0.5 rounded-lg text-[11px] border"
                  style="color:${t.color};border-color:${t.color}55;background:${t.color}15">${esc(t.estadoEtiqueta)}</span>
            ${sinPersona}
            ${t.prioridad ? `<span class="text-[11px] text-telecab-warn">${esc(t.prioridad)}</span>` : ''}
          </p>
          <p class="text-sm font-semibold text-telecab-text mt-1">${esc(t.subtipo)} · ${esc(t.quien)}</p>
          <p class="text-[11px] text-telecab-muted">${esc(t.gestion || '')}</p>
        </div>
        <div class="text-right text-[11px] text-telecab-muted shrink-0">
          <p>${esc(t.pedido || t.creado)}</p>
          <p>${t.cerrado ? 'tardó' : 'lleva'} ${dias}</p>
          ${t.responsable ? `<p class="text-telecab-text">${esc(t.responsable)}</p>` : ''}
        </div>
      </div>

      ${(t.fechaIni || t.matricula) ? `
        <p class="text-xs text-telecab-text mt-2">
          ${t.fechaIni ? `<i class="fa-solid fa-calendar-days text-telecab-muted mr-1"></i>${esc(t.fechaIni)}${t.fechaFin ? ' → ' + esc(t.fechaFin) : ''}` : ''}
          ${t.matricula ? `<span class="ml-3"><i class="fa-solid fa-car text-telecab-muted mr-1"></i>${esc(t.matricula)}</span>` : ''}
        </p>` : ''}

      ${t.descripcion ? `
        <details class="mt-2">
          <summary class="cursor-pointer text-xs text-telecab-muted">Lo que escribió</summary>
          <pre class="mt-1 text-xs text-telecab-text whitespace-pre-wrap font-sans bg-telecab-dark/30 rounded-lg p-2">${esc(t.descripcion)}</pre>
        </details>` : ''}

      ${t.resolucion ? `<p class="text-xs text-telecab-green mt-2"><i class="fa-solid fa-check mr-1"></i>${esc(t.resolucion)}</p>` : ''}

      <div class="acciones mt-3 flex flex-wrap items-center gap-2"></div>`;

    const acc = el.querySelector('.acciones');
    const boton = (txt, icono, tono, fn) => {
      const b = document.createElement('button');
      b.className = `px-3 py-1.5 rounded-lg text-xs border border-telecab-${tono}/40 bg-telecab-${tono}/10 text-telecab-${tono} hover:bg-telecab-${tono}/20 transition`;
      b.innerHTML = `<i class="fa-solid ${icono} mr-1"></i>${txt}`;
      b.addEventListener('click', fn);
      acc.appendChild(b);
      return b;
    };

    if (!t.cerrado) {
      if (!t.responsable) {
        boton('Me lo quedo', 'fa-hand', 'gold', async () => {
          const r = await api('/asignar', { id: t.id, responsable: YO });
          r.status === 'ok' ? cargar() : aviso(r.msg, 'error');
        });
      }

      if (!t.conductorId) {
        boton('Enlazar persona', 'fa-link', 'red', () => enlazar(t));
      }

      if (t.afectaPlanning && t.conductorId) {
        boton('Aplicar', 'fa-wand-magic-sparkles', 'green', async () => {
          const desde = prompt('Desde (aaaa-mm-dd):', t.fechaIniIso || '');
          if (desde === null) return;
          const hasta = prompt('Hasta (aaaa-mm-dd, vacío si no tiene):', t.fechaFinIso || '');
          if (hasta === null) return;
          const r = await api('/aplicar', { id: t.id, desde, hasta });
          if (r.status === 'ok') { aviso('Aplicado: la ausencia ya está en su ficha.', 'ok'); cargar(); }
          else aviso(r.msg, 'error');
        });
      }

      boton('Resolver', 'fa-flag-checkered', 'green', () => resolver(t));
      boton('Mover', 'fa-arrows-turn-to-dots', 'text', () => mover(t));
    }

    boton('Historia', 'fa-clock-rotate-left', 'text', async () => {
      const r = await (await fetch(`${BASE}/api/ticket/${t.id}`)).json();
      if (r.status !== 'ok') return aviso(r.msg, 'error');
      alert(r.historia.map(h =>
        `${h.cuando} · ${h.quien || '—'} · ${h.estado_antes || '—'} → ${h.estado_despues || '—'}` +
        (h.nota ? `\n   ${h.nota}` : '')).join('\n\n') || 'Sin apuntes.');
    });

    return el;
  }

  // ── Acciones que necesitan preguntar algo ────────────────────────────────

  async function enlazar(t) {
    if (!PERSONAS) {
      const r = await (await fetch(BASE + '/api/personas')).json();
      PERSONAS = r.personas || [];
    }
    const pista = prompt(
      `¿Quién es? Escribió «${t.escribio || '—'}»${t.dni ? ', DNI ' + t.dni : ''}${t.telefono ? ', tel ' + t.telefono : ''}.\n\n` +
      'Escribe parte del nombre o el DNI:');
    if (!pista) return;
    const p = pista.trim().toLowerCase();
    const hallados = PERSONAS.filter(x =>
      x.nombre.toLowerCase().includes(p) || (x.dni || '').toLowerCase().includes(p));
    if (!hallados.length) return aviso('No encuentro a nadie así.', 'error');
    if (hallados.length > 1) {
      const lista = hallados.slice(0, 12).map((x, i) =>
        `${i + 1}. ${x.nombre}${x.vigente ? '' : ' (ya no está)'}`).join('\n');
      const n = prompt(`Hay ${hallados.length}:\n\n${lista}\n\n¿Cuál? (número)`);
      const i = Number(n) - 1;
      if (!(i >= 0 && i < hallados.length)) return;
      hallados.splice(0, hallados.length, hallados[i]);
    }
    const r = await api('/enlazar', { id: t.id, conductorId: hallados[0].id });
    r.status === 'ok' ? cargar() : aviso(r.msg, 'error');
  }

  async function resolver(t) {
    const cierres = ESTADOS.filter(e => e.cierra);
    const lista = cierres.map((e, i) => `${i + 1}. ${e.etiqueta}`).join('\n');
    const n = prompt(`¿Cómo queda?\n\n${lista}\n\n(número)`);
    const i = Number(n) - 1;
    if (!(i >= 0 && i < cierres.length)) return;
    const resolucion = prompt('¿En qué quedó? (se guarda con el ticket)');
    if (resolucion === null) return;
    const r = await api('/estado', { id: t.id, estado: cierres[i].codigo, resolucion });
    r.status === 'ok' ? cargar() : aviso(r.msg, 'error');
  }

  async function mover(t) {
    const lista = SUBTIPOS.map((s, i) => `${i + 1}. ${s.etiqueta} (${s.area_codigo})`).join('\n');
    const n = prompt(`¿A qué bandeja?\n\n${lista}\n\n(número)`);
    const i = Number(n) - 1;
    if (!(i >= 0 && i < SUBTIPOS.length)) return;
    const r = await api('/reclasificar', { id: t.id, subtipo: SUBTIPOS[i].codigo });
    if (r.status === 'ok') { aviso(`Movido a ${r.ticket.area}.`, 'ok'); cargar(); }
    else aviso(r.msg, 'error');
  }

  // ── Carga ────────────────────────────────────────────────────────────────

  async function cargar() {
    const cerrados = $('#f-cerrados').checked ? '1' : '0';
    const r = await (await fetch(`${BASE}/api/datos?cerrados=${cerrados}`)).json();
    if (r.status !== 'ok') return aviso(r.msg, 'error');
    TICKETS = r.tickets || []; SUBTIPOS = r.subtipos || []; ESTADOS = r.estados || [];
    pintarResumen();
    const cont = $('#lista');
    cont.innerHTML = '';
    if (!TICKETS.length) {
      cont.innerHTML = '<p class="text-telecab-muted text-sm">No hay tickets aquí.</p>';
      return;
    }
    TICKETS.forEach(t => cont.appendChild(tarjeta(t)));
  }

  $('#btn-recargar').addEventListener('click', cargar);
  $('#f-cerrados').addEventListener('change', cargar);
  $('#btn-traer').addEventListener('click', async () => {
    aviso('Leyendo el formulario…');
    const r = await api('/sincronizar');
    if (r.status !== 'ok') return aviso(r.msg, 'error');
    // Los fallos se dicen ENTEROS, con su fila: una respuesta que no entra es
    // una persona esperando una contestación que no va a llegar.
    const fallos = r.fallos || [];
    aviso(`${r.nuevas} nuevo(s), ${r.repetidas} ya estaban, ${r.sinIdentificar} sin identificar.` +
      (fallos.length ? `  ⚠ ${fallos.length} fila(s) NO entraron: ` +
        fallos.map(f => `${f.fila} (${f.quien}) — ${f.motivo}`).join(' · ') : ''),
      fallos.length ? 'error' : (r.nuevas ? 'ok' : null));
    cargar();
  });

  cargar();
})();
</script>
