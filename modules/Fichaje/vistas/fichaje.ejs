<style>
  /* El botón grande. Es lo único que hace la gente aquí, así que ocupa lo que
     tiene que ocupar y se pulsa bien con el pulgar en un móvil. */
  /* Liso, como todos los botones de la casa (27/09/2026): el color ya dice si
     es entrar (verde) o salir (el acento). */
  .fi-boton { width: 100%; padding: 1.4rem 1rem; border: 0; border-radius: .75rem; cursor: pointer;
    font-weight: 700; font-size: 1.15rem; color: rgb(var(--tc-dark));
    display: flex; align-items: center; justify-content: center; gap: .65rem;
    transition: filter .15s ease; }
  .fi-boton:hover { filter: brightness(.94); }
  .fi-boton[disabled] { opacity: .6; cursor: progress; }
  .fi-entrar { background: rgb(var(--tc-green)); }
  .fi-salir  { background: rgb(var(--tc-gold)); color: rgb(var(--tc-on-gold)); }

  /* El cronómetro. Tabular para que no baile al cambiar de minuto. */
  .fi-reloj { font-size: clamp(2.6rem, 9vw, 4rem); font-weight: 600; letter-spacing: -.02em;
    line-height: 1; font-variant-numeric: tabular-nums; }

  /* Las filas son dos maquetas distintas porque son dos cosas distintas: en MI
     mes la primera columna es la fecha; en el parte, la persona. Copiar la
     misma rejilla para las dos dejaba el nombre repetido dos veces. */
  .fi-fila { display: grid; gap: .5rem; align-items: center;
    padding: .55rem .7rem; border-radius: .6rem; font-size: .82rem; }
  /* Columnas ESTRECHAS Y FIJAS, y el sobrante al final. Repartir el ancho con
     varios 1fr dejaba las horas nadando a un palmo unas de otras en una
     pantalla grande: se leía peor cuanto mejor era el monitor. */
  .fi-mio   { grid-template-columns: 9rem 5.5rem 5.5rem 5.5rem 1fr; }
  /* El día sin fichaje ("Libra", "sin fichar") ocupa lo que quede: centrado en
     su propio hueco se lee como lo que es, una fila sin datos. */
  .fi-vacio { grid-column: 2 / -1; text-align: center; }
  .fi-parte { grid-template-columns: 13rem 5.5rem 5.5rem 1fr; }
  .fi-pend  { grid-template-columns: 7.5rem 13rem 5.5rem 5.5rem 5.5rem 1fr; }
  /* La semana de todos: el nombre se lleva el sobrante y los siete días van
     en columnas iguales, que es lo que deja comparar una fila con otra. */
  .fi-sem   { grid-template-columns: minmax(9rem, 1fr) repeat(7, 4.6rem) 5.6rem; }
  .fi-sem .fi-dia { text-align: center; font-variant-numeric: tabular-nums; }
  /* El fin de semana, con el fondo más apagado: se libra, y se ve que se libra
     sin tener que leer la cabecera. */
  .fi-sem > .fi-finde { background: rgb(var(--tc-muted) / .05); }
  .fi-pie { border-top: 1px solid rgb(var(--tc-border)); font-weight: 700; }
  .fi-pie:hover { background: none; }
  /* En móvil una matriz de nueve columnas no cabe de ninguna manera: se deja
     rodar a lo ancho en vez de aplastarla. */
  @media (max-width: 860px) {
    .fi-scroll { overflow-x: auto; }
    .fi-scroll > div { min-width: 46rem; }
  }
  /* Las horas, centradas en su columna: son números de la misma anchura y
     alineados se leen de arriba abajo sin buscar. */
  .fi-c { text-align: center; }
  /* La cabecera de la tabla usa la MISMA rejilla que las filas, o no cuadran. */
  .fi-cab { padding-top: 0; padding-bottom: .3rem; font-size: 10px; text-transform: uppercase;
    letter-spacing: .04em; color: rgb(var(--tc-muted)); font-weight: 700; }
  .fi-cab:hover { background: none; }
  .fi-cab + .fi-fila { border-top: 0; }
  /* En un móvil no caben cinco columnas. Se apilan en dos, que es lo que de
     verdad se mira desde el teléfono: quién/cuándo y cuánto. */
  @media (max-width: 640px) {
    .fi-fila { grid-template-columns: 1fr auto; row-gap: .15rem; }
    .fi-fila > :nth-child(1) { grid-column: 1 / -1; font-weight: 600; }
    /* Apilado no hay columnas que encabezar, y centrar deja el texto flotando. */
    .fi-cab { display: none; }
    .fi-c { text-align: left; }
    .fi-vacio { grid-column: 1 / -1; text-align: left; }
  }
  /* La línea que va debajo de una jornada: la corrección pedida o rechazada.
     Pegada a su jornada, sin raya entre las dos: se lee como parte de ella. */
  .fi-nota { padding-top: 0; font-size: .72rem; }
  .fi-nota > .fi-vacio { text-align: left; }
  .fi-fila + .fi-fila.fi-nota { border-top: 0; }
  /* Las correcciones pedidas: quién, qué día, cómo está y qué pide. */
  .fi-corr { grid-template-columns: 11rem 7.5rem 9.5rem minmax(0, 1fr) auto; align-items: start; }
  /* Lo que cambia, en dorado: es lo único que hay que mirar. */
  .fi-cambia { color: rgb(var(--tc-gold)); font-weight: 700; }
  @media (max-width: 640px) {
    .fi-acc { justify-content: flex-start !important; }
  }
  .fi-fila + .fi-fila { border-top: 1px solid rgb(var(--tc-border) / .5); }
  .fi-fila:hover { background: rgb(var(--tc-card2) / .5); }
  .fi-tag { font-size: 10px; font-weight: 700; padding: .1rem .4rem; border-radius: .35rem; }
</style>

<div class="grid grid-cols-1 lg:grid-cols-[22rem_1fr] gap-4">

  <!-- ── Fichar ─────────────────────────────────────────────────────────── -->
  <div class="rounded-2xl border border-telecab-border bg-telecab-card p-5">
    <div id="fi-panel">
      <p class="text-sm text-telecab-muted"><i class="fa-solid fa-circle-notch fa-spin mr-2"></i>Cargando…</p>
    </div>
  </div>

  <!-- ── Mi mes ─────────────────────────────────────────────────────────── -->
  <div class="rounded-2xl border border-telecab-border bg-telecab-card p-5">
    <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
      <div>
        <h2 class="text-sm font-semibold text-telecab-text">Mis jornadas</h2>
        <p class="text-xs text-telecab-muted">Lo que has fichado esta semana. Es tu registro: puedes pedirlo cuando quieras.</p>
        <p id="fi-corr-nota" class="text-xs text-telecab-muted mt-0.5"></p>
      </div>
      <div class="flex items-center gap-1.5">
        <button id="fi-sem-ant" title="Semana anterior"
                class="w-7 h-7 rounded-lg border border-telecab-border text-telecab-muted hover:text-telecab-gold hover:border-telecab-gold/60 transition">
          <i class="fa-solid fa-chevron-left text-xs"></i></button>
        <input id="fi-sem" aria-label="Semana de mis jornadas" class="js-fecha w-28 px-2 py-1.5 rounded-lg bg-telecab-card2/60 border border-telecab-border text-xs text-telecab-text text-center"
               placeholder="dd/mm/aaaa" title="Cualquier día de la semana que quieras ver" readonly>
        <button id="fi-sem-sig" title="Semana siguiente"
                class="w-7 h-7 rounded-lg border border-telecab-border text-telecab-muted hover:text-telecab-gold hover:border-telecab-gold/60 transition">
          <i class="fa-solid fa-chevron-right text-xs"></i></button>
        <span id="fi-total" class="text-sm font-bold text-telecab-gold tabular-nums ml-1">—</span>
      </div>
      <p id="fi-rotulo" class="text-[11px] text-telecab-muted w-full"></p>
      <p id="fi-confirm" class="text-[11px] text-telecab-muted w-full"></p>
    </div>
    <div id="fi-mis-dias" class="text-sm text-telecab-muted">—</div>
  </div>
</div>

<% if (puedeRevisar) { %>
<% if (!puedeAprobar) { %>
<div class="mt-4 px-4 py-2.5 rounded-xl border border-telecab-border bg-telecab-card2/40 text-xs text-telecab-muted">
  <i class="fa-solid fa-eye mr-1.5"></i>Lo ves todo, pero corregir, confirmar horas y aprobar correcciones
  es solo de <b class="text-telecab-text"><%= quienAprueba || 'quien tenga la llave de aprobar' %></b>: la llave la
  tiene una sola persona y no va con el rol.
</div>
<% } %>

<!-- ── Lo que pide corregir cada uno (db/159) ─────────────────── -->
<div class="rounded-2xl border border-telecab-border bg-telecab-card p-5 mt-4">
  <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
    <div>
      <h2 class="text-sm font-semibold text-telecab-text">
        <i class="fa-solid fa-pen-to-square text-telecab-gold mr-1"></i>Correcciones pedidas
        <span id="fi-corr-cuantas" class="ml-1"></span>
      </h2>
      <p class="text-xs text-telecab-muted">
        Lo que cada uno pide cambiar de su fichaje. No cambia nada hasta que se aprueba; al aprobarlo,
        la jornada queda corregida con su motivo y confirmada con tu nombre. Rechazar pide decir por qué.
      </p>
    </div>
  </div>
  <div id="fi-correcciones" class="text-sm text-telecab-muted">—</div>
</div>

<!-- ── Cómo va la gente esta semana ───────────────────────────── -->
<div class="rounded-2xl border border-telecab-border bg-telecab-card p-5 mt-4">
  <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
    <div>
      <h2 class="text-sm font-semibold text-telecab-text">
        <i class="fa-solid fa-table-cells text-telecab-gold mr-1"></i>La semana de todos
      </h2>
      <p class="text-xs text-telecab-muted">
        Lo que lleva cada uno, día a día, y el total de la semana. En ámbar, lo que
        aún no ha confirmado nadie.
      </p>
    </div>
    <div class="flex items-center gap-1.5">
      <button id="fi-tsem-ant" title="Semana anterior"
              class="w-7 h-7 rounded-lg border border-telecab-border text-telecab-muted hover:text-telecab-gold hover:border-telecab-gold/60 transition">
        <i class="fa-solid fa-chevron-left text-xs"></i></button>
      <input id="fi-tsem" aria-label="Semana de todos" class="js-fecha w-28 px-2 py-1.5 rounded-lg bg-telecab-card2/60 border border-telecab-border text-xs text-telecab-text text-center"
             placeholder="dd/mm/aaaa" title="Cualquier día de la semana que quieras ver" readonly>
      <button id="fi-tsem-sig" title="Semana siguiente"
              class="w-7 h-7 rounded-lg border border-telecab-border text-telecab-muted hover:text-telecab-gold hover:border-telecab-gold/60 transition">
        <i class="fa-solid fa-chevron-right text-xs"></i></button>
    </div>
    <p id="fi-tsem-rotulo" class="text-[11px] text-telecab-muted w-full"></p>
  </div>
  <div class="fi-scroll"><div id="fi-tabla-sem" class="text-sm text-telecab-muted">—</div></div>
</div>

<!-- La cola: horas que nadie ha dado por buenas todavía -->
<div class="rounded-2xl border border-telecab-border bg-telecab-card p-5 mt-4">
  <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
    <div>
      <h2 class="text-sm font-semibold text-telecab-text">
        <i class="fa-solid fa-stamp text-telecab-gold mr-1"></i>Horas por confirmar
      </h2>
      <p class="text-xs text-telecab-muted">
        Una jornada cerrada no cuenta hasta que alguien la da por buena. Lo que no cuadre,
        se corrige antes —queda con tu nombre y el motivo— y después se confirma.
      </p>
    </div>
    <% if (puedeAprobar) { %>
    <button id="fi-aprobar-todo"
            class="text-xs px-3 py-2 rounded-lg bg-telecab-gold text-telecab-dark font-semibold disabled:opacity-40">
      <i class="fa-solid fa-check-double mr-1"></i>Confirmar las que se ven
    </button>
    <% } %>
  </div>
  <div id="fi-pendientes" class="text-sm text-telecab-muted">—</div>
</div>

<!-- ── El registro, solo para quien puede corregirlo ────────────────────── -->
<div class="rounded-2xl border border-telecab-border bg-telecab-card p-5 mt-4">
  <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
    <div>
      <h2 class="text-sm font-semibold text-telecab-text">
        <i class="fa-solid fa-user-shield text-telecab-gold mr-1"></i>El registro de todos
      </h2>
      <p class="text-xs text-telecab-muted">
        Quién fichó y quién no, día a día. Corregir queda con tu nombre, el motivo y la hora
        original al lado: un registro que se edita sin rastro no vale ante Inspección.
      </p>
    </div>
    <input id="fi-dia" aria-label="Día del registro" class="js-fecha w-28 px-2 py-1.5 rounded-lg bg-telecab-card2/60 border border-telecab-border text-xs text-telecab-text text-center"
           placeholder="dd/mm/aaaa" title="Qué día se mira" readonly>
  </div>
  <div id="fi-avisos" class="mb-3"></div>
  <div id="fi-parte" class="text-sm text-telecab-muted">—</div>
</div>
<% } %>

<script type="application/json" id="datos-servidor"><%- json({ puedeRevisar: !!(puedeRevisar), puedeAprobar: !!(puedeAprobar), quienAprueba: quienAprueba || null }) %></script>
<script src="<%= est('/assets/js/vistas/Fichaje/fichaje.js') %>"></script>
