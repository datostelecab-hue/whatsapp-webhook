<%- include('partials/control-nav', { sub: 'directo' }) %>
<%- include('partials/historial-llamadas') %>

<div class="max-w-[1400px] mx-auto">

  <div class="flex flex-wrap items-end justify-between gap-3 mb-4">
    <div>
      <h1 class="text-2xl font-bold text-telecab-text flex items-center gap-2">
        <i class="fa-solid fa-satellite-dish text-telecab-gold"></i> En directo
      </h1>
      <p class="text-sm text-telecab-muted mt-1">
        El plan del cuadrante contra lo que rueda ahora mismo, por turno. En
        <span class="text-red-500 font-medium">rojo</span> lo que hay que llamar.
      </p>
    </div>
    <div class="flex items-center gap-2">
      <span id="d-actualizado" class="text-xs text-telecab-muted"></span>
      <button id="d-refrescar" class="px-3 py-2 rounded-lg bg-telecab-card border border-telecab-border
        text-sm text-telecab-muted hover:text-telecab-text">
        <i class="fa-solid fa-rotate mr-1"></i> Actualizar
      </button>
    </div>
  </div>

  <!-- Si una de las dos fuentes no responde, se dice: el resto se ve igual. -->
  <div id="d-aviso" class="hidden mb-3 px-3 py-2 rounded-xl border text-sm"></div>

  <!-- Pestañas por turno: Día · Noche · TodoTurno · NN (los que ruedan sin plan). -->
  <div id="d-tabs" class="flex flex-wrap items-center gap-2 mb-3"></div>

  <!-- LO PRIMERO QUE SE VE. Tráfico abre esta pantalla para saber a quién llama, así
       que el número de los que faltan va grande y de rojo, y se puede pinchar para
       quedarse solo con ellos. Lo demás es contexto. -->
  <div id="d-resumen" class="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-7 gap-2 mb-3"></div>

  <div class="mb-3 flex flex-wrap items-center gap-2">
    <i class="fa-solid fa-filter text-telecab-muted text-xs"></i>
    <input id="d-filtro" placeholder="Conductor o matrícula" aria-label="Filtrar por conductor o matrícula"
      class="px-2 py-1.5 rounded-lg bg-telecab-dark border border-telecab-border text-xs text-telecab-text w-56">
    <button id="d-solo-nosalieron" class="px-3 py-1.5 rounded-lg border border-telecab-border bg-telecab-card text-xs text-telecab-muted hover:text-telecab-text">
      <i class="fa-solid fa-phone-volume mr-1"></i> Solo los que no han salido
    </button>
    <%# Los que están conectados y aunque sigan hasta el final del turno no llegan
        a su jornada (06/10/2026). Es otra lista de llamadas: no la de quien no ha
        salido, sino la de quien salió y se va a quedar corto. %>
    <button id="d-solo-noterminara" class="px-3 py-1.5 rounded-lg border border-telecab-border bg-telecab-card text-xs text-telecab-muted hover:text-telecab-text"
            title="Solo quien está conectado (o en descanso) y, aunque siga hasta el final de su turno, no llega a su jornada. Pincha otra vez para verlos a todos.">
      <i class="fa-solid fa-hourglass-end mr-1"></i> Solo «No terminará la jornada» <span id="d-noterminara-n" class="tabular-nums"></span>
    </button>
    <%# Los que están parados sin sus horas y todavía llegan si vuelven ya
        (06/10/2026). Camilo: «filtro aparte, "En riesgo", pero sin alerta, solo
        un filtro». No pinta ningún aviso en la fila: solo los junta. %>
    <button id="d-solo-enriesgo" class="px-3 py-1.5 rounded-lg border border-telecab-border bg-telecab-card text-xs text-telecab-muted hover:text-telecab-text"
            title="Solo quien está desconectado o en descanso sin sus horas y aún llega si vuelve ya. Arriba los que antes se quedan sin margen; cuando ya no les da el tiempo pasan a «No terminará la jornada». Pincha otra vez para verlos a todos.">
      <i class="fa-solid fa-stopwatch mr-1"></i> En riesgo <span id="d-enriesgo-n" class="tabular-nums"></span>
    </button>
    <span id="d-cuenta" class="text-xs text-telecab-muted ml-auto"></span>
  </div>

  <div class="rounded-2xl border border-telecab-border bg-telecab-card overflow-hidden">
    <!-- Cabecera de columnas: sin ella hay que adivinar qué es cada número. -->
    <div id="d-cabecera" class="hidden dcab-grid px-0 py-2 border-b border-telecab-border
      bg-telecab-dark/60 text-[10px] uppercase tracking-wide text-telecab-muted">
      <span></span>
      <span>Conductor</span>
      <span class="dopc">Coche</span>
      <span>Estado</span>
      <span class="dopc text-right">Desde</span>
      <span class="text-right" title="Horas efectivas: viaje + espera">Efectivas</span>
      <span class="dopc text-right" title="Km rodados trabajando">Km</span>
      <span class="dopc text-right" title="Km rodados fuera de BOLT (descanso o desconectado)">Km fuera</span>
      <span class="dopc text-right" title="Viajes aceptados sobre los que le ha ofrecido BOLT en su turno (día de 00:00 a 24:00, noche de 12:00 a 12:00)">Aceptados</span>
      <span class="text-right">Avisos</span>
      <span></span>
    </div>
    <div id="d-lista">
      <p class="px-4 py-10 text-center text-sm text-telecab-muted">Cargando…</p>
    </div>
  </div>

  <!-- Al final y fuera de la lista a propósito: esto NO es una persona que no ha
       salido, es un COCHE rodando sin que nadie esté conectado a él. La pregunta
       tampoco es la misma: no es "a quién llamo" sino "quién lo está usando". -->
  <div id="d-sinduenio" class="hidden mt-4"></div>
</div>

<style>
  /* UNA REJILLA, NO UN FLEX-WRAP.
     La fila era un flex con anchos variables: el chip de estado caía en una x
     distinta en cada línea y los números no se podían comparar de un vistazo.
     Con columnas fijas, la vista baja en vertical y todo cuadra. */
  .dcab-grid {
    display: grid;
    grid-template-columns:
      3px                    /* barra de estado, el color que se ve de lejos */
      minmax(9rem, 1.6fr)    /* nombre + rol */
      minmax(7rem, 1fr)      /* matrícula */
      7.5rem                 /* estado */
      4.5rem                 /* desde */
      4.5rem                 /* horas efectivas */
      5rem                   /* km de trabajo */
      5rem                   /* km fuera */
      4.5rem                 /* % de viajes aceptados en la jornada */
      minmax(7rem, 9rem)     /* avisos: chips con texto, no un número */
      1.5rem;                /* el desplegable */
    align-items: center;
    column-gap: 0.75rem;
    padding-right: 1rem;
  }
  .dcab-grid > span:first-child { padding: 0; }
  /* La barra de color ocupa el alto entero de la fila, no solo el del texto. */
  .dfila .dbarra { align-self: stretch; border-radius: 0 2px 2px 0; }

  /* UNA ALERTA SIN ATENDER LATE. No es decoración: es lo que hace que no se
     quede ahí media hora porque "ya la había visto". Deja de latir en cuanto se
     apunta la llamada o se justifica, y entonces se queda en rojo quieto. */
  @keyframes dlatido {
    0%, 100% { background-color: rgb(239 68 68 / .07); }
    50%      { background-color: rgb(239 68 68 / .20); }
  }
  .dfila.dalerta { animation: dlatido 1.8s ease-in-out infinite; box-shadow: inset 3px 0 0 0 rgb(239 68 68); }
  .dfila.dalerta-ok { background-color: rgb(239 68 68 / .05); box-shadow: inset 3px 0 0 0 rgb(239 68 68 / .45); }
  .dlate { animation: dlatido 1.8s ease-in-out infinite; }
  /* CUMPLEAÑOS (15/10/2026): la fila de quien cumple hoy, en azul. Con una alerta
     sin atender late igual, pero en azul en vez de en rojo. */
  @keyframes dlatido-cumple {
    0%, 100% { background-color: rgb(var(--tc-azul) / .14); }
    50%      { background-color: rgb(var(--tc-azul) / .42); }
  }
  .dfila.dcumple { background-color: rgb(var(--tc-azul) / .24); box-shadow: inset 4px 0 0 0 rgb(var(--tc-azul)); }
  .dfila.dcumple-alerta { animation: dlatido-cumple 1.8s ease-in-out infinite; box-shadow: inset 4px 0 0 0 rgb(var(--tc-azul)); }
  .dcumple-chip { background: rgb(var(--tc-azul) / .18); color: rgb(var(--tc-azul)); }
  /* A quien le moleste el movimiento (o lo tenga desactivado en su sistema) se
     le deja el rojo fijo: la información es el color, no el parpadeo. */
  @media (prefers-reduced-motion: reduce) {
    .dfila.dalerta, .dlate { animation: none; background-color: rgb(239 68 68 / .16); }
    .dfila.dcumple-alerta { animation: none; background-color: rgb(var(--tc-azul) / .34); }
  }

  /* En pantallas estrechas se apilan las tres cosas que de verdad importan y el
     resto se esconde: llamar por teléfono desde el móvil sigue funcionando. */
  @media (max-width: 900px) {
    .dcab-grid {
      grid-template-columns: 3px minmax(7rem, 1fr) 6.75rem 4rem 3.25rem 1.5rem;
    }
    .dcab-grid > .dopc { display: none; }
  }
</style>

<script src="/assets/js/flotaVivaGestion.js?v=<%= v %>"></script>
<script type="application/json" id="datos-servidor"><%- json({
  resultadosLlamada: resultadosLlamada || [],
  catalogoLlamada: catalogoLlamada || [],
  tiposJ: tiposJ || [],
  casuisticasMenosJ: typeof casuisticasMenosJ !== 'undefined' ? casuisticasMenosJ : [],
  motivosNoSale: typeof motivosNoSale !== 'undefined' ? motivosNoSale : [],
  canalesSlack: typeof canalesSlack !== 'undefined' ? canalesSlack : [],
}) %></script>
<script src="<%= est('/assets/js/vistas/Control/controlDirecto.js') %>"></script>
