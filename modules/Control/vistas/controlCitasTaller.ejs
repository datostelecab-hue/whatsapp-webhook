<%- include('partials/control-nav', { sub: 'citas' }) %>

<div class="max-w-[1400px] mx-auto px-4 lg:px-6 pb-10">

  <div class="flex flex-wrap items-end justify-between gap-3 mb-4 mt-4">
    <div>
      <h1 class="text-2xl font-bold text-telecab-text flex items-center gap-2">
        <i class="fa-solid fa-screwdriver-wrench text-telecab-gold"></i> Citas del taller
      </h1>
      <p class="text-sm text-telecab-muted mt-1 max-w-3xl">
        Quién lleva cada coche el día de su cita, según el planificador. Llámale para que la
        confirme y apunta lo que te diga: queda en la cita, la ve Mantenimientos y entra en su
        historial de llamadas. Dos días antes el sistema le avisa por WhatsApp, y si pulsa
        «Confirmo» o «No puedo ir» sale aquí solo.
      </p>
    </div>
    <button id="c-recargar" class="px-3 py-2 rounded-lg bg-telecab-card border border-telecab-border text-sm text-telecab-muted hover:text-telecab-text">
      <i class="fa-solid fa-rotate mr-1"></i> Recargar
    </button>
  </div>

  <div id="c-resumen" class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-4"></div>

  <div id="c-tramos" class="flex flex-wrap items-center gap-2 mb-4"></div>

  <div id="c-lista" class="space-y-5">
    <p class="px-4 py-10 text-center text-sm text-telecab-muted">Cargando…</p>
  </div>
</div>

<script src="<%= typeof est === 'function' ? est('/assets/js/citasTaller.js') : '/assets/js/citasTaller.js' %>"></script>
<script type="application/json" id="datos-servidor"><%- json({ resultados: resultados }) %></script>
<script src="<%= est('/assets/js/vistas/Control/controlCitasTaller.js') %>"></script>
