<%
  // Cambiar umbrales y destinatarios es un permiso APARTE: se reparte a mano.
  const puedeConfig = !permisos || permisos.includes('/alertas/config');
%>
<div class="max-w-[1500px] mx-auto px-4 py-6">

  <div class="flex flex-wrap items-start justify-between gap-4 mb-5">
    <div>
      <h1 class="text-2xl font-bold text-telecab-text">Alertas de control</h1>
      <p id="a-sub" class="text-telecab-muted text-sm">—</p>
    </div>
    <div class="flex items-center gap-2">
      <button id="a-revisar" class="px-4 py-2 rounded-lg bg-telecab-gold text-telecab-dark font-semibold text-sm hover:brightness-110 transition">
        <i class="fa-solid fa-bolt mr-1"></i> Revisar ahora
      </button>
      <% if (puedeConfig) { %>
      <button id="a-config-btn" class="px-4 py-2 rounded-lg border border-telecab-border text-telecab-text hover:bg-telecab-card transition text-sm">
        <i class="fa-solid fa-sliders mr-1"></i> Ajustes
      </button>
      <% } %>
    </div>
  </div>

  <!-- ══ Estado: franja, modo y a quién le llega ══ -->
  <div id="a-estado" class="grid gap-3 md:grid-cols-3 mb-5"></div>

  <!-- ══ Está pasando AHORA (por encima del umbral en la franja en curso) ══ -->
  <section id="a-vivo-caja" class="hidden mb-5">
    <h2 class="text-sm font-semibold uppercase tracking-wide text-telecab-muted mb-2">
      <i class="fa-solid fa-tower-broadcast text-telecab-gold mr-1"></i>
      Por encima del umbral ahora mismo <span id="a-vivo-n" class="font-normal normal-case"></span>
    </h2>
    <div id="a-vivo" class="grid gap-2 md:grid-cols-2 lg:grid-cols-3"></div>
  </section>

  <!-- ══ Las alertas del día ══ -->
  <section>
    <div class="flex flex-wrap items-center gap-3 mb-2">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-telecab-muted">
        <i class="fa-solid fa-bell text-telecab-gold mr-1"></i> Alertas enviadas
      </h2>
      <input id="a-dia" type="date" aria-label="Día" class="px-2 py-1 rounded-lg bg-telecab-card border border-telecab-border text-telecab-text text-xs">
      <span id="a-resumen" class="text-xs text-telecab-muted"></span>
    </div>
    <div class="overflow-x-auto border border-telecab-border rounded-2xl">
      <table class="w-full text-sm">
        <thead class="bg-telecab-card2 text-telecab-muted text-[11px] uppercase tracking-wide">
          <tr>
            <th class="text-left font-semibold px-3 py-2.5">Hora</th>
            <th class="text-left font-semibold px-3 py-2.5">Franja</th>
            <th class="text-left font-semibold px-3 py-2.5">Conductor</th>
            <th class="text-left font-semibold px-3 py-2.5">Teléfono</th>
            <th class="text-left font-semibold px-3 py-2.5">Alerta</th>
            <th class="text-center font-semibold px-3 py-2.5">Horas</th>
            <th class="text-left font-semibold px-3 py-2.5">Enviada a</th>
          </tr>
        </thead>
        <tbody id="a-tabla"></tbody>
      </table>
    </div>
  </section>
</div>

<% if (puedeConfig) { %>
<!-- ══ Ajustes ══ -->
<div id="a-config" class="hidden fixed inset-0 z-[120] bg-black/60 backdrop-blur-sm flex items-start justify-center p-4 overflow-y-auto">
  <div class="bg-telecab-card border border-telecab-border rounded-2xl shadow-soft w-full max-w-2xl my-8">
    <div class="flex items-center justify-between px-5 py-4 border-b border-telecab-border">
      <h3 class="font-bold">Ajustes de las alertas</h3>
      <button id="a-config-x" aria-label="Cerrar" class="w-8 h-8 rounded-lg hover:bg-telecab-card2 text-telecab-muted"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
    </div>
    <div class="p-5 space-y-6 max-h-[75vh] overflow-y-auto">

      <div>
        <p class="text-[11px] uppercase tracking-wider font-semibold text-telecab-gold border-b border-telecab-border pb-1 mb-3">Umbrales</p>
        <div id="a-tipos" class="space-y-3"></div>
        <p class="text-xs text-telecab-muted mt-3">
          Cada tipo se avisa <b>una sola vez por conductor y franja</b>. Un conductor puede
          levantar los tres, y serían tres mensajes; si sigue rechazando después del aviso,
          no vuelve a sonar hasta la franja siguiente.
        </p>
      </div>

      <div>
        <p class="text-[11px] uppercase tracking-wider font-semibold text-telecab-gold border-b border-telecab-border pb-1 mb-3">Quién recibe</p>
        <div id="a-dest" class="grid gap-1.5 sm:grid-cols-2"></div>
        <p class="text-xs text-telecab-muted mt-3">Sin importar su rol. Quien no tenga teléfono en su ficha no puede recibir.</p>
      </div>

      <div>
        <p class="text-[11px] uppercase tracking-wider font-semibold text-telecab-gold border-b border-telecab-border pb-1 mb-3">Envío</p>
        <label class="flex items-center gap-2 text-sm mb-3">
          <input id="a-modo" type="checkbox" class="w-4 h-4 accent-telecab-gold">
          <span>Enviar de verdad por WhatsApp <span class="text-telecab-muted">(sin marcar: se registran las alertas pero no se manda nada)</span></span>
        </label>
        <div class="grid gap-3 sm:grid-cols-2">
          <label class="text-sm">Plantilla de WhatsApp
            <input id="a-plantilla" class="w-full mt-1 px-3 py-2 bg-telecab-card2 border border-telecab-border rounded-xl text-sm">
          </label>
          <label class="text-sm">Tope de avisos por franja
            <input id="a-max" type="number" min="1" class="w-full mt-1 px-3 py-2 bg-telecab-card2 border border-telecab-border rounded-xl text-sm">
          </label>
        </div>
      </div>

      <div class="flex gap-2 pt-2">
        <button id="a-config-save" class="flex-1 px-3 py-2 rounded-xl bg-telecab-gold text-telecab-dark font-semibold text-sm">Guardar</button>
        <button id="a-config-cancel" class="px-3 py-2 rounded-xl bg-telecab-card2 border border-telecab-border text-sm">Cancelar</button>
      </div>
    </div>
  </div>
</div>
<% } %>

<script type="application/json" id="datos-servidor"><%- json({ puedeConfig: !!(puedeConfig) }) %></script>
<script src="<%= est('/assets/js/vistas/Control/alertas.js') %>"></script>
