<%- include('partials/control-nav', { sub: 'campanas' }) %>

<div class="px-4 lg:px-6 pb-8 max-w-[1600px] mx-auto">

  <!-- Cabecera -->
  <div class="flex flex-wrap items-end justify-between gap-3 mt-4 mb-4">
    <div>
      <h1 class="text-2xl font-bold text-telecab-text flex items-center gap-2">
        <i class="fa-solid fa-phone-volume text-telecab-gold"></i> Campañas de llamadas
      </h1>
      <p class="text-sm text-telecab-muted mt-1">
        Tres pasadas por turno: se llama a quien no se ha conectado, se etiqueta con el buzón,
        y cada etiqueta decide su cola en la campaña siguiente.
        <span id="c-ventanas"></span>
        <span id="c-actualizado" class="text-telecab-muted/70"></span>
      </p>
    </div>
    <div class="flex items-center gap-2">
      <div id="c-turnos" class="flex rounded-lg border border-telecab-border overflow-hidden">
        <button data-turno="dia" class="px-3 py-2 text-sm bg-telecab-card text-telecab-muted"><i class="fa-solid fa-sun mr-1"></i> Día</button>
        <button data-turno="noche" class="px-3 py-2 text-sm bg-telecab-card text-telecab-muted"><i class="fa-solid fa-moon mr-1"></i> Noche</button>
      </div>
      <% if (typeof esAdmin !== 'undefined' && esAdmin) { %>
      <a id="c-informe" href="/control/campanas" class="px-3 py-2 rounded-lg bg-telecab-card border border-telecab-border text-sm text-telecab-muted hover:text-telecab-text">
        <i class="fa-solid fa-chart-column mr-1"></i> Volver al informe
      </a>
      <% } %>
      <button id="c-refrescar" class="px-3 py-2 rounded-lg bg-telecab-card border border-telecab-border text-sm text-telecab-muted hover:text-telecab-text">
        <i class="fa-solid fa-rotate mr-1"></i> Actualizar
      </button>
    </div>
  </div>

  <!-- Resumen -->
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 mb-4">
    <div class="bg-telecab-card border border-telecab-border rounded-2xl p-3">
      <p class="text-xs text-telecab-muted uppercase tracking-wide">En el plan</p>
      <p id="r-plan" class="text-xl font-bold mt-1">—</p>
    </div>
    <div class="bg-telecab-card border border-telecab-border rounded-2xl p-3">
      <p class="text-xs text-telecab-muted uppercase tracking-wide">Activos</p>
      <p id="r-activos" class="text-xl font-bold mt-1 text-telecab-green">—</p>
    </div>
    <div class="bg-telecab-card border border-telecab-border rounded-2xl p-3">
      <p class="text-xs text-telecab-muted uppercase tracking-wide">Sin conectar</p>
      <p id="r-pendientes" class="text-xl font-bold mt-1 text-telecab-warn">—</p>
    </div>
    <div class="bg-telecab-card border border-telecab-border rounded-2xl p-3">
      <p class="text-xs text-telecab-muted uppercase tracking-wide">Sin llamar aún</p>
      <p id="r-sinllamar" class="text-xl font-bold mt-1 text-telecab-warn">—</p>
    </div>
    <div class="bg-telecab-card border border-telecab-border rounded-2xl p-3">
      <p class="text-xs text-telecab-muted uppercase tracking-wide">Justificados</p>
      <p id="r-just" class="text-xl font-bold mt-1 text-sky-400">—</p>
    </div>
    <div class="bg-telecab-card border border-telecab-border rounded-2xl p-3">
      <p class="text-xs text-telecab-muted uppercase tracking-wide">Lista roja</p>
      <p id="r-roja" class="text-xl font-bold mt-1 text-telecab-red">—</p>
    </div>
  </div>

  <!-- Las tres campañas -->
  <div id="c-tabs" class="flex flex-wrap gap-2 mb-3"></div>
  <div id="c-detalle" class="mb-6"></div>

  <!-- Las listas de consulta -->
  <div class="grid lg:grid-cols-3 gap-4 items-start">
    <div class="bg-telecab-card border border-telecab-border rounded-2xl overflow-hidden">
      <button data-abre="l-activos" class="w-full px-4 py-3 flex items-center gap-2 text-left border-b border-telecab-border">
        <i class="fa-solid fa-circle-check text-telecab-green"></i>
        <span class="font-semibold text-sm">Activos · <span id="t-activos">—</span></span>
        <i class="fa-solid fa-chevron-down ml-auto text-xs text-telecab-muted"></i>
      </button>
      <div id="l-activos" class="hidden max-h-[420px] overflow-y-auto"></div>
    </div>
    <div class="bg-telecab-card border border-telecab-border rounded-2xl overflow-hidden">
      <button data-abre="l-just" class="w-full px-4 py-3 flex items-center gap-2 text-left border-b border-telecab-border">
        <i class="fa-solid fa-file-circle-check text-sky-400"></i>
        <span class="font-semibold text-sm">Justificados · <span id="t-just">—</span></span>
        <i class="fa-solid fa-chevron-down ml-auto text-xs text-telecab-muted"></i>
      </button>
      <div id="l-just" class="hidden max-h-[420px] overflow-y-auto"></div>
    </div>
    <div class="bg-telecab-card border border-telecab-red/40 rounded-2xl overflow-hidden">
      <button data-abre="l-roja" class="w-full px-4 py-3 flex items-center gap-2 text-left border-b border-telecab-red/30 bg-telecab-red/5">
        <i class="fa-solid fa-triangle-exclamation text-telecab-red"></i>
        <span class="font-semibold text-sm text-telecab-red">Lista roja · <span id="t-roja">—</span></span>
        <i class="fa-solid fa-chevron-down ml-auto text-xs text-telecab-muted"></i>
      </button>
      <div id="l-roja" class="max-h-[420px] overflow-y-auto"></div>
    </div>
  </div>
</div>

<script type="application/json" id="datos-servidor"><%- json({ resultadosLlamada: resultadosLlamada || [], tiposJ: tiposJ || [] }) %></script>
<script src="<%= est('/assets/js/vistas/Control/controlCampanas.js') %>"></script>
