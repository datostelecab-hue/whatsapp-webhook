<div class="p-4 lg:p-6 max-w-[1200px] mx-auto">

  <div class="flex flex-wrap items-end justify-between gap-3 mb-4">
    <div>
      <h1 class="text-2xl font-bold text-telecab-text flex items-center gap-2">
        <i class="fa-solid fa-file-circle-check text-telecab-gold"></i> Justificantes
      </h1>
      <p class="text-sm text-telecab-muted mt-1">
        Las J nacen <b class="text-sky-400">presuntas</b> y aquí las aprueba el área responsable: una de Tráfico la aprueba Tráfico,
        una de RRHH la aprueba RRHH. <b class="text-emerald-400">Aprobada</b> es la única que cuenta horas en la bitácora;
        <b class="text-red-400">rechazada</b> devuelve el día a tráfico y hay que volver a llamar.
        La <b class="text-telecab-text">−J</b> es otra cosa: constancia de un perjuicio a la empresa, con su pestaña;
        no toca horas, nómina ni letra, y solo cuenta aprobada.
      </p>
    </div>
    <div class="flex items-center gap-2">
      <input id="j-desde" type="date" title="Desde" aria-label="Desde"
        class="px-2.5 py-2 rounded-lg bg-telecab-dark border border-telecab-border text-sm text-telecab-text">
      <span class="text-telecab-muted text-xs">a</span>
      <input id="j-hasta" type="date" title="Hasta" aria-label="Hasta"
        class="px-2.5 py-2 rounded-lg bg-telecab-dark border border-telecab-border text-sm text-telecab-text">
      <button id="j-limpiar" class="px-3 py-2 rounded-lg bg-telecab-card border border-telecab-border text-sm text-telecab-muted hover:text-telecab-text">Todo</button>
    </div>
  </div>

  <!-- LAS TRES PESTAÑAS. Antes esto era un <select> y las rechazadas estaban
       escondidas dentro: nadie sabía que existían, y son las que hay que
       atender. Ahora se ven las tres con su cuenta, y las rechazadas llevan
       encima cuántas siguen pidiendo una llamada. -->
  <div id="j-estados" class="flex flex-wrap gap-2 mb-3"></div>
  <select id="j-estado" class="hidden" aria-label="Estado">
    <option value="pendiente">Pendientes</option>
    <option value="aprobada">Aprobadas</option>
    <option value="rechazada">Rechazadas</option>
  </select>

  <!-- Pestañas por tipo, con su cuenta de pendientes -->
  <div id="j-tabs" class="flex flex-wrap gap-2 mb-4"></div>

  <div id="j-lista" class="bg-telecab-card border border-telecab-border rounded-2xl overflow-hidden">
    <p class="px-4 py-10 text-center text-sm text-telecab-muted">Cargando…</p>
  </div>
</div>

<script type="application/json" id="datos-servidor"><%- json({ tiposJ: tiposJ || [], casuisticasMenosJ: casuisticasMenosJ || [] }) %></script>
<script src="<%= est('/assets/js/vistas/Control/justificantes.js') %>"></script>
