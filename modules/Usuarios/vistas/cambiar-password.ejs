<form method="POST" action="/cambiar-password" class="form-acceso">
  <h1><%= primerAcceso ? 'Crea tu contraseña' : 'Cambiar contraseña' %></h1>
  <p class="bajada">
    <% if (primerAcceso) { %>
      Es tu primer acceso: elige una contraseña propia para <b class="text-white font-medium"><%= usuario.email %></b>.
    <% } else { %>
      La nueva contraseña de <b class="text-white font-medium"><%= usuario.email %></b>. Cierra la sesión en los demás dispositivos.
    <% } %>
  </p>

  <% if (error) { %>
    <div role="alert" class="aviso error">
      <i class="fa-solid fa-circle-exclamation mt-0.5"></i><span><%= error %></span>
    </div>
  <% } %>

  <% if (!primerAcceso) { %>
    <div class="grupo">
      <label class="etiqueta" for="actual">Contraseña actual</label>
      <input class="entrada" id="actual" name="actual" type="password" required autocomplete="current-password">
    </div>
  <% } %>

  <div class="grupo">
    <label class="etiqueta" for="nueva">Nueva contraseña <span class="font-normal opacity-70">· mínimo 8 caracteres</span></label>
    <input class="entrada" id="nueva" name="nueva" type="password" required minlength="8" autocomplete="new-password">
  </div>

  <div class="grupo mb-5">
    <label class="etiqueta" for="repetir">Repite la nueva contraseña</label>
    <input class="entrada" id="repetir" name="repetir" type="password" required minlength="8" autocomplete="new-password">
  </div>

  <div class="flex flex-wrap items-center gap-x-5 gap-y-3">
    <button type="submit" class="btn-entrar">Guardar y entrar</button>
    <% if (!primerAcceso) { %>
      <a href="/" class="enlace">Cancelar</a>
    <% } %>
  </div>
</form>
