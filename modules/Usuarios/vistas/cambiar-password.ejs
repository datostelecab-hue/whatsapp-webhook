<form method="POST" action="/cambiar-password" class="panel-acceso">
  <h1><%= primerAcceso ? 'Crea tu contraseña' : 'Cambiar contraseña' %></h1>
  <p class="bajada">
    <% if (primerAcceso) { %>
      Es tu primer acceso: elige una contraseña propia para <b class="text-telecab-text font-medium"><%= usuario.email %></b>.
    <% } else { %>
      La nueva contraseña de <b class="text-telecab-text font-medium"><%= usuario.email %></b>. Cierra la sesión en los demás dispositivos.
    <% } %>
  </p>

  <% if (error) { %>
    <div role="alert" class="flex items-start gap-2.5 mb-4 px-3 py-2.5 rounded-lg border border-telecab-red/40 bg-telecab-red/10">
      <i class="fa-solid fa-circle-exclamation text-telecab-red mt-0.5"></i>
      <p class="text-sm text-telecab-red leading-snug"><%= error %></p>
    </div>
  <% } %>

  <% if (!primerAcceso) { %>
    <div class="campo">
      <input id="actual" name="actual" type="password" required autocomplete="current-password" placeholder=" ">
      <label for="actual">Contraseña actual</label>
      <i class="icono fa-solid fa-lock"></i>
    </div>
  <% } %>

  <div class="campo">
    <input id="nueva" name="nueva" type="password" required minlength="8" autocomplete="new-password" placeholder=" ">
    <label for="nueva">Nueva contraseña · mínimo 8</label>
    <i class="icono fa-solid fa-key"></i>
  </div>

  <div class="campo mb-5">
    <input id="repetir" name="repetir" type="password" required minlength="8" autocomplete="new-password" placeholder=" ">
    <label for="repetir">Repite la nueva contraseña</label>
    <i class="icono fa-solid fa-key"></i>
  </div>

  <button type="submit" class="btn-entrar">Guardar y entrar</button>

  <% if (!primerAcceso) { %>
    <div class="text-center mt-4">
      <a href="/" class="enlace">Cancelar</a>
    </div>
  <% } %>
</form>
