<form method="POST" action="/login" id="f-login" class="panel-acceso" novalidate>
  <h1>Entrar</h1>
  <p class="bajada">Con tu correo de la empresa.</p>

  <% if (error) { %>
    <div role="alert" class="flex items-start gap-2.5 mb-4 px-3 py-2.5 rounded-lg border border-telecab-red/40 bg-telecab-red/10">
      <i class="fa-solid fa-circle-exclamation text-telecab-red mt-0.5"></i>
      <p class="text-sm text-telecab-red leading-snug"><%= error %></p>
    </div>
  <% } %>

  <input type="hidden" name="next" value="<%= next || '' %>">

  <!-- LA SEDE (07/10/2026). Madrid es el ERP de siempre; Barcelona, su
       planificador, su reporte de horas y su Visibilidad. Se recuerda la última
       elegida en este navegador. -->
  <fieldset class="mb-4">
    <legend class="text-xs font-medium text-telecab-muted mb-1.5">Sede</legend>
    <div class="sedes" role="radiogroup" aria-label="Sede">
      <label>
        <input type="radio" name="sede" value="madrid" class="sr-only" checked>
        <span>Madrid</span>
      </label>
      <label>
        <input type="radio" name="sede" value="barcelona" class="sr-only">
        <span>Barcelona</span>
      </label>
    </div>
  </fieldset>

  <!-- El placeholder de un espacio NO es un descuido: `:placeholder-shown` es lo
       que deja saber en CSS si el campo está vacío, y así la etiqueta flota sin
       una línea de JavaScript. -->
  <div class="campo">
    <input id="email" name="email" type="email" required autofocus autocomplete="username"
           placeholder=" " spellcheck="false">
    <label for="email">Correo</label>
    <i class="icono fa-solid fa-envelope"></i>
  </div>

  <div class="campo">
    <input id="password" name="password" type="password" required autocomplete="current-password"
           placeholder=" ">
    <label for="password">Contraseña</label>
    <i class="icono fa-solid fa-lock"></i>
    <button type="button" class="ojo" id="ver-pass" aria-label="Mostrar la contraseña" title="Mostrar la contraseña">
      <i class="fa-solid fa-eye"></i>
    </button>
  </div>

  <label class="flex items-center gap-2.5 mt-1 mb-4 cursor-pointer group w-fit">
    <input id="recordar" name="recordar" type="checkbox" value="si"
           class="w-4 h-4 accent-telecab-gold shrink-0">
    <span class="text-[13px] text-telecab-muted group-hover:text-telecab-text transition">
      Mantener la sesión iniciada <span class="text-telecab-muted/70">· 30 días</span>
    </span>
  </label>

  <!-- El aviso sale SOLO al marcar la casilla: puesto siempre, se lee una vez y
       deja de verse. Y va aquí porque la decisión se toma justo en este momento. -->
  <p id="aviso-recordar" class="hidden text-xs leading-snug text-telecab-warn bg-telecab-warn/10 border border-telecab-warn/30 rounded-lg px-3 py-2 mb-4">
    <b>Solo en tu equipo personal.</b> En un ordenador compartido, cualquiera que
    lo abra entrará con tu nombre y lo que haga quedará a tu nombre. Si te pasa,
    cambia tu contraseña: eso cierra la sesión en todos los dispositivos.
  </p>

  <button type="submit" class="btn-entrar" id="btn-entrar">
    <span id="btn-txt">Entrar</span>
  </button>

  <div class="text-center mt-4">
    <a href="/olvide-password" class="enlace">¿Olvidaste tu contraseña?</a>
  </div>
</form>

<script>
  (function () {
    // El aviso de la sesión larga, al marcar. Sin JavaScript la casilla sigue
    // funcionando: el aviso es ayuda, no un requisito.
    const c = document.getElementById('recordar');
    const a = document.getElementById('aviso-recordar');
    if (c && a) {
      const pinta = () => a.classList.toggle('hidden', !c.checked);
      c.addEventListener('change', pinta);
      pinta();
    }

    // Ver la contraseña. En un móvil, con prisa y el teclado tapando media
    // pantalla, es la diferencia entre entrar y equivocarse tres veces — y a la
    // tercera salta el freno anti fuerza bruta.
    const ojo = document.getElementById('ver-pass');
    const pass = document.getElementById('password');
    if (ojo && pass) {
      ojo.addEventListener('click', () => {
        const ver = pass.type === 'password';
        pass.type = ver ? 'text' : 'password';
        ojo.innerHTML = '<i class="fa-solid fa-eye' + (ver ? '-slash' : '') + '"></i>';
        ojo.setAttribute('aria-label', ver ? 'Ocultar la contraseña' : 'Mostrar la contraseña');
        ojo.title = ver ? 'Ocultar la contraseña' : 'Mostrar la contraseña';
        pass.focus();
      });
    }

    // La sede: la última que se eligió en este navegador. Es una comodidad: si el
    // navegador no deja guardar, sale Madrid y ya.
    try {
      const guardada = localStorage.getItem('telecab-sede');
      const radio = guardada && document.querySelector('input[name="sede"][value="' + guardada + '"]');
      if (radio) radio.checked = true;
    } catch (e) { /* sin almacenamiento: Madrid */ }
    document.querySelectorAll('input[name="sede"]').forEach(r => r.addEventListener('change', () => {
      try { localStorage.setItem('telecab-sede', r.value); } catch (e) { /* nada */ }
    }));

    // Al enviar, el botón dice que está trabajando. El login va contra la base y
    // puede tardar un segundo; sin esto la gente pulsa dos y tres veces, y cada
    // pulsación es un intento más para el freno anti fuerza bruta.
    const f = document.getElementById('f-login');
    const b = document.getElementById('btn-entrar');
    const t = document.getElementById('btn-txt');
    if (f && b && t) {
      f.addEventListener('submit', ev => {
        // Sin `novalidate` el navegador pondría su globo; con él, se dice aquí
        // qué falta, en el campo que falta.
        const vacio = [...f.querySelectorAll('input[required]')].find(i => !i.value.trim());
        if (vacio) { ev.preventDefault(); vacio.focus(); vacio.style.borderColor = 'rgb(var(--tc-red))'; return; }
        b.disabled = true;
        t.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin mr-2"></i>Entrando…';
      });
      f.querySelectorAll('input[required]').forEach(i => i.addEventListener('input', () => { i.style.borderColor = ''; }));
    }
  })();
</script>
