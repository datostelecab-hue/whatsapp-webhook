<form method="POST" action="/login" id="f-login" class="form-acceso" novalidate>
  <h1>Entrar</h1>
  <p class="bajada">Con tu correo de la empresa.</p>

  <% if (error) { %>
    <div role="alert" class="aviso error">
      <i class="fa-solid fa-circle-exclamation mt-0.5"></i><span><%= error %></span>
    </div>
  <% } %>

  <input type="hidden" name="next" value="<%= next || '' %>">

  <!-- LA SEDE (07/10/2026). Madrid es el ERP de siempre; Barcelona, su
       planificador, su reporte de horas y su Visibilidad. Se recuerda la última
       elegida en este navegador. -->
  <fieldset class="grupo">
    <legend class="etiqueta">Sede</legend>
    <div class="sedes" role="radiogroup" aria-label="Sede">
      <label>
        <input type="radio" name="sede" value="madrid" class="sr-only" checked>
        <span>Madrid</span>
      </label>
      <label>
        <input type="radio" name="sede" value="barcelona" class="sr-only">
        <span>Barcelona</span>
      </label>
    </div>
  </fieldset>

  <div class="grupo">
    <label class="etiqueta" for="email">Correo</label>
    <input class="entrada" id="email" name="email" type="email" required autofocus autocomplete="username"
           spellcheck="false" placeholder="nombre@telecab.es">
  </div>

  <div class="grupo con-ojo">
    <label class="etiqueta" for="password">Contraseña</label>
    <input class="entrada" id="password" name="password" type="password" required autocomplete="current-password">
    <button type="button" class="ojo" id="ver-pass" aria-label="Mostrar la contraseña" title="Mostrar la contraseña">
      <i class="fa-solid fa-eye" aria-hidden="true"></i>
    </button>
  </div>

  <label class="casilla mb-4">
    <input id="recordar" name="recordar" type="checkbox" value="si">
    Mantener la sesión iniciada (30 días)
  </label>

  <!-- El aviso sale SOLO al marcar la casilla: puesto siempre, se lee una vez y
       deja de verse. Y va aquí porque la decisión se toma justo en este momento. -->
  <p id="aviso-recordar" class="aviso cuidado hidden">
    <span><b>Solo en tu equipo personal.</b> En un ordenador compartido, cualquiera que
    lo abra entrará con tu nombre. Si te pasa, cambia tu contraseña: eso cierra la
    sesión en todos los dispositivos.</span>
  </p>

  <div class="flex flex-wrap items-center gap-x-5 gap-y-3">
    <button type="submit" class="btn-entrar" id="btn-entrar"><span id="btn-txt">Entrar</span></button>
    <a href="/olvide-password" class="enlace">¿Olvidaste tu contraseña?</a>
  </div>

  <p class="nota">Acceso restringido al personal de Telecab.<br>Lo que hagas dentro queda a tu nombre.</p>
</form>

<script src="<%= est('/assets/js/vistas/Usuarios/login.js') %>"></script>
