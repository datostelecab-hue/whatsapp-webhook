<form method="POST" action="/olvide-password" class="panel-acceso">
  <h1>Recuperar acceso</h1>
  <p class="bajada">Escribe tu correo y te enviaremos una contraseña provisional.</p>

  <% if (mensaje) { %>
    <div role="status" class="flex items-start gap-2.5 mb-4 px-3 py-2.5 rounded-lg border border-telecab-green/40 bg-telecab-green/10">
      <i class="fa-solid fa-circle-check text-telecab-green mt-0.5"></i>
      <p class="text-sm text-telecab-green leading-snug"><%= mensaje %></p>
    </div>
  <% } %>
  <% if (error) { %>
    <div role="alert" class="flex items-start gap-2.5 mb-4 px-3 py-2.5 rounded-lg border border-telecab-red/40 bg-telecab-red/10">
      <i class="fa-solid fa-circle-exclamation text-telecab-red mt-0.5"></i>
      <p class="text-sm text-telecab-red leading-snug"><%= error %></p>
    </div>
  <% } %>

  <div class="campo mb-5">
    <input id="email" name="email" type="email" required autofocus autocomplete="username" placeholder=" " spellcheck="false">
    <label for="email">Correo</label>
    <i class="icono fa-solid fa-envelope"></i>
  </div>

  <button type="submit" class="btn-entrar">Enviarme una provisional</button>

  <div class="text-center mt-4">
    <a href="/login" class="enlace">Volver a entrar</a>
  </div>
</form>
