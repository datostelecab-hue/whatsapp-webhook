<form method="POST" action="/olvide-password" class="form-acceso">
  <h1>Recuperar acceso</h1>
  <p class="bajada">Escribe tu correo y te enviaremos una contraseña provisional.</p>

  <% if (mensaje) { %>
    <div role="status" class="aviso ok">
      <i class="fa-solid fa-circle-check mt-0.5"></i><span><%= mensaje %></span>
    </div>
  <% } %>
  <% if (error) { %>
    <div role="alert" class="aviso error">
      <i class="fa-solid fa-circle-exclamation mt-0.5"></i><span><%= error %></span>
    </div>
  <% } %>

  <div class="grupo mb-5">
    <label class="etiqueta" for="email">Correo</label>
    <input class="entrada" id="email" name="email" type="email" required autofocus autocomplete="username"
           spellcheck="false" placeholder="nombre@telecab.es">
  </div>

  <div class="flex flex-wrap items-center gap-x-5 gap-y-3">
    <button type="submit" class="btn-entrar">Enviarme una provisional</button>
    <a href="/login" class="enlace">Volver a entrar</a>
  </div>
</form>
