<div class="max-w-[1600px] mx-auto px-4 py-6">

  <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold text-telecab-text">Cobertura semanal</h1>
      <p id="resumen" class="text-telecab-muted text-sm">—</p>
    </div>
    <button id="btn-recargar" class="px-4 py-2 rounded-lg border border-telecab-border text-telecab-text hover:bg-telecab-card transition">
      <i class="fa-solid fa-rotate mr-1"></i> Recargar
    </button>
  </div>

  <div class="flex flex-wrap items-center gap-3 mb-5">
    <button id="sem-prev" class="px-3 py-1.5 rounded-lg border border-telecab-border text-telecab-text hover:bg-telecab-card disabled:opacity-40" title="Semana anterior" aria-label="Semana anterior">◀</button>
    <span id="sem-label" class="text-sm text-telecab-text font-medium min-w-[240px] text-center">—</span>
    <button id="sem-next" class="px-3 py-1.5 rounded-lg border border-telecab-border text-telecab-text hover:bg-telecab-card" title="Semana siguiente" aria-label="Semana siguiente">▶</button>
    <button id="sem-hoy" class="px-3 py-1.5 rounded-lg border border-telecab-border text-telecab-muted hover:bg-telecab-card text-sm">Esta semana</button>
    <span class="text-xs text-telecab-muted">Adelanta semanas para ver quién saldrá según altas, bajas y sustituciones.</span>
  </div>

  <div class="flex gap-1 mb-5 border-b border-telecab-border overflow-x-auto">
    <button data-tab="dias" class="tab whitespace-nowrap px-5 py-2.5 font-medium text-telecab-gold border-b-2 border-telecab-gold">
      Por día
    </button>
    <button data-tab="personas" class="tab whitespace-nowrap px-5 py-2.5 font-medium text-telecab-muted border-b-2 border-transparent hover:text-telecab-text">
      Por conductor
    </button>
  </div>

  <!-- ══ El registro de avisos: quién avisó, a cuántos y cuántas veces ══ -->
  <section id="avisos-dia" class="mb-5"></section>

  <!-- ══ Titulares de vacaciones/baja que siguen en su plaza (esos turnos NO salen) ══ -->
  <div id="ausentes-plaza" class="mb-5"></div>

  <!-- ══ TodoTurno: cubren día y noche del mismo coche (para tenerlos en cuenta) ══ -->
  <div id="todoturno" class="mb-5"></div>

  <!-- El logo del layout hace de indicador de carga; este div queda solo para errores. -->
  <div id="cargando" class="hidden text-center py-16 text-telecab-muted"></div>

  <!-- ══ POR DÍA ══ -->
  <section id="panel-dias" class="space-y-3"></section>

  <!-- ══ POR CONDUCTOR ══ -->
  <section id="panel-personas" class="hidden">
    <div class="flex flex-wrap items-center gap-3 mb-4">
      <input id="f-persona" type="search" placeholder="Nombre, ID o matrícula…" aria-label="Buscar conductor"
             class="flex-1 min-w-[220px] max-w-md px-3 py-2 rounded-lg bg-telecab-card border border-telecab-border
                    text-telecab-text placeholder:text-telecab-muted focus:outline-none focus:border-telecab-gold">
      <button id="btn-turnos-todos" class="px-4 py-2 rounded-lg bg-green-600/15 text-green-400 text-sm font-medium hover:bg-green-600/25">
        <i class="fa-brands fa-whatsapp mr-1"></i> Enviar turnos a todos
      </button>
      <span id="turnos-estado" class="text-sm text-telecab-muted"></span>
    </div>
    <p id="personas-ventana" class="text-xs text-telecab-muted mb-3"></p>
    <div id="lista-personas" class="grid gap-3 lg:grid-cols-2"></div>
  </section>
</div>

<script type="application/json" id="datos-servidor">
  <%- json({ diasSem: diasSem, turnos: turnos }) %>
</script>

<script src="<%= est('/assets/js/vistas/Planificacion/cobertura.js') %>"></script>
