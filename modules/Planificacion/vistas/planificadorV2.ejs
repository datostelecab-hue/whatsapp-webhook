<%
  // El cuadrante: la pantalla de Tráfico, modelada sobre el Excel de correturnos.
  // Filas por zona y coche; columnas Fijo día/noche y CT día/noche. La regla de
  // quién cubre qué día vive en la base (f_cobertura); aquí solo se pinta y se
  // colocan personas. Todo lo que se guarda vale DESDE el día que se mira.
%>

<div class="p-4 lg:p-6 max-w-[1600px] mx-auto">

  <!-- ══════════ Cabecera: fecha, KPIs y acciones ══════════ -->
  <div class="flex flex-wrap items-center gap-3 mb-4">
    <div>
      <h2 class="text-xl font-bold flex items-center gap-2">
        <i class="fa-solid fa-table-cells-large text-telecab-gold"></i>Cuadrante
      </h2>
      <p id="sub" class="text-sm text-telecab-muted mt-0.5">Cargando…</p>
    </div>

    <%# Quien no tiene el permiso de editar ve el cuadrante entero, pero de
        lejos. El distintivo no es adorno: sin él, la pantalla parece rota
        cuando un botón no hace nada. %>
    <% if (!puedeEditar) { %>
      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-telecab-card
                   border border-telecab-border text-xs text-telecab-muted"
            title="Puedes mirar el cuadrante, pero no cambiarlo. El permiso lo da un administrador en /usuarios.">
        <i class="fa-solid fa-eye"></i>Solo lectura
      </span>
    <% } %>

    <div class="ml-auto flex items-center gap-2">
      <button id="sem-prev" class="w-9 h-9 rounded-xl bg-telecab-card border border-telecab-border hover:border-telecab-gold/40 text-telecab-muted transition" title="Semana anterior">
        <i class="fa-solid fa-chevron-left text-xs"></i>
      </button>
      <input id="f-dia" class="js-fecha w-32 text-center px-2 py-2 bg-telecab-card border border-telecab-border rounded-xl text-sm cursor-pointer" readonly>
      <button id="sem-next" class="w-9 h-9 rounded-xl bg-telecab-card border border-telecab-border hover:border-telecab-gold/40 text-telecab-muted transition" title="Semana siguiente">
        <i class="fa-solid fa-chevron-right text-xs"></i>
      </button>
      <button id="hoy" class="px-3 py-2 rounded-xl bg-telecab-card border border-telecab-border hover:border-telecab-gold/40 text-sm transition">Hoy</button>
      <%# MODO EVENTOS. Abre las dos plazas de refuerzo (CT2 dia y noche) unos
          dias y se cierra SOLO: no hay nada que recordar apagar. %>
      <% if (puedeEditar) { %>
        <button id="btn-evento" class="flex items-center gap-2 px-3 py-2 rounded-xl bg-telecab-card border border-telecab-border
                       hover:border-telecab-gold/40 text-sm transition">
          <i class="fa-solid fa-bolt"></i><span id="btn-evento-txt">Modo eventos</span>
        </button>
        <%# TURNOS POR WHATSAPP Y BLOQUEO DE MOTOR (db/148). Desde el 28/09/2026 todo
            conductor abre turno por WhatsApp; aquí se enciende, persona a persona,
            a quién se le bloquea el motor al terminar. %>
        <button id="btn-fichaje" class="flex items-center gap-2 px-3 py-2 rounded-xl bg-telecab-card border border-telecab-border
                       hover:border-telecab-gold/40 text-sm transition"
                title="Turnos abiertos por WhatsApp y a quién se le bloquea el motor al terminar">
          <i class="fa-solid fa-key"></i><span>Bloqueo de motor</span><span id="btn-fichaje-n" class="text-xs text-telecab-muted"></span>
        </button>
      <% } %>
    </div>
  </div>

  <%# La franja del evento: qué es, hasta cuándo y —lo que de verdad se pregunta—
      a qué hora vuelve el cuadrante a la normalidad. %>
  <div id="franja-evento" class="hidden mb-4"></div>

  <%# Lo planificado A LA FUERZA esta semana: a quién se apartó de qué coche y
      por qué. Tiene que verse sin buscarlo — es lo que explica que el cuadrante
      diga una cosa y la calle otra— y poder deshacerse de un clic. %>
  <div id="franja-relevos" class="hidden mb-4"></div>

  <%# El panel del fichaje. Nace plegado: se abre con el botón «Fichaje». %>
  <div id="panel-fichaje" class="hidden mb-4"></div>

  <%# LAS BASES (05/10/2026, Camilo). El planificador empieza por las cinco bases,
      por nombre (de Alcobendas a Usera), y debajo todos sus cuadrantes, base a
      base y cada una de mejor a peor (iceberg.js). Cada tarjeta dice de un
      vistazo cómo está su base: la barra es su iceberg (completos, con plazas
      vacías, sin nadie) y debajo, lo que le falta. Pincharla deja solo esa. %>
  <style>
    /* Lo que se pulsa nota el dedo: solo transform, rápido y con salida suave.
       Elegir base es de todos los días, así que el cambio de contenido NO se
       anima. Y nada de esto con «menos movimiento». */
    .tc-pulsable { transition: border-color 150ms ease, background-color 150ms ease, color 150ms ease,
                   transform 120ms cubic-bezier(0.23, 1, 0.32, 1); }
    .tc-pulsable:active { transform: scale(0.98); }
    @media (prefers-reduced-motion: reduce) {
      .tc-pulsable { transition: none; }
      .tc-pulsable:active { transform: none; }
    }
    /* «Ver su cuadrante»: el sitio al que se salta se marca un momento con el
       acento, para que el ojo lo encuentre. Se apaga solo. */
    .tc-resalte { outline: 2px solid rgb(var(--tc-gold)); outline-offset: 4px; border-radius: 1rem;
                  transition: outline-color 600ms ease; }
    tr.tc-resalte { outline: none; }
    tr.tc-resalte > td { background: rgb(var(--tc-gold) / 0.12); }
  </style>
  <nav id="bases" aria-label="Bases" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 mb-4"></nav>

  <%# De qué son los números de abajo: de toda la flota o de la base abierta. %>
  <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mb-2">
    <h3 id="k-ambito" class="text-sm font-semibold">Todas las bases</h3>
    <span id="k-ambito-sub" class="text-xs text-telecab-muted tabular-nums"></span>
    <span class="ml-auto"></span>
    <button id="b-sinbase" type="button" class="tc-pulsable hidden items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs border border-telecab-border text-telecab-muted hover:border-telecab-gold/40"
            title="Coches que no están en ningún cuadrante y no tienen base. Para que salgan en una base, mételos en un cuadrante de esa base.">
      <i class="fa-solid fa-circle-question"></i><span></span></button>
    <button id="b-todas" type="button" class="tc-pulsable hidden items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs border border-telecab-border hover:border-telecab-gold/40">
      <i class="fa-solid fa-arrow-left text-[10px]"></i>Todas las bases</button>
  </div>

  <%# Se cuentan PERSONAS, no celdas. "Huecos día 174" no decía si faltaban tres
      personas o treinta; "fijo día 61" sí. Y el correturnos se cuenta UNA vez
      aunque esté repartido entre cuadrantes: L y M con una matrícula y X y J con
      otra son UN correturnos de cuatro días, no dos de dos. Con una base abierta,
      las mismas tarjetas cuentan solo esa base. %>
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 mb-5">
    <div class="bg-telecab-card border border-telecab-border rounded-2xl p-3 shadow-soft">
      <p class="text-xs text-telecab-muted uppercase tracking-wide">Coches</p>
      <p id="k-coches" class="text-xl font-bold mt-1">—</p>
    </div>
    <%# DOS NÚMEROS: el grande es el bruto —quién tiene la plaza en el papel— y el
        pequeño el neto, descontando vacaciones y bajas. Con uno solo, 61 fijos de
        día de los que 5 están de vacaciones se leen como 61 coches saliendo. %>
    <div class="bg-telecab-card border border-telecab-border rounded-2xl p-3 shadow-soft">
      <p class="text-xs text-telecab-muted uppercase tracking-wide">Fijo día</p>
      <p class="mt-1 leading-none"><span id="k-fd" class="text-xl font-bold">—</span>
        <span id="k-fd-n" class="text-sm text-telecab-muted font-semibold ml-1"></span></p>
      <p class="text-[10px] text-telecab-muted mt-1">sin vacaciones ni bajas</p>
    </div>
    <div class="bg-telecab-card border border-telecab-border rounded-2xl p-3 shadow-soft">
      <p class="text-xs text-telecab-muted uppercase tracking-wide">Fijo noche</p>
      <p class="mt-1 leading-none"><span id="k-fn" class="text-xl font-bold">—</span>
        <span id="k-fn-n" class="text-sm text-telecab-muted font-semibold ml-1"></span></p>
      <p class="text-[10px] text-telecab-muted mt-1">sin vacaciones ni bajas</p>
    </div>
    <div class="bg-telecab-card border border-telecab-border rounded-2xl p-3 shadow-soft">
      <p class="text-xs text-telecab-muted uppercase tracking-wide">CT día</p>
      <p class="mt-1 leading-none"><span id="k-ctd" class="text-xl font-bold">—</span>
        <span id="k-ctd-n" class="text-sm text-telecab-muted font-semibold ml-1"></span></p>
      <p class="text-[10px] text-telecab-muted mt-1">con 4 días o más</p>
    </div>
    <div class="bg-telecab-card border border-telecab-border rounded-2xl p-3 shadow-soft">
      <p class="text-xs text-telecab-muted uppercase tracking-wide">CT noche</p>
      <p class="mt-1 leading-none"><span id="k-ctn" class="text-xl font-bold">—</span>
        <span id="k-ctn-n" class="text-sm text-telecab-muted font-semibold ml-1"></span></p>
      <p class="text-[10px] text-telecab-muted mt-1">con 4 días o más</p>
    </div>

    <%# La alerta. Se pincha y dice QUIÉNES son y cómo tienen repartidos los días:
        una cifra sin nombres no se puede arreglar. %>
    <button id="k-flojos-caja" type="button"
            class="text-left bg-telecab-card border border-telecab-border rounded-2xl p-3 shadow-soft
                   hover:border-telecab-red/50 transition">
      <p class="text-xs text-telecab-muted uppercase tracking-wide">CT sin días</p>
      <p class="mt-1 leading-none"><span id="k-flojos" class="text-xl font-bold text-telecab-red">—</span>
        <span id="k-flojos-n" class="text-sm text-telecab-muted font-semibold ml-1"></span></p>
      <p class="text-[10px] text-telecab-muted mt-1">menos de 4 · pincha para verlos</p>
    </button>
    <%# Las dos mitades del mismo problema, separadas a propósito. Un coche SIN
        FIJO no necesita quien lo releve, necesita quien lo lleve: contar sus días
        como "correturnos que faltan" daba 53 cuando de verdad son 16. %>
    <div class="bg-telecab-card border border-telecab-border rounded-2xl p-3 shadow-soft">
      <p class="text-xs text-telecab-muted uppercase tracking-wide">Fijos que faltan</p>
      <p id="k-fijofalta" class="text-xl font-bold mt-1 text-telecab-gold">—</p>
      <p id="k-fijofalta-sub" class="text-[10px] text-telecab-muted mt-1">plazas de fijo vacías</p>
    </div>
    <div class="bg-telecab-card border border-telecab-border rounded-2xl p-3 shadow-soft">
      <p class="text-xs text-telecab-muted uppercase tracking-wide">CT que faltan</p>
      <p id="k-ct" class="text-xl font-bold mt-1 text-telecab-gold">—</p>
      <p id="k-ct-sub" class="text-[10px] text-telecab-muted mt-1">solo de coches con su fijo</p>
    </div>
    <div class="bg-telecab-card border border-telecab-border rounded-2xl p-3 shadow-soft">
      <p class="text-xs text-telecab-muted uppercase tracking-wide">Huérfanos</p>
      <p id="k-huerf" class="text-xl font-bold mt-1 text-telecab-red">—</p>
    </div>
    <div class="bg-telecab-card border border-telecab-border rounded-2xl p-3 shadow-soft">
      <p class="text-xs text-telecab-muted uppercase tracking-wide">Banquillo</p>
      <p id="k-banq" class="text-xl font-bold mt-1">—</p>
    </div>
  </div>

  <!-- Búsqueda + vista + avisos. La base se elige arriba, en sus tarjetas. -->
  <div class="flex flex-wrap items-center gap-2 mb-3">
    <div class="relative">
      <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-telecab-muted text-xs"></i>
      <input id="f-busca" type="search" placeholder="Buscar conductor o matrícula…"
             title="Sin base abierta, busca en todas."
             class="pl-8 pr-3 py-2 w-56 bg-telecab-card border border-telecab-border rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-telecab-gold/40">
    </div>
    <%# DOS VISTAS. Horizontal: una fila por coche y las plazas en columnas, con
        todo el detalle (teléfono, zona de casa, libranza excepcional). Vertical:
        cada coche es una tarjeta con sus plazas apiladas —día a la izquierda,
        noche a la derecha—, para ver más coches de un golpe. La elección se
        recuerda en el navegador. %>
    <div id="f-vista" role="group" aria-label="Vista del cuadrante"
         class="inline-flex p-0.5 rounded-xl bg-telecab-card border border-telecab-border">
      <button type="button" data-vista="horizontal" aria-pressed="true"
              title="Horizontal: una fila por coche y sus plazas en columnas, con todo el detalle."
              class="tc-pulsable flex items-center gap-1.5 px-2.5 py-1.5 rounded-[10px] text-sm">
        <i class="fa-solid fa-grip-lines text-xs"></i><span>Horizontal</span></button>
      <button type="button" data-vista="vertical" aria-pressed="false"
              title="Vertical: cada coche en una tarjeta, con sus plazas apiladas (día a la izquierda, noche a la derecha). Caben más coches a la vista."
              class="tc-pulsable flex items-center gap-1.5 px-2.5 py-1.5 rounded-[10px] text-sm">
        <i class="fa-solid fa-grip-lines-vertical text-xs"></i><span>Vertical</span></button>
    </div>
    <label class="flex items-center gap-2 text-sm text-telecab-muted ml-1">
      <input type="checkbox" id="f-huecos" class="accent-telecab-gold"> Solo con huecos
    </label>
    <% if (puedeEditar) { %>
    <button id="btn-nuevo-cua" class="flex items-center gap-2 px-3 py-2 rounded-xl bg-telecab-gold text-telecab-dark font-semibold text-sm shadow-gold">
      <i class="fa-solid fa-plus"></i>Nuevo cuadrante
    </button>
    <% } %>
    <button id="btn-avisos" class="ml-auto hidden items-center gap-2 px-3 py-2 rounded-xl bg-telecab-warn/10 border border-telecab-warn/30 text-telecab-warn text-sm">
      <i class="fa-solid fa-triangle-exclamation"></i><span id="btn-avisos-n">0</span> avisos
    </button>
  </div>

  <div class="flex flex-col xl:flex-row gap-4">

    <!-- ══════════ El cuadrante ══════════ -->
    <div class="flex-1 min-w-0">
      <div id="incorporaciones" class="hidden mb-3 space-y-2"></div>
      <div id="avisos" class="hidden mb-3"></div>
      <div id="cuadrante" class="space-y-6"></div>
      <div id="vacio" class="hidden p-10 text-center text-telecab-muted border border-telecab-border rounded-2xl">
        No hay coches que coincidan.
      </div>
    </div>

    <!-- ══════════ Columna lateral: huérfanos, emergencia, banquillo ══════════ -->
    <aside class="xl:w-80 shrink-0 space-y-4">
      <section id="panel-huerfanos" class="hidden bg-telecab-red/5 border border-telecab-red/30 rounded-2xl p-4">
        <h3 class="font-semibold text-sm text-telecab-red flex items-center gap-2 mb-2">
          <i class="fa-solid fa-user-slash"></i>Huérfanos (sin coche)
        </h3>
        <div id="huerfanos" class="space-y-1.5"></div>
      </section>

      <section id="panel-emergencia" class="hidden bg-telecab-card border border-telecab-border rounded-2xl p-4">
        <h3 class="font-semibold text-sm flex items-center gap-2 mb-2">
          <i class="fa-solid fa-car-burst text-telecab-gold"></i>Coches de emergencia
        </h3>
        <div id="emergencia" class="flex flex-wrap gap-1.5"></div>
      </section>

      <%# LAS PRÓXIMAS INCORPORACIONES (06/10/2026): quién entra en un coche de hoy
          en adelante siendo NUEVO, o volviendo de vacaciones o de baja médica a
          OTRO cuadrante (quien vuelve a lo suyo no sale). Al pinchar un nombre, su
          número, cuadrante, base, puesto y fecha, y «Ver su cuadrante». Con una
          base abierta, solo los de esa base; sin nadie, no sale. %>
      <section id="panel-llegadas" class="hidden bg-telecab-card border border-telecab-border rounded-2xl p-4">
        <h3 class="font-semibold text-sm flex items-center gap-2 mb-2"
            title="Quién entra en un coche de hoy en adelante:&#10;· gente nueva (su primera plaza en este contrato);&#10;· quien vuelve de vacaciones o de baja médica, solo si le han cambiado de cuadrante mientras estaba fuera.&#10;Pincha un nombre para ver su número, su cuadrante y cuándo entra.">
          <i class="fa-solid fa-user-plus text-telecab-gold"></i>Próximas incorporaciones
          <span id="llegadas-n" class="ml-auto text-xs text-telecab-muted"></span>
        </h3>
        <div id="llegadas" class="space-y-1.5 max-h-[40vh] overflow-y-auto pr-1"></div>
      </section>

      <%# LAS BAJAS DE LOS ÚLTIMOS 5 DÍAS (29/09/2026): quién se ha ido de la
          empresa. Al pinchar un nombre se despliega el motivo. Cuenta desde hoy,
          mires la semana que mires; sin nadie, no sale, como los huérfanos. %>
      <section id="panel-bajas" class="hidden bg-telecab-card border border-telecab-border rounded-2xl p-4">
        <h3 class="font-semibold text-sm flex items-center gap-2 mb-2"
            title="Conductores que han causado baja en la empresa en los últimos días, contando hoy.&#10;No salen los que tienen otro contrato abierto: quien pasa de ETT a plantilla o vuelve no se ha ido.&#10;Pincha un nombre para ver el motivo.">
          <i class="fa-solid fa-user-minus text-telecab-muted"></i><span id="bajas-tit">Bajas · últimos 5 días</span>
          <span id="bajas-n" class="ml-auto text-xs text-telecab-muted"></span>
        </h3>
        <div id="bajas" class="space-y-1.5 max-h-[40vh] overflow-y-auto pr-1"></div>
      </section>

      <section class="bg-telecab-card border border-telecab-border rounded-2xl p-4">
        <h3 class="font-semibold text-sm flex items-center gap-2 mb-2">
          <i class="fa-solid fa-users text-telecab-muted"></i>Banquillo
          <span id="banq-n" class="ml-auto text-xs text-telecab-muted"></span>
        </h3>
        <input id="banq-busca" type="search" placeholder="Buscar…"
               class="w-full mb-2 px-3 py-1.5 bg-telecab-card2 border border-telecab-border rounded-lg text-sm">
        <div class="flex items-center gap-1.5 mb-2">
          <button data-banq-tab="todos" class="banq-tab px-2.5 py-1 rounded-lg text-xs font-semibold border transition">Todos</button>
          <button data-banq-tab="ett" class="banq-tab px-2.5 py-1 rounded-lg text-xs font-semibold border transition">Solo ETT</button>
          <button data-banq-tab="propios" class="banq-tab px-2.5 py-1 rounded-lg text-xs font-semibold border transition">Sin ETT</button>
        </div>
        <div id="banquillo" class="space-y-1 max-h-[60vh] overflow-y-auto pr-1"></div>
      </section>

      <!-- Fuera del banquillo a propósito: no se pueden planificar hoy, pero
           tienen que verse. Antes los de vacaciones salían mezclados con quien
           sí se podía colocar, y los de baja médica no salían en ninguna parte. -->
      <section id="panel-vuelven" class="hidden bg-telecab-card border border-telecab-border rounded-2xl p-4">
        <h3 class="font-semibold text-sm flex items-center gap-2 mb-2">
          <i class="fa-solid fa-plane-arrival text-telecab-gold"></i>Vuelven
          <span id="vuelven-n" class="ml-auto text-xs text-telecab-muted"></span>
        </h3>
        <div id="vuelven" class="space-y-1 max-h-[30vh] overflow-y-auto pr-1"></div>
      </section>

      <section id="panel-sinfecha" class="hidden bg-telecab-card border border-telecab-border rounded-2xl p-4">
        <h3 class="font-semibold text-sm flex items-center gap-2 mb-2">
          <i class="fa-solid fa-user-injured text-telecab-muted"></i>Sin fecha de vuelta
          <span id="sinfecha-n" class="ml-auto text-xs text-telecab-muted"></span>
        </h3>
        <div id="sinfecha" class="space-y-1 max-h-[30vh] overflow-y-auto pr-1"></div>
      </section>

      <section class="bg-telecab-card border border-telecab-border rounded-2xl p-4">
        <h3 class="font-semibold text-sm flex items-center gap-2 mb-1">
          <i class="fa-solid fa-hourglass-half text-telecab-gold"></i>Fin de periodo de prueba
          <span id="prueba-n" class="ml-auto text-xs text-telecab-muted"></span>
        </h3>
        <p class="text-[11px] text-telecab-muted mb-2">Los 3 meses desde el alta, del más próximo al más lejano.</p>
        <div id="prueba-lista" class="space-y-1 max-h-72 overflow-y-auto pr-1"></div>
      </section>
    </aside>
  </div>
</div>

<script>
(function () {
  // ── SOLO LECTURA ──────────────────────────────────────────────────────────
  // El candado DE VERDAD esta en el servidor: cualquier peticion al
  // planificador que no sea un GET exige el permiso '/planificador/editar'.
  // Esto de aqui es para que la pantalla no mienta.
  //
  // Se envuelve `fetch` en vez de apagar los botones uno a uno a proposito: en
  // este cuadrante se escribe desde treinta sitios —arrastrar una persona, el
  // menu de un coche, el panel de eventos, los relevos— y una lista de botones
  // se queda corta el dia que se añada el treinta y uno. Asi cualquier camino
  // que intente escribir se para en el mismo sitio y con el mismo aviso.
  const PUEDE_EDITAR = <%- JSON.stringify(!!puedeEditar) %>;
  if (!PUEDE_EDITAR) {
    const fetchReal = window.fetch.bind(window);
    let avisando = false;
    window.fetch = function (url, opciones) {
      const metodo = String((opciones && opciones.method) || 'GET').toUpperCase();
      if (metodo === 'GET') return fetchReal(url, opciones);
      if (!avisando) {
        avisando = true;
        Promise.resolve(Dialogo.aviso({
          titulo: 'Solo lectura', tono: 'aviso',
          html: '<p>Puedes mirar el cuadrante, pero no cambiarlo.</p>' +
                '<p class="mt-2 text-sm text-telecab-muted">Si necesitas planificar, pide el permiso ' +
                '<b>Planificador · editar</b> a quien lleve los usuarios.</p>',
        })).catch(() => {}).then(() => { avisando = false; });
      }
      return Promise.resolve(new Response(
        JSON.stringify({ status: 'error', msg: 'Solo lectura' }),
        { status: 403, headers: { 'Content-Type': 'application/json' } }));
    };
  }

  const DIAS_LETRA = <%- JSON.stringify(letrasDia) %>;              // ['L','M','X','J','V','S','D']
  const ESTADOS = <%- JSON.stringify(estadosVehiculo) %>;           // catálogo de estados del coche
  const ESTADO_ETQ = new Map(ESTADOS.map(e => [e.codigo, e.etiqueta]));
  const esc = s => String(s == null ? '' : s).replace(/[&<>"']/g, c =>
    ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

  // Tono del estado del coche. El operativo en verde; lo que sale de cobertura,
  // en rojo/ámbar. Se lee del catálogo (es_operativo), no de una lista fija.
  const TONO_ESTADO = { O: 'green', R: 'gold', T: 'violet', X: 'warn', S: 'red', E: 'gold', B: 'muted', P: 'azul' };
  const tonoEstado = cod => TONO_ESTADO[cod] || 'muted';

  let T = null;                       // el tablero que llega del servidor
  let AV = null;                      // avisos de turnos de la semana mirada (semáforo por cuadrante)
  let DIA = null;                     // fecha efectiva (AAAA-MM-DD)
  const porId = new Map();            // conductor id -> conductor

  // LA BASE ABIERTA ('' = ninguna: se ven las bases y las tarjetas de toda la
  // flota). Es la `clave` de `resumen.porZona`: el id de la base, o 'sin' para
  // los coches que no tienen ninguna. Viaja en la dirección (#base=getafe) para
  // que recargar o pasar el enlace abra la misma base, y «atrás» vuelva a las bases.
  let ZONA = '';
  let ZONA_PEDIDA = null;             // la de la dirección, hasta que llegue el tablero
  // LA VISTA: 'horizontal' (una fila por coche) o 'vertical' (una tarjeta por
  // coche). Se recuerda en este navegador; si no se puede, se queda en horizontal.
  let VISTA = 'horizontal';
  try { if (localStorage.getItem('planificador-vista') === 'vertical') VISTA = 'vertical'; } catch (_) {}

  const $ = s => document.querySelector(s);
  const pad = n => String(n).padStart(2, '0');
  const hoyISO = () => { const d = new Date(); return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`; };
  const isoAes = iso => { const [a, m, d] = iso.split('-'); return `${d}/${m}/${a}`; };
  const esAiso = txt => { const m = String(txt || '').match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/); return m ? `${m[3]}-${pad(m[2])}-${pad(m[1])}` : ''; };
  const sumarDias = (iso, n) => { const d = new Date(iso + 'T00:00:00'); d.setDate(d.getDate() + n); return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`; };

  /** [1,3] -> "L X". Vacío si no hay. */
  const diasTexto = arr => (arr || []).map(d => DIAS_LETRA[d - 1]).join(' ');
  /** libra[] (booleanos por día) -> "L M". */
  const libraTexto = libra => (libra || []).map((v, i) => v ? DIAS_LETRA[i] : null).filter(Boolean).join(' ');

  // ── Cargar ────────────────────────────────────────────────────────────────
  async function cargar(dia) {
    const q = dia ? ('?dia=' + encodeURIComponent(dia)) : '';
    const r = await fetch('/planificador-v2/api/tablero' + q);
    const j = await r.json();
    if (!r.ok || j.status === 'error') throw new Error(j.msg || 'No se pudo cargar el cuadrante');
    aplicar(j);
  }

  // ── Incorporaciones: la alerta que NO se va hasta aceptarla o rechazarla ──
  // Alguien se dio de alta con una vacante del generador. Aceptar lo coloca en
  // las plazas de la vacante (todo o nada); rechazar lo deja en el banquillo.
  async function cargarIncorporaciones() {
    let lista = [];
    try {
      const r = await (await fetch('/planificador-v2/api/incorporaciones')).json();
      lista = r.incorporaciones || [];
    } catch (_) {}
    const cont = $('#incorporaciones');
    cont.classList.toggle('hidden', !lista.length);
    cont.innerHTML = lista.map(i => {
      const det = i.detalle || {};
      const mats = (det.matriculas || []).map(m =>
        `<span class="font-mono">${esc(m.m)}</span> <span class="text-telecab-muted">(${esc(m.letras || '')}${m.zona ? ' · ' + esc(m.zona) : ''})</span>`).join(' + ');
      // SIN VACANTE NO HAY NADA QUE ACEPTAR: no se le prometió ninguna plaza, así
      // que no hay un «todo o nada» que colocar. El aviso solo dice que hay
      // alguien nuevo sin coche, y se va solo en cuanto se le dé una plaza.
      const sinVacante = !i.vacanteId;
      return `<div class="px-4 py-3 rounded-2xl border ${sinVacante ? 'border-telecab-border' : 'border-telecab-gold/50'} ${sinVacante ? 'bg-telecab-card2/60' : 'bg-telecab-gold/10'} flex flex-wrap items-center gap-3">
        <i class="fa-solid ${sinVacante ? 'fa-user-plus text-telecab-muted' : 'fa-bell text-telecab-gold'}"></i>
        <div class="min-w-0 flex-1">
          <div class="text-sm font-semibold text-telecab-text"><a href="/plantilla#${encodeURIComponent(i.conductorId)}" title="Abrir su ficha en Plantilla"
              class="hover:text-telecab-gold hover:underline underline-offset-2">${esc(i.nombre)}<i class="fa-solid fa-arrow-up-right-from-square text-[10px] ml-1.5 text-telecab-muted"></i></a>
            ${i.telefono ? `<span class="font-mono font-normal text-xs text-telecab-muted ml-1">${esc(i.telefono)}</span>` : ''}
            <span class="font-normal text-telecab-muted">— ${sinVacante ? 'se dio de alta' : 'incorporación'}${i.alta ? ' · alta ' + isoAes(i.alta) : ''}</span></div>
          <div class="text-xs text-telecab-muted mt-0.5">${sinVacante
            ? 'Sin plaza prometida: dale una en el cuadrante y este aviso desaparece.'
            : esc(det.puesto || '') + (mats ? ' → ' + mats : '')}</div>
        </div>
        ${sinVacante ? '' : `<button data-inc-ok="${esc(i.id)}" class="px-3 py-1.5 rounded-lg bg-telecab-gold text-telecab-dark text-xs font-semibold whitespace-nowrap">
          <i class="fa-solid fa-check mr-1"></i>Aceptar y colocar</button>
        <button data-inc-no="${esc(i.id)}" class="px-3 py-1.5 rounded-lg border border-telecab-border text-xs text-telecab-muted hover:border-telecab-red hover:text-telecab-red whitespace-nowrap">
          Rechazar</button>`}
      </div>`;
    }).join('');
    cont.querySelectorAll('[data-inc-ok]').forEach(b => b.addEventListener('click', async () => {
      b.disabled = true;
      try {
        const r = await fetch('/planificador-v2/api/incorporaciones/' + b.dataset.incOk + '/aceptar', {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ dia: DIA }) });
        const j = await r.json();
        if (j.status !== 'ok') throw new Error(j.msg || 'No se pudo colocar');
        if (j.tablero) aplicar(j.tablero);
        else cargar(DIA);
      } catch (e) {
        b.disabled = false;
        await Dialogo.aviso({ titulo: 'No se pudo colocar', texto: e.message + ' La alerta se queda hasta que lo resuelvas (o recházala y colócalo a mano).', tono: 'error' });
      }
    }));
    cont.querySelectorAll('[data-inc-no]').forEach(b => b.addEventListener('click', async () => {
      const v = await Dialogo.formulario('Rechazar la incorporación', [
        { id: 'motivo', etiqueta: 'Motivo (opcional)', tipo: 'texto' },
      ], { textoBoton: 'Rechazar', nota: 'El conductor queda en el banquillo para colocarlo a mano y la vacante vuelve a Abierta.' });
      if (v == null) return;
      try {
        const r = await fetch('/planificador-v2/api/incorporaciones/' + b.dataset.incNo + '/rechazar', {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ motivo: v.motivo || '' }) });
        const j = await r.json();
        if (j.status !== 'ok') throw new Error(j.msg || 'No se pudo rechazar');
        cargarIncorporaciones();
      } catch (e) {
        await Dialogo.aviso({ titulo: 'No se pudo rechazar', texto: e.message, tono: 'error' });
      }
    }));
  }

  function aplicar(j) {
    T = j;
    DIA = j.dia;
    porId.clear();
    (j.conductores || []).forEach(c => { if (c.id) porId.set(String(c.id), c); });
    $('#f-dia').value = isoAes(j.dia);
    // La base de la dirección se resuelve cuando ya se sabe qué bases hay; y si
    // la abierta desaparece (los coches sin base se colocaron), se vuelve a todas.
    if (ZONA_PEDIDA != null) { ZONA = claveDeNombre(ZONA_PEDIDA); ZONA_PEDIDA = null; }
    if (ZONA && !baseActual()) ZONA = '';
    pintarBases();
    pintarKpis();
    pintarEvento();
    pintarRelevos();
    pintarContadorFichaje();
    if (fjAbierto) pintarFichaje();
    pintar();
    pintarLaterales();
    pintarPrueba();
    pintarAvisos(j.avisos || []);
    cargarIncorporaciones();
    cargarAvisosTurnos();
  }

  // ══════════ MODO EVENTOS ══════════
  //
  // Un evento abre las dos plazas de refuerzo (CT2 día y noche) y se cierra
  // SOLO. La hora de cierre no es la del papel: es la del final del ÚLTIMO turno
  // planificado en refuerzo, y los turnos de noche mueren a las 05:00 del día
  // siguiente. Esa frase es lo que va en la franja, porque es la pregunta que se
  // hace Tráfico ("¿y cuándo vuelve esto a la normalidad?").

  const horaLarga = ts => new Date(ts).toLocaleString('es-ES', {
    weekday: 'long', day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit', hour12: false });

  function pintarEvento() {
    const caja = $('#franja-evento');
    const ev = (T.eventos || {}).vigente;
    // En solo lectura el boton de eventos no esta en la pagina, pero la FRANJA
    // si se pinta: saber que hay un evento abierto es mirar, no tocar.
    const btn = $('#btn-evento');
    if (btn) {
      $('#btn-evento-txt').textContent = ev ? ev.nombre : 'Modo eventos';
      btn.classList.toggle('bg-telecab-gold', !!ev);
      btn.classList.toggle('text-telecab-dark', !!ev);
      btn.classList.toggle('font-semibold', !!ev);
      btn.classList.toggle('border-telecab-gold', !!ev);
    }

    if (!ev) { caja.classList.add('hidden'); caja.innerHTML = ''; return; }
    caja.classList.remove('hidden');
    const enRefuerzo = ev.genteRefuerzo || 0;
    caja.innerHTML = `
      <div class="rounded-2xl border border-telecab-gold/40 bg-telecab-gold/10 px-4 py-3 flex flex-wrap items-center gap-x-4 gap-y-2">
        <span class="flex items-center gap-2 font-bold text-telecab-gold">
          <i class="fa-solid fa-bolt"></i>${esc(ev.nombre)}</span>
        <span class="text-sm">${isoAes(ev.desde)} → ${isoAes(ev.hasta)}</span>
        <span class="text-sm text-telecab-muted">Refuerzo abierto: <b class="text-telecab-text">CT día 2</b>
          y <b class="text-telecab-text">CT noche 2</b>${enRefuerzo ? ` · ${enRefuerzo} persona(s)` : ' · sin nadie todavía'}</span>
        <span class="text-sm ${ev.alargado ? 'text-telecab-warn' : 'text-telecab-muted'}">
          <i class="fa-solid fa-clock text-[11px]"></i>
          vuelve a la normalidad el <b>${esc(horaLarga(ev.cierraAt))}</b>${
            ev.alargado ? ' <span class="text-[11px]">(el último turno de refuerzo acaba después del evento)</span>' : ''}</span>
        ${ev.nota ? `<span class="text-[11px] text-telecab-muted italic">${esc(ev.nota)}</span>` : ''}
        <span class="ml-auto flex items-center gap-2">
          <button data-ev-wa class="px-2.5 py-1.5 rounded-lg bg-telecab-card border border-telecab-border text-xs hover:border-telecab-gold/50"
                  title="Ver el WhatsApp que recibe un conductor durante el evento, antes de mandarlo">
            <i class="fa-brands fa-whatsapp"></i> Ver aviso</button>
          <button data-ev-editar class="px-2.5 py-1.5 rounded-lg bg-telecab-card border border-telecab-border text-xs hover:border-telecab-gold/50">
            <i class="fa-solid fa-pen"></i> Fechas</button>
          <button data-ev-volver class="px-2.5 py-1.5 rounded-lg bg-telecab-card border border-telecab-border text-xs hover:border-telecab-gold/50"
                  title="Devolver el cuadrante a como estaba antes del evento (se hace solo a las 05:10, esto es para adelantarlo)">
            <i class="fa-solid fa-rotate-left"></i> Volver ya</button>
          <button data-ev-cancelar class="px-2.5 py-1.5 rounded-lg bg-telecab-red/10 border border-telecab-red/40 text-telecab-red text-xs">
            <i class="fa-solid fa-xmark"></i> Cancelar</button>
        </span>
      </div>
      ${(ev.ultimos || []).length ? `
        <p class="text-[11px] text-telecab-muted mt-1.5 pl-1">Último en salir:
          ${esc(ev.ultimos[0].conductor)} · ${esc(ev.ultimos[0].matricula)} ·
          ${esc(ev.ultimos[0].turno)} del ${isoAes(ev.ultimos[0].dia)}</p>` : ''}`;
    caja.querySelector('[data-ev-editar]').addEventListener('click', () => editarEvento(ev));
    caja.querySelector('[data-ev-cancelar]').addEventListener('click', () => cancelarEvento(ev));
    caja.querySelector('[data-ev-volver]').addEventListener('click', () => volverEvento(ev));
    caja.querySelector('[data-ev-wa]').addEventListener('click', () => verAvisoEvento(ev));
  }

  /**
   * EL WHATSAPP DEL EVENTO, ANTES DE MANDARLO.
   *
   * Durante un evento, "Ver mis turnos" no contesta con el cuadro de siempre:
   * contesta con los días del apaño, a quién entrega el coche al terminar y su
   * semana normal siguiente. Esto lo enseña tal cual, para poder leerlo antes de
   * que lo lean cien personas.
   */
  async function verAvisoEvento(ev) {
    const ejemplo = ((ev.ultimos || [])[0] || {});
    const v = await Dialogo.formulario('Ver el aviso de un conductor', [
      { id: 'telefono', etiqueta: 'Teléfono del conductor', tipo: 'texto', obligatorio: true,
        marcador: '6XXXXXXXX',
        ayuda: ejemplo.conductor ? `Por ejemplo, el de ${ejemplo.conductor}.` : 'El de cualquiera del cuadrante.' },
    ], { textoBoton: 'Ver el mensaje', ancho: 'max-w-md' });
    if (!v) return;
    try {
      const r = await fetch('/planificador-v2/api/eventos/mensaje?telefono=' + encodeURIComponent(v.telefono));
      const j = await r.json();
      if (!r.ok || j.status === 'error') throw new Error(j.msg || 'No se pudo');
      if (!j.mensaje) {
        await Dialogo.aviso({ titulo: 'Sin mensaje de evento', tono: 'aviso',
          texto: 'Con ese teléfono no sale el aviso del evento: o no lo reconozco, o no hay evento vivo. ' +
            'Recibiría el mensaje normal de turnos.' });
        return;
      }
      await Dialogo.aviso({
        titulo: 'Esto es lo que recibe por WhatsApp', ancho: 'max-w-lg',
        html: '<pre class="whitespace-pre-wrap text-[13px] leading-relaxed bg-telecab-card2/60 ' +
          'border border-telecab-border rounded-xl p-3">' + esc(j.mensaje.texto) + '</pre>',
      });
    } catch (e) { await Dialogo.aviso({ titulo: 'No se ha podido', texto: e.message, tono: 'error' }); }
  }

  async function volverEvento(ev) {
    const ok = await Dialogo.confirmar({
      titulo: `¿Devolver el cuadrante a como estaba antes de "${ev.nombre}"?`,
      texto: 'Los apaños del evento se cierran y cada plaza vuelve a quien la tenía en la foto de antes. ' +
        'Lo ya trabajado no se toca. Esto pasa solo a las 05:10; el botón es para adelantarlo.',
      si: 'Devolver ya', tono: 'aviso' });
    if (!ok) return;
    try {
      const j = await pedirTablero(`/planificador-v2/api/eventos/${ev.id}/restaurar`, { dia: DIA });
      await Dialogo.aviso({ titulo: 'Cuadrante devuelto a la normalidad', tono: 'ok',
        texto: j.arreglos.length
          ? `${j.arreglos.length} plaza(s) recolocadas: ` +
            j.arreglos.slice(0, 6).map(a => `${a.matricula} → ${a.vuelve}`).join(', ') +
            (j.arreglos.length > 6 ? '…' : '')
          : 'No hizo falta mover nada: cada apaño ya tenía su fecha de vuelta puesta.' });
    } catch (e) { await Dialogo.aviso({ titulo: 'No se ha podido', texto: e.message, tono: 'error' }); }
  }

  /** Lo planificado a la fuerza esta semana, con quién lo hizo y por qué. */
  function pintarRelevos() {
    const caja = $('#franja-relevos');
    const lista = T.relevos || [];
    if (!lista.length) { caja.classList.add('hidden'); caja.innerHTML = ''; return; }
    caja.classList.remove('hidden');
    caja.innerHTML = `
      <div class="rounded-2xl border border-telecab-warn/40 bg-telecab-warn/5 px-4 py-3">
        <p class="text-sm font-semibold text-telecab-warn mb-2">
          <i class="fa-solid fa-user-xmark"></i> ${lista.length} planificación(es) a la fuerza esta semana
          <span class="font-normal text-telecab-muted">· en Control saldrá quien de verdad conduce</span></p>
        <div class="space-y-1.5">
          ${lista.map(r => `
            <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm" data-rel="${esc(r.id)}">
              <span class="font-mono text-xs text-telecab-muted w-20">${isoAes(r.dia)}</span>
              <span class="font-semibold">${esc(r.matricula)}</span>
              <span class="text-xs text-telecab-muted">${esc(r.turnoCodigo === 'noche' ? 'noche' : 'día')}</span>
              <span><span class="line-through text-telecab-muted">${esc(r.sale)}</span>
                <i class="fa-solid fa-arrow-right-long text-telecab-gold text-[10px] mx-1"></i>
                <b>${esc(r.entra)}</b></span>
              <span class="text-xs text-telecab-muted italic">«${esc(r.motivo)}»${r.quien ? ' — ' + esc(r.quien) : ''}</span>
              <button data-deshacer class="ml-auto px-2 py-0.5 rounded-lg border border-telecab-border text-[11px] text-telecab-muted hover:text-telecab-text">
                deshacer</button>
            </div>`).join('')}
        </div>
      </div>`;
    caja.querySelectorAll('[data-rel]').forEach(el => {
      const r = lista.find(x => x.id === el.dataset.rel);
      el.querySelector('[data-deshacer]').addEventListener('click', async () => {
        const ok = await Dialogo.confirmar({
          titulo: `¿${r.sale} vuelve a conducir ${r.matricula} el ${isoAes(r.dia)}?`,
          texto: 'Se deshace el apartado. El cuadrante vuelve a mandar ese día.', tono: 'aviso' });
        if (!ok) return;
        try { await pedirTablero(`/planificador-v2/api/relevo/${r.id}/quitar`, { dia: DIA }); }
        catch (e) { await Dialogo.aviso({ titulo: 'No se ha podido', texto: e.message, tono: 'error' }); }
      });
    });
  }

  async function abrirEvento() {
    const ev = (T.eventos || {}).vigente;
    if (ev) { await editarEvento(ev); return; }
    const v = await Dialogo.formulario('Modo eventos', [
      { id: 'nombre', etiqueta: 'Qué evento es', tipo: 'texto', obligatorio: true,
        marcador: 'F1 Madrid, Marcha del Orgullo, concierto…' },
      { id: 'desde', etiqueta: 'Desde', tipo: 'fecha', obligatorio: true, valor: isoAes(DIA) },
      { id: 'hasta', etiqueta: 'Hasta', tipo: 'fecha', obligatorio: true },
      { id: 'nota', etiqueta: 'Nota (opcional)', tipo: 'texto' },
    ], {
      textoBoton: 'Abrir el refuerzo', ancho: 'max-w-lg', columnas: 2,
      nota: 'Se abren CT día 2 y CT noche 2 en todos los coches. Se cierran SOLAS cuando termine el último ' +
        'turno planificado en ellas: si el último es de noche, a las 05:00 del día siguiente.',
    });
    if (!v) return;
    try {
      const j = await pedirTablero('/planificador-v2/api/eventos', {
        nombre: v.nombre, desde: v.desde, hasta: v.hasta, nota: v.nota,
      });
      const nuevo = (j.tablero.eventos || {}).vigente;
      await Dialogo.aviso({ titulo: 'Refuerzo abierto', tono: 'ok',
        texto: nuevo
          ? `${nuevo.nombre}: ya puedes colocar gente en CT día 2 y CT noche 2. ` +
            `Vuelve a la normalidad el ${horaLarga(nuevo.cierraAt)}.`
          : 'El evento queda programado; las columnas se abren al llegar la fecha.' });
    } catch (e) { await Dialogo.aviso({ titulo: 'No se ha podido', texto: e.message, tono: 'error' }); }
  }

  async function editarEvento(ev) {
    const v = await Dialogo.formulario(`Fechas de "${ev.nombre}"`, [
      { id: 'nombre', etiqueta: 'Nombre', tipo: 'texto', valor: ev.nombre },
      { id: 'desde', etiqueta: 'Desde', tipo: 'fecha', valor: isoAes(ev.desde) },
      { id: 'hasta', etiqueta: 'Hasta', tipo: 'fecha', valor: isoAes(ev.hasta) },
      { id: 'nota', etiqueta: 'Nota', tipo: 'texto', valor: ev.nota },
    ], { textoBoton: 'Guardar', ancho: 'max-w-lg', columnas: 2,
         nota: 'Alargarlo o acortarlo no borra lo ya planificado en el refuerzo.' });
    if (!v) return;
    try { await pedirTablero(`/planificador-v2/api/eventos/${ev.id}`, { ...v, dia: DIA }); }
    catch (e) { await Dialogo.aviso({ titulo: 'No se ha podido', texto: e.message, tono: 'error' }); }
  }

  async function cancelarEvento(ev) {
    const v = await Dialogo.formulario(`Cancelar "${ev.nombre}"`, [
      { id: 'nota', etiqueta: 'Por qué se cancela', tipo: 'texto-largo', obligatorio: true },
    ], { textoBoton: 'Cancelar el evento', ancho: 'max-w-lg',
         nota: 'Lo ya trabajado se queda. Lo planificado en refuerzo que aún no ha empezado se quita, y lo que ' +
           'está en curso se cierra hoy: si no, quedarían plazas abiertas sin evento que las sostenga.' });
    if (!v) return;
    try {
      const j = await pedirTablero(`/planificador-v2/api/eventos/${ev.id}/cancelar`, { nota: v.nota, dia: DIA });
      await Dialogo.aviso({ titulo: 'Evento cancelado', tono: 'ok',
        texto: `${j.borradas} plaza(s) de refuerzo sin empezar quitadas y ${j.cerradas} cerrada(s).` });
    } catch (e) { await Dialogo.aviso({ titulo: 'No se ha podido', texto: e.message, tono: 'error' }); }
  }

  // ── El semáforo de avisos: qué cuadrantes están avisados y cuáles cambiaron ──
  // Se pide aparte del tablero (es otra pregunta: al registro de envíos) y se
  // repinta cuando llega. Si la semana mirada ya pasó, no hay nada que avisar.
  let _avToken = 0;
  async function cargarAvisosTurnos() {
    const mio = ++_avToken;
    AV = null;
    const off = Math.round((new Date(T.lunes + 'T00:00:00') - new Date(lunesDeIso(hoyISO()) + 'T00:00:00')) / 6048e5);
    if (off < 0 || off > 8) { pintar(); return; }
    try {
      const j = await (await fetch('/cobertura/api/avisos-estado?semana=' + off)).json();
      if (mio !== _avToken) return;                    // llegó tarde: ya se mira otra semana
      if (j.status === 'ok') { AV = j; pintar(); }
    } catch (_) { /* sin registro no hay semáforo, y ya está */ }
  }

  // El chip del cuadrante: VERDE avisado, ROJO cambiado desde el aviso, gris sin
  // avisar. Se decide con la gente que tiene turnos AHORA en estos coches: si a
  // alguien le cambió la semana después del aviso (o entró alguien sin avisar),
  // el aviso ya no vale y toca reenviar.
  function chipAvisoCuadrante(lista) {
    if (!AV || !AV.conductores) return '';
    const conTurnos = new Set(AV.conTurnos || []);
    const ids = [...new Set(lista.flatMap(c => (c.personas || []).filter(p => p && p.id).map(p => String(p.id))))]
      .filter(id => conTurnos.has(id));
    if (!ids.length) return '';
    const infos = ids.map(id => AV.conductores[id]).filter(Boolean);
    const base = 'inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-semibold border';
    if (!infos.length) {
      return `<span class="${base} border-telecab-border text-telecab-muted" title="A esta gente aún no se le han enviado los turnos de esta semana">
        <i class="fa-regular fa-bell"></i> Sin avisar</span>`;
    }
    const u = infos.reduce((a, b) => (b.ultimoTs > a.ultimoTs ? b : a));
    const cambiados = infos.filter(i => i.cambiado).length;
    const sinAviso = ids.length - infos.length;
    const veces = Math.max(...infos.map(i => i.veces));
    if (cambiados || sinAviso) {
      const que = [cambiados ? `${cambiados} con los turnos CAMBIADOS desde el aviso` : '',
                   sinAviso ? `${sinAviso} sin avisar` : ''].filter(Boolean).join(' y ');
      return `<span class="${base} bg-telecab-red/15 text-telecab-red border-telecab-red/40"
        title="${esc(`El cuadrante cambió después de avisar: ${que}. Último aviso ${u.ultimoAt}${u.ultimoPor ? ' por ' + u.ultimoPor : ''}. Toca volver a enviar los turnos.`)}">
        <i class="fa-solid fa-triangle-exclamation"></i> Cambiado · reavisar</span>`;
    }
    return `<span class="${base} bg-telecab-green/15 text-telecab-green border-telecab-green/40"
      title="${esc(`Avisado ${u.ultimoAt}${u.ultimoPor ? ' por ' + u.ultimoPor : ''} · ${veces} envío(s) · sin cambios desde entonces`)}">
      <i class="fa-solid fa-check"></i> Avisado ${esc(u.ultimoAt)}${u.ultimoPor ? ' · ' + esc(u.ultimoPor) : ''}${veces > 1 ? ` · ×${veces}` : ''}</span>`;
  }

  // ── KPIs y subtítulo ────────────────────────────────────────────────────────
  function pintarKpis() {
    // Con una base abierta, las MISMAS tarjetas con los números de esa base
    // (`resumen.porZona`, iceberg.js), contados con la misma regla que el total.
    const r = resumenActual();
    const b = baseActual();
    $('#k-ambito').textContent = b ? b.zona : 'Todas las bases';
    $('#k-ambito-sub').textContent = b
      ? `${b.cochesTotal} coche${b.cochesTotal === 1 ? '' : 's'} · ${b.cuadrantes} cuadrante${b.cuadrantes === 1 ? '' : 's'}` +
        (b.cochesTotal ? ` · ${fmtH(b.iceberg.horas)} h instaladas esta semana` : '')
      : 'Las tarjetas cuentan toda la flota. Elige una base para ver solo la suya.';
    $('#k-ambito-sub').title = b && b.cochesTotal
      ? 'Horas instaladas: por cada día y turno de la semana, el promedio de horas por día trabajado de quien lo cubre (su calificación), sumado en los coches que ruedan.'
      : '';
    $('#b-todas').classList.toggle('hidden', !ZONA);
    $('#b-todas').classList.toggle('inline-flex', !!ZONA);
    $('#k-coches').textContent = r.coches ?? '—';
    // El bruto grande, el neto al lado. El neto SOLO se pinta si difiere: cuando
    // no hay nadie de vacaciones, repetir el mismo número dos veces es ruido.
    const par = (id, bruto, neto) => {
      $('#' + id).textContent = bruto ?? '—';
      const n = $('#' + id + '-n');
      const hay = bruto != null && neto != null && neto !== bruto;
      n.textContent = hay ? '· ' + neto : '';
      n.title = hay ? `${bruto - neto} de vacaciones o de baja` : '';
    };
    par('k-fd', r.fijoDia, r.fijoDiaNeto);
    par('k-fn', r.fijoNoche, r.fijoNocheNeto);
    par('k-ctd', r.ctDia, r.ctDiaNeto);
    par('k-ctn', r.ctNoche, r.ctNocheNeto);
    par('k-flojos', r.ctFlojos, r.ctFlojosNeto);
    // Quién cuenta sin tener plaza HOY porque llega a una plaza VACÍA (28/09/2026):
    // en el 1194LCK sin fijo, Jonathan ya cuenta; quien llega a una plaza ocupada,
    // no (el 0431MMZ son dos fijos aunque salgan cuatro nombres).
    [['k-fd', 'fijoDia'], ['k-fn', 'fijoNoche'], ['k-ctd', 'ctDia'], ['k-ctn', 'ctNoche']].forEach(([id, k]) => {
      const xs = (r.llegan || []).filter(x => x.tarjeta === k);
      const caja = $('#' + id).closest('div, button');
      if (caja) caja.title = xs.length
        ? 'Incluye a quien llega a una plaza vacía:\n' + xs.map(x => `· ${x.nombre} → ${x.plazas}, desde el ${isoAes(x.desde)}`).join('\n')
        : '';
    });
    // Sin ninguno, la tarjeta deja de gritar: el rojo tiene que significar algo.
    const caja = $('#k-flojos-caja');
    caja.classList.toggle('border-telecab-red/60', (r.ctFlojos || 0) > 0);
    caja.classList.toggle('bg-telecab-red/5', (r.ctFlojos || 0) > 0);
    $('#k-flojos').classList.toggle('text-telecab-red', (r.ctFlojos || 0) > 0);
    $('#k-flojos').classList.toggle('text-telecab-muted', (r.ctFlojos || 0) === 0);
    // Las dos tarjetas cuentan CÓMO QUEDA cada plaza con todo lo ya escrito
    // (28/09/2026): vacía hoy con su próximo dueño planificado no falta, llega;
    // ocupada hoy por alguien que se va sin relevo, sí falta. Debajo se dice
    // cuántas de cada; al pasar el ratón, quién, dónde y cuándo.
    const plan = r.planificados || [], van = r.seVan || [];
    const de = (xs, rol) => xs.filter(p => p.rol === rol);
    const lineaPlan = p => `· ${p.matricula} ${String(p.turno || '').toLowerCase()} → ${p.nombre}, desde el ${isoAes(p.desde)}` +
      (p.dias ? ` (${p.dias} días)` : '');
    const lineaVa = p => `· ${p.matricula} ${String(p.turno || '').toLowerCase()}: ${p.nombre} hasta el ${isoAes(p.hasta)}`;
    const detalle = rol => [
      de(plan, rol).length ? `${de(plan, rol).length} ya planificada(s)` : '',
      de(van, rol).length ? `${de(van, rol).length} se queda(n) vacía(s)` : '',
    ].filter(Boolean).join(' · ');
    const ayuda = rol => (de(plan, rol).length ? '\n\nNo cuentan, porque ya tienen a alguien planificado:\n' + de(plan, rol).map(lineaPlan).join('\n') : '') +
      (de(van, rol).length ? '\n\nSí cuentan, aunque hoy estén ocupadas, porque se quedan sin nadie:\n' + de(van, rol).map(lineaVa).join('\n') : '');
    const fijoFalta = (r.fijosQueFaltanDia || 0) + (r.fijosQueFaltanNoche || 0);
    $('#k-fijofalta').textContent = fijoFalta;
    $('#k-fijofalta-sub').textContent = ['plazas de fijo sin nadie', detalle('FIJO')].filter(Boolean).join(' · ');
    $('#k-fijofalta').parentElement.title =
      `${r.fijosQueFaltanDia || 0} de día y ${r.fijosQueFaltanNoche || 0} de noche: plazas de fijo sin nadie, ` +
      'contando lo que ya está planificado para más adelante.' + ayuda('FIJO');
    const ctFalta = (r.ctQueFaltanDia || 0) + (r.ctQueFaltanNoche || 0);
    $('#k-ct').textContent = ctFalta;
    $('#k-ct-sub').textContent = ['solo de coches con su fijo', detalle('CT')].filter(Boolean).join(' · ');
    $('#k-ct').parentElement.title =
      `${r.ctQueFaltanDia || 0} de día y ${r.ctQueFaltanNoche || 0} de noche. ` +
      'Son los días que libra un fijo y NADIE tiene escritos en su cuadrante, contando lo que ya está planificado ' +
      'para más adelante, a seis días por correturnos. No mira la semana que tengas abierta: un día ya pasado no es un hueco. ' +
      'Y solo de coches que tienen su fijo (o lo tienen planificado): un coche sin fijo necesita un fijo, no un correturnos.' + ayuda('CT');
    $('#k-huerf').textContent = b ? (r.huerfanos || 0) : (T.huerfanos || []).length;
    $('#k-banq').textContent = (T.pendientes || []).length;
    // La gente no tiene base hasta que se le da coche: el banquillo es de todas.
    $('#k-banq').parentElement.title = b ? 'El banquillo es de todas las bases: la gente no tiene base hasta que se le da un coche.' : '';
    const semana = (T.fechas && T.fechas.length) ? `${isoAes(T.fechas[0])} – ${isoAes(T.fechas[6])}` : '';
    $('#sub').textContent = `Semana ${semana} · efectivo desde el ${isoAes(T.dia)}`;
  }

  // ── Las bajas de los últimos días ───────────────────────────────────────────
  // Cada nombre se despliega por su cuenta. Lo abierto se recuerda: el tablero
  // se repinta entero al mover a alguien, y sin esto se plegarían solas.
  const bajasAbiertas = new Set();
  // «NSPP» es jerga de RRHH: se dice al lado qué significa.
  const glosaMotivo = m => (/\bNSPP\b/i.test(m) ? ' (no superó el periodo de prueba)' : '');
  // ── Las próximas incorporaciones (06/10/2026) ──────────────────────────────
  // Gente nueva y quien vuelve de vacaciones o de baja médica a OTRO cuadrante
  // (la lista la decide el servidor: planificador.repo.proximasIncorporaciones).
  // Cada nombre se despliega por su cuenta, y lo abierto sobrevive al repintado.
  const llegadasAbiertas = new Set();
  const MOTIVO_LLEGADA = {
    nuevo:       { texto: 'Nuevo',                 cls: 'bg-telecab-green/15 text-telecab-green border-telecab-green/30' },
    vacaciones:  { texto: 'Vuelve de vacaciones',  cls: 'bg-sky-500/15 text-sky-400 border-sky-500/30' },
    baja_medica: { texto: 'Vuelve de baja médica', cls: 'bg-telecab-violet/15 text-telecab-violet border-telecab-violet/30' },
  };
  const diaYMes = iso => isoAes(iso).slice(0, 5);

  function pintarLlegadas() {
    // Con una base abierta, solo quien entra en un coche de esa base.
    const lista = (T.proximasIncorporaciones || [])
      .filter(p => !ZONA || (p.plazas || []).some(x => (x.zonaClave || SIN_BASE) === ZONA));
    $('#panel-llegadas').classList.toggle('hidden', lista.length === 0);
    $('#llegadas-n').textContent = lista.length || '';
    $('#llegadas').innerHTML = lista.map(p => {
      const abierta = llegadasAbiertas.has(p.conductorId);
      const m = MOTIVO_LLEGADA[p.motivo] || MOTIVO_LLEGADA.nuevo;
      const coches = [...new Set((p.plazas || []).map(x => x.matricula))].join(' · ');
      // Un botón por cuadrante distinto; sin cuadrante, se va a su coche.
      const destinos = [];
      (p.plazas || []).forEach(x => {
        const k = x.cuadranteId || ('v' + x.vehiculoId);
        if (!destinos.some(d => d.k === k)) destinos.push({ k, ...x });
      });
      const botones = destinos.map(d => `
        <button type="button" data-ir-cuadrante="${esc(d.cuadranteId)}" data-ir-vehiculo="${esc(d.vehiculoId)}" data-ir-zona="${esc(d.zonaClave)}"
                class="tc-pulsable inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-semibold border border-telecab-gold/40 text-telecab-gold hover:bg-telecab-gold/10">
          <i class="fa-solid fa-arrow-right text-[10px]"></i>${destinos.length > 1
            ? 'Ver ' + esc(d.cuadrante || d.matricula)
            : (d.cuadranteId ? 'Ver su cuadrante' : 'Ver su coche')}</button>`).join('');
      const fila = (etq, valor) => `<p><span class="text-telecab-muted">${etq}:</span> <span class="font-medium">${valor}</span></p>`;
      const plazas = (p.plazas || []).map(x => `
        <div class="rounded-md bg-telecab-card2/60 px-2 py-1">
          <p class="font-medium">${esc(x.matricula)} · ${esc(x.esFijo ? 'Fijo' : 'CT')} ${esc(String(x.puesto || '').replace(/^\S+\s/, ''))}</p>
          <p class="text-telecab-muted">${esc(x.cuadrante || 'Sin cuadrante')}${x.zona ? ' · ' + esc(x.zona) : ''}${
            x.desde !== p.desde ? ' · desde el ' + esc(diaYMes(x.desde)) : ''}</p>
        </div>`).join('');
      const detalle = p.motivo === 'nuevo'
        ? (p.alta ? fila('Alta', esc(isoAes(p.alta))) : '')
        : fila('Fuera', `${esc((m.texto.replace('Vuelve de ', '')))} del ${esc(diaYMes(p.ausencia.desde))}` +
                        `${p.ausencia.hasta ? ' al ' + esc(diaYMes(p.ausencia.hasta)) : ', sin fecha de vuelta'}`) +
          fila('Antes', (p.antes && p.antes.cuadrantes.length)
            ? esc(p.antes.cuadrantes.join(', ')) + (p.antes.matriculas.length ? ` <span class="text-telecab-muted">(${esc(p.antes.matriculas.join(', '))})</span>` : '')
            : (p.antes && p.antes.matriculas.length ? esc(p.antes.matriculas.join(', ')) + ' <span class="text-telecab-muted">(sin cuadrante)</span>' : 'sin coche'));
      return `
        <div class="rounded-lg bg-telecab-card border border-telecab-border">
          <button type="button" data-llegada="${esc(p.conductorId)}" aria-expanded="${abierta}"
                  class="w-full flex items-center gap-2 px-2 py-1.5 text-left rounded-lg hover:bg-telecab-card2 transition-colors">
            <div class="min-w-0 flex-1">
              <div class="text-sm font-medium truncate">${esc(p.nombre)}</div>
              <div class="flex flex-wrap items-center gap-x-1.5 gap-y-0.5 mt-0.5">
                <span class="inline-flex px-1.5 rounded border text-[10px] font-semibold ${m.cls}">${esc(m.texto)}</span>
                <span class="text-[11px] text-telecab-muted">entra el ${esc(diaYMes(p.desde))} · ${esc(coches)}</span>
              </div>
            </div>
            <i class="fa-solid fa-chevron-down text-[10px] text-telecab-muted transition-transform ${abierta ? 'rotate-180' : ''}"></i>
          </button>
          <div class="px-2 pb-2 text-xs space-y-1 ${abierta ? '' : 'hidden'}">
            ${fila('Teléfono', p.telefono ? `<span class="font-mono tabular-nums">${esc(p.telefono)}</span>` : '<span class="text-telecab-warn">sin teléfono</span>')}
            ${fila('Incorporación', esc(isoAes(p.desde)))}
            ${detalle}
            <div class="space-y-1">${plazas}</div>
            <div class="flex flex-wrap gap-1.5 pt-1">${botones}</div>
          </div>
        </div>`;
    }).join('');
  }

  /**
   * «Ver su cuadrante»: lleva la vista a su cuadrante (o a su coche, si no está
   * en ninguno) y lo marca un momento. Si el buscador o «solo con huecos» lo
   * esconderían, se quitan; si hay otra base abierta, se abre la suya.
   */
  function irAlCuadrante({ cuadranteId, vehiculoId, zonaClave }) {
    let repintar = false;
    if (plano($('#f-busca').value).trim()) { $('#f-busca').value = ''; repintar = true; }
    if ($('#f-huecos').checked) { $('#f-huecos').checked = false; repintar = true; }
    if (ZONA && ZONA !== (zonaClave || SIN_BASE)) elegirBase(zonaClave || SIN_BASE);
    else if (repintar) pintar();
    const destino = document.querySelector(cuadranteId
      ? `[data-cuadrante="${CSS.escape(cuadranteId)}"]` : `[data-vehiculo="${CSS.escape(vehiculoId)}"]`);
    if (!destino) {
      Dialogo.aviso({ titulo: 'No está a la vista', tono: 'aviso',
        texto: 'Ese cuadrante no sale en la semana que estás mirando. Prueba con «Hoy».' });
      return;
    }
    const suave = !(window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches);
    destino.scrollIntoView({ block: 'start', behavior: suave ? 'smooth' : 'auto' });
    const coche = cuadranteId && vehiculoId ? destino.querySelector(`[data-vehiculo="${CSS.escape(vehiculoId)}"]`) : null;
    [destino, coche].filter(Boolean).forEach(el => {
      el.classList.add('tc-resalte');
      setTimeout(() => el.classList.remove('tc-resalte'), 2600);
    });
  }

  function pintarBajas() {
    const B = T.bajasRecientes || { dias: 5, lista: [] };
    const lista = B.lista || [];
    $('#panel-bajas').classList.toggle('hidden', lista.length === 0);
    $('#bajas-tit').textContent = `Bajas · últimos ${B.dias} días`;
    $('#bajas-n').textContent = lista.length || '';
    $('#bajas').innerHTML = lista.map(b => {
      const abierta = bajasAbiertas.has(b.conductorId);
      const contrato = b.tipo === 'ett' ? `ETT${b.ett ? ' ' + b.ett : ''}` : 'Plantilla propia';
      const coche = b.matricula ? `${b.matricula}${b.turno ? ' · ' + b.turno : ''}` : 'sin coche';
      const motivo = b.motivo
        ? `<p><span class="text-telecab-muted">Motivo:</span> <span class="font-medium">${esc(b.motivo)}</span>${esc(glosaMotivo(b.motivo))}</p>`
        : '<p class="text-telecab-warn" title="Al darle de baja no se apuntó el motivo.">Sin motivo apuntado</p>';
      return `
        <div class="rounded-lg bg-telecab-card border border-telecab-border">
          <button type="button" data-baja="${esc(b.conductorId)}" aria-expanded="${abierta}"
                  class="w-full flex items-center gap-2 px-2 py-1.5 text-left rounded-lg hover:bg-telecab-card2 transition">
            <div class="min-w-0 flex-1">
              <div class="text-sm font-medium truncate">${esc(b.nombre)}</div>
              <div class="text-[11px] text-telecab-muted">Baja el ${esc(isoAes(b.baja).slice(0, 5))} · ${esc(coche)}</div>
            </div>
            <i class="fa-solid fa-chevron-down text-[10px] text-telecab-muted transition-transform ${abierta ? 'rotate-180' : ''}"></i>
          </button>
          <div class="px-2 pb-2 text-xs space-y-0.5 ${abierta ? '' : 'hidden'}">
            ${motivo}
            <p class="text-telecab-muted">${esc(contrato)} · baja el ${esc(isoAes(b.baja))}</p>
          </div>
        </div>`;
    }).join('');
  }

  // ══════════ LAS BASES (05/10/2026) ══════════
  //
  // Las cinco bases son la entrada al cuadrante. Cada tarjeta es su iceberg:
  // cuántos coches están completos, cuántos tienen plazas vacías y cuántos no
  // tienen a nadie, y lo que le falta. Al pincharla se abren sus cuadrantes y las
  // tarjetas de arriba pasan a contar solo esa base. Las cuentas vienen hechas
  // del servidor (`resumen.porZona`, iceberg.js): aquí solo se pintan.

  const SIN_BASE = 'sin';
  const bases = () => (T && T.resumen && T.resumen.porZona) || [];
  const baseActual = () => (ZONA ? bases().find(b => b.clave === ZONA) || null : null);
  const resumenActual = () => baseActual() || (T && T.resumen) || {};
  const nombreEnUrl = s => plano(s).replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
  const claveDeNombre = nombre => {
    const b = bases().find(x => nombreEnUrl(x.zona) === nombreEnUrl(nombre));
    return b ? b.clave : '';
  };
  const fmtH = n => Number(n || 0).toLocaleString('es-ES', { maximumFractionDigits: 0 });
  const fmtH1 = n => Number(n || 0).toLocaleString('es-ES', { maximumFractionDigits: 1 });

  // LA BARRA DE HORAS: llena son 14 turnos a 9 h, la S de la calificación. Es la
  // misma escala para un coche y para la media por coche de un cuadrante.
  const HORAS_LLENO = 14 * 9;
  const medidor = h => `<span class="relative inline-block w-10 h-1 shrink-0 rounded-full bg-telecab-card2 overflow-hidden" aria-hidden="true">
      <span class="absolute inset-y-0 left-0 rounded-full bg-telecab-muted" style="width:${Math.min(100, Math.round((Number(h) || 0) / HORAS_LLENO * 100))}%"></span></span>`;

  // Los escalones del iceberg, de arriba abajo. Rojo, naranja y verde son
  // ESTADOS (Identidad visual): aquí lo son.
  const ESCALON = {
    completo:  { tit: 'Completos', punto: 'bg-telecab-green',
                 txt: 'Todas sus plazas tienen dueño, hoy o ya escrito. De más a menos horas instaladas.' },
    vacante:   { tit: 'Con plazas vacías', punto: 'bg-telecab-warn',
                 txt: 'Les falta un fijo o días de correturnos. De más a menos horas instaladas.' },
    vacio:     { tit: 'Sin nadie', punto: 'bg-telecab-red',
                 txt: 'Ni una persona puesta ni por llegar.' },
    sinCoches: { tit: 'Sin coches', punto: 'bg-telecab-muted',
                 txt: 'Cuadrantes creados sin ningún bloque todavía.' },
  };
  const escalonDe = x => (x && x.iceberg && ESCALON[x.iceberg.escalon]) ? x.iceberg.escalon : 'vacante';

  function tarjetaBase(b) {
    const on = ZONA === b.clave;
    const ic = b.iceberg || {};
    const total = b.cochesTotal || 0;
    const fijos = (b.fijosQueFaltanDia || 0) + (b.fijosQueFaltanNoche || 0);
    const cts = (b.ctQueFaltanDia || 0) + (b.ctQueFaltanNoche || 0);
    const falta = !total ? 'Sin coches todavía'
      : (fijos || cts) ? 'Faltan ' + [fijos ? `${fijos} fijo${fijos === 1 ? '' : 's'}` : '', cts ? `${cts} CT` : ''].filter(Boolean).join(' · ')
      : 'Nada por cubrir';
    const tramo = (n, cls) => (n ? `<span class="${cls}" style="flex:${n} 1 0%"></span>` : '');
    const titulo = !total
      ? `${b.zona} todavía no tiene coches. Pincha para crear su primer cuadrante.`
      : `${b.zona}: ${total} coches en ${b.cuadrantes} cuadrantes.\n` +
        `${ic.completo} completos · ${ic.vacante} con plazas vacías · ${ic.vacio} sin nadie` +
        (ic.parados ? ` · ${ic.parados} parado(s) en taller o siniestro` : '') + '.\n' +
        `Faltan ${b.fijosQueFaltanDia || 0} fijo(s) de día y ${b.fijosQueFaltanNoche || 0} de noche, ` +
        `y ${b.ctQueFaltanDia || 0} CT de día y ${b.ctQueFaltanNoche || 0} de noche.\n` +
        'Pincha para ver sus cuadrantes, de mejor a peor.';
    return `
      <button type="button" data-base="${esc(b.clave)}" aria-pressed="${on}" title="${esc(titulo)}"
              class="tc-pulsable text-left rounded-2xl border p-3 min-w-0 outline-none focus-visible:ring-2 focus-visible:ring-telecab-gold/50
                     ${on ? 'border-telecab-gold bg-telecab-gold/5' : 'border-telecab-border bg-telecab-card hover:border-telecab-gold/40'}">
        <span class="flex items-baseline gap-2 min-w-0">
          <span class="font-semibold truncate ${on ? 'text-telecab-gold' : ''}">${esc(b.zona)}</span>
          <span class="ml-auto text-xs text-telecab-muted tabular-nums whitespace-nowrap">${total} coche${total === 1 ? '' : 's'}</span>
        </span>
        <span class="mt-2 flex h-1.5 gap-px rounded-full overflow-hidden bg-telecab-card2" aria-hidden="true">
          ${tramo(ic.completo, 'bg-telecab-green')}${tramo(ic.vacante, 'bg-telecab-warn')}${tramo(ic.vacio, 'bg-telecab-red')}
        </span>
        <span class="mt-2 block text-[11px] text-telecab-muted tabular-nums truncate">${total
          ? `${ic.completo} completo${ic.completo === 1 ? '' : 's'} · ${ic.vacante} con vacías${ic.vacio ? ` · ${ic.vacio} sin nadie` : ''}`
          : 'Ningún cuadrante'}</span>
        <span class="block text-xs font-semibold mt-0.5 truncate ${total && (fijos || cts) ? 'text-telecab-warn' : 'text-telecab-muted'}">${falta}</span>
      </button>`;
  }

  function pintarBases() {
    const todas = bases();
    const visibles = todas.filter(b => b.clave !== SIN_BASE);
    $('#bases').innerHTML = visibles.map(tarjetaBase).join('');
    // Los coches sin base no son una sexta base: son coches por colocar. Salen
    // como un aviso pequeño, y solo si los hay.
    const sin = todas.find(b => b.clave === SIN_BASE);
    const bSin = $('#b-sinbase');
    bSin.classList.toggle('hidden', !sin);
    bSin.classList.toggle('inline-flex', !!sin);
    if (sin) {
      bSin.querySelector('span').textContent = `${sin.cochesTotal} coche${sin.cochesTotal === 1 ? '' : 's'} sin base`;
      bSin.setAttribute('aria-pressed', String(ZONA === SIN_BASE));
      bSin.classList.toggle('border-telecab-gold', ZONA === SIN_BASE);
      bSin.classList.toggle('text-telecab-gold', ZONA === SIN_BASE);
    }
  }

  /**
   * Abrir una base ('' = volver a todas). Con `apilar`, el navegador lo apunta
   * como un paso: «atrás» vuelve a las bases en vez de salir del planificador.
   */
  function elegirBase(clave, { apilar = true } = {}) {
    ZONA = clave || '';
    const b = baseActual();
    const destino = location.pathname + location.search + (b ? '#base=' + nombreEnUrl(b.zona) : '');
    try {
      if (apilar) history.pushState({ base: ZONA }, '', destino);
      else history.replaceState({ base: ZONA }, '', destino);
    } catch (_) { /* sin historial, la base se elige igual */ }
    pintarBases();
    pintarKpis();
    pintar();
    pintarLaterales();
    if (b) window.scrollTo({ top: Math.min(window.scrollY, $('#bases').offsetTop), behavior: 'auto' });
  }

  const baseDeLaUrl = () => {
    const m = String(location.hash || '').match(/base=([^&]+)/);
    return m ? decodeURIComponent(m[1]) : '';
  };

  // ── El cuadrante, por zona ───────────────────────────────────────────────────
  const plano = s => String(s || '').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
  // Un HUECO = una PLAZA VISIBLE (fijo día/noche o CT día/noche = slots 0-3) sin
  // nadie asignado. Incluye los huecos de CORRETURNOS, no solo los de fijos. (No
  // cuenta "días sin cubrir": casi todo coche tiene el finde sin CT y eso mostraba a
  // todos con "solo con huecos".)
  const tieneHueco = c => [0, 1, 2, 3].some(s => !((c.personas || [])[s] || {}).id);
  // LA BASE de un coche o de un cuadrante la dice el servidor (iceberg.js): la
  // del CUADRANTE si el coche está en uno, y si no, la suya. Así lo que se ve y
  // lo que cuentan las tarjetas no se pueden separar.
  const zonaDe = x => (x && x.iceberg && x.iceberg.zona) || SIN_BASE;
  const ordenIce = x => (x && x.iceberg && x.iceberg.orden != null ? x.iceberg.orden : 1e6);
  const ordenBase = clave => { const i = bases().findIndex(b => b.clave === clave); return i < 0 ? 1e3 : i; };
  function cochesVisibles() {
    const soloHuecos = $('#f-huecos').checked;
    const q = plano($('#f-busca').value).trim();
    return (T.coches || []).filter(c => {
      if (ZONA && zonaDe(c) !== ZONA) return false;
      if (soloHuecos && !tieneHueco(c)) return false;
      if (q) {
        // TAMBIÉN LOS QUE ESTÁN POR LLEGAR. Una plaza puede estar vacía hoy y
        // tener dueño para el lunes («→ Cristian · llega 21/09»), y buscar por
        // su nombre contestaba «no hay nada» justo cuando lo que quieres es ver
        // dónde cae. Lo mismo con la vacante que tiene prometida la plaza.
        const txt = plano(c.matricula + ' ' + (c.personas || []).map(p => {
          if (!p) return '';
          const per = p.id ? (porId.get(String(p.id)) || {}) : {};
          return [p.nombre, per.telefono, per.barrio,
            p.futuro && p.futuro.nombre,
            p.vacante && (p.vacante.codigo || p.vacante.sustituye)].filter(Boolean).join(' ');
        }).join(' '));
        if (!txt.includes(q)) return false;
      }
      return true;
    }).sort((a, b) => ordenIce(a) - ordenIce(b));
  }

  // Las 4 columnas del Excel: Fijo día/noche, CT día/noche (slots 0,1,2,3).
  // LAS COLUMNAS DEL TABLERO. Las cuatro de siempre, y en MODO EVENTOS dos más:
  // las plazas de refuerzo. No son nuevas —los slots 4 y 5 existen en la base
  // desde el primer día para los 100 coches— simplemente no se enseñaban, porque
  // abrirlas a mano significa que alguien tiene que acordarse de cerrarlas.
  const COLS_BASE = [
    { slot: 0, tit: 'Fijo día',  turno: 'dia' },
    { slot: 1, tit: 'Fijo noche', turno: 'noche' },
    { slot: 2, tit: 'CT día',    turno: 'dia' },
    { slot: 3, tit: 'CT noche',  turno: 'noche' },
  ];
  const COLS_REFUERZO = [
    { slot: 4, tit: 'CT día 2',   turno: 'dia',   refuerzo: true },
    { slot: 5, tit: 'CT noche 2', turno: 'noche', refuerzo: true },
  ];
  const cols = () => (T && T.refuerzoVisible ? COLS_BASE.concat(COLS_REFUERZO) : COLS_BASE);

  // El CT (día/noche) de un cuadrante: el ocupante de la plaza CT en sus coches.
  // Si es el mismo en todos, ese es el CT del cuadrante; si difieren, 'varios'.
  function ctDelCuadrante(lista, slot) {
    const ids = new Set();
    lista.forEach(c => { const p = (c.personas || [])[slot]; if (p && p.id) ids.add(String(p.id)); });
    if (ids.size === 1) return porId.get([...ids][0]) || null;
    return ids.size > 1 ? 'varios' : null;
  }

  // La libranza de un CT = el complemento de los días de SUS BLOQUES (su patrón:
  // la unión de los descansos de los coches donde es CT), no de lo que cubrió esa
  // semana en concreto (que depende de cuándo empezó la asignación).
  const libraCT = persona => {
    if (!persona) return '';
    const trabaja = new Set();
    (T.coches || []).forEach(c => [2, 3].forEach(slot => {
      const p = (c.personas || [])[slot];
      if (p && String(p.id) === String(persona.id)) (c.descanso || []).forEach(d => trabaja.add(Number(d)));
    }));
    return [1, 2, 3, 4, 5, 6, 7].filter(d => !trabaja.has(d)).map(d => DIAS_LETRA[d - 1]).join(' ');
  };

  function tablaCoches(lista, enCuadrante) {
    const wrap = document.createElement('div');
    wrap.className = 'overflow-x-auto border border-telecab-border rounded-2xl';
    wrap.innerHTML = `
      <table class="w-full text-sm border-collapse">
        <thead class="bg-telecab-card2 text-telecab-muted text-[11px] uppercase tracking-wide">
          <tr>
            <th class="text-left font-semibold px-3 py-2.5 whitespace-nowrap">Matrícula</th>
            <th class="text-left font-semibold px-3 py-2.5 whitespace-nowrap">Descanso</th>
            ${cols().map(c => `<th class="text-left font-semibold px-3 py-2.5">${c.tit}</th>`).join('')}
            <th class="w-10"></th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>`;
    const tb = wrap.querySelector('tbody');
    lista.forEach(coche => tb.appendChild(filaCoche(coche, enCuadrante)));
    return wrap;
  }

  /** El cuerpo de un grupo de coches, en la vista elegida. */
  const cochesEnVista = (lista, enCuadrante) =>
    (VISTA === 'vertical' ? tarjetasCoches(lista, enCuadrante) : tablaCoches(lista, enCuadrante));

  /**
   * Las horas instaladas de un cuadrante, para su cabecera. Se ordena por la
   * MEDIA por coche: con la suma, uno de tres coches flojos pasaba delante de
   * uno de dos muy buenos solo por tener más coches.
   */
  function horasDelCuadrante(cu) {
    const ic = cu.iceberg;
    if (!ic || !ic.coches) return '';
    const tit = `Horas instaladas esta semana: ${fmtH1(ic.horas)} h entre sus ${ic.coches} coches, ${fmtH1(ic.media)} h de media por coche.\n` +
      'Cada turno suma el promedio de horas por día trabajado de quien lo cubre. El cuadrante se ordena por la media, ' +
      'para que uno de tres coches no pase delante solo por tener más. La barra llena son 14 turnos a 9 h.';
    return `<span class="inline-flex items-center gap-1.5 text-xs text-telecab-muted tabular-nums" title="${esc(tit)}">
      ${medidor(ic.media)}<b class="text-telecab-text font-semibold">${fmtH(ic.horas)} h</b>
      <span>· ${fmtH(ic.media)} h por coche</span></span>`;
  }

  function seccionCuadrante(cu, lista) {
    const sec = document.createElement('section');
    sec.dataset.cuadrante = cu.id;
    sec.className = 'scroll-mt-24';   // que la barra de arriba no tape la cabecera al saltar aquí
    const ctDia = ctDelCuadrante(lista, 2), ctNoche = ctDelCuadrante(lista, 3);
    const chipCT = (persona, turno) => {
      const nombre = persona === 'varios' ? 'Varios' : (persona ? persona.nombre : null);
      const libra = (persona && persona !== 'varios') ? libraCT(persona) : '';
      return `<button data-ct="${turno}" class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-semibold border transition
                ${nombre ? 'bg-telecab-violet/10 text-telecab-violet border-telecab-violet/30' : 'border-dashed border-telecab-border text-telecab-muted'} hover:border-telecab-gold/50">
              <i class="fa-solid fa-user-group"></i>CT ${turno}: ${nombre ? esc(nombre) : 'asignar'}${libra ? ` <span class="text-telecab-muted">libra ${esc(libra)}</span>` : ''}</button>`;
    };
    const cab = document.createElement('div');
    cab.className = 'flex flex-wrap items-center gap-2 mb-2';
    cab.innerHTML = `
      <h3 class="text-sm font-semibold uppercase tracking-wide text-telecab-gold flex items-center gap-2">
        <span class="w-2 h-2 rounded-full ${ESCALON[escalonDe(cu)].punto}" title="${esc(ESCALON[escalonDe(cu)].tit)}"></span>
        ${esc(cu.nombre)}
        <span class="text-telecab-muted font-normal normal-case">${cu.zona ? esc(cu.zona) + ' · ' : ''}${lista.length} bloque(s)</span>
      </h3>
      ${horasDelCuadrante(cu)}
      <button data-bloque class="px-2.5 py-1 rounded-lg text-xs font-semibold bg-telecab-card border border-telecab-border hover:border-telecab-gold/50 transition"><i class="fa-solid fa-plus"></i> Bloque</button>
      <div class="flex items-center gap-2 ml-1">${chipCT(ctDia, 'día')}${chipCT(ctNoche, 'noche')}</div>
      ${lista.length ? `<span class="ml-auto"></span>${chipAvisoCuadrante(lista)}<button data-waturnos class="px-2.5 py-1 rounded-lg text-xs font-semibold bg-green-600/15 text-green-400 hover:bg-green-600/25 transition"
              title="Enviar por WhatsApp a la gente de este cuadrante sus turnos de la semana que estás mirando">
        <i class="fa-brands fa-whatsapp"></i> Enviar turnos</button>` : ''}
      <button data-borrar-cua class="${lista.length ? '' : 'ml-auto '}text-xs text-telecab-muted hover:text-telecab-red transition"><i class="fa-solid fa-trash"></i> borrar cuadrante</button>`;
    const bWa = cab.querySelector('[data-waturnos]');
    if (bWa) bWa.addEventListener('click', e => enviarTurnosCuadrante(cu.nombre, lista, e.currentTarget));
    cab.querySelector('[data-bloque]').addEventListener('click', () => anadirBloque(cu.id));
    cab.querySelector('[data-ct="día"]').addEventListener('click', () =>
      asignarCTCuadrante(cu.id, 'dia', lista, (ctDia && ctDia !== 'varios') ? ctDia.id : null));
    cab.querySelector('[data-ct="noche"]').addEventListener('click', () =>
      asignarCTCuadrante(cu.id, 'noche', lista, (ctNoche && ctNoche !== 'varios') ? ctNoche.id : null));
    cab.querySelector('[data-borrar-cua]').addEventListener('click', () => borrarCuadranteUI(cu.id, cu.nombre));
    sec.appendChild(cab);
    if (lista.length) {
      sec.appendChild(cochesEnVista(lista, true));
    } else {
      const vac = document.createElement('p');
      vac.className = 'text-xs text-telecab-muted px-3 py-4 border border-dashed border-telecab-border rounded-2xl text-center';
      vac.textContent = 'Cuadrante vacío. Pulsa "Bloque" para añadir días + matrícula.';
      sec.appendChild(vac);
    }
    return sec;
  }

  function seccionSueltos(lista) {
    const sec = document.createElement('section');
    const cab = document.createElement('div');
    cab.className = 'flex flex-wrap items-center gap-2 mb-2';
    cab.innerHTML = `
      <h3 class="text-sm font-semibold uppercase tracking-wide text-telecab-muted flex items-center gap-2">
        <i class="fa-solid fa-car-side"></i>Coches sueltos <span class="font-normal normal-case">${lista.length}</span></h3>
      <span class="ml-auto"></span>${chipAvisoCuadrante(lista)}
      <button data-waturnos class="px-2.5 py-1 rounded-lg text-xs font-semibold bg-green-600/15 text-green-400 hover:bg-green-600/25 transition"
              title="Enviar por WhatsApp a la gente de estos coches sus turnos de la semana que estás mirando">
        <i class="fa-brands fa-whatsapp"></i> Enviar turnos</button>`;
    cab.querySelector('[data-waturnos]').addEventListener('click', e => enviarTurnosCuadrante('coches sueltos', lista, e.currentTarget));
    sec.appendChild(cab);
    sec.appendChild(cochesEnVista(lista, false));
    return sec;
  }

  /**
   * La franja que abre cada escalón del iceberg: qué es, cuántos cuadrantes y
   * coches caen en él, y en qué orden van.
   */
  function franjaEscalon(escalon, cuadrantes, porCua) {
    const e = ESCALON[escalon];
    const coches = cuadrantes.reduce((s, cu) => s + (porCua.get(String(cu.id)) || []).length, 0);
    const div = document.createElement('div');
    div.className = 'flex items-center gap-3 pt-1';
    div.innerHTML = `
      <span class="w-2.5 h-2.5 rounded-full shrink-0 ${e.punto}"></span>
      <h3 class="text-xs font-semibold uppercase tracking-wider whitespace-nowrap">${esc(e.tit)}</h3>
      <span class="text-xs text-telecab-muted tabular-nums whitespace-nowrap" title="${esc(e.txt)}">${cuadrantes.length} cuadrante${cuadrantes.length === 1 ? '' : 's'}${
        coches ? ` · ${coches} coche${coches === 1 ? '' : 's'}` : ''}</span>
      <span class="flex-1 h-px bg-telecab-border"></span>`;
    return div;
  }

  /**
   * Sin base abierta, cada base abre su tramo con su nombre, lo que tiene y lo
   * que le falta: lo mismo que su tarjeta de arriba. Pincharla deja solo esa.
   */
  function cabeceraBase(clave) {
    const b = bases().find(x => x.clave === clave);
    const fijos = b ? (b.fijosQueFaltanDia || 0) + (b.fijosQueFaltanNoche || 0) : 0;
    const cts = b ? (b.ctQueFaltanDia || 0) + (b.ctQueFaltanNoche || 0) : 0;
    const falta = (fijos || cts) ? 'Faltan ' + [fijos ? `${fijos} fijo${fijos === 1 ? '' : 's'}` : '', cts ? `${cts} CT` : ''].filter(Boolean).join(' · ') : '';
    const div = document.createElement('div');
    div.className = 'flex flex-wrap items-baseline gap-x-3 gap-y-1 pt-4 border-t border-telecab-border first:pt-0 first:border-t-0';
    div.innerHTML = `
      <h3 class="text-base font-semibold whitespace-nowrap">${esc(b ? b.zona : 'Sin base')}</h3>
      ${b ? `<span class="text-xs text-telecab-muted tabular-nums">${b.cochesTotal} coche${b.cochesTotal === 1 ? '' : 's'} · ${b.cuadrantes} cuadrante${b.cuadrantes === 1 ? '' : 's'}</span>` : ''}
      ${falta ? `<span class="text-xs font-semibold text-telecab-warn">${esc(falta)}</span>` : ''}
      ${b ? `<button type="button" data-solo-base class="tc-pulsable ml-auto text-xs text-telecab-muted hover:text-telecab-gold">Ver solo ${b.clave === SIN_BASE ? 'estos' : esc(b.zona)} <i class="fa-solid fa-arrow-right text-[10px]"></i></button>` : ''}`;
    const btn = div.querySelector('[data-solo-base]');
    if (btn) btn.addEventListener('click', () => elegirBase(b.clave));
    return div;
  }

  /** Una base abierta sin cuadrantes todavía. */
  function baseVacia(b) {
    const div = document.createElement('div');
    div.className = 'px-6 py-10 text-center border border-dashed border-telecab-border rounded-2xl';
    div.innerHTML = `
      <p class="text-sm font-semibold">${esc(b.zona)} todavía no tiene cuadrantes</p>
      ${PUEDE_EDITAR ? '<p class="mt-1 text-xs text-telecab-muted">Crea uno y añádele bloques (días + matrícula).</p>' : ''}
      ${PUEDE_EDITAR && b.clave !== SIN_BASE ? `<button type="button" data-crear class="tc-pulsable mt-4 inline-flex items-center gap-2 px-3 py-2 rounded-xl bg-telecab-gold text-telecab-dark font-semibold text-sm">
        <i class="fa-solid fa-plus"></i>Nuevo cuadrante en ${esc(b.zona)}</button>` : ''}`;
    const btn = div.querySelector('[data-crear]');
    if (btn) btn.addEventListener('click', nuevoCuadrante);
    return div;
  }

  // EL ICEBERG. Los cuadrantes de cada base de mejor a peor: primero los
  // completos, luego los que tienen plazas vacías y al final los que no tienen
  // a nadie; dentro de cada escalón, los que ruedan antes que los del taller, y
  // más horas instaladas primero. El ORDEN lo pone el servidor (`iceberg.orden`):
  // aquí solo se agrupa. Ya no se ordena por número.
  //
  // SIN PULSAR NADA SE VEN TODOS (06/10/2026, Camilo): base a base, en el orden
  // de las tarjetas de arriba, y dentro de cada una su iceberg. Al pinchar una
  // base queda solo la suya.
  function pintar() {
    const cont = $('#cuadrante');
    const buscando = !!plano($('#f-busca').value).trim();
    const filtrando = buscando || $('#f-huecos').checked;

    const coches = cochesVisibles();

    // Coches por cuadrante; los sueltos aparte.
    const porCua = new Map(); const sueltos = [];
    coches.forEach(c => {
      if (c.cuadranteId) { const k = String(c.cuadranteId); if (!porCua.has(k)) porCua.set(k, []); porCua.get(k).push(c); }
      else sueltos.push(c);
    });

    // Los cuadrantes de la base (incluidos los vacíos, recién creados). Al
    // FILTRAR (buscando o solo-huecos), un cuadrante sin coches que pasen el
    // filtro se oculta: si no, salía como "vacío" y parecía que el filtro no
    // hacía nada. Sin filtro, los vacíos siguen (para poder añadir bloques).
    const cuadrantes = (T.cuadrantes || [])
      .filter(cu => (!ZONA || zonaDe(cu) === ZONA) && (!filtrando || (porCua.get(String(cu.id)) || []).length))
      .sort((a, b) => (ZONA ? 0 : ordenBase(zonaDe(a)) - ordenBase(zonaDe(b))) || ordenIce(a) - ordenIce(b));

    const hayAlgo = cuadrantes.length || sueltos.length;
    const b = baseActual();
    cont.innerHTML = '';
    if (!hayAlgo && b && !filtrando) {
      cont.classList.remove('hidden');
      $('#vacio').classList.add('hidden');
      cont.appendChild(baseVacia(b));
      return;
    }
    $('#vacio').classList.toggle('hidden', hayAlgo > 0);
    cont.classList.toggle('hidden', !hayAlgo);

    // Sin base abierta, cada base lleva su cabecera; dentro de cada base, una
    // franja por escalón. Buscando, solo la cabecera de base: con pocos
    // resultados, las franjas serían más ruido que ayuda.
    let base = null, escalon = null;
    cuadrantes.forEach(cu => {
      const z = zonaDe(cu);
      if (!ZONA && z !== base) {
        base = z; escalon = null;
        cont.appendChild(cabeceraBase(z));
      }
      const e = escalonDe(cu);
      if (!buscando && e !== escalon) {
        escalon = e;
        cont.appendChild(franjaEscalon(e, cuadrantes.filter(x => zonaDe(x) === z && escalonDe(x) === e), porCua));
      }
      cont.appendChild(seccionCuadrante(cu, porCua.get(String(cu.id)) || []));
    });
    // Los coches sin cuadrante, al final: con todas las bases a la vista, bajo
    // su propia cabecera para que no parezcan de la última base.
    if (sueltos.length) {
      if (!ZONA) cont.appendChild(cabeceraBase(SIN_BASE));
      cont.appendChild(seccionSueltos(sueltos));
    }
  }

  function filaCoche(coche, enCuadrante) {
    const tr = document.createElement('tr');
    tr.className = 'border-t border-telecab-border/70 align-top scroll-mt-24';
    tr.dataset.vehiculo = coche.vehiculoId;   // para «Ver su cuadrante»
    const tono = tonoEstado(coche.estadoVeh);

    // Celda de matrícula + estado.
    const tdMat = document.createElement('td');
    tdMat.className = 'px-3 py-2.5 whitespace-nowrap';
    tdMat.innerHTML = `
      <div class="font-semibold">${esc(coche.matricula)}</div>
      <button class="mt-1 inline-flex items-center gap-1 px-2 py-0.5 rounded-lg text-xs font-semibold
                     bg-telecab-${tono}/15 text-telecab-${tono} border border-telecab-${tono}/30 hover:bg-telecab-${tono}/25 transition"
              data-estado>${esc(ESTADO_ETQ.get(coche.estadoVeh) || coche.estadoVeh)}<i class="fa-solid fa-chevron-down text-[9px]"></i></button>`;
    tdMat.querySelector('[data-estado]').addEventListener('click', () => cambiarEstado(coche));
    tdMat.insertAdjacentHTML('beforeend', lineaHoras(coche));
    // Taller/siniestro: el coche se queda en su bloque, pero avisa de que hay que
    // cambiar la matrícula ahí (sus conductores quedan "huérfanos imaginarios").
    if (!coche.visibleCobertura) {
      tr.classList.add('bg-telecab-red/5');
      const tieneGente = (coche.personas || []).some(p => p && p.id);
      const b = document.createElement('button');
      b.className = 'mt-1 block text-[11px] text-telecab-red font-semibold hover:underline';
      b.innerHTML = tieneGente
        ? '<i class="fa-solid fa-triangle-exclamation"></i> cambiar matrícula aquí'
        : '<i class="fa-solid fa-triangle-exclamation"></i> fuera de cobertura';
      if (tieneGente) {
        b.title = 'Intercambia el coche por otro (libre o con bloque): las tripulaciones se quedan en su cuadrante y días, cambia la matrícula';
        b.addEventListener('click', () => reemplazarMatriculaUI(coche));
      } else {
        b.className = 'mt-1 block text-[11px] text-telecab-red';
      }
      tdMat.appendChild(b);
    }
    tr.appendChild(tdMat);

    // Descanso del coche (el bloque): vive en el coche. Sus fijos libran esos
    // días. Editable siempre (es del coche, no del fijo).
    const descTxt = (coche.descanso && coche.descanso.length) ? diasTexto(coche.descanso) : '';
    const tdDesc = document.createElement('td');
    tdDesc.className = 'px-3 py-2.5 whitespace-nowrap';
    tdDesc.innerHTML = `
      <button class="px-2 py-1 rounded-lg text-xs font-semibold border transition hover:border-telecab-gold/50
                     ${descTxt ? 'bg-telecab-gold/10 text-telecab-gold border-telecab-gold/30' : 'border-dashed border-telecab-border text-telecab-muted'}"
              data-desc title="Editar el descanso del coche (día y noche)">
        ${descTxt ? esc(descTxt) : 'sin descanso'}
      </button>`;
    tdDesc.querySelector('[data-desc]').addEventListener('click', () => fijarDescansoCoche(coche));
    tr.appendChild(tdDesc);

    // Las 4 columnas de puestos.
    cols().forEach(col => {
      const p = (coche.personas || [])[col.slot] || {};
      const td = document.createElement('td');
      td.className = 'px-3 py-2.5';
      td.appendChild(celdaPuesto(coche, p, col));
      tr.appendChild(td);
    });

    // Acciones del coche.
    const tdAcc = document.createElement('td');
    tdAcc.className = 'px-2 py-2.5 text-right whitespace-nowrap';
    tdAcc.innerHTML = `
      <button class="w-8 h-8 rounded-lg text-telecab-muted hover:bg-telecab-card2 hover:text-telecab-gold transition" data-cua
              title="${enCuadrante ? 'Sacar del cuadrante' : 'Meter en un cuadrante'}"><i class="fa-solid ${enCuadrante ? 'fa-object-ungroup' : 'fa-object-group'}"></i></button>
      <button class="w-8 h-8 rounded-lg text-telecab-muted hover:bg-telecab-card2 hover:text-telecab-gold transition" data-swap
              title="Intercambiar coche por otro (cada tripulación se queda en su cuadrante y días; solo cambia la matrícula)"><i class="fa-solid fa-shuffle"></i></button>
      <button class="w-8 h-8 rounded-lg text-telecab-muted hover:bg-telecab-card2 hover:text-telecab-gold transition" data-cambiar
              title="Cambiar de coche (llevarse la tripulación a una matrícula libre)"><i class="fa-solid fa-right-left"></i></button>`;
    tdAcc.querySelector('[data-cua]').addEventListener('click', () => enCuadrante ? sacarDeCuadrante(coche) : meterEnCuadrante(coche));
    tdAcc.querySelector('[data-swap]').addEventListener('click', () => reemplazarMatriculaUI(coche));
    tdAcc.querySelector('[data-cambiar]').addEventListener('click', () => cambiarCoche(coche));
    tr.appendChild(tdAcc);

    return tr;
  }

  // ── Las horas instaladas de un coche, y lo que le falta ─────────────────────
  // Por cada día y turno de la semana, el promedio de horas por día trabajado
  // de quien lo cubre (su calificación). Un turno sin nadie suma 0, y quien aún
  // no tiene calificación cuenta con la mediana de la flota (iceberg.js).
  function tituloHoras(coche) {
    const ic = coche.iceberg || {};
    return `Horas instaladas esta semana: ${fmtH1(ic.horas)} h en ${ic.turnos} de 14 turnos.\n` +
      'Cada turno suma el promedio de horas por día trabajado de quien lo cubre (su calificación); un turno sin nadie suma 0.' +
      (ic.estimados ? `\n${ic.estimados} turno(s) con alguien sin calificación todavía: cuentan ${fmtH1((T.resumen || {}).horasEstimadas)} h, la mediana de la flota.` : '') +
      '\nLa barra llena son 14 turnos a 9 h.';
  }

  /** «falta fijo noche · 2 días de CT de día», o nada si está completo. */
  function textoFalta(coche) {
    const f = (coche.iceberg || {}).falta;
    if (!f) return '';
    const dias = n => `${n} día${n === 1 ? '' : 's'}`;
    return [
      f.fijoDia ? 'fijo de día' : '', f.fijoNoche ? 'fijo de noche' : '',
      f.ctDiasDia ? `${dias(f.ctDiasDia)} de CT de día` : '', f.ctDiasNoche ? `${dias(f.ctDiasNoche)} de CT de noche` : '',
    ].filter(Boolean).join(' · ');
  }

  function lineaHoras(coche) {
    const ic = coche.iceberg;
    if (!ic) return '';
    const falta = textoFalta(coche);
    return `
      <div class="mt-1 flex items-center gap-1.5 text-[11px] text-telecab-muted tabular-nums" title="${esc(tituloHoras(coche))}">
        ${medidor(ic.horas)}<span><b class="text-telecab-text font-semibold">${fmtH(ic.horas)} h</b>${ic.huecos ? ` · ${ic.huecos} sin nadie` : ''}</span>
      </div>
      ${falta ? `<div class="mt-0.5 text-[11px] text-telecab-warn max-w-[11rem] whitespace-normal leading-tight">Falta ${esc(falta)}</div>` : ''}`;
  }

  // ── LA VISTA VERTICAL: una tarjeta por coche ────────────────────────────────
  // Lo mismo que la fila de la tabla, apilado: arriba la matrícula, su estado y
  // sus horas; debajo las plazas, el DÍA a la izquierda y la NOCHE a la derecha.
  // El teléfono y la zona de casa van en la ayuda del nombre para que quepan más
  // coches a la vista; la libranza excepcional y la zona de casa se editan en la
  // vista horizontal.
  function tarjetasCoches(lista, enCuadrante) {
    const wrap = document.createElement('div');
    wrap.className = 'grid gap-2 grid-cols-1 md:grid-cols-2 2xl:grid-cols-3';
    lista.forEach(coche => wrap.appendChild(tarjetaCoche(coche, enCuadrante)));
    return wrap;
  }

  function tarjetaCoche(coche, enCuadrante) {
    const art = document.createElement('article');
    art.dataset.vehiculo = coche.vehiculoId;  // para «Ver su cuadrante»
    const tono = tonoEstado(coche.estadoVeh);
    const parado = !coche.visibleCobertura;
    const ic = coche.iceberg || {};
    const falta = textoFalta(coche);
    const descTxt = (coche.descanso && coche.descanso.length) ? diasTexto(coche.descanso) : '';
    art.className = `rounded-2xl border p-3 flex flex-col gap-2 min-w-0 scroll-mt-24 ${parado ? 'border-telecab-red/40 bg-telecab-red/5' : 'border-telecab-border bg-telecab-card'}`;
    const accion = (data, icono, titulo) =>
      `<button type="button" ${data} title="${esc(titulo)}" class="w-7 h-7 rounded-lg text-telecab-muted hover:bg-telecab-card2 hover:text-telecab-gold transition-colors"><i class="fa-solid ${icono} text-xs"></i></button>`;
    art.innerHTML = `
      <header class="flex items-center gap-2 min-w-0">
        <span class="w-2 h-2 rounded-full shrink-0 ${ESCALON[escalonDe(coche)].punto}" title="${esc(ESCALON[escalonDe(coche)].tit)}"></span>
        <span class="font-semibold tabular-nums">${esc(coche.matricula)}</span>
        <button type="button" data-estado class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-md text-[11px] font-semibold
                       bg-telecab-${tono}/15 text-telecab-${tono} border border-telecab-${tono}/30 hover:bg-telecab-${tono}/25 transition-colors">
          ${esc(ESTADO_ETQ.get(coche.estadoVeh) || coche.estadoVeh)}<i class="fa-solid fa-chevron-down text-[8px]"></i></button>
        <span class="ml-auto flex items-center gap-1.5 text-[11px] text-telecab-muted tabular-nums whitespace-nowrap" title="${esc(tituloHoras(coche))}">
          ${medidor(ic.horas)}<b class="text-telecab-text font-semibold">${fmtH(ic.horas)} h</b></span>
      </header>
      <div class="flex items-center gap-1 -mt-1">
        <button type="button" data-desc title="Editar el descanso del coche (día y noche)"
                class="px-1.5 py-0.5 rounded-md text-[11px] font-semibold border transition-colors hover:border-telecab-gold/50
                       ${descTxt ? 'bg-telecab-gold/10 text-telecab-gold border-telecab-gold/30' : 'border-dashed border-telecab-border text-telecab-muted'}">
          ${descTxt ? 'libra ' + esc(descTxt) : 'sin descanso'}</button>
        ${falta ? `<span class="min-w-0 truncate text-[11px] text-telecab-warn" title="${esc('Falta ' + falta)}">Falta ${esc(falta)}</span>` : ''}
        <span class="ml-auto flex items-center shrink-0">
          ${accion('data-cua', enCuadrante ? 'fa-object-ungroup' : 'fa-object-group', enCuadrante ? 'Sacar del cuadrante' : 'Meter en un cuadrante')}
          ${accion('data-swap', 'fa-shuffle', 'Intercambiar coche por otro (cada tripulación se queda en su cuadrante y días; solo cambia la matrícula)')}
          ${accion('data-cambiar', 'fa-right-left', 'Cambiar de coche (llevarse la tripulación a una matrícula libre)')}
        </span>
      </div>
      <div class="grid grid-cols-2 gap-x-2 gap-y-1" data-plazas>
        <div class="px-2 text-[10px] font-semibold uppercase tracking-wider text-telecab-muted"><i class="fa-solid fa-sun mr-1"></i>Día</div>
        <div class="px-2 text-[10px] font-semibold uppercase tracking-wider text-telecab-muted"><i class="fa-solid fa-moon mr-1"></i>Noche</div>
      </div>`;
    art.querySelector('[data-estado]').addEventListener('click', () => cambiarEstado(coche));
    art.querySelector('[data-desc]').addEventListener('click', () => fijarDescansoCoche(coche));
    art.querySelector('[data-cua]').addEventListener('click', () => enCuadrante ? sacarDeCuadrante(coche) : meterEnCuadrante(coche));
    art.querySelector('[data-swap]').addEventListener('click', () => reemplazarMatriculaUI(coche));
    art.querySelector('[data-cambiar]').addEventListener('click', () => cambiarCoche(coche));
    // Las plazas van por orden de slot (0 fijo día, 1 fijo noche, 2 CT día…):
    // en una rejilla de dos columnas eso deja el día a la izquierda.
    const rejilla = art.querySelector('[data-plazas]');
    cols().forEach(col => rejilla.appendChild(plazaCompacta(coche, (coche.personas || [])[col.slot] || {}, col)));
    if (parado) {
      const tieneGente = (coche.personas || []).some(p => p && p.id);
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'self-start text-[11px] text-telecab-red font-semibold ' + (tieneGente ? 'hover:underline' : 'cursor-default');
      b.innerHTML = `<i class="fa-solid fa-triangle-exclamation"></i> ${tieneGente ? 'cambiar matrícula aquí' : 'fuera de cobertura'}`;
      if (tieneGente) {
        b.title = 'Intercambia el coche por otro (libre o con bloque): las tripulaciones se quedan en su cuadrante y días, cambia la matrícula';
        b.addEventListener('click', () => reemplazarMatriculaUI(coche));
      }
      art.appendChild(b);
    }
    return art;
  }

  /** Una plaza en una línea: quién, su chip de horas y, debajo, lo que hay que saber. */
  function plazaCompacta(coche, p, col) {
    const esFijo = col.slot < 2;
    const rol = esFijo ? 'Fijo' : (col.refuerzo ? 'CT2' : 'CT');
    const persona = p.id ? porId.get(String(p.id)) : null;
    const div = document.createElement('div');
    div.className = 'min-w-0';
    const notas = [];
    if (p.futuro) notas.push(`<span class="text-telecab-gold"><i class="fa-solid fa-arrow-right-long"></i> ${esc((p.futuro.nombre || '').split(' ')[0])} llega ${esc(isoAes(p.futuro.desde).slice(0, 5))}</span>`);
    if (p.vacante) notas.push(`<span class="${p.vacante.estado === 'proceso' ? 'text-telecab-violet' : 'text-sky-400'}" title="${esc('Vacante ' + p.vacante.codigo + (p.vacante.candidato ? ' · ' + p.vacante.candidato : ' · sin candidato todavía'))}"><i class="fa-solid fa-briefcase text-[9px]"></i> ${esc(p.vacante.codigo)}</span>`);

    if (p.id) {
      const av = avisoAusencia(persona);
      const dias = esFijo ? '' : ((p.diasManual || []).some(Boolean)
        ? (p.diasManual || []).map((v, i) => (v ? DIAS_LETRA[i] : null)).filter(Boolean).join(' ')
        : diasTexto((p.diasSugeridos || []).map(d => d + 1)));
      if (!esFijo) notas.unshift(`<span>${dias ? esc(dias) : 'sin días'}</span>`);
      if (av) notas.unshift(`<span class="text-telecab-${av.tono} font-semibold"><i class="fa-solid fa-triangle-exclamation"></i> ${esc(av.texto)}</span>`);
      const nombre = persona ? persona.nombre : p.nombre;
      const ayuda = [nombre, (persona && persona.telefono) ? 'Tel. ' + persona.telefono : 'Sin teléfono',
        persona && persona.barrio ? 'Vive en ' + persona.barrio : '', 'Pincha para cambiar o quitar.'].filter(Boolean).join('\n');
      // El nombre se queda con todo el ancho de la línea; el chip de horas y lo
      // demás van debajo. Con el chip al lado, en una tarjeta estrecha el nombre
      // se quedaba en «Carl…».
      const rend = chipRend(persona && persona.rendimiento);
      div.innerHTML = `
        <button type="button" data-asignar title="${esc(ayuda)}" class="group w-full text-left px-2 py-1 rounded-lg hover:bg-telecab-card2 transition-colors">
          <span class="flex items-center gap-1.5 min-w-0">
            <span class="text-[10px] font-semibold text-telecab-muted w-7 shrink-0">${rol}</span>
            <span class="min-w-0 truncate text-[13px] ${av && av.tachado ? 'line-through text-telecab-muted' : 'font-medium group-hover:text-telecab-gold'}">${esc(nombre)}</span>
            ${llaveFichaje(persona)}
          </span>
          ${(rend || notas.length) ? `<span class="flex flex-wrap items-center gap-x-2 gap-y-0.5 mt-0.5 pl-[2.125rem] text-[10px] leading-tight text-telecab-muted">${rend}${notas.join('')}</span>` : ''}
        </button>`;
    } else {
      // Un hueco salta a la vista: el de fijo en rojo, el de CT en naranja, el que
      // ya está prometido en una vacante en azul (hay que esperarlo, no buscarlo).
      const cls = p.vacante ? 'border-sky-500/60 bg-sky-500/10 text-sky-400'
        : esFijo ? 'border-telecab-red/60 bg-telecab-red/10 text-telecab-red'
          : 'border-telecab-warn/60 bg-telecab-warn/10 text-telecab-warn';
      div.innerHTML = `
        <button type="button" data-asignar class="w-full text-left px-2 py-1 rounded-lg border border-dashed text-xs font-semibold transition hover:brightness-110 ${cls}">
          <span class="text-[10px] w-7 inline-block">${rol}</span>${p.vacante ? 'En vacante' : 'Hueco'}
        </button>
        ${notas.length ? `<span class="flex flex-wrap gap-x-2 pl-[2.125rem] mt-0.5 text-[10px] leading-tight text-telecab-muted">${notas.join('')}</span>` : ''}`;
    }
    div.querySelector('[data-asignar]').addEventListener('click', () => asignar(coche, p, col));
    // Ausente y ocupando plaza: el atajo para poner a quien lo cubre.
    if (p.id && persona && persona.ausente) {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'ml-[2.125rem] mt-0.5 text-[10px] font-semibold text-telecab-gold hover:underline';
      b.innerHTML = '<i class="fa-solid fa-user-plus"></i> Cubrir';
      b.title = `Poner a alguien mientras ${persona.nombre.split(' ')[0]} no está.` +
        (persona.vuelveEl ? ` La plaza vuelve a ser suya el ${isoAes(persona.vuelveEl)}.` : ' Su ausencia no tiene fecha de vuelta.');
      b.addEventListener('click', e => { e.stopPropagation(); cubrirUI(coche, p, col, persona); });
      div.appendChild(b);
    }
    return div;
  }

  // El aviso de ausencia de un conductor: vacaciones (libera la plaza -> hueco),
  // baja/permiso (alerta, sigue asignado), o una ausencia que entra pronto.
  function avisoAusencia(c) {
    if (!c) return null;
    if (c.ausente) {
      const vuelve = c.vuelveEl && c.vuelveEl <= sumarDias(DIA, 7) ? ` · vuelve ${isoAes(c.vuelveEl)}` : '';
      // Cualquier ausente deja el dia sin cubrir (hueco); el tachado (se quita del
      // cuadrante) es solo para las que liberan la plaza, como vacaciones.
      return { tono: c.liberaPlaza ? 'red' : 'warn', texto: c.estado + vuelve, hueco: true, tachado: !!c.liberaPlaza };
    }
    if (c.proxAusencia && c.proxAusencia.desde && c.proxAusencia.desde <= sumarDias(DIA, 7)) {
      return { tono: 'gold', texto: `entra en ${String(c.proxAusencia.estado || '').toLowerCase()} el ${isoAes(c.proxAusencia.desde)}`, hueco: false };
    }
    return null;
  }

  // ── EL RENDIMIENTO: "10,4 h · S" al lado del nombre ─────────────────────────
  // Promedio de horas del MES CORRIDO y su letra (S >=9 · A 8-9 · B 6-8 · C <6).
  // Cuenta lo de BOLT MÁS lo justificado (2 h de taller + 6 rodando = 8), y los
  // días que debía salir y no salió sin justificar cuentan como 0. Librar, las
  // vacaciones y las bajas no cuentan.
  const REND_TONO = {
    A: 'bg-emerald-500/20 text-emerald-400 border-emerald-500/40',
    B: 'bg-telecab-gold/20 text-telecab-gold border-telecab-gold/40',
    C: 'bg-amber-500/15 text-amber-500 border-amber-500/40',
    D: 'bg-red-500/15 text-red-500 border-red-500/40',
    N: 'bg-sky-500/15 text-sky-400 border-sky-500/40',
  };
  // LA LETRA ES LA CALIFICACIÓN A–D, no el promedio de horas.
  //
  // A partir del modelo ABCD, el chip pesa tres cosas: horas (50 %), utilización
  // (30 %) y excesos de velocidad (20 %) sobre los últimos 14 días. El número que
  // va delante sigue siendo las horas, porque es lo que se mira de un vistazo,
  // pero la letra ya no sale solo de ahí.
  function tituloRend(r) {
    if (!r || !r.total && r.total !== 0) return 'Calificación ' + ((r && r.letra) || '');
    const n = v => String(v == null ? '—' : v).replace('.', ',');
    let t = 'Calificación ' + r.letra + ' · ' + n(r.total) + ' puntos'
      + (r.desde ? ' (' + r.desde.slice(8, 10) + '/' + r.desde.slice(5, 7)
                 + ' – ' + r.hasta.slice(8, 10) + '/' + r.hasta.slice(5, 7) + ')' : '')
      // Los primeros días del mes es la letra del mes CERRADO (db/175): se dice.
      + (window.FichaConductor && FichaConductor.mesCerrado(r.hasta) ? '\n' + FichaConductor.mesCerrado(r.hasta) : '')
      + '\n· Horas ' + n(r.horas) + ' h/día en ' + r.dias + ' día(s) → ' + r.ptsHoras + ' pts (50 %)'
      + '\n· Utilización ' + n(r.utilProm) + ' % → ' + r.ptsUtilizacion + ' pts (30 %)'
      + '\n· Excesos de velocidad ' + n(r.excesos) + ' → ' + r.ptsVelocidad + ' pts (20 %)';
    if (r.topeAplicado) t += '\nAviso: por puntos sería ' + r.letraPorPuntos + ': la baja el tope por velocidad.';
    if (r.diasTelemetria != null && r.diasTelemetria < 14) {
      t += '\nAviso: solo ' + r.diasTelemetria + ' día(s) de telemetría: faltan excesos por contar.';
    }
    return t;
  }

  function chipRend(r, mini) {
    if (!r) return '';
    // Recién incorporado: no se promedia hasta el cuarto día. "0 h · C" en
    // alguien que lleva dos días no dice nada malo de él, dice que no se sabe.
    // Sin calificación todavía (menos de 5 días trabajados, o sin telemetría).
    if (r.nuevo) return `<span class="shrink-0 inline-flex items-center px-1.5 py-0 rounded border text-[10px] font-bold leading-[1.4] ${REND_TONO.N}" title="${esc('Sin calificar: ' + (r.motivo || 'datos insuficientes'))}">N/E</span>`;
    if (!r.dias) return '';
    const h = String(r.horas).replace('.', ',');
    return `<span class="shrink-0 inline-flex items-center gap-1 px-1.5 py-0 rounded border text-[10px] font-bold leading-[1.4] ${REND_TONO[r.letra] || REND_TONO.D}" title="${esc(tituloRend(r))}">` +
      `${h} h<span class="opacity-80">·</span>${r.letra}${r.topeAplicado ? '<i class="fa-solid fa-triangle-exclamation text-[8px] ml-0.5 align-middle"></i>' : ''}</span>`;
  }

  function celdaPuesto(coche, p, col) {
    const esFijo = p.rol === 'FIJO' || col.slot < 2;
    const wrap = document.createElement('div');
    const persona = p.id ? porId.get(String(p.id)) : null;

    // Aviso del PRÓXIMO DUEÑO: quien tiene esta plaza reservada para más adelante.
    // Se ve aunque ahora esté vacía o con un temporal ("→ Carlos · llega el 12/09").
    const fut = p.futuro
      ? `<span class="block text-[11px] text-telecab-gold font-semibold mt-0.5"><i class="fa-solid fa-arrow-right-long"></i> ${esc(p.futuro.nombre)} · llega ${isoAes(p.futuro.desde)}</span>`
      : '';

    // LA PLAZA ESTÁ PROMETIDA en una vacante. El cuadrante era el último en
    // enterarse: un hueco que Tráfico ve rojo puede llevar dos semanas
    // reclutándose, y se colocaba a alguien a mano encima de una plaza ya
    // ofrecida. Ahora lo dice la propia celda, y dice qué fase lleva.
    const vac = p.vacante;
    const vacHtml = !vac ? '' : (() => {
      const quien = vac.candidato
        ? `${esc(vac.candidato)}${vac.inicioPrevisto ? ' · entra ' + isoAes(vac.inicioPrevisto) : ''}`
        : 'sin candidato todavía';
      const releva = vac.motivo === 'recambio'
        ? ` · releva a ${esc((vac.sale || '').split(' ')[0] || '')}` +
          (vac.salidaPrevista ? ` (sale ${isoAes(vac.salidaPrevista)})` : '')
        : '';
      const tono = vac.estado === 'proceso' ? 'text-telecab-violet' : 'text-sky-400';
      const icono = vac.motivo === 'recambio' ? 'fa-right-left' : 'fa-briefcase';
      return `<span class="block text-[11px] ${tono} font-semibold mt-0.5"
                    title="Vacante ${esc(vac.codigo)}${vac.letras ? ' · días ' + esc(vac.letras) : ''}. ${vac.estado === 'proceso' ? 'Ya tiene candidato en proceso.' : 'Selección la está reclutando.'}">
                <i class="fa-solid ${icono} text-[9px]"></i> ${esc(vac.codigo)} · ${quien}${releva}</span>`;
    })();

    if (p.id) {
      // Sub-línea: para el fijo, los días que libra; para el CT, sus días.
      let sub = '';
      if (esFijo) sub = 'libra ' + (diasTexto(coche.descanso) || '—');
      else if (!esFijo) {
        const dias = (p.diasManual || []).some(Boolean)
          ? (p.diasManual || []).map((v, i) => v ? DIAS_LETRA[i] : null).filter(Boolean).join(' ')
          : diasTexto((p.diasSugeridos || []).map(d => d + 1));
        sub = dias ? ('días ' + dias) : 'sin días';
      }
      const ett = persona && persona.esEtt ? ' <span class="text-telecab-violet">ETT</span>' : '';
      const av = avisoAusencia(persona);
      const nombreCls = av && av.tachado ? 'line-through text-telecab-muted' : 'font-medium group-hover:text-telecab-gold';
      // El teléfono SIEMPRE a la vista bajo el nombre. El envío por WhatsApp va en
      // la cabecera del cuadrante: UN botón por cuadrante, no uno por persona.
      const tel = (persona && persona.telefono) || '';
      wrap.innerHTML = `
        <button class="text-left w-full group" data-asignar>
          <span class="${nombreCls} transition">${esc(persona ? persona.nombre : p.nombre)}${ett}${llaveFichaje(persona)}</span>
          ${chipRend(persona && persona.rendimiento)}
          ${tel ? `<span class="block text-[11px] text-telecab-muted font-mono tabular-nums">${esc(tel)}</span>`
                : `<span class="block text-[11px] text-telecab-warn/80">sin teléfono</span>`}
          <span data-barrio class="block text-[11px] ${(persona && persona.barrio) ? 'text-telecab-gold/80' : 'text-telecab-muted/50'} hover:text-telecab-gold transition" title="La zona del conductor (Aluche, San Blas…): pincha para cambiarla"><i class="fa-solid fa-house text-[9px]"></i> ${(persona && persona.barrio) ? esc(persona.barrio) : 'poner zona'}</span>
          <span class="block text-xs text-telecab-muted">${esc(sub)}</span>
          ${av ? `<span class="block text-[11px] text-telecab-${av.tono} font-semibold"><i class="fa-solid fa-triangle-exclamation"></i> ${esc(av.texto)}${av.hueco ? ' · sin cubrir' : ''}</span>` : ''}
          ${fut}
          ${vacHtml}
        </button>`;
      wrap.querySelector('[data-asignar]').addEventListener('click', () => asignar(coche, p, col));
      // La zona se edita desde su propia línea, sin disparar el "asignar" de la carta.
      wrap.querySelector('[data-barrio]').addEventListener('click', e => {
        e.stopPropagation();
        editarBarrio(persona || { id: p.id, nombre: p.nombre, barrio: '' });
      });
    } else {
      // Un hueco tiene que SALTAR a la vista para localizarlos rápido: fondo tintado
      // + icono de aviso. El fijo vacío en rojo (crítico); el CT vacío en ámbar.
      // Un hueco YA PROMETIDO no es el mismo hueco: no hay que salir a buscar a
      // nadie, hay que esperar a que llegue. Se pinta distinto para que no se
      // cuente dos veces la misma falta.
      const cls = vac
        ? 'border-sky-500/60 bg-sky-500/10 text-sky-400'
        : esFijo
          ? 'border-telecab-red/60 bg-telecab-red/10 text-telecab-red'
          : 'border-telecab-warn/60 bg-telecab-warn/10 text-telecab-warn';
      const texto = vac
        ? (vac.candidato ? 'Hueco · candidato en camino' : 'Hueco · en vacante')
        : (esFijo ? 'Hueco · sin fijo' : 'Hueco · colocar CT');
      wrap.innerHTML = `
        <button class="text-left w-full px-2 py-1 rounded-lg border border-dashed font-semibold transition ${cls} hover:brightness-110"
                data-asignar>
          <i class="fa-solid ${vac ? 'fa-hourglass-half' : 'fa-triangle-exclamation'} text-xs"></i> ${texto}
        </button>
        ${vacHtml}
        ${fut}`;
      wrap.querySelector('[data-asignar]').addEventListener('click', () => asignar(coche, p, col));
    }

    // AUSENTE Y OCUPANDO PLAZA: la casilla para poner a quien lo cubre. Va aquí,
    // pegada al aviso de que está de vacaciones, porque es justo cuando se
    // piensa en ello: el que ve el hueco es el que sabe a quién meter.
    if (p.id && persona && persona.ausente) {
      const b = document.createElement('button');
      b.className = 'mt-1 w-full text-left px-2 py-1 rounded-lg border border-dashed '
        + 'border-telecab-gold/50 bg-telecab-gold/5 text-[11px] font-semibold text-telecab-gold '
        + 'hover:bg-telecab-gold/15 transition';
      b.innerHTML = '<i class="fa-solid fa-user-plus"></i> Cubrir esta plaza';
      b.title = persona.vuelveEl
        ? `Poner a alguien mientras ${persona.nombre.split(' ')[0]} no está. La plaza vuelve a ser suya el ${isoAes(persona.vuelveEl)}.`
        : `Poner a alguien mientras ${persona.nombre.split(' ')[0]} no está. Su ausencia no tiene fecha de vuelta.`;
      b.addEventListener('click', e => { e.stopPropagation(); cubrirUI(coche, p, col, persona); });
      wrap.appendChild(b);
    }

    // En un fijo colocado, atajo a la libranza excepcional.
    if (esFijo && p.id) {
      const b = document.createElement('button');
      b.className = 'mt-1 text-[11px] text-telecab-muted hover:text-telecab-gold transition';
      b.innerHTML = '<i class="fa-solid fa-calendar-day"></i> libranza excepcional';
      b.addEventListener('click', () => libranzaExcepcional(persona || { id: p.id, nombre: p.nombre }));
      wrap.appendChild(b);
    }
    return wrap;
  }

  // ── Paneles laterales ─────────────────────────────────────────────────────
  function pintarLaterales() {
    // Huérfanos: con una base abierta, los de esa base (lo mismo que su tarjeta).
    const huerf = (T.huerfanos || []).filter(h => !ZONA || (h.zonaClave || SIN_BASE) === ZONA);
    $('#panel-huerfanos').classList.toggle('hidden', huerf.length === 0);
    $('#huerfanos').innerHTML = huerf.map(h => `
      <div class="flex items-center gap-2 px-2 py-1.5 rounded-lg bg-telecab-card border border-telecab-border">
        <div class="min-w-0 flex-1">
          <div class="text-sm font-medium truncate">${esc(h.conductor)}</div>
          <div class="text-[11px] text-telecab-muted">${esc(h.matricula)} · ${esc(h.estado)} · ${esc(h.turno)}</div>
        </div>
      </div>`).join('');

    // Emergencia
    const emer = T.emergencia || [];
    $('#panel-emergencia').classList.toggle('hidden', emer.length === 0);
    $('#emergencia').innerHTML = emer.map(e => `
      <span class="inline-flex items-center gap-1 px-2 py-1 rounded-lg text-xs font-semibold bg-telecab-gold/10 text-telecab-gold border border-telecab-gold/30">
        <i class="fa-solid fa-car-side"></i>${esc(e.matricula)}${e.zona ? ` <span class="text-telecab-muted">${esc(e.zona)}</span>` : ''}
      </span>`).join('');

    pintarLlegadas();
    pintarBajas();
    pintarBanquillo();
    pintarAusentes();
  }

  /**
   * Los que NO se pueden planificar hoy, en sus propias tarjetas.
   *
   * Están fuera del banquillo a propósito: el banquillo es la lista de a quién
   * puedo poner en un coche, y mezclar ahí a quien está de vacaciones obliga a
   * leérsela entera para saber quién sirve. Pero tienen que verse —el de baja
   * médica antes no salía en ninguna parte y su ausencia no se explicaba sola.
   */
  function pintarAusentes() {
    const pinta = (lista, idPanel, idLista, idNum, conFecha) => {
      const l = lista || [];
      $('#' + idPanel).classList.toggle('hidden', !l.length);
      $('#' + idNum).textContent = l.length;
      $('#' + idLista).innerHTML = l.map(p => `
        <div class="px-2 py-1.5 rounded-lg bg-telecab-card2/40 border border-telecab-border/70">
          <div class="text-sm truncate">${esc(p.nombre)}</div>
          <div class="text-[11px] text-telecab-muted">${esc(p.estado || '')}${
            conFecha && p.vuelveEl ? ` · vuelve <span class="text-telecab-gold">${isoAes(p.vuelveEl)}</span>` : ''
          }${p.turno ? ' · ' + esc(p.turno) : ''}</div>
        </div>`).join('');
    };
    pinta(T.ausentesConVuelta, 'panel-vuelven', 'vuelven', 'vuelven-n', true);
    pinta(T.ausentesSinFecha, 'panel-sinfecha', 'sinfecha', 'sinfecha-n', false);
  }

  let banqTab = 'todos';   // todos | ett | propios
  function pintarBanquillo() {
    const q = ($('#banq-busca').value || '').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
    const gente = (T.pendientes || []).filter(p => {
      if (banqTab === 'ett' && !p.esEtt) return false;
      if (banqTab === 'propios' && p.esEtt) return false;
      if (!q) return true;
      const t = (p.nombre + ' ' + (p.dni || '') + ' ' + (p.ettNombre || '') + ' ' + (p.telefono || '') + ' ' + (p.barrio || '') + ' ' + (p.turno || '') + ' ' + ((p.rendimiento && p.rendimiento.letra) || '')).toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
      return t.includes(q);
    });
    document.querySelectorAll('.banq-tab').forEach(b => {
      const on = b.dataset.banqTab === banqTab;
      b.className = 'banq-tab px-2.5 py-1 rounded-lg text-xs font-semibold border transition ' +
        (on ? 'bg-telecab-gold text-telecab-dark border-telecab-gold' : 'bg-telecab-card border-telecab-border text-telecab-muted hover:border-telecab-gold/40');
    });
    $('#banq-n').textContent = `${gente.length}/${(T.pendientes || []).length}`;
    $('#banquillo').innerHTML = gente.length ? gente.map(p => `
      <div class="px-2 py-1.5 rounded-lg bg-telecab-card2/50 border border-telecab-border">
        <div class="text-sm font-medium truncate">${esc(p.nombre)}${p.esEtt ? ` <span class="text-telecab-violet text-xs">ETT${p.ettNombre ? ' ' + esc(p.ettNombre) : ''}</span>` : ''} ${chipRend(p.rendimiento)}</div>
        <div class="text-[11px] text-telecab-muted">${p.telefono ? `<span class="font-mono tabular-nums">${esc(p.telefono)}</span> · ` : ''}${esc(p.turno || 'sin turno')}${p.contrato ? ' · ' + esc(p.contrato) : ''}${p.boltPendiente ? ' · <span class="text-telecab-warn">sin BOLT</span>' : ''}</div>
        ${p.faltanDias ? `<div class="text-[11px] text-telecab-gold"><i class="fa-solid fa-calendar-day text-[9px]"></i> correturnos a medio poner: ${p.diasPuestos} de ${p.diasQueDebeCT} días${
          (p.diasDePlaza || []).length ? ` (lleva ${p.diasDePlaza.map(d => 'LMXJVSD'[d - 1] || '?').join('')})` : ''}</div>` : ''}
        ${p.llega ? `<div class="text-[11px] text-telecab-violet"><i class="fa-solid fa-arrow-right-to-bracket text-[9px]"></i> ya entra el ${isoAes(p.llega.desde)} en ${esc(p.llega.matriculas.join(' · '))}</div>` : ''}
        <button data-barrio="${p.id}" class="block text-[11px] text-left ${p.barrio ? 'text-telecab-gold/80' : 'text-telecab-muted/50'} hover:text-telecab-gold transition"><i class="fa-solid fa-house text-[9px]"></i> ${p.barrio ? esc(p.barrio) : 'poner zona'}</button>
        ${p.ausente ? `<div class="text-[11px] text-telecab-warn"><i class="fa-solid fa-plane-departure"></i> ${esc(p.estado)}${p.vuelveEl ? ` · vuelve ${isoAes(p.vuelveEl)}` : ''}</div>` : ''}
      </div>`).join('') : '<p class="text-xs text-telecab-muted text-center py-4">Nadie en el banquillo.</p>';
    $('#banquillo').querySelectorAll('[data-barrio]').forEach(b => b.addEventListener('click', () => {
      const c = porId.get(String(b.dataset.barrio));
      if (c) editarBarrio(c);
    }));
  }

  function pintarAvisos(avisos) {
    const btn = $('#btn-avisos');
    btn.classList.toggle('hidden', !avisos.length);
    btn.classList.toggle('flex', avisos.length > 0);
    $('#btn-avisos-n').textContent = avisos.length;
    const cont = $('#avisos');
    if (!avisos.length) { cont.classList.add('hidden'); return; }
    cont.innerHTML = `
      <div class="rounded-2xl border border-telecab-warn/30 bg-telecab-warn/5 p-3">
        <ul class="space-y-1 text-sm">${avisos.map(a => `<li class="flex items-start gap-2"><i class="fa-solid fa-circle text-[5px] mt-2 text-telecab-warn"></i><span>${esc(a.msg)}</span></li>`).join('')}</ul>
      </div>`;
  }

  // ── Acciones ─────────────────────────────────────────────────────────────
  async function guardarCambios(cambios) {
    const r = await fetch('/planificador-v2/api/guardar', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ dia: DIA, cambios }),
    });
    const j = await r.json();
    if (!r.ok || j.status === 'error') throw new Error(j.msg || 'No se pudo guardar');
    if (j.tablero) aplicar(j.tablero);
    return j;
  }

  /** Pregunta al servidor qué días haría y con qué choca. */
  async function comprobarPlan(cuerpo) {
    const r = await fetch('/planificador-v2/api/comprobar', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(cuerpo),
    });
    const j = await r.json();
    if (!r.ok || j.status === 'error') throw new Error(j.msg || 'No se pudo comprobar');
    return j.plan;
  }

  /** El parte de la comprobación, día a día, para enseñarlo antes de guardar. */
  function htmlPlan(plan) {
    const fila = f => {
      const choca = f.choca.length;
      const ocup = f.ocupado.length;
      const tono = choca ? 'text-telecab-red' : ocup ? 'text-telecab-warn' : 'text-telecab-green';
      const icono = choca ? 'fa-ban' : ocup ? 'fa-user-xmark' : 'fa-check';
      const dice = choca
        ? `ya lleva ${esc(f.choca.map(c => c.matricula + ' (' + c.turno.toLowerCase() + ')').join(', '))}`
        : ocup
          ? `lo lleva ${esc(f.ocupado.map(o => o.conductor).join(', '))}`
          : 'el coche está libre';
      return `<tr class="border-t border-telecab-border/60">
        <td class="py-1.5 pr-3 font-semibold">${f.letra} <span class="text-telecab-muted font-normal">${isoAes(f.dia)}</span></td>
        <td class="py-1.5 pr-3 text-[11px] ${f.esLibranza ? 'text-telecab-green' : 'text-telecab-muted'}">
          ${f.esLibranza ? 'libra ese día' : 'no es su libranza'}</td>
        <td class="py-1.5 ${tono}"><i class="fa-solid ${icono} text-[10px] mr-1"></i>${dice}</td>
      </tr>`;
    };
    return `
      <p class="text-sm text-telecab-muted mb-2">
        <b class="text-telecab-text">${esc(plan.conductor)}</b> haría
        <b class="text-telecab-gold">${esc(plan.letras || '—')}</b> en <b>${esc(plan.matricula)}</b>
        (${esc(plan.etiqueta)}).</p>
      <table class="w-full text-sm"><tbody>${plan.filas.map(fila).join('')}</tbody></table>`;
  }

  // Colocar / cambiar / quitar a alguien en un puesto.
  //
  // Colocar ya no es "elige a alguien y listo". Antes de guardar hay que saber
  // QUÉ DÍAS va a trabajar en esa matrícula y comprobar dos cosas que el tablero
  // dejaba hacer en silencio: que nadie lleve dos coches el mismo día (imposible,
  // y además tienen que descansar) y que el coche esté libre ese día. Lo segundo
  // se puede forzar; lo primero no.
  async function asignar(coche, p, col) {
    if (!p.plazaId) { await Dialogo.aviso({ titulo: 'Recarga', texto: 'Esta plaza no existe todavía en la base. Recarga el cuadrante.', tono: 'aviso' }); return; }
    const ev = (T.eventos || {}).vigente;
    // Si la plaza tiene DUEÑO FUTURO, se recuerda en el título: estás planificando
    // "mientras llega él".
    const tit = `${col.tit} · ${coche.matricula}` +
      (p.futuro ? ` · llega ${(p.futuro.nombre || '').split(' ')[0]} el ${isoAes(p.futuro.desde)}` : '');
    const id = await pickConductor({ titulo: tit, turno: col.turno, actual: p.id ? String(p.id) : null });
    if (id === undefined) return;   // cancelado

    // QUITAR A ALGUIEN. No necesita comprobación, pero CON EVENTO hay que
    // preguntar lo mismo que al colocar: quitarlo estos días o quitarlo del
    // todo. Fue justo esto lo que rompió el finde de la F1 — se vaciaron las
    // plazas de correturnos para dejar solo fijos y se quedaron vacías para
    // siempre, así que el lunes esa gente no tenía plaza y el WhatsApp se lo
    // dijo. Ahora por defecto se les devuelve la plaza al acabar el evento.
    if (!id) {
      let slotVacio = { plazaId: p.plazaId, id: '' };
      if (ev && p.id) {
        const q = await Dialogo.formulario(`Quitar a ${p.nombre} de ${coche.matricula}`, [
          { id: 'alcance', etiqueta: '¿Lo quitas para siempre o solo estos días?', tipo: 'opciones',
            obligatorio: true, valor: 'evento', opciones: [
              { valor: 'evento', texto: `Solo durante el evento (${isoAes(ev.desde)} → ${isoAes(ev.hasta)})`,
                detalle: 'Recupera su plaza al acabar, y su WhatsApp de la semana que viene sale bien.' },
              { valor: 'permanente', texto: 'Quitarlo del cuadrante',
                detalle: 'Deja de tener esa plaza. No vuelve solo.' },
            ] },
        ], { textoBoton: 'Quitar', ancho: 'max-w-lg' });
        if (!q) return;
        if (((q.alcance || {}).valor || 'evento') === 'evento') slotVacio.eventoId = ev.id;
      }
      try {
        const j = await guardarCambios([{ vehiculoId: coche.vehiculoId, slots: [slotVacio] }]);
        if (slotVacio.eventoId) {
          await Dialogo.aviso({ titulo: 'Quitado solo durante el evento', tono: 'ok',
            texto: `${p.nombre} recupera ${coche.matricula} el ${isoAes(ev.hasta)} +1. ` +
              'En su WhatsApp verá que esos días libra y que la semana que viene vuelve a lo de siempre.' });
        }
      } catch (e) { await Dialogo.aviso({ titulo: 'No se ha podido', texto: e.message, tono: 'error' }); }
      return;
    }

    // Los días de partida: los suyos si ya los tenía, si no los sugeridos (los
    // que libra el fijo del coche). Un FIJO no elige: hace todos menos el
    // descanso del coche, y eso lo calcula el servidor.
    const esCT = p.rol === 'CT' || col.slot >= 2;
    const diasPrevios = (p.diasManual || []).some(Boolean)
      ? (p.diasManual || []).map((v, i) => v ? i + 1 : null).filter(Boolean)
      : (p.diasSugeridos || []).map(d => d + 1);

    // El refuerzo de un evento CADUCA con el evento: las fechas vienen puestas y
    // no hay que acordarse de cerrarlas. Eso es lo que lo hace "momentáneo".
    const campos = [];
    if (esCT) {
      campos.push({ id: 'dias', etiqueta: 'Qué días trabaja en esta matrícula', tipo: 'semana',
        valor: diasPrevios });
    }
    // CON EVENTO VIVO, LA PRIMERA PREGUNTA ES OTRA: ¿esto es un apaño de estos
    // días o un cambio de verdad? De la respuesta depende que el cuadrante
    // vuelva solo a lo de antes. Un apaño se cierra con el evento y AL QUE SE
    // ECHA se le repone con fecha de vuelta en el mismo movimiento.
    if (ev) {
      campos.push({ id: 'alcance', etiqueta: '¿Hasta cuándo?', tipo: 'opciones',
        obligatorio: true, valor: 'evento', opciones: [
          { valor: 'evento', texto: `Solo durante el evento (${isoAes(ev.desde)} → ${isoAes(ev.hasta)})`,
            detalle: 'Al terminar, el cuadrante vuelve solo a como estaba y al que estaba aquí se le repone.' },
          { valor: 'permanente', texto: 'Cambio permanente',
            detalle: 'Se queda después del evento. Al que estaba aquí NO se le repone.' },
        ] });
    }
    campos.push({ id: 'desde', etiqueta: 'Desde', tipo: 'fecha',
      valor: ev && ev.desde > DIA ? isoAes(ev.desde) : '',
      ayuda: ev ? `Vacío = hoy. El evento "${ev.nombre}" va del ${isoAes(ev.desde)} al ${isoAes(ev.hasta)}.`
                : 'Vacío = desde el día que estás mirando.' });
    campos.push({ id: 'hasta', etiqueta: 'Hasta (último día)', tipo: 'fecha',
      valor: p.hasta ? isoAes(p.hasta) : '',
      ayuda: ev
        ? 'Si es del evento, se rellena solo con la fecha de fin: no hace falta tocarlo.'
        : (p.futuro ? `Vacío = hasta la víspera de que llegue ${p.futuro.nombre} (${isoAes(p.futuro.desde)}).`
                    : 'Vacío = indefinido.') });

    const v = await Dialogo.formulario(tit, campos, {
      textoBoton: 'Comprobar y colocar', ancho: 'max-w-lg',
      nota: esCT
        ? 'Se comprobará que esos días los tiene libres y que el coche no lo lleva ya otro.'
        : 'Un fijo hace todos los días menos el descanso del coche. Se comprobará igual.',
    });
    if (!v) return;

    // Con evento, "solo durante el evento" es lo normal: si no se toca nada, eso
    // es lo que sale, que es lo que casi siempre se quiere un viernes por la tarde.
    const deEvento = !!ev && ((v.alcance || {}).valor || 'evento') === 'evento';
    const base = {
      plazaId: p.plazaId, conductorId: id,
      dias: esCT ? (v.dias || []) : [],
      desde: (v.desde || '').trim() || DIA,
      hasta: deEvento ? ev.hasta : ((v.hasta || '').trim() || null),
    };
    if (esCT && !base.dias.length) {
      await Dialogo.aviso({ titulo: 'Faltan los días', tono: 'aviso',
        texto: 'Un correturnos sin días no cubre nada: marca al menos uno.' });
      return;
    }

    let plan;
    try { plan = await comprobarPlan(base); }
    catch (e) { await Dialogo.aviso({ titulo: 'No se ha podido comprobar', texto: e.message, tono: 'error' }); return; }

    // IMPOSIBLE: ya lleva otro coche esos días. No hay "a la fuerza" que valga.
    if (plan.bloqueado) {
      await Dialogo.aviso({
        titulo: 'No puede llevar dos coches el mismo día', tono: 'error', ancho: 'max-w-lg',
        html: htmlPlan(plan) +
          '<p class="text-sm text-telecab-red mt-3">Para ponerlo aquí, primero hay que sacarlo del otro coche ' +
          'esos días (o cambiarle los días).</p>',
      });
      return;
    }

    // FORZABLE: el coche ya tiene conductor ese día. Se puede, apartándolo.
    let forzar = null;
    if (plan.forzable) {
      const f = await Dialogo.formulario('El coche ya tiene conductor esos días', [
        { id: 'motivoCodigo', etiqueta: 'Por qué se aparta al del cuadrante', tipo: 'opciones',
          obligatorio: true, opciones: (plan.motivos || []).map(m => ({ valor: m.codigo, texto: m.etiqueta })) },
        { id: 'motivo', etiqueta: 'Cuéntalo con tus palabras', tipo: 'texto-largo', obligatorio: true },
      ], {
        textoBoton: 'Planificar a la fuerza', ancho: 'max-w-lg',
        nota: 'No se le quita la plaza: se le aparta SOLO esos días. El día que llegue, Control dirá que ' +
          'conduce ' + plan.conductor + ' y por qué.',
      });
      if (!f) return;
      forzar = { forzar: true, motivoCodigo: (f.motivoCodigo || {}).valor || 'otro', motivo: f.motivo };
    }

    try {
      const slot = { plazaId: p.plazaId, id, dias: base.dias, desde: base.desde,
        ...(base.hasta ? { hasta: base.hasta } : {}), ...(forzar || {}),
        ...(deEvento ? { eventoId: ev.id } : {}) };
      const j = await guardarCambios([{ vehiculoId: coche.vehiculoId, slots: [slot] }]);
      const apartados = (j.hechos || []).filter(h => h.que === 'aparta');
      const repuestos = (j.hechos || []).filter(h => h.que === 'repone');
      if (apartados.length || repuestos.length) {
        const L = [];
        if (apartados.length) {
          L.push(`${plan.conductor} lleva ${coche.matricula} esos días. Se ha apartado a ` +
            [...new Set(apartados.map(a => a.sale))].join(', ') + ` (${apartados.length} día(s)).`);
        }
        if (repuestos.length) {
          // Lo que hace que el cuadrante vuelva solo: el que sale ya tiene fecha
          // de vuelta puesta, y se dice para que nadie tenga que fiarse.
          L.push(`La plaza vuelve a su dueño el ${isoAes(repuestos[0].desde)}: no hay que acordarse de nada.`);
        }
        await Dialogo.aviso({ titulo: apartados.length ? 'Colocado a la fuerza' : 'Colocado por el evento',
          tono: apartados.length ? 'aviso' : 'ok', texto: L.join(' ') });
      }
    } catch (e) { await Dialogo.aviso({ titulo: 'No se ha podido', texto: e.message, tono: 'error' }); }
  }

  /**
   * Cubrir a quien está ausente SIN quitarle la plaza.
   *
   * Lo que lo diferencia de colocar a alguien a secas: la plaza vuelve a ser del
   * titular el día que regresa, sin que nadie tenga que acordarse dentro de tres
   * semanas. Por defecto el reemplazo dura lo que dura su ausencia; las dos
   * fechas se pueden tocar porque a veces el sustituto entra dos días después.
   */
  async function cubrirUI(coche, p, col, titular) {
    if (!p.plazaId) { await Dialogo.aviso({ titulo: 'Recarga', texto: 'Esta plaza no existe todavía en la base. Recarga el cuadrante.', tono: 'aviso' }); return; }
    const nom = (titular.nombre || '').split(' ')[0];
    const id = await pickConductor({
      titulo: `Cubrir a ${nom} · ${coche.matricula} · ${col.tit}`,
      turno: col.turno, actual: null,
    });
    if (!id) return;   // cancelado o "dejar vacía": aquí no aplica

    const v = await Dialogo.formulario(`Mientras ${nom} está de ${String(titular.estado || '').toLowerCase()}`, [
      { id: 'desde', etiqueta: 'Desde (opcional)', tipo: 'fecha',
        ayuda: 'Vacío = desde que empieza su ausencia (o desde hoy, si ya empezó).' },
      { id: 'hasta', etiqueta: 'Hasta (opcional)', tipo: 'fecha',
        // El campo fecha del formulario se escribe dd/mm/aaaa (él lo devuelve en
        // ISO). Aquí decía isoDeFecha(), una función que NUNCA existió: con
        // fecha de vuelta —el caso normal, unas vacaciones— el diálogo reventaba
        // antes de abrirse y "Cubrir esta plaza" no hacía nada.
        valor: titular.vuelveEl ? isoAes(titular.vuelveEl) : '',
        ayuda: titular.vuelveEl
          ? `Vacío = hasta el ${isoAes(titular.vuelveEl)}, el último día de su ausencia. Al siguiente la plaza vuelve a ser suya.`
          : 'Su ausencia NO tiene fecha de vuelta, así que sin esta fecha la plaza se queda del sustituto '
            + 'hasta que alguien diga otra cosa.' },
    ], { textoBoton: 'Cubrir' });
    if (v === undefined || v === null) return;

    try {
      // `pedirTablero` ya repinta con el tablero que devuelve la ruta.
      const r = await pedirTablero('/planificador-v2/api/cubrir', {
        plazaId: p.plazaId, conductorId: id, dia: DIA,
        desde: (v.desde || '').trim() || null,
        hasta: (v.hasta || '').trim() || null,
      });
      const quien = ((T.conductores || []).find(c => String(c.id) === String(id)) || {}).nombre || 'El sustituto';
      await Dialogo.aviso({
        titulo: 'Plaza cubierta', tono: 'ok',
        texto: `${quien} lleva ${coche.matricula} del ${isoAes(r.cubierta.desde)} `
             + (r.cubierta.hasta ? `al ${isoAes(r.cubierta.hasta)}.` : 'en adelante, SIN fecha de fin.')
             + (r.vuelve ? ` ${nom} recupera su plaza el ${isoAes(r.vuelve.desde)}.`
                         : ` OJO: ${nom} no tiene vuelta programada; cuando vuelva habrá que devolvérsela a mano.`),
      });
    } catch (e) { await Dialogo.aviso({ titulo: 'No se ha podido', texto: e.message, tono: 'error' }); }
  }

  /**
   * Quiénes son los correturnos flojos y cómo tienen repartidos los días.
   *
   * La cifra sola no se puede arreglar: hace falta el nombre, el teléfono para
   * llamarle y VER el reparto, porque casi siempre el problema es que le falta
   * el segundo cuadrante, no que sobre él.
   */
  async function verCtFlojos() {
    const lista = resumenActual().ctFlojosLista || [];
    if (!lista.length) {
      await Dialogo.aviso({ titulo: 'Ningún correturnos corto', tono: 'ok',
        texto: 'Todos los correturnos colocados llegan a 4 días o más entre todos sus cuadrantes.' });
      return;
    }
    const filas = lista.map(x => `
      <tr class="border-t border-telecab-border/60">
        <td class="py-1.5 pr-2">
          <div class="font-medium">${esc(x.nombre)}</div>
          <div class="text-[11px] text-telecab-muted font-mono tabular-nums">${esc(x.telefono || 'sin teléfono')}</div>
        </td>
        <td class="py-1.5 px-2 text-center text-telecab-muted">${esc(x.turno)}${
          x.ausente ? `<div class="text-[10px] text-telecab-warn">${esc(x.ausente)}</div>` : ''}</td>
        <td class="py-1.5 px-2 text-center">
          <span class="px-1.5 py-0.5 rounded font-bold ${x.dias <= 2 ? 'bg-telecab-red/15 text-telecab-red' : 'bg-telecab-warn/15 text-telecab-warn'}">${x.dias}</span>
        </td>
        <td class="py-1.5 pl-2 text-[11px] text-telecab-muted">${esc(x.reparto)}</td>
      </tr>`).join('');
    await Dialogo.aviso({
      titulo: `${lista.length} correturnos con menos de 4 días`,
      ancho: 'max-w-2xl', tono: 'aviso',
      html: `
        <p class="text-sm text-telecab-muted mb-3">Los días son los que tiene ESCRITOS sumando todos sus
          cuadrantes: dos en un coche y dos en otro son cuatro, no dos. No es lo que cubre esta semana —a quien
          entra un viernes no le faltan días, es que aún no había llegado—; son los del reparto de la derecha.</p>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="text-[11px] uppercase tracking-wide text-telecab-muted">
              <tr><th class="text-left pb-1">Conductor</th><th class="pb-1">Turno</th>
                  <th class="pb-1">Días</th><th class="text-left pb-1 pl-2">Reparto</th></tr>
            </thead>
            <tbody>${filas}</tbody>
          </table>
        </div>`,
    });
  }

  async function cambiarEstado(coche) {
    const opciones = ESTADOS.map(e => ({ valor: e.codigo, texto: e.etiqueta }));
    const cod = await Dialogo.elegir({
      titulo: `Estado de ${coche.matricula}`,
      texto: 'Vale desde el día que estás mirando. Un coche que sale de cobertura deja a su gente en huérfanos.',
      opciones,
    });
    if (!cod || cod === coche.estadoVeh) return;
    try {
      await guardarCambios([{ vehiculoId: coche.vehiculoId, estadoVeh: cod }]);
    } catch (e) { alert(e.message); }
  }

  // Taller/siniestro: la matrícula nueva (de emergencia) hereda el bloque entero.
  async function reemplazarMatriculaUI(coche) {
    // Se puede intercambiar por una matrícula LIBRE (de emergencia) o por otra que
    // YA lleve bloque: en ese caso se intercambian (cada tripulación se queda en su
    // cuadrante y días, solo cambia la matrícula que lleva).
    const emergencia = (T.emergencia || []).map(e => ({ vehiculoId: e.vehiculoId, matricula: e.matricula + '  · libre', zona: e.zona }));
    const ocupados = (T.coches || [])
      .filter(c => String(c.vehiculoId) !== String(coche.vehiculoId) && (c.personas || []).some(p => p && p.id))
      .map(c => ({ vehiculoId: c.vehiculoId, matricula: c.matricula, zona: c.zona || (c.cuadrante || '') }));
    const opciones = ocupados.concat(emergencia);
    if (!opciones.length) { await Dialogo.aviso({ titulo: 'No hay con qué intercambiar', texto: 'No hay otra matrícula (ni libre ni con bloque) disponible.', tono: 'aviso' }); return; }
    const destino = await pickCoche({ titulo: `Intercambiar el coche de ${coche.matricula} por…`, coches: opciones });
    if (!destino) return;
    const destCoche = (T.coches || []).find(c => String(c.vehiculoId) === String(destino));
    const ocupado = destCoche && (destCoche.personas || []).some(p => p && p.id);
    const ok = await Dialogo.confirmar({
      titulo: `Intercambiar ${coche.matricula}`, si: 'Intercambiar', no: 'Cancelar',
      html: ocupado
        ? `<p>Se <b>intercambian</b> los coches: cada tripulación se queda en su <b>cuadrante</b> y sus <b>días</b>, y solo cambia la <b>matrícula</b> que lleva. ${esc(coche.matricula)} ⇄ ${esc(destCoche.matricula)}.</p>`
        : `<p>La matrícula nueva hereda el <b>cuadrante</b>, los <b>días</b> y la <b>tripulación</b>. ${esc(coche.matricula)} queda libre (en el taller).</p>`,
    });
    if (!ok) return;
    try {
      await pedirTablero('/planificador-v2/api/reemplazar-matricula', { de: coche.vehiculoId, a: destino, dia: DIA });
    } catch (e) { alert(e.message); }
  }

  async function cambiarCoche(coche, soloEmergencia) {
    // La matrícula nueva SOLO puede ser una que no tenga a nadie (de emergencia):
    // si llevara gente, moverla la dejaría sin sitio. Por eso, para el cambio de
    // un coche en taller/siniestro, solo se ofrecen las de emergencia.
    const emergencia = (T.emergencia || []).map(e => ({ vehiculoId: e.vehiculoId, matricula: e.matricula, zona: e.zona }));
    if (soloEmergencia && !emergencia.length) {
      await Dialogo.aviso({ titulo: 'Sin coches de emergencia', texto: 'No hay ninguna matrícula libre (sin nadie asignado) para meter aquí.', tono: 'aviso' });
      return;
    }
    const otros = soloEmergencia ? emergencia
      : (T.coches || []).filter(c => c.vehiculoId !== coche.vehiculoId)
          .concat(emergencia.map(e => ({ ...e, matricula: e.matricula + ' (emergencia)' })));
    const destino = await pickCoche({
      titulo: soloEmergencia ? `Matrícula de emergencia para ${coche.matricula}` : `Mover la tripulación de ${coche.matricula} a…`,
      coches: otros,
    });
    if (!destino) return;
    try {
      const r = await fetch('/planificador-v2/api/cambiar-coche', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ de: coche.vehiculoId, a: destino, dia: DIA }),
      });
      const j = await r.json();
      if (!r.ok || j.status === 'error') {
        if (j.ocupantes) {
          const ok = await Dialogo.confirmar({ titulo: 'El coche de destino lleva gente', tono: 'aviso', si: 'Quitarles la plaza y mover', no: 'Cancelar', html: `<p>${esc(j.ocupantes.join(', '))}</p>` });
          if (!ok) return;
          const r2 = await fetch('/planificador-v2/api/cambiar-coche', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ de: coche.vehiculoId, a: destino, dia: DIA, forzar: true }),
          });
          const j2 = await r2.json();
          if (!r2.ok || j2.status === 'error') throw new Error(j2.msg);
          if (j2.tablero) aplicar(j2.tablero);
          return;
        }
        throw new Error(j.msg);
      }
      if (j.tablero) aplicar(j.tablero);
    } catch (e) { alert(e.message); }
  }

  // ── El barrio (la zona del conductor: "Aluche", "San Blas"…) ──────────────
  // Texto libre de Tráfico. Se escribe en la ficha (conductor.barrio) y se
  // repinta en el sitio, sin recargar el tablero entero.
  async function editarBarrio(c) {
    const v = await Dialogo.formulario(`Zona de ${c.nombre}`, [
      { id: 'barrio', etiqueta: 'Barrio / zona', tipo: 'texto', valor: c.barrio || '',
        ayuda: 'Con tus palabras: Aluche, San Blas, Getafe… Vacío = quitarla.' },
    ], { textoBoton: 'Guardar' });
    if (v == null) return;
    try {
      const r = await fetch('/planificador-v2/api/barrio', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ conductorId: c.id, barrio: (v.barrio || '').trim() }),
      });
      const j = await r.json();
      if (j.status !== 'ok') throw new Error(j.msg || 'No se pudo guardar');
      const per = porId.get(String(c.id));
      if (per) per.barrio = j.barrio || '';
      pintar(); pintarLaterales(); pintarPrueba();
    } catch (e) {
      await Dialogo.aviso({ titulo: 'No se pudo guardar la zona', texto: e.message, tono: 'error' });
    }
  }

  // ── Fin del periodo de prueba, del más próximo al más lejano ──────────────
  // Los 3 meses de convenio desde el alta (o la fecha apuntada, si la hay). Solo
  // quienes SIGUEN en prueba: para ver venir a quién hay que decidirle pronto.
  function pintarPrueba() {
    const hoy = hoyISO();
    const lista = (T.conductores || [])
      .filter(c => c.finPrueba && c.finPrueba >= hoy)
      .sort((a, b) => a.finPrueba.localeCompare(b.finPrueba));
    $('#prueba-n').textContent = lista.length ? `${lista.length}` : '';
    const dias = f => Math.round((new Date(f + 'T00:00:00') - new Date(hoy + 'T00:00:00')) / 864e5);
    $('#prueba-lista').innerHTML = lista.length ? lista.map(c => {
      const n = dias(c.finPrueba);
      const tono = n <= 14 ? 'text-telecab-warn' : 'text-telecab-muted';
      return `<div class="px-2 py-1.5 rounded-lg bg-telecab-card2/50 border border-telecab-border flex items-center gap-2">
        <div class="min-w-0 flex-1">
          <div class="text-sm truncate">${esc(c.nombre)}${c.esEtt ? ' <span class="text-telecab-violet text-xs">ETT</span>' : ''}</div>
          <div class="text-[11px] text-telecab-muted">${c.alta ? 'alta ' + isoAes(c.alta) : ''}${c.barrio ? ' · ' + esc(c.barrio) : ''}</div>
        </div>
        <div class="text-right shrink-0">
          <div class="text-xs font-semibold tabular-nums ${tono}">${isoAes(c.finPrueba)}</div>
          <div class="text-[11px] ${tono}">${n === 0 ? 'hoy' : 'en ' + n + ' día' + (n === 1 ? '' : 's')}</div>
        </div>
      </div>`;
    }).join('') : '<p class="text-xs text-telecab-muted text-center py-3">Nadie en periodo de prueba.</p>';
  }

  // ── Enviar los turnos del CUADRANTE por WhatsApp (un botón por cuadrante) ──
  // Avisa a toda la gente colocada en esos coches que trabaja en la semana que se
  // está MIRANDO (en la actual, de hoy a 7 días); el detalle (coche, de quién
  // recibe y a quién entrega) lo sirve el bot cuando el conductor pulsa su
  // botón, y son sus turnos de ESE día a 7 días (28/09/2026). Reusa la
  // maquinaria de Cobertura: manda con ritmo para no pasarse de los límites de Meta.
  const lunesDeIso = iso => sumarDias(iso, -((new Date(iso + 'T00:00:00').getDay() + 6) % 7));
  async function enviarTurnosCuadrante(nombre, lista, btn) {
    const ids = [...new Set(lista.flatMap(c => (c.personas || []).filter(p => p && p.id).map(p => String(p.id))))];
    if (!ids.length) { await Dialogo.aviso({ titulo: 'Nadie colocado', texto: 'En estos coches no hay ningún conductor al que avisar.', tono: 'aviso' }); return; }
    const off = Math.round((new Date(T.lunes + 'T00:00:00') - new Date(lunesDeIso(hoyISO()) + 'T00:00:00')) / 6048e5);
    if (off < 0) { await Dialogo.aviso({ titulo: 'Semana pasada', texto: 'Estás mirando una semana que ya pasó: no tiene sentido avisar de esos turnos.', tono: 'aviso' }); return; }
    if (off > 8) { await Dialogo.aviso({ titulo: 'Demasiado lejos', texto: 'Solo se pueden avisar turnos hasta 8 semanas vista.', tono: 'aviso' }); return; }
    const sinTel = ids.filter(id => !((porId.get(id) || {}).telefono)).length;
    const ok = await Dialogo.confirmar({
      titulo: `Enviar turnos · ${nombre}`, tono: 'pregunta', si: 'Enviar', no: 'Cancelar',
      html: `<p class="text-sm">Se avisa por WhatsApp a la gente de ${lista.length === 1 ? 'este coche' : `estos ${lista.length} coches`} — ${ids.length} persona(s)${sinTel ? `, ${sinTel} sin teléfono` : ''} — de que tienen sus turnos listos. ${off === 0 ? 'Solo a quienes trabajan de hoy a 7 días.' : `Solo a quienes trabajan la semana del <b>${isoAes(T.fechas[0])}</b>.`}</p><p class="text-sm mt-2 text-telecab-muted">Al pulsar «Ver mis turnos», cada uno ve los suyos de ese día a 7 días: su coche, de quién lo recibe y a quién se lo entrega.</p>`,
    });
    if (!ok) return;
    const previo = btn.innerHTML;
    btn.disabled = true; btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Enviando…';
    try {
      const r = await fetch('/cobertura/enviar-turnos-varios', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        // `cuadrante` va al registro: "William avisó al cuadrante X a tal hora".
        body: JSON.stringify({ ids, semana: off, cuadrante: nombre }),
      });
      const j = await r.json();
      if (j.status !== 'ok') throw new Error(j.msg || 'No se pudo iniciar el envío');
      seguirEnvio(btn, previo);
    } catch (e) {
      btn.disabled = false; btn.innerHTML = previo;
      await Dialogo.aviso({ titulo: 'No se pudo enviar', texto: e.message, tono: 'error' });
    }
  }

  // El progreso del envío, en el propio botón (el estado es el de Cobertura).
  async function seguirEnvio(btn, previo) {
    for (let i = 0; i < 100; i++) {
      await new Promise(r => setTimeout(r, 3000));
      let p;
      try { p = ((await (await fetch('/cobertura/enviar-turnos/estado')).json()).progreso) || {}; }
      catch (_) { continue; }
      if (p.activo) { btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> ${p.enviados}/${p.total}`; continue; }
      const extra = (p.errores ? ` · ${p.errores} err` : '') + (p.sinTel ? ` · ${p.sinTel} sin tel` : '');
      btn.innerHTML = `<i class="fa-solid fa-check"></i> ${p.enviados}/${p.total} enviados${extra}`;
      btn.disabled = false;
      cargarAvisosTurnos();   // el envío acaba de apuntarse: que el chip se ponga verde
      return;
    }
    btn.disabled = false; btn.innerHTML = previo;
  }

  async function libranzaExcepcional(persona) {
    const lunes = T.fechas[0], domingo = T.fechas[6];
    const datos = await Dialogo.formulario(
      `Libranza excepcional · ${persona.nombre}`,
      [
        { id: 'trabaja', etiqueta: 'Trabaja el día (que normalmente libra)', tipo: 'fecha', obligatorio: true, ayuda: `Entre ${isoAes(lunes)} y ${isoAes(domingo)}` },
        { id: 'libra', etiqueta: 'Libra el día (que normalmente trabaja)', tipo: 'fecha', obligatorio: true },
        { id: 'motivo', etiqueta: 'Motivo', tipo: 'texto' },
      ],
      { nota: 'Cambia, solo esta semana, un día de libranza por uno de trabajo. La semana siguiente vuelve a la normalidad.' }
    );
    if (!datos) return;
    // `formulario` ya devuelve las fechas en ISO (aaaa-mm-dd).
    const diaTrabaja = datos.trabaja, diaLibra = datos.libra;
    if (!diaTrabaja || !diaLibra) { alert('Faltan las fechas'); return; }
    if (diaTrabaja < lunes || diaTrabaja > domingo || diaLibra < lunes || diaLibra > domingo) {
      alert('Los dos días tienen que ser de la semana que estás mirando'); return;
    }
    try {
      const r = await fetch('/planificador-v2/api/libranza-excepcional', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ conductorId: persona.id, diaTrabaja, diaLibra, motivo: datos.motivo, dia: DIA }),
      });
      const j = await r.json();
      if (!r.ok || j.status === 'error') throw new Error(j.msg || 'No se pudo guardar');
      if (j.tablero) aplicar(j.tablero);
    } catch (e) { alert(e.message); }
  }

  // ── Cuadrantes ────────────────────────────────────────────────────────────
  async function pedirTablero(url, body, metodo) {
    const r = await fetch(url, {
      method: metodo || 'POST', headers: { 'Content-Type': 'application/json' },
      body: body ? JSON.stringify(body) : undefined,
    });
    const j = await r.json();
    if (!r.ok || j.status === 'error') throw new Error(j.msg || 'No se pudo guardar');
    if (j.tablero) aplicar(j.tablero);
    return j;
  }

  async function nuevoCuadrante() {
    const zonas = (T.zonas || []).map(z => ({ valor: String(z.id), texto: z.nombre }));
    if (!zonas.length) { await Dialogo.aviso({ titulo: 'Sin zonas', texto: 'No hay zonas dadas de alta.', tono: 'aviso' }); return null; }
    // Con una base abierta, el cuadrante nuevo nace en ella.
    const datos = await Dialogo.formulario('Nuevo cuadrante',
      [{ id: 'zona', etiqueta: 'Base', tipo: 'lista', opciones: zonas, obligatorio: true,
         valor: (ZONA && ZONA !== SIN_BASE) ? ZONA : '' }],
      { nota: 'El número se asigna solo. Después le añades los bloques (días + matrícula).' });
    if (!datos || !datos.zona) return null;
    try {
      const r = await fetch('/planificador-v2/api/cuadrantes', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ zonaId: Number(datos.zona) }),
      });
      const j = await r.json();
      if (!r.ok || j.status === 'error') throw new Error(j.msg || 'No se pudo crear');
      // Se abre su base y se lleva la vista hasta él: un cuadrante vacío va al
      // fondo del iceberg, y sin esto había que bajar a buscarlo.
      const otraBase = String(datos.zona) !== ZONA;
      await cargar(DIA);   // refresca cuadrantes/zonas en el payload
      if (otraBase) elegirBase(String(datos.zona), { apilar: false });
      if (j.id) {
        const sec = document.querySelector(`[data-cuadrante="${CSS.escape(String(j.id))}"]`);
        if (sec) sec.scrollIntoView({ block: 'center', behavior: 'smooth' });
      }
      return j.id ? String(j.id) : null;
    } catch (e) { alert(e.message); return null; }
  }

  // Añadir un bloque: días (checkbox) + matrícula. La matrícula sale de los
  // coches sin cuadrante y del pool de emergencia (los que no tienen a nadie).
  async function anadirBloque(cuadranteId) {
    const dias = await editarDescanso({ titulo: 'Días del bloque', actual: [] });
    if (dias === undefined) return;
    if (!dias.length) { alert('Elige al menos un día'); return; }
    const candidatos = [
      ...(T.coches || []).filter(c => !c.cuadranteId).map(c => ({ vehiculoId: c.vehiculoId, matricula: c.matricula, zona: c.zona })),
      ...(T.emergencia || []).map(c => ({ vehiculoId: c.vehiculoId, matricula: c.matricula, zona: c.zona })),
    ];
    const vistos = new Set(); const unicos = candidatos.filter(c => !vistos.has(c.vehiculoId) && vistos.add(c.vehiculoId));
    const vehiculoId = await pickCoche({ titulo: `Matrícula del bloque ${dias.map(d => DIAS_LETRA[d - 1]).join('/')}`, coches: unicos });
    if (!vehiculoId) return;
    try {
      await pedirTablero('/planificador-v2/api/cuadrante/bloque', { cuadranteId, vehiculoId, dias, dia: DIA });
    } catch (e) { alert(e.message); }
  }

  async function meterEnCuadrante(coche) {
    const opciones = (T.cuadrantes || []).map(c => ({ valor: c.id, texto: `${c.nombre}${c.zona ? ' · ' + c.zona : ''} (${c.coches})` }));
    opciones.push({ valor: '__nuevo__', texto: '＋ Nuevo cuadrante…' });
    const elegido = await Dialogo.elegir({ titulo: `Meter ${coche.matricula} en un cuadrante`, opciones });
    if (!elegido) return;
    let id = elegido;
    if (elegido === '__nuevo__') { id = await nuevoCuadrante(); if (!id) return; }
    try {
      await pedirTablero('/planificador-v2/api/cuadrante/coche', { vehiculoId: coche.vehiculoId, cuadranteId: id, dia: DIA });
    } catch (e) { alert(e.message); }
  }

  async function sacarDeCuadrante(coche) {
    try {
      await pedirTablero('/planificador-v2/api/cuadrante/coche', { vehiculoId: coche.vehiculoId, cuadranteId: null, dia: DIA });
    } catch (e) { alert(e.message); }
  }

  async function borrarCuadranteUI(id, nombre) {
    const ok = await Dialogo.confirmar({
      titulo: `Borrar el cuadrante ${nombre}`, tono: 'aviso', si: 'Borrar', no: 'Cancelar',
      html: '<p>Los coches quedan sueltos. No se toca su gente ni su libranza.</p>',
    });
    if (!ok) return;
    try {
      await pedirTablero(`/planificador-v2/api/cuadrantes/${encodeURIComponent(id)}?dia=${encodeURIComponent(DIA)}`, null, 'DELETE');
    } catch (e) { alert(e.message); }
  }

  async function asignarCTCuadrante(cuadranteId, turno, lista, actual) {
    // `actual` = el CT que ya tiene el cuadrante (si es uno solo): así el selector
    // ofrece "Dejar la plaza vacía", que es el ÚNICO camino para quitar un CT de
    // todos los bloques de golpe — el servidor lo admite desde siempre
    // (conductorId vacío) pero la pantalla no daba forma de pedirlo.
    const id = await pickConductor({ titulo: `CT ${turno} del cuadrante`, turno, actual: actual || null });
    if (id === undefined) return;   // cancelado
    let vehiculos = [];
    if (id) {
      // Qué bloques (matrículas) cubre este CT. Por defecto, todos.
      vehiculos = await elegirBloques(lista || []);
      if (vehiculos === undefined) return;               // cancelado
      if (!vehiculos.length) { alert('Elige al menos un bloque para el CT'); return; }
    }
    try {
      const j = await pedirTablero('/planificador-v2/api/cuadrante/ct',
        { cuadranteId, turno, conductorId: id || '', vehiculos, dia: DIA });
      // Los bloques que ese día ya tenían conductor NO se tocan en bloque:
      // meterse ahí es apartar a alguien, y eso lleva motivo y nombre.
      if ((j.saltados || []).length) {
        await Dialogo.aviso({
          titulo: 'Hay bloques que ya tenían conductor', tono: 'aviso',
          texto: `No se ha tocado ${j.saltados.join(', ')}: esos días ya los cubre otro. ` +
            'Si aun así tiene que entrar, hazlo coche a coche desde su columna y di por qué se aparta al otro.',
        });
      }
    } catch (e) { await Dialogo.aviso({ titulo: 'No se ha podido', texto: e.message, tono: 'error' }); }
  }

  // Elegir qué bloques (coches del cuadrante) cubre un CT. Por defecto, todos.
  function elegirBloques(lista) {
    return new Promise(resolve => {
      const sel = new Set((lista || []).map(c => String(c.vehiculoId)));
      const fondo = document.createElement('div');
      fondo.className = 'fixed inset-0 z-[120] bg-black/60 backdrop-blur-sm flex items-start justify-center p-4';
      fondo.innerHTML = `
        <div class="bg-telecab-card border border-telecab-border rounded-2xl shadow-soft w-full max-w-sm my-16">
          <div class="flex items-center justify-between px-4 py-3 border-b border-telecab-border">
            <h3 class="font-semibold">¿Qué días/bloques cubre?</h3>
            <button data-x class="w-8 h-8 rounded-lg hover:bg-telecab-card2 text-telecab-muted"><i class="fa-solid fa-xmark"></i></button>
          </div>
          <div class="p-4">
            <p class="text-xs text-telecab-muted mb-3">Los bloques que cubre el correturnos. Los demás días serán su libranza.</p>
            <div class="space-y-1.5" data-lista></div>
            <div class="flex gap-2 mt-4">
              <button data-guardar class="flex-1 px-3 py-2 rounded-xl bg-telecab-gold text-telecab-dark font-semibold text-sm">Guardar</button>
              <button data-cancelar class="px-3 py-2 rounded-xl bg-telecab-card border border-telecab-border text-sm">Cancelar</button>
            </div>
          </div>
        </div>`;
      const cerrar = v => { document.body.removeChild(fondo); resolve(v); };
      const cont = fondo.querySelector('[data-lista]');
      const pinta = () => {
        cont.innerHTML = (lista || []).map(c => {
          const on = sel.has(String(c.vehiculoId));
          const dias = (c.descanso && c.descanso.length) ? diasTexto(c.descanso) : '—';
          return `<button data-v="${esc(c.vehiculoId)}" class="w-full flex items-center gap-2 px-3 py-2 rounded-lg border text-left transition ${on ? 'bg-telecab-gold/10 border-telecab-gold/40' : 'border-telecab-border hover:bg-telecab-card2'}">
            <i class="fa-${on ? 'solid fa-square-check text-telecab-gold' : 'regular fa-square text-telecab-muted'}"></i>
            <span class="text-sm font-medium">${esc(c.matricula)}</span><span class="text-xs text-telecab-muted ml-auto">${esc(dias)}</span></button>`;
        }).join('') || '<p class="text-xs text-telecab-muted text-center py-3">El cuadrante no tiene bloques.</p>';
        cont.querySelectorAll('[data-v]').forEach(b => b.addEventListener('click', () => {
          const v = b.dataset.v; if (sel.has(v)) sel.delete(v); else sel.add(v); pinta();
        }));
      };
      fondo.querySelector('[data-x]').addEventListener('click', () => cerrar(undefined));
      fondo.querySelector('[data-cancelar]').addEventListener('click', () => cerrar(undefined));
      fondo.addEventListener('mousedown', e => { if (e.target === fondo) cerrar(undefined); });
      fondo.querySelector('[data-guardar]').addEventListener('click', () => cerrar([...sel]));
      document.body.appendChild(fondo);
      pinta();
    });
  }

  // ── Descanso del coche (día + noche a la vez) ─────────────────────────────
  async function fijarDescansoCoche(coche) {
    const dias = await editarDescanso({ titulo: `Descanso de ${coche.matricula}`, actual: coche.descanso || [] });
    if (dias === undefined) return;   // cancelado
    try {
      const r = await fetch('/planificador-v2/api/descanso', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ vehiculoId: coche.vehiculoId, dias, dia: DIA }),
      });
      const j = await r.json();
      if (!r.ok || j.status === 'error') throw new Error(j.msg || 'No se pudo guardar el descanso');
      if (j.tablero) aplicar(j.tablero);
    } catch (e) { alert(e.message); }
  }

  function editarDescanso({ titulo, actual }) {
    return new Promise(resolve => {
      const sel = new Set(actual || []);
      const fondo = document.createElement('div');
      fondo.className = 'fixed inset-0 z-[120] bg-black/60 backdrop-blur-sm flex items-start justify-center p-4';
      fondo.innerHTML = `
        <div class="bg-telecab-card border border-telecab-border rounded-2xl shadow-soft w-full max-w-sm my-16">
          <div class="flex items-center justify-between px-4 py-3 border-b border-telecab-border">
            <h3 class="font-semibold">${esc(titulo)}</h3>
            <button data-x class="w-8 h-8 rounded-lg hover:bg-telecab-card2 text-telecab-muted"><i class="fa-solid fa-xmark"></i></button>
          </div>
          <div class="p-4">
            <p class="text-xs text-telecab-muted mb-3">Los días que libran los fijos (día y noche a la vez). El correturnos cubre justo esos días.</p>
            <div class="flex flex-wrap gap-1.5 justify-center" data-dias></div>
            <div class="flex gap-2 mt-4">
              <button data-guardar class="flex-1 px-3 py-2 rounded-xl bg-telecab-gold text-telecab-dark font-semibold text-sm">Guardar</button>
              <button data-cancelar class="px-3 py-2 rounded-xl bg-telecab-card border border-telecab-border text-sm">Cancelar</button>
            </div>
          </div>
        </div>`;
      const cerrar = v => { document.body.removeChild(fondo); resolve(v); };
      const cont = fondo.querySelector('[data-dias]');
      const pinta = () => {
        cont.innerHTML = DIAS_LETRA.map((l, i) => {
          const d = i + 1, on = sel.has(d);
          return `<button data-d="${d}" class="w-10 h-10 rounded-xl border text-sm font-semibold transition ${on ? 'bg-telecab-gold text-telecab-dark border-telecab-gold' : 'bg-telecab-card2 border-telecab-border text-telecab-muted hover:border-telecab-gold/40'}">${l}</button>`;
        }).join('');
        cont.querySelectorAll('[data-d]').forEach(b => b.addEventListener('click', () => {
          const d = Number(b.dataset.d); if (sel.has(d)) sel.delete(d); else sel.add(d); pinta();
        }));
      };
      fondo.querySelector('[data-x]').addEventListener('click', () => cerrar(undefined));
      fondo.querySelector('[data-cancelar]').addEventListener('click', () => cerrar(undefined));
      fondo.addEventListener('mousedown', e => { if (e.target === fondo) cerrar(undefined); });
      fondo.querySelector('[data-guardar]').addEventListener('click', () => cerrar([...sel].sort((a, b) => a - b)));
      document.body.appendChild(fondo);
      pinta();
    });
  }

  // ── Selector de conductor (modal con búsqueda) ────────────────────────────
  function pickConductor({ titulo, turno, actual }) {
    return new Promise(resolve => {
      const fondo = document.createElement('div');
      fondo.className = 'fixed inset-0 z-[120] bg-black/60 backdrop-blur-sm flex items-start justify-center p-4 overflow-y-auto';
      // Elegibles: el banquillo primero, luego el resto de la plantilla del turno.
      const mismoTurno = c => !turno || !c.turnoCodigo || c.turnoCodigo === turno;
      const lista = [...(T.conductores || [])].filter(c => c.id).sort((a, b) =>
        (b.plazas === 0) - (a.plazas === 0) || a.nombre.localeCompare(b.nombre));
      fondo.innerHTML = `
        <div class="bg-telecab-card border border-telecab-border rounded-2xl shadow-soft w-full max-w-md my-8">
          <div class="flex items-center justify-between px-4 py-3 border-b border-telecab-border">
            <h3 class="font-semibold">${esc(titulo)}</h3>
            <button data-x class="w-8 h-8 rounded-lg hover:bg-telecab-card2 text-telecab-muted"><i class="fa-solid fa-xmark"></i></button>
          </div>
          <div class="p-3">
            <input data-busca type="search" placeholder="Buscar nombre, DNI, teléfono…" class="w-full mb-2 px-3 py-2 bg-telecab-card2 border border-telecab-border rounded-lg text-sm">
            ${actual ? '<button data-quitar class="w-full mb-2 px-3 py-2 rounded-lg border border-telecab-red/40 text-telecab-red text-sm hover:bg-telecab-red/10"><i class="fa-solid fa-user-minus"></i> Dejar la plaza vacía</button>' : ''}
            <div data-lista class="space-y-1 max-h-[50vh] overflow-y-auto"></div>
          </div>
        </div>`;
      const cerrar = v => { document.body.removeChild(fondo); resolve(v); };
      fondo.addEventListener('mousedown', e => { if (e.target === fondo) cerrar(undefined); });
      fondo.querySelector('[data-x]').addEventListener('click', () => cerrar(undefined));
      const q = fondo.querySelector('[data-quitar]');
      if (q) q.addEventListener('click', () => cerrar(''));

      const cont = fondo.querySelector('[data-lista]');
      const pinta = () => {
        const txt = (fondo.querySelector('[data-busca]').value || '').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
        const vis = lista.filter(c => {
          const t = (c.nombre + ' ' + (c.dni || '') + ' ' + (c.telefono || '') + ' ' + (c.barrio || '')).toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
          return t.includes(txt);
        });
        cont.innerHTML = vis.slice(0, 80).map(c => `
          <button data-id="${esc(c.id)}" class="w-full text-left px-3 py-2 rounded-lg border transition
                  ${String(c.id) === String(actual) ? 'border-telecab-gold bg-telecab-gold/10' : 'border-telecab-border hover:bg-telecab-card2'}
                  ${!mismoTurno(c) ? 'opacity-60' : ''}">
            <div class="text-sm font-medium">${esc(c.nombre)}${c.esEtt ? ' <span class="text-telecab-violet text-xs">ETT</span>' : ''}</div>
            <div class="text-[11px] text-telecab-muted">${c.telefono ? `<span class="font-mono tabular-nums">${esc(c.telefono)}</span> · ` : ''}${esc(c.turno || 'sin turno')}${c.plazas ? ' · ya colocado' : ' · banquillo'}${!mismoTurno(c) ? ' · otro turno' : ''}${c.barrio ? ' · ' + esc(c.barrio) : ''}</div>
          </button>`).join('') || '<p class="text-xs text-telecab-muted text-center py-4">Nadie coincide.</p>';
        cont.querySelectorAll('[data-id]').forEach(b => b.addEventListener('click', () => cerrar(b.dataset.id)));
      };
      fondo.querySelector('[data-busca]').addEventListener('input', pinta);
      document.body.appendChild(fondo);
      pinta();
      fondo.querySelector('[data-busca]').focus();
    });
  }

