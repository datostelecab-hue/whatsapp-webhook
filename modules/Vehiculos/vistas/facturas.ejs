<div id="modulo"></div>

<!-- Alta de factura. Vive fuera del componente porque es propio de esta
     pantalla: el componente pone la lista y la ficha, no sabe de facturas.
     Y la tabla de líneas crece: una factura de iPark trae media docena. -->
<!-- Las matriculas de la flota que esta persona puede tocar. Se rellena al
     abrir el formulario, no al cargar la pagina: quien solo mira facturas no
     necesita bajarse los 95 coches. -->


<div id="fm" class="hidden fixed inset-0 z-50 flex items-start justify-center p-4 overflow-y-auto bg-black/60 backdrop-blur-sm">
  <div class="bg-telecab-card border border-telecab-border rounded-2xl shadow-soft w-full max-w-4xl my-8">
    <div class="flex items-center justify-between px-5 py-4 border-b border-telecab-border">
      <h3 class="font-bold text-lg">Nueva factura de taller</h3>
      <button type="button" id="fm-cerrar" class="w-8 h-8 rounded-lg hover:bg-telecab-card2 text-telecab-muted transition">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <form id="fm-form" class="p-5 space-y-5">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <label class="block">
          <span class="text-xs text-telecab-muted uppercase tracking-wide">Taller</span>
          <input name="proveedorId" data-picker readonly required placeholder="Elige el taller"
                 class="w-full mt-1 px-3 py-2 bg-telecab-card2 border border-telecab-border rounded-xl text-sm cursor-pointer focus:outline-none focus:ring-2 focus:ring-telecab-gold/40">
        </label>
        <label class="block">
          <span class="text-xs text-telecab-muted uppercase tracking-wide">Nº de factura</span>
          <input name="numero" required placeholder="26/04137" class="w-full mt-1 px-3 py-2 bg-telecab-card2 border border-telecab-border rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-telecab-gold/40">
        </label>
        <label class="block">
          <span class="text-xs text-telecab-muted uppercase tracking-wide">Fecha</span>
          <!-- `js-fecha`: el calendario de la casa (layout-gestion). Trabaja en
               dd/mm/aaaa y se convierte a ISO al guardar. -->
          <input name="fecha" required class="js-fecha w-full mt-1 px-3 py-2 bg-telecab-card2 border border-telecab-border rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-telecab-gold/40" placeholder="dd/mm/aaaa" autocomplete="off">
        </label>
        <label class="block">
          <span class="text-xs text-telecab-muted uppercase tracking-wide">Total con IVA (€)</span>
          <input name="total" required inputmode="decimal" placeholder="1456,13" class="w-full mt-1 px-3 py-2 bg-telecab-card2 border border-telecab-border rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-telecab-gold/40 tabular-nums">
        </label>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <label class="block">
          <span class="text-xs text-telecab-muted uppercase tracking-wide">Base imponible (€)</span>
          <input name="base" inputmode="decimal" placeholder="1203,41" class="w-full mt-1 px-3 py-2 bg-telecab-card2 border border-telecab-border rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-telecab-gold/40 tabular-nums">
          <!-- Es contra la BASE contra lo que cuadran las líneas: los talleres
               facturan los artículos sin IVA. -->
          <span class="text-[11px] text-telecab-muted">Se rellena sola al poner el total. Es contra esta contra la que cuadran las líneas.</span>
        </label>
        <label class="block">
          <span class="text-xs text-telecab-muted uppercase tracking-wide">IVA (€)</span>
          <input name="iva" inputmode="decimal" placeholder="252,72" class="w-full mt-1 px-3 py-2 bg-telecab-card2 border border-telecab-border rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-telecab-gold/40 tabular-nums">
        </label>
      </div>

      <div>
        <div class="flex items-center justify-between mb-2">
          <div>
            <span class="font-semibold">Qué se hizo y a qué coche</span>
            <!-- Se dice aquí y no en un manual: es la duda que tiene quien está
                 tecleando una factura con un albarán sin matrícula delante. -->
            <p class="text-xs text-telecab-muted mt-0.5">
              Una línea por coche. Si la factura no dice de qué coche es, deja la matrícula
              vacía y quedará como <strong>NN</strong> — el gasto cuenta igual.
            </p>
          </div>
          <button type="button" id="fm-mas" class="text-sm px-3 py-1.5 rounded-lg bg-telecab-card2 hover:bg-telecab-border transition">
            <i class="fa-solid fa-plus mr-1"></i> Añadir línea
          </button>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="text-xs text-telecab-muted">
              <tr>
                <th class="text-left font-medium pb-1">Matrícula</th>
                <th class="text-left font-medium pb-1">Albarán</th>
                <th class="text-left font-medium pb-1">Fecha</th>
                <th class="text-left font-medium pb-1">Km</th>
                <th class="text-left font-medium pb-1">Concepto</th>
                <th class="text-left font-medium pb-1">Importe (€)</th>
                <th class="pb-1"></th>
              </tr>
            </thead>
            <tbody id="fm-lineas"></tbody>
          </table>
        </div>
        <p id="fm-suma" class="text-xs text-telecab-muted mt-2 tabular-nums"></p>
      </div>

      <label class="block">
        <span class="text-xs text-telecab-muted">Notas</span>
        <input name="notas" class="w-full mt-1 bg-telecab-dark border border-telecab-border rounded-lg px-3 py-2">
      </label>

      <div class="flex justify-end gap-2 pt-2 border-t border-telecab-border">
        <button type="button" id="fm-cancelar" class="px-4 py-2 rounded-lg bg-telecab-card2 hover:bg-telecab-border transition">Cancelar</button>
        <button type="submit" class="px-4 py-2 rounded-lg bg-telecab-gold text-black font-semibold hover:opacity-90 transition">Guardar factura</button>
      </div>
    </form>
  </div>
</div>

<script>
(() => {
  const { fecha, etiqueta, esc, euros } = Listado.fmt;
  const PUEDE = <%- JSON.stringify(!!puedeApuntar) %>;
  const TODAS_SEDES = <%- JSON.stringify(!!verTodasLasSedes) %>;
  const EXIGE_DESDE = <%- JSON.stringify(exigeMatriculaDesde) %>;
  const $ = s => document.querySelector(s);

  const eur = v => (v == null ? '—' : euros(v));
  // La flota, en memoria mientras dura el formulario: se usa para la lista de
  // matriculas y para ofrecer el kilometraje de cada coche.
  let FLOTA = new Map();
  let PROVEEDORES = [];
  const pedir = async (url, opciones) => {
    const r = await fetch(url, opciones);
    const d = await r.json();
    if (d.status !== 'ok') throw new Error(d.msg || 'No se pudo');
    return d;
  };

  // ---------- la lista ----------

  const lista = Listado.montar({
    raiz: '#modulo',
    titulo: 'Facturas de taller',
    icono: 'fa-file-invoice',
    clave: 'id',
    origen: '/facturas/api/lista',
    vacio: 'No hay facturas todavía.',
    buscar: { texto: 'Buscar por nº, taller o matrícula…', campos: ['numero', 'proveedor'] },

    subtitulo: (v, t) => (v.length === t.length ? `${t.length} facturas` : `${v.length} de ${t.length} facturas`),

    kpis: filas => {
      const total = filas.reduce((a, f) => a + f.total, 0);
      const nn = filas.reduce((a, f) => a + f.nn, 0);
      const reclamables = filas.filter(f => f.nnReclamable).length;
      return [
        { etiqueta: 'Facturado', valor: eur(total), tono: 'gold', pie: `${filas.length} facturas` },
        { etiqueta: 'Coches distintos', valor: new Set(filas.flatMap(f => f.coches ? [f.id] : [])).size
            ? filas.reduce((a, f) => a + f.coches, 0) : 0, tono: 'green' },
        // El NN no es una curiosidad: es dinero que no se puede imputar a nadie.
        { etiqueta: 'Sin matrícula (NN)', valor: eur(nn), tono: nn ? 'warn' : 'muted',
          pie: `${filas.reduce((a, f) => a + f.nnLineas, 0)} líneas` },
        { etiqueta: 'Por reclamar', valor: reclamables, tono: reclamables ? 'red' : 'muted',
          pie: `facturas desde ${fecha(EXIGE_DESDE)} sin matrícula` },
      ];
    },

    filtros: [{
      id: 'taller', campo: 'proveedor', textoTodos: 'Todos los talleres',
      opciones: filas => [...new Set(filas.map(f => f.proveedor))].sort()
        .map(p => ({ valor: p, texto: p, cuenta: filas.filter(f => f.proveedor === p).length })),
    }],

    acciones: [
      ...(PUEDE ? [{ texto: 'Nueva factura', icono: 'fa-plus', onClick: () => abrir() }] : []),
      { texto: 'Gasto por coche', icono: 'fa-chart-column', principal: false, onClick: verGasto },
    ],

    columnas: [
      { titulo: 'Fecha', campo: 'fecha', clase: 'whitespace-nowrap', pinta: v => fecha(v) },
      { titulo: 'Taller', campo: 'proveedor', clase: 'font-medium' },
      { titulo: 'Nº', campo: 'numero', clase: 'tabular-nums whitespace-nowrap' },
      { titulo: 'Coches', campo: 'coches', clase: 'tabular-nums',
        pinta: (v, f) => ((v ? v : '') +
          (f.nnLineas ? ` ${etiqueta('NN ×' + f.nnLineas, f.nnReclamable ? 'red' : 'warn')}` : '') +
          (f.desconocidas ? ` ${etiqueta('? ×' + f.desconocidas, 'warn')}` : ''))
          || '<span class="text-telecab-muted">—</span>' },
      { titulo: 'Total', campo: 'total', clase: 'tabular-nums whitespace-nowrap font-semibold',
        pinta: v => eur(v) },
      ...(TODAS_SEDES ? [{ titulo: 'Sede', campo: 'sede',
        pinta: v => etiqueta(v === 'barcelona' ? 'Barcelona' : 'Madrid', v === 'barcelona' ? 'violet' : 'muted') }] : []),
      { titulo: 'PDF', campo: 'archivo',
        pinta: (v, f) => (f.enlace
          ? `<a href="${esc(f.enlace)}" target="_blank" rel="noopener" class="text-telecab-gold hover:underline"><i class="fa-solid fa-file-pdf"></i></a>`
          : '<span class="text-telecab-muted">—</span>') },
    ],

    detalle: {
      origen: id => `/facturas/api/ficha/${id}`,
      titulo: d => `${d.proveedor} · ${d.numero}`,
      subtitulo: d => [fecha(d.fecha), eur(d.total), d.anulada ? 'ANULADA' : ''].filter(Boolean).join(' · '),

      acciones: [
        ...(PUEDE ? [{ texto: 'Subir PDF', icono: 'fa-file-arrow-up', principal: true,
          visible: d => !d.anulada, onClick: subirPdf }] : []),
        ...(PUEDE ? [{ texto: 'Anular', icono: 'fa-ban', peligro: true,
          visible: d => !d.anulada, onClick: anular }] : []),
      ],

      bloques: [
        {
          titulo: 'La factura', icono: 'fa-file-invoice',
          campos: [
            { etiqueta: 'Taller', valor: d => d.proveedor },
            { etiqueta: 'Número', valor: d => d.numero },
            { etiqueta: 'Fecha', valor: d => fecha(d.fecha) },
            { etiqueta: 'Base', valor: d => eur(d.base) },
            { etiqueta: 'IVA', valor: d => eur(d.iva) },
            { etiqueta: 'Total', valor: d => eur(d.total), clase: 'font-semibold' },
            { etiqueta: 'Sede', valor: d => (d.sede === 'barcelona' ? 'Barcelona' : 'Madrid') },
            { etiqueta: 'Anulada', valor: d => (d.anulada ? d.anuladoMotivo : '') },
            { etiqueta: 'Notas', valor: d => d.notas, ancho: 'sm:col-span-2 lg:col-span-3' },
          ],
        },
        {
          titulo: 'Qué se hizo y a qué coche', icono: 'fa-screwdriver-wrench',
          tabla: {
            datos: d => d.lineasDetalle,
            vacio: 'Esta factura no tiene líneas.',
            columnas: [
              { titulo: 'Coche', campo: 'matricula',
                // Tres estados distintos y cada uno quiere decir algo:
                //  · reconocido      → la matrícula casó con una ficha
                //  · matrícula suelta → venía en el papel pero no la conocemos
                //  · NN               → el papel no dice de qué coche es
                pinta: (v, l) => (l.reconocido
                  ? `<span class="font-semibold">${esc(v)}</span>`
                  : v
                    ? `${esc(v)} ${etiqueta('no está en la flota', 'warn')}`
                    : etiqueta('NN', 'warn')) },
              { titulo: 'Albarán', campo: 'albaran', clase: 'tabular-nums' },
              { titulo: 'Fecha', campo: 'fecha', pinta: v => fecha(v) },
              { titulo: 'Km', campo: 'km', clase: 'tabular-nums',
                pinta: v => (v == null ? '—' : v.toLocaleString('es-ES')) },
              { titulo: 'Concepto', campo: 'concepto' },
              { titulo: 'Importe', campo: 'importe', clase: 'tabular-nums whitespace-nowrap',
                pinta: v => eur(v) },
            ],
            // La operacion del dia a dia: llega la factura sin matricula, se le
            // reclama al taller y cuando contesta hay que poder apuntarlo sin
            // volver a teclear la factura entera.
            acciones: PUEDE ? [
              { icono: 'fa-car', titulo: 'Decir de que coche es (o corregirlo)',
                onClick: (linea, d) => asignarCoche(d.id, linea) },
            ] : [],
          },
        },
      ],
    },
  });

  // ---------- gasto por coche ----------

  async function verGasto() {
    let d;
    try { d = await pedir('/facturas/api/gasto'); }
    catch (e) { return Dialogo.aviso({ titulo: 'No se pudo', texto: e.message, tono: 'error' }); }
    const filas = (d.coches || []).map(c => `
      <tr class="border-t border-telecab-border">
        <td class="py-1.5 font-semibold">${esc(c.matricula)}</td>
        <td class="py-1.5 text-telecab-muted">${esc(c.modelo || '')}</td>
        <td class="py-1.5 tabular-nums">${c.facturas}</td>
        <td class="py-1.5 tabular-nums">${c.ultimoKm == null ? '—' : c.ultimoKm.toLocaleString('es-ES')}</td>
        <td class="py-1.5 tabular-nums font-semibold">${esc(eur(c.gasto))}</td>
      </tr>`).join('');
    const nn = d.sinCoche || {};
    Dialogo.abrir({ titulo: 'Gasto por coche', ancho: 'max-w-3xl',
      opciones: [{ texto: 'Cerrar' }], html: `
      <div class="overflow-x-auto max-h-[60vh]">
        <table class="w-full text-sm">
          <thead class="text-xs text-telecab-muted"><tr>
            <th class="text-left font-medium pb-1">Matrícula</th>
            <th class="text-left font-medium pb-1">Modelo</th>
            <th class="text-left font-medium pb-1">Facturas</th>
            <th class="text-left font-medium pb-1">Último km</th>
            <th class="text-left font-medium pb-1">Gasto</th>
          </tr></thead>
          <tbody>${filas || '<tr><td colspan="5" class="py-3 text-telecab-muted">Todavía no hay gasto imputado a ningún coche.</td></tr>'}</tbody>
        </table>
      </div>
      ${nn.lineas ? `<p class="mt-3 text-sm text-telecab-warn">
        <i class="fa-solid fa-triangle-exclamation mr-1"></i>
        ${esc(eur(nn.importe))} en ${nn.lineas} línea(s) <strong>sin matrícula</strong>, que no se pueden imputar a ningún coche.
        ${nn.reclamables ? `De esas, <strong>${nn.reclamables}</strong> son posteriores al ${esc(fecha(EXIGE_DESDE))}: hay que reclamárselas al taller.` : ''}
      </p>` : ''}` });
  }

  // ---------- alta ----------

  // La matrícula va contra la LISTA DE LA FLOTA (datalist): se escriben dos
  // dígitos y sale el coche. Pero es una lista, no una jaula — se puede escribir
  // una que no esté, porque el taller a veces factura coches que no llevamos, y
  // eso hay que poder apuntarlo tal cual.
  const MINI = 'bg-telecab-card2 border border-telecab-border rounded-lg px-2 py-1 text-sm focus:outline-none focus:ring-2 focus:ring-telecab-gold/40';
  const filaHTML = () => `
    <tr class="border-t border-telecab-border">
      <td class="py-1 pr-2"><input name="matricula" placeholder="vacío = NN"
          class="w-32 uppercase ${MINI}" autocomplete="off"></td>
      <td class="py-1 pr-2"><input name="albaran" class="w-24 ${MINI}"></td>
      <td class="py-1 pr-2"><input name="fecha" class="js-fecha w-28 ${MINI}" placeholder="dd/mm/aaaa" autocomplete="off"></td>
      <td class="py-1 pr-2"><input name="km" inputmode="numeric" class="w-24 tabular-nums ${MINI}"></td>
      <td class="py-1 pr-2"><input name="concepto" class="w-full ${MINI}"></td>
      <td class="py-1 pr-2"><input name="importe" inputmode="decimal" class="w-24 tabular-nums ${MINI}"></td>
      <td class="py-1"><button type="button" class="quitar w-7 h-7 rounded text-telecab-muted hover:text-telecab-red transition" title="Quitar la línea"><i class="fa-solid fa-trash"></i></button></td>
    </tr>`;

  // ── UN SELECTOR EN LÍNEA CON LA CARA DE LA CASA ────────────────────────────
  // El <datalist> y el <select> del navegador se pintan con los colores del
  // sistema operativo —fondo blanco, azul de Windows— y en una pantalla oscura
  // parecen de otra aplicación. `Dialogo.formulario` ya tiene el de la casa,
  // pero es para ventanas: esto son celdas de una tabla.
  //
  // Se ven DIEZ como mucho y se filtra escribiendo: la flota son cien coches y
  // ninguna lista de cien se lee, se busca.
  //
  // Sigue siendo una lista y no una jaula: en la matrícula se puede teclear una
  // que no esté, porque el taller a veces factura coches que no llevamos y eso
  // hay que poder apuntarlo tal cual.
  const TOPE_PICKER = 10;
  const plano = t => String(t == null ? '' : t)
    .normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();

  function engancharPicker(input, opciones, { libre = false, alElegir } = {}) {
    const caja = document.createElement('div');
    caja.className = 'absolute z-50 mt-1 w-max min-w-full max-h-64 overflow-y-auto rounded-xl ' +
      'border border-telecab-border bg-telecab-card shadow-soft hidden';
    const envoltorio = document.createElement('div');
    envoltorio.className = 'relative';
    input.parentNode.insertBefore(envoltorio, input);
    envoltorio.appendChild(input);
    envoltorio.appendChild(caja);

    let abierto = false;
    const cerrar = () => { abierto = false; caja.classList.add('hidden'); };

    const pintar = () => {
      const q = libre ? plano(input.value) : '';
      const todas = opciones();
      const casan = q ? todas.filter(o => plano(o.texto).includes(q) || plano(o.detalle).includes(q)) : todas;
      const ops = casan.slice(0, TOPE_PICKER);
      const fuera = casan.length - ops.length;
      caja.innerHTML = (ops.length
        ? ops.map(o => `<button type="button" data-v="${esc(o.valor)}"
              class="w-full text-left px-3 py-2 text-sm text-telecab-text hover:bg-telecab-gold/15 transition">
              <span class="font-semibold">${esc(o.texto)}</span>
              ${o.detalle ? `<span class="block text-[11px] text-telecab-muted">${esc(o.detalle)}</span>` : ''}
            </button>`).join('')
        : `<p class="px-3 py-2 text-xs text-telecab-muted">Nada que coincida${q ? ' con «' + esc(input.value.trim()) + '»' : ''}.</p>`)
        + (fuera > 0
          ? `<p class="px-3 py-1.5 text-[11px] text-telecab-gold border-t border-telecab-border">
               Se ven ${ops.length} de ${casan.length}. Sigue escribiendo para afinar.</p>`
          : '');
      caja.querySelectorAll('[data-v]').forEach(b => b.addEventListener('mousedown', ev => {
        // `mousedown` y no `click`: el blur del input cierra la caja antes de
        // que llegue el click, y el botón se quedaba sin pulsar.
        ev.preventDefault();
        const o = opciones().find(x => String(x.valor) === b.dataset.v);
        input.value = libre ? (o ? o.texto : b.dataset.v) : (o ? o.texto : '');
        input.dataset.valor = b.dataset.v;
        cerrar();
        if (alElegir) alElegir(o);
        input.dispatchEvent(new Event('change', { bubbles: true }));
      }));
      abierto = true;
      caja.classList.remove('hidden');
    };

    input.addEventListener('focus', pintar);
    if (libre) input.addEventListener('input', () => { delete input.dataset.valor; pintar(); });
    else input.addEventListener('click', pintar);
    input.addEventListener('blur', () => setTimeout(cerrar, 120));
    input.addEventListener('keydown', ev => {
      if (ev.key === 'Escape' && abierto) { ev.preventDefault(); cerrar(); }
    });
  }

  const num = v => { const n = Number(String(v || '').replace(',', '.')); return Number.isFinite(n) ? n : 0; };

  function recalcular() {
    const suma = [...$('#fm-lineas').querySelectorAll('tr')]
      .reduce((a, tr) => a + num(tr.querySelector('[name=importe]').value), 0);
    // Si el total lleva IVA y las lineas son la base, restarlos canta el IVA
    // como si faltara dinero. Se compara contra la base cuando la hay.
    const total = num($('#fm-form').total.value);
    const base = num($('#fm-form').base.value);
    const contra = base || total;
    const dif = +(contra - suma).toFixed(2);
    // El descuadre se AVISA, no se impide: una factura trae portes, descuentos y
    // redondeos que no son de ningún coche. Obligar a cuadrarlo al céntimo
    // acabaría con alguien inventándose una línea para poder guardar.
    $('#fm-suma').innerHTML = `Las líneas suman <strong>${esc(eur(suma))}</strong>` +
      (contra ? ` · ${base ? 'base' : 'total'} de la factura <strong>${esc(eur(contra))}</strong>` +
        (Math.abs(dif) >= 0.01
          ? ` · <span class="text-telecab-warn">quedan ${esc(eur(dif))} sin repartir</span>`
          : ' · <span class="text-telecab-green">cuadra</span>') : '');
  }

  function anadirFila() {
    $('#fm-lineas').insertAdjacentHTML('beforeend', filaHTML());
    const tr = $('#fm-lineas').lastElementChild;
    tr.querySelector('.quitar').addEventListener('click', () => { tr.remove(); recalcular(); });
    tr.querySelector('[name=importe]').addEventListener('input', recalcular);

    // La fecha de la linea, la de la factura mientras no se diga otra cosa: casi
    // siempre coinciden, y cuando no, se cambia.
    const fFactura = $('#fm-form').fecha.value;
    if (fFactura) tr.querySelector('[name=fecha]').value = fFactura;

    // Al elegir coche se ofrece SU kilometraje. Se ofrece, no se impone: el del
    // papel es el del dia del taller y el nuestro es el de hoy, asi que solo se
    // rellena si el campo esta vacio, y avisa de cual es cual.
    const mat = tr.querySelector('[name=matricula]');
    const km = tr.querySelector('[name=km]');
    // La lista de la flota, con el modelo debajo para no confundir dos parecidas.
    engancharPicker(mat, () => [...FLOTA.values()].map(v => ({
      valor: v.matricula, texto: v.matricula,
      detalle: `${v.modelo}${v.deBaja ? ' · de baja' : ''}${v.sede === 'barcelona' ? ' · Barcelona' : ''}`,
    })), { libre: true });

    mat.addEventListener('change', () => {
      const v = FLOTA.get(mat.value.trim().toUpperCase());
      mat.value = mat.value.trim().toUpperCase();
      if (v && v.km && !km.value.trim()) {
        km.value = v.km;
        km.title = 'Los que tenemos nosotros de ' + v.matricula + '. Si el papel dice otros, manda el papel.';
        km.classList.add('text-telecab-muted');
      }
      mat.title = v ? `${v.modelo}${v.deBaja ? ' (de baja)' : ''}` : 'No esta en la flota: se guardara tal cual';
    });
    km.addEventListener('input', () => km.classList.remove('text-telecab-muted'));
  }

  async function abrir() {
    const f = $('#fm-form');
    f.reset();
    // `reset()` vacía el texto pero no el id que lleva pegado: sin esto, abrir
    // el formulario otra vez guardaría la factura con el taller de la anterior.
    delete f.proveedorId.dataset.valor;
    $('#fm-lineas').innerHTML = '';
    anadirFila();
    recalcular();
    try {
      const [{ proveedores }, { flota }] = await Promise.all([
        pedir('/facturas/api/proveedores'),
        pedir('/facturas/api/flota'),
      ]);
      // El taller: el mismo selector, sin filtro —son tres— y de solo lectura,
      // que aquí no vale escribir uno que no esté: el proveedor tiene que existir
      // en la base con su CIF para que la factura sirva de algo.
      PROVEEDORES = proveedores;
      if (!f.proveedorId.dataset.enganchado) {
        f.proveedorId.dataset.enganchado = '1';
        engancharPicker(f.proveedorId, () => PROVEEDORES.map(p => ({
          valor: p.id, texto: p.nombre, detalle: [p.nif, p.poblacion].filter(Boolean).join(' · '),
        })));
      }

      // La lista de matriculas, con el modelo al lado para no equivocarse entre
      // dos parecidas. Las de baja se marcan: una factura vieja puede ser de un
      // coche que ya se vendio, y hay que poder apuntarla igual.
      FLOTA = new Map(flota.map(v => [v.matricula, v]));
      $('#flota-lista').innerHTML = flota.map(v =>
        `<option value="${esc(v.matricula)}">${esc(v.modelo)}${v.deBaja ? ' · de baja' : ''}${
          v.sede === 'barcelona' ? ' · Barcelona' : ''}</option>`).join('');
    } catch (e) { return Dialogo.aviso({ titulo: 'No se pudo', texto: e.message, tono: 'error' }); }
    $('#fm').classList.remove('hidden');
  }
  const cerrar = () => $('#fm').classList.add('hidden');

  if (PUEDE) {
    $('#fm-cerrar').addEventListener('click', cerrar);
    $('#fm-cancelar').addEventListener('click', cerrar);
    $('#fm-mas').addEventListener('click', anadirFila);
    $('#fm-form').total.addEventListener('input', recalcular);
    $('#fm-form').base.addEventListener('input', recalcular);

    // Cortesia con quien teclea: si pone el total y no la base, se le ofrece la
    // del 21%. Se RELLENA el campo, no se calcula por detras: asi lo ve y lo
    // corrige si esa factura lleva otro IVA.
    $('#fm-form').total.addEventListener('blur', () => {
      const f = $('#fm-form');
      const t = num(f.total.value);
      if (t && !num(f.base.value)) {
        f.base.value = (t / 1.21).toFixed(2).replace('.', ',');
        f.iva.value = (t - t / 1.21).toFixed(2).replace('.', ',');
        recalcular();
      }
    });

    $('#fm-form').addEventListener('submit', async ev => {
      ev.preventDefault();
      const f = ev.target;
      // El calendario de la casa trabaja en dd/mm/aaaa; la base quiere ISO.
      const aISO = Dialogo.aISO;
      const lineas = [...$('#fm-lineas').querySelectorAll('tr')].map(tr => ({
        matricula: tr.querySelector('[name=matricula]').value,
        albaran: tr.querySelector('[name=albaran]').value,
        fecha: aISO(tr.querySelector('[name=fecha]').value) || null,
        km: tr.querySelector('[name=km]').value,
        concepto: tr.querySelector('[name=concepto]').value,
        importe: tr.querySelector('[name=importe]').value,
      }));
      const cuerpo = {
        proveedorId: f.proveedorId.dataset.valor || '', numero: f.numero.value, fecha: aISO(f.fecha.value),
        base: f.base.value, iva: f.iva.value,
        total: f.total.value, notas: f.notas.value, lineas,
      };
      try {
        const r = await pedir('/facturas/api/factura', {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(cuerpo),
        });
        cerrar();
        lista.recargar();
        const avisos = [];
        if (r.sinCoche) avisos.push(`${r.sinCoche} línea(s) quedaron como <strong>NN</strong>: la factura no dice de qué coche son.`);
        if (r.desconocidas) avisos.push(`${r.desconocidas} matrícula(s) <strong>no están en la flota</strong>. Compruébalas: o vienen mal del taller, o son coches que no llevamos.`);
        if (Math.abs(r.descuadre) >= 0.01) avisos.push(`Quedan ${eur(r.descuadre)} del total sin repartir entre las líneas.`);
        if (avisos.length) Dialogo.abrir({ titulo: 'Factura guardada', html: avisos.join('<br>'), tono: 'ok', opciones: [{ texto: 'Entendido' }] });
      } catch (e) { Dialogo.aviso({ titulo: 'No se pudo guardar', texto: e.message, tono: 'error' }); }
    });
  }

  /**
   * El PDF de la factura, a Drive.
   *
   * El fichero se lee en el navegador y viaja en base64 dentro del JSON, como
   * el resto de adjuntos del sistema. Se avisa del tamaño antes de mandarlo:
   * un escaneo de 20 MB tarda, y sin aviso parece que se ha colgado.
   */
  async function subirPdf(d) {
    const input = document.createElement('input');
    input.type = 'file';
    input.accept = 'application/pdf,image/*';
    input.addEventListener('change', async () => {
      const file = input.files && input.files[0];
      if (!file) return;
      if (file.size > 25 * 1024 * 1024) {
        return Dialogo.aviso({ titulo: 'Demasiado grande',
          texto: `Ese archivo ocupa ${(file.size / 1048576).toFixed(1)} MB y el límite son 25.`, tono: 'error' });
      }
      const base64 = await new Promise((res, rej) => {
        const fr = new FileReader();
        fr.onload = () => res(String(fr.result).split(',')[1]);
        fr.onerror = () => rej(new Error('No se pudo leer el archivo'));
        fr.readAsDataURL(file);
      });
      try {
        const r = await pedir('/facturas/api/pdf', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: d.id, nombre: file.name, mime: file.type, base64 }),
        });
        lista.recargar();
        Dialogo.abrir({ titulo: 'PDF guardado', tono: 'ok',
          html: `Está en Drive como <strong>${esc(r.archivo)}</strong>.` +
            (r.enlace ? ` <a href="${esc(r.enlace)}" target="_blank" rel="noopener" class="text-telecab-gold hover:underline">Abrirlo</a>` : ''),
          opciones: [{ texto: 'Entendido' }] });
      } catch (e) { Dialogo.aviso({ titulo: 'No se pudo subir', texto: e.message, tono: 'error' }); }
    });
    input.click();
  }

  /**
   * Ponerle coche a una línea.
   *
   * Es lo del día a día: llega una factura sin matrícula, se le reclama al taller,
   * el taller dice de qué coche era y hay que apuntarlo sin volver a teclear la
   * factura entera. También sirve para corregir una mal escrita.
   */
  async function asignarCoche(facturaId, linea) {
    const v = await Dialogo.formulario('¿De qué coche es esta línea?', [
      { id: 'matricula', etiqueta: 'Matrícula', obligatorio: true, valor: linea.matricula || '',
        ayuda: 'Se guarda tal como la escribas, aunque el coche no esté en la flota.' },
      { id: 'km', etiqueta: 'Kilómetros', valor: linea.km == null ? '' : String(linea.km),
        ayuda: 'Los que marcaba el coche ese día, si vienen en el papel.' },
    ], { nota: `${linea.albaran ? 'Albarán ' + linea.albaran + ' · ' : ''}${eur(linea.importe)}` });
    if (!v || !v.matricula) return;
    try {
      const r = await pedir('/facturas/api/linea/coche', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ facturaId, lineaId: linea.id, matricula: v.matricula, km: v.km }),
      });
      lista.recargar();
      if (!r.reconocido) {
        Dialogo.abrir({ titulo: 'Guardada', tono: 'aviso',
          html: `Apuntada como <strong>${esc(v.matricula.toUpperCase())}</strong>, pero <strong>ese coche no está en la flota</strong>. ` +
                'Compruébalo: o está mal escrita, o es un coche que no llevamos nosotros.',
          opciones: [{ texto: 'Entendido' }] });
      }
    } catch (e) { Dialogo.aviso({ titulo: 'No se pudo', texto: e.message, tono: 'error' }); }
  }

  async function anular(d) {
    const v = await Dialogo.formulario('Anular la factura', [
      { id: 'motivo', etiqueta: 'Motivo', tipo: 'texto-largo', obligatorio: true,
        ayuda: 'Queda guardado con tu nombre. Es lo que se mira cuando el gasto del mes no cuadra.' },
    ], { nota: 'Una factura no se borra: se anula y queda el motivo.' });
    const motivo = v && v.motivo;
    if (!motivo) return;
    try {
      await pedir('/facturas/api/anular', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: d.id, motivo }),
      });
      lista.recargar();
    } catch (e) { Dialogo.aviso({ titulo: 'No se pudo anular', texto: e.message, tono: 'error' }); }
  }
})();
</script>
