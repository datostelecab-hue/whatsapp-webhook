<div id="modulo"></div>

<!-- Formulario de alta y edición. Vive fuera del componente porque es propio de
     esta pantalla: el componente pone la lista y la ficha, no sabe de coches. -->
<div id="ficha-modal" class="hidden fixed inset-0 z-50 flex items-start justify-center p-4 overflow-y-auto bg-black/60 backdrop-blur-sm">
  <div class="bg-telecab-card border border-telecab-border rounded-2xl shadow-soft w-full max-w-lg my-8">
    <div class="flex items-center justify-between px-5 py-4 border-b border-telecab-border">
      <h3 id="fm-titulo" class="font-bold text-lg">Vehículo</h3>
      <button type="button" id="fm-cerrar" aria-label="Cerrar" class="w-8 h-8 rounded-lg hover:bg-telecab-card2 text-telecab-muted transition">
        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
      </button>
    </div>

    <form id="fm-form" class="p-5 space-y-4">
      <input type="hidden" id="fm-id">

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label for="fm-matricula" class="block text-xs text-telecab-muted uppercase tracking-wide mb-1">Matrícula *</label>
          <input id="fm-matricula" required maxlength="12"
                 class="w-full px-3 py-2 bg-telecab-card2 border border-telecab-border rounded-xl text-sm uppercase
                        focus:outline-none focus:ring-2 focus:ring-telecab-gold/40">
        </div>
        <div>
          <label for="fm-estado" class="block text-xs text-telecab-muted uppercase tracking-wide mb-1" title="Operativo, en taller, siniestro, de baja…&#10;Lo que decide si el coche se planifica y si cuenta en Control NO es este texto, sino si su estado está marcado como operativo en el catálogo.">Estado</label>
          <input type="hidden" id="fm-estado" value="O">
          <div class="tc-selector" data-para="fm-estado">
            <% (estadosVehiculo || []).forEach(e => { %>
              <button type="button" data-v="<%= e.codigo %>"><%= e.etiqueta %></button>
            <% }) %>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label for="fm-marcaModelo" class="block text-xs text-telecab-muted uppercase tracking-wide mb-1">Marca y modelo</label>
          <input id="fm-marcaModelo" maxlength="120"
                 class="w-full px-3 py-2 bg-telecab-card2 border border-telecab-border rounded-xl text-sm
                        focus:outline-none focus:ring-2 focus:ring-telecab-gold/40">
        </div>
        <div>
          <label for="fm-anio" class="block text-xs text-telecab-muted uppercase tracking-wide mb-1">Año</label>
          <input id="fm-anio" type="number" min="1980" max="2100"
                 class="w-full px-3 py-2 bg-telecab-card2 border border-telecab-border rounded-xl text-sm
                        focus:outline-none focus:ring-2 focus:ring-telecab-gold/40">
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label for="fm-matriculacion" class="block text-xs text-telecab-muted uppercase tracking-wide mb-1" title="La fecha del permiso de circulación. Se usa para la edad del coche en los informes de flota.">Matriculación</label>
          <input id="fm-matriculacion" class="js-fecha w-full px-3 py-2 bg-telecab-card2 border border-telecab-border rounded-xl text-sm
                        focus:outline-none focus:ring-2 focus:ring-telecab-gold/40" placeholder="dd/mm/aaaa">
        </div>
        <div>
          <label for="fm-itv" class="block text-xs text-telecab-muted uppercase tracking-wide mb-1" title="De aquí salen los avisos de ITV. Sin fecha no hay aviso: el coche no da error, simplemente nadie se entera cuando le toque.">Caduca la ITV</label>
          <input id="fm-itv" class="js-fecha w-full px-3 py-2 bg-telecab-card2 border border-telecab-border rounded-xl text-sm
                        focus:outline-none focus:ring-2 focus:ring-telecab-gold/40" placeholder="dd/mm/aaaa">
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label for="fm-aseguradora" class="block text-xs text-telecab-muted uppercase tracking-wide mb-1">Aseguradora</label>
          <input id="fm-aseguradora" maxlength="80"
                 class="w-full px-3 py-2 bg-telecab-card2 border border-telecab-border rounded-xl text-sm
                        focus:outline-none focus:ring-2 focus:ring-telecab-gold/40">
        </div>
        <div>
          <label for="fm-venceSeguro" class="block text-xs text-telecab-muted uppercase tracking-wide mb-1" title="Igual que la ITV: sin fecha no hay aviso.">Vence el seguro</label>
          <input id="fm-venceSeguro" class="js-fecha w-full px-3 py-2 bg-telecab-card2 border border-telecab-border rounded-xl text-sm
                        focus:outline-none focus:ring-2 focus:ring-telecab-gold/40" placeholder="dd/mm/aaaa">
        </div>
      </div>

      <div>
        <label for="fm-zonaId" class="block text-xs text-telecab-muted uppercase tracking-wide mb-1" title="La base del coche. Es lo que agrupa el cuadrante y lo que se usa para filtrar en el planificador y en Control.">Zona</label>
        <input type="hidden" id="fm-zonaId" value="">
        <div class="tc-selector" data-para="fm-zonaId">
          <button type="button" data-v="">Sin zona</button>
          <% (zonas || []).forEach(z => { %>
            <button type="button" data-v="<%= z.id %>"><%= z.nombre %></button>
          <% }) %>
        </div>
      </div>

      <% if (verTodasLasSedes) { %>
      <!-- LA SEDE, solo para quien ve las dos. A quien solo ve Madrid no se le
           enseña un campo que no puede tocar: el coche se queda donde estaba
           porque el formulario no lo manda y el servidor no lo toca. -->
      <div>
        <label for="fm-sede" class="block text-xs text-telecab-muted uppercase tracking-wide mb-1"
               title="En qué sede está el coche.&#10;Manda de verdad: Mantenimientos solo enseña los de tu sede, así que un coche con la sede equivocada desaparece de ahí sin avisar.">Sede</label>
        <input type="hidden" id="fm-sede" value="madrid">
        <div class="tc-selector" data-para="fm-sede">
          <% (sedes || []).forEach(x => { %>
            <button type="button" data-v="<%= x.codigo %>"><%= x.etiqueta %></button>
          <% }) %>
        </div>
      </div>
      <% } %>

      <div>
        <label for="fm-notas" class="block text-xs text-telecab-muted uppercase tracking-wide mb-1">Notas</label>
        <textarea id="fm-notas" rows="2"
                  class="w-full px-3 py-2 bg-telecab-card2 border border-telecab-border rounded-xl text-sm
                         focus:outline-none focus:ring-2 focus:ring-telecab-gold/40"></textarea>
      </div>

      <p id="fm-error" class="hidden text-sm text-telecab-red"></p>

      <div class="flex items-center gap-2 pt-2">
        <button type="submit" id="fm-guardar"
                class="flex-1 px-4 py-2.5 rounded-xl bg-telecab-gold text-telecab-dark font-semibold text-sm
                       hover:bg-telecab-gold-soft transition shadow-gold">
          Guardar
        </button>
        <button type="button" id="fm-cancelar"
                class="px-4 py-2.5 rounded-xl bg-telecab-card2 border border-telecab-border text-sm">
          Cancelar
        </button>
      </div>
    </form>
  </div>
</div>

<script src="<%= typeof est === 'function' ? est('/assets/js/piezasCoche.js') : '/assets/js/piezasCoche.js' %>"></script>
<script src="<%= typeof est === 'function' ? est('/assets/js/mantenimientosCoche.js') : '/assets/js/mantenimientosCoche.js' %>"></script>
<%# El resumen en 3D (pestaña «3D»): three.js y el modelo se bajan solo al abrirla. %>
<script src="<%= typeof est === 'function' ? est('/assets/js/coche3d.js') : '/assets/js/coche3d.js' %>"></script>
<script type="application/json" id="datos-servidor"><%- json({ puedePiezas: !!(typeof puedePiezas !== 'undefined' && puedePiezas), verTodasLasSedes: !!verTodasLasSedes }) %></script>
<script src="<%= est('/assets/js/vistas/Vehiculos/vehiculos.js') %>"></script>
