<div class="p-4 lg:p-6 space-y-4">

  <!-- ── KPIs de flota: hoy y este mes ─────────────────────────────────────── -->
  <div id="kpis-flota" class="grid grid-cols-2 lg:grid-cols-5 gap-3">
    <% [['Plantilla vigente','personas hoy'],['Ausentes hoy','baja, vacaciones, permiso'],['Sin salir esta semana','vigentes sin una hora'],['Horas del mes','efectivas, viaje + espera · sin hoy'],['Justificantes del mes','días con J']].forEach(function(k){ %>
      <div class="bg-telecab-card border border-telecab-border rounded-2xl px-4 py-3">
        <p class="text-[11px] uppercase tracking-wide text-telecab-muted"><%= k[0] %></p>
        <p class="kpi-val text-2xl font-bold text-telecab-text tabular-nums leading-none mt-1">–</p>
        <p class="text-[11px] text-telecab-muted mt-1"><%= k[1] %></p>
      </div>
    <% }); %>
  </div>

  <!-- ── Maestro-detalle ───────────────────────────────────────────────────── -->
  <div class="flex flex-col lg:flex-row gap-4 lg:h-[calc(100vh-14rem)]">
    <aside class="lg:w-[22rem] shrink-0 bg-telecab-card border border-telecab-border rounded-2xl flex flex-col lg:h-full overflow-hidden">
      <div class="p-3 border-b border-telecab-border space-y-2">
        <input id="b-buscar" class="w-full bg-telecab-dark border border-telecab-border rounded-xl px-3 py-2 text-sm text-telecab-text" placeholder="Nombre o teléfono…" aria-label="Buscar por nombre o teléfono" autocomplete="off">
        <div id="b-filtros" class="flex flex-wrap gap-1"></div>
        <p id="b-count" class="text-[11px] text-telecab-muted"></p>
      </div>
      <div id="b-lista" class="flex-1 overflow-y-auto p-2 space-y-0.5 max-h-[45vh] lg:max-h-none"></div>
    </aside>

    <section class="flex-1 min-w-0 bg-telecab-card border border-telecab-border rounded-2xl overflow-y-auto lg:h-full">
      <div id="b-default" class="p-5"></div>
      <div id="b-detalle" class="p-5 hidden"></div>
    </section>
  </div>
</div>

<style>
  /* La celda del calendario: cuadrada, con el número arriba y el dato abajo. */
  .cal { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 6px; }
  /* Ese dia trabajo con la cuenta de otro. Un punto y no un color de fondo: el
     fondo ya dice cuantas horas hizo, y son dos cosas distintas. */
  .cal-fantasma {
    position: absolute; top: .3rem; right: .3rem; width: .42rem; height: .42rem;
    border-radius: 50%; background: rgb(var(--tc-gold)); box-shadow: 0 0 0 2px rgb(var(--tc-dark) / .8);
  }
  /* Ese día tiene una −J (db/227): constancia, no horas. Abajo a la derecha,
     para no pisar ni el número ni el punto de la cuenta prestada. Pendiente,
     solo el borde: todavía no cuenta. */
  .cal-menosj {
    position: absolute; bottom: .3rem; right: .35rem; font-style: normal; font-size: 9px; font-weight: 700;
    line-height: 1; padding: .12rem .28rem; border-radius: .35rem;
    color: rgb(var(--tc-red)); background: rgb(var(--tc-red) / .14); border: 1px solid rgb(var(--tc-red) / .45);
  }
  .cal-menosj.pend { background: transparent; border-style: dashed; opacity: .8; }
  .cal-dia {
    position: relative; aspect-ratio: 1 / .78; border-radius: .8rem; padding: .45rem .55rem;
    display: flex; flex-direction: column; justify-content: space-between;
    border: 1px solid rgb(var(--tc-border) / .6); background: rgb(var(--tc-dark) / .35);
    cursor: pointer; transition: transform .12s ease, box-shadow .15s ease, border-color .15s ease;
  }
  .cal-dia:hover { transform: translateY(-1px); border-color: rgb(var(--tc-gold) / .6); box-shadow: 0 10px 24px -14px rgb(0 0 0 / .8); }
  .cal-dia.hoy { outline: 2px solid rgb(var(--tc-gold)); outline-offset: 1px; }
  .cal-dia.sel { border-color: rgb(var(--tc-gold)); box-shadow: 0 0 0 3px rgb(var(--tc-gold) / .25); }
  /* Lo ya decidido para el futuro (vacaciones, baja, libranza) se ve con su
     color pero atenuado y con el borde punteado: es una promesa, no un hecho. */
  .cal-dia.porvenir { opacity: .55; border-style: dashed; }
  .mini > i.porvenir { opacity: .45; }
  .cal-dia.futuro, .cal-dia.fuera { opacity: .28; cursor: default; }
  /* Horas en un día sin contrato en el sistema: se ven, con el borde de aviso. */
  .cal-dia.sincontrato { outline: 2px dashed rgb(var(--tc-red) / .7); outline-offset: -3px; }
  .cal-dia.futuro:hover, .cal-dia.fuera:hover { transform: none; border-color: rgb(var(--tc-border) / .6); box-shadow: none; }
  .cal-num { font-size: 11px; color: rgb(var(--tc-muted)); font-weight: 600; line-height: 1; }
  .cal-val { font-size: 12px; font-weight: 700; line-height: 1; letter-spacing: -.01em; }
  .cal-tag { font-size: 10px; font-weight: 700; padding: .15rem .4rem; border-radius: .4rem; align-self: flex-start; }
  /* Trabajo: verde, más lleno cuanto más cerca de las 8 h. */
  .cal-dia.t1 { background: rgb(var(--tc-green) / .10); }
  .cal-dia.t2 { background: rgb(var(--tc-green) / .22); }
  .cal-dia.t3 { background: rgb(var(--tc-green) / .40); border-color: rgb(var(--tc-green) / .5); }
  .cal-dia.t3 .cal-val, .cal-dia.t2 .cal-val { color: rgb(var(--tc-text)); }
  .cal-dia.t1 .cal-val { color: rgb(var(--tc-green)); }
  /* HOY va a medias: neutro, con su etiqueta, sin el rojo de «Ausencia» ni el
     verde de un día cerrado. Lo que haga hoy cuenta mañana (15/10/2026). */
  .cal-dia.hoydia, .cal-dia.hoyh { background: rgb(var(--tc-gold) / .06); border-color: rgb(var(--tc-gold) / .35); }
  .cal-dia.hoyh .cal-val { color: rgb(var(--tc-text)); }
  .cal-hoytag { font-size: 9px; font-weight: 700; letter-spacing: .04em; color: rgb(var(--tc-gold)); margin-left: .3rem; }
  /* Sin plaza ese día, o en una situación sin marca (suspensión…): nadie le
     esperaba en un coche. No es «Ausencia» ni cuenta en su promedio. */
  .cal-dia.sinplaza, .cal-dia.sinmarca { background: rgb(var(--tc-muted) / .06); }
  .cal-dia.sinplaza .cal-val, .cal-dia.sinmarca .cal-val { color: rgb(var(--tc-muted)); font-weight: 600; font-size: 10px; }
  .cal-dia.nosalio { background: rgb(var(--tc-red) / .10); border-color: rgb(var(--tc-red) / .35); }
  .cal-dia.nosalio .cal-val { color: rgb(var(--tc-red)); font-size: 10px; font-weight: 600; }
  .cal-dia.L { background: rgb(var(--tc-muted) / .10); }
  .cal-dia.L .cal-val { color: rgb(var(--tc-muted)); font-weight: 600; font-size: 10px; }
  .cal-dia.V { background: rgb(var(--tc-vac) / .22); border-color: rgb(var(--tc-vac) / .45); }
  .cal-dia.B { background: rgb(var(--tc-med) / .22); border-color: rgb(var(--tc-med) / .45); }
  .cal-dia.P { background: rgb(var(--tc-permiso) / .22); border-color: rgb(var(--tc-permiso) / .45); }
  /* Un día JUSTIFICADO lleva SIEMPRE el borde azul: de ahí se sabe que hay J,
     venga el fondo del color que venga. */
  .cal-dia.J { border-color: rgb(var(--tc-just) / .75); border-width: 2px; }
  /* UN DÍA SON HORAS, VENGAN DE DONDE VENGAN: las de BOLT más las de la J.
     De ahí salen tres casos y los tres se ven distintos.

       jcumple   J + BOLT >= 8   verde, igual que un día conducido entero
       jpura     J >= 8 sin BOLT azul: cubrió la jornada SIN SALIR (taller,
                 médico, juzgado). Cuenta para la nómina, pero no es lo mismo
                 que haber conducido, y pintarlo del mismo verde lo escondía.
       jcorto    no llega a 8    ROJO, aunque tenga papel. Una J de 2 h con 3 h
                 en BOLT son 5 h: antes salía azul y se disimulaba entre los
                 días buenos. */
  .cal-dia.jcumple { background: rgb(var(--tc-green) / .30); }
  .cal-dia.jpura   { background: rgb(var(--tc-just) / .26); }
  .cal-dia.jcorto  { background: rgb(var(--tc-red) / .16); }
  .cal-dia.jcorto .cal-val { color: rgb(var(--tc-red)); }
  .cal-dia.jcumple .cal-val, .cal-dia.jpura .cal-val { color: rgb(var(--tc-text)); }
  /* La "J" pequeña dentro de la celda, para no perder de vista que es un día
     justificado aunque el color venga de las horas. */
  .cal-val.cal-j { display: flex; align-items: baseline; gap: .25rem; }
  .cal-jmini { font-size: 9px; font-style: normal; font-weight: 800; padding: 0 .25rem;
    border-radius: .25rem; background: rgb(var(--tc-just)); color: white; letter-spacing: .02em; }
  .mini > i.J { background: rgb(var(--tc-just)); }
  /* UNA J PENDIENTE DE APROBAR es una hora PRESUNTA: va en azul y con el borde
     punteado, porque puede desaparecer. Si la rechazan, esas horas nunca
     existieron; hasta que alguien la apruebe, no cuentan en la nómina. */
  .cal-dia.jpend .cal-jmini { background: rgb(var(--tc-azul)); }
  .cal-dia.jpend .cal-val { color: rgb(var(--tc-azul)); }
  .cal-dia.jpend { outline: 1px dashed rgb(var(--tc-azul) / .55); outline-offset: -2px; }
  /* El año: doce meses en miniatura, cada día un puntito. */
  .mini { display: grid; grid-template-columns: repeat(7, 1fr); gap: 2px; }
  .mini > i { display: block; aspect-ratio: 1; border-radius: 2px; background: rgb(var(--tc-dark) / .5); }
  .mini > i.t1 { background: rgb(var(--tc-green) / .35); } .mini > i.t2 { background: rgb(var(--tc-green) / .6); } .mini > i.t3 { background: rgb(var(--tc-green)); }
  .mini > i.nosalio { background: rgb(var(--tc-red) / .6); } .mini > i.L { background: rgb(var(--tc-muted) / .35); }
  .mini > i.hoydia { background: rgb(var(--tc-gold) / .45); }
  .mini > i.sinplaza, .mini > i.sinmarca { background: rgb(var(--tc-muted) / .18); }
  .mini > i.V { background: rgb(var(--tc-vac)); } .mini > i.B { background: rgb(var(--tc-med)); } .mini > i.P { background: rgb(var(--tc-permiso)); } .mini > i.J { background: rgb(var(--tc-just)); }
  .mini > i.futuro, .mini > i.fuera { opacity: .15; }
  .b-chip { font-size: 11px; padding: .2rem .55rem; border-radius: .5rem; border: 1px solid rgb(var(--tc-border) / .7); color: rgb(var(--tc-muted)); cursor: pointer; }
  .b-chip.on { border-color: rgb(var(--tc-gold)); color: rgb(var(--tc-text)); background: rgb(var(--tc-gold) / .12); }
  /* Vacaciones por meses: una fila por persona, una celda por día. */
  .vac-fila { display: grid; gap: 2px; align-items: center; }
  .vac-fila > i { display: block; height: 20px; border-radius: 4px; background: rgb(var(--tc-dark) / .3); }
  .vac-fila > i.finde { background: rgb(var(--tc-dark) / .55); }
  .vac-fila > i.vac-on { background: rgb(var(--tc-vac)); }
  /* Programadas (aún no llegan): rayadas, para distinguir la proyección. */
  .vac-fila > i.vac-prog { background: repeating-linear-gradient(45deg,
      rgb(var(--tc-vac) / .9) 0 5px, rgb(var(--tc-vac) / .30) 5px 10px); }
  .vac-fila > b { display: flex; align-items: center; justify-content: center; height: 20px;
      border-radius: 4px; font-size: 10px; font-weight: 700; color: rgb(var(--tc-text)); }
  .vac-nombre { cursor: pointer; }
  .vac-nombre:hover { color: rgb(var(--tc-gold)); }
</style>

<script type="application/json" id="datos-servidor"><%- json({
  rol: String(rol || ''),
  puedeJustificar: !!(puedeJustificar),
  puedeVacaciones: typeof puedeVacaciones !== 'undefined' && !!puedeVacaciones,
  destinosJ: destinosJ || [],
  casuisticasMenosJ: typeof casuisticasMenosJ !== 'undefined' ? casuisticasMenosJ : [],
  tiposJ: tiposJ || [],
}) %></script>
<script src="<%= est('/assets/js/vistas/Operaciones/bitacora.js') %>"></script>
