<div class="p-4 lg:p-6 max-w-[1500px] mx-auto">

  <!-- ── Cabecera ─────────────────────────────────────────────────────── -->
  <div class="flex flex-wrap items-end justify-between gap-3 mb-4">
    <div>
      <h1 class="text-2xl font-bold text-telecab-text flex items-center gap-2">
        <i class="fa-solid fa-gauge-high text-telecab-gold"></i> Excesos de velocidad
      </h1>
      <p class="text-sm text-telecab-muted mt-1">
        Cada exceso se avisa por WhatsApp con la misma plantilla, siempre.
        Lo que se mira aquí es <b>quién sigue corriendo después de que se le diga</b>.
      </p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <input id="v-desde" class="js-fecha w-28 px-2.5 py-2 bg-telecab-card border border-telecab-border rounded-xl text-sm text-telecab-text"
             readonly placeholder="dd/mm/aaaa" aria-label="Desde" data-max="today">
      <span class="text-telecab-muted text-sm">a</span>
      <input id="v-hasta" class="js-fecha w-28 px-2.5 py-2 bg-telecab-card border border-telecab-border rounded-xl text-sm text-telecab-text"
             readonly placeholder="dd/mm/aaaa" aria-label="Hasta" data-max="today">
      <button id="v-consultar" class="px-4 py-2 rounded-xl bg-telecab-gold text-telecab-dark text-sm font-semibold">
        <i class="fa-solid fa-magnifying-glass mr-1"></i> Consultar
      </button>
      <button id="v-procesar" class="px-3 py-2 rounded-xl bg-telecab-card border border-telecab-border text-sm text-telecab-muted hover:text-telecab-text"
              title="Procesa los excesos que ya trajo la ingesta, resuelve quién conducía con los tramos de Bolt y avisa. Lo normal lo hace el cron cada 15 minutos.">
        <i class="fa-solid fa-bolt mr-1"></i> Revisar ahora
      </button>
    </div>
  </div>

  <!-- El modo importa mucho: en pruebas NO sale ningún WhatsApp. -->
  <div id="v-modo" class="hidden mb-4 rounded-xl px-4 py-3 text-sm"></div>

  <!-- ── Las cifras ───────────────────────────────────────────────────── -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-5">
    <div class="bg-telecab-card border border-telecab-border rounded-2xl p-4">
      <p class="text-xs text-telecab-muted uppercase tracking-wide">Excesos</p>
      <p id="v-excesos" class="text-3xl font-bold mt-1 text-telecab-text tabular-nums">—</p>
      <p id="v-gente" class="text-[11px] text-telecab-muted mt-1"></p>
    </div>
    <div class="bg-telecab-card border-2 border-telecab-green/40 rounded-2xl p-4">
      <p class="text-xs text-telecab-muted uppercase tracking-wide">Avisos enviados</p>
      <p id="v-avisos" class="text-3xl font-bold mt-1 text-telecab-green tabular-nums">—</p>
      <p id="v-avisos-det" class="text-[11px] text-telecab-muted mt-1">Uno por exceso, con 5 min entre avisos</p>
    </div>
    <div class="bg-telecab-card border border-telecab-border rounded-2xl p-4">
      <p class="text-xs text-telecab-muted uppercase tracking-wide">Sin avisar</p>
      <p id="v-sinavisar" class="text-3xl font-bold mt-1 text-telecab-muted tabular-nums">—</p>
      <p class="text-[11px] text-telecab-muted mt-1">No se supo quién conducía</p>
    </div>
    <div class="bg-telecab-card border-2 border-telecab-red/40 rounded-2xl p-4">
      <p class="text-xs text-telecab-muted uppercase tracking-wide">Punta</p>
      <p id="v-punta" class="text-3xl font-bold mt-1 text-telecab-red tabular-nums">—</p>
      <p id="v-fallos" class="text-[11px] text-telecab-muted mt-1"></p>
    </div>
  </div>

  <div id="v-aviso" class="hidden mb-4 rounded-xl border border-telecab-red/40 bg-telecab-red/5 p-4 text-sm text-telecab-red"></div>

  <!-- ── Pestañas ─────────────────────────────────────────────────────── -->
  <div class="flex gap-1 mb-4 border-b border-telecab-border" id="v-tabs">
    <button data-tab="cond" class="v-tab px-4 py-2.5 text-sm font-medium -mb-px border-b-2 transition">
      <i class="fa-solid fa-user-clock mr-1.5"></i> Quién no hace caso
    </button>
    <button data-tab="hist" class="v-tab px-4 py-2.5 text-sm font-medium -mb-px border-b-2 transition">
      <i class="fa-solid fa-clock-rotate-left mr-1.5"></i> Histórico de excesos
    </button>
  </div>

  <!-- ══ Quién no hace caso ══ -->
  <section data-panel="cond">
    <div class="bg-telecab-card border border-telecab-border rounded-2xl overflow-hidden">
      <div class="overflow-x-auto max-h-[34rem] overflow-y-auto">
        <table class="w-full text-sm">
          <thead class="bg-telecab-card2 text-telecab-muted text-xs uppercase tracking-wide sticky top-0 z-10">
            <tr>
              <th class="text-left   font-semibold px-4 py-3 sticky left-0 bg-telecab-card2">Conductor</th>
              <th class="text-center font-semibold px-3 py-3" title="WhatsApp que ha recibido de verdad">Avisos</th>
              <th class="text-center font-semibold px-3 py-3">Excesos</th>
              <th class="text-right  font-semibold px-3 py-3">Punta</th>
              <th class="text-right  font-semibold px-3 py-3">Exceso medio</th>
              <th class="text-center font-semibold px-3 py-3">Coches</th>
              <th class="text-left   font-semibold px-3 py-3">Desde</th>
              <th class="text-left   font-semibold px-3 py-3">Último</th>
              <th class="text-left   font-semibold px-3 py-3 w-32">Insistencia</th>
            </tr>
          </thead>
          <tbody id="v-tbody-cond" class="divide-y divide-telecab-border/60"></tbody>
        </table>
      </div>
      <div id="v-vacio-cond" class="hidden p-10 text-center text-telecab-muted">
        <i class="fa-solid fa-gauge-simple text-3xl mb-2 opacity-40"></i>
        <p>Nadie ha pasado del límite en este rango.</p>
      </div>
    </div>
    <p class="text-[11px] text-telecab-muted mt-2">
      <b>Avisos</b> son los WhatsApp que ha recibido DE VERDAD — un «simulado» se cuenta aparte porque
      al conductor no le llegó nada—; <b>excesos</b>, las veces que pasó del límite
      —la diferencia son los que no se le pudieron atribuir con seguridad—. La barra compara
      <b>avisos por día transcurrido</b> desde su primer exceso: diez avisos en tres días son una racha,
      diez en seis meses son una costumbre, y no se arreglan igual.
    </p>
  </section>

  <!-- ══ Histórico ══ -->
  <section data-panel="hist" class="hidden">
    <div class="flex flex-wrap items-center gap-2 mb-3">
      <select id="v-estado" aria-label="Estado del exceso" class="px-3 py-2 rounded-lg bg-telecab-card border border-telecab-border text-sm text-telecab-text">
        <option value="">Todos los excesos</option>
        <option value="avisado">Solo los avisados</option>
        <option value="revisar">Los que hay que mirar a mano</option>
        <option value="simulado">Simulados (modo pruebas)</option>
        <option value="agrupado">Con el aviso anterior (menos de 5 min)</option>
      </select>
      <input id="v-busca" type="search" placeholder="Conductor o matrícula…" aria-label="Buscar conductor o matrícula"
             class="flex-1 min-w-[200px] px-3 py-2 rounded-lg bg-telecab-card border border-telecab-border text-sm text-telecab-text">
      <span id="v-cuenta" class="text-xs text-telecab-muted"></span>
    </div>

    <div class="bg-telecab-card border border-telecab-border rounded-2xl overflow-hidden">
      <div class="overflow-x-auto max-h-[34rem] overflow-y-auto">
        <table class="w-full text-sm">
          <thead class="bg-telecab-card2 text-telecab-muted text-xs uppercase tracking-wide sticky top-0 z-10">
            <tr>
              <th class="text-left  font-semibold px-4 py-3">Cuándo</th>
              <th class="text-left  font-semibold px-3 py-3">Matrícula</th>
              <th class="text-left  font-semibold px-3 py-3">Conductor</th>
              <th class="text-right font-semibold px-3 py-3">Velocidad</th>
              <th class="text-right font-semibold px-3 py-3">Límite</th>
              <th class="text-right font-semibold px-3 py-3 text-telecab-red">Exceso</th>
              <th class="text-left  font-semibold px-3 py-3">Qué se hizo</th>
              <th class="text-left  font-semibold px-3 py-3">Dónde</th>
            </tr>
          </thead>
          <tbody id="v-tbody-hist" class="divide-y divide-telecab-border/60"></tbody>
        </table>
      </div>
      <div id="v-vacio-hist" class="hidden p-10 text-center text-telecab-muted">
        <i class="fa-solid fa-clock-rotate-left text-3xl mb-2 opacity-40"></i>
        <p>Sin excesos con esos filtros.</p>
      </div>
    </div>
  </section>
</div>

<script src="<%= est('/assets/js/vistas/Operaciones/sanciones.js') %>"></script>
