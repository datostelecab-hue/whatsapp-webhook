<div class="p-4 lg:p-6 max-w-6xl mx-auto space-y-5">

  <!-- Totales -->
  <div class="grid grid-cols-2 sm:grid-cols-5 gap-3">
    <div class="bg-telecab-card border border-telecab-border rounded-2xl px-4 py-3">
      <p class="text-[11px] uppercase tracking-wide text-telecab-muted">Por reclutar</p>
      <p id="t-abiertas" class="text-2xl font-bold text-telecab-gold">–</p>
    </div>
    <div class="bg-telecab-card border border-telecab-border rounded-2xl px-4 py-3">
      <p class="text-[11px] uppercase tracking-wide text-telecab-muted">Con candidato</p>
      <p id="t-proceso" class="text-2xl font-bold text-telecab-violet">–</p>
    </div>
    <div class="bg-telecab-card border border-telecab-border rounded-2xl px-4 py-3">
      <p class="text-[11px] uppercase tracking-wide text-telecab-muted">Recambios</p>
      <p id="t-recambios" class="text-2xl font-bold text-telecab-text">–</p>
    </div>
    <div class="bg-telecab-card border border-telecab-border rounded-2xl px-4 py-3">
      <p class="text-[11px] uppercase tracking-wide text-telecab-muted">Plazas prometidas</p>
      <p id="t-plazas" class="text-2xl font-bold text-telecab-text">–</p>
    </div>
    <div class="bg-telecab-card border border-telecab-border rounded-2xl px-4 py-3">
      <p class="text-[11px] uppercase tracking-wide text-telecab-muted">Día / Noche</p>
      <p class="text-2xl font-bold text-telecab-text"><span id="t-dia">–</span><span class="text-telecab-muted text-base mx-1">/</span><span id="t-noche">–</span></p>
    </div>
  </div>

  <div class="flex flex-wrap items-center justify-between gap-2">
    <p class="text-xs text-telecab-muted">
      Lo que Tráfico armó en el <a href="/generador" class="text-telecab-gold hover:underline">generador</a> y
      Selección tiene que reclutar. Cada vacante apunta a <b>plazas reales</b> del planificador, así que la
      matrícula que se promete es la que se ocupa.
    </p>
    <button id="btn-recargar" class="text-xs px-3 py-1.5 rounded-lg border border-telecab-border text-telecab-muted hover:border-telecab-gold transition">
      <i class="fa-solid fa-rotate mr-1"></i> Recargar
    </button>
  </div>

  <div id="lista" class="grid gap-3 lg:grid-cols-2"></div>

  <div id="resueltas-wrap" class="hidden mt-6">
    <h2 class="text-sm font-semibold text-telecab-text mb-3 flex items-center gap-2">
      <i class="fa-solid fa-circle-check text-telecab-green"></i> Cerradas <span id="t-resueltas" class="text-telecab-muted font-normal"></span>
    </h2>
    <div id="lista-resueltas" class="grid gap-3 lg:grid-cols-2 opacity-70"></div>
  </div>

</div>

<script src="<%= est('/assets/js/vistas/Seleccion/vacantes.js') %>"></script>
