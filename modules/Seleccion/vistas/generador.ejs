<div class="p-4 lg:p-6 max-w-5xl mx-auto space-y-5">

  <!-- Controles -->
  <div class="bg-telecab-card border border-telecab-border rounded-2xl p-4">
    <div class="mb-4">
      <label id="lbl-tipo" class="block text-xs text-telecab-muted mb-1">Tipo de vacante</label>
      <div class="inline-flex rounded-xl border border-telecab-border overflow-hidden" id="tg-tipo" role="group" aria-labelledby="lbl-tipo">
        <button type="button" data-val="CT" class="px-4 py-2 text-sm">Correturno (varias matrículas)</button>
        <button type="button" data-val="Fijo" class="px-4 py-2 text-sm border-l border-telecab-border">Fijo (una matrícula)</button>
        <button type="button" data-val="Recambio" class="px-4 py-2 text-sm border-l border-telecab-border">Buscar recambio</button>
      </div>
      <p id="tipo-ayuda" class="text-[11px] text-telecab-muted mt-1.5"></p>
    </div>
    <div id="modo-hueco">
    <div class="grid md:grid-cols-4 gap-4">
      <div>
        <label for="sel-zona" class="block text-xs text-telecab-muted mb-1">Zona</label>
        <select id="sel-zona" class="inp"><option value=""></option></select>
      </div>
      <div>
        <label id="lbl-turno" class="block text-xs text-telecab-muted mb-1">Turno</label>
        <div class="inline-flex rounded-xl border border-telecab-border overflow-hidden w-full" id="tg-turno" role="group" aria-labelledby="lbl-turno">
          <button type="button" data-val="Día" class="flex-1 px-3 py-2 text-sm"><i class="fa-solid fa-sun mr-1.5 text-[11px] opacity-70"></i>Día</button>
          <button type="button" data-val="Noche" class="flex-1 px-3 py-2 text-sm border-l border-telecab-border"><i class="fa-solid fa-moon mr-1.5 text-[11px] opacity-70"></i>Noche</button>
        </div>
      </div>
      <div id="wrap-dias">
        <label id="lbl-dias" class="block text-xs text-telecab-muted mb-1">Contrato</label>
        <div class="inline-flex rounded-xl border border-telecab-border overflow-hidden w-full" id="tg-dias" role="group" aria-labelledby="lbl-dias">
          <button type="button" data-val="32" class="flex-1 px-3 py-2 text-sm">32 h · 4 días</button>
          <button type="button" data-val="40" class="flex-1 px-3 py-2 text-sm border-l border-telecab-border">40 h · 6 días</button>
        </div>
      </div>
      <div>
        <label for="sel-matricula" class="block text-xs text-telecab-muted mb-1" id="lbl-matricula">Matrícula de partida</label>
        <select id="sel-matricula" class="inp"><option value="">—</option></select>
      </div>
    </div>
    <div class="flex items-center gap-3 mt-4">
      <button id="btn-generar" class="px-5 py-2.5 rounded-xl bg-telecab-gold text-telecab-dark font-semibold hover:bg-telecab-gold-soft transition disabled:opacity-40" disabled>
        <i class="fa-solid fa-wand-magic-sparkles mr-1"></i> Generar vacante
      </button>
      <p id="msg" class="text-xs hidden"></p>
    </div>
    </div><!-- /modo-hueco -->

    <!-- BUSCAR RECAMBIO: se elige a la persona, no al hueco -->
    <div id="modo-recambio" class="hidden">
      <label for="rc-busca" class="block text-xs text-telecab-muted mb-1">¿A quién hay que sustituir?</label>
      <div class="relative">
        <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-telecab-muted text-xs"></i>
        <input id="rc-busca" type="search" autocomplete="off" placeholder="Nombre, matrícula o teléfono…"
               class="inp pl-8 w-full">
      </div>
      <p class="text-[11px] text-telecab-muted mt-1.5">
        Solo sale quien tiene plaza en el planificador, ordenado por <b>quien menos horas hace</b> —
        que es por donde se empieza a mirar—. La vacante saldrá sola de lo que ocupa hoy.
      </p>
      <div id="rc-lista" class="mt-3 space-y-1.5 max-h-[420px] overflow-y-auto pr-1"></div>
    </div>
  </div>

  <!-- Pendientes de generar: huecos sin vacante guardada -->
  <div id="pendientes-wrap" class="bg-telecab-card border border-telecab-border rounded-2xl p-4 hidden">
    <h2 class="text-sm font-semibold text-telecab-text mb-1"><i class="fa-solid fa-bell text-telecab-gold mr-1"></i> Pendientes de generar <span id="pend-turno" class="text-telecab-muted font-normal"></span></h2>
    <p class="text-[11px] text-telecab-muted mb-2">Huecos que aún NO tienen vacante guardada. Clic para prepararla y generar.</p>
    <div id="pendientes" class="grid gap-1.5 sm:grid-cols-2"></div>
  </div>

  <!-- Resultado interactivo -->
  <div id="resultado" class="hidden space-y-4">
    <div class="bg-telecab-card border border-telecab-border rounded-2xl p-4">
      <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
        <h2 id="res-titulo" class="text-sm font-semibold text-telecab-text"></h2>
        <span id="res-estado" class="text-xs px-2.5 py-1 rounded-full border"></span>
      </div>
      <div class="grid grid-cols-7 gap-1.5" id="semana"></div>
      <div class="flex flex-wrap gap-3 mt-3 text-[11px] text-telecab-muted">
        <span><span class="inline-block w-3 h-3 rounded bg-telecab-gold/30 border border-telecab-gold/50 align-middle"></span> misma zona</span>
        <span><span class="inline-block w-3 h-3 rounded bg-sky-500/25 border border-sky-500/50 align-middle"></span> zona cercana</span>
        <span><span class="inline-block w-3 h-3 rounded bg-telecab-dark border border-telecab-border align-middle"></span> libre</span>
      </div>
    </div>

    <div class="bg-telecab-card border border-telecab-border rounded-2xl p-4">
      <div class="flex items-center justify-between mb-2 gap-2">
        <h3 class="text-sm font-semibold text-telecab-text"><i class="fa-solid fa-list-check text-telecab-gold mr-1"></i> Matrículas de la vacante</h3>
        <button id="btn-guardar-vac" class="px-4 py-2 rounded-xl bg-telecab-green/15 border border-telecab-green/40 text-telecab-green hover:bg-telecab-green/25 transition text-sm font-semibold whitespace-nowrap">
          <i class="fa-solid fa-floppy-disk mr-1"></i> Guardar vacante
        </button>
      </div>
      <div id="sel-bloques" class="space-y-1.5"></div>
      <p id="msg-vac" class="text-xs mt-2 hidden"></p>
    </div>

    <div class="bg-telecab-card border border-telecab-border rounded-2xl p-4">
      <h3 class="text-sm font-semibold text-telecab-text mb-1"><i class="fa-solid fa-plus text-telecab-green mr-1"></i> Otras opciones compatibles
        <span class="text-telecab-muted font-normal">— añade a criterio de Tráfico</span></h3>
      <p class="text-[11px] text-telecab-muted mb-2">Fichas cuyos huecos no chocan con los días ya cubiertos.</p>
      <div id="compatibles" class="space-y-1.5"></div>
    </div>
  </div>

  <!-- Resultado RECAMBIO -->
  <div id="resultado-recambio" class="hidden space-y-4">
    <div class="bg-telecab-card border border-telecab-border rounded-2xl p-4">
      <div class="flex flex-wrap items-start justify-between gap-2 mb-3">
        <div>
          <h2 id="rc-titulo" class="text-sm font-semibold text-telecab-text"></h2>
          <p id="rc-sub" class="text-[11px] text-telecab-muted mt-0.5"></p>
        </div>
        <span id="rc-jornada" class="text-xs px-2.5 py-1 rounded-full border border-telecab-gold/40 text-telecab-gold bg-telecab-gold/10 whitespace-nowrap"></span>
      </div>
      <div id="rc-persona" class="grid sm:grid-cols-2 lg:grid-cols-4 gap-2 mb-3"></div>

      <h3 class="text-sm font-semibold text-telecab-text mb-1"><i class="fa-solid fa-list-check text-telecab-gold mr-1"></i> Plazas que deja</h3>
      <p class="text-[11px] text-telecab-muted mb-2">Se pueden quitar: a veces se sustituye solo una parte del correturno. La jornada se recalcula sola.</p>
      <div id="rc-plazas" class="space-y-1.5"></div>

      <div class="grid grid-cols-7 gap-1.5 mt-3" id="rc-semana"></div>
      <p id="rc-porque" class="text-[11px] text-telecab-muted mt-2"></p>

      <div class="grid sm:grid-cols-3 gap-3 mt-4">
        <div>
          <label for="rc-salida" class="block text-xs text-telecab-muted mb-1">Último día que trabaja (opcional)</label>
          <input id="rc-salida" type="date" class="inp w-full">
        </div>
        <div class="sm:col-span-2">
          <label for="rc-notas" class="block text-xs text-telecab-muted mb-1">Nota para Selección (opcional)</label>
          <input id="rc-notas" type="text" class="inp w-full" placeholder="Por qué se le sustituye, urgencia…">
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-3 mt-4">
        <button id="btn-guardar-recambio" class="px-4 py-2 rounded-xl bg-telecab-green/15 border border-telecab-green/40 text-telecab-green hover:bg-telecab-green/25 transition text-sm font-semibold">
          <i class="fa-solid fa-floppy-disk mr-1"></i> Generar vacante de recambio
        </button>
        <button id="btn-rc-volver" class="px-3 py-2 rounded-xl border border-telecab-border text-telecab-muted hover:text-telecab-text transition text-sm">
          Volver a la búsqueda
        </button>
        <p id="msg-rc" class="text-xs hidden"></p>
      </div>
    </div>
  </div>

  <!-- Resultado FIJO (una sola matrícula) -->
  <div id="resultado-fijo" class="hidden">
    <div class="bg-telecab-card border border-telecab-border rounded-2xl p-4">
      <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
        <h2 id="fijo-titulo" class="text-sm font-semibold text-telecab-text"></h2>
        <button id="btn-guardar-fijo" class="px-4 py-2 rounded-xl bg-telecab-green/15 border border-telecab-green/40 text-telecab-green hover:bg-telecab-green/25 transition text-sm font-semibold whitespace-nowrap">
          <i class="fa-solid fa-floppy-disk mr-1"></i> Guardar vacante
        </button>
      </div>
      <div id="fijo-detalle"></div>
      <p id="msg-fijo" class="text-xs mt-2 hidden"></p>
    </div>
  </div>

</div>


<script src="<%= est('/assets/js/vistas/Seleccion/generador.js') %>"></script>
