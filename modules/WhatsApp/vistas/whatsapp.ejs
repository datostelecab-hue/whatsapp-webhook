<style>
  body .tc-selector.w-filtros { gap: .2rem; flex-wrap: wrap; }
  body .tc-selector.w-filtros button { padding: .35rem .4rem; font-size: .75rem; white-space: nowrap; }
  body .tc-selector.w-filtros [data-cuenta] { font-weight: 500; opacity: .75; font-variant-numeric: tabular-nums; }
  body .tc-selector.w-filtros [data-cuenta]:empty { display: none; }
</style>
<%# A TODO EL ANCHO Y CON POCO MARGEN (22/10/2026, Camilo: «haz más grande la
    ventana del módulo colocándole pocos márgenes»). Sin el párrafo de explicación
    de arriba, que también pidió quitar: el chat ocupa todo lo que queda bajo la
    barra. %>
<div class="px-2 sm:px-3 pt-2 pb-2">

  <h1 class="sr-only">WhatsApp</h1>

  <div id="w-aviso" class="hidden mb-2 rounded-2xl border border-telecab-warn/40 bg-telecab-warn/10 p-4 text-sm text-telecab-warn"></div>

  <div id="w-marco" class="rounded-2xl border border-telecab-border bg-telecab-card overflow-hidden grid grid-cols-1 md:grid-cols-[400px_minmax(0,1fr)] h-[calc(100svh-10.5rem)] md:h-[calc(100svh-5rem)] min-h-[440px]">

    <!-- ── Las conversaciones ─────────────────────────────────────────────── -->
    <aside id="w-lado" class="flex flex-col min-h-0 border-r border-telecab-border">
      <div class="p-3 border-b border-telecab-border space-y-2">
        <div class="flex items-center gap-2">
          <label class="relative block flex-1">
            <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-xs text-telecab-muted" aria-hidden="true"></i>
            <input id="w-buscar" type="search" autocomplete="off" placeholder="Busca por nombre o teléfono" aria-label="Buscar conversación"
                   class="w-full pl-8 pr-3 py-2 rounded-xl bg-telecab-dark border border-telecab-border text-sm text-telecab-text placeholder:text-telecab-muted focus:outline-none focus:border-telecab-gold/70">
          </label>
          <% if (puedeEscribir) { %>
          <button type="button" id="w-nueva" class="shrink-0 w-9 h-9 rounded-xl border border-telecab-border text-telecab-muted hover:text-telecab-text hover:border-telecab-gold/60"
                  title="Escribir a un conductor que no está en la lista.&#10;Si nunca ha escrito, la primera vez es con una plantilla (se paga)." aria-label="Escribir a un conductor">
            <i class="fa-solid fa-pen-to-square"></i>
          </button>
          <% } %>
        </div>
        <input type="hidden" id="w-filtro" value="">
        <div class="tc-selector w-filtros" data-para="w-filtro" role="group" aria-label="Qué conversaciones ver">
          <button type="button" data-v="">Todas <span data-cuenta="todas"></span></button>
          <button type="button" data-v="noleidas" title="Las que tienen mensajes sin leer">No leídas <span data-cuenta="noleidas"></span></button>
          <button type="button" data-v="mias" title="Las que llevas tú">Mías <span data-cuenta="mias"></span></button>
          <button type="button" data-v="libres" title="Las que no lleva nadie">Sin asignar <span data-cuenta="libres"></span></button>
          <button type="button" data-v="sinwsp" title="Números a los que Meta no pudo entregar el mensaje: no tienen WhatsApp">Sin Wsp <span data-cuenta="sinwsp"></span></button>
        </div>
      </div>
      <ul id="w-lista" class="flex-1 overflow-y-auto min-h-0" aria-label="Conversaciones">
        <li class="px-4 py-6 text-sm text-telecab-muted">Cargando…</li>
      </ul>
    </aside>

    <!-- ── El chat ────────────────────────────────────────────────────────── -->
    <section id="w-chat" class="hidden md:flex flex-col min-h-0">
      <div id="w-vacio" class="flex-1 flex flex-col items-center justify-center text-center p-8 text-telecab-muted">
        <i class="fa-solid fa-comments text-4xl mb-3 opacity-40"></i>
        <p class="text-sm max-w-[44ch]">Elige una conversación para ver qué le ha mandado el bot y qué ha escrito.</p>
      </div>

      <div id="w-abierto" class="hidden flex-1 flex-col min-h-0">
        <header id="w-cabecera" class="flex flex-wrap items-center gap-3 px-4 py-3 border-b border-telecab-border"></header>
        <div id="w-mensajes" class="flex-1 overflow-y-auto min-h-0 px-4 py-4 space-y-1.5 bg-telecab-dark/40"></div>
        <footer id="w-pie" class="relative border-t border-telecab-border p-3"></footer>
      </div>
    </section>
  </div>
</div>

<script type="application/json" id="datos-servidor"><%- json({ puedeEscribir: !!puedeEscribir, verLlamadas: !!verLlamadas, abrirTel: abrirTel || '', sinTelefono: !!sinTelefono, videos: locals.videos || [] }) %></script>
<script src="<%= est('/assets/js/vistas/WhatsApp/whatsapp.js') %>"></script>
