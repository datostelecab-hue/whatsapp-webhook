      if (l.noLeidos) partes.push(`${l.noLeidos} correo(s) que no se entienden`);
      if (l.repetidos) partes.push(`${l.repetidos} repetido(s)`);
      if (l.releidos) partes.push(`${l.releidos} que antes no se entendían`);
